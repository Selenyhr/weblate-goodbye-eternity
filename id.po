msgctxt "N_AIE_PAS_PEUR_C_EST_MOI_SAITO_581ED8"
msgid "N'aie pas peur, c'est moi, {{saito.n}} ! On s'est vus hier matin, tu m'as déjà oublié ?"
msgstr "Jangan takut, ini aku, {{saito.n}}! Kita ketemu kemarin pagi, kamu sudah lupa aku?"

#. Character:`chiaki` | Attributes:`shy`
msgctxt "FONT_SIZE_14_NON_JE_N_AI_PAS_D85CE0"
msgid "[font_size=14]Non... Je n'ai pas oublié...[/font_size]"
msgstr "[font_size=14]Tidak... Aku tidak lupa...[/font_size]"

#. Character:`chiaki`
msgctxt "FONT_SIZE_14_NE_LUI_DIS_PAS_Q_A6317A"
msgid "[font_size=14]Ne... lui dis pas que je suis là.[/font_size]"
msgstr "[font_size=14]Jangan... bilang kalau aku di sini.[/font_size]"

#. Character:`narrator` | Attributes:`sad`
msgctxt "TRANGE_QUAND_M_ME_COMME_R_ACT_89BDCB"
msgid "Étrange, quand même, comme réaction..."
msgstr "Aneh juga reaksinya..."

#. Character:`narrator`
msgctxt "POURQUOI_CRAINT_ELLE_AUTANT_SO_747BE4"
msgid "Pourquoi craint-elle autant son frère que ça ?"
msgstr "Kenapa dia takut banget sama kakaknya sampai segitunya?"

#. Character:`saito` | Attributes:`happy`
msgctxt "SI_A_PEUT_TE_RASSURER_JE_NE_DI_8162C2"
msgid "Si ça peut te rassurer, je ne dirai absolument rien."
msgstr "Kalau itu bisa bikin kamu tenang, aku nggak akan bilang apa-apa."

#. Character:`chiaki` | Attributes:`shy`
msgctxt "FONT_SIZE_14_TU_LE_PROMETS_FO_CEB111"
msgid "[font_size=14]Tu le promets ?[/font_size]"
msgstr "[font_size=14]Kamu janji?[/font_size]"

#. Character:`saito`
msgctxt "C_EST_PROMIS_E1E88C"
msgid "C'est promis !"
msgstr "Janji!"

#. Character:`saito`
msgctxt "TU_VOUDRAS_QUE_JE_TE_RACCOMPAG_95FB5A"
msgid "Tu voudras que je te raccompagne ?"
msgstr "Kamu mau aku antar pulang?"

#. Character:`chiaki` | Attributes:`afraid`
msgctxt "NON_JE_NE_VEUX_PAS_Y_RETOURNER_E44D48"
msgid "NON ! Je ne veux pas y retourner !!"
msgstr "TIDAK! Aku nggak mau balik ke sana!!"

#. Character:`chiaki` | Attributes:`cry`
msgctxt "TU_AVAIS_PROMIS_DEAEB7"
msgid "Tu avais promis..."
msgstr "Kamu sudah janji..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "CHIAKI_N_ATTENDS_JE_VOULAIS_J_DEC424"
msgid "{{chiaki.n}}, attends ! Je voulais juste te raccompagner..."
msgstr "{{chiaki.n}}, tunggu! Aku cuma mau antar kamu pulang..."

#. Character:`saito`
msgctxt "ELLE_A_D_TAL_COMME_UN_LAPIN_1C4490"
msgid "Elle a détalé comme un lapin."
msgstr "Dia kabur seperti kelinci."

#. Character:`narrator`
msgctxt "C_EST_QUOI_CE_BORDEL_POURQUOI_38E229"
msgid "C'est quoi ce bordel ? Pourquoi elle est si terrifiée à l'idée de rentrer chez elle ?"
msgstr "Apa sih ini? Kenapa dia ketakutan banget buat pulang?"

#. Character:`narrator`
msgctxt "QU_EST_CE_QUE_MINATO_N_PEUT_BI_7159A1"
msgid "Qu'est-ce que {{minato.n}} peut bien lui faire ?"
msgstr "Apa yang {{minato.n}} lakukan sama dia?"

#. Character:`saito` | Attributes:`upset`
msgctxt "TOI_ET_MOI_ON_VA_DEVOIR_AVOIR_EE3D51"
msgid "Toi et moi, on va devoir avoir une conversation."
msgstr "Kamu dan aku harus ngobrol."

#. Character:`narrator` | Attributes:`happy`
msgctxt "BON_PREMIER_JOUR_D_ENTRA_NEMEN_A5C8AA"
msgid "Bon... Premier jour d'entraînement aujourd'hui !"
msgstr "Oke... Hari pertama latihan hari ini!"

#. Character:`narrator` | Attributes:`guilty`
msgctxt "AVEC_MACUMBA_N_8EF0ED"
msgid "Avec {{macumba.n}}..."
msgstr "Bersama {{macumba.n}}..."

#. Character:`narrator`
msgctxt "POURQUOI_J_AI_CETTE_SENSATION_58CDEA"
msgid "Pourquoi j'ai cette sensation que je vais souffrir comme jamais je n'ai souffert ?"
msgstr "Kenapa aku merasa akan menderita seperti belum pernah aku alami sebelumnya?"

#. Character:`narrator` | Attributes:`upset`
msgctxt "NON_PEU_IMPORTE_SI_C_EST_DUR_J_8D8575"
msgid "Non ! Peu importe si c'est dur, je dois changer."
msgstr "Tidak! Tidak peduli seberat apa pun, aku harus berubah."

#. Character:`narrator` | Attributes:`upset`
msgctxt "C_EST_UNE_QUESTION_DE_SURVIE_A_93EB6E"
msgid "C'est une question de survie, après tout."
msgstr "Ini soal bertahan hidup, bagaimanapun juga."

#. Character:`saito` | Attributes:`neutral`
msgctxt "W_SALUT_71D639"
msgid "...[w] Salut..."
msgstr "...[w] Hai..."

#. Character:`noriko`
msgctxt "FONT_SIZE_14_MOUAIS_SALUT_FON_63AD77"
msgid "[font_size=14]Mouais, salut...[/font_size]"
msgstr "[font_size=14]Ya, hai juga...[/font_size]"

#. Character:`saito` | Attributes:`happy`
msgctxt "DU_COUP_A_VA_MIEUX_E3327B"
msgid "Du coup, ça va mieux... ?"
msgstr "Jadi, kamu merasa lebih baik... ?"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "COMMENT_A_QU_EST_CE_QUI_VA_M_07FFA1"
msgid "Comment ça... Qu'est-ce qui va m—"
msgstr "Gimana maksudnya... Apa yang akan aku—"

#. Character:`noriko` | Attributes:`angry`
msgctxt "ENFOIR_TU_M_ESPIONNAIS_EF3514"
msgid "ENFOIRÉ, TU M'ESPIONNAIS ?!!"
msgstr "BAJINGAN, KAMU MATA-MATAIN AKU?!!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "TA_NUIT_PARDON_JE_VOULAIS_DIRE_413E6B"
msgid "Ta nuit !! ... Pardon. Je voulais dire, elle était bien, ta nuit ?"
msgstr "Malammu!! ... Maaf. Maksudku, malammu bagaimana?"

#. Character:`noriko`
msgctxt "FONT_SIZE_14_T_ES_VRAIMENT_LE_8640B8"
msgid "[font_size=14]T'es vraiment le pire ![/font_size]"
msgstr "[font_size=14]Kamu memang paling brengsek![/font_size]"

#. Character:`saito` | Attributes:`sad`
msgctxt "MAIS_QUEL_CON_0D36B3"
msgid "Mais quel con..."
msgstr "Dasar sialan..."

#. Character:`macumba` | Attributes:`happy`
msgctxt "PETIT_FR_RE_J_AI_PASS_LA_NUIT_DB57E8"
msgid "Petit frère ! J'ai passé la nuit à te préparer le meilleur des entraînements."
msgstr "Adik kecil! Aku sudah menyiapkan latihan terbaik untukmu semalaman."

#. Character:`macumba`
msgctxt "TU_VAS_POUVOIR_DIRE_ADIEU_CE_C_312FE1"
msgid "Tu vas pouvoir dire adieu à ce corps de lâche !"
msgstr "Kamu bakal bisa bilang selamat tinggal sama tubuh pengecut itu!"

#. Character:`macumba` | Attributes:`upset`
msgctxt "talk_macumba_aa56bc67"
msgid "Je vais te faire roter du sang !"
msgstr "Aku bakal bikin kamu muntahin darah!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "TU_SAIS_QU_ON_PEUT_AUSSI_COMME_950303"
msgid "Tu sais qu'on peut aussi commencer tranquillement, pas besoin de risquer une crise cardiaque."
msgstr "Kamu tahu kan kita juga bisa mulai pelan-pelan, nggak perlu sampai risiko serangan jantung."

#. Character:`macumba` | Attributes:`happy`
msgctxt "J_AIME_BEAUCOUP_CE_CONCEPT_DU_CB07B5"
msgid "J'aime beaucoup ce concept du \"Fighting Spirit\", le fait de se donner toujours à fond, peu importe ce que vous entreprenez !"
msgstr "Aku suka banget konsep \"Fighting Spirit\" ini, semangat ngasih yang terbaik terus, apapun yang kamu kerjakan!"

#. Character:`saito` | Attributes:`sad`
msgctxt "FONT_SIZE_14_IL_NE_M_ENTEND_D_D785FB"
msgid "[font_size=14]Il ne m'entend déjà plus...[/font_size]"
msgstr "[font_size=14]Dia sudah nggak denger aku lagi...[/font_size]"

#. Character:`macumba`
msgctxt "C_EST_POUR_A_QUE_JE_ME_SUIS_BE_7985BA"
msgid "C'est pour ça que je me suis beaucoup inspiré d'œuvres majeures."
msgstr "Makanya aku banyak terinspirasi dari karya-karya besar."

#. Character:`saito` | Attributes:`guilty`
msgctxt "talk_asami_2093e8de"
msgid "J'ai peur..."
msgstr "Aku takut..."

#. Character:`macumba` | Attributes:`neutral`
msgctxt "TU_VAS_AVOIR_DROIT_UN_MIX_ENTR_DD4376"
msgid "Tu vas avoir droit à un mix entre Ken le survivant, Dragon Ball, Berserk et Bible Black !"
msgstr "Kamu bakal dapat campuran antara Ken si Survivor, Dragon Ball, Berserk, dan Bible Black!"

#. Character:`narrator`
msgctxt "OH_PUTAIN_JE_SUIS_MORT_6AC094"
msgid "Oh putain, je suis mort !"
msgstr "Sial, aku mati!"

#. Character:`narrator`
msgctxt "JE_NE_SAIS_PAS_SI_MON_ENTRA_NE_CE6819"
msgid "Je ne sais pas si mon entraînement va consister à repousser mon endurance ou à découvrir jusqu'où mon anus peut être dilaté."
msgstr "Aku nggak tahu latihan ini buat nguji daya tahan atau buat tahu seberapa besar anusku bisa diregangkan."

#. Character:`narrator`
msgctxt "IL_FAUT_QUE_JE_ME_TIRE_J_IRAI_076F04"
msgid "Il faut que je me tire, j'irai courir dans mon coin, tout seul."
msgstr "Aku harus cabut, aku bakal lari sendiri di tempat lain."

#. Character:`macumba` | Attributes:`upset`
msgctxt "PR_SENT_TU_VAS_COURIR_PETIT_F_5E50DB"
msgid "À présent, tu vas courir, petit frère !"
msgstr "Sekarang, kamu harus lari, adik laki-laki!"

#. Character:`macumba`
msgctxt "AUSSI_VITE_QUE_LE_VENT_3C1557"
msgid "Aussi vite que le vent."
msgstr "Secepat angin."

#. Character:`macumba`
msgctxt "CAR_TU_ES_EN_DANGER_6F2646"
msgid "Car tu es en danger !"
msgstr "Karena kamu dalam bahaya!"

#. Character:`saito`
msgctxt "QUOI_D_J_940F17"
msgid "Quoi, déjà ?"
msgstr "Apa, sudah?"

#. Character:`macumba`
msgctxt "JE_SUIS_LE_DANGER_76DDE0"
msgid "Je suis le danger !"
msgstr "Aku adalah bahaya itu!"

#. Character:`macumba` | Attributes:`happy`
msgctxt "ET_SOUVIENS_TOI_SI_PETIT_FR_RE_0F3A1C"
msgid "Et souviens-toi, si petit frère est trop lent..."
msgstr "Dan ingat, kalau adik terlalu lambat..."

#. Character:`saito`
msgctxt "SI_JE_SUIS_TROP_LENT_9300FB"
msgid "Si je suis trop lent..?"
msgstr "Kalau aku terlalu lambat..?"

#. Character:`macumba`
msgctxt "C_EST_CE_BANC_DANS_TON_CUL_W_D_7B0635"
msgid "C'est ce banc dans ton cul.[w] Dans la largeur."
msgstr "Itu karena pantatmu yang berat.[w] Lebarnya."

#. Character:`macumba`
msgctxt "VOS_MARQUES_99798B"
msgid "À vos marques..."
msgstr "Bersiaplah..."

#. Character:`macumba` | Attributes:`upset`
msgctxt "J_AI_DIT_GO_133BA5"
msgid "J'ai dit GO!"
msgstr "Aku bilang MULAI!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "AH_C_EST_BON_J_Y_VAIS_104BA3"
msgid "Ah ! C'est bon j'y vais !"
msgstr "Ah! Baik, aku pergi!"

#. Character:`narrator`
msgctxt "TOUT_BIEN_R_FL_CHI_7726B6"
msgid "Tout bien réfléchi..."
msgstr "Setelah dipikir-pikir..."

#. Character:`narrator`
msgctxt "PARTIR_SANS_ATTENDRE_VOTRE_VI_D0F15A"
msgid "Partir sans attendre, votre virginité anale est en jeu !"
msgstr "Pergi tanpa menunggu, keperawanan analmu dipertaruhkan!"

#. Character:`macumba` | Attributes:`happy`
msgctxt "C_EST_A_PETIT_FR_RE_COURS_DFEF65"
msgid "C'est ça, petit frère, cours !"
msgstr "Itu dia, adik kecil, lari!"

#. Character:`macumba` | Attributes:`upset`
msgctxt "AUSSI_VITE_QUE_TU_LE_POURRAS_5F6C7F"
msgid "Aussi vite que tu le pourras..."
msgstr "Secepat yang kamu bisa..."

#. Character:`narrator`
msgctxt "talk_macumba_ed6995c5"
msgid "Ah putain, je déteste ça !"
msgstr "Ah sial, aku benci banget ini!"

#. Character:`narrator`
msgctxt "talk_macumba_bc64ddd5"
msgid "Courir, c'est juste horrible."
msgstr "Lari itu bener-bener nyebelin."

#. Character:`narrator`
msgctxt "talk_macumba_a8799e20"
msgid "C'est vraiment la pire chose qui puisse exister."
msgstr "Ini bener-bener hal terburuk yang ada."

#. Character:`narrator`
msgctxt "talk_macumba_2f35f56d"
msgid "[i]Hannnnn, haannnnn...[/i]"
msgstr "[i]Hannnnn, haannnnn...[/i]"

#. Character:`narrator`
msgctxt "talk_macumba_229f6624"
msgid "Oh putain... Oh putain."
msgstr "Oh sial... Oh sial."

#. Character:`macumba`
msgctxt "talk_macumba_1dcad4d2"
msgid "Ça devient plus facile."
msgstr "Mulai agak gampang nih."

#. Character:`narrator`
msgctxt "talk_asami_ff4d3041"
msgid "Hein ?!"
msgstr "Hah?!"

#. Character:`macumba`
msgctxt "talk_macumba_7c5565a7"
msgid "...chaque jour, ça devient un peu plus facile."
msgstr "...setiap hari, mulai agak gampang dikit."

#. Character:`narrator`
msgctxt "talk_macumba_2da42e66"
msgid "Euh... Okay ?"
msgstr "Euh... Oke?"

#. Character:`macumba`
msgctxt "talk_macumba_adb9bc41"
msgid "Mais tu dois le faire tous les jours, c'est ça la partie difficile."
msgstr "Tapi kamu harus lakuin tiap hari, itu yang susah."

#. Character:`macumba`
msgctxt "talk_macumba_59803a85"
msgid "...mais ça devient plus facile."
msgstr "...tapi memang makin gampang."

#. Character:`notice`
msgctxt "VOTRE_ENDURANCE_S_EST_AM_LIOR_923091"
msgid "Votre endurance s'est améliorée !"
msgstr "Daya tahanmu meningkat!"

#. Character:`narrator`
msgctxt "talk_macumba_0182e725"
msgid "Okay."
msgstr "Oke."

#. Character:`narrator`
msgctxt "talk_macumba_7fcd5cb2"
msgid "Finalement, ce n'était pas si terrible que ça."
msgstr "Akhirnya, ternyata nggak segitu seremnya juga."

#. Character:`narrator`
msgctxt "L_ENTRA_NEMENT_EST_VALID_PR_SE_1E1E65"
msgid "L'entraînement est validé... À présent, il va falloir retourner dialoguer avec ce vieux con..."
msgstr "Latihan selesai... Sekarang, kamu harus kembali bicara sama si tua itu..."

#. Character:`saito`
msgctxt "COURAGE_SAITO_N_897C68"
msgid "Courage {{saito.n}}..."
msgstr "Semangat {{saito.n}}..."

#. Character:`akira`
msgctxt "JE_T_ASSURE_QUE_TU_NE_LE_REGR_D0E3C7"
msgid "... Je t'assure que tu ne le regretteras pas."
msgstr "... Aku janji kamu nggak akan menyesal."

#. Character:`sakuya`
msgctxt "NON_J_AI_D_J_QUELQU_UN_EN_T_TE_822620"
msgid "Non... J'ai déjà quelqu'un en tête, je ne veux pas de ta proposition."
msgstr "Nggak... Aku sudah ada orang yang kupikirkan, aku nggak mau tawaranmu."

#. Character:`akira`
msgctxt "J_ENTENDS_CE_REFRAIN_DEPUIS_TE_3B9127"
msgid "J'entends ce refrain depuis tellement longtemps... Ce type ne te calcule même pas."
msgstr "Aku sudah dengar omongan itu dari lama... Orang itu bahkan nggak peduli sama kamu."

#. Character:`akira`
msgctxt "ET_MOI_JE_SUIS_L_DEVANT_TOI_54BB5D"
msgid "Et moi, je suis là, devant toi !"
msgstr "Dan aku, ada di sini, di depanmu!"

#. Character:`sakuya`
msgctxt "M_ME_JE_SUIS_CERTAINE_QU_IL_VA_2511B0"
msgid "Même... Je suis certaine qu'il va finir par..."
msgstr "Bahkan... Aku yakin dia akhirnya akan..."

#. Character:`akira`
msgctxt "SAKUYA_N_TU_ES_BELLE_INTELLIG_E605F6"
msgid "{{sakuya.n}}... Tu es belle, intelligente... Je pense que tu peux te rendre compte toute seule que ça ne mène à rien."
msgstr "{{sakuya.n}}... Kamu cantik, pintar... Aku rasa kamu sendiri bisa sadar kalau itu nggak akan membawa ke mana-mana."

#. Character:`akira`
msgctxt "JE_SUIS_S_R_QUE_TOI_M_ME_AU_FO_646BCF"
msgid "Je suis sûr que toi-même, au fond, tu le sais, tu es invisible à ses yeux."
msgstr "Aku yakin kamu sendiri, di lubuk hati, tahu kalau kamu nggak terlihat di matanya."

#. Character:`saito` | Attributes:`guilty`
msgctxt "talk_chef_b7ecfc18"
msgid "..."
msgstr "..."

#. Character:`akira`
msgctxt "CE_TRAIN_L_TU_VAS_PASSER_TA_V_169E14"
msgid "À ce train-là, tu vas passer ta vie dans ce restaurant déprimant."
msgstr "Kalau terus begini, kamu bakal habiskan hidupmu di restoran suram ini."

#. Character:`akira`
msgctxt "TRAVAILLER_POUR_TON_P_RE_QUI_2330A1"
msgid "À travailler pour ton père, qui t'exploite littéralement."
msgstr "Bekerja untuk ayahmu, yang benar-benar mengeksploitasi kamu."

#. Character:`akira`
msgctxt "ALORS_QUE_TU_POURRAIS_TRE_LIBR_984C48"
msgid "Alors que tu pourrais être libre, dehors, à faire tout ce que tu veux..."
msgstr "Padahal kamu bisa bebas di luar sana, melakukan apa pun yang kamu mau..."

#. Character:`akira`
msgctxt "PENDANT_CE_TEMPS_L_LUI_AURA_LE_CD5769"
msgid "Pendant ce temps-là, lui aura le temps de se trouver quelqu'un qui l'intéressera vraiment."
msgstr "Sementara itu, dia bakal sempat cari seseorang yang benar-benar menarik baginya."

#. Character:`akira`
msgctxt "ET_IL_AURA_M_ME_DES_ENFANTS_LE_D32258"
msgid "Et il aura même des enfants le temps que tu te décides !"
msgstr "Bahkan dia bisa punya anak sebelum kamu memutuskan!"

#. Character:`sakuya`
msgctxt "PEUT_TRE_BIEN_OUI_A7C1D8"
msgid "Peut-être bien, oui..."
msgstr "Mungkin iya, sih..."

#. Character:`akira`
msgctxt "TU_NE_VEUX_VRAIMENT_PAS_088088"
msgid "Tu ne veux vraiment pas ?"
msgstr "Kamu benar-benar nggak mau?"

#. Character:`sakuya`
msgctxt "NON_JE_PR_F_RE_ENCORE_LE_REGAR_C5AE96"
msgid "Non... Je préfère encore le regarder de loin plutôt que choisir un autre homme par dépit."
msgstr "Nggak... Aku lebih memilih melihatnya dari jauh daripada harus milih pria lain karena putus asa."

#. Character:`akira`
msgctxt "PFFFF_BON_TR_S_BIEN_JE_COMPREN_55CF9B"
msgid "Pffff... Bon, très bien, je comprends... Dans ce cas, laisse-moi t'aider !"
msgstr "Huh... Baiklah, aku mengerti... Kalau begitu, biar aku bantu kamu!"

#. Character:`sakuya`
msgctxt "M_AIDER_TOI_E2384E"
msgid "M'aider ? Toi ?"
msgstr "Bantu aku? Kamu?"

#. Character:`akira`
msgctxt "TU_AS_BESOIN_QU_IL_TE_REGARDE_CA3EFF"
msgid "Tu as besoin qu'il te regarde, c'est bien ça ?"
msgstr "Kamu butuh dia yang lihat kamu, kan?"

#. Character:`sakuya`
msgctxt "OUI_E2B697"
msgid "Oui..."
msgstr "Iya..."

#. Character:`akira`
msgctxt "EH_BIEN_FAISONS_EN_SORTE_QU_IL_4A351A"
msgid "Eh bien, faisons en sorte qu'il soit impossible pour lui de détourner les yeux."
msgstr "Kalau begitu, kita buat dia nggak mungkin bisa alihkan pandangan."

#. Character:`sakuya`
msgctxt "CO_COMMENT_TU_COMPTES_FAIRE_A_52939E"
msgid "Co... Comment tu comptes faire ça ?"
msgstr "Ca... Gimana kamu mau lakukan itu?"

#. Character:`akira`
msgctxt "OH_INT_RESS_E_W_IL_S_AV_RE_QUE_CB358D"
msgid "Oh, intéressée ?[w] Il s'avère que je connais des types dans le showbiz qui pourraient faire de toi une véritable idole."
msgstr "Oh, tertarik?[w] Ternyata aku kenal beberapa orang di dunia hiburan yang bisa bikin kamu jadi idola sejati."

#. Character:`akira`
msgctxt "IL_TE_SUFFIT_JUSTE_DE_B5B708"
msgid "Il te suffit juste de-"
msgstr "Kamu cuma perlu-"

#. Character:`akira`
msgctxt "PUTAIN_T_EN_AS_PAS_MARRE_DE_RE_D58230"
msgid "Putain, t'en as pas marre de rester là à nous regarder ? Tu vois pas que tu déranges ?"
msgstr "Sial, kamu nggak bosan ya cuma diem di situ ngeliatin kita? Kamu nggak lihat kamu ganggu?"

#. Character:`sakuya`
msgctxt "_3F5B1E"
msgid "!!!"
msgstr "!!!"

#. Character:`narrator`
msgctxt "POURQUOI_FAUT_IL_TOUJOURS_QUE_FB8760"
msgid "Pourquoi faut-il toujours que je tombe sur lui dans les moments les plus importants ?"
msgstr "Kenapa aku selalu harus ketemu dia di momen-momen paling penting?"

#. Character:`narrator`
msgctxt "JE_POURRAIS_REVENIR_PLUS_TARD_A09F4B"
msgid "Je pourrais revenir plus tard..."
msgstr "Mungkin aku bisa balik nanti..."

#. Character:`narrator`
msgctxt "MAIS_C_EST_PAS_TOUS_LES_JOURS_257C0A"
msgid "Mais c'est pas tous les jours qu'on a la possibilité de casser le coup de son harceleur..."
msgstr "Tapi nggak setiap hari kan bisa ngancurin rencana si penguntit..."

#. Character:`narrator`
msgctxt "PAR_CONTRE_JE_RISQUE_SACR_MENT_A21B8F"
msgid "Par contre, je risque sacrément de morfler après ça."
msgstr "Tapi setelah itu, aku pasti kena getahnya juga."

#. Character:`saito` | Attributes:`upset`
msgctxt "J_AI_DES_CHOSES_FAIRE_4FD98D"
msgid "J'ai des choses à faire."
msgstr "Aku ada urusan."

#. Character:`akira` | Attributes:`angry`
msgctxt "JE_T_AVAIS_DIT_QUE_SI_JE_TE_RE_DA2566"
msgid "Je t'avais dit que si je te retombais dessus, tu étais mort. Tu as déjà oublié ?"
