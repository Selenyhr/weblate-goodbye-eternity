msgctxt "OUI_TU_AS_VU_A_C_EST_DINGUE_BFFCCD"
msgid "Oui, tu as vu ça ? C’est dingue !"
msgstr "Iya, kamu lihat itu? Gila banget!"

#. Character:`noriko`
msgctxt "_3F9E71"
msgid "..."
msgstr "..."

