#. Character:`asami`
msgctxt "HEY_JE_SUIS_TON_AMIE_DD7393"
msgid "Hey ! Je suis ton amie !"
msgstr "Hei! Aku temanmu!"

#. Character:`asami`
msgctxt "ET_JE_VEUX_AUSSI_TRE_PR_SENTE_472473"
msgid "Et je veux aussi être présente dans les mauvais moments."
msgstr "Dan aku juga pengen ada di saat-saat susah."

#. Character:`asami`
msgctxt "EXPLIQUE_MOI_CE_QU_IL_SE_PASSE_833611"
msgid "Explique-moi ce qu'il se passe pour que je puisse t'aider."
msgstr "Jelasin ke aku apa yang terjadi biar aku bisa bantu."

#. Character:`asami`
msgctxt "TU_N_AS_PAS_CONFIANCE_EN_MOI_491B81"
msgid "Tu n'as pas confiance en moi ?"
msgstr "Kamu nggak percaya sama aku?"

#. Character:`saito` | Attributes:`sad`
msgctxt "BIEN_S_R_QUE_SI_132053"
msgid "Bien sûr que si..."
msgstr "Tentu aja percaya..."

#. Character:`asami`
msgctxt "ALORS_DIS_MOI_22A9D2"
msgid "Alors dis-moi !"
msgstr "Ya udah bilang dong!"

#. Character:`saito`
msgctxt "W_J_AI_D_CONN_D0CBD0"
msgid "...[w] J'ai déconné."
msgstr "...[w] Aku udah bikin kesalahan."

#. Character:`asami`
msgctxt "COMMENT_A_C29136"
msgid "Comment ça ?"
msgstr "Maksud kamu gimana?"

#. Character:`saito`
msgctxt "JE_SUIS_EN_RELATION_AVEC_TOI_E_DA94AF"
msgid "Je suis en relation avec toi et... depuis quelques jours..."
msgstr "Aku lagi sama kamu dan... beberapa hari ini..."

#. Character:`asami`
msgctxt "OH_JE_SENS_QUE_JE_NE_VAIS_PAS_29D27B"
msgid "Oh... Je sens que je ne vais pas aimer ce que je vais entendre."
msgstr "Oh... Aku merasa gak bakal suka sama apa yang bakal aku denger."

#. Character:`saito`
msgctxt "TU_AS_RAISON_MAIS_JE_NE_TE_CAC_69251C"
msgid "Tu as raison, mais je ne te cacherai plus rien."
msgstr "Kamu bener, tapi aku gak bakal nutupin apa-apa lagi sama kamu."

#. Character:`saito`
msgctxt "IL_Y_A_EU_QUELQUE_CHOSE_ENTRE_519A65"
msgid "Il y a eu quelque chose entre {{yasuka.n}} et moi."
msgstr "Ada sesuatu yang terjadi antara aku dan {{yasuka.n}}."

#. Character:`saito`
msgctxt "DISONS_QUE_DEPUIS_QUELQUES_JOU_6DB6A8"
msgid "Disons que depuis quelques jours, j'ai une relation intime avec {{yasuka.n}}..."
msgstr "Bilang aja deh, beberapa hari terakhir ini aku punya hubungan intim sama {{yasuka.n}}..."

#. Character:`asami`
msgctxt "OH_VOYEZ_VOUS_A_4ED5A0"
msgid "Oh, voyez-vous ça ?"
msgstr "Oh, liat nih?"

#. Character:`asami`
msgctxt "DONC_A_VEUT_DIRE_QUOI_JE_NE_TE_705C6C"
msgid "Donc ça veut dire quoi ? Je ne te suffis plus ?"
msgstr "Jadi itu artinya apa? Aku gak cukup lagi buat kamu?"

#. Character:`saito`
msgctxt "NON_NON_CE_N_EST_PAS_A_C8390B"
msgid "Non... Non... Ce n'est pas ça..."
msgstr "Gak... Gak gitu..."

#. Character:`saito`
msgctxt "JE_CROIS_QUE_JE_N_AI_PAS_SU_PO_DDB3F7"
msgid "Je crois que je n'ai pas su poser des limites et..."
msgstr "Kayaknya aku gak bisa buat batasan dan..."

#. Character:`asami`
msgctxt "HEY_NE_T_EN_FAIS_PAS_NOTRE_REL_59E7DA"
msgid "Hey ! Ne t'en fais pas, notre relation tient plus du charnel que de l'émotionnel."
msgstr "Hei! Santai aja, hubungan kita lebih ke urusan fisik daripada perasaan."

#. Character:`asami`
msgctxt "JE_NE_TE_CACHE_PAS_QU_AU_FOND_BD5A25"
msgid "Je ne te cache pas qu'au fond de moi, j'ai envie d'hurler, mais c'est moi qui t'ai proposé cet arrangement."
msgstr "Aku gak nutupin kalo sebenernya aku pengen teriak, tapi aku yang nawarin pengaturan ini sama kamu."

#. Character:`asami`
msgctxt "ET_PUIS_NOUS_SOMMES_AUSSI_AMIS_717211"
msgid "Et puis, nous sommes aussi amis, non ?"
msgstr "Terus, kita juga temen, kan?"

#. Character:`saito`
msgctxt "OUI_TU_AS_RAISON_E200C8"
msgid "Oui, tu as raison..."
msgstr "Iya, kamu bener..."

#. Character:`asami`
msgctxt "ALORS_EXPLIQUE_MOI_PLUT_T_LE_V_2ABEAB"
msgid "Alors, explique-moi plutôt le vrai problème !"
msgstr "Yaudah, jelasin aja masalah sebenernya!"

#. Character:`saito`
msgctxt "CES_DERNIERS_TEMPS_JE_ME_SUIS_03C00B"
msgid "Ces derniers temps, je me suis beaucoup rapproché de {{yasuka.n}}."
msgstr "Belakangan ini, aku makin dekat sama {{yasuka.n}}."

#. Character:`asami`
msgctxt "RAPPROCH_C_EST_DIRE_993BE6"
msgid "Rapproché ? C'est-à-dire ?"
msgstr "Dekat? Maksudnya gimana?"

#. Character:`asami`
msgctxt "OH_TU_VEUX_DIRE_TU_L_AS_FAIT_A_51047A"
msgid "OH ! Tu veux dire... Tu l'as fait avec elle ?!"
msgstr "OH! Maksud kamu... Kamu udah ngelakuin sama dia?!"

#. Character:`asami`
msgctxt "JE_COMPRENDS_MIEUX_PR_SENT_TON_5B2794"
msgid "Je comprends mieux à présent, ton truc, c'est les femmes plus âgées..."
msgstr "Sekarang aku lebih ngerti, ternyata kamu suka cewek yang lebih tua ya..."

#. Character:`asami`
msgctxt "EXCUSE_MOI_JE_TE_LAISSE_FINIR_07AD3F"
msgid "Excuse-moi, je te laisse finir ton explication."
msgstr "Maaf, aku kasih kamu lanjut jelasin dulu."

#. Character:`saito`
msgctxt "SAKUYA_N_LA_FILLE_AVEC_QUI_JE_857762"
msgid "{{sakuya.n}}, la fille avec qui je travaille."
msgstr "{{sakuya.n}}, cewek yang aku kerja bareng."

#. Character:`asami`
msgctxt "CELLE_QUI_N_ARR_TE_PAS_DE_VENI_D4783F"
msgid "Celle qui n'arrête pas de venir nous observer avec son regard de folle quand on a nos moments à nous ?"
msgstr "Yang nggak berhenti ngintip kita sambil ngeliatin kayak orang gila pas kita lagi berdua itu kan?"

#. Character:`asami`
msgctxt "CELLE_QUI_N_ARR_TE_PAS_DE_VENI_879EBA"
msgid "Celle qui n'arrête pas de venir nous observer avec son regard de folle quand on s'envoie en l'air ?"
msgstr "Itu cewek yang nggak berhenti ngintip kita sambil ngelihatin dengan mata gila pas kita lagi asik ya?"

#. Character:`asami`
msgctxt "CELLE_QUI_N_ARR_TE_PAS_DE_VENI_ABDB39"
msgid "Celle qui n'arrête pas de venir nous espionner quand on est en train de jouer ?"
msgstr "Itu cewek yang nggak berhenti ngeintip kita pas lagi main ya?"

#. Character:`asami`
msgctxt "JE_SAVAIS_BIEN_QU_ELLE_POSERAI_D71423"
msgid "Je savais bien qu'elle poserait problème !"
msgstr "Aku yakin dia bakal jadi masalah!"

#. Character:`saito`
msgctxt "ELLE_M_A_DIT_QU_ELLE_VOUS_TUER_C60EA3"
msgid "Elle m'a dit qu'elle vous tuerait si jamais je continuais ces deux relations..."
msgstr "Dia bilang bakal bunuh kalian kalau aku terusin dua hubungan ini..."

#. Character:`asami`
msgctxt "JE_SUIS_PARTAG_E_EN_CE_MOMENT_E85D45"
msgid "Je suis partagée en ce moment entre mon envie de te gifler de m'avoir menti et le fait d'être terrifiée que cette fille puisse aller aussi loin dans ses menaces."
msgstr "Sekarang aku bingung antara pengen tampar kamu karena bohong sama takut banget kalau cewek itu beneran ngelakuin ancaman gila gitu."

#. Character:`asami`
msgctxt "ELLE_EST_STUPIDE_SI_ELLE_M_AVA_81AF5E"
msgid "Elle est stupide, si elle m'avait demandé, on aurait pu faire un truc à trois."
msgstr "Dia bodoh banget, kalau dia minta, kita bisa aja bikin threesome."

#. Character:`asami`
msgctxt "MAIS_JE_SUPPOSE_QU_ELLE_VOULAI_BE1AE8"
msgid "Mais je suppose qu'elle voulait l'exclusivité..."
msgstr "Tapi kayaknya dia mau eksklusif..."

#. Character:`asami`
msgctxt "QUOI_MAIS_ON_EST_JUSTE_AMIS_A_92153C"
msgid "Quoi ?! Mais on est juste amis, ça n'a pas de sens !"
msgstr "Apa?! Kita kan cuma temen, nggak masuk akal!"

#. Character:`asami`
msgctxt "IL_FAUT_CROIRE_QU_ELLE_ME_VOIT_33EB46"
msgid "Il faut croire qu'elle me voit comme une menace, hmmm."
msgstr "Kayaknya dia ngeliat aku sebagai ancaman, hmmm."

#. Character:`saito`
msgctxt "JE_LUI_AI_DIT_QUE_JE_NE_ME_LAI_D56FC3"
msgid "Je lui ai dit que je ne me laisserais pas intimider par des menaces et que je serais plus honnête avec toi."
msgstr "Aku bilang ke dia kalau aku nggak bakal takut sama ancaman dan bakal lebih jujur sama kamu."

#. Character:`saito`
msgctxt "J_AI_EU_UNE_DISCUSSION_ASSEZ_L_66F884"
msgid "J'ai eu une discussion assez longue avec elle, je pensais pouvoir arranger ça pacifiquement."
msgstr "Aku udah ngobrol cukup lama sama dia, aku pikir bisa nyelesain ini dengan damai."

#. Character:`saito`
msgctxt "MAIS_YASUKA_N_DEVAIT_ME_REJOIN_CB3011"
msgid "Mais {{yasuka.n}} devait me rejoindre hier soir et elle n'est jamais venue et reste introuvable."
msgstr "Tapi {{yasuka.n}} harusnya ketemu aku tadi malem dan dia nggak pernah dateng, sekarang juga nggak ketemu-ketemu."

#. Character:`saito`
msgctxt "JE_SUIS_SINC_REMENT_D_SOL_ASAM_100398"
msgid "Je suis sincèrement désolé, {{asami.n}}."
msgstr "Aku bener-bener minta maaf, {{asami.n}}."

#. Character:`asami`
msgctxt "JE_SUIS_FURIEUSE_CONTRE_TOI_M_AAD75E"
msgid "... Je suis furieuse contre toi, mais..."
msgstr "... Aku kesel banget sama kamu, tapi..."

#. Character:`asami`
msgctxt "JE_CONNAIS_AUSSI_YASUKA_N_ET_J_7DABCE"
msgid "Je connais aussi {{yasuka.n}} et j'aimerais en discuter avec elle avant de prendre ma décision."
msgstr "Aku juga kenal {{yasuka.n}} dan pengen ngobrol dulu sama dia sebelum aku ambil keputusan."

#. Character:`asami`
msgctxt "DONC_JUSQU_CE_QU_ON_LA_RETROUV_833AF6"
msgid "Donc jusqu'à ce qu'on la retrouve, je ne m'en prendrai pas à toi."
msgstr "Jadi sampai kita nemuin dia, aku nggak bakal nyerang kamu."

#. Character:`asami`
msgctxt "MAIS_JE_TE_PR_VIENS_QUAND_TOUT_396E22"
msgid "Mais je te préviens, quand toute cette histoire sera terminée, je demanderai à {{macumba.n}} de te botter le cul pour moi !"
msgstr "Tapi aku peringatkan, pas masalah ini kelar, aku bakal minta {{macumba.n}} buat ngelindes kamu buat aku!"

#. Character:`saito`
msgctxt "A_SERA_PROBABLEMENT_M_RIT_573230"
msgid "Ça sera probablement mérité..."
msgstr "Mungkin itu emang pantas sih..."

#. Character:`asami`
msgctxt "LA_SEULE_CHOSE_QUI_ME_G_NE_C_E_469A45"
msgid "La seule chose qui me gêne, c'est que tu n'aies pas pensé à moi en premier !"
msgstr "Hal yang aku nggak suka cuma kamu nggak mikirin aku duluan!"

#. Character:`asami`
msgctxt "JE_M_ENNUYAIS_MOI_HIER_SOIR_TU_7FDA83"
msgid "Je m'ennuyais, moi, hier soir, tu aurais dû m'inviter aussi."
msgstr "Aku bosen nih tadi malem, kamu sebenernya harusnya ajak aku juga."

#. Character:`saito`
msgctxt "JE_SUIS_D_SOL_F894BC"
msgid "Je suis désolé !"
msgstr "Maaf ya!"

#. Character:`asami`
msgctxt "ARR_TE_DE_TE_MORFONDRE_ON_VA_L_D63816"
msgid "Arrête de te morfondre, on va la retrouver, j'en suis certaine."
msgstr "Berhenti ngedumel, kita pasti bakal nemuin dia, aku yakin deh."

#. Character:`asami`
msgctxt "ET_QUAND_A_SERA_LE_CAS_JE_VEUX_AE6582"
msgid "Et quand ça sera le cas, je veux être présente !"
msgstr "Dan waktu itu terjadi, aku pengen ikut hadir!"

#. Character:`saito`
msgctxt "JE_NE_SAIS_PAS_SI_ELLE_ACCEPTE_003339"
msgid "Je ne sais pas si elle acceptera, par contre..."
msgstr "Tapi aku nggak tahu dia bakal terima atau nggak..."

#. Character:`asami`
msgctxt "JE_SAURAI_TRE_CONVAINCANTE_T_E_53D09D"
msgid "Je saurai être convaincante, t'en fais pas !"
msgstr "Aku bakal bisa meyakinkan dia, santai aja!"

#. Character:`asami`
msgctxt "Y_A_QUAND_M_ME_QUELQUE_CHOSE_Q_147B94"
msgid "Y'a quand même quelque chose qui m'intrigue..."
msgstr "Tapi ada satu hal yang bikin aku penasaran..."

#. Character:`asami`
msgctxt "NORIKO_N_EST_AU_COURANT_4C3336"
msgid "{{noriko.n}} est au courant ?"
msgstr "{{noriko.n}} udah tau belum sih?"

#. Character:`asami`
msgctxt "JE_VEUX_DIRE_TU_TU_T_ENVOIES_E_BA955B"
msgid "Je veux dire... Tu... Tu t'envoies en l'air avec sa mère, quand même."
msgstr "Maksudku... Lu... Kamu udah tidur sama ibunya, lho."

#. Character:`saito`
msgctxt "ON_EST_VRAIMENT_OBLIG_S_DE_PAR_AEEC3B"
msgid "On est vraiment obligés de parler de ça maintenant ?"
msgstr "Kita beneran harus bahas ini sekarang juga?"

#. Character:`asami`
msgctxt "NON_BIEN_S_R_QUE_NON_2AF4A4"
msgid "Non, bien sûr que non..."
msgstr "Nggak, jelas nggak..."

#. Character:`saito`
msgctxt "SAKUYA_N_ARR_TE_A_C76ACD"
msgid "{{sakuya.n}} !! Arrête ça !"
msgstr "{{sakuya.n}} !! Berhenti dong!"

#. Character:`saito`
msgctxt "JE_SUIS_PR_T_DISCUTER_C_EST_BO_C62539"
msgid "Je suis prêt à discuter, c'est bon !"
msgstr "Aku siap buat ngomong baik-baik, oke!"

#. Character:`saito` | Attributes:`sad`
msgctxt "NE_LEUR_FAIS_PAS_DE_MAL_C7B49D"
msgid "Ne leur fais pas de mal..."
msgstr "Jangan sakitin mereka..."

#. Character:`saito`
msgctxt "BON_SANG_JE_NE_SAIS_PLUS_QUOI_5E22D6"
msgid "Bon sang... Je ne sais plus quoi faire..."
msgstr "Sialan... Aku bener-bener gak tau mau ngapain lagi..."

#. Character:`saito`
msgctxt "POURQUOI_A_T_IL_FALLU_QUE_JE_S_D84102"
msgid "Pourquoi a-t-il fallu que je sois aussi stupide ?!"
msgstr "Kenapa aku harus sebodoh ini sih?!"

#. Character:`noriko`
msgctxt "POURQUOI_TU_PENSES_QUE_C_EST_D_7EF67B"
msgid "Pourquoi tu penses que c'est de ta faute ?!"
msgstr "Kenapa kamu mikir ini salah kamu?!"

#. Character:`noriko`
msgctxt "C_EST_CETTE_FILLE_QUI_EST_COMP_2830F6"
msgid "C'est cette fille qui est complètement dérangée."
msgstr "Gadis itu yang bener-bener gila."

#. Character:`noriko`
msgctxt "ON_VA_LES_RETROUVER_3AAFA9"
msgid "On va les retrouver !"
msgstr "Kita bakal cari mereka!"

#. Character:`saito`
msgctxt "JE_NE_SAIS_PAS_PAR_O_COMMENCER_DD4F5C"
msgid "Je ne sais pas par où commencer..."
msgstr "Aku gak tau harus mulai dari mana..."

#. Character:`noriko`
msgctxt "RETOURNONS_CHEZ_ELLE_ET_ATTEND_A941C1"
msgid "Retournons chez elle et attendons-la là-bas."
msgstr "Ayo balik ke rumahnya dan tunggu dia di sana."

#. Character:`noriko`
msgctxt "ON_AVISERA_ENSUITE_22A2E0"
msgid "On avisera ensuite !"
msgstr "Nanti kita lihat aja!"

#. Character:`saito`
msgctxt "TU_TU_AS_RAISON_FAISONS_A_D9DB6F"
msgid "Tu... Tu as raison, faisons ça !"
msgstr "Kamu... Kamu bener, ayo kita lakuin itu!"

#. Character:`noriko`
msgctxt "JE_VAIS_R_CUP_RER_DES_AFFAIRES_EBB735"
msgid "Je vais récupérer des affaires et j'arrive."
msgstr "Aku mau ambil barang dulu, bentar lagi aku nyusul."

#. Character:`saito`
msgctxt "LAISSE_MOI_T_ACCOMPAGNER_5D17DA"
msgid "Laisse-moi t'accompagner."
msgstr "Biar aku temenin kamu."

#. Character:`noriko`
msgctxt "J_EN_AI_POUR_MOINS_D_UNE_MINUT_56CBEE"
msgid "J'en ai pour moins d'une minute et si je la vois, je hurle !"
msgstr "Aku cuma butuh kurang dari semenit, dan kalo aku liat dia, aku bakal teriak!"

#. Character:`saito`
msgctxt "W_JE_LE_SENS_PAS_AE1B6C"
msgid "...[w] Je le sens pas."
msgstr "...[w] Aku gak ngerasa enak nih."

#. Character:`saito`
msgctxt "J_AURAIS_PAS_D_L_COUTER_JE_VAI_4F4639"
msgid "J'aurais pas dû l'écouter, je vais la chercher quand même !"
msgstr "Seharusnya aku gak dengerin dia, tapi aku bakal cari dia juga!"

#. Character:`narrator`
msgctxt "asami_truth_6b63022a"
msgid "Je pense que j'en apprendrais pas plus aujourd'hui."
msgstr "Kayaknya hari ini aku gak bakal dapet info lebih banyak deh."

#. Character:`narrator`
msgctxt "asami_truth_ca242601"
msgid "J'ai au moins pu commencer à éclaircir le problème."
msgstr "Setidaknya aku udah mulai ngerti masalahnya."

#. Character:`narrator`
msgctxt "asami_truth_baacff73"
msgid "Quelque chose s'est passé dans le parc il y a des années de ça."
msgstr "Ada sesuatu yang kejadian di taman beberapa tahun lalu."

#. Character:`narrator`
msgctxt "asami_truth_0a369b00"
msgid "Quelque chose qui fait qu'elle s'est totalement détournée de moi."
msgstr "Ada sesuatu yang bikin dia bener-bener ninggalin aku."

#. Character:`narrator`
msgctxt "asami_truth_70da40c0"
msgid "Est-ce que j'aurais fait quelque chose d'impardonnable ?"
msgstr "Apa aku udah ngelakuin sesuatu yang gak bisa dimaafin?"

#. Character:`narrator`
msgctxt "asami_truth_ee22d19d"
msgid "Tchh.... Pourquoi je ne me souviens de rien ?"
msgstr "Tchh... Kenapa aku gak inget apa-apa ya?"

#. Character:`narrator`
msgctxt "asami_truth_9e8d253e"
msgid "Comme si... toute cette période de ma vie était floue."
msgstr "Kayak... semua masa itu dalam hidup aku jadi blur gitu."

#. Character:`narrator`
msgctxt "asami_truth_cd736e9a"
msgid "Bref... on verra demain."
msgstr "Pokoknya... kita liat besok aja."

#. Character:`asami`
msgctxt "asami_truth_4252234c"
msgid "On va attendre encore longtemps comme ça ?"
msgstr "Kita mau nunggu kayak gini lama banget?"

#. Character:`kimochi`
msgctxt "asami_truth_e4a709a8"
msgid "Shhhht, c'est toi qui a voulu venir, arrête de te plaindre !"
msgstr "Shhhht, kamu yang mau datang, berhenti ngeluh dong!"

#. Character:`kimochi`
msgctxt "asami_truth_1bbe9eeb"
msgid "Si tu passes ton temps à te plaindre on va finir par se faire repérer."
msgstr "Kalo kamu terus-terusan ngeluh, kita bakal ketauan deh."

#. Character:`saito`
msgctxt "asami_truth_80c4505e"
msgid "On a quand même l'air sacrément suspects."
msgstr "Kita emang keliatan banget kayak orang yang mencurigakan."

#. Character:`saito`
msgctxt "asami_truth_7bd12c63"
msgid "C'est normal que je me sente aussi mal ?"
msgstr "Wajar gak sih aku ngerasa sesak kayak gini?"

#. Character:`kimochi`
msgctxt "asami_truth_ce058765"
msgid "Ça passera t'en fais pas... Tu apprendras à apprécier cette sensation."
msgstr "Nanti juga bakal biasa, santai aja... Kamu bakal mulai suka sensasinya."

#. Character:`asami`
msgctxt "asami_truth_8e105af1"
msgid "J'aime vraiment beaucoup ta maison, elle a vraiment beaucoup de charme."
msgstr "Aku bener-bener suka rumahmu, punya pesona yang keren banget."

#. Character:`saito`
msgctxt "asami_truth_a27f0788"
msgid "Merci, {{yasuka.n}} s'est donnée beaucoup de mal pour..."
msgstr "Makasih, {{yasuka.n}} udah capek-capek buat..."

#. Character:`kimochi`
msgctxt "asami_truth_3902e28b"
msgid "Mais bordel vos gueules ! On est en planque pas en pique-nique !"
msgstr "Beb, pada diem! Kita lagi nyamar, bukan piknik!"

#. Character:`asami`
msgctxt "asami_truth_a43f6dc7"
msgid "J'en viens de plus en plus à penser que c'était vraiment une idée d-"
msgstr "Aku makin mikir ini emang ide yang g-"

#. Character:`kimochi`
msgctxt "asami_truth_ae5259f1"
msgid "Shut, taisez-vous je vois quelque chose !"
msgstr "Shh, diam! Aku liat sesuatu!"

#. Character:`noriko`
msgctxt "asami_truth_cc7afb19"
msgid "Mais où est passé ce pervers ?"
msgstr "Tapi si mesum itu kemana sih?"

#. Character:`noriko` | Attributes:`shame`
msgctxt "asami_truth_0f4290cc"
msgid "J'ai attendu la matinée pour rien au final."
msgstr "Aku nunggu dari pagi tapi ujung-ujungnya sia-sia."

#. Character:`noriko`
msgctxt "asami_truth_245bc0be"
msgid "Je suis sûre qu'il doit être chez {{asami.n}} ou l'autre folle..."
msgstr "Aku yakin dia pasti di rumah {{asami.n}} atau si gila itu..."

#. Character:`kimochi`
msgctxt "asami_truth_e9486062"
msgid "[font_size=14]Pourquoi elle t'appelle le pervers ?[/font_size]"
msgstr "[font_size=14]Kenapa dia manggil kamu mesum?[/font_size]"

#. Character:`asami`
msgctxt "asami_truth_5d80cf45"
msgid "[font_size=14]Moi j'ai bien une idée...[/font_size]"
msgstr "[font_size=14]Aku sih punya ide nih...[/font_size]"

#. Character:`saito`
msgctxt "asami_truth_e95ff49a"
msgid "[font_size=14]... Bon sang arrêtez et concentrez-vous ![/font_size]"
msgstr "[font_size=14]... Sialan, berhenti dong dan fokus![/font_size]"

#. Character:`kimochi`
msgctxt "asami_truth_aa648b36"
msgid "[font_size=14]Le peuple exige des réponses.[/font_size]"
msgstr "[font_size=14]Rakyat minta jawaban nih.[/font_size]"

#. Character:`saito`
msgctxt "asami_truth_30906c8d"
msgid "[font_size=14]Ahhh ça suffit, restez concentrés, elle s'en va ![/font_size]"
msgstr "[font_size=14]Ahhh, udah cukup, tetap fokus, dia mau pergi![/font_size]"

#. Character:`asami`
msgctxt "asami_truth_d9ee3794"
msgid "[font_size=14]Elle se dirige vers le konbini...[/font_size]"
msgstr "[font_size=14]Dia menuju ke konbini...[/font_size]"

#. Character:`kimochi`
msgctxt "asami_truth_18764228"
msgid "[font_size=14]Attendez un peu, il ne faut pas se faire griller bêtement.[/font_size]"
msgstr "[font_size=14]Tunggu dulu, jangan sampe kita ketahuan bodoh gitu aja.[/font_size]"

#. Character:`kimochi`
msgctxt "asami_truth_72bf6b74"
msgid "Maintenant c'est bon."
msgstr "Sekarang udah oke."

#. Character:`asami` | Attributes:`sad`
msgctxt "asami_truth_d5b35cb1"
msgid "Alors...?"
msgstr "Jadi...?"

#. Character:`saito` | Attributes:`upset`
msgctxt "asami_truth_f910881f"
msgid "...[w] eh bien..."
msgstr "...[w] yah..."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "asami_truth_63d31c8c"
msgid "Elle a menti c'est ça ?"
msgstr "Dia bohong ya?"

#. Character:`kimochi`
msgctxt "asami_truth_4f581005"
msgid "Elle a dû dire qu'elle avait passé la journée avec ses copines ou un truc dans le genre."
msgstr "Dia pasti bilang kalau dia habis ngabisin hari sama temen-temennya atau semacamnya."

#. Character:`saito`
msgctxt "asami_truth_21b9300c"
msgid "En effet."
msgstr "Iya, bener."

#. Character:`asami` | Attributes:`surprised`
msgctxt "asami_truth_0e3c8e42"
msgid "Quoi ?! Mais pourquoi ?"
msgstr "Apa?! Tapi kenapa?"

#. Character:`saito`
msgctxt "asami_truth_8233990a"
msgid "Visiblement elle cache quelque chose. Elle a dit qu'elle avait passé toute sa journée avec toi."
msgstr "Kayaknya dia nyembunyiin sesuatu. Dia bilang dia ngabisin seharian sama kamu."

#. Character:`asami` | Attributes:`sad`
msgctxt "asami_truth_52c8669a"
msgid "{{saito.n}} s'il te plaît, laisse-moi aller lui faire un câlin ! Je ne tiens plus en place."
msgstr "{{saito.n}} tolong, biarin aku peluk dia! Aku udah nggak sabar."

#. Character:`saito`
msgctxt "asami_truth_24cbdb1b"
msgid "Non, elle le verrait sur ton visage que quelque chose ne va pas et tu finirais par craquer."
msgstr "Nggak, dia bakal liat dari wajah kamu kalau ada yang nggak beres dan kamu bakal nyerah."

#. Character:`asami` | Attributes:`pouting`
msgctxt "asami_truth_7f329100"
msgid "Alors c'est toi qui vas t'en charger, va lui faire un câlin !"
msgstr "Jadi kamu yang harus ngelakuin, peluk dia!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "asami_truth_acce791a"
msgid "Non... Si je fais ça elle pourrait même me castrer."
msgstr "Nggak... Kalau aku ngelakuin itu dia malah bisa aja ngegugurin aku."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "asami_truth_5e1f59a5"
msgid "Laissez-moi y aller dans ce cas, je me porte volontaire."
msgstr "Biarin aku yang pergi, aku sukarela."

#. Character:`saito` | Attributes:`upset`
msgctxt "asami_truth_4698549a"
msgid "Arrête un peu de dire des conneries."
msgstr "Udah stop ngomong omong kosong gitu."

#. Character:`saito`
msgctxt "asami_truth_70b08a97"
msgid "J'irai lui parler et la confronterai à ses mensonges."
msgstr "Aku bakal ngomong sama dia dan lawan kebohongannya."

#. Character:`saito`
msgctxt "asami_truth_74135d2f"
msgid "Même si elle se fâche peut-être que j'en tirerais quelque chose."
msgstr "Walaupun dia marah, mungkin aku bakal dapet sesuatu dari situ."

#. Character:`kimochi` | Attributes:`think`
msgctxt "asami_truth_50f260fd"
msgid "Si on veut que les choses avancent, on n'aura pas le choix."
msgstr "Kalau kita mau ngelanjutin semuanya, gak ada pilihan lain."

#. Character:`kimochi`
msgctxt "asami_truth_0f9352ce"
msgid "Je vais rentrer, tenez-moi au courant. J'ai dit que j'allais aider et je le ferai !"
msgstr "Aku bakal pulang, kabarin aku ya. Aku udah bilang bakal bantu, dan aku bakal lakuin itu!"

#. Character:`saito` | Attributes:`sad`
msgctxt "asami_truth_9e381748"
msgid "Je sais ce que tu vas dire à son sujet mais..."
msgstr "Aku tau apa yang mau kamu bilang soal dia tapi..."

#. Character:`asami` | Attributes:`upset`
msgctxt "asami_truth_75a10874"
msgid "Ne t'en fais pas, je me fiche de cet idiot. Ce qui m'inquiète c'est {{noriko.n}}."
msgstr "Santai aja, aku gak peduli sama bodoh itu. Yang bikin aku khawatir itu {{noriko.n}}."

#. Character:`saito` | Attributes:`happy`
msgctxt "asami_truth_16f70965"
msgid "Je te promets qu'on trouvera le problème, d'accord ?"
msgstr "Aku janji kita bakal cari masalahnya, oke?"

#. Character:`asami` | Attributes:`sad`
msgctxt "asami_truth_4793ef5b"
msgid "Il faut faire vite, je ne supporterais plus de la voir comme ça longtemps."
msgstr "Kita harus cepet, aku gak bakal tahan liat dia kayak gini lama-lama."

#. Character:`asami`
msgctxt "asami_truth_4f7d0a73"
msgid "Je vais rentrer, ma mère doit m'attendre."
msgstr "Aku bakal pulang, ibu aku pasti nungguin."

#. Character:`saito`
msgctxt "asami_truth_75c4d25b"
msgid "Sois prudente sur le retour."
msgstr "Hati-hati waktu pulang."

#. Character:`asami` | Attributes:`happy`
msgctxt "asami_truth_b69a5fcc"
msgid "Comme toujours !"
msgstr "Seperti biasa!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "asami_truth_b1671e86"
msgid "Avec ça, peut-être qu..."
msgstr "Dengan ini, mungkin aja..."

#. Character:`saito`
msgctxt "asami_truth_3080fcdb"
msgid "TOI !"
msgstr "LU!"

#. Character:`saito`
msgctxt "asami_truth_82621661"
msgid "J'AI DEUX MOTS À TE DIRE !"
msgstr "AKU PUNYA DUA KATA BUAT KAMU!"

#. Character:`noriko`
msgctxt "asami_truth_4543e5f3"
msgid "Mais..."
msgstr "Tapi..."

#. Character:`nobu`
msgctxt "asami_truth_36e176cf"
msgid "Eh bien alors ?! {{saito.n}} le déchet pète les plombs ?"
msgstr "Nah loh?! {{saito.n}} si bangsat itu kebakaran jenggot ya?"

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "asami_truth_3eba51df"
msgid "Hgnnn..."
msgstr "Hgnnn..."

#. Character:`narrator`
msgctxt "t5ac66d11c5"
msgid "VA BIEN TE FAIRE FOUTRE !"
msgstr "JALAN KAMU MAKAN TAI!"

#. Character:`saito`
msgctxt "asami_truth_a5ec6c91"
msgid "Je te préviens {{noriko.n}} j'en ai ras le bas de tes..."
msgstr "Aku peringatkan kamu {{noriko.n}}, aku udah muak banget sama..."

#. Character:`narrator`
msgctxt "asami_truth_4564f99b"
msgid "Oh tu ne pourras pas te cacher derrière {{yasuka.n}} cette fois-ci !"
msgstr "Oh, kali ini kamu gak bisa sembunyi di balik {{yasuka.n}}!"

#. Character:`asami`
msgctxt "asami_truth_8362b00d"
msgid "Est-ce que ça va {{saito.n}} ?"
msgstr "Aku baik-baik aja nggak sih {{saito.n}}?"

#. Character:`asami`
msgctxt "asami_truth_a0685e03"
msgid "Ma mere m'a racontée ce qu'il s'était passé hier soir devant le konbini."
msgstr "Ibu aku cerita soal kejadian tadi malam depan konbini."

#. Character:`asami`
msgctxt "asami_truth_60a4cdce"
msgid "Tu aurais dû venir, je me serais occupée de toi !"
msgstr "Seharusnya kamu dateng, aku bakal urusin kamu!"

#. Character:`saito`
msgctxt "asami_truth_1b50c802"
msgid "C'était pas aussi grave que ça en avait l'air... Je me suis reposé et maintenant je pète la forme !"
msgstr "Gak separah yang kelihatan kok... Aku udah istirahat dan sekarang aku lagi fit banget!"

#. Character:`kimochi`
msgctxt "asami_truth_fb85c1b3"
msgid "C'était qui ? {{kenji.n}} ?"
msgstr "Itu siapa? {{kenji.n}}?"

#. Character:`saito`
msgctxt "asami_truth_f9362822"
msgid "Oui... C'était bien plus difficile qu'avec {{nobu.n}} mais au final je crois que prendre des coups assez souvent a fini par me faire gagner en endurance."
msgstr "Iya... Jauh lebih susah dibanding sama {{nobu.n}} tapi akhirnya aku rasa kena pukul terus malah bikin stamina aku jadi kuat."

#. Character:`kimochi`
msgctxt "asami_truth_fe7f2a05"
msgid "Dans ce cas-là je suis immortel !"
msgstr "Kalau gitu aku kebal maut nih!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "asami_truth_1c2fd513"
msgid "Vous allez me rendre folle !"
msgstr "Kalian bikin aku gila!"

#. Character:`kimochi` | Attributes:`think`
msgctxt "asami_truth_e2fad4c1"
msgid "Alors quel est le programme du jour."
msgstr "Jadi, rencana hari ini apa?"

#. Character:`saito` | Attributes:`upset`
msgctxt "asami_truth_a4c9caf7"
msgid "Je vais aller botter le cul de {{takeo.n}}."
msgstr "Aku bakal pergi nyepak pantat {{takeo.n}}."

#. Character:`saito`
msgctxt "asami_truth_0906ccd4"
msgid "Et par la même occasion je vais récupérer l'argent que tous ces connards m'ont volé depuis toutes ces années."
msgstr "Sekalian juga aku bakal ambil duit yang semua bajingan itu curi dari aku selama bertahun-tahun."

#. Character:`asami` | Attributes:`sad`
msgctxt "asami_truth_c52576c3"
msgid "Et pour {{noriko.n}} ?"
msgstr "Kalau buat {{noriko.n}} gimana?"

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "asami_truth_4b348165"
msgid "Oui c'est vrai ça !"
msgstr "Iya bener juga!"

#. Character:`saito`
msgctxt "asami_truth_31670bc3"
msgid "Elle a des problèmes et je pense que c'est lié à {{akira.n}}."
msgstr "Dia lagi ada masalah dan aku pikir itu ada hubungannya sama {{akira.n}}."

#. Character:`saito`
msgctxt "asami_truth_1fbad250"
msgid "Elle doit le retrouver ce soir pour lui donner une réponse."
msgstr "Dia harus ketemu dia malam ini buat ngasih jawaban."

#. Character:`saito`
msgctxt "asami_truth_601cb8f1"
msgid "En repensant à la conversation que j'ai eue avec elle ce matin, j'ai comme l'impression qu'elle se sacrifie."
msgstr "Kalo inget obrolan aku sama dia pagi ini, rasanya dia kayak lagi ngorbanin diri."

#. Character:`asami` | Attributes:`surprised`
msgctxt "asami_truth_5b0a0117"
msgid "Se sacrifier ? Mais pour quelle raison ?"
msgstr "Ngorbanin diri? Tapi buat alasan apa?"

#. Character:`saito` | Attributes:`sad`
msgctxt "asami_truth_e16c4917"
msgid "Elle pense qu'avec tout le mal qu'elle a fait elle ne mérite pas de fin heureuse..."
msgstr "Dia pikir dengan semua salah yang udah dia lakuin, dia nggak pantas dapet akhir yang bahagia..."

#. Character:`kimochi`
msgctxt "asami_truth_8e0573e2"
msgid "T'es sûr que vous êtes pas frère et sœur ?"
msgstr "Kamu yakin kalian bukan saudara?"

#. Character:`saito` | Attributes:`upset`
msgctxt "asami_truth_c2cffe85"
msgid "..."
msgstr "..."

#. Character:`kimochi`
msgctxt "asami_truth_2df43078"
msgid "Parce que préférer se sacrifier, gérer les choses par soi-même, ça me rappelle quelqu'un que je connais."
msgstr "Soalnya milih buat ngorbanin diri, ngurus semuanya sendiri, itu ngingetin aku sama seseorang yang aku kenal."

#. Character:`saito` | Attributes:`sad`
msgctxt "asami_truth_212d13a8"
msgid "Je sais..."
msgstr "Aku tau..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "asami_truth_1f48a5f9"
msgid "J'aurai bientôt le fin mot de cette histoire !"
msgstr "Aku bakal segera dapet jawaban pasti dari cerita ini!"

#. Character:`saito` | Attributes:`upset`
msgctxt "asami_truth_c45435e2"
msgid "Pour le moment je dois faire comprendre aux thugs qu'ils ne pourront plus avoir le dessus sur moi."
msgstr "Buat sekarang aku harus bikin para preman itu ngerti kalo mereka nggak bakal bisa nguasain aku lagi."

#. Character:`asami` | Attributes:`happy`
msgctxt "asami_truth_dc66bd01"
msgid "Il ne reste qu'à trouver le dernier de ces trois idiots."
msgstr "Tinggal nyari satu idiot terakhir dari tiga ini aja."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "asami_truth_556dd5b6"
msgid "Inutile je sais où ils sont, devant le dojo."
msgstr "Gak perlu, aku tau mereka di mana, di depan dojo."

#. Character:`saito`
msgctxt "asami_truth_876a3018"
msgid "Parfait, on va régler ça tout de suite."
msgstr "Sip, kita bakal beresin ini sekarang juga."

#. Character:`narrator`
msgctxt "asami_truth_07d0b210"
msgid "J'ai beau dire à {{yasuka.n}} qu'il n'arrivera rien à {{noriko.n}}. Tout ça ressemble étrangement à la situation de ma précédente vie."
msgstr "Udah aku bilang ke {{yasuka.n}} gak bakal terjadi apa-apa sama {{noriko.n}}. Tapi semuanya ini anehnya mirip banget sama situasi hidup aku sebelumnya."

#. Character:`narrator`
msgctxt "asami_truth_2ee7939c"
msgid "Est-ce que c'est cette ordure qui l'avait tuée ?"
msgstr "Apa itu bajingan yang ngebunuh dia?"

#. Character:`narrator`
msgctxt "asami_truth_39351170"
msgid "Si c'est le cas... Il doit être mis hors d'état de nuire...[w] définitivement."
msgstr "Kalau iya... Dia harus dibikin gak berbahaya...[w] selamanya."

#. Character:`narrator`
msgctxt "asami_truth_a69ff185"
msgid "Mais est-ce que j'en serais capable...?"
msgstr "Tapi apa aku sanggup...?"

#. Character:`yasuka`
msgctxt "asami_truth_2afafce4"
msgid "Je dois leur preparer un repas qu'ils n'oublieront pas de sitôt."
msgstr "Aku harus siapin makanan yang gak bakal mereka lupain dalam waktu lama."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "asami_truth_50e1bcb2"
msgid "À cette heure-ci je n'ai pas d'autre choix que d'aller au konbini."
msgstr "Jam segini aku gak punya pilihan lain selain ke konbini."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "asami_truth_bc057949"
msgid "Ohlala, je ne tiens plus en place !"
msgstr "Astaga, aku udah gak sabar banget!"

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "asami_truth_37ef3729"
msgid "Je dois me dépêcher !"
msgstr "Aku harus buru-buru!"

#. Character:`saito`
msgctxt "asami_truth_10a3f9db"
msgid "Au fait, cette histoire de récompense c'était quoi ?"
msgstr "Ngomong-ngomong, cerita soal hadiah itu apa sih?"

#. Character:`noriko`
msgctxt "asami_truth_00453ba9"
msgid "Ne sois pas si impatient, ça nécessite un peu de préparation."
msgstr "Jangan terlalu buru-buru, itu butuh persiapan dulu."

#. Character:`noriko` | Attributes:`angry`
msgctxt "asami_truth_c9985ca3"
msgid "Rejoins-moi dans ma chambre demain en fin d'après midi et tu verras bien..."
msgstr "Besok sore aja dateng ke kamarku, nanti kamu bakal tahu..."

#. Character:`saito`
msgctxt "asami_truth_55099618"
msgid "Besoins de préparation ?"
msgstr "Butuh persiapan?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "asami_truth_53520d54"
msgid "Ne me dites pas qu'elle va tenter de cuisiner quelque chose pour moi ?"
msgstr "Jangan bilang dia mau masak sesuatu buat aku?"

#. Character:`saito`
msgctxt "asami_truth_0f113e38"
msgid "Tiens qu'est-ce que tu fais là ?"
msgstr "Eh, kamu ngapain di sini?"

#. Character:`asami`
msgctxt "asami_truth_d3ccc383"
msgid "Je venais pour une petite visite mais je suis tombée sur {{noriko.n}}."
msgstr "Aku cuma mau mampir bentar tapi ketemu {{noriko.n}}."

#. Character:`asami` | Attributes:`pouting`
msgctxt "asami_truth_d6ad52d2"
msgid "Elle semblait nerveuse, j'ai cru qu'il t'était arrivé quelque chose mais elle n'a rien voulu me dire."
msgstr "Dia keliatan gugup, aku kira ada yang terjadi sama kamu tapi dia gak mau cerita apa-apa."

#. Character:`saito` | Attributes:`sad`
msgctxt "asami_truth_0f3fce43"
msgid "Je crois qu'il y a un problème... Je vais aller la chercher."
msgstr "Kayaknya ada masalah... Aku bakal cari dia."

#. Character:`asami` | Attributes:`happy`
msgctxt "asami_truth_215d0806"
msgid "Enfin ! Je commençais à m'ennuyer à mourir ! Tu veux un coup de main ?"
msgstr "Akhirnya! Aku mulai bosen banget! Mau aku bantuin?"

#. Character:`saito`
msgctxt "asami_truth_3d7fec40"
msgid "Non, ne t'en fais pas, je sais où elle se trouve..."
msgstr "Nggak, santai aja, aku tahu dia ada di mana..."

#. Character:`asami` | Attributes:`pouting`
msgctxt "asami_truth_cf90ea5a"
msgid "Vraiment ?"
msgstr "Seriusan?"

#. Character:`saito` | Attributes:`happy`
msgctxt "asami_truth_d59c6ff7"
msgid "Demain nous pourrons enfin passer du temps ensemble."
msgstr "Besok kita akhirnya bisa ngabisin waktu bareng."

#. Character:`asami` | Attributes:`neutral`
msgctxt "asami_truth_03572045"
msgid "Mhh... D'accord... J'espère juste que ce n'est pas trop grave."
msgstr "Hmm... Oke... Aku cuma harap ini nggak terlalu parah."

#. Character:`saito`
msgctxt "asami_truth_e6c30045"
msgid "Ça ira, cette fois-ci je peux l'aider !"
msgstr "Gak apa-apa, kali ini aku bisa bantu dia!"

#. Character:`asami`
msgctxt "asami_truth_0d7b9a51"
msgid "Dans ce cas... A demain sans faute !"
msgstr "Kalau gitu... Sampai besok, jangan sampai lupa!"

#. Character:`kimochi`
msgctxt "tbe393183c7"
msgid "C'est ici !"
msgstr "Ini dia!"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "td10bfda998"
msgid "Mais dépêche toi bon sang !"
msgstr "Cepetin dong, sialan!"

#. Character:`saito` | Attributes:`sad`
msgctxt "tb90ee67070"
msgid "Ne me dis pas que..."
msgstr "Jangan bilang kalau..."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "t6dc9d5e38b"
msgid "Si {{saito.n}}, l'avenir du monde est en jeu et tout ça se joue aujourd'hui !"
msgstr "Kalau {{saito.n}}, masa depan dunia lagi dipertaruhkan dan semua ini terjadi hari ini!"

#. Character:`saito`
msgctxt "t0fdce11ac1"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "t0f2d5d4eaa"
msgid "Mais pourquoi je continue de traîner avec un cas pareil ?"
msgstr "Kenapa ya aku masih aja nongkrong sama orang kayak gini?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "te136f0ad57"
msgid "Je vais continuer de réfléchir a une solution."
msgstr "Aku bakal terus mikirin solusi."

#. Character:`kimochi`
msgctxt "t66fe6d00e1"
msgid "Une, qui ne nous mettrait pas dans une position inconfortable ne t'inquiète pas."
msgstr "Une, yang nggak bakal bikin kita ngerasa nggak nyaman, santai aja."

#. Character:`saito`
msgctxt "t294fdd6c74"
msgid "Merci... Si effectivement {{minato.n}} a le bras long et qu'il a des contacts haut placé..."
msgstr "Makasih... Emang bener sih {{minato.n}} punya pengaruh gede dan punya koneksi orang penting..."

#. Character:`saito` | Attributes:`upset`
msgctxt "t601fd93f4e"
msgid "Il sera plus facile pour lui de nous mettre hors-jeu."
msgstr "Dia bakal lebih gampang buat ngejelasin kita keluar dari permainan."

#. Character:`kimochi`
msgctxt "t156b5309ac"
msgid "Tu as raison."
msgstr "Kamu bener."

#. Character:`narrator`
msgctxt "t66a53009a6"
msgid "Toute cette histoire avec {{chiaki.n}} me fait penser qu'elle n'est pas la seule personne qui a besoins d'aide."
msgstr "Semua cerita ini tentang {{chiaki.n}} bikin aku mikir kalau dia bukan satu-satunya yang butuh bantuan."

#. Character:`narrator`
msgctxt "t73b3872316"
msgid "Dans ma vie précédente je n'avais jamais interagi avec {{asami.n}} mais elle avait disparue a peu près à ce moment."
msgstr "Di hidup aku sebelumnya, aku nggak pernah berinteraksi sama {{asami.n}} tapi dia hilang sekitar waktu itu."

#. Character:`narrator`
msgctxt "ta571a32723"
msgid "Sauf que cette fois si elle semble passer quelques jours avec son père... Cela devrait la tenir a distance des problèmes."
msgstr "Cuma kali ini dia kayaknya lagi ngabisin beberapa hari sama ayahnya... Seharusnya itu bikin dia jauh dari masalah."

#. Character:`narrator`
msgctxt "te19eb44523"
msgid "Le cours de l'histoire a probablement déjà changé."
msgstr "Jalur ceritanya mungkin udah berubah."

#. Character:`narrator`
msgctxt "te0d5f62add"
msgid "Néanmoins... Je ne me sens pas tranquille."
msgstr "Tapi... aku nggak merasa tenang."

#. Character:`noriko`
msgctxt "t9e88207b0f"
msgid "C'est bon ? Tête de bite est rentré chez lui ?"
msgstr "Udah? Si anjing bodoh itu udah pulang?"

#. Character:`saito` | Attributes:`happy`
msgctxt "t592d7698c8"
msgid "Oui il vient de partir."
msgstr "Iya dia baru aja pergi."

#. Character:`noriko` | Attributes:`bad`
msgctxt "t03f8cd2c9e"
msgid "Suis moi !"
msgstr "Ikutin aku!"

#. Character:`saito`
msgctxt "INSTALLONS_QUELQUES_AFFICHES_I_A31B13"
msgid "Installons quelques affiches ici."
msgstr "Pasang beberapa poster di sini."

#. Character:`saito`
msgctxt "BON_A_DEVRAIT_SUFFIRE_POUR_ICI_793924"
msgid "Bon, ça devrait suffire pour ici, allons voir du côté du konbini."
msgstr "Oke, seharusnya cukup di sini, ayo kita cek di konbini."

#. Character:`kimochi`
msgctxt "SAITO_N_C_EST_LA_MERDE_A2D1FD"
msgid "{{saito.n}} !! C'est la merde !!"
msgstr "{{saito.n}} !! Ini gila banget!!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "QUOI_DOUCEMENT_EXPLIQUE_MOI_CE_007D72"
msgid "Quoi ?! Doucement, explique-moi ce qu'il se passe !!"
msgstr "Apa?! Santai, jelasin ke aku apa yang terjadi!!"

#. Character:`kimochi`
msgctxt "NON_J_AI_PAS_LE_TEMPS_D_Y_ALLE_933C06"
msgid "Non ! J'ai pas le temps d'y aller doucement !"
msgstr "Gak! Aku gak sempet santai!"

#. Character:`kimochi`
msgctxt "MACUMBA_N_A_DES_PROBL_MES_C0DCAF"
msgid "{{macumba.n}} a des problèmes !"
msgstr "{{macumba.n}} lagi ada masalah!"

#. Character:`kimochi`
msgctxt "LA_POLICE_EST_EN_TRAIN_DE_L_AR_1AEB7A"
msgid "La police est en train de l'arrêter !!!"
msgstr "Polisi lagi nangkep dia!!!"

#. Character:`saito`
msgctxt "OH_BORDEL_NON_PAS_A_AAB760"
msgid "Oh bordel, non, pas ça !!"
msgstr "Sialan, bukan ini!!"

#. Character:`saito` | Attributes:`upset`
msgctxt "O_SONT_ILS_29FA67"
msgid "Où sont-ils ?"
msgstr "Mereka dimana?"

#. Character:`kimochi`
msgctxt "AU_PARC_D_P_CHE_TOI_A07336"
msgid "Au parc ! Dépêche-toi !"
msgstr "Di taman! Cepetan!"

#. Character:`narrator`
msgctxt "NON_NON_NON_TOUT_EST_EN_TRAIN_D4194D"
msgid "Non non non... Tout est en train de se reproduire comme avant !"
msgstr "Gak, gak, gak... Semuanya mulai kejadian lagi kayak dulu!"

#. Character:`narrator`
msgctxt "MES_ACTIONS_N_ONT_EU_AUCUNE_CO_D3697B"
msgid "Mes actions n'ont eu aucune conséquence..."
msgstr "Tindakan aku gak ngasih pengaruh apa-apa..."

#. Character:`cop`
msgctxt "JE_SUIS_D_SOL_MONSIEUR_NOUS_N_CB6EFD"
msgid "Je suis désolé, monsieur, nous n'avons pas réussi à arriver à temps."
msgstr "Maaf, Pak, kita gak berhasil sampai tepat waktu."

#. Character:`minato` | Attributes:`suspicious`
msgctxt "JE_SUIS_QUAND_M_ME_SURPRIS_DE_6F9BD2"
msgid "Je suis quand même surpris de le voir capable d'autant de ressources."
msgstr "Aku masih kaget liat dia bisa punya segudang cara gitu."

#. Character:`minato`
msgctxt "PENSER_QU_IL_IRAIT_JUSQU_FUIR_9E6075"
msgid "Penser qu'il irait jusqu'à fuir la police... Il y a quelques semaines de ça, cela aurait été impossible."
msgstr "Aku gak nyangka dia bakal sampe lari dari polisi... Beberapa minggu lalu, itu mustahil banget."

#. Character:`cop`
msgctxt "NOUS_ALLONS_METTRE_AUTANT_D_HO_13F5D2"
msgid "Nous allons mettre autant d'hommes que possible sur cette affaire !"
msgstr "Kita bakal turunin sebanyak mungkin orang buat kasus ini!"

#. Character:`cop` | Attributes:`bad`
msgctxt "IL_NE_POURRA_PLUS_ALLER_BIEN_L_6E9F80"
msgid "Il ne pourra plus aller bien loin à présent, son portrait a été diffusé partout, il est activement recherché."
msgstr "Dia gak bakal kemana-mana lagi sekarang, wajahnya udah tersebar dimana-mana, dia lagi dikejar banget."

#. Character:`minato`
msgctxt "PARFAIT_J_ATTENDS_DE_VOS_NOUVE_AA6BC5"
msgid "Parfait, j'attends de vos nouvelles."
msgstr "Sip, aku tunggu kabar dari kalian."

#. Character:`natsume`
msgctxt "C_TAIT_DONC_A_7B0DD3"
msgid "C'était donc ça..."
msgstr "Jadi itu dia..."

#. Character:`minato` | Attributes:`happy`
msgctxt "QU_AS_TU_PENS_DE_MON_PLAN_4A382B"
msgid "Qu'as-tu pensé de mon plan ?"
msgstr "Aku pengen tau, gimana menurut kamu soal rencanaku?"

#. Character:`natsume`
msgctxt "QU_IL_NE_FAUT_SURTOUT_PAS_DEVE_1578D0"
msgid "Qu'il ne faut surtout pas devenir ton ennemi."
msgstr "Jangan sampai dia jadi musuh kamu, ya."

#. Character:`minato`
msgctxt "PR_CIS_MENT_5F3D37"
msgid "Précisément !"
msgstr "Bener banget!"

#. Character:`minato` | Attributes:`upset`
msgctxt "RETROUVE_LE_417FB4"
msgid "Retrouve-le !"
msgstr "Cari dia!"

#. Character:`natsume`
msgctxt "TU_PENSES_QUE_JE_FERAI_MIEUX_Q_809FE1"
msgid "Tu penses que je ferai mieux que la police ?"
msgstr "Kamu pikir aku bakal lebih jago dari polisi?"

#. Character:`minato`
msgctxt "QUOI_TU_ME_SERS_SINON_DF6441"
msgid "À quoi tu me sers sinon ?"
msgstr "Kamu ngapain aku kalau nggak buat itu?"

#. Character:`natsume` | Attributes:`afraid`
msgctxt "JE_FAIS_QUOI_QUAND_JE_L_AURAI_ACDE63"
msgid "Je fais quoi quand je l'aurai retrouvé ?"
msgstr "Aku harus ngapain kalau udah nemuin dia?"

#. Character:`minato` | Attributes:`neutral`
msgctxt "GAGNE_SA_CONFIANCE_S_DUIS_LE_J_97F2CE"
msgid "Gagne sa confiance, séduis-le, je suis certain qu'il n'est pas insensible à tes charmes."
msgstr "Dapetin kepercayaannya, goda dia, aku yakin dia nggak kebal sama pesona kamu."

#. Character:`minato`
msgctxt "FAIS_LUI_CROIRE_QU_IL_RESTE_EN_0BAF19"
msgid "Fais-lui croire qu'il reste encore un espoir d'arranger et de renverser toute cette situation."
msgstr "Buat dia percaya masih ada harapan buat ngerapihin dan ngebalikinn semua situasi ini."

#. Character:`minato`
msgctxt "FAIS_LUI_PENSER_QU_IL_EST_ENCO_580214"
msgid "Fais-lui penser qu'il est encore possible de la sauver."
msgstr "Buat dia mikir masih mungkin buat nyelamatin dia."

#. Character:`natsume` | Attributes:`shame`
msgctxt "JE_NE_COMPRENDS_TOUJOURS_PAS_DEF291"
msgid "... Je ne comprends toujours pas pourquoi tu t'acharnes autant sur lui, mais je ne poserai plus de questions."
msgstr "... Aku masih nggak ngerti kenapa kamu ngejar dia segitunya, tapi aku nggak bakal nanya lagi."

#. Character:`minato` | Attributes:`happy`
msgctxt "BRAVE_FILLE_A84379"
msgid "Brave fille."
msgstr "Cewek pemberani."

#. Character:`minato`
msgctxt "NE_CHERCHE_PAS_COMPRENDRE_C_ES_77ACF7"
msgid "Ne cherche pas à comprendre, c'est juste un jeu, un divertissement."
msgstr "Jangan coba-coba ngerti, ini cuma game, hiburan doang."

#. Character:`natsume`
msgctxt "_1BCFD4"
msgid "..."
msgstr "..."

#. Character:`yasuka`
msgctxt "QU_EST_CE_QUI_SE_PASSE_JE_N_AI_7E8B95"
msgid "Qu'est-ce qui se passe ? Je n'ai jamais demandé à avoir quelqu'un en face de chez moi !"
msgstr "Ada apa sih? Aku nggak pernah minta ada orang nongkrong depan rumah aku!"

#. Character:`cop`
msgctxt "MADAME_L_INDIVIDU_QUE_VOUS_H_B_87CD45"
msgid "Madame, l'individu que vous hébergiez est dangereux et tout à fait susceptible de venir prendre contact avec vous."
msgstr "Bu, orang yang kamu tampung itu berbahaya dan bener-bener bisa aja dateng buat nyamperin kamu."

#. Character:`cop`
msgctxt "VOUS_NE_SEMBLEZ_PAS_DISPOS_E_C_966EBC"
msgid "Vous ne semblez pas disposée à coopérer, nous devons donc prendre nos dispositions."
msgstr "Kamu kayaknya nggak mau kerja sama, jadi kita harus ambil langkah."

#. Character:`cop` | Attributes:`bad`
msgctxt "IL_POURRAIT_TOUT_AUSSI_BIEN_S_530C69"
msgid "Il pourrait tout aussi bien s'en prendre à vous en pensant qu'il aurait été dénoncé par sa famille."
msgstr "Dia juga bisa aja nyerang kamu karena mikir dia udah dilaporin keluarga."

#. Character:`sayuri` | Attributes:`upset`
msgctxt "VOUS_VOUS_FOUTEZ_DE_NOTRE_GUEU_84C570"
msgid "Vous vous foutez de notre gueule ?! Il n'y a aucun moyen que {{saito.n}} fasse ce genre de choses."
msgstr "Kamu ngejek aku?! Nggak mungkin {{saito.n}} ngelakuin hal kayak gitu."

#. Character:`sayuri`
msgctxt "TOUT_A_N_EST_QU_UN_FOUTU_COU_935DB2"
msgid "Tout ça n'est qu'un foutu cou—"
msgstr "Semua ini cuma omong kosong—"

#. Character:`yasuka` | Attributes:`upset`
msgctxt "SAYURI_N_0B77D1"
msgid "{{sayuri.n}} !"
msgstr "{{sayuri.n}}!"

#. Character:`cop` | Attributes:`angry`
msgctxt "MADAME_VOUS_DEVENEZ_HYST_RIQUE_D7A407"
msgid "Madame, vous devenez hystérique. Soit vous vous calmez, soit je vous embarque avec moi pour trouble sur la voie publique !"
msgstr "Bu, kamu mulai histeris. Tenangin diri kamu, atau aku bakal bawa kamu karena bikin keributan di tempat umum!"

#. Character:`yasuka`
msgctxt "RENTRONS_L_INT_RIEUR_IL_NE_SER_E2CADF"
msgid "Rentrons à l'intérieur, il ne sert à rien de s'énerver ici."
msgstr "Ayo balik ke dalam, nggak guna marah-marah di sini."

#. Character:`yasuka`
msgctxt "CE_SERAIT_CONTRE_PRODUCTIF_A1E9E9"
msgid "Ce serait contre-productif."
msgstr "Itu bakal jadi kontraproduktif."

#. Character:`cop` | Attributes:`happy`
msgctxt "ET_BONNE_JOURN_E_MESDAMES_189F07"
msgid "Et bonne journée, mesdames."
msgstr "Selamat hari, para wanita."

#. Character:`sayuri`
msgctxt "MON_DIEU_JE_VOULAIS_TELLEMENT_E24D23"
msgid "Mon dieu, je voulais tellement lui faire bouffer sa propre casquette !"
msgstr "Ya ampun, aku pengen banget bikin dia makan topinya sendiri!"

#. Character:`yasuka`
msgctxt "TU_ES_TOUJOURS_AUSSI_VULGAIRE_EBA814"
msgid "Tu es toujours aussi vulgaire quand tu t'énerves, toi..."
msgstr "Kamu masih kasar banget pas marah, ya..."

#. Character:`narrator`
msgctxt "MERDE_LE_VIEUX_AVAIT_RAISON_E79FEA"
msgid "Merde, le vieux avait raison..."
msgstr "Sial, si tua itu bener..."

#. Character:`narrator`
msgctxt "IL_M_EST_IMPOSSIBLE_DE_RETOURN_E2DAE6"
msgid "Il m'est impossible de retourner les voir, même discrètement."
msgstr "Aku gak mungkin balik buat liat mereka lagi, bahkan diam-diam sekalipun."

#. Character:`narrator`
msgctxt "J_AURAIS_AU_MOINS_VOULU_CROISE_D36773"
msgid "J'aurais au moins voulu croiser leur regard à travers la fenêtre, même juste une seconde."
msgstr "Setidaknya aku pengen liat matanya dari jendela, walau cuma sedetik."

#. Character:`narrator`
msgctxt "BON_VITONS_DE_TRA_NER_ICI_A_PO_37A2C7"
msgid "Bon, évitons de traîner ici, ça pourrait devenir dangereux."
msgstr "Oke, mending jangan nongkrong di sini, bisa bahaya."

#. Character:`narrator`
msgctxt "PEUT_TRE_QUE_J_AURAI_PLUS_DE_C_8F39C7"
msgid "Peut-être que j'aurai plus de chance avec {{kimochi.n}}."
msgstr "Mungkin aku bakal lebih beruntung sama {{kimochi.n}}."

#. Character:`kimochi`
msgctxt "NOUS_DEVRIONS_TRE_TRANQUILLES_8F14E8"
msgid "Nous devrions être tranquilles à présent !"
msgstr "Sekarang kita harusnya aman!"

#. Character:`kimochi`
msgctxt "O_EST_ELLE_PASS_E_006FAD"
msgid "Où est-elle passée ?"
msgstr "Dia pergi ke mana ya?"

#. Character:`noriko`
msgctxt "AAAAH_MAIS_COMMENT_A_SE_FAIT_8C77EA"
msgid "... Aaaah, mais comment ça se fait que tu cours aussi vite ?"
msgstr "... Aaaah, tapi gimana sih kamu bisa lari secepat itu?"

#. Character:`kimochi`
msgctxt "ENTRA_NEMENT_AVEC_MACUMBA_N_F705E0"
msgid "Entraînement avec {{macumba.n}} !"
msgstr "Latihan sama {{macumba.n}}!"

#. Character:`kimochi`
msgctxt "DIFFICULT_LEV_E_MAIS_R_SULTATS_BEDB5B"
msgid "Difficulté élevée, mais résultats garantis."
msgstr "Sulit banget, tapi hasilnya dijamin."

#. Character:`noriko`
msgctxt "LAISSE_MOI_REPRENDRE_MON_SOUFF_D890AE"
msgid "Laisse-moi reprendre mon souffle, je vais mourir."
msgstr "Biar aku tarik napas dulu, aku kayaknya mau mati nih."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "MONSIEUR_L_AGENT_S_IL_VOUS_PLA_FA3074"
msgid "Monsieur l'agent, s'il vous plaît, aidez-nous ! Nous sommes poursuivis par trois personnes qui nous veulent du mal !"
msgstr "Pak polisi, tolong dong, bantu kami! Ada tiga orang yang ngejar kita dan pengen nyakitin!"

#. Character:`cop` | Attributes:`bad`
msgctxt "TIENS_TIENS_TIENS_VOYEZ_QUI_RA_D54602"
msgid "Tiens tiens tiens, voyez qui rapplique ?"
msgstr "Wah wah wah, liat siapa yang dateng nih?"

#. Character:`cop`
msgctxt "FINALEMENT_VOUS_NE_POUVEZ_RIEN_C94039"
msgid "Finalement, vous ne pouvez rien faire sans nous."
msgstr "Ternyata kalian nggak bisa ngapa-ngapain tanpa kita ya."

#. Character:`cop`
msgctxt "JE_VAIS_M_OCCUPER_DE_A_B2E701"
msgid "Je vais m'occuper de ça !"
msgstr "Aku yang urus ini!"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "FONT_SIZE_14_EN_M_ME_TEMPS_C_154D68"
msgid "[font_size=14]En même temps, c'est votre travail ! Pourquoi on paie des impôts, sinon ?[/font_size]"
msgstr "[font_size=14]Tapi ya itu tugas kalian juga! Masa bayar pajak buat apa dong kalau nggak buat ini?[/font_size]"

#. Character:`cop`
msgctxt "ALORS_VOYONS_A_QUI_J_AI_AFFAIR_33977B"
msgid "Alors voyons ça... À qui j'ai affaire ?"
msgstr "Oke, kita lihat nih... Aku lagi ngomong sama siapa sih?"

#. Character:`takeo`
msgctxt "PAPA_QU_EST_CE_QUE_TU_FAIS_L_753982"
msgid "Papa ?!! Qu'est-ce que tu fais là ?!!"
msgstr "Papa?!! Kamu ngapain di sini?!!"

#. Character:`cop` | Attributes:`angry`
msgctxt "TAKEO_N_C_EST_QUOI_CET_ACCOUT_1A41DB"
msgid "{{takeo.n}} ? C'est quoi cet accoutrement ? Depuis quand tu t'habilles comme ça ?"
msgstr "{{takeo.n}}? Itu baju apa sih kamu? Sejak kapan kamu mulai dandan kayak gitu?"

#. Character:`cop`
msgctxt "ET_C_EST_QUI_CEUX_L_FDF150"
msgid "Et c'est qui, ceux-là ?"
msgstr "Terus yang itu siapa?"

#. Character:`nobu` | Attributes:`bad`
msgctxt "ON_EST_SES_MEILLEURS_POTES_E8F4B1"
msgid "On est ses meilleurs potes !"
msgstr "Kita sahabat akrabnya!"

#. Character:`cop`
msgctxt "TOUT_CE_QUE_JE_VOIS_CE_SONT_TR_56B90F"
msgid "Tout ce que je vois, ce sont trois putains de clowns !"
msgstr "Yang aku liat cuma tiga badut sialan doang!"

#. Character:`cop`
msgctxt "JE_TE_L_AI_D_J_DIT_CENT_FOIS_N_B19836"
msgid "Je te l'ai déjà dit cent fois, ne fais rien qui pourrait compromettre ma réputation !"
msgstr "Aku udah bilang ratusan kali, jangan ngelakuin hal yang bisa ngejatuhin nama aku!"

#. Character:`cop`
msgctxt "ATTENDS_QU_ON_RENTRE_CE_SOIR_E_1EDDB4"
msgid "Attends qu'on rentre ce soir et tu vas voir la branlée que tu vas prendre."
msgstr "Tunggu sampai malem kita pulang, kamu bakal liat tamparan yang bakal kamu dapet."

#. Character:`kimochi`
msgctxt "FONT_SIZE_14_WOAH_C_EST_ENCOR_BB6D0E"
msgid "[font_size=14]Woah, c'est encore mieux que ce que je pensais...[/font_size]"
msgstr "[font_size=14]Wah, ini malah lebih keren dari yang aku kira...[/font_size]"

#. Character:`noriko`
msgctxt "FONT_SIZE_14_TU_SAVAIS_QUE_SO_E0BA16"
msgid "[font_size=14]Tu savais que son père était dans la police ?[/font_size]"
msgstr "[font_size=14]Kamu tau gak kalo bokapnya dia polisi?[/font_size]"

#. Character:`kimochi`
msgctxt "FONT_SIZE_14_NON_JE_LE_D_COUV_5D00EE"
msgid "[font_size=14]Non, je le découvre en même temps que toi. Mais ça expliquerait pas mal de choses.[/font_size]"
msgstr "[font_size=14]Nggak, aku juga baru tau bareng kamu. Tapi itu bisa jelasin banyak hal sih.[/font_size]"

#. Character:`kimochi`
msgctxt "FONT_SIZE_14_LE_FAIT_QU_ILS_N_2828BD"
msgid "[font_size=14]Le fait qu'ils n'aient jamais été inquiétés, peu importe ce qu'ils font.[/font_size]"
msgstr "[font_size=14]Faktanya mereka nggak pernah kena masalah, apapun yang mereka lakuin.[/font_size]"

#. Character:`noriko`
msgctxt "FONT_SIZE_14_IL_A_D_PENSER_QU_720A35"
msgid "[font_size=14]Il a dû penser que son père le couvrirait, peu importe ce qu'il fait.[/font_size]"
msgstr "[font_size=14]Dia pasti mikir kalo ayahnya bakal nutupin dia, apapun yang dia lakuin.[/font_size]"

#. Character:`kimochi`
msgctxt "FONT_SIZE_14_RIEN_QUE_D_IMAGI_9D8486"
msgid "[font_size=14]Rien que d'imaginer {{takeo.n}} se faire punir par ses parents suffit à refaire ma journée... non, attends... ma semaine ![/font_size]"
msgstr "[font_size=14]Bayangin aja {{takeo.n}} kena hukum dari orang tuanya udah bikin hari aku jadi lebih baik... eh, tunggu... malah seminggu![/font_size]"

#. Character:`kenji` | Attributes:`disgusted`
msgctxt "ON_ON_VA_TE_LAISSER_ON_SE_RETR_A61ACE"
msgid "On... On va te laisser, on se retrouve plus tard..."
msgstr "Aku... Kita bakal ninggalin kamu dulu, nanti kita ketemu lagi..."

#. Character:`cop`
msgctxt "OH_QUE_NON_IL_N_Y_A_AUCUN_MOYE_3322A2"
msgid "Oh que non ! Il n'y a aucun moyen que je laisse mon fils traîner avec des délinquants comme vous."
msgstr "Oh nggak! Gak ada cara aku ngebiarin anak aku nongkrong sama preman kayak kalian."

#. Character:`takeo`
msgctxt "MAIS_PAPA_JE_2DCA85"
msgid "Mais papa... Je..."
msgstr "Tapi, Pa... Aku..."

#. Character:`cop`
msgctxt "SILENCE_TU_VAS_RENTRER_LA_MAIS_9240C5"
msgid "Silence ! Tu vas rentrer à la maison, te changer et étudier !"
msgstr "Diam! Kamu harus pulang, ganti baju, terus belajar!"

#. Character:`cop`
msgctxt "JE_ME_SUIS_BIEN_FAIT_COMPRENDR_0D236D"
msgid "Je me suis bien fait comprendre ?"
msgstr "Aku udah jelas, kan?"

#. Character:`takeo` | Attributes:`angry`
msgctxt "JE_NE_SUIS_PLUS_UN_GAMIN_J_AI_332907"
msgid "Je ne suis plus un gamin, j'ai passé 18 ans tu le sais !"
msgstr "Aku bukan bocah lagi, aku udah 18 tahun, kamu tau kan!"

#. Character:`cop`
msgctxt "CA_N_A_AUCUN_RAPPORT_2CF17C"
msgid "Ça n'a aucun rapport..."
msgstr "Itu nggak ada hubungannya sama sekali..."

#. Character:`takeo`
msgctxt "C_EST_TOUJOURS_PAREIL_AVEC_TOI_4F9D7A"
msgid "C'est toujours pareil avec toi, je ne peux jamais m'expliquer !"
msgstr "Aku selalu bilang gitu sama kamu, aku gak pernah bisa jelasin diri aku!"

#. Character:`cop`
msgctxt "TU_VEUX_VIVRE_TA_VIE_COMME_TU_79BBE7"
msgid "Tu veux vivre ta vie comme tu l'entends ? Alors trouve-toi un travail et un appartement."
msgstr "Kamu mau hidup sesuka kamu? Ya cari kerjaan sama apartemen sendiri dong."

#. Character:`cop`
msgctxt "TANT_QUE_TU_VIVRAS_SOUS_MON_TO_952C8D"
msgid "Tant que tu vivras sous mon toit, tu obéiras à mes règles !"
msgstr "Selama kamu masih tinggal di bawah atap aku, kamu harus nurut sama aturan aku!"

#. Character:`kimochi`
msgctxt "FONT_SIZE_14_HAHA_LE_MALAISE_8FB68F"
msgid "[font_size=14]Haha, le malaise... J'ai presque de la peine pour lui.[/font_size]"
msgstr "[font_size=14]Haha, awkward banget... Aku hampir kasian sama dia.[/font_size]"

#. Character:`noriko`
msgctxt "FONT_SIZE_14_JE_N_AIME_PAS_A_98AF7C"
msgid "[font_size=14]Je n'aime pas ça, ça me donne l'impression qu'il s'adresse aussi à moi.[/font_size]"
msgstr "[font_size=14]Aku gak suka nih, kayaknya dia ngomong ke aku juga.[/font_size]"

#. Character:`takeo`
msgctxt "PUTAIN_F6D757"
msgid "Putain !"
msgstr "Sialan!"

#. Character:`takeo`
msgctxt "VOUS_DEUX_JE_VOUS_AI_L_IL_SI_J_760410"
msgid "Vous deux ! Je vous ai à l'œil, si je vous recroise, vous êtes morts !"
msgstr "Kalian berdua! Aku awasin, kalo aku ketemu lagi, siap-siap aja!"

#. Character:`kimochi` | Attributes:`sad`
msgctxt "MONSIEUR_L_AGENT_VOUS_AVEZ_ENT_EAE482"
msgid "Monsieur l'agent, vous avez entendu comme moi ? Cet individu a proféré des menaces de mort à mon encontre !"
msgstr "Pak polisi, kamu denger gak kayak aku? Orang ini ngancem mau bunuh aku!"

#. Character:`cop` | Attributes:`disgusted`
msgctxt "JE_ME_FICHE_PERDUMENT_DE_CE_QU_792147"
msgid "Je me fiche éperdument de ce qui peut t'arriver, et si ça ne tenait qu'à moi, je t'aurais déjà refroidi il y a longtemps."
msgstr "Aku gak peduli apa yang terjadi sama kamu, dan kalo aku yang pegang kendali, udah aku bikin mati dari dulu."

#. Character:`cop`
msgctxt "VOTRE_EXISTENCE_NE_TIENT_PLUS_3696B5"
msgid "Votre existence ne tient plus qu'au bon vouloir d'une seule personne. Médite là-dessus et agis en conséquence !"
msgstr "Hidup kamu sekarang cuma bergantung sama satu orang. Pikirin itu dan bertindaklah sesuai!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "LAISSE_TOMBER_VIENS_LA_MAISON_61C231"
msgid "Laisse tomber, viens à la maison..."
msgstr "Lupakan aja, ikut aku pulang..."

#. Character:`saito` | Attributes:`upset`
msgctxt "love_hotel_exterior_70c72a3d"
msgid "Merde... Personne... Est-ce qu'ils sont déjà à l'intérieur ?"
msgstr "Sial... Gak ada orang... Apa mereka udah masuk ke dalam?"

#. Character:`saito`
msgctxt "love_hotel_exterior_c6a80c2f"
msgid "Putain, aucun moyen de le savoir."
msgstr "Sialan, gak ada cara buat tahu."

#. Character:`saito` | Attributes:`surprised`
msgctxt "love_hotel_exterior_2f0a0a01"
msgid "Une seconde...[w] C'est...[w] {{kimochi.n}} ?"
msgstr "Sebentar...[w] Ini...[w] {{kimochi.n}} ?"

#. Character:`kimochi`
msgctxt "love_hotel_exterior_50762b84"
msgid "Oh salut {{saito.n}}, toi aussi, tu traines en ville la nuit ?"
msgstr "Oh halo {{saito.n}}, kamu juga nongkrong di kota malam-malam?"

#. Character:`saito` | Attributes:`sad`
msgctxt "love_hotel_exterior_e0065b3f"
msgid "Pas vraiment, mais... Qu'est-ce que tu fais ici exactement ?"
msgstr "Gak juga sih, tapi... Kamu ngapain sih sebenernya di sini?"

#. Character:`kimochi`
msgctxt "love_hotel_exterior_81a0093f"
msgid "...Si c'est toi, je veux bien te le dire."
msgstr "...Kalau itu kamu, aku mau bilang deh."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "love_hotel_exterior_3532ed51"
msgid "Je prends en photo les couples qui vont au love hôtel."
msgstr "Aku foto-foto pasangan yang mau ke love hotel."

#. Character:`kimochi`
msgctxt "love_hotel_exterior_d2db3ccb"
msgid "Ça pourrait être utile comme moyen de pression."
msgstr "Bisa jadi cara buat ngancem juga nih."

#. Character:`saito` | Attributes:`surprised`
msgctxt "love_hotel_exterior_9912113c"
msgid "Donc... Tu fais ça pour faire chanter les gens ?"
msgstr "Jadi... Kamu ngelakuin itu buat ngeblackmail orang ya?"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "love_hotel_exterior_64949c29"
msgid "Seulement ceux qui me manquent de respect !"
msgstr "Cuma yang gak hormatin aku doang!"

#. Character:`saito` | Attributes:`sad`
msgctxt "love_hotel_exterior_25ac774f"
msgid "...[w] Peu importe, plus rien ne m'étonne avec toi."
msgstr "...[w] Gak peduli, aku udah gak kaget lagi sama kamu."

#. Character:`saito` | Attributes:`neutral`
msgctxt "love_hotel_exterior_80a47c9d"
msgid "Mais tu vas pouvoir m'aider à nouveau."
msgstr "Tapi kamu bakal bisa bantu aku lagi nih."

#. Character:`saito`
msgctxt "love_hotel_exterior_5cbdece1"
msgid "Est-ce que tu aurais vu un gros porc entrer avec une femme aux cheveux rouge ?"
msgstr "Kamu gak kebetulan liat babi gede masuk sama cewek rambut merah nggak?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "love_hotel_exterior_55b426d5"
msgid "Tu vas devoir être plus précis, des gros porcs qui vont au love hôtel, c'est assez courant."
msgstr "Kamu harus lebih jelas, babi gede yang ke love hotel itu lumayan biasa."

#. Character:`saito` | Attributes:`upset`
msgctxt "love_hotel_exterior_b6afbb9c"
msgid "Le patron du Coffee Boutique ! Le mec de l'autre jour que tu devais retenir."
msgstr "Bos Coffee Boutique! Cowok yang kemarin kamu harus inget itu."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "love_hotel_exterior_59191929"
msgid "Aaaah, {{netoru.n}} ? Oui, il est passé tout à l'heure."
msgstr "Aaaah, {{netoru.n}}? Iya, dia lewat tadi."

#. Character:`saito`
msgctxt "love_hotel_exterior_2c02998f"
msgid "Merde ! Est-ce qu'ils y sont entrés ?"
msgstr "Sial! Mereka udah masuk belum?"

#. Character:`kimochi` | Attributes:`sad`
msgctxt "love_hotel_exterior_83d33d8c"
msgid "Ho du calme ![w] Non, lui semblait le vouloir en tout cas, mais elle n'était pas d'accord."
msgstr "Santai dulu![w] Gak, dia kayaknya pengen sih, tapi ceweknya nolak."

#. Character:`kimochi` | Attributes:`think`
msgctxt "love_hotel_exterior_2dde09ab"
msgid "Maintenant que j'y pense... Je comprends mieux pourquoi il voulait de la milf..."
msgstr "Sekarang aku mikir... Aku makin paham kenapa dia pengen milf..."

#. Character:`kimochi`
msgctxt "love_hotel_exterior_b6cf4a9c"
msgid "Au moins, il sait qu'il est moche."
msgstr "Setidaknya dia sadar dia jelek."

#. Character:`kimochi`
msgctxt "love_hotel_exterior_ee810677"
msgid "Après, il s'est énervé et a continué à lui coller aux basques."
msgstr "Abis itu, dia kesel dan terus nempel terus sama dia."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "love_hotel_exterior_819d5a23"
msgid "Visiblement, il ne voulait pas lâcher l'affaire."
msgstr "Kelihatannya dia gak mau ngalah gitu aja."

#. Character:`saito` | Attributes:`angry`
msgctxt "love_hotel_exterior_2e5fbab0"
msgid "Putain ! Dans quelle direction ?!"
msgstr "Sialan! Arah mana sih?!"

#. Character:`kimochi`
msgctxt "love_hotel_exterior_abed959b"
msgid "Je crois qu'elle se dirigeait vers le [color=yellow]konbini[/color]."
msgstr "Kayaknya dia mau ke [color=yellow]konbini[/color]."

#. Character:`saito` | Attributes:`upset`
msgctxt "love_hotel_exterior_f8d43df4"
msgid "Parfait merci, je t'en devrais une !"
msgstr "Sip, makasih, aku bakal bales nih!"

#. Character:`kimochi`
msgctxt "love_hotel_exterior_3a722e95"
msgid "Non, maintenant, tu m'en dois deux."
msgstr "Nggak deh, sekarang kamu utang aku dua."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "love_hotel_exterior_ce09cca6"
msgid "Oh, mais... C'est mon ancien prof principal ça !"
msgstr "Oh, itu guru wali kelas aku dulu!"

#. Character:`saito`
msgctxt "love_hotel_exterior_e1250044"
msgid "Ça ne devrait plus être très loin."
msgstr "Seharusnya sih gak jauh lagi."

#. Character:`unknown`
msgctxt "love_hotel_exterior_982abe80"
msgid "CHOPEZ-LE !"
msgstr "TANGKAP DIA!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "love_hotel_exterior_b37e98ac"
msgid "Put-"
msgstr "Put-"

#. Character:`nobu`
msgctxt "love_hotel_exterior_a83d8eeb"
msgid "Personne dans le coin, attirez-le dans la ruelle à côté et défoncez-le !"
msgstr "Gak ada orang di sekitar? Tarik dia ke gang sebelah terus hajar habis!"

#. Character:`centered`
msgctxt "love_hotel_exterior_43843ac8"
msgid "{{saito.n}} se fit entrainer dans une ruelle sombre."
msgstr "{{saito.n}} terbawa masuk ke gang gelap."

#. Character:`centered`
msgctxt "love_hotel_exterior_8beb1479"
msgid "Les trois thugs le passèrent à tabac à long moment, avant de finalement récupérer son argent et de le laisser là."
msgstr "Tiga preman itu nggebukin dia lama banget, sebelum akhirnya ngambil duitnya dan ninggalin dia di situ."

#. Character:`takeo` | Attributes:`mocking`
msgctxt "love_hotel_exterior_7eba8098"
msgid "Ouhlala, mais c'est qu'il en avait des économies cet idiot !"
msgstr "Waduh, ternyata si idiot itu punya tabungan juga ya!"

#. Character:`kenji` | Attributes:`bad`
msgctxt "love_hotel_exterior_80316393"
msgid "Mec, se balader avec tout son fric sur soi quand on est une putain de cible sur pattes."
msgstr "Bro, jalan-jalan bawa duit segitu banyak padahal kamu target empuk banget."

#. Character:`nobu` | Attributes:`bad`
msgctxt "love_hotel_exterior_d82c7b50"
msgid "Je t'avais dit que je finirais par t'avoir et c'est que le début !"
msgstr "Aku udah bilang bakal dapetin kamu dan ini baru permulaan!"

#. Character:`saito`
msgctxt "love_hotel_exterior_07c0f38a"
msgid "Rendez-moi... mon argent !"
msgstr "Kembalikan... duit aku!"

#. Character:`saito`
msgctxt "love_hotel_exterior_55ebd0b0"
msgid "Vous n'avez pas le droit de..."
msgstr "Kalian nggak punya hak buat..."

#. Character:`takeo`
msgctxt "love_hotel_exterior_628e4f27"
msgid "Oh, mais nous aussi, regarde comme je transpire !"
msgstr "Oh, tapi kita juga, liat deh aku berkeringat!"

#. Character:`kenji`
msgctxt "love_hotel_exterior_bb9c0617"
msgid "Et moi regarde, je saigne des phalanges à force de te frapper, ça mérite bien un dédommagement."
msgstr "Dan aku juga, liat nih, jari aku berdarah karena terus mukulin kamu, ini pantas dapet kompensasi."

#. Character:`saito` | Attributes:`sad`
msgctxt "love_hotel_exterior_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`takeo` | Attributes:`disgusted`
msgctxt "love_hotel_exterior_ce3a8fac"
msgid "Toujours rien à dire ?"
msgstr "Masih nggak ada yang mau ngomong?"

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "love_hotel_exterior_6fb65c06"
msgid "Pff, laisse tomber cette loque."
msgstr "Pff, lupakan aja si pecundang itu."

#. Character:`kenji`
msgctxt "love_hotel_exterior_857b36ce"
msgid "Allez on s'arrache, je cramerai bien tout son fric aux arcades."
msgstr "Ayo cabut, aku pengen bakar semua duitnya di arcade."

#. Character:`saito` | Attributes:`upset`
msgctxt "love_hotel_exterior_d0b5b04d"
msgid "ATTENDEZ !"
msgstr "TUNGGU!"

#. Character:`takeo` | Attributes:`angry`
msgctxt "love_hotel_exterior_a754ebdc"
msgid "Putain, mais t'en as pas eu assez ? Tu veux qu'on en remette une couche ?"
msgstr "Sialan, kamu gak puas ya? Mau kita tambah lagi?"

#. Character:`saito` | Attributes:`angry`
msgctxt "love_hotel_exterior_09d97f46"
msgid "Je vous jure qu'un jour... Vous allez me payer au centuple toutes ces humiliations."
msgstr "Aku sumpahin suatu hari nanti... Kalian bakal bayar semua penghinaan ini seratus kali lipat."

#. Character:`saito`
msgctxt "love_hotel_exterior_2300047a"
msgid "Et ce jour-là, il n'y aura aucun pardon."
msgstr "Dan di hari itu, gak akan ada ampun."

#. Character:`takeo` | Attributes:`mocking`
msgctxt "love_hotel_exterior_fa0e68f1"
msgid "HAHAHA !"
msgstr "HAHAHA!"

#. Character:`nobu` | Attributes:`bad`
msgctxt "love_hotel_exterior_8dc6d726"
msgid "Mais j'en peux plus..."
msgstr "Aku udah gak kuat lagi..."

#. Character:`kenji` | Attributes:`bad`
msgctxt "love_hotel_exterior_ec75b4b4"
msgid "Dans ce cas, bonne chance."
msgstr "Kalau gitu, semoga beruntung."

#. Character:`kenji`
msgctxt "love_hotel_exterior_e1021b8c"
msgid "Allez dégage d'ici !"
msgstr "Ayo cabut dari sini!"

#. Character:`netoru`
msgctxt "love_hotel_exterior_a1c9f3e9"
msgid "Ce putain de petit bâtard !"
msgstr "Bajingan kecil sialan itu!"

#. Character:`netoru`
msgctxt "love_hotel_exterior_ceaa5e00"
msgid "Il va voir ce qu'il va voir !"
msgstr "Dia bakal tau apa yang bakal dia dapetin!"

#. Character:`netoru`
msgctxt "love_hotel_exterior_24f6861d"
msgid "Ils sont finis ! FINI !!!"
msgstr "Mereka udah kelar! SELESAI!!!"

#. Character:`netoru`
msgctxt "love_hotel_exterior_a06ac8a0"
msgid "Avec tout ce que j'ai sur cette pute, j'ai de quoi la faire se prostituer jusqu'à la fin de sa vie !"
msgstr "Dengan semua yang aku punya tentang pelacur itu, aku bisa bikin dia jadi pelacur sampai mati!"

#. Character:`netoru`
msgctxt "love_hotel_exterior_6d703bc6"
msgid "Elle sera à moi d'une manière ou d'une autre."
msgstr "Dia bakal jadi milik aku entah gimana caranya."

#. Character:`netoru`
msgctxt "love_hotel_exterior_14e3e045"
msgid "Quant à lui... Je vais le... le... je vais le tuer !"
msgstr "Soal dia... Aku bakal... aku bakal... aku bakal bunuh dia!"

#. Character:`sakuya`
msgctxt "love_hotel_exterior_ac7728e7"
msgid "Bonsoir, Mr. {{netoru.n}}, la nuit est magnifique, vous ne trouvez pas ?"
msgstr "Selamat malam, Mr. {{netoru.n}}, malamnya indah banget, kamu nggak ngerasa gitu?"

#. Character:`netoru`
msgctxt "love_hotel_exterior_71424ba2"
msgid "Mais t'es qui bordel ?"
msgstr "Tapi kamu siapa, sialan?"

#. Character:`sakuya`
msgctxt "love_hotel_exterior_98625ab4"
msgid "Je crois savoir que vous êtes friand de chantage."
msgstr "Aku denger kamu doyan ngancem."

#. Character:`sakuya`
msgctxt "love_hotel_exterior_0bd801ec"
msgid "Et que vous possédez un réel talent..."
msgstr "Dan kamu punya bakat yang nyata..."

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "love_hotel_exterior_8d0ce918"
msgid "Et alors, tu veux quoi ? Un autographe ?"
msgstr "Terus, kamu mau apa? Tanda tangan?"

#. Character:`sakuya`
msgctxt "love_hotel_exterior_f654124f"
msgid "Je suis simplement venue vous avertir."
msgstr "Aku cuma datang buat ngasih peringatan."

#. Character:`netoru` | Attributes:`bad`
msgctxt "love_hotel_exterior_576b27a5"
msgid "M'avertir ? C'est la meilleure blague que j'ai entendue !"
msgstr "Ngasih tau aku? Itu candaan paling gila yang pernah aku denger!"

#. Character:`netoru`
msgctxt "love_hotel_exterior_42bc640e"
msgid "La personne qui me fera plier sous la menace n'est pas encore née."
msgstr "Orang yang bisa bikin aku nyerah karena ancaman belum lahir nih."

#. Character:`sakuya` | Attributes:`melancholic`
msgctxt "love_hotel_exterior_555c56f1"
msgid "Oh, mais vous faites fausse route Mr. {{netoru.n}}, je ne suis pas venue pour vous menacer."
msgstr "Oh, tapi kamu salah paham, Pak {{netoru.n}}, aku nggak datang buat ngancem."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "love_hotel_exterior_b4df7b91"
msgid "Je préfère agir..."
msgstr "Aku lebih milih buat bertindak..."

#. Character:`sakuya`
msgctxt "love_hotel_exterior_6b782802"
msgid "D'ailleurs à ce sujet... Vous ne trouvez pas que cela sent le brulé ?"
msgstr "Ngomong-ngomong soal itu... Kamu nggak ngerasa ada bau gosong, gak sih?"

#. Character:`netoru`
msgctxt "love_hotel_exterior_8c9f230b"
msgid "Mais de quoi tu p-"
msgstr "Tapi kamu ngomong ap-"

#. Character:`sakuya`
msgctxt "love_hotel_exterior_75967fc5"
msgid "Il me semblait pourtant avoir senti votre maison en train de bruler..."
msgstr "Padahal aku yakin aku ngerasa rumah kamu lagi kebakaran..."

#. Character:`netoru`
msgctxt "love_hotel_exterior_93d8ae63"
msgid "Quoi ?!"
msgstr "Apa?!"

#. Character:`netoru`
msgctxt "love_hotel_exterior_19c3ae76"
msgid "NOON NON NON NON NONNNNN"
msgstr "NOOO GAK GAK GAK GAKKKK"

#. Character:`sakuya`
msgctxt "love_hotel_exterior_30349a32"
msgid "Quelle infortune !"
msgstr "Sial banget!"

#. Character:`saito`
msgctxt "love_hotel_exterior_5cb11a71"
msgid "Elle doit m'attendre à l'intérieur."
msgstr "Dia pasti nungguin aku di dalam."

#. Character:`saito`
msgctxt "love_hotel_exterior_c3995d9b"
msgid "Je ferais mieux de me dépêcher."
msgstr "Mending aku buru-buru deh."

#. Character:`akira`
msgctxt "love_hotel_exterior_5d197fe8"
msgid "Te voilà enfin !"
msgstr "Akhirnya kamu datang juga!"

#. Character:`akira`
msgctxt "love_hotel_exterior_761b0bfe"
msgid "J'ai cru que tu baisserais les bras mais finalement te voilà."
msgstr "Aku kira kamu bakal nyerah, tapi ternyata kamu malah datang."

#. Character:`akira`
msgctxt "love_hotel_exterior_64391a45"
msgid "Prête à passer la meilleure nuit de ta vie ?"
msgstr "Siap buat ngalamin malem terbaik dalam hidup kamu?"

#. Character:`noriko`
msgctxt "love_hotel_exterior_455dabce"
msgid "Je veux juste en finir au plus vite..."
msgstr "Aku cuma pengen cepet selesai aja..."

#. Character:`akira` | Attributes:`upset`
msgctxt "love_hotel_exterior_282138dd"
msgid "Ah non ! Ça ne fonctionne pas comme ça, tu va devoir y mettre du tien sinon je ne marche plus."
msgstr "Ah, nggak gitu caranya, kamu harus usaha juga kalo nggak aku nggak bakal jalan."

#. Character:`akira`
msgctxt "love_hotel_exterior_026e1a29"
msgid "Je te l'ai déjà dit, ne me fais surtout pas perdre mon temps. J'ai bien mieux à faire et t'aider ne m'apporte absolument rien."
msgstr "Udah aku bilang, jangan buang-buang waktu aku. Aku punya hal yang jauh lebih penting dan nolongin kamu nggak ngasih aku apa-apa."

#. Character:`noriko` | Attributes:`shame`
msgctxt "love_hotel_exterior_241d2dc2"
msgid "... D'accord j-"
msgstr "... Oke deh, gua-"

#. Character:`saito`
msgctxt "love_hotel_exterior_cb0e5e00"
msgid "Éloigne-toi de cette ordure {{noriko.n}} !"
msgstr "Jauh-jauh dari sampah itu {{noriko.n}}!"

#. Character:`noriko` | Attributes:`afraid`
msgctxt "love_hotel_exterior_4a1f7887"
msgid "Quoi ! Mais... Qu'est-ce que tu fais ?! Ça ne te concerne pas !"
msgstr "Apa! Tapi... Kamu ngapain?! Ini nggak urusan kamu!"

#. Character:`noriko`
msgctxt "love_hotel_exterior_f9cac87d"
msgid "Laisse-moi tranquille."
msgstr "Tinggalin aku sendiri."

#. Character:`akira` | Attributes:`angry`
msgctxt "love_hotel_exterior_d3e7541f"
msgid "... Dégage... dé-déchet ! Sinon... Je.."
msgstr "... Pergi... sampah... kalo nggak... aku.."

#. Character:`saito`
msgctxt "love_hotel_exterior_419020d5"
msgid "{{noriko.n}} maintenant ça suffit, tu vas me laisser t'aider que tu le veuilles ou non."
msgstr "{{noriko.n}} sekarang udah cukup, kamu bakal ngizinin aku bantuin kamu mau kamu suka atau nggak."

#. Character:`saito`
msgctxt "love_hotel_exterior_d9ccf413"
msgid "Je vais gérer cet abruti par moi-même."
msgstr "Aku bakal urusin bocah bodoh itu sendirian."

#. Character:`saito`
msgctxt "love_hotel_exterior_3d7c6932"
msgid "Attends-moi plus loin !"
msgstr "Nungguin aku di sana aja!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "love_hotel_exterior_eb7303af"
msgid "Mais il va te..."
msgstr "Tapi dia bakal..."

#. Character:`saito` | Attributes:`happy`
msgctxt "love_hotel_exterior_d1cecc44"
msgid "Il ne me fera plus rien, il n'en a plus la possibilité."
msgstr "Dia nggak bakal ngapa-ngapain aku lagi, dia udah nggak mampu."

#. Character:`noriko`
msgctxt "love_hotel_exterior_29cd7803"
msgid "..."
msgstr "..."

#. Character:`akira` | Attributes:`arrogant`
msgctxt "love_hotel_exterior_1eb9d4f6"
msgid "Je crois que tu te surestimes un peu {{saito.n}}"
msgstr "Kayaknya kamu terlalu percaya diri deh {{saito.n}}"

#. Character:`saito` | Attributes:`happy`
msgctxt "love_hotel_exterior_7e5f6a1e"
msgid "Non... c'est toi qui ne comprends pas."
msgstr "Nggak... justru kamu yang nggak ngerti."

#. Character:`saito`
msgctxt "love_hotel_exterior_8cdce688"
msgid "Avoue que tu es incapable de m'approcher à moins d'avoir une érection..."
msgstr "Ngaku aja kamu nggak bisa deketin aku kecuali kamu lagi ereksi..."

#. Character:`akira` | Attributes:`angry`
msgctxt "love_hotel_exterior_353e91f9"
msgid "Va te f-"
msgstr "Mampus lu-"

#. Character:`saito`
msgctxt "love_hotel_exterior_9538550f"
msgid "C'est bien ce que je pensais !"
msgstr "Tuh kan, aku udah duga!"

#. Character:`akira`
msgctxt "love_hotel_exterior_b403a11a"
msgid "Putain...[w] T'as de la chance... Cette maudite drogue me rend complètement fou."
msgstr "Sialan...[w] Kamu beruntung... Obat sialan ini bikin aku gila banget."

#. Character:`saito` | Attributes:`upset`
msgctxt "love_hotel_exterior_dd3638cc"
msgid "C'est pas de la chance, ça s'appelle le karma. C'est toi qui as voulu jouer avec le feu."
msgstr "Itu bukan keberuntungan, itu namanya karma. Kamu sendiri yang pengen main api."

#. Character:`akira`
msgctxt "love_hotel_exterior_1b806897"
msgid "Ne crois pas que tu resteras intouchable longtemps."
msgstr "Jangan kira kamu bakal tetep aman terus."

#. Character:`akira`
msgctxt "love_hotel_exterior_16b4bf95"
msgid "Tu risques d'être surpris !"
msgstr "Kamu bakal kaget, deh!"

#. Character:`saito` | Attributes:`angry`
msgctxt "love_hotel_exterior_d7765cab"
msgid "Me raconte pas ta vie, n'approche plus jamais {{noriko.n}} !"
msgstr "Aku gak mau denger cerita kamu, jangan pernah deketin lagi {{noriko.n}}!"

#. Character:`akira` | Attributes:`upset`
msgctxt "love_hotel_exterior_61c4b671"
msgid "Tu veux t'en occuper ? Fais-toi plaisir mais tu viens juste de signer ton arrêt de mort."
msgstr "Mau urus itu? Silahkan aja, tapi kamu baru aja tanda tangan surat kematian kamu."

#. Character:`saito`
msgctxt "love_hotel_exterior_f1fa3661"
msgid "Pourquoi ça ?"
msgstr "Kenapa gitu?"

#. Character:`akira` | Attributes:`arrogant`
msgctxt "love_hotel_exterior_a4511f86"
msgid "Attends, tu veux dire que tu n'es au courant de rien ?"
msgstr "Tunggu, maksud kamu lo gak tau apa-apa?"

#. Character:`akira`
msgctxt "love_hotel_exterior_7dd954f2"
msgid "Alors que vous vivez littéralement sous le même toit ?"
msgstr "Padahal kalian literally tinggal satu atap?"

#. Character:`akira`
msgctxt "love_hotel_exterior_df199a0e"
msgid "Hahaha... La rentrée va être épique... si tu survis jusque là !"
msgstr "Hahaha... Awal tahun sekolah bakal gila... kalo kamu masih hidup sampe situ!"

#. Character:`akira`
msgctxt "love_hotel_exterior_c6ef15aa"
msgid "Profite de tes derniers jours !"
msgstr "Nikmatin hari-hari terakhir kamu!"

#. Character:`narrator`
msgctxt "love_hotel_exterior_65c75c43"
msgid "Ça s'est passé bien mieux que je ne l'aurais cru..."
msgstr "Ini malah kejadian jauh lebih bagus dari yang aku kira..."

#. Character:`narrator`
msgctxt "love_hotel_exterior_a4b20747"
msgid "Après pour les menaces de mort... ça reste du {{akira.n}} tout craché."
msgstr "Soal ancaman bunuh... itu jelas banget dari {{akira.n}}."

#. Character:`narrator`
msgctxt "love_hotel_exterior_d0661f86"
msgid "Inutile d'y accorder davantage d'attention pour le moment."
msgstr "Gak usah kasih perhatian lebih buat sekarang."

#. Character:`saito`
msgctxt "love_hotel_exterior_9496cd11"
msgid "{{noriko.n}} ne viendra pas, il faudra se contenter de moi !"
msgstr "{{noriko.n}} gak bakal datang, harus puas sama aku aja!"

#. Character:`akira` | Attributes:`angry`
msgctxt "love_hotel_exterior_bfcda05a"
msgid "Putain... TOI !!"
msgstr "Sialan... KAMU!!"

#. Character:`akira`
msgctxt "love_hotel_exterior_2806bd16"
msgid "Ne t'approche pas !"
msgstr "Jangan deketin aku!"

#. Character:`saito`
msgctxt "love_hotel_exterior_f84b2f16"
msgid "Tu es donc toujours sous l'effet de cette drogue n'est-ce pas ?"
msgstr "Jadi kamu masih kebawa efek obat itu kan?"

#. Character:`akira`
msgctxt "love_hotel_exterior_06c16761"
msgid "C'est la faute de ta folle de copine !"
msgstr "Salah tuh pacarmu yang gila!"

#. Character:`saito`
msgctxt "love_hotel_exterior_c733153f"
msgid "{{sakuya.n}} ?[w] Non je ne pense pas..."
msgstr "{{sakuya.n}} ?[w] Gak deh aku rasa nggak..."

#. Character:`saito` | Attributes:`angry`
msgctxt "love_hotel_exterior_b8933dbc"
msgid "C'est toi qui avais ce truc sur toi."
msgstr "Kamu yang bawa barang itu."

#. Character:`saito`
msgctxt "love_hotel_exterior_a5417e4d"
msgid "Tout ce qu'il s'est passé est juste un retour de karma."
msgstr "Semua yang kejadian itu cuma karma yang balik."

#. Character:`akira`
msgctxt "love_hotel_exterior_b7f222e0"
msgid "T'approche pas bordel !"
msgstr "Jangan deket-deket, bangsat!"

#. Character:`saito` | Attributes:`happy`
msgctxt "love_hotel_exterior_67e96b5c"
msgid "Sinon quoi ? Tu vas avoir une erection ?"
msgstr "Atau gimana? Kamu bakal ereksi ya?"

#. Character:`saito`
msgctxt "love_hotel_exterior_4a67b980"
msgid "Tu ne vas pas pouvoir t'empêcher de venir me suc-"
msgstr "Kamu nggak bakal bisa nahan buat ngisep aku-"

#. Character:`akira` | Attributes:`upset`
msgctxt "love_hotel_exterior_41cc89af"
msgid "Putain ta gueule ! STOP ! Arrête ça !"
msgstr "Sialan, tutup mulut! BERHENTI! Berhentiin itu!"

#. Character:`saito` | Attributes:`upset`
msgctxt "love_hotel_exterior_690bf5cc"
msgid "Si tu veux que j'arrête c'est simple... Sors de ma vie, de celle de {{noriko.n}} et de {{yasuka.n}}."
msgstr "Kalau mau aku berhenti gampang... Pergi dari hidup aku, dari hidup {{noriko.n}} dan {{yasuka.n}}."

#. Character:`saito`
msgctxt "love_hotel_exterior_2a40481d"
msgid "Tu nous oublies et on fera de même !"
msgstr "Lupain kita, dan kita juga bakal lupain kamu!"

#. Character:`akira` | Attributes:`arrogant`
msgctxt "love_hotel_exterior_045910c6"
msgid "Tu le regretteras de toute façon, j'étais la seule chance pour {{noriko.n}} de s'en sortir."
msgstr "Kamu bakal nyesel juga, aku satu-satunya kesempatan {{noriko.n}} buat keluar dari ini."

#. Character:`akira`
msgctxt "love_hotel_exterior_5e59e2b9"
msgid "Qu'elle profite de sa tranquillité retrouvée si elle le veut."
msgstr "Biar dia nikmatin ketenangan yang dia dapet kalo emang mau."

#. Character:`akira`
msgctxt "love_hotel_exterior_9125a530"
msgid "De toute façon, ça ne durera pas longtemps."
msgstr "Tapi ya, itu nggak bakal bertahan lama."

#. Character:`akira`
msgctxt "love_hotel_exterior_f70d0b52"
msgid "Ne crois pas non plus que je ne m'en prendrais plus jamais à toi... Je trouverai une solution pour me débarrasser de... ça !"
msgstr "Jangan kira aku nggak bakal nyerang kamu lagi... Aku bakal cari cara buat ngilangin... itu!"

#. Character:`akira`
msgctxt "love_hotel_exterior_57e2c04c"
msgid "Allez tous vous faire foutre !"
msgstr "Pergi sana semua kamu!"

#. Character:`narrator`
msgctxt "love_hotel_exterior_ecd12cf6"
msgid "Voilà une bonne chose de faite !"
msgstr "Nah, itu udah beres!"

#. Character:`narrator`
msgctxt "love_hotel_exterior_9a270151"
msgid "En ce qui concerne les menaces... C'est la routine avec {{akira.n}}."
msgstr "Soal ancaman... Udah jadi rutinitas sama {{akira.n}}."

#. Character:`narrator`
msgctxt "love_hotel_exterior_27641333"
msgid "Je m'occuperais de ça le moment venu."
msgstr "Aku bakal urusin itu pas waktunya."

#. Character:`saito` | Attributes:`surprised`
msgctxt "tad4c7efd77"
msgid "Oh !"
msgstr "Oh!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t6f757428a9"
msgid "Tu m'attendais depuis longtemps ?"
msgstr "Kamu udah nunggu aku lama ya?"

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t63011f23af"
msgid "Depuis bien trop longtemps si tu veux mon avis !"
msgstr "Udah kelamaan banget menurut aku!"

#. Character:`sayuri`
msgctxt "t7f929530b5"
msgid "Allez hop ! La chambre nous attend !"
msgstr "Ayo cepet! Kamar nunggu kita!"

#. Character:`sayuri` | Attributes:`happy,blush`
msgctxt "ta7036e6d69"
msgid "J'ai bien l'intention de rentabiliser la nuit complète, j'espère que tu es en forme ?"
msgstr "Aku niat banget mau manfaatin semalam penuh, semoga kamu siap ya?"

#. Character:`saito`
msgctxt "ta0591f9a80"
msgid "Ca... Ca devrait aller !"
msgstr "Itu... Kayaknya sih oke!"

#. Character:`sayuri` | Attributes:`happy`
msgctxt "t92ae6bfde8"
msgid "Mon dieu quel nuit !"
msgstr "Ya ampun, malam yang gila!"

#. Character:`sayuri`
msgctxt "tf28c19f9dc"
msgid "Tu n'as pas failli à ta réputation !"
msgstr "Kamu nggak ngecewain reputasi kamu!"

#. Character:`saito` | Attributes:`happy`
msgctxt "te58d27dc4a"
msgid "Je donne toujours le maximum."
msgstr "Aku selalu ngasih yang terbaik."

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t5ef3490440"
msgid "Je ferais bien de me remettre en forme sinon je tiendrais jamais la rythme..."
msgstr "Sebenernya aku harus mulai olahraga lagi, kalo nggak aku nggak bakal kuat ngejalanin ritmenya..."

#. Character:`saito` | Attributes:`guilty`
msgctxt "ta61adcfcc4"
msgid "Dois-je conclure que tu ne souhaites pas t'arrêter là ?"
msgstr "Haruskah aku nyimpulin kalo kamu nggak pengen berhenti sampai sini?"

#. Character:`sayuri` | Attributes:`moved`
msgctxt "t634cdef8e0"
msgid "...[w]Si tu es d'accord bien sur ?"
msgstr "...[w]Kalo kamu setuju sih?"

#. Character:`narrator`
msgctxt "t2234a46081"
msgid "Mon dieu avec un tel regard..."
msgstr "Ya ampun, liat tatapan kayak gitu..."

#. Character:`narrator`
msgctxt "t0127750a54"
msgid "Comment je pourrais lui refuser quoi que se soit ?"
msgstr "Gimana aku bisa nolak apa pun dari dia?"

#. Character:`saito`
msgctxt "t4a4824d082"
msgid "Tant que c'est toi qui parle de cette situation à {{asami.n}} ça me va..."
msgstr "Selama kamu yang ngomongin situasi ini ke {{asami.n}}, aku oke-oke aja..."

#. Character:`sayuri`
msgctxt "t9d0e980e14"
msgid "...Je suis certaine qu'elle sera compréhensible et heureuse pour sa mère...[w]Je crois..."
msgstr "...Aku yakin dia bakal ngerti dan seneng buat ibunya...[w]Aku rasa sih..."

#. Character:`saito`
msgctxt "t229b75289f"
msgid "Allez je te raccompagne ?"
msgstr "Ayo, aku antar kamu pulang?"

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t28869c1396"
msgid "J'espère bien ! Si avec la nuit qu'on a passée tu me laisse tomber maintenant, je vais vraiment me fâcher !"
msgstr "Semoga iya! Kalo setelah malam yang kita lewatin kamu ninggalin aku sekarang, aku bakal bener-bener marah!"

#. Character:`saito`
msgctxt "INSTALLONS_QUELQUES_AFFICHES_I_BB2A16"
msgid "Installons quelques affiches ici."
msgstr "Pasang beberapa poster di sini."

#. Character:`saito`
msgctxt "BON_A_DEVRAIT_SUFFIRE_POUR_ICI_4899DD"
msgid "Bon, ça devrait suffire pour ici, allons voir du côté du konbini."
msgstr "Oke, seharusnya cukup di sini, ayo kita cek di konbini."

#. Character:`takeo`
msgctxt "J_ESP_RE_QUE_TU_PASSES_UNE_BON_B49FF0"
msgid "J'espère que tu passes une bonne soirée..."
msgstr "Semoga kamu lagi nikmatin malammu..."

#. Character:`takeo`
msgctxt "J_AI_D_PENS_SANS_COMPTER_POUR_53E3AE"
msgid "J'ai dépensé sans compter pour toi, bébé."
msgstr "Aku udah ngeluarin duit tanpa hitung buat kamu, sayang."

#. Character:`tsubaki` | Attributes:`pouting`
msgctxt "OUI_C_TAIT_PAS_TROP_MAL_DB514C"
msgid "Oui, c'était pas trop mal..."
msgstr "Iya, lumayan juga sih..."

#. Character:`tsubaki`
msgctxt "ET_QU_EST_CE_QU_ON_FAIT_DEVANT_9C4B15"
msgid "Et qu'est-ce qu'on fait devant le love hôtel, exactement ?"
msgstr "Terus kita ngapain sih di depan love hotel ini, sebenarnya?"

#. Character:`takeo`
msgctxt "ALLONS_B_B_TU_DOIS_BIEN_AVOIR_F21AD2"
msgid "Allons, bébé... Tu dois bien avoir une idée... Ça fait plusieurs mois qu'on sort ensemble..."
msgstr "Ayo dong, sayang... Pasti kamu punya ide... Kita udah pacaran beberapa bulan..."

#. Character:`takeo`
msgctxt "IL_SERAIT_PEUT_TRE_TEMPS_DE_FA_4F3111"
msgid "Il serait peut-être temps de faire avancer notre relation..."
msgstr "Mungkin udah saatnya kita majuin hubungan kita..."

#. Character:`takeo`
msgctxt "POUR_LE_MOMENT_C_EST_SURTOUT_T_18EA5D"
msgid "Pour le moment, c'est surtout toi qui en profites..."
msgstr "Sekarang ini, kamu yang paling nikmatin sih..."

#. Character:`takeo`
msgctxt "IL_FAUT_QUE_TU_DONNES_UN_PEU_D_E19239"
msgid "Il faut que tu donnes un peu du tien aussi."
msgstr "Kamu juga harus kasih usaha dikit."

#. Character:`tsubaki` | Attributes:`bored`
msgctxt "JE_COMMENCE_COMPRENDRE_PR_SENT_0F30B3"
msgid "Je commence à comprendre à présent !"
msgstr "Aku mulai ngerti sekarang!"

#. Character:`tsubaki` | Attributes:`happy`
msgctxt "TU_AS_RAISON_JE_CROIS_QUE_JE_T_F98B8E"
msgid "Tu as raison, je crois que je t'ai fait attendre assez longtemps... Allons-y !"
msgstr "Kamu bener, kayaknya aku bikin kamu nunggu terlalu lama... Ayo kita masuk!"

#. Character:`takeo`
msgctxt "OUI_PUTAIN_OUI_C_EST_LE_GRAND_D41C4A"
msgid "Oui ! Putain ! Oui, c'est le grand soir !"
msgstr "Iya! Sialan! Iya, ini malam yang ditunggu-tunggu!"

#. Character:`takeo`
msgctxt "JE_VAIS_ENFIN_PERDRE_MON_PUC_A99DDD"
msgid "Je vais enfin perdre mon puc-"
msgstr "Akhirnya aku bakal kehilangan perjakaanku-"

#. Character:`saito`
msgctxt "TAKEO_N_J_AI_BESOIN_DE_TE_PAR_2DE451"
msgid "{{takeo.n}}, j'ai besoin de te parler, ça ne sera pas long."
msgstr "{{takeo.n}}, aku perlu ngomong sama kamu, gak bakal lama kok."

#. Character:`takeo`
msgctxt "HEY_NON_LACHE_MOI_PUTAIN_D4CAC7"
msgid "Hey ! Non ! Lache moi putain !"
msgstr "Hei! Gak! Lepasin aku, sialan!"

#. Character:`tsubaki`
msgctxt "POURQUOI_CHAQUE_FOIS_QU_ON_SE_AE60CE"
msgid "Pourquoi à chaque fois qu'on se promène on finit toujours ici ?"
msgstr "Kenapa tiap kali kita jalan-jalan kita selalu berakhir di sini?"

#. Character:`takeo`
msgctxt "B_B_JE_SUIS_D_SOL_MAIS_CHAQUE_43D948"
msgid "Bébé... Je suis désolé, mais à chaque fois qu'on a voulu aller plus loin, on a été dérangés."
msgstr "Sayang... Maaf ya, tapi tiap kali kita mau lanjut, selalu aja ada gangguan."

#. Character:`tsubaki` | Attributes:`bored`
msgctxt "QUI_LA_FAUTE_4CC663"
msgid "À qui la faute ?"
msgstr "Salah siapa coba?"

#. Character:`takeo`
msgctxt "JE_SAIS_JE_SAIS_A_N_ARRIVERA_P_F67D69"
msgid "Je sais... Je sais... Ça n'arrivera plus, je te le promets !"
msgstr "Aku tau... Aku tau... Gak bakal kejadian lagi, aku janji!"

#. Character:`takeo` | Attributes:`mocking`
msgctxt "TU_VEUX_BIEN_ME_LAISSER_UNE_DE_CE4682"
msgid "Tu veux bien me laisser une dernière chance ?"
msgstr "Mau gak kasih aku kesempatan terakhir?"

#. Character:`takeo`
msgctxt "JE_TE_PROMETS_QUE_TU_NE_LE_REG_10E686"
msgid "Je te promets que tu ne le regretteras pas."
msgstr "Aku janji kamu gak bakal nyesel."

#. Character:`tsubaki` | Attributes:`arrogant`
msgctxt "TU_M_OFFRIRAS_CE_MAGNIFIQUE_SA_A490E2"
msgid "Tu m'offriras ce magnifique sac qu'on a vu tout à l'heure ?"
msgstr "Kamu bakal beliin aku tas keren yang tadi kita liat itu, kan?"

#. Character:`takeo` | Attributes:`disgusted`
msgctxt "F_W_OUI_TOUT_CE_QUE_TU_VEUX_B_C867BD"
msgid "F..[w] Oui ! Tout ce que tu veux, bébé !"
msgstr "I-iya! Apa aja yang kamu mau, sayang!"

#. Character:`tsubaki` | Attributes:`smile`
msgctxt "D_ACCORD_JE_TE_LAISSE_UNE_DERN_ED89CF"
msgid "D'accord, je te laisse une dernière chance alors."
msgstr "Oke, aku kasih kamu kesempatan terakhir nih."

#. Character:`takeo` | Attributes:`bad`
msgctxt "ALLEZ_CETTE_FOIS_CI_C_EST_LA_B_902E06"
msgid "Allez, cette fois-ci c'est la bonne, personne pour venir me faire chier."
msgstr "Ayo deh, kali ini beneran, gak ada yang bakal ganggu aku."

#. Character:`takeo`
msgctxt "JE_VAIS_ENFIN_DIRE_ADIEU_MON_P_D2E4A2"
msgid "Je vais enfin dire adieu à mon pucelage !"
msgstr "Akhirnya aku bakal ngucapin selamat tinggal ke keperjakaanku!"

#. Character:`akira`
msgctxt "UNE_PROSTITU_E_TE_CO_TERAIT_BI_B2F2E8"
msgid "Une prostituée te coûterait bien moins cher, ducon."
msgstr "Malah lebih murah bayar pelacur, bodoh."

#. Character:`akira`
msgctxt "VIENS_DISCUTER_UN_PEU_AVEC_MOI_5C429D"
msgid "Viens discuter un peu avec moi..."
msgstr "Ayo ngobrol dulu dikit sama aku..."

#. Character:`saito`
msgctxt "home_player_bathroom_64704e2b"
msgid "Ça devrait faire l'affaire et..."
msgstr "Seharusnya ini cukup dan..."

#. Character:`saito`
msgctxt "home_player_bathroom_fced261b"
msgid "Hey, mais c'est quoi ce bordel ?!"
msgstr "Hei, ini apaan sih, berantakan banget?!"

#. Character:`narrator`
msgctxt "home_player_bathroom_8178876c"
msgid "Mes yeux... Ils sont dorés !"
msgstr "Mataku... Warnanya emas!"

#. Character:`narrator`
msgctxt "home_player_bathroom_2f893cb9"
msgid "Qu'est-ce que c'est que ce bordel ?"
msgstr "Ini apa sih berantakannya?"

#. Character:`narrator`
msgctxt "home_player_bathroom_e2327b56"
msgid "Jusqu'à ce que je me souvienne, ils ont toujours été marron..."
msgstr "Seingat aku, mereka selalu coklat..."

#. Character:`narrator`
msgctxt "home_player_bathroom_4649eabc"
msgid "Ça aurait un rapport avec ma réincarnation ?"
msgstr "Apa ini ada hubungannya sama reinkarnasi aku?"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "home_player_bathroom_626857b3"
msgid "Et voilà !"
msgstr "Nah, kan!"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_bathroom_1647e37f"
msgid "Tant de mystères..."
msgstr "Banyak banget misterinya..."

#. Character:`yasuka`
msgctxt "home_player_bathroom_07d4f51a"
msgid "En fait, je trouve ça très excitant."
msgstr "Sebenarnya, aku malah ngerasa ini seru banget."

#. Character:`saito`
msgctxt "home_player_bathroom_58f446b9"
msgid "Tiens, tiens."
msgstr "Nah, nih."

#. Character:`yasuka`
msgctxt "home_player_bathroom_d1fd9e41"
msgid "Prenons le bain ensemble..."
msgstr "Ayo mandi bareng..."

#. Character:`yasuka`
msgctxt "home_player_bathroom_d6f084c8"
msgid "Allez, ferme-moi ses yeux tout de suite et déshabille-toi !"
msgstr "Ayolah, tutup matanya sekarang juga dan buka bajumu!"

#. Character:`narrator`
msgctxt "home_player_bathroom_1c3da840"
msgid "Pourquoi toutes les femmes veulent toujours que je ferme les yeux à un moment si important ?!"
msgstr "Kenapa sih semua cewek pengen aku nutup mata pas momen penting kayak gini?!"

#. Character:`saito`
msgctxt "home_player_bathroom_ecf59c13"
msgid "Tu sais... Tu es déjà venue dormir nue dans ma chambre..."
msgstr "Tau nggak... Kamu pernah tidur telanjang di kamar aku sebelumnya..."

#. Character:`yasuka`
msgctxt "home_player_bathroom_80138a2a"
msgid "Ce... Ça n'avait rien à voir ! On ne faisait que dormir !"
msgstr "Itu... Gak ada hubungannya sama sekali! Kita cuma tidur doang!"

#. Character:`yasuka`
msgctxt "home_player_bathroom_d812661f"
msgid "Allez, laisse-moi t'aider à te rincer !"
msgstr "Ayo, biar aku bantu bilasin kamu!"

#. Character:`saito`
msgctxt "home_player_bathroom_f70630e3"
msgid "Je pouvais le faire, tu n'étais pas obligée, tu sais..."
msgstr "Aku bisa kok, kamu gak harus ngelakuin itu, tau..."

#. Character:`yasuka`
msgctxt "home_player_bathroom_7aa29b63"
msgid "J'ai envie de prendre soin de toi, tu te donnes beaucoup de mal en ce moment."
msgstr "Aku pengen rawat kamu, kamu udah capek banget akhir-akhir ini."

#. Character:`saito`
msgctxt "home_player_bathroom_a3ae53b2"
msgid "D'accord."
msgstr "Oke deh."

#. Character:`yasuka`
msgctxt "home_player_bathroom_5e340896"
msgid "Bon garçon !"
msgstr "Bagus, anak baik!"

#. Character:`yasuka`
msgctxt "home_player_bathroom_dccf268d"
msgid "Voilà, tu peux rentrer dans le bain à présent."
msgstr "Nah, sekarang kamu bisa masuk ke bak mandinya."

#. Character:`yasuka`
msgctxt "home_player_bathroom_06a705f5"
msgid "Et me voilà."
msgstr "Nah, aku udah di sini."

#. Character:`yasuka`
msgctxt "home_player_bathroom_5bca1934"
msgid "Tu apprécies ?"
msgstr "Kamu suka gak?"

#. Character:`saito`
msgctxt "home_player_bathroom_fe5907b3"
msgid "Honnêtement ? Je nage littéralement dans le bonheur."
msgstr "Jujur? Aku bener-bener ngerasa bahagia banget."

#. Character:`yasuka`
msgctxt "home_player_bathroom_3efbffad"
msgid "Pfff."
msgstr "Huh."

#. Character:`saito`
msgctxt "home_player_bathroom_47e17d91"
msgid "Héhé"
msgstr "Hehe"

#. Character:`yasuka`
msgctxt "home_player_bathroom_856cf8c5"
msgid "Tu sais..."
msgstr "Tau gak..."

#. Character:`yasuka`
msgctxt "home_player_bathroom_e6a0582a"
msgid "Je repensais à nous deux et nos longues discussions."
msgstr "Aku lagi mikirin kita berdua dan obrolan panjang kita."

#. Character:`yasuka`
msgctxt "home_player_bathroom_7d5c4e4b"
msgid "J'ai adoré ça, j'ai envie d'en savoir encore plus maintenant sur ce nouveau toi."
msgstr "Aku suka banget, sekarang aku pengen tahu lebih banyak lagi tentang kamu yang baru ini."

#. Character:`yasuka`
msgctxt "home_player_bathroom_8dc0acd9"
msgid "Tu es devenue une véritable épaule sur laquelle j'ai envie de m'appuyer."
msgstr "Kamu jadi bahu yang beneran pengen aku sandarin."

#. Character:`saito`
msgctxt "home_player_bathroom_46fef55d"
msgid "Oh je... Merci, je ne m'attendais pas à une déclaration aussi adorable."
msgstr "Oh aku... Makasih, aku nggak nyangka bakal dapet pernyataan yang manis banget kayak gini."

#. Character:`saito`
msgctxt "home_player_bathroom_b7484b85"
msgid "Que veux-tu savoir ?"
msgstr "Mau tahu apa?"

#. Character:`yasuka`
msgctxt "home_player_bathroom_eb5b503a"
msgid "Tout !"
msgstr "Semua!"

#. Character:`saito`
msgctxt "home_player_bathroom_c78fe368"
msgid "Ça risque d'être long..."
msgstr "Ini bakal lama nih..."

#. Character:`yasuka`
msgctxt "home_player_bathroom_e5a3391a"
msgid "J'ai tout mon temps, je suis en très bonne compagnie ici."
msgstr "Aku punya banyak waktu, aku lagi di tempat yang asik banget nih."

#. Character:`saito`
msgctxt "home_player_bathroom_4e46793f"
msgid "Alors voilà..."
msgstr "Jadi begini..."

#. Character:`centered`
msgctxt "home_player_bathroom_a898e9b8"
msgid "{{saito.n}} et {{yasuka.n}} passèrent un long moment à discuter de tout et de rien."
msgstr "{{saito.n}} dan {{yasuka.n}} ngobrol lama banget tentang segala hal yang nggak penting sampai penting."

#. Character:`centered`
msgctxt "home_player_bathroom_4b7ae6a4"
msgid "À force, restés blottis l'un contre l'autre... {{saito.n}} ne put davantage cacher son excitation."
msgstr "Saking seringnya, karena mereka terus nempel satu sama lain... {{saito.n}} nggak bisa sembunyiin gairahnya lagi."

#. Character:`saito`
msgctxt "home_player_bathroom_fe841259"
msgid "...Désolé."
msgstr "...Maaf ya."

#. Character:`yasuka`
msgctxt "home_player_bathroom_d657c227"
msgid "Ne t'excuse pas mon chéri."
msgstr "Jangan minta maaf, sayang."

#. Character:`yasuka`
msgctxt "home_player_bathroom_82b5d20f"
msgid "Je te promets de m'occuper de toi comme il se doit !"
msgstr "Aku janji bakal ngurus kamu dengan sebaik-baiknya!"

#. Character:`yasuka`
msgctxt "home_player_bathroom_4bef913d"
msgid "C'est juste que...[w] J'ai l'impression de sauter dans l'inconnu."
msgstr "Cuma... [w] Aku merasa kayak loncat ke yang gak pasti."

#. Character:`saito`
msgctxt "home_player_bathroom_5fb2bda1"
msgid "Plus de marche arrière après ça..."
msgstr "Gak bisa mundur lagi setelah ini..."

#. Character:`yasuka`
msgctxt "home_player_bathroom_56544447"
msgid "Tu pensais la même chose ?"
msgstr "Kamu juga mikir gitu?"

#. Character:`narrator`
msgctxt "t485b79496a"
msgid "Non, je suis sûr de ce que je ressens pour toi."
msgstr "Gak, aku yakin sama perasaanku ke kamu."

#. Character:`saito`
msgctxt "home_player_bathroom_6b6cf084"
msgid "Mais ça ne me gêne pas, prend le temps nécessaire d'accord."
msgstr "Tapi aku gak keberatan kok, ambil waktu yang kamu butuhin, ya."

#. Character:`yasuka`
msgctxt "home_player_bathroom_8a8b6c2b"
msgid "...Je te promets que quand cela arrivera, tu ne le regretteras pas."
msgstr "...Aku janji pas itu terjadi, kamu gak bakal nyesel."

#. Character:`saito`
msgctxt "home_player_bathroom_ab7f11c3"
msgid "Je ne suis pas inquiet."
msgstr "Aku gak khawatir kok."

#. Character:`yasuka`
msgctxt "home_player_bathroom_abf16d3b"
msgid "Bon, je vais sortir, l'eau du bain commence à être froide et {{noriko.n}} va surement se demander ce que je suis en train de faire."
msgstr "Oke, aku bakal keluar, air di bathub mulai dingin dan {{noriko.n}} pasti bakal nanya aku lagi ngapain."

#. Character:`noriko`
msgctxt "home_player_bathroom_5f48eaba"
msgid "[font_size=14]Maman ! C'est toi qui es dans la salle de bain ? Je peux entrer ?[/font_size]"
msgstr "[font_size=14]Mami! Itu kamu yang lagi di kamar mandi? Boleh aku masuk?[/font_size]"

#. Character:`yasuka`
msgctxt "home_player_bathroom_3d1073c4"
msgid "Oh non, mince !"
msgstr "Aduh, sial!"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_bathroom_8b558934"
msgid "...Je m'en occupe !"
msgstr "...Aku yang urus ini!"

#. Character:`yasuka`
msgctxt "home_player_bathroom_7f38982e"
msgid "Ahhhhh, quel bonheur."
msgstr "Ahhhhh, senangnya."

#. Character:`yasuka`
msgctxt "home_player_bathroom_e787a87b"
msgid "Après une bonne journée de travail, rien de tel qu'un bon bain chaud."
msgstr "Abis kerja seharian, nggak ada yang lebih enak dari mandi air panas."

#. Character:`yasuka`
msgctxt "home_player_bathroom_5d3850be"
msgid "En bonne compagnie..."
msgstr "Kalau ditemani yang asik..."

#. Character:`saito`
msgctxt "home_player_bathroom_b3ea5326"
msgid "Ce n'est pas moi qui dirai le contraire."
msgstr "Bukan aku yang bakal nolak sih."

#. Character:`yasuka`
msgctxt "home_player_bathroom_7a605276"
msgid "Je ne comprends pourquoi avant, tu ne voulais plus prendre ton bain avec moi..."
msgstr "Aku nggak ngerti kenapa dulu kamu nggak mau mandi bareng aku..."

#. Character:`saito`
msgctxt "home_player_bathroom_cbfaaba5"
msgid "Je...[w] J'étais mal dans ma peau."
msgstr "Aku...[w] Aku ngerasa nggak nyaman sama diri sendiri."

#. Character:`saito`
msgctxt "home_player_bathroom_649991de"
msgid "Mais j'ai réussi à me reprendre en main."
msgstr "Tapi aku berhasil ngambil alih diri lagi."

#. Character:`yasuka`
msgctxt "home_player_bathroom_b063eed8"
msgid "Oui, j'ai vu et j'adore ce nouveau toi."
msgstr "Iya, aku liat dan aku suka banget sama kamu yang sekarang."

#. Character:`saito`
msgctxt "home_player_bathroom_57a3a43c"
msgid "Et tu n'as encore rien vu !"
msgstr "Dan kamu belum liat apa-apa nih!"

#. Character:`yasuka`
msgctxt "home_player_bathroom_e1343d73"
msgid "Oh, je vois..."
msgstr "Oh, aku ngerti..."

#. Character:`yasuka`
msgctxt "home_player_bathroom_5305d519"
msgid "Je constate en tout cas que ton corps est tout aussi sincère."
msgstr "Aku liat tubuh kamu juga tulus banget."

#. Character:`yasuka`
msgctxt "home_player_bathroom_57eaec54"
msgid "Il y a quelque chose de plutôt dur dans mon dos."
msgstr "Ada sesuatu yang agak keras di punggung aku."

#. Character:`yasuka`
msgctxt "home_player_bathroom_9eed8622"
msgid "Et je crois savoir ce que c'est."
msgstr "Dan aku rasa aku tahu itu apa."

#. Character:`saito`
msgctxt "home_player_bathroom_a0261f49"
msgid "Oh !"
msgstr "Oh!"

#. Character:`yasuka`
msgctxt "home_player_bathroom_211d2233"
msgid "On continue dans notre chambre ?"
msgstr "Lanjut di kamar kita?"

#. Character:`saito`
msgctxt "home_player_bathroom_e21757d7"
msgid "Avec plaisir !"
msgstr "Dengan senang hati!"

#. Character:`saito`
msgctxt "coffeebar_exterior_a7116d26"
msgid "{{kimochi.n}} est en train de faire diversion. Je devrais en profiter pour parler à {{yasuka.n}} !"
msgstr "{{kimochi.n}} lagi ngalihin perhatian. Aku harus manfaatin buat ngobrol sama {{yasuka.n}}!"

#. Character:`netoru`
msgctxt "talk_ubs_638d53ff"
msgid "Qu'est-ce que tu fais encore là ?"
msgstr "Kamu masih ngapain di situ?"

#. Character:`netoru`
msgctxt "talk_ubs_f9af6ae6"
msgid "Tu ne crois pas que j'ai déjà assez vu ta tête pour aujourd'hui ?"
msgstr "Kamu gak mikir aku udah cukup liat muka kamu hari ini?"

#. Character:`netoru`
msgctxt "talk_ubs_81181c4f"
msgid "Tire-toi de là !"
msgstr "Cabut sana!"

#. Character:`netoru`
msgctxt "talk_ubs_2cc75c94"
msgid "Tu veux ma photo ?"
msgstr "Mau foto aku?"

#. Character:`netoru`
msgctxt "talk_ubs_16ec413d"
msgid "Dégage !"
msgstr "Pergi sana!"

#. Character:`saito`
msgctxt "talk_ubs_21bb631c"
msgid "Ma-"
msgstr "Ma-"

#. Character:`netoru`
msgctxt "talk_ubs_f5987766"
msgid "Non, mais tu pensais pas que tu allais pouvoir rentrer comme dans un moulin ?"
msgstr "Gak, tapi kamu gak mikir kalo kamu bisa masuk seenaknya gitu kan?"

#. Character:`netoru`
msgctxt "talk_ubs_a6362c16"
msgid "Je ne veux plus voir ta tête à proximité de ma boutique ou j'appelle la police."
msgstr "Aku gak mau liat muka kamu deket-deket toko aku lagi, atau aku panggil polisi."

#. Character:`netoru`
msgctxt "talk_ubs_a8bd39f9"
msgid "Casse-toi, j'ai horreur de me répéter !"
msgstr "Pergi sana, aku benci ngulangin!"

#. Character:`netoru`
msgctxt "talk_ubs_c7e603a2"
msgid "Tu sais, je serai un super beau-papa, tu verras."
msgstr "Kamu tau nggak, aku bakal jadi calon ayah tiri yang keren, nanti kamu liat."

#. Character:`netoru`
msgctxt "talk_ubs_0f328635"
msgid "Enfin... Je vais surtout m'occuper d'elle, si tu vois ce que je veux dire."
msgstr "Ya... Aku sih bakal lebih fokus ngurus dia, kalau kamu ngerti maksud aku."

#. Character:`saito`
msgctxt "coffeebar_exterior_c47aa1d8"
msgid "Je crois que c'est ici..."
msgstr "Kayaknya ini tempatnya..."

#. Character:`saito`
msgctxt "coffeebar_exterior_66c269d1"
msgid "Ça a l'air plutôt chic."
msgstr "Nih tempat keliatan cukup mewah."

#. Character:`saito`
msgctxt "coffeebar_exterior_6cc9dafd"
msgid "Je crois bien n'être jamais venu ici auparavant."
msgstr "Aku rasa aku belum pernah ke sini sebelumnya."

#. Character:`netoru`
msgctxt "coffeebar_exterior_0cf34c6e"
msgid "Je peux savoir ce que tu cherches ?"
msgstr "Boleh tau kamu nyari apa?"

#. Character:`narrator`
msgctxt "coffeebar_exterior_54c5c8aa"
msgid "Oh la vache, je ne l'avais pas vu arriver lui !"
msgstr "Waduh, aku nggak nyangka dia dateng!"

#. Character:`narrator`
msgctxt "coffeebar_exterior_977c6c67"
msgid "Une seconde... Boss ?"
msgstr "Sebentar... Bos?"

#. Character:`narrator`
msgctxt "coffeebar_exterior_25297198"
msgid "C'est lui le patron de {{yasuka.n}} ?"
msgstr "Ini dia bosnya {{yasuka.n}}?"

#. Character:`narrator`
msgctxt "coffeebar_exterior_bf5beb90"
msgid "Merde, je comprends mieux pourquoi elle semblait si angoissée à l'idée d'y retourner."
msgstr "Sialan, aku jadi ngerti kenapa dia kelihatan banget cemas kalo harus balik ke sana."

#. Character:`narrator`
msgctxt "coffeebar_exterior_77d2c7ea"
msgid "Une seconde, je juge trop vite, peut-être qu'il est tout aussi sympa que {{macumba.n}} ?"
msgstr "Tunggu, aku terlalu cepet nge-judge, mungkin dia juga asik kayak {{macumba.n}}?"

#. Character:`saito` | Attributes:`happy`
msgctxt "coffeebar_exterior_caa122d1"
msgid "Je..."
msgstr "Aku..."

#. Character:`netoru` | Attributes:`angry`
msgctxt "coffeebar_exterior_8e2d1a55"
msgid "FOUS-MOI LE CAMP !"
msgstr "CABUT KAMU!"

#. Character:`netoru`
msgctxt "coffeebar_exterior_fdd9d734"
msgid "Quoi ? Il faut que je le répète espèce de demeuré ?"
msgstr "Apa? Harus aku ulangin, bodoh?"

#. Character:`netoru`
msgctxt "coffeebar_exterior_9c63b3a6"
msgid "Arrête de rester planté là-devant ma boutique."
msgstr "Berhenti berdiri diem depan toko aku."

#. Character:`netoru`
msgctxt "coffeebar_exterior_4ebbe5df"
msgid "Dégage, tu vas faire fuir les clients !"
msgstr "Pergi sana, kamu malah bikin pelanggan kabur!"

#. Character:`saito` | Attributes:`upset`
msgctxt "coffeebar_exterior_c7ddf840"
msgid "Hey, je suis justement un client !"
msgstr "Hei, aku ini pelanggan loh!"

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "coffeebar_exterior_9f91f230"
msgid "...Tsss."
msgstr "...Tsss."

#. Character:`netoru` | Attributes:`neutral`
msgctxt "coffeebar_exterior_bbf36726"
msgid "Dans ce cas, bienvenue cher monsieur."
msgstr "Kalau gitu, selamat datang, Pak."

#. Character:`narrator`
msgctxt "coffeebar_exterior_23514d28"
msgid "Mais quelle putain de bâtard !"
msgstr "Dasar bajingan sialan!"

#. Character:`narrator`
msgctxt "coffeebar_exterior_bedadfdb"
msgid "J'ai parlé avec lui 2 minutes et j'ai déjà envie de le tuer !"
msgstr "Aku ngomong sama dia cuma dua menit, tapi aku udah pengen bunuh dia!"

#. Character:`narrator`
msgctxt "coffeebar_exterior_29c3f1e3"
msgid "Bon, je suis venu pour {{yasuka.n}}, oublions ce gros connard."
msgstr "Oke, aku dateng buat {{yasuka.n}}, lupakan aja si bajingan itu."

#. Character:`saito`
msgctxt "coffeebar_exterior_45797a47"
msgid "Mais quel enfoiré ce type !"
msgstr "Dasar bajingan sih cowok ini!"

#. Character:`saito` | Attributes:`upset`
msgctxt "coffeebar_exterior_5d15ecaa"
msgid "Je dois comprendre pourquoi elle tient tant à rester travailler ici."
msgstr "Aku harus ngerti kenapa dia pengen banget kerja di sini terus."

#. Character:`saito` | Attributes:`sad`
msgctxt "coffeebar_exterior_80f48e75"
msgid "J'espère que tout ira bien pour elle."
msgstr "Semoga semuanya bakal baik-baik aja buat dia."

#. Character:`saito`
msgctxt "coffeebar_exterior_632ac3e9"
msgid "C'est ici !"
msgstr "Ini dia!"

#. Character:`noriko`
msgctxt "coffeebar_exterior_dff5d2da"
msgid "Plutôt sympa comme endroit si on exclut le gros porc assis sur chaise devant."
msgstr "Tempatnya lumayan asik sih, asal jangan liat si babi gendut yang duduk di kursi depan itu."

#. Character:`saito` | Attributes:`surprised`
msgctxt "coffeebar_exterior_09d8e41d"
msgid "Parle moins fort, tu vas le..."
msgstr "Jangan ngomong keras-keras, kamu bakal bikin dia..."

#. Character:`netoru`
msgctxt "coffeebar_exterior_470fd0fc"
msgid "HEY !"
msgstr "HEI!"

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "coffeebar_exterior_73bde567"
msgid "Je t'ai reconnu, tu es le petit merdeux d'hier !"
msgstr "Aku tau kamu, bocah bodoh kemaren!"

#. Character:`netoru`
msgctxt "coffeebar_exterior_4ce04571"
msgid "Tu es venu faire le malin avec ta copine ?"
msgstr "Kamu dateng mau pamer sama cewek kamu ya?"

#. Character:`noriko` | Attributes:`angry`
msgctxt "coffeebar_exterior_f9814168"
msgid "Une seconde, le gros dégueulasse !"
msgstr "Santai sebentar, si babi gendut!"

#. Character:`netoru` | Attributes:`angry`
msgctxt "coffeebar_exterior_af1f6064"
msgid "Qu'est-ce que tu veux petite salope ?"
msgstr "Kamu mau apa, cewek sialan?"

#. Character:`netoru`
msgctxt "coffeebar_exterior_560f9a2d"
msgid "Tu penses que tu peux faire la maline, car ton mec est derrière toi ?"
msgstr "Kamu kira bisa sok jagoan karena pacar kamu ada di belakang kamu?"

#. Character:`netoru`
msgctxt "coffeebar_exterior_0d01fe0e"
msgid "Dégagez en vitesse."
msgstr "Cabut cepet."

#. Character:`noriko` | Attributes:`angry`
msgctxt "coffeebar_exterior_272ec25a"
msgid "J'vais le tuer !"
msgstr "Aku bakal bunuh dia!"

#. Character:`saito` | Attributes:`upset`
msgctxt "coffeebar_exterior_76433045"
msgid "Un instant... Contrairement à ce que vous pensez, on n'est pas venu ici pour chercher des ennuis."
msgstr "Tunggu... Gak seperti yang kalian pikir, kita gak datang ke sini buat cari masalah."

#. Character:`saito`
msgctxt "coffeebar_exterior_529eaebf"
msgid "Nous sommes seulement passés voir..."
msgstr "Kita cuma lewat buat liat..."

#. Character:`noriko`
msgctxt "coffeebar_exterior_1651643c"
msgid "Ma mère ! Elle travaille ici !"
msgstr "Ibuku! Dia kerja di sini!"

#. Character:`netoru` | Attributes:`bad`
msgctxt "coffeebar_exterior_204d9fe2"
msgid "Oh, je vois ! Tu dois être {{noriko.n}}, la fille de {{yasuka.n}}."
msgstr "Oh, aku ngerti! Kamu pasti {{noriko.n}}, anaknya {{yasuka.n}}."

#. Character:`netoru`
msgctxt "coffeebar_exterior_a7eeb5c1"
msgid "Il y a effectivement un petit air de famille."
msgstr "Emang ada sedikit mirip keluarga sih."

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "coffeebar_exterior_10a3b67b"
msgid "Mais peu importe, {{yasuka.n}} a terminé sa pause, il faudra revenir une autre fois."
msgstr "Tapi gak papa, {{yasuka.n}} udah selesai istirahatnya, harus balik lagi lain kali."

#. Character:`noriko`
msgctxt "coffeebar_exterior_94068052"
msgid "QUOI ?! Mais..."
msgstr "APA?! Tapi..."

#. Character:`saito`
msgctxt "coffeebar_exterior_f82348b6"
msgid "Est-ce qu'on peut entrer et acheter quelque chose ?"
msgstr "Bisa masuk dan beli sesuatu nggak?"

#. Character:`netoru`
msgctxt "coffeebar_exterior_675954d9"
msgid "Dis-moi ce que tu veux et je vais te le chercher..."
msgstr "Katakan apa yang kamu mau, aku bakal cariin..."

#. Character:`saito`
msgctxt "coffeebar_exterior_03775ec8"
msgid "..."
msgstr "..."

#. Character:`netoru`
msgctxt "coffeebar_exterior_22325562"
msgid "Non ? Rien ?"
msgstr "Nggak? Gak ada?"

#. Character:`netoru` | Attributes:`angry`
msgctxt "coffeebar_exterior_f298d007"
msgid "ALORS, FOUTEZ-MOI LE CAMP !"
msgstr "YAUDAH, CABUT KAMU SANA!"

#. Character:`noriko`
msgctxt "coffeebar_exterior_4fad3cd5"
msgid "Je croyais que tu étais la personne la plus horripilante du monde."
msgstr "Aku kira kamu orang paling nyebelin di dunia."

#. Character:`noriko`
msgctxt "coffeebar_exterior_e2cb3a81"
msgid "Mais je pense que j'ai trouvée pire encore..."
msgstr "Tapi kayaknya aku nemu yang lebih parah..."

#. Character:`saito` | Attributes:`sad`
msgctxt "coffeebar_exterior_3fbac9ed"
msgid "Merci... Je suppose."
msgstr "Makasih... Kayaknya gitu deh."

#. Character:`noriko` | Attributes:`shame`
msgctxt "coffeebar_exterior_bc7494f4"
msgid "Et maintenant ?"
msgstr "Terus sekarang gimana?"

#. Character:`saito`
msgctxt "coffeebar_exterior_ff17a3e2"
msgid "Tant que cette espèce de... sera toujours là, nous ne passerons plus."
msgstr "Selama makhluk kayak gini masih ada, kita nggak bakal bisa lewat."

#. Character:`saito` | Attributes:`upset`
msgctxt "coffeebar_exterior_09694f81"
msgid "Il faudrait une diversion..."
msgstr "Butuh pengalihan perhatian..."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "coffeebar_exterior_df45c8a8"
msgid "Bon et bien, j'te laisse réfléchir à tout ça. Moi, je rentre !"
msgstr "Oke, ya udah, aku kasih kamu waktu buat mikir. Aku pulang dulu!"

#. Character:`saito`
msgctxt "coffeebar_exterior_47e12b3e"
msgid "Il me faut quelqu'un de malin."
msgstr "Aku butuh seseorang yang pinter."

#. Character:`saito`
msgctxt "coffeebar_exterior_3fcb3426"
msgid "Où est-ce que je pourrais trouver ça ?"
msgstr "Di mana ya aku bisa nemuin itu?"

#. Character:`kimochi`
msgctxt "coffeebar_exterior_79fc129c"
msgid "Bon, laisse-moi faire. J'ai l'habitude de le gérer."
msgstr "Oke, kasih aku tanggung jawab. Aku udah biasa ngurusin ini."

#. Character:`saito`
msgctxt "coffeebar_exterior_1077aafd"
msgid "Tu me sauves la vie !"
msgstr "Kamu nyelametin hidup aku!"

#. Character:`kimochi`
msgctxt "coffeebar_exterior_df254786"
msgid "N'oublie pas que tu m'en dois une."
msgstr "Jangan lupa kamu masih punya utang sama aku."

#. Character:`saito`
msgctxt "coffeebar_exterior_c60cb0ae"
msgid "Je n'oublierai pas !"
msgstr "Aku nggak akan lupa!"

#. Character:`kimochi`
msgctxt "coffeebar_exterior_8b23f999"
msgid "Allez, c'est le moment de briller !"
msgstr "Ayo, ini saatnya buat bersinar!"

#. Character:`netoru`
msgctxt "coffeebar_exterior_2bcf82ba"
msgid "{{kimochi.n}} ! Tu tombes bien, je pensais justement à toi !"
msgstr "{{kimochi.n}}! Pas banget, aku lagi mikirin kamu!"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "coffeebar_exterior_cb8f5e81"
msgid "Oh oh, que puis-je pour mon meilleur client ?"
msgstr "Oh oh, ada apa nih sama pelanggan favorit aku?"

#. Character:`netoru`
msgctxt "coffeebar_exterior_8781cb78"
msgid "Hmm, attends, allons un peu plus loin pour discuter."
msgstr "Hmm, tunggu, ayo kita cari tempat yang lebih private buat ngobrol."

#. Character:`netoru` | Attributes:`bad`
msgctxt "coffeebar_exterior_d971d2e2"
msgid "Les derniers Hentai non censurés que tu m'as vendus étaient extraordinaires."
msgstr "Hentai tanpa sensor terakhir yang kamu jual ke aku itu luar biasa banget."

#. Character:`kimochi`
msgctxt "coffeebar_exterior_6efb83ff"
msgid "Des œuvres d'art, je suis d'accord."
msgstr "Beneran karya seni, setuju deh."

#. Character:`kimochi`
msgctxt "coffeebar_exterior_f41c0a51"
msgid "Que te faut-il cette fois-ci ?"
msgstr "Kali ini kamu mau apa?"

#. Character:`netoru` | Attributes:`neutral`
msgctxt "coffeebar_exterior_ff0e0376"
msgid "...[w] Tu en as des aussi bons avec des femmes mûres et des hommes... dégoutants ?"
msgstr "...[w] Kamu juga punya yang seru sama cewek-cewek mateng sama cowok-cowok... ngeselin gitu?"

#. Character:`kimochi`
msgctxt "coffeebar_exterior_d8dd7177"
msgid "Ah, je vois que monsieur est un homme de gout."
msgstr "Ah, aku liat kamu emang orang yang punya selera tinggi."

#. Character:`kimochi`
msgctxt "coffeebar_exterior_97682e23"
msgid "Mais pourquoi ce changement de gouts soudain ? D'habitude les milfs, ce n'est pas ton truc, {{netoru.n}}."
msgstr "Tapi kenapa tiba-tiba seleranya berubah gitu? Biasanya kamu nggak suka milfs, {{netoru.n}}."

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "coffeebar_exterior_5e74ffee"
msgid "...Mêles-toi de tes oignons ! Tu en as ou pas ?"
msgstr "...Urusin urusan kamu aja! Kamu punya atau nggak?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "coffeebar_exterior_17aadf73"
msgid "Peut-être... Laisse-moi regarder."
msgstr "Mungkin... Biar aku cek dulu."

#. Character:`netoru` | Attributes:`bad`
msgctxt "coffeebar_exterior_21f5520e"
msgid "Alors comme ça... Vous avez des dettes..."
msgstr "Jadi gini ya... Kamu punya hutang..."

#. Character:`netoru`
msgctxt "coffeebar_exterior_efd7799a"
msgid "Intéressant."
msgstr "Menarik."

#. Character:`saito` | Attributes:`upset`
msgctxt "coffeebar_exterior_0d935c9c"
msgid "Ça ne vous regarde pas !"
msgstr "Itu bukan urusan kalian!"

#. Character:`netoru`
msgctxt "coffeebar_exterior_32c02c84"
msgid "Allons, allons, ne soit pas si désagréable."
msgstr "Ayo dong, jangan jutek gitu."

#. Character:`netoru`
msgctxt "coffeebar_exterior_cc741bc2"
msgid "Tu sais que j'ai pas mal d'argent de côté..."
msgstr "Kamu tahu aku punya banyak duit simpanan..."

#. Character:`netoru`
msgctxt "coffeebar_exterior_7faac2e6"
msgid "Je pourrais proposer mon aide pour vous aider à sortir de cette... malheureuse situation."
msgstr "Aku bisa nawarin bantuan buat bantu kalian keluar dari... situasi sial ini."

#. Character:`saito`
msgctxt "coffeebar_exterior_bbe25598"
msgid "...Vous n'avez pas la tête à aider sans rien attendre en retour."
msgstr "...Kalian nggak kayaknya mau nolong cuma-cuma gitu aja."

#. Character:`saito`
msgctxt "coffeebar_exterior_5bce59f7"
msgid "Je suppose que vous voulez des contreparties ?"
msgstr "Aku tebak kalian mau imbalan, ya?"

#. Character:`netoru` | Attributes:`neutral`
msgctxt "coffeebar_exterior_ca085e51"
msgid "Des contreparties ?! Mon Dieu, mais quelle façon vulgaire et cynique de voir les choses."
msgstr "Imbalan?! Ya ampun, ngelihatnya kok kasar dan sinis banget sih."

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "coffeebar_exterior_ee40d2e0"
msgid "J'appellerai plutôt ça... une offre commerciale."
msgstr "Aku lebih bilang itu... tawaran bisnis."

#. Character:`netoru` | Attributes:`bad`
msgctxt "coffeebar_exterior_910b7f84"
msgid "{{yasuka.n}} rembourse ses dettes et toi, tu obtiens un nouveau beau-papa."
msgstr "{{yasuka.n}} bayar hutangnya dan kamu dapat papa baru yang cakep."

#. Character:`narrator`
msgctxt "t3d44aad72c"
msgid "Plutôt mourir !"
msgstr "Mending mati aja!"

#. Character:`narrator`
msgctxt "t2a53526e89"
msgid "[hint=ROUTE ???]C'est à elle de décider de ça, pas à moi."
msgstr "[hint=ROUTE ???]Itu dia yang harus putusin, bukan aku."

#. Character:`netoru`
msgctxt "coffeebar_exterior_17d89edc"
msgid "Haha, les jeunes..."
msgstr "Haha, bocah-bocah muda..."

#. Character:`netoru` | Attributes:`neutral`
msgctxt "coffeebar_exterior_fb0ec684"
msgid "De toute façon, tu n'as pas ton mot à dire dans cette histoire."
msgstr "Pokoknya, kamu gak punya hak ngomong soal ini."

#. Character:`netoru`
msgctxt "coffeebar_exterior_d82bb78d"
msgid "Je suis certain d'arriver à la faire craquer..."
msgstr "Aku yakin bisa bikin dia luluh..."

#. Character:`netoru` | Attributes:`bad`
msgctxt "coffeebar_exterior_f4a6a76a"
msgid "Sur ce, à bientôt[w] fiston."
msgstr "Oke deh, sampai ketemu lagi[w] nak."

#. Character:`narrator`
msgctxt "coffeebar_exterior_d00ed906"
msgid "Putain !"
msgstr "Sialan!"

#. Character:`narrator`
msgctxt "coffeebar_exterior_fd91ba2e"
msgid "J'ai jamais eu autant envie de tuer quelqu'un de ma vie."
msgstr "Aku belum pernah sebenci ini pengen ngebunuh seseorang."

#. Character:`narrator`
msgctxt "coffeebar_exterior_1f4c51e5"
msgid "Je ne peux pas laisser cette ordure arriver à ses fins."
msgstr "Aku gak bisa ngasih kesempatan brengsek itu buat berhasil."

#. Character:`saito`
msgctxt "coffeebar_exterior_f8a5baf8"
msgid "C'est fermé !"
msgstr "Tutup!"

#. Character:`saito`
msgctxt "coffeebar_exterior_8a85a199"
msgid "Où est-ce qu'elle a pu aller ?"
msgstr "Dia pergi ke mana ya?"

#. Character:`akira`
msgctxt "coffeebar_exterior_935e7106"
msgid "Tiens, tiens, tiens..."
msgstr "Hmm, hmm, hmm..."

#. Character:`akira`
msgctxt "coffeebar_exterior_ce381177"
msgid "{{saito.n}} le déchet."
msgstr "{{saito.n}} si sampah."

#. Character:`akira`
msgctxt "coffeebar_exterior_1d2cd101"
msgid "Qu'est-ce que tu viens faire dans ce quartier à une heure pareille ?"
msgstr "Kamu ngapain sih ke daerah ini jam segini?"

#. Character:`narrator`
msgctxt "coffeebar_exterior_1b12701e"
msgid "Putain, {{akira.n}} !"
msgstr "Sialan, {{akira.n}}!"

#. Character:`narrator`
msgctxt "coffeebar_exterior_cb33c666"
msgid "Pourquoi faut-il toujours que je tombe sur des emmerdeurs ?!"
msgstr "Kenapa aku selalu ketemu orang nyebelin terus?!"

#. Character:`akira`
msgctxt "coffeebar_exterior_29ed40e1"
msgid "Toujours aussi causant à ce que je vois..."
msgstr "Masih doyan ngomong ya kayaknya..."

#. Character:`akira`
msgctxt "coffeebar_exterior_9275f7dd"
msgid "Ma foi, peu importe. J'ai trouvé un truc qui va faire parler pas mal de monde."
msgstr "Ya udah lah, aku nemu sesuatu yang bakal bikin banyak orang ngomongin ini."

#. Character:`akira`
msgctxt "coffeebar_exterior_8ff18caf"
msgid "J'ai croisé ta soi-disant mère en train de marcher avec un putain de gros porc."
msgstr "Aku ketemu 'ibu' kamu yang katanya sama seekor babi gendut banget."

#. Character:`saito` | Attributes:`surprised`
msgctxt "coffeebar_exterior_13aa479f"
msgid "QUOI ?!"
msgstr "APA?!"

#. Character:`akira`
msgctxt "coffeebar_exterior_473276e2"
msgid "Ils se dirigeaient vers un love hôtel."
msgstr "Mereka lagi jalan ke love hotel."

#. Character:`akira` | Attributes:`happy`
msgctxt "coffeebar_exterior_87d03739"
msgid "Je ne savais pas qu'elle se prostituait."
msgstr "Aku gak tau dia jadi pelacur."

#. Character:`akira`
msgctxt "coffeebar_exterior_6893fbfe"
msgid "Si j'avais su, j'aurais fait appel à ses services bien plus tôt !"
msgstr "Kalau aku tau, aku udah pake jasanya dari dulu!"

#. Character:`saito` | Attributes:`angry`
msgctxt "coffeebar_exterior_ec421db8"
msgid "ESPÈCE DE..."
msgstr "ANJING..."

#. Character:`akira` | Attributes:`angry`
msgctxt "coffeebar_exterior_43b14a71"
msgid "Fais attention à ce que tu dis."
msgstr "Hati-hati sama apa yang kamu bilang."

#. Character:`akira`
msgctxt "coffeebar_exterior_25255762"
msgid "Si je dois t'éclater la tête sur le trottoir, je ne me gênerais pas."
msgstr "Kalo aku harus ngebanting kepala kamu ke trotoar, aku gak bakal ragu."

#. Character:`akira` | Attributes:`arrogant`
msgctxt "coffeebar_exterior_f46181a8"
msgid "À plus tocard !"
msgstr "Ntar dulu, bocah bodoh!"

#. Character:`narrator`
msgctxt "coffeebar_exterior_53bb8ec4"
msgid "Merde, c'est quoi ce délire..."
msgstr "Sialan, ini apaan sih..."

#. Character:`narrator`
msgctxt "coffeebar_exterior_5e5d09fd"
msgid "Je refuse de croire un truc pareil."
msgstr "Aku gak mau percaya hal gila kayak gitu."

#. Character:`narrator`
msgctxt "coffeebar_exterior_6fd549e4"
msgid "Je dois la retrouver avant qu'il ne soit trop tard."
msgstr "Aku harus nemuin dia sebelum semuanya keburu terlambat."

#. Character:`netoru`
msgctxt "talk_ubs_fcc2f08b"
msgid "J'ai failli attendre !"
msgstr "Aku hampir nunggu nih!"

#. Character:`saito`
msgctxt "talk_ubs_bb45508a"
msgid "Je suis arrivé en avance !"
msgstr "Aku dateng lebih awal!"

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "talk_ubs_4efb9256"
msgid "Le travail en lui-même n'est pas compliqué, un enfant de 4 ans pourrait le faire."
msgstr "Kerjanya sebenernya gak ribet, bocah umur 4 taun juga bisa ngelakuinnya."

#. Character:`netoru`
msgctxt "talk_ubs_172c5dd1"
msgid "Contente-toi d'être serviable, de sourire, de servir les clients, de faire le nettoyage..."
msgstr "Cukup jadi orang yang ramah, senyum, layani pelanggan, terus bersihin aja..."

#. Character:`netoru`
msgctxt "talk_ubs_66ca2b1e"
msgid "De gérer le stock, de-"
msgstr "Ngatur stok, de-"

#. Character:`saito`
msgctxt "talk_ubs_626971b4"
msgid "Un enfant de 4 ans pourrait le faire, hein..."
msgstr "Anak umur 4 tahun juga bisa ngelakuin, ya kan..."

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "talk_ubs_e6543f74"
msgid "AH ! Tu fais le malin ?"
msgstr "AH! Kamu sok jago ya?"

#. Character:`netoru`
msgctxt "talk_ubs_8fbcfade"
msgid "100¥ en moins !"
msgstr "100¥ berkurang!"

#. Character:`saito`
msgctxt "talk_ubs_03775ec8"
msgid "..."
msgstr "..."

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_87b616bf"
msgid "AU BOULOT ESPÈCE DE BRANLEUR !"
msgstr "KERJA BODOH BANGSAT!"

#. Character:`centered`
msgctxt "talk_ubs_813d6843"
msgid "{{saito.n}} fit de son mieux toute la journée."
msgstr "{{saito.n}} udah usaha sekuat tenaga seharian."

#. Character:`centered`
msgctxt "talk_ubs_d2857457"
msgid "Mais {{netoru.n}} passa sa journée à le rabaisser et à l'humilier devant les clients."
msgstr "Tapi {{netoru.n}} habisin harinya buat ngejek dan ngerendahin dia di depan pelanggan."

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "talk_ubs_9065cc7c"
msgid "Allez, ça suffit pour aujourd'hui !"
msgstr "Ayolah, cukup buat hari ini!"

#. Character:`netoru`
msgctxt "talk_ubs_afc8b2e7"
msgid "C'était un véritable désastre."
msgstr "Ini bener-bener bencana."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_038e35e8"
msgid "Vous n'avez pas non plus été vraiment aidant."
msgstr "Kalian juga gak bantu apa-apa sih."

#. Character:`netoru`
msgctxt "talk_ubs_314c5d34"
msgid "Voilà ta paye."
msgstr "Ini gajimu."

#. Character:`notice`
msgctxt "ta3108b0ad9"
msgid "Vous avez gagné 1500¥."
msgstr "Kamu dapet 1500¥."

#. Character:`saito`
msgctxt "talk_ubs_f52f9baf"
msgid "Attendez... C'est trop peu."
msgstr "Tunggu... Ini terlalu sedikit."

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_cd85e591"
msgid "Et en plus, tu te plains ? Tu as été horrible, j'ai perdu mon temps à t'expliquer comment faire le travail."
msgstr "Terus kamu ngeluh? Kamu parah banget, aku buang-buang waktu jelasin gimana cara kerja."

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_ubs_7235f720"
msgid "Mais... C'est à vous de m'expliquer !"
msgstr "Tapi... Harusnya kamu yang jelasin ke aku!"

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "talk_ubs_c7d027f0"
msgid "Et j'ai pris de mon temps pour le faire, et mon temps, c'est de l'argent, donc j'ai déduit mes honoraires de ton salaire."
msgstr "Dan aku udah ngabisin waktu aku buat itu, waktu aku itu duit, jadi aku potong honor aku dari gaji kamu."

#. Character:`narrator`
msgctxt "talk_ubs_8468f4f5"
msgid "Ce mec est pourri jusqu'à la moelle !"
msgstr "Orang ini busuk banget sampe ke tulang!"

#. Character:`narrator`
msgctxt "talk_ubs_bf6d45ef"
msgid "Je n'ai jamais eu autant envie de frapper quelqu'un de ma vie."
msgstr "Aku belum pernah sebegitu pengen mukulin orang seumur hidup aku."

#. Character:`narrator`
msgctxt "talk_ubs_864ddbef"
msgid "Mais si je fais ça, je suis sûr que je vais avoir encore plus de problèmes qu'avant."
msgstr "Tapi kalo aku lakuin itu, aku yakin masalah aku bakal makin banyak dari sebelumnya."

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_76fa3468"
msgid "ARRÊTE DE RÊVASSER ET TIRE-TOI !"
msgstr "BERHENTI MELAMUN DAN CABUT DARI SINI!"

#. Character:`netoru`
msgctxt "talk_ubs_52f2563a"
msgid "T'AS INTÉRÊT À ÊTRE LA DEMAIN À LA PREMIÈRE HEURE !"
msgstr "KAMU PASTI HARUS DI SANA BESOK PAGI-PAGI BANGET!"

#. Character:`saito`
msgctxt "coffeebar_exterior_4105bc1c"
msgid "Quelle journée horrible..."
msgstr "Hari yang menyebalkan banget..."

#. Character:`saito`
msgctxt "coffeebar_exterior_97cd39a3"
msgid "J'espère que {{yasuka.n}} ne subissait pas ça au quotidien."
msgstr "Semoga {{yasuka.n}} gak ngalamin ini tiap hari."

#. Character:`saito`
msgctxt "coffeebar_exterior_03bd8415"
msgid "Surtout pour un salaire pareil."
msgstr "Apalagi dengan gaji yang segitu."

#. Character:`saito`
msgctxt "coffeebar_exterior_a873ad2e"
msgid "Je ferais mieux de rentrer."
msgstr "Mending aku pulang aja."

#. Character:`netoru`
msgctxt "talk_ubs_7adbec28"
msgid "Ce n'est pas trop tôt !"
msgstr "Akhirnya juga!"

#. Character:`netoru`
msgctxt "talk_ubs_7f273282"
msgid "Allez, reste pas planter là et mets-toi au travail tout de suite !"
msgstr "Ayo, jangan cuma diem di situ, mulai kerja sekarang juga!"

#. Character:`netoru`
msgctxt "talk_ubs_ec330a3f"
msgid "Et ne me regarde pas avec ces yeux !"
msgstr "Jangan pandang aku pake mata kayak gitu!"

#. Character:`netoru`
msgctxt "talk_ubs_879d3fac"
msgid "Tu sais très bien ce qui peut arriver à ta chère protégée si tu déconnes."
msgstr "Kamu tau banget apa yang bakal kejadian sama cewek yang kamu lindungi kalo kamu ngaco."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_c2cffe85"
msgid "..."
msgstr "..."

#. Character:`netoru` | Attributes:`bad`
msgctxt "talk_ubs_3d89609b"
msgid "Parfait, si tu comprends, au boulot et plus vite que ça !"
msgstr "Bagus, kalo kamu paham, kerja cepet sana dan jangan ngaret!"

#. Character:`centered`
msgctxt "talk_ubs_c233b205"
msgid "{{saito.n}} passa une journée de plus en enfer à supporter les humiliations."
msgstr "{{saito.n}} ngelewatin lagi sehari penuh di neraka ngerasain penghinaan."

#. Character:`centered`
msgctxt "talk_ubs_5c1c08bf"
msgid "Après plusieurs heures à subir, {{saito.n}} estima qu'il avait assez travaillé pour aujourd'hui."
msgstr "Abis berjam-jam nahan itu semua, {{saito.n}} ngerasa dia udah cukup kerja buat hari ini."

#. Character:`saito`
msgctxt "talk_ubs_9a363f10"
msgid "Désolé, mais je ne compte pas travailler 16h par jour, surtout pour 1500¥."
msgstr "Maaf, tapi aku gak mau kerja 16 jam sehari, apalagi cuma buat 1500¥."

#. Character:`netoru`
msgctxt "talk_ubs_37303de5"
msgid "Ah, tu ne veux pas travailler ?"
msgstr "Ah, kamu gak mau kerja?"

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "talk_ubs_8eafefb4"
msgid "Très bien, aujourd'hui, tu ne toucheras que 500¥."
msgstr "Oke deh, hari ini kamu cuma dapet 500¥."

#. Character:`notice`
msgctxt "tf5b6d671d7"
msgid "Vous avez gagné 500¥."
msgstr "Kamu dapet 500¥."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_c2cffe85_1"
msgid "..."
msgstr "..."

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_2a18bda4"
msgid "MAINTENANT, TIRE-TOI SALE INGRAT !"
msgstr "SEKARANG, CABUT KAMU SIALAN TIDAK BERSYUKUR!"

#. Character:`saito`
msgctxt "talk_ubs_f47c0f82"
msgid "Je ne peux pas continuer de travailler pour ce type plus longtemps."
msgstr "Aku gak bisa terus kerja buat orang ini lebih lama lagi."

#. Character:`saito`
msgctxt "talk_ubs_8585cbda"
msgid "Je gagne trop peu d'argent et ça ne résout pas nos problèmes."
msgstr "Aku dapet duit terlalu dikit dan itu gak nyelesain masalah kita."

#. Character:`saito`
msgctxt "talk_ubs_c98dc509"
msgid "Je vais devoir aller travailler au restaurant si je veux aussi pouvoir aider à rembourser les dettes."
msgstr "Aku harus kerja di restoran kalo aku juga mau bantu bayar utang."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_e3ceb2b3"
msgid "J'ai l'impression de retrouver ma vie d'avant et d'enchainer les petits boulots pour survivre..."
msgstr "Aku ngerasa kayak balik ke kehidupan lama aku, ngejalanin kerjaan cemen buat bertahan hidup..."

#. Character:`saito` | Attributes:`-upset`
msgctxt "talk_ubs_3f3b9e95"
msgid "Ça craint."
msgstr "Ini gak banget."

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_16ce0f73"
msgid "C'EST TOI ! JE SUIS SÛR QUE C'EST TOI !"
msgstr "ITU KAMU! AKU PASTI ITU KAMU!"

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_a33b4f89"
msgid "Qu'est-ce que vous me voulez encore ?"
msgstr "Kamu mau apalagi sama aku?"

#. Character:`netoru`
msgctxt "talk_ubs_9f2107d7"
msgid "Il y a quelqu'un cette nuit qui est venue s'amuser a sonné chez moi toutes les 10 minutes."
msgstr "Malam ini ada orang yang datang main-main, ngetok pintu aku tiap 10 menit."

#. Character:`netoru`
msgctxt "talk_ubs_d1708ebd"
msgid "C'était toi ! Avoue !"
msgstr "Itu kamu! Ngaku deh!"

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_81d395be"
msgid "Bien sûr que non ! Vous croyez que j'ai que ça à faire de ma soirée ?"
msgstr "Tentu nggak! Kamu kira aku cuma ngabisin malam buat itu doang?"

#. Character:`saito`
msgctxt "talk_ubs_1a36e399"
msgid "Je ne sais même pas où vous habitez."
msgstr "Aku bahkan nggak tau kamu tinggal di mana."

#. Character:`netoru`
msgctxt "talk_ubs_976cd9bf"
msgid "BORDEL ! SI JE CHOPPE CE PETIT CON..."
msgstr "SIALAN! KALO AKU NANGKAP SI ANAK BANGSAT ITU..."

#. Character:`netoru`
msgctxt "talk_ubs_b401678f"
msgid "ARRÊTE DE ME REGARDER ET VA BOSSER FEIGNASSE !"
msgstr "BERHENTI NGELIHAT AKU DAN MULAI KERJA, MALASAN!"

#. Character:`centered`
msgctxt "talk_ubs_21ce37b2"
msgid "{{saito.n}} passa à nouveau une journée en enfer."
msgstr "{{saito.n}} menjalani hari lagi di neraka."

#. Character:`centered`
msgctxt "talk_ubs_5c1c08bf_1"
msgid "Après plusieurs heures à subir, {{saito.n}} estima qu'il avait assez travaillé pour aujourd'hui."
msgstr "Abis berjam-jam nahan itu semua, {{saito.n}} ngerasa dia udah cukup kerja buat hari ini."

#. Character:`centered`
msgctxt "talk_ubs_eb62591a"
msgid "Néanmoins, {{saito.n}} constata que le patron était moins virulent que d'habitude."
msgstr "Tapi, {{saito.n}} lihat bosnya nggak segarang biasanya."

#. Character:`netoru`
msgctxt "talk_ubs_82c0d6ca"
msgid "Allez, casse-toi, je vais fermer la boutique plus tôt aujourd'hui."
msgstr "Ayo, cabut sana, aku bakal tutup toko lebih cepet hari ini."

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_ubs_d6af1694"
msgid "Et mon salaire ?"
msgstr "Gaji aku gimana?"

#. Character:`netoru`
msgctxt "talk_ubs_a085b9a7"
msgid "Avec le peu de clients qu'on a eu ?"
msgstr "Dengan pelanggan yang cuma segitu doang?"

#. Character:`notice`
msgctxt "td0239bf2d6"
msgid "Vous avez gagné 200¥."
msgstr "Kamu dapet 200¥."

#. Character:`netoru`
msgctxt "talk_ubs_129a41ef"
msgid "Estime-toi heureux de gagner de l'argent."
msgstr "Syukurin aja bisa dapet duit."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_ff6e704f"
msgid "Mais bordel... Je gagne plus en ramassant de l'argent par terre !"
msgstr "Tapi sialan... Aku malah bisa dapet lebih banyak ngambil duit yang jatuh di jalan!"

#. Character:`saito`
msgctxt "talk_ubs_f3f91756"
msgid "Je n'ai jamais vu un esclavagiste pareil."
msgstr "Aku belum pernah liat budak yang kayak gini."

#. Character:`saito`
msgctxt "talk_ubs_c31dc0cd"
msgid "Même dans ma précédente vie."
msgstr "Bahkan di kehidupan aku yang sebelumnya."

#. Character:`saito`
msgctxt "talk_ubs_cca7d7d2"
msgid "Je ferais mieux d'aller au restaurant. Au moins, la paye est bien meilleure."
msgstr "Sebaiknya aku pergi ke restoran aja. Setidaknya gajinya jauh lebih oke."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_13e38ac5"
msgid "Je suis prêt à commencer ma journée..."
msgstr "Aku siap mulai hari ini..."

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "talk_ubs_60c27fa8"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_ubs_fadf996b"
msgid "Euh... Vous m'entendez ?"
msgstr "Eh... Kamu denger aku nggak?"

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_87aee577"
msgid "Bordel gamin, me casse pas les couilles."
msgstr "Anjing bocah, jangan ganggu aku."

#. Character:`netoru`
msgctxt "talk_ubs_5689fe99"
msgid "Va te mettre au boulot."
msgstr "Ayo mulai kerja."

#. Character:`saito`
msgctxt "talk_ubs_23f1158b"
msgid "Ça a empiré, c'est ça ?"
msgstr "Jadi makin parah ya?"

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "talk_ubs_c841105a"
msgid "...[w] J'ai trouvé ma boite aux lettres aspergée de sang ce matin."
msgstr "...[w] Aku nemu kotak surat aku penuh darah pagi ini."

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_ubs_a4381e9d"
msgid "Woah, c'est carrément flippant !"
msgstr "Wah, itu bener-bener serem!"

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_993f87c3"
msgid "Tu es content ? Maintenant dégage, je ne suis pas ton pote !"
msgstr "Kamu seneng? Sekarang pergi sana, aku bukan temen kamu!"

#. Character:`centered`
msgctxt "talk_ubs_a25ad3a8"
msgid "{{saito.n}} passa pour la première fois une journée à peu près normale."
msgstr "{{saito.n}} ngalamin hari yang agak normal buat pertama kalinya."

#. Character:`centered`
msgctxt "talk_ubs_16142624"
msgid "Après quelques heures d'effort, il termina son service."
msgstr "Setelah beberapa jam berjuang, dia selesai dengan tugasnya."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_ubs_539d34dc"
msgid "J'ai terminé."
msgstr "Aku sudah selesai."

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "talk_ubs_adc08c67"
msgid "Génial, tu veux quoi ? Une médaille pour avoir fait ton travail ?"
msgstr "Keren, kamu mau apa? Medali karena udah ngerjain tugas kamu?"

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_b58de3e1"
msgid "...[w]"
msgstr "...[w] "

#. Character:`netoru`
msgctxt "talk_ubs_2b07e93c"
msgid "Je suis émotionnellement perturbé, tu peux t'en aller, j'ai besoins de repos."
msgstr "Aku lagi bener-bener stres, kamu bisa pergi dulu, aku butuh istirahat."

#. Character:`saito`
msgctxt "talk_ubs_ccf05981"
msgid "Vous ne comptez pas me payer ?"
msgstr "Kamu nggak mau bayar aku?"

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_5be1c9a2"
msgid "PUTAIN TU ME SAOULES, C'EST À CROIRE QUE VOUS PENSEZ QU'À L'ARGENT !"
msgstr "SIALAN KAMU NGEBETEIN AKU, KAYAKNYA KAMU CUMA PIKIRIN UANG DOANG!"

#. Character:`netoru`
msgctxt "talk_ubs_15fa99fc"
msgid "TIRE-TOI ET VITE SALE PROFITEUR !"
msgstr "GUSUR KAMU CEPETAN, KAMU PENGUTIL KOTORAN!"

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_98655990"
msgid "Cette espèce d'esclavagiste ne prend même plus la peine de me payer..."
msgstr "Si budak pelahap duit ini bahkan nggak mau repot-repot bayar aku..."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_cc6a9130"
msgid "En même temps, à quoi je m'attendais ?"
msgstr "Ya tapi, aku ngarep apaan sih?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_ubs_203af949"
msgid "Allez {{saito.n}}, c'est l'heure du service au restaurant !"
msgstr "Ayo {{saito.n}}, waktunya kerja di restoran nih!"

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "talk_ubs_0fffff41"
msgid "...encore toi ?!"
msgstr "...lu lagi?!"

#. Character:`netoru`
msgctxt "talk_ubs_48d4f489"
msgid "Qu'est-ce que tu me veux ?"
msgstr "Kamu mau apa sama aku?"

#. Character:`netoru`
msgctxt "talk_ubs_15d569af"
msgid "Tu n'en as pas marre de te moquer de moi ?"
msgstr "Gak bosen ya ngejek aku terus?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_ubs_cc0bccd7"
msgid "De vous torturer ?"
msgstr "Siksa diri kalian ya?"

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_ubs_dd28627b"
msgid "Euh... Vous devez faire erreur, je ne suis pas responsable de ça."
msgstr "Eh... Kayaknya kalian salah, aku gak tanggung jawab soal itu."

#. Character:`netoru`
msgctxt "talk_ubs_0bebdcbe"
msgid "La privation de sommeil, le sang dans la boite aux lettres et maintenant les traces de coupures sur le corps quand je me réveille."
msgstr "Kurang tidur, darah di kotak surat, terus sekarang ada bekas luka potong di badan aku pas bangun tidur."

#. Character:`netoru`
msgctxt "talk_ubs_188d7563"
msgid "Il y a un taré qui veut me tuer !"
msgstr "Ada orang gila yang pengen bunuh aku!"

#. Character:`saito`
msgctxt "talk_ubs_5a59cc5e"
msgid "Appelez la police dans ce cas !"
msgstr "Ya panggil polisi aja dong!"

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_17e5b34d"
msgid "NON !"
msgstr "GAK!"

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_ubs_14a617ab"
msgid "Pourquoi ? Vous avez peur qu'elle trouve des choses compromettantes chez vous ou à la boutique ?"
msgstr "Kenapa? Kamu takut polisi nemuin sesuatu yang memberatkan di tempat kamu atau toko?"

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "talk_ubs_4ff94e8a"
msgid "..."
msgstr "..."

#. Character:`narrator`
msgctxt "talk_ubs_f16cdaa6"
msgid "Nous y voilà enfin !"
msgstr "Akhirnya sampai juga nih!"

#. Character:`narrator`
msgctxt "talk_ubs_65acf4b4"
msgid "Je ne sais pas qui est en train de le traquer, mais ça m'arrange."
msgstr "Aku nggak tau siapa yang lagi ngikutin dia, tapi aku sih nggak masalah."

#. Character:`narrator`
msgctxt "talk_ubs_02c95d0c"
msgid "Honnêtement, vu son comportement, il a dû provoquer la personne qu'il ne fallait pas."
msgstr "Jujur aja, liat sikapnya, dia pasti nyentuh orang yang salah."

#. Character:`narrator`
msgctxt "talk_ubs_9b9c0a60"
msgid "Il faut que je demande à {{noriko.n}}."
msgstr "Aku harus nanya ke {{noriko.n}}."

#. Character:`narrator`
msgctxt "talk_ubs_f2d7763b"
msgid "Et il faut surtout que j'en profite pour régler cette histoire avec {{yasuka.n}}."
msgstr "Dan yang paling penting, aku harus manfaatin kesempatan ini buat beresin urusan sama {{yasuka.n}}."

#. Character:`saito`
msgctxt "talk_ubs_5f1e7a60"
msgid "Tout ça va continuer et je dirai même que les choses vont s'aggraver."
msgstr "Semua ini bakal terus berlanjut dan aku malah yakin keadaannya bakal makin parah."

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_b40a021d"
msgid "Quoi ?! Tu me menaces gamin ?"
msgstr "Apa?! Kamu mau ngancem aku, bocah?"

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_ubs_c8f068c9"
msgid "Doucement, je ne suis pas responsable de ce qui vous arrive."
msgstr "Santai, aku nggak tanggung jawab sama apa yang terjadi sama kalian."

#. Character:`saito`
msgctxt "talk_ubs_8e4c4d40"
msgid "Vous êtes le seul responsable de votre situation."
msgstr "Kalian sendiri yang harus tanggung jawab atas situasi kalian."

#. Character:`saito`
msgctxt "talk_ubs_5a9de8f4"
msgid "Vous êtes absolument odieux et vous avez dû énerver beaucoup de monde."
msgstr "Kalian bener-bener nyebelin dan pasti udah nyebelin banyak orang."

#. Character:`saito`
msgctxt "talk_ubs_b0ad906c"
msgid "Probablement la personne qu'il ne fallait pas."
msgstr "Mungkin orang yang salah itu."

#. Character:`netoru`
msgctxt "talk_ubs_7078d593"
msgid "PUTAIN !"
msgstr "SIALAN!"

#. Character:`saito`
msgctxt "talk_ubs_3a9ad98b"
msgid "Je vous conseille fortement de corriger votre attitude et de vous excuser auprès de tous ceux à qui vous avez fait du tort."
msgstr "Aku saranin banget kamu ubah sikap dan minta maaf ke semua orang yang udah kamu sakitin."

#. Character:`netoru` | Attributes:`bad`
msgctxt "talk_ubs_1d7dbb87"
msgid "HAHA ! Et puis quoi encore, je préfèrerai plutôt crever !"
msgstr "HAHA! Terus apalagi, mending aku mati aja deh!"

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_762108dd"
msgid "Je réussirai à chopper cet enfoiré, et je le tuerai de mes propres mains !"
msgstr "Aku bakal nangkep bajingan itu, dan aku bakal bunuh dia dengan tangan aku sendiri!"

#. Character:`netoru`
msgctxt "talk_ubs_b1d977df"
msgid "Maintenant, casse-toi, je dois préparer ma défense et je ne te veux pas dans mes pattes !"
msgstr "Sekarang, cabut sana, aku harus siapin pembelaan aku dan aku nggak mau kamu ngerepotin!"

#. Character:`saito`
msgctxt "talk_ubs_3e0a2cd2"
msgid "Je ferais mieux d'aller au restaurant, je parlerais à {{noriko.n}} ce soir."
msgstr "Mending aku ke restoran aja, aku bakal ngobrol sama {{noriko.n}} malam ini."

#. Character:`netoru`
msgctxt "talk_ubs_ed9d1ef5"
msgid "Putain, putain, putain, PUTAINNNN !"
msgstr "Sialan, sialan, sialan, SIALLANNN!"

#. Character:`netoru`
msgctxt "talk_ubs_1d9780d1"
msgid "MERDE ! J'EN AI RAS LE BOL !"
msgstr "SIAL! AKU UDAN MUAK BANGET!"

#. Character:`netoru`
msgctxt "talk_ubs_dbdaaf76"
msgid "Faites que ça s'arrête par pitié..."
msgstr "Tolong, biarin ini berhenti, tolong..."

#. Character:`saito`
msgctxt "talk_ubs_4e3e2265"
msgid "Euh, tout va bien ?"
msgstr "Eh, semuanya baik-baik aja?"

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_2376588a"
msgid "NON ! Bien sûr que non, je hurle pour le plaisir."
msgstr "NGGAK! Jelas nggak, aku teriak cuma buat seneng-seneng aja."

#. Character:`saito`
msgctxt "talk_ubs_45e558f0"
msgid "Je suppose que votre situation a empiré."
msgstr "Aku rasa situasimu makin parah."

#. Character:`netoru`
msgctxt "talk_ubs_d62674ac"
msgid "Tu n'as même pas idée à quel point !"
msgstr "Kamu nggak punya bayangan seberapa parahnya!"

#. Character:`netoru`
msgctxt "talk_ubs_eb1f2b3e"
msgid "Tout ça a complètement dégénéré."
msgstr "Semuanya udah bener-bener kacau."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_ubs_d169a6db"
msgid "Vous pourriez peut-être envisager de réparer vos erreurs..."
msgstr "Mungkin kamu harus mikirin buat benerin kesalahanmu..."

#. Character:`netoru`
msgctxt "talk_ubs_179ba0a0"
msgid "Non ! Je ne veux pas !"
msgstr "Nggak! Aku nggak mau!"

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_ubs_1ed9f42a"
msgid "Mais tout ça va continuer, vous le savez..."
msgstr "Tapi semuanya bakal terus gitu, kamu tahu itu..."

#. Character:`saito`
msgctxt "talk_ubs_4e2d10f8"
msgid "Parfois, il faut s'avouer vaincu et accepter la défaite."
msgstr "Kadang, harus ngaku kalah dan terima kekalahan."

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "talk_ubs_388d865b"
msgid "Je..."
msgstr "Aku..."

#. Character:`netoru` | Attributes:`angry`
msgctxt "talk_ubs_3ba0e1ec"
msgid "PLUTÔT CREVER !"
msgstr "MENDING MATI AJA!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_ubs_bc151b92"
msgid "Non, mais je rêve ?!"
msgstr "Seriusan, aku mimpi ya?!"

#. Character:`saito`
msgctxt "talk_ubs_1173903f"
msgid "Il s'est barré comme ça en me laissant sur place ?"
msgstr "Dia kabur gitu aja ninggalin aku di sini?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_ubs_f614ad2d"
msgid "Du coup, je suppose que je devrais aller à mon vrai travail..."
msgstr "Jadi, kayaknya aku harus balik ke kerjaan aku yang beneran nih..."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_ubs_b92aac18"
msgid "Quand même, c'est presque trop beau pour être vrai, toute cette situation qui se résolve d'elle-même."
msgstr "Tapi ya, ini hampir nggak masuk akal, semua masalah ini beres sendiri gitu aja."

#. Character:`saito`
msgctxt "coffeebar_exterior_d6459a06"
msgid "Tiens, c'est bizarre, il n'est pas dehors pour une fois ?"
msgstr "Eh, aneh ya, dia nggak ada di luar buat sekali ini?"

#. Character:`saito`
msgctxt "coffeebar_exterior_3a072529"
msgid "Il est peut-être à l'intérieur."
msgstr "Mungkin dia lagi di dalam."

#. Character:`natsume`
msgctxt "coffeebar_exterior_970a3680"
msgid "Alors ? Explique-moi un peu tout ce délire !"
msgstr "Jadi? Ceritain semua kekacauan ini ke aku dong!"

#. Character:`saito` | Attributes:`sad`
msgctxt "coffeebar_exterior_18bf55b2"
msgid "Tu ne vas pas avoir des problèmes avec {{minato.n}} si tu me parles ?"
msgstr "Kamu nggak bakal kena masalah sama {{minato.n}} cuma gara-gara ngomong sama aku kan?"

#. Character:`natsume` | Attributes:`pouting`
msgctxt "coffeebar_exterior_062c614c"
msgid "Toujours à te prendre la tête avec les autres, alors que tu ferais mieux de penser à toi..."
msgstr "Selalu ribet sama orang lain, padahal mending mikirin diri kamu sendiri..."

#. Character:`natsume` | Attributes:`happy`
msgctxt "coffeebar_exterior_dd17903c"
msgid "Tu n'as pas à t'inquiéter de ça."
msgstr "Kamu nggak usah khawatir soal itu."

#. Character:`natsume`
msgctxt "coffeebar_exterior_695f8d91"
msgid "Et puis je ne crois pas avoir demandé d'aide."
msgstr "Dan aku juga nggak inget pernah minta bantuan."

#. Character:`natsume` | Attributes:`-happy`
msgctxt "coffeebar_exterior_c74028b1"
msgid "Raconte-moi ce qu'il se passe !"
msgstr "Ceritain apa yang sebenernya terjadi!"

#. Character:`saito`
msgctxt "coffeebar_exterior_474fe8ef"
msgid "Je crois que je pourrais pas y couper..."
msgstr "Aku rasa aku gak bisa ngelakarin ini..."

#. Character:`natsume` | Attributes:`happy`
msgctxt "coffeebar_exterior_667c48f8"
msgid "Tu commences à me connaitre !"
msgstr "Kamu mulai kenal aku nih!"

#. Character:`centered`
msgctxt "coffeebar_exterior_d4f81b19"
msgid "{{saito.n}} lui raconta alors tous les derniers événements."
msgstr "{{saito.n}} terus cerita semua kejadian terakhir ke dia."

#. Character:`saito`
msgctxt "coffeebar_exterior_c4ea87c7"
msgid "Tu en sais autant que moi à présent."
msgstr "Sekarang kamu tau semua kayak aku."

#. Character:`natsume`
msgctxt "coffeebar_exterior_530c8790"
msgid "Tu es un putain d'idiot !"
msgstr "Kamu emang bodoh banget!"

#. Character:`saito` | Attributes:`upset`
msgctxt "coffeebar_exterior_347b42c3"
msgid "QUOI ?!"
msgstr "APA?!"

#. Character:`natsume`
msgctxt "coffeebar_exterior_4c7c0dc1"
msgid "Ah bon sang, vous les mecs, vous êtes irrécupérables."
msgstr "Ah sialan, kalian cowok emang gak bisa diperbaiki."

#. Character:`natsume`
msgctxt "coffeebar_exterior_b9444519"
msgid "Elle ne risque rien."
msgstr "Dia gak bakal kenapa-kenapa."

#. Character:`saito`
msgctxt "coffeebar_exterior_b15beab2"
msgid "Mais et {{akira.n}} ?"
msgstr "Tapi gimana sama {{akira.n}}?"

#. Character:`natsume` | Attributes:`pouting`
msgctxt "coffeebar_exterior_b1c7288f"
msgid "Pourquoi tu t'inquiètes pour cette petite bite ?"
msgstr "Kenapa kamu khawatir sama bocah kecil itu?"

#. Character:`natsume`
msgctxt "coffeebar_exterior_5d6c6e97"
msgid "Ce mec est juste un beau parleur."
msgstr "Cowok itu cuma tukang omong doang."

#. Character:`natsume` | Attributes:`happy`
msgctxt "coffeebar_exterior_d65fec7a"
msgid "De plus, je connais bien cet établissement...[w] j'y ai déjà travaillé."
msgstr "Selain itu, aku juga kenal banget sama tempat ini...[w] aku pernah kerja di sini."

#. Character:`saito` | Attributes:`surprised`
msgctxt "coffeebar_exterior_13f7647f"
msgid "Tu as été hôtesse toi aussi ?!"
msgstr "Kamu juga pernah jadi pramugari?!"

#. Character:`natsume` | Attributes:`pouting`
msgctxt "coffeebar_exterior_fcaf4a57"
msgid "Ça ne te regarde pas !"
msgstr "Itu urusan kamu!"

#. Character:`natsume` | Attributes:`happy`
msgctxt "coffeebar_exterior_929fb880"
msgid "Mais crois-moi qu'ici personne ne touche les femmes à moins d'avoir un compte en banque à 10 chiffres."
msgstr "Tapi percaya deh, di sini gak ada yang nyentuh cewek kecuali punya rekening bank 10 digit."

#. Character:`natsume`
msgctxt "coffeebar_exterior_6754707e"
msgid "Et encore, il faut qu'elles soient consentantes."
msgstr "Dan itu pun, ceweknya harus setuju dulu."

#. Character:`saito`
msgctxt "coffeebar_exterior_03775ec8_1"
msgid "..."
msgstr "..."

#. Character:`natsume` | Attributes:`angry`
msgctxt "coffeebar_exterior_5c96e2f9"
msgid "Et puis fais-lui confiance un peu !"
msgstr "Dan percayain dia dikit dong!"

#. Character:`natsume`
msgctxt "coffeebar_exterior_646651a2"
msgid "Elle semble faire ça pour vous sortir des emmerdes, pas pour s'amuser avec le premier gamin venu !"
msgstr "Dia kayaknya ngelakuin itu buat nolongin kalian dari masalah, bukan buat seneng-seneng sama bocah random!"

#. Character:`saito` | Attributes:`neutral`
msgctxt "coffeebar_exterior_ccbf63c0"
msgid "T'es douée..."
msgstr "Kamu jago banget..."

#. Character:`natsume` | Attributes:`bad`
msgctxt "coffeebar_exterior_1c43d75b"
msgid "Précise, y'a un tas de domaine ou j'excelle et certains sont confidentiels."
msgstr "Jelasinnya, ada banyak bidang yang aku jago dan beberapa rahasia."

#. Character:`saito`
msgctxt "coffeebar_exterior_0136f5be"
msgid "Pour me rassurer."
msgstr "Buat bikin aku tenang aja."

#. Character:`natsume`
msgctxt "coffeebar_exterior_a703dd82"
msgid "Pff, idiot."
msgstr "Pff, idiot."

#. Character:`natsume`
msgctxt "coffeebar_exterior_883859e7"
msgid "Tiens, tu veux passer une bonne nuit ?"
msgstr "Eh, mau malam yang seru?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "coffeebar_exterior_3b2b21f9"
msgid "Euh... C'est une proposition ou... ?"
msgstr "Eh... Ini ajakan atau gimana...?"

#. Character:`natsume` | Attributes:`happy`
msgctxt "coffeebar_exterior_1ad1aa52"
msgid "Mais quel pervers, tu veux qu'on se fasse un plan à 3 avec {{asami.n}} ?"
msgstr "Buset, kamu pengen kita bikin threesome sama {{asami.n}}?"

#. Character:`natsume` | Attributes:`bad`
msgctxt "coffeebar_exterior_d1834a96"
msgid "Je me doute que tu aimerais bien mais..."
msgstr "Aku tau banget kamu pengen sih tapi..."

#. Character:`natsume`
msgctxt "coffeebar_exterior_0b704b5e"
msgid "C'était juste une blague."
msgstr "Cuma becandaan doang."

#. Character:`natsume`
msgctxt "coffeebar_exterior_86a5c6d7"
msgid "Mais je peux pas t'en vouloir d'avoir cette idée en tête."
msgstr "Tapi aku gak bisa nyalahin kamu mikirin itu."

#. Character:`natsume`
msgctxt "coffeebar_exterior_727a6aa3"
msgid "Deux filles sexy rien que pour toi."
msgstr "Dua cewek seksi cuma buat kamu."

#. Character:`natsume` | Attributes:`happy`
msgctxt "coffeebar_exterior_10b487bb"
msgid "Le rêve de tout homme."
msgstr "Mimpi semua cowok."

#. Character:`narrator`
msgctxt "te241345fa8"
msgid "Mais carrément !"
msgstr "Bener banget!"

#. Character:`natsume` | Attributes:`pouting`
msgctxt "coffeebar_exterior_53f02ddb"
msgid "Mince, moi qui croyais que t'allais tomber dans le panneau."
msgstr "Duh, aku pikir kamu bakal ketipu."

#. Character:`natsume` | Attributes:`bad`
msgctxt "coffeebar_exterior_47300511"
msgid "Mais dans d'autres circonstances... Je n'aurais pas dit non."
msgstr "Tapi kalo situasinya beda... Aku nggak bakal nolak sih."

#. Character:`natsume`
msgctxt "coffeebar_exterior_87f3025e"
msgid "Mais à présent, tu es coincée, impossible pour toi de savoir si je suis sarcastique ou pas."
msgstr "Tapi sekarang, kamu terjebak, nggak mungkin buat kamu tahu aku lagi nyindir apa nggak."

#. Character:`narrator`
msgctxt "tdaaab64bcf"
msgid "Arrête de te foutre de moi."
msgstr "Berhenti ngejek aku dong."

#. Character:`saito` | Attributes:`sad`
msgctxt "coffeebar_exterior_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`upset`
msgctxt "coffeebar_exterior_146f8a9c"
msgid "Arrête de te foutre de moi."
msgstr "Berhenti ngejek aku dong."

#. Character:`natsume` | Attributes:`pouting`
msgctxt "coffeebar_exterior_82e66687"
msgid "Rho, allez le prend pas mal, je te promets que toi et moi, on se fera un truc ensemble !"
msgstr "Ah, jangan baper, aku janji kita bakal ngelakuin sesuatu bareng kok!"

#. Character:`saito`
msgctxt "coffeebar_exterior_c2273609"
msgid "C'est encore une de tes blagues ?"
msgstr "Itu lelucon kamu lagi ya?"

#. Character:`natsume` | Attributes:`happy`
msgctxt "coffeebar_exterior_57ea6d42"
msgid "Seul le temps le dira."
msgstr "Waktu yang bakal bilang."

#. Character:`natsume`
msgctxt "coffeebar_exterior_a4f2f05a"
msgid "Allez... Oublie un peu ton pénis et viens avec moi par ici, ça ne devrait plus tarder."
msgstr "Ayolah... Lupakan dulu penis kamu dan ikut aku ke sini, sebentar lagi nih."

#. Character:`saito` | Attributes:`neutral`
msgctxt "coffeebar_exterior_4a36b24f"
msgid "Qu'est-ce que tu veux me montrer ?"
msgstr "Mau nunjukin apa ke aku?"

#. Character:`natsume`
msgctxt "coffeebar_exterior_7765e384"
msgid "Quelque chose qui te donnera le sourire !"
msgstr "Sesuatu yang bakal bikin kamu senyum!"

#. Character:`narrator`
msgctxt "coffeebar_exterior_39146d15"
msgid "Putain, ils veulent vraiment ma peau."
msgstr "Sialan, mereka bener-bener pengen ngebunuh aku."

#. Character:`narrator`
msgctxt "coffeebar_exterior_c5cef682"
msgid "Mon seul espoir, c'est cette boutique."
msgstr "Harapan satu-satunya aku cuma toko ini."

#. Character:`nobu`
msgctxt "coffeebar_exterior_f660aabd"
msgid "ENFIN !"
msgstr "AKHIRNYA!"

#. Character:`nobu`
msgctxt "coffeebar_exterior_72e9885f"
msgid "IL EST COINCÉ !"
msgstr "DIA TERKURUNG!"

#. Character:`takeo`
msgctxt "coffeebar_exterior_9ff56d5a"
msgid "Putain, ferme ta gueule, laisse nous reprendre notre souffle."
msgstr "Sialan, tutup mulut kamu, kasih kita napas dulu."

#. Character:`kenji` | Attributes:`neutral`
msgctxt "coffeebar_exterior_5545f95c"
msgid "De toute façon ça tombe bien, je boirai bien un truc !"
msgstr "Ngomong-ngomong, enak juga nih kalo aku minum sesuatu!"

#. Character:`nobu`
msgctxt "coffeebar_exterior_6fcc4016"
msgid "Non, on le défonce d'abord !"
msgstr "Nggak, kita hajar duluan!"

#. Character:`takeo`
msgctxt "coffeebar_exterior_b1b72ed6"
msgid "Tu vois quand tu veux !"
msgstr "Liat, kalo mau bisa juga!"

#. Character:`kenji` | Attributes:`angry`
msgctxt "coffeebar_exterior_cd693907"
msgid "Tu nous as bien fait perdre notre temps aujourd'hui, alors que tout ça aurait pu être terminé rapidement."
msgstr "Kamu bikin kita buang-buang waktu hari ini, padahal semuanya bisa selesai cepet."

#. Character:`nobu`
msgctxt "coffeebar_exterior_14989668"
msgid "Laissez-moi lui en mettre une !"
msgstr "Kasih aku kesempatan buat pukulin dia!"

#. Character:`kenji` | Attributes:`neutral`
msgctxt "coffeebar_exterior_cf7eb2cb"
msgid "Non, {{akira.n}} nous attend depuis bien trop longtemps, on risque d'avoir encore plus d'emmerdes."
msgstr "Nggak, {{akira.n}} udah nunggu kita terlalu lama, kita malah bakal kena masalah lebih parah."

#. Character:`narrator`
msgctxt "coffeebar_exterior_732f8a10"
msgid "J'ai plus le choix à présent."
msgstr "Aku nggak punya pilihan lagi sekarang."

#. Character:`narrator`
msgctxt "coffeebar_exterior_845c8f58"
msgid "Je dois attendre la bonne occasion."
msgstr "Aku harus nunggu momen yang pas."

#. Character:`nobu` | Attributes:`angry`
msgctxt "coffeebar_exterior_257c6d4d"
msgid "Fait chier !"
msgstr "Sialan!"

#. Character:`takeo`
msgctxt "coffeebar_exterior_e8a8eed1"
msgid "Dépêchons-nous de le rejoindre au dojo."
msgstr "Cepet kita ke dojo buat ketemu dia."

#. Character:`saito`
msgctxt "coffeebar_exterior_bdec40fa"
msgid "Bon... Ce type me laissera dans la merde quoi qu'il arrive."
msgstr "Oke... Orang ini bakal ninggalin aku susah apapun yang terjadi."

#. Character:`saito`
msgctxt "coffeebar_exterior_5420d6bd"
msgid "Mais j'ai l'impression qu'il ne me dit pas tout."
msgstr "Tapi aku ngerasa dia nggak ngasih tau aku semuanya."

#. Character:`akira`
msgctxt "coffeebar_exterior_601436bf"
msgid "Tiens, tiens, qui voilà..."
msgstr "Nah, nah, siapa nih..."

#. Character:`saito`
msgctxt "coffeebar_exterior_11aa6672"
msgid "Qu'est-ce que tu veux encore ?"
msgstr "Mau apa lagi kamu?"

#. Character:`akira`
msgctxt "coffeebar_exterior_12e58909"
msgid "Tu ne pourras pas éternellement te cacher derrière ce gros porc."
msgstr "Kamu nggak bakal bisa terus-terusan sembunyi di balik babi gemuk itu."

#. Character:`akira`
msgctxt "coffeebar_exterior_9ce74ffa"
msgid "Il arrivera bien à un moment où tu te retrouveras seul."
msgstr "Suatu saat pasti bakal ada saatnya kamu sendirian."

#. Character:`akira`
msgctxt "coffeebar_exterior_d31cc6ee"
msgid "Et ce jour-là... Tu vas prendre cher."
msgstr "Dan hari itu... Kamu bakal kena beneran."

#. Character:`akira`
msgctxt "coffeebar_exterior_8a4c9e66"
msgid "Et puis... Je n'oublie pas qui-tu-sais."
msgstr "Terus... Aku gak lupa siapa-dia-itu."

#. Character:`akira`
msgctxt "coffeebar_exterior_7dab334d"
msgid "Je la baiserai. Tu peux me croire !"
msgstr "Aku bakal ngencengin dia. Kamu bisa percaya itu!"

#. Character:`narrator`
msgctxt "coffeebar_exterior_a3c55d3d"
msgid "Ah, je rêverai de lui éclater la gueule une bonne fois pour toutes."
msgstr "Ah, aku mimpi pengen ngebantai muka dia sekali dan buat selamanya."

#. Character:`narrator`
msgctxt "coffeebar_exterior_0307b665"
msgid "Je suis certain qu'il prépare un sale coup."
msgstr "Aku yakin dia lagi nyiapin rencana busuk."

#. Character:`narrator`
msgctxt "coffeebar_exterior_9210d93f"
msgid "Je dois avertir {{yasuka.n}} de faire attention a {{akira.n}}."
msgstr "Aku harus ngasih tau {{yasuka.n}} buat hati-hati sama {{akira.n}}."

#. Character:`saito` | Attributes:`happy`
msgctxt "IL_ME_SEMBLE_QUE_C_EST_ICI_7F0131"
msgid "Il me semble que c'est ici."
msgstr "Kayaknya ini tempatnya."

#. Character:`saito`
msgctxt "DE_TOUTE_FA_ON_C_EST_LA_SEULE_06661A"
msgid "De toute façon, c'est la seule boutique de ce style du quartier, impossible de se tromper."
msgstr "Pokoknya, ini satu-satunya toko kayak gini di daerah sini, gak mungkin salah."

#. Character:`saito`
msgctxt "JE_NE_CROIS_PAS_TRE_D_J_VENU_I_617290"
msgid "Je ne crois pas être déjà venu ici auparavant."
msgstr "Kayaknya aku belum pernah ke sini sebelumnya."

#. Character:`netoru` | Attributes:`angry`
msgctxt "HEY_ARR_TE_DE_TRA_NER_DEVANT_M_F6A760"
msgid "Hey ! Arrête de traîner devant ma boutique et tire-toi !"
msgstr "Hei! Berhenti nongkrong depan toko aku dan cabut sana!"

#. Character:`narrator` | Attributes:`surprised`
msgctxt "WOAH_C_EST_QUI_LUI_68F4B2"
msgid "Woah ! C'est qui lui ?!"
msgstr "Woah! Itu siapa dia?!"

#. Character:`narrator`
msgctxt "UNE_MINUTE_BOSS_4D2C06"
msgid "Une minute... Boss ?"
msgstr "Tunggu... Bos?"

#. Character:`narrator`
msgctxt "C_EST_LUI_SON_PATRON_BB84CE"
msgid "C'est lui son patron ?"
msgstr "Dia bosnya ya?"

#. Character:`narrator` | Attributes:`guilty`
msgctxt "BON_SANG_JE_COMPRENDS_MIEUX_PO_3E8476"
msgid "Bon sang, je comprends mieux pourquoi {{yasuka.n}} semblait si réticente à l'idée de retourner travailler."
msgstr "Sialan, aku jadi ngerti kenapa {{yasuka.n}} keliatan ogah banget buat balik kerja."

#. Character:`narrator` | Attributes:`neutral`
msgctxt "NON_NE_JUGEONS_PAS_TROP_VITE_M_3EE05D"
msgid "Non... Ne jugeons pas trop vite, {{macumba.n}} était aussi effrayant aux premiers abords mais il avait un cœur d'or."
msgstr "Gak... Jangan buru-buru nilai, {{macumba.n}} juga awalnya serem tapi sebenernya dia berhati emas."

#. Character:`narrator`
msgctxt "LAISSONS_LUI_SA_CHANCE_763479"
msgid "Laissons-lui sa chance."
msgstr "Kasih dia kesempatan aja."

#. Character:`netoru` | Attributes:`angry`
msgctxt "HEY_LE_DEMEUR_8189AF"
msgid "Hey, le demeuré !"
msgstr "Hei, kamu bodoh!"

#. Character:`netoru`
msgctxt "TIRE_TOI_DE_L_OU_J_APPELLE_LA_50D806"
msgid "Tire-toi de là ou j'appelle la police ? T'es bouché ou quoi ?"
msgstr "Cabut dari sini atau aku panggil polisi? Kamu bodoh apa gimana?"

#. Character:`netoru`
msgctxt "ICI_C_EST_POUR_MES_CLIENTS_UNI_FC578F"
msgid "Ici c'est pour mes clients uniquement."
msgstr "Ini tempat buat pelanggan aku doang."

#. Character:`saito` | Attributes:`surprised`
msgctxt "MAIS_JE_SUIS_JUSTEMENT_UN_CLIE_791222"
msgid "Mais je suis justement un client !!"
msgstr "Tapi aku kan pelanggan!!"

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "W_MOUAIS_T_AS_LA_T_TE_DE_QUEL_10FDFC"
msgid "...[w] Mouais, t'as la tête de quelqu'un de fauché."
msgstr "...[w] Yah, kamu keliatan kayak orang yang lagi bokek."

#. Character:`narrator` | Attributes:`angry`
msgctxt "MAIS_QUEL_PUTAIN_DE_B_TARD_FCA6EE"
msgid "Mais quel putain de bâtard !"
msgstr "Bajingan sialan banget sih!"

#. Character:`narrator`
msgctxt "BON_JE_SUIS_VENU_POUR_ELLE_OUB_1997AA"
msgid "Bon, je suis venu pour elle, oublions ce gros connard."
msgstr "Oke, aku dateng buat dia, lupakan si brengsek itu."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "BONJOUR_MONSIEUR_CCCA48"
msgid "Bonjour Monsieur."
msgstr "Halo Pak."

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "EH_BIEN_CE_N_EST_PAS_TROP_T_T_7C3A3A"
msgid "Eh bien ce n'est pas trop tôt, allez donc me préparer un café."
msgstr "Ya udah, lama banget sih, cepetin bikinin kopi aku."

#. Character:`yasuka`
msgctxt "JE_VOUS_APPORTE_A_TOUT_DE_SUIT_046DBF"
msgid "Je vous apporte ça tout de suite."
msgstr "Aku bawa sekarang juga."

#. Character:`netoru` | Attributes:`neutral`
msgctxt "W_UN_INSTANT_0D87FF"
msgid "...[w] Un instant !"
msgstr "...[w] Tunggu sebentar!"

#. Character:`yasuka`
msgctxt "OUI_D2DD58"
msgid "Oui ?"
msgstr "Iya?"

#. Character:`netoru`
msgctxt "TOUT_VA_BIEN_FDFFA0"
msgid "Tout va bien ?"
msgstr "Aku baik-baik aja?"

#. Character:`yasuka`
msgctxt "OUI_JE_JE_VAIS_BIEN_MERCI_DE_686D45"
msgid "... Oui, je... je vais bien, merci de vous inquiéter pour moi."
msgstr "... Iya, aku... aku baik-baik aja, makasih udah perhatian."

#. Character:`yasuka`
msgctxt "ENCORE_TOUTES_MES_EXCUSES_POUR_40B744"
msgid "Encore toutes mes excuses pour mon retard."
msgstr "Maaf banget ya aku telat."

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "VOUS_N_TES_PAS_EN_RETARD_YASUK_998915"
msgid "Vous n'êtes pas en retard {{yasuka.n}}, vous êtes toujours en avance."
msgstr "Kamu gak telat {{yasuka.n}}, kamu malah selalu datang lebih awal."

#. Character:`netoru`
msgctxt "SERVEZ_VOUS_UNE_TASSE_DE_TH_OU_1F4B6D"
msgid "Servez-vous une tasse de thé ou un café, cela vous fera du bien."
msgstr "Nikmati secangkir teh atau kopi, itu bakal bikin kamu enakan."

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "OH_JE_MERCI_BEAUCOUP_MONSIEUR_B677F8"
msgid "Oh... je... Merci beaucoup Monsieur."
msgstr "Oh... aku... Makasih banyak Pak."

#. Character:`netoru` | Attributes:`neutral`
msgctxt "ELLE_N_EST_VRAIMENT_PAS_COMME_224B21"
msgid "Elle n'est vraiment pas comme d'habitude."
msgstr "Dia bener-bener nggak kayak biasanya."

#. Character:`netoru`
msgctxt "ELLE_QUI_D_HABITUDE_EST_TOUJOU_5E5159"
msgid "Elle qui d'habitude est toujours si souriante..."
msgstr "Dia yang biasanya selalu senyum terus..."

#. Character:`netoru` | Attributes:`bad`
msgctxt "IL_Y_A_PEUT_TRE_QUELQUE_CHOSE_6ACFCF"
msgid "Il y a peut-être quelque chose à en tirer."
msgstr "Mungkin ada sesuatu yang bisa diambil dari ini."

#. Character:`netoru` | Attributes:`neutral`
msgctxt "YASUKA_N_JE_SAIS_QUE_PARFOIS_8FE735"
msgid "{{yasuka.n}} je sais que parfois je me montre assez dur avec vous mais j'ai beaucoup apprécié le fait que vous vous soyez confiée à moi."
msgstr "{{yasuka.n}} aku tahu kadang aku cukup keras sama kamu tapi aku bener-bener menghargai kamu udah percaya sama aku."

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "OH_JE_JE_SUIS_D_SOL_E_C_EST_QU_C504D2"
msgid "Oh je... Je suis désolée... C'est que vous paraissiez si intimidant auparavant que je n'osais pas..."
msgstr "Oh aku... Maaf ya... Soalnya kamu keliatan serem sebelumnya jadi aku nggak berani..."

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "J_AI_CONSCIENCE_QUE_JE_NE_SUIS_829781"
msgid "J'ai conscience que je ne suis pas parfait, je tâcherai de corriger certains de mes travers à l'avenir."
msgstr "Aku sadar aku nggak sempurna, aku bakal coba perbaiki beberapa kebiasaan burukku ke depannya."

#. Character:`netoru` | Attributes:`neutral`
msgctxt "JE_VOUS_SOUHAITE_UNE_BONNE_SOI_FBB684"
msgid "Je vous souhaite une bonne soirée."
msgstr "Aku harap kamu malamnya menyenangkan."

#. Character:`yasuka` | Attributes:`happy`
msgctxt "VOUS_AUSSI_MONSIEUR_BONSOIR_E_F80079"
msgid "À vous aussi Monsieur, bonsoir et à demain !"
msgstr "Kamu juga Pak, selamat malam dan sampai besok!"

#. Character:`netoru` | Attributes:`neutral`
msgctxt "BIEN_VOYONS_O_CETTE_NOUVELLE_A_B712D2"
msgid "Bien... Voyons où cette nouvelle approche pourra nous mener, je le sens bien cette fois-ci."
msgstr "Baiklah... Mari kita lihat ke mana pendekatan baru ini akan membawa kita, aku ngerasa kali ini bakal berhasil."

#. Character:`netoru` | Attributes:`bad`
msgctxt "BONJOUR_JE_CONSTATE_QUE_VOUS_A_9BBB50"
msgid "Bonjour... Je constate que vous avez retrouvé le sourire, cela vous va beaucoup mieux."
msgstr "Hai... Aku lihat kamu udah senyum lagi, itu jauh lebih cocok buat kamu."

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "OUI_MERCI_UNE_GROSSE_PARTIE_DE_021EEA"
msgid "Oui, merci. Une grosse partie de mon fardeau à été allégée."
msgstr "Iya, makasih. Beban beratku sebagian besar udah berkurang."

#. Character:`yasuka`
msgctxt "JE_ME_SENT_BIEN_MOINS_OPPRESS_0C168F"
msgid "Je me sens bien moins oppressée."
msgstr "Aku ngerasa jauh lebih lega sekarang."

#. Character:`netoru`
msgctxt "VOUS_M_EN_VOYEZ_RAVIS_DANS_CE_35A41A"
msgid "Vous m'en voyez ravi dans ce cas."
msgstr "Aku seneng banget denger itu."

#. Character:`yasuka`
msgctxt "JE_VAIS_DE_CE_PAS_COMMENCER_MO_7A635F"
msgid "Je vais de ce pas commencer mon service !"
msgstr "Aku bakal langsung mulai kerja nih!"

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "NE_TE_PR_CIPITE_PAS_NETORU_N_P_D7AD2F"
msgid "Ne te précipite pas {{netoru.n}}... Petit à petit... Gagne sa confiance..."
msgstr "Jangan buru-buru {{netoru.n}}... Pelan-pelan... Dapetin kepercayaannya..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "ATTENDS_8A0D96"
msgid "Attends !"
msgstr "Tunggu!"

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "SAITO_N_MON_CH_RI_QU_EST_CE_Q_203F24"
msgid "{{saito.n}} ? Mon chéri, qu'est-ce que tu fais là ? Il y a un problème ?"
msgstr "{{saito.n}}? Sayang, kamu ngapain di sini? Ada masalah?"

#. Character:`saito` | Attributes:`sad`
msgctxt "J_AVAIS_BESOIN_DE_TE_PARLER_AV_774F45"
msgid "J'avais besoin de te parler avant que tu n'ailles travailler."
msgstr "Aku perlu ngomong sama kamu sebelum kamu pergi kerja."

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "OH_PARDON_JE_SUIS_PARTIE_EN_AV_5D812E"
msgid "Oh pardon, je suis partie en avance ce matin sans même te dire au revoir."
msgstr "Oh maaf, aku pergi dulu pagi ini tanpa sempat bilang dadah ke kamu."

#. Character:`yasuka` | Attributes:`happy`
msgctxt "QU_EST_CE_QUE_TU_VOULAIS_ME_DI_4AA97C"
msgid "Qu'est-ce que tu voulais me dire ?"
msgstr "Mau ngomong apa sih sama aku?"

#. Character:`saito` | Attributes:`upset`
msgctxt "JE_VOULAIS_SIMPLEMENT_TE_DIRE_B264BE"
msgid "Je voulais simplement... te dire de faire attention à toi."
msgstr "Aku cuma... mau bilang supaya kamu jaga diri."

#. Character:`saito`
msgctxt "IL_N_Y_A_PAS_SI_LONGTEMPS_TU_D_81E82D"
msgid "Il n'y a pas si longtemps tu détestais ton travail et ton patron."
msgstr "Belum lama ini kamu benci banget sama kerjaan dan bos kamu."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "C_EST_VRAI_349545"
msgid "C'est vrai..."
msgstr "Iya sih..."

#. Character:`saito`
msgctxt "SON_ATTITUDE_ENVERS_TOI_SEMBLE_5A5B0C"
msgid "Son attitude envers toi semble avoir changé du jour au lendemain et..."
msgstr "Sikap dia ke kamu kayaknya berubah tiba-tiba dan..."

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "O_VEUX_TU_EN_VENIR_EXACTEMENT_2CE5C7"
msgid "Où veux-tu en venir exactement ?"
msgstr "Mau ngapain sih sebenernya?"

#. Character:`saito` | Attributes:`upset`
msgctxt "JE_JE_PENSE_QU_IL_A_QUELQUE_CH_FF18B0"
msgid "Je... je pense qu'il a quelque chose derrière la tête..."
msgstr "Aku... aku pikir dia ada maksud tersembunyi..."

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "COMMENT_A_JE_NE_COMPRENDS_PAS_87457C"
msgid "Comment ça ? Je ne comprends pas."
msgstr "Maksudnya gimana? Aku nggak ngerti."

#. Character:`saito`
msgctxt "W_TU_ES_UNE_FEMME_MAGNIFIQUE_D43A17"
msgid "...[w] Tu es une femme magnifique et je pense que ses intentions ne sont pas aussi nobles qu'il le prétend."
msgstr "...[w] Kamu wanita cantik dan aku rasa niat dia nggak sebaik yang dia bilang."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "OH_MON_CH_RI_C_EST_VRAI_TU_ME_140579"
msgid "Oh mon chéri... C'est vrai ? Tu me trouves magnifique ?"
msgstr "Oh sayangku... beneran? Kamu pikir aku keren banget ya?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "EUH_OUI_MAIS_C_EST_SURTOUT_QUE_0E9150"
msgid "Euh.. Oui... Mais c'est surtout que..."
msgstr "Uh.. Iya... Tapi sebenernya..."

#. Character:`yasuka`
msgctxt "MERCI_DE_VEILLER_SUR_MOI_2C15FF"
msgid "Merci de veiller sur moi !"
msgstr "Makasih udah jaga aku!"

#. Character:`netoru`
msgctxt "IL_Y_A_UN_PROBL_ME_A537FB"
msgid "Il y a un problème ?"
msgstr "Ada masalah apa?"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "PAS_DU_TOUT_MON_CHER_SAITO_N_M_DBB3ED"
msgid "Pas du tout, mon cher {{saito.n}} m'accompagnait au travail."
msgstr "Enggak sama sekali, sayangku {{saito.n}} nemenin aku ke kerja."

#. Character:`yasuka`
msgctxt "PASSE_UNE_BONNE_JOURN_E_MON_CH_FD3F31"
msgid "Passe une bonne journée mon chéri."
msgstr "Semoga hari kamu menyenangkan, sayang."

#. Character:`saito` | Attributes:`neutral`
msgctxt "TOI_AUSSI_9E1902"
msgid "Toi aussi..."
msgstr "Kamu juga..."

#. Character:`netoru`
msgctxt "JE_PEUX_SAVOIR_POURQUOI_TU_RES_11F997"
msgid "Je peux savoir pourquoi tu restes encore planté là ?"
msgstr "Boleh tau kenapa kamu masih diem aja di situ?"

#. Character:`saito`
msgctxt "J_AI_LE_DROIT_JE_SUIS_INQUIET_AC09CF"
msgid "J'ai le droit, je suis inquiet donc je veille sur elle."
msgstr "Aku punya hak, aku khawatir jadi aku jagain dia."

#. Character:`netoru` | Attributes:`bad`
msgctxt "TU_N_AS_PAS_TE_PR_OCCUPER_DE_A_656EE6"
msgid "Tu n'as pas à te préoccuper de ça, je vais prendre soin d'elle à présent."
msgstr "Kamu gak usah repot-repot mikirin itu, aku bakal jaga dia sekarang."

#. Character:`saito` | Attributes:`surprised`
msgctxt "MAIS_4EEE0F"
msgid "Mais !"
msgstr "Tapi!"

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "NE_VA_PAS_LUI_METTRE_DES_ID_ES_4F916F"
msgid "Ne va pas lui mettre des idées saugrenues dans la tête ou lui faire croire qu'avec un peu de bonne volonté tout finira par s'arranger."
msgstr "Jangan masukin ide-ide aneh ke kepala dia atau bikin dia mikir kalau dengan niat baik semuanya bakal beres."

#. Character:`netoru`
msgctxt "NOUS_NE_VIVONS_PAS_DANS_UN_MON_C8F26E"
msgid "Nous ne vivons pas dans un monde de bisounours !"
msgstr "Kita gak hidup di dunia dongeng, bro!"

#. Character:`netoru` | Attributes:`neutral`
msgctxt "DE_PLUS_JE_PENSE_QU_ELLE_A_D_J_119E49"
msgid "De plus, je pense qu'elle a déjà bien assez à penser à comment rembourser sa dette et avoir quelqu'un comme toi qui lui traîne constamment autour ne va pas l'aider."
msgstr "Selain itu, aku rasa dia udah cukup pusing mikirin gimana cara bayar hutang, dan punya orang kayak kamu yang terus-terusan ngikutin dia nggak bakal ngebantu."

#. Character:`netoru` | Attributes:`frustrated`
msgctxt "TON_GE_J_TAIS_D_J_IND_PENDANT_9AA367"
msgid "À ton âge, j'étais déjà indépendant et j'avais mon propre appart ! Pendant combien de temps vas-tu encore être un poids pour elle ?"
msgstr "Waktu aku seusia kamu, aku udah mandiri dan punya apartemen sendiri! Sampai kapan sih kamu mau terus jadi beban buat dia?"

#. Character:`saito` | Attributes:`upset`
msgctxt "AUSSI_LONGTEMPS_QUE_N_CESSAIRE_07C0FB"
msgid "Aussi longtemps que nécessaire pour la protéger des gens qui pourraient avoir des intentions mal placées."
msgstr "Selama perlu buat ngejaga dia dari orang-orang yang punya niat jelek."

#. Character:`netoru` | Attributes:`angry`
msgctxt "C_EST_CE_QU_ON_VERRA_A43AE3"
msgid "C'est ce qu'on verra..."
msgstr "Kita liat aja nanti..."

#. Character:`narrator` | Attributes:`sad`
msgctxt "ELLE_N_A_PAS_L_AIR_D_TRE_L_ET_8E86D6"
msgid "Elle n'a pas l'air d'être là, et je ne l'ai pas croisée sur le chemin du retour."
msgstr "Dia kayaknya nggak ada di sini, dan aku nggak ketemu dia pas pulang tadi."

#. Character:`narrator`
msgctxt "PEUT_TRE_QUE_JE_L_AI_VRAIMENT_4D60D0"
msgid "Peut être que je l'ai vraiment ratée ?"
msgstr "Mungkin aku beneran kelewatan ya?"

#. Character:`narrator` | Attributes:`upset`
msgctxt "BON_JE_FAIS_QUOI_PR_SENT_C82DCB"
msgid "Bon je fais quoi à présent ?"
msgstr "Oke, sekarang aku ngapain nih?"

#. Character:`narrator`
msgctxt "JE_DEVRAIS_PEUT_TRE_PASSER_UN_DB7539"
msgid "Je devrais peut être passer un peu de temps avec {{asami.n}} ?"
msgstr "Mungkin aku harus ngabisin waktu sama {{asami.n}}?"

#. Character:`narrator`
msgctxt "CONTINUER_CHERCHER_7BBAAA"
msgid "Continuer à chercher."
msgstr "Terus nyari."

#. Character:`narrator`
msgctxt "PASSER_DU_TEMPS_AVEC_ASAMI_N_6E3BC0"
msgid "Passer du temps avec {{asami.n}}"
msgstr "Ngabisin waktu sama {{asami.n}}"

#. Character:`yasuka` | Attributes:`depressed`
msgctxt "OHLALA_MON_DIEU_QU_EST_CE_QUE_B889AB"
msgid "Ohlala ! Mon dieu qu'est-ce que j'ai fait ?!"
msgstr "Ohlala! Ya ampun, aku udah ngapain sih?!"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "VOUS_AVEZ_SIMPLEMENT_PRIS_LA_B_754A95"
msgid "Vous avez simplement pris la bonne décision."
msgstr "Kamu cuma ambil keputusan yang bener aja."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "PEUT_TRE_MAIS_PR_SENT_JE_N_AI_A3B336"
msgid "Peut-être... mais à présent je n'ai plus de travail... Et je suis certaine qu'il fera tout ce qu'il peut pour ternir ma réputation afin que je ne sois plus embauchée nulle part."
msgstr "Mungkin... tapi sekarang aku gak punya kerjaan lagi... Dan aku yakin dia bakal ngelakuin apa aja buat ngerusak reputasi aku biar gak ada yang mau nerima aku kerja."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "J_AI_PEUT_TRE_UNE_SOLUTION_VOU_BEE4D7"
msgid "J'ai peut-être une solution à vous proposer..."
msgstr "Mungkin aku punya solusi buat kamu..."

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "TOI_VRAIMENT_453E1C"
msgid "Toi ? Vraiment ?"
msgstr "Lo? Seriusan?"

#. Character:`sakuya`
msgctxt "BIEN_S_R_NE_POSEZ_PAS_DE_QUEST_0C3F66"
msgid "Bien sûr. Ne posez pas de questions et suivez-moi."
msgstr "Tentu aja. Jangan banyak tanya, ikutin aku aja."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "DE_TOUTE_FA_ON_JE_N_AI_PLUS_GR_66333C"
msgid "De toute façon, je n'ai plus grand-chose à perdre !"
msgstr "Ya udah, aku juga udah gak punya banyak yang bisa dipertaruhkan!"

#. Character:`saito`
msgctxt "INSTALLONS_QUELQUES_AFFICHES_I_2C6F6D"
msgid "Installons quelques affiches ici."
msgstr "Pasang beberapa poster di sini."

#. Character:`saito`
msgctxt "BON_A_DEVRAIT_SUFFIRE_POUR_ICI_DEBD5B"
msgid "Bon, ça devrait suffire pour ici, allons voir du côté du konbini."
msgstr "Oke, seharusnya cukup di sini, ayo kita cek di konbini."

#. Character:`sakuya`
msgctxt "onsen_exterior_038c169c"
msgid "Nous y sommes !"
msgstr "Kita udah sampai!"

#. Character:`sakuya`
msgctxt "onsen_exterior_a506492f"
msgid "Alors ? Plutôt charmant comme endroit, non ?"
msgstr "Nah? Tempatnya lumayan keren, kan?"

#. Character:`saito` | Attributes:`happy`
msgctxt "onsen_exterior_469fb1c1"
msgid "Je... Oui, je ne connaissais pas du tout cet endroit."
msgstr "Aku... Iya, aku sama sekali gak tau tempat ini."

#. Character:`sakuya`
msgctxt "onsen_exterior_99876f18"
msgid "Il s'agit d'un hôtel traditionnel, géré par ma famille du côté maternel depuis des centaines d'années."
msgstr "Ini hotel tradisional, yang sudah dikelola keluarga aku dari pihak ibu selama ratusan tahun."

#. Character:`saito`
msgctxt "UNE_SECONDE_C_EST_PAS_ICI_QUE_A502D5"
msgid "Une seconde, c'est pas ici que {{yasuka.n}} a trouvé du travail ?"
msgstr "Tunggu, bukannya di sini {{yasuka.n}} dapet kerjaan ya?"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "C_EST_EXACT_C_EST_MOI_QUI_LUI_D70C3E"
msgid "C'est exact, c'est moi qui lui ai donné. Tu t'inquiétais tellement pour elle que ça me brisait le cœur de te voir comme ça..."
msgstr "Iya, aku yang ngasih dia kerjaan itu. Kamu khawatir banget sama dia sampai aku sedih lihat kamu kayak gitu..."

#. Character:`sakuya`
msgctxt "ET_PUIS_QUI_SAIT_CE_QUI_AURAIT_CB39BD"
msgid "Et puis qui sait ce qui aurait pu lui arriver si elle était restée avec ce gros porc ?"
msgstr "Terus siapa tau apa yang bakal terjadi sama dia kalau dia masih sama babi gendut itu?"

#. Character:`saito` | Attributes:`sad`
msgctxt "MERCI_C28E73"
msgid "Merci..."
msgstr "Makasih..."

#. Character:`sakuya`
msgctxt "DE_RIEN_MON_AMOUR_TU_SAIS_QUE_9D0049"
msgid "De rien mon amour, tu sais que je ferais tout pour toi..."
msgstr "Sama-sama sayang, kamu tau aku bakal ngelakuin apa aja buat kamu..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "A_VOUS_APPARTIENT_DEPUIS_AUSS_07CA8F"
msgid "Ça vous appartient depuis aussi longtemps ?"
msgstr "Ini milik kalian dari dulu banget ya?"

#. Character:`sakuya`
msgctxt "onsen_exterior_e639cd57"
msgid "Oui ![w] Ce qui fait le charme de cet endroit, c'est surtout sa source chaude exclusive..."
msgstr "Iya![w] Yang bikin tempat ini istimewa itu terutama sumber air panas eksklusifnya..."

#. Character:`sakuya`
msgctxt "onsen_exterior_12735cd9"
msgid "Mais, ce n'est que l'un des nombreux atouts de cet établissement."
msgstr "Tapi itu cuma salah satu dari banyak keunggulan tempat ini."

#. Character:`saito`
msgctxt "onsen_exterior_f798c96a"
msgid "Mais... Ça doit coûter une fortune ?"
msgstr "Tapi... Pasti mahal banget ya?"

#. Character:`sakuya`
msgctxt "onsen_exterior_e9ae96b9"
msgid "C'est un établissement de luxe... Les clients sont peu nombreux, mais ils en ont pour leur argent."
msgstr "Ini tempat mewah... Pelanggannya gak banyak, tapi mereka dapet yang sepadan sama uangnya."

#. Character:`sakuya`
msgctxt "onsen_exterior_5ca9a838"
msgid "Ne t'en fais pas, rien ne sera trop beau ou trop cher pour toi."
msgstr "Santai aja, nggak bakal ada yang terlalu bagus atau terlalu mahal buat kamu."

#. Character:`saito` | Attributes:`neutral`
msgctxt "onsen_exterior_b4e69ca9"
msgid "..."
msgstr "..."

#. Character:`sakuya`
msgctxt "onsen_exterior_f0f48930"
msgid "Allez, ne restons pas là !"
msgstr "Ayo, jangan diem aja di sini!"

#. Character:`narrator`
msgctxt "onsen_exterior_5ec7adc5"
msgid "Fait chier, si elle était odieuse, au moins, ce serait plus facile de la détester."
msgstr "Sialan, kalo dia nyebelin sih, paling nggak bakal susah buat benci dia."

#. Character:`narrator`
msgctxt "onsen_exterior_b1eddcce"
msgid "De toute façon, je n'ai plus trop le choix maintenant."
msgstr "Pokoknya, aku udah nggak punya banyak pilihan sekarang."

#. Character:`narrator`
msgctxt "onsen_exterior_9ca58259"
msgid "Autant entrer maintenant que je suis là..."
msgstr "Mending masuk aja sekalian sekarang aku udah di sini..."

#. Character:`narrator`
msgctxt "onsen_exterior_a3432d40"
msgid "Ce sera ma première fois dans un onsen."
msgstr "Ini bakal jadi pertama kalinya aku ke onsen."

#. Character:`sakuya`
msgctxt "onsen_exterior_36b0598e"
msgid "[font_size=14]Mon chéri, tu me rejoins ?[/font_size]"
msgstr "[font_size=14]Sayang, kamu ikut nggak?[/font_size]"

#. Character:`saito` | Attributes:`surprised`
msgctxt "onsen_exterior_e01970b4"
msgid "Je... j'arrive !"
msgstr "Aku... aku datang!"

#. Character:`notice`
msgctxt "onsen_exterior_10fa3611"
msgid "{{sakuya.n}} a restreint votre liberté, vous n'êtes désormais plus libre de vous déplacer comme vous le souhaitez."
msgstr "{{sakuya.n}} udah ngebatesin kebebasanmu, sekarang kamu nggak bebas lagi kemana-mana seenaknya."

#. Character:`narrator`
msgctxt "onsen_exterior_265879a3"
msgid "Je ne peux pas partir maintenant, {{sakuya.n}} pourrait s'en prendre à {{asami.n}} ou {{yasuka.n}}."
msgstr "Aku nggak bisa pergi sekarang, {{sakuya.n}} bisa nyerang {{asami.n}} atau {{yasuka.n}}."

#. Character:`saito` | Attributes:`happy`
msgctxt "t61eb8a0595"
msgid "Nous y voilà !"
msgstr "Akhirnya sampai juga!"

#. Character:`sayuri` | Attributes:`surprised`
msgctxt "td0cb35c9b7"
msgid "Oh mon dieu !"
msgstr "Ya ampun!"

#. Character:`sayuri`
msgctxt "tdcd07457b8"
msgid "Est ce que tu sais combien de fois j'ai rêvée de venir ici ?"
msgstr "Kamu tahu nggak berapa kali aku mimpi pengen dateng ke sini?"

#. Character:`sayuri` | Attributes:`moved`
msgctxt "t4c38962c69"
msgid "Cet endroit est juste incroyable !"
msgstr "Tempat ini bener-bener keren banget!"

#. Character:`sayuri` | Attributes:`neutral`
msgctxt "t412e042e65"
msgid "Rassure moi, tu connais la particularité de cet endroit ?"
msgstr "Yakinin aku ya, kamu tau nggak keunikan tempat ini?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "tfafd214628"
msgid "La particularité ?"
msgstr "Keunikan?"

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "tc3c28958ec"
msgid "Je le savais... Tu n'étais pas au courant !"
msgstr "Tebakanku benar... Kamu nggak tau ya!"

#. Character:`saito` | Attributes:`happy`
msgctxt "td1ab8bc015"
msgid "Je t'en prie, éclaire moi."
msgstr "Ayo dong, jelasin ke aku."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "ta9c07643b5"
msgid "Ce lieu existe depuis plusieurs centaine d'années et plus que la beauté de l'endroit c'est la seule règle de l'établissement qui a fait sa renommée."
msgstr "Tempat ini udah ada ratusan tahun, dan lebih dari kecantikan tempatnya, cuma aturan satu-satunya di sini yang bikin tempat ini terkenal."

#. Character:`saito` | Attributes:`neutral`
msgctxt "ta8bd1e9543"
msgid "La seule règle ?"
msgstr "Aturan satu-satunya?"

#. Character:`sayuri`
msgctxt "te12a61a9a9"
msgid "C'est eux qui choisissent leurs clients."
msgstr "Mereka yang milih sendiri pelanggan mereka."

#. Character:`saito` | Attributes:`surprised`
msgctxt "t15a75ea0cb"
msgid "Je ne savais pas qu'une telle règle était possible !"
msgstr "Aku nggak nyangka ada aturan kayak gitu!"

#. Character:`saito`
msgctxt "ta175b28d06"
msgid "C'est plutôt incroyable !"
msgstr "Ini bener-bener nggak nyangka!"

#. Character:`sayuri` | Attributes:`happy`
msgctxt "t90b5422e3d"
msgid "En effet !"
msgstr "Iya nih!"

#. Character:`sayuri`
msgctxt "t8dbbf63d49"
msgid "Et malgré elle, l'endroit est toujours là après tant d'années..."
msgstr "Dan meskipun begitu, tempat ini masih ada setelah bertahun-tahun..."

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t15dfd7a578"
msgid "Bref oublions... Tu ne pouvais pas savoir, allons ailleurs."
msgstr "Pokoknya lupain aja... Kamu kan nggak bisa tahu, yuk kita pergi ke tempat lain."

#. Character:`saito` | Attributes:`happy`
msgctxt "t755ae7ddd3"
msgid "Mais non voyons qu'est ce que tu racontes ?"
msgstr "Ah masa sih, kamu ngomong apa sih?"

#. Character:`saito`
msgctxt "t881f30547b"
msgid "Allons y on nous attend !"
msgstr "Ayo cepetan, kita udah ditunggu!"

#. Character:`sayuri` | Attributes:`surprised`
msgctxt "t765ac56881"
msgid "Quoi ?! Mais... Comment tu... ?"
msgstr "Apa?! Tapi... Gimana kamu bisa...?"

#. Character:`saito` | Attributes:`happy`
msgctxt "t4ab8230900"
msgid "C'est bon, désolé pour l'attente."
msgstr "Santai aja, maaf ya udah bikin nunggu."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "t589ff67982"
msgid "Pas de problème, prends le temps qu'il faudra."
msgstr "Gak masalah, santai aja seberapa lama pun butuhnya."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "tbb4a72f061"
msgid "En espérant que vous avez passé un agréable moment dans notre établissement !"
msgstr "Semoga kalian senang dan nyaman selama di tempat kami!"

#. Character:`sayuri`
msgctxt "t9631ede783"
msgid "Oui c'était absolument merveilleux !"
msgstr "Iya, itu bener-bener luar biasa!"

#. Character:`sayuri` | Attributes:`blush`
msgctxt "t5a95776e51"
msgid "N'est-ce pas {{saito.n}} ?"
msgstr "Kan gitu, {{saito.n}}?"

#. Character:`saito`
msgctxt "t254114eb2f"
msgid "Oui, tout était parfait !"
msgstr "Iya, semuanya sempurna!"

#. Character:`saito`
msgctxt "t4938e89bb6"
msgid "Merci encore pour tout {{sakuya.n}}."
msgstr "Makasih lagi buat semuanya, {{sakuya.n}}."

#. Character:`sakuya`
msgctxt "tf767ccecad"
msgid "Je t'en prie, ça m'a fait plaisir !"
msgstr "Sama-sama, aku seneng banget!"

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "t76b428068f"
msgid "N'oublie pas !"
msgstr "Jangan lupa ya!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t1bfc6ac1cb"
msgid "Je n'oublierai pas !"
msgstr "Aku nggak akan lupa!"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "t0130999514"
msgid "Dans ce cas, je vous souhaite une très bonne fin de soirée."
msgstr "Kalau gitu, aku doain kalian nikmatin sisa malam ini."

#. Character:`sakuya`
msgctxt "t3d89969590"
msgid "Au plaisir de vous revoir."
msgstr "Sampai ketemu lagi ya."

#. Character:`sayuri` | Attributes:`neutral`
msgctxt "tca2a11dbcf"
msgid "Un problème ? Qu'est-ce que tu ne dois pas oublier ?"
msgstr "Ada masalah? Apa sih yang nggak boleh kamu lupain?"

#. Character:`saito` | Attributes:`happy`
msgctxt "tde82f308ee"
msgid "Rien de grave, disons que pour avoir privatisé le onsen rien que pour nous, j'aurai un petit service à rendre en échange."
msgstr "Gak apa-apa, bilang aja karena kita ngeprivat onsen cuma buat kita, aku punya sedikit permintaan sebagai gantinya."

#. Character:`sayuri`
msgctxt "tf5cdc9405b"
msgid "Oh! Rien de compliqué j'espère ?"
msgstr "Oh! Semoga nggak ribet ya?"

#. Character:`saito`
msgctxt "td23f0f55c0"
msgid "Rien qui ne soit hors de ma portée, ne t'en fais pas.."
msgstr "Nggak ada yang di luar kemampuan aku, santai aja.."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "td2b43cb8db"
msgid "Très bien, mais si tu as besoin d'aide, n'hésite pas !"
msgstr "Oke banget, tapi kalau butuh bantuan, jangan sungkan ya!"

#. Character:`saito` | Attributes:`neutral`
msgctxt "tf2b2edf135"
msgid "Allez, je te raccompagne."
msgstr "Ayo, aku antar kamu pulang."

#. Character:`kimochi`
msgctxt "t01fea45291"
msgid "Je la vois ! Elle est à l'[color=yellow]arrêt de bus[/color] ! Allons-y."
msgstr "Aku liat dia! Dia di [color=yellow]halte bus[/color] itu! Ayo pergi."

#. Character:`takeo` | Attributes:`angry`
msgctxt "t68eac6f78e"
msgid "Bordel si je retrouve ce petit batard."
msgstr "Bajingan, kalau aku ketemu bocah sialan itu."

#. Character:`kenji`
msgctxt "te6372d0b38"
msgid "T'es vraiment trop con ma parole, tu penses que c'est à cause de quoi d'après toi qu'on a passé la nuit dans les chiottes ?"
msgstr "Kamu emang bodoh parah, aku tanya, menurut kamu kenapa kita nginep semalem di kamar mandi?"

#. Character:`kenji` | Attributes:`disgusted`
msgctxt "t2394f26950"
msgid "Il a du mettre un truc dans sa bouffe."
msgstr "Pasti dia naro sesuatu di makanannya."

#. Character:`nobu`
msgctxt "tc5fa373113"
msgid "Mais... Ca n'a pas de sens ! Pourquoi il s'infligerait ça ?"
msgstr "Tapi... Gak masuk akal nih! Kenapa dia mau ngerasain kayak gitu?"

#. Character:`takeo` | Attributes:`disgusted`
msgctxt "t536e83eb81"
msgid "Parce que ce petit con savait qu'on s'en prendrait a lui..."
msgstr "Soalnya si brengsek itu tau bakal kita serang dia..."

#. Character:`nobu`
msgctxt "t198a81323d"
msgid "...merde t'as raison."
msgstr "...sialan kamu bener juga."

#. Character:`narrator`
msgctxt "t9b79666808"
msgid "Mais pour qu'ils y passent la nuit... qu'elle dose il a bien pu mettre la dedans ?"
msgstr "Tapi buat bikin mereka nginep semaleman... dosisnya seberapa sih yang dia masukin ke situ?"

#. Character:`narrator`
msgctxt "t7f0057eca0"
msgid "Pour en avoir mis autant, ça devait forcement se sentir."
msgstr "Udah pasti berasa banget tuh kalo dia masukin sebanyak itu."

#. Character:`narrator`
msgctxt "t8f2727f93d"
msgid "Du coup je ne sais pas qui le plus fou dans l'histoire."
msgstr "Jadi aku gak tau siapa yang paling gila di cerita ini."

#. Character:`narrator`
msgctxt "t13964821b6"
msgid "{{kimochi.n}} qui vide un flacon de laxatif et ou les trois idiots qui ont tout mangé sans se rendre compte de rien ?"
msgstr "{{kimochi.n}} yang ngabisin botol pencahar atau tiga idiot itu yang makan semua tanpa sadar apa-apa?"

#. Character:`narrator`
msgctxt "t18ddf7fb6e"
msgid "Oula ! Ennuie a l'horizon."
msgstr "Waduh! Bakal ribet nih."

#. Character:`macumba` | Attributes:`happy`
msgctxt "td5473573ce"
msgid "Un problème les mecs ?"
msgstr "Ada masalah apa, guys?"

#. Character:`nobu` | Attributes:`angry`
msgctxt "t6b7a8d4765"
msgid "Fous nous la paix, on vient de passer la nuit a se vider a cause d'un connard qui nous a fait bouffer un laxatif."
msgstr "Usapin aja, kita baru aja ngabisin malam buat ngeberesin abis gara-gara bajingan yang bikin kita makan pencahar."

#. Character:`takeo` | Attributes:`angry`
msgctxt "t86284f7bce"
msgid "Mais putain ta gueule {{nobu.n}} pourquoi tu racontes ça au premier venu ?!"
msgstr "Tutup mulut kamu {{nobu.n}} kenapa kamu cerita gitu ke orang sembarangan?!"

#. Character:`macumba` | Attributes:`neutral`
msgctxt "t17bcbbb8a1"
msgid "Dans ce cas il faut boire, votre corps est surement déshydrater."
msgstr "Kalau gitu harus minum, tubuh kalian pasti dehidrasi."

#. Character:`kenji` | Attributes:`angry`
msgctxt "t0789d1cbf6"
msgid "Va te faire foutre, j'ai l'impression d'entendre ma mère ! Et puis c'est quoi ça d'abord ?!"
msgstr "Cabul kamu, aku kayak dengerin emak aku! Terus apaan sih itu?!"

#. Character:`macumba`
msgctxt "tfafe51731f"
msgid "Ca ?! C'est ce qui me maintient en vie chaque jour mon frère, la musique !"
msgstr "Itu?! Itulah yang membuatku tetap hidup setiap hari, saudaraku, musik!"

#. Character:`nobu` | Attributes:`bad`
msgctxt "t4c4101346c"
msgid "Ah ouai ? Je peux écouter un peu ?"
msgstr "Oh iya? Aku boleh denger dikit nggak?"

#. Character:`macumba`
msgctxt "t5a1d135363"
msgid "Pas de problème, je vais m'étirer un peu plus loin, rend le moi quand tu auras fini mais fais y attention."
msgstr "Nggak masalah, aku mau ngulur badan dikit ke sana, balikin pas kamu udah selesai tapi hati-hati ya."

#. Character:`nobu`
msgctxt "t05186a7934"
msgid "Ouai ouai t'inquiète pas !"
msgstr "Iya iya, santai aja!"

#. Character:`kenji` | Attributes:`bad`
msgctxt "t94601341ef"
msgid "Mais quel maladroit franchement..."
msgstr "Dasar ceroboh banget sih..."

#. Character:`takeo` | Attributes:`bad`
msgctxt "te82e917de8"
msgid "Oui, si tu avais vraiment voulu le casser il fallait y aller comme ça !"
msgstr "Iya, kalo emang mau beneran dihancurin ya harus gitu caranya!"

#. Character:`takeo`
msgctxt "t6326ba34f3"
msgid "Ah je me sent mieux ! Allez on se casse !"
msgstr "Ah, aku ngerasa lebih baik! Ayo kita cabut!"

#. Character:`saito` | Attributes:`sad`
msgctxt "tc3c21ae8e1"
msgid "Je ne sais pas comment ce type va réagir mais je suppose que ça ne va pas lui plaire."
msgstr "Aku gak tau sih gimana reaksinya, tapi kayaknya dia gak bakal seneng."

#. Character:`narrator`
msgctxt "tde20706126"
msgid "Son propriétaire n'est pas très loin..."
msgstr "Pemiliknya gak jauh dari sini..."

#. Character:`macumba` | Attributes:`upset`
msgctxt "talk_macumba_7e0d13c5"
msgid "Hey, petit frère, c'est dimanche aujourd'hui, le repos fait partie de l'entrainement."
msgstr "Hei, adik kecil, hari ini Minggu, istirahat juga bagian dari latihan."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_macumba_ff385e1b"
msgid "Mince, j'avais oublié, désolé."
msgstr "Sial, aku lupa, maaf ya."

#. Character:`macumba` | Attributes:`happy`
msgctxt "talk_macumba_1ed97f9f"
msgid "Aucun problème, on se retrouve dès demain matin."
msgstr "Gak masalah, kita ketemu besok pagi."

#. Character:`macumba`
msgctxt "menu_macumba_c3d2b7e1_1"
msgid "Hey petit frère !"
msgstr "Hei adik kecil!"

#. Character:`macumba` | Attributes:`-happy`
msgctxt "menu_macumba_662b5327"
msgid "Ça me fait plaisir que tu sois aussi motivé, mais il faut aussi se reposer."
msgstr "Senang banget liat kamu semangat, tapi istirahat juga penting."

#. Character:`macumba` | Attributes:`happy`
msgctxt "menu_macumba_d2c8ad9a"
msgid "On se voit demain pour l'entraînement !"
msgstr "Kita ketemu besok buat latihan!"

#. Character:`macumba` | Attributes:`happy`
msgctxt "menu_macumba_32b94129"
msgid "On se voit lundi pour l'entraînement !"
msgstr "Kita ketemu Senin buat latihan!"

#. Character:`macumba`
msgctxt "tf25c93d613"
msgid "[next]"
msgstr "[next]"

#. Character:`narrator`
msgctxt "talk_macumba_b173ff68"
msgid "Mieux vaut éviter les ennuis et ne pas se frotter à cette espèce de golgoth."
