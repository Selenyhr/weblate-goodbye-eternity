msgid "Essayons plutot autre chose."
msgstr "Mending coba yang lain deh."

#. Character:`saito`
msgctxt "tb3e5e86b0a"
msgid "Comme quoi ?"
msgstr "Kayak apa?"

#. Character:`noriko`
msgctxt "t0b8532af7d"
msgid "Tu vois très bien ce que je veux dire."
msgstr "Kamu tau banget maksud aku."

#. Character:`saito`
msgctxt "t5f15d98685"
msgid "Non je... OH ! Ah oui très bien."
msgstr "Enggak aku... OH! Iya, oke deh."

#. Character:`noriko`
msgctxt "tdda4c30113"
msgid "Vas'y doucement par contre."
msgstr "Pelan-pelan aja ya."

#. Character:`noriko`
msgctxt "tb2bd24a2b5"
msgid "J'ai jamais..."
msgstr "Aku belum pernah..."

#. Character:`saito`
msgctxt "tb1ab1807d7"
