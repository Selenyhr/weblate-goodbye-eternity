msgctxt "J_AI_M_ME_REFAIT_MA_GARDE_ROBE_854759"
msgid "J’ai même refait ma garde-robe pour cet objectif !"
msgstr "Aku bahkan ganti lemari pakaian demi tujuan itu!"

