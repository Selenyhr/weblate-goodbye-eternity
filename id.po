msgstr "Kamu terlalu meremehin daya tarik seks cewek yang udah nikah, kasian deh kamu {{saito.n}}"

#. Character:`saito`
msgctxt "t34550aa936"
msgid "...[w]N'importe quoi..."
msgstr "...[w]Omong kosong banget..."

#. Character:`noriko`
msgctxt "te66c6edf85"
msgid "[font_size=14]Et rappelle toi...[/font_size]"
msgstr "[font_size=14]Inget ya...[/font_size]"

#. Character:`noriko`
msgctxt "tb1ec01f44d"
msgid "[font_size=14]On ne touche pas pas à la mère de sa meilleure amie[/font_size]"
msgstr "[font_size=14]Jangan sentuh ibu sahabat terbaik lo[/font_size]"

#. Character:`noriko`
msgctxt "t4b748d8a3a"
msgid "[font_size=14]On ne touche pas pas à la mère de sa petite amie[/font_size]"
msgstr "[font_size=14]Jangan sentuh ibu pacar lo[/font_size]"

#. Character:`saito` | Attributes:`sad`
msgctxt "tc4bea41113"
msgid "Je t'ai déjà dis qu'il ne se passerait rien !"
msgstr "Aku udah bilang, gak bakal ada apa-apa!"

#. Character:`noriko`
msgctxt "te8244f15f1"
msgid "[font_size=14]C'est ce qu'ils disent tous...[/font_size]"
msgstr "[font_size=14]Itu yang mereka semua bilang...[/font_size]"

#. Character:`noriko`
msgctxt "tcaa1b16bb4"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "teb79a71097"
msgid "Oh merde !"
msgstr "Sialan!"

#. Character:`saito` | Attributes:`upset`
msgctxt "t583d7b4288"
msgid "Tu m'as fait peur, je ne m'attendais pas à te trouver là."
msgstr "Aku kaget, nggak nyangka nemu kamu di sini."

#. Character:`noriko`
msgctxt "t00543a8508"
msgid "Tu rentres tard, une fois de plus."
msgstr "Kamu pulang malam lagi nih."

#. Character:`saito` | Attributes:`happy`
msgctxt "te78d30b416"
msgid "Oui je sais..."
msgstr "Iya aku tau..."

#. Character:`saito`
msgctxt "t4beca839c3"
msgid "On devait passer la journée en ville et, au final, on est restés à la salle d'arcade."
msgstr "Kita harusnya seharian di kota, tapi ujung-ujungnya malah nongkrong di tempat arcade."

#. Character:`noriko` | Attributes:`cute`
msgctxt "t95d51d26b9"
msgid "Donc c'est terminé ?"
msgstr "Jadi udah selesai gitu?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "tad373f642e"
msgid "mhh pas exactement..."
msgstr "mhh nggak juga sih..."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "tda848956db"
msgid "Tu la vois toujours demain, c'est ça ?"
msgstr "Besok masih ketemu dia kan?"

#. Character:`saito`
msgctxt "t74d7ccd50e"
msgid "On va au parc d'attractions..."
msgstr "Kita mau ke taman hiburan..."

#. Character:`noriko` | Attributes:`afraid`
msgctxt "tb9f597cd22"
msgid "Celui pour les couples ?"
msgstr "Yang buat pasangan?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "t864211c504"
msgid "Comment ça pour les couples ?"
msgstr "Maksudnya gimana buat pasangan?"

#. Character:`noriko` | Attributes:`bad`
msgctxt "tb232dd88a5"
msgid "C'est à se demander si tu connais la ville dans laquelle tu habites."
msgstr "Bikin aku mikir, kamu beneran tau nggak kota tempat kamu tinggal."

#. Character:`noriko`
msgctxt "te7ab29873c"
msgid "Ce parc a une particularité, c'est qu'il ne laisse entrer que et uniquement les couples."
msgstr "Taman ini punya keunikan, cuma ngizinin pasangan doang buat masuk."

#. Character:`saito` | Attributes:`upset`
msgctxt "t6bf39b97ec"
msgid "Arrête de te moquer de moi !"
msgstr "Udah jangan ngejek aku dong!"

#. Character:`saito`
msgctxt "t291e1a5d24"
msgid "[font_size=14]Il ne se passera rien entre {{sayuri.n}} et moi ![/font_size]"
msgstr "[font_size=14]Nggak bakal ada apa-apa antara {{sayuri.n}} dan aku![/font_size]"

#. Character:`noriko` | Attributes:`shame`
msgctxt "ta6fcdcf6ca"
msgid "Bon sang ! Mais comment il peut être aussi naif ?!"
msgstr "Sialan! Kok bisa sebodoh itu sih?!"

#. Character:`noriko`
msgctxt "SALUT_BIEN_DORMI_AEBF96"
msgid "Salut... Bien dormi ?"
msgstr "Hai... Tidur nyenyak?"

#. Character:`saito`
msgctxt "PAS_VRAIMENT_ET_TOI_720EC2"
msgid "Pas vraiment... et toi ?"
msgstr "Gak banget... kamu gimana?"

#. Character:`noriko`
msgctxt "MOI_NON_PLUS_E81698"
msgid "Moi non plus."
msgstr "Aku juga gitu."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "T_TE_DE_BITE_A_D_TERMINER_LES_E9DC77"
msgid "Tête de bite a dû terminer les affiches."
msgstr "Bangsat itu pasti yang nempelinnya."

#. Character:`saito` | Attributes:`neutral`
msgctxt "S_REMENT_A4EB14"
msgid "Sûrement..."
msgstr "Pasti..."

#. Character:`noriko`
msgctxt "ON_Y_VA_ALORS_24F103"
msgid "On y va alors ?"
msgstr "Mau pergi sekarang?"

#. Character:`saito`
msgctxt "AVANT_J_AIMERAIS_PASSER_VOIR_M_599669"
msgid "Avant, j'aimerais passer voir {{macumba.n}} au parc. J'aimerais m'assurer que tout va bien."
msgstr "Tapi sebelumnya, aku pengen mampir ke taman buat lihat {{macumba.n}}. Aku pengen pastiin semuanya baik-baik aja."

#. Character:`noriko`
msgctxt "SI_TU_VEUX_MAIS_JE_VIENS_AVEC_A07EFE"
msgid "Si tu veux, mais je viens avec toi !"
msgstr "Kalau kamu mau, tapi aku ikut ya!"

#. Character:`noriko`
msgctxt "TU_COMPTES_ME_DIRE_LA_V_RIT_MO_204954"
msgid "Tu comptes me dire la vérité à moi ?"
msgstr "Kamu mau ngomong jujur sama aku?"

#. Character:`saito` | Attributes:`upset`
msgctxt "W_J_AI_T_VOIR_LES_3_IDIOTS_EN_E2D30A"
msgid "...[w] J'ai été voir les 3 idiots... en espérant qu'ils pourraient m'aider à trouver {{akira.n}}, mais... ils n'ont pas été très coopératifs."
msgstr "...[w] Aku udah dateng ke tiga idiot itu... harapannya mereka bisa bantu cari {{akira.n}}, tapi... mereka nggak banget buat kerjasama."

#. Character:`noriko`
msgctxt "CE_QUI_EXPLIQUE_LE_SANG_SUR_T_DD6AE9"
msgid "... Ce qui explique le sang sur tes poings."
msgstr "... Makanya ada darah di tinju kamu."

#. Character:`saito`
msgctxt "W_COMMENT_TU_FAISAIS_POUR_CON_DD446C"
msgid "...[w] Comment tu faisais pour contacter {{akira.n}} ?"
msgstr "...[w] Kamu biasanya gimana buat hubungin {{akira.n}}?"

#. Character:`noriko` | Attributes:`shame`
msgctxt "JE_NE_LE_FAISAIS_PAS_C_EST_TOU_578C8F"
msgid "Je ne le faisais pas... C'est toujours lui qui me contactait..."
msgstr "Aku nggak pernah yang hubungin... Dia yang selalu hubungin aku..."

#. Character:`saito`
msgctxt "DONC_IL_EST_NOTRE_SEULE_PISTE_8CF711"
msgid "Donc il est notre seule piste, et lui aussi a disparu ?"
msgstr "Jadi dia satu-satunya petunjuk kita, dan dia juga hilang?"

#. Character:`saito`
msgctxt "J_AI_BESOIN_DE_DORMIR_BONNE_NU_E1069B"
msgid "J'ai besoin de dormir, bonne nuit."
msgstr "Aku butuh tidur, selamat malam."

#. Character:`noriko`
msgctxt "BONNE_NUIT_473BEE"
msgid "... Bonne nuit..."
msgstr "... Selamat malam..."

#. Character:`saito`
msgctxt "FONT_SIZE_14_MERDE_FONT_SIZE_112EAF"
msgid "[font_size=14]MERDE ![/font_size]"
msgstr "[font_size=14]SIALAN![/font_size]"

#. Character:`yasuka`
msgctxt "TU_PENSES_QU_IL_A_TROUV_UN_END_C58FA3"
msgid "Tu penses qu'il a trouvé un endroit où dormir ?"
msgstr "Kamu pikir dia nemu tempat buat tidur?"

#. Character:`noriko`
msgctxt "JE_JE_NE_SAIS_PAS_645D8E"
msgid "Je... Je ne sais pas."
msgstr "Aku... Aku gak tahu."

#. Character:`noriko`
msgctxt "TOUS_LES_ENDROITS_O_IL_AURAIT_E46999"
msgid "Tous les endroits où il aurait pu se réfugier sont maintenant surveillés."
msgstr "Semua tempat yang mungkin dia jadiin tempat ngumpet sekarang diawasi semua."

#. Character:`noriko`
msgctxt "JE_NE_VOIS_PAS_COMMENT_IL_POUR_ED2945"
msgid "Je ne vois pas comment il pourrait se sortir de cette situation."
msgstr "Aku gak tau gimana dia bisa keluar dari situasi ini."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "EST_CE_QU_IL_AVAIT_UN_PEU_D_AR_B7D073"
msgid "Est-ce qu'il avait un peu d'argent avec lui ? De quoi manger ?"
msgstr "Dia bawa sedikit uang gak? Ada makanan gak?"

#. Character:`noriko`
msgctxt "MAMAN_J_AIMERAIS_POUVOIR_TE_R_2F2CCE"
msgid "Maman... J'aimerais pouvoir te répondre, mais je me pose les mêmes questions."
msgstr "Mama... Aku pengen bisa jawab, tapi aku juga nanya hal yang sama."

#. Character:`noriko`
msgctxt "IL_DEVRAIT_S_EN_SORTIR_J_ESP_R_692683"
msgid "Il devrait s'en sortir... J'espère."
msgstr "Dia harusnya bisa bertahan... Semoga aja."

#. Character:`saito`
msgctxt "home_natsume_exterior_7eab8102"
msgid "Attends, c'est le quartier abandonné..."
msgstr "Tunggu, ini daerah yang ditinggalin..."

#. Character:`saito`
msgctxt "home_natsume_exterior_ba442f46"
msgid "Tu veux dire que tu vis ici ?"
msgstr "Maksudmu, kamu tinggal di sini?"

#. Character:`natsume` | Attributes:`pouting`
msgctxt "home_natsume_exterior_600f60aa"
msgid "Ne pose pas de questions."
msgstr "Jangan tanya-tanya."

#. Character:`natsume`
msgctxt "home_natsume_exterior_7c517bb8"
msgid "Je ne devrais même pas t'aider."
msgstr "Sebenarnya aku nggak harus nolong kamu."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_natsume_exterior_b5044fd2"
msgid "Je m'abstiendrais de poser des questions, mais quand même..."
msgstr "Aku bakal tahan diri buat nggak nanya, tapi ya... gitu deh."

#. Character:`saito`
msgctxt "home_natsume_exterior_b557bbfb"
msgid "Je ne me serais pas imaginé une seconde que tu vivrais ici tout en sachant où vis {{minato.n}}."
msgstr "Nggak pernah kebayang sama sekali kalo kamu bakal tinggal di sini padahal tau dimana {{minato.n}} tinggal."

#. Character:`natsume` | Attributes:`sad`
msgctxt "home_natsume_exterior_5dcf2bf7"
msgid "Il y a beaucoup de choses que tu ignores, et c'est mieux comme ça."
msgstr "Banyak hal yang kamu nggak tau, dan emang mending gitu."

#. Character:`narrator`
msgctxt "home_natsume_exterior_43421862"
msgid "Cette fille est entourée de mystères."
msgstr "Gadis ini penuh misteri."

#. Character:`narrator`
msgctxt "home_natsume_exterior_0596f754"
msgid "J'espère qu'un jour, je pourrais enfin avoir le fin mot de cette histoire."
msgstr "Aku berharap suatu hari nanti, aku bisa dapet jawaban pasti dari semua ini."

#. Character:`natsume`
msgctxt "home_natsume_exterior_3d9494f6"
msgid "Voilà, c'est pour toi !"
msgstr "Ini dia, buat kamu!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_natsume_exterior_49dfb5fb"
msgid "Qu'est-ce que c'est ?"
msgstr "Ini apaan sih?"

#. Character:`natsume`
msgctxt "home_natsume_exterior_b8a1e465"
msgid "Un ancien costume de {{minato.n}} qu'il n'utilise plus."
msgstr "Kostum lama {{minato.n}} yang udah gak dia pake lagi."

#. Character:`saito`
msgctxt "home_natsume_exterior_354149d3"
msgid "Attend... Tu veux que je porte... son costume ?"
msgstr "Tunggu... Kamu mau aku pake... kostumnya dia?"

#. Character:`natsume` | Attributes:`pouting`
msgctxt "home_natsume_exterior_d114cc35"
msgid "Tu as besoins d'un costume oui ou non ?"
msgstr "Kamu butuh kostum, iya atau gak?"

#. Character:`saito`
msgctxt "home_natsume_exterior_640e1625"
msgid "Tu es certaine que je peux l'utiliser ?"
msgstr "Kamu yakin aku boleh make?"

#. Character:`natsume` | Attributes:`bad`
msgctxt "home_natsume_exterior_edb8f9a8"
msgid "La fin justifie les moyens."
msgstr "Tujuan menghalalkan cara."

#. Character:`natsume`
msgctxt "home_natsume_exterior_a63b13a7"
msgid "Utilise-le pour protéger les gens que tu aimes."
msgstr "Pake itu buat lindungin orang-orang yang kamu sayang."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_natsume_exterior_70edd1c0"
msgid "...Merci {{natsume.n}}."
msgstr "...Makasih, {{natsume.n}}."

#. Character:`saito`
msgctxt "home_natsume_exterior_dc07c0e1"
msgid "Je ne sais pas pourquoi tu m'aides autant alors ça risque de t'attirer des ennuis."
msgstr "Aku gak tau kenapa kamu bantu aku segitunya, tapi ini bisa bikin kamu kena masalah."

#. Character:`natsume` | Attributes:`happy`
msgctxt "home_natsume_exterior_8977a407"
msgid "Allez tire-toi vite, les thugs habitent dans le coin."
msgstr "Ayo cepetan cabut, preman-preman itu tinggal di sekitar sini."

#. Character:`saito`
msgctxt "home_natsume_exterior_608419eb"
msgid "Merci !"
msgstr "Makasih!"

#. Character:`natsume` | Attributes:`shame`
msgctxt "home_natsume_exterior_413c4eb4"
msgid "...de rien."
msgstr "...sama-sama."

#. Character:`minato`
msgctxt "home_natsume_exterior_bac3fdb6"
msgid "Tout est en place ?"
msgstr "Semua udah siap?"

#. Character:`natsume`
msgctxt "home_natsume_exterior_f9f4e275"
msgid "Oui... mais tu ne penses pas que tu vas trop loin ?"
msgstr "Iya... tapi kamu nggak mikir kamu udah kelewatan?"

#. Character:`natsume` | Attributes:`shame`
msgctxt "home_natsume_exterior_cc3049f1"
msgid "Beaucoup d'innocents vont..."
msgstr "Banyak orang tak bersalah yang bakal..."

#. Character:`minato` | Attributes:`upset`
msgctxt "home_natsume_exterior_392945bf"
msgid "{{natsume.n}}... Si je tolère ta présence et ton franc-parler c'est uniquement parce que tu sais te rendre utile mais..."
msgstr "{{natsume.n}}... Kalau aku nerima keberadaan kamu dan cara ngomongmu yang blak-blakan itu cuma karena kamu berguna, tapi..."

#. Character:`minato`
msgctxt "home_natsume_exterior_3dfa2c4b"
msgid "... ne dépasse pas les bornes."
msgstr "...jangan sampai kelewatan."

#. Character:`natsume` | Attributes:`afraid`
msgctxt "home_natsume_exterior_bd4a924e"
msgid "..."
msgstr "..."

#. Character:`minato` | Attributes:`suspicious`
msgctxt "home_natsume_exterior_0c201a7c"
msgid "Ne me dis pas que tu t'inquiètes pour cette idiote ?"
msgstr "Jangan bilang kamu khawatir sama si bodoh itu?"

#. Character:`minato`
msgctxt "home_natsume_exterior_a9347b5f"
msgid "Bon sang c'est pas vrai..."
msgstr "Sialan, nggak mungkin..."

#. Character:`minato`
msgctxt "home_natsume_exterior_b292f054"
msgid "Je t'avais prévenue de ne pas te lier d'amitié."
msgstr "Udah aku bilang jangan deket-deket dia."

#. Character:`natsume` | Attributes:`shame`
msgctxt "home_natsume_exterior_c025c1b9"
msgid "... Je ne comprends pas le but derrière toutes ces actions."
msgstr "... Aku nggak ngerti tujuan di balik semua tindakan ini."

#. Character:`minato`
msgctxt "home_natsume_exterior_6ff67b70"
msgid "Tu n'es de toute façon pas payée pour comprendre."
msgstr "Aku rasa kamu juga nggak dibayar buat ngerti."

#. Character:`minato`
msgctxt "home_natsume_exterior_76096e2e"
msgid "Les trois débiles ont été pris en charge ?"
msgstr "Ketiga bodoh itu udah diurus?"

#. Character:`natsume` | Attributes:`neutral`
msgctxt "home_natsume_exterior_77faf824"
msgid "Oui... Je pense que le fait qu'ils se soient faits avoir par {{saito.n}} en 1 contre 1 les a motivés comme jamais."
msgstr "Iya... Kayaknya mereka jadi termotivasi banget gara-gara dibantai {{saito.n}} satu lawan satu."

#. Character:`natsume`
msgctxt "home_natsume_exterior_511679a5"
msgid "C'était complètement surréaliste comme situation."
msgstr "Situasinya bener-bener nggak masuk akal."

#. Character:`minato`
msgctxt "home_natsume_exterior_bd461333"
msgid "C'est ça le problème avec les branleurs de ce genre, ils agissent toujours en groupe pour paraître plus fort."
msgstr "Itulah masalahnya sama brengsek kayak gitu, mereka selalu ngumpul biar keliatan kuat."

#. Character:`minato`
msgctxt "home_natsume_exterior_2be0c684"
msgid "Mais si tu les prends un par un, ça reste des grandes gueules."
msgstr "Tapi kalo dihadapin satu-satu, cuma tukang omong doang."

#. Character:`natsume` | Attributes:`bad`
msgctxt "home_natsume_exterior_665eea64"
msgid "C'est fou ce qu'il a pu changer en si peu de temps."
msgstr "Gila sih, dia bisa berubah segitu cepetnya."

#. Character:`minato` | Attributes:`happy`
msgctxt "home_natsume_exterior_deb64a51"
msgid "Peu importe, il va goûter au désespoir."
msgstr "Pokoknya, dia bakal ngerasain putus asa."

#. Character:`minato`
msgctxt "home_natsume_exterior_37ac0d04"
msgid "J'ai hâte de voir sa réaction quand son monde va s'écrouler."
msgstr "Aku nggak sabar liat reaksinya pas dunianya runtuh."

#. Character:`natsume` | Attributes:`happy`
msgctxt "TU_SAIS_JE_N_AI_JAMAIS_AMEN_D_DC7ADA"
msgid "Tu sais... Je n'ai jamais amené d'homme chez moi."
msgstr "Kamu tahu... Aku belum pernah bawa cowok ke rumahku."

#. Character:`saito` | Attributes:`upset`
msgctxt "PAS_M_ME_3A33F1"
msgid "Pas même..."
msgstr "Bahkan nggak pernah..."

#. Character:`natsume` | Attributes:`pouting`
msgctxt "SURTOUT_PAS_LUI_C_EST_BIEN_LE_287E04"
msgid "Surtout pas lui ! C'est bien le dernier endroit où je veux le voir."
msgstr "Apalagi dia! Itu tempat terakhir yang pengen aku lihat dia."

#. Character:`saito`
msgctxt "ET_DONC_QU_EST_CE_QUE_JE_FAIS_CA47E5"
msgid "Et donc ? Qu'est-ce que je fais ici ?"
msgstr "Terus? Kenapa aku ada di sini?"

#. Character:`natsume`
msgctxt "TU_CROIS_TOUT_DE_M_ME_PAS_QUE_18ED05"
msgid "Tu crois tout de même pas que je vais te laisser comme ça ?"
msgstr "Kamu nggak mungkin mikir aku bakal ninggalin kamu gitu aja kan?"

#. Character:`natsume` | Attributes:`neutral`
msgctxt "ENTRE_7D9C0E"
msgid "Entre !"
msgstr "Masuklah!"

#. Character:`saito`
msgctxt "NON_226EB1"
msgid "Non !"
msgstr "Nggak!"

#. Character:`natsume` | Attributes:`angry`
msgctxt "BON_SANG_PRENDRE_UNE_DOUCHE_NE_C7FEC8"
msgid "Bon sang, prendre une douche ne va pas te tuer..."
msgstr "Sialan, mandi nggak bakal bikin kamu mati kok..."

#. Character:`natsume`
msgctxt "D_AILLEURS_JE_VAIS_TRE_CELLE_Q_790F23"
msgid "D'ailleurs, je vais être celle qui va mourir si je continue de me tenir à côté de toi."
msgstr "Malahan, aku yang bakal mati kalau terus berdiri di samping kamu."

#. Character:`saito` | Attributes:`sad`
msgctxt "TU_N_ES_PAS_OBLIG_E_NON_PLUS_D_C0045F"
msgid "Tu n'es pas obligée non plus de..."
msgstr "Kamu juga nggak harus..."

#. Character:`natsume` | Attributes:`bad`
msgctxt "ALLEZ_HOP_HOP_HOP_F90D56"
msgid "Allez, hop hop hop !"
msgstr "Ayo, cepet cepet cepet!"

#. Character:`saito`
msgctxt "BON_LE_SOLEIL_EST_D_J_BIEN_HAU_E7AC58"
msgid "Bon... Le soleil est déjà bien haut."
msgstr "Ya... Matahari udah tinggi banget nih."

#. Character:`saito`
msgctxt "IL_NE_FAUT_PAS_QUE_JE_TRA_NE_D1A7EB"
msgid "Il ne faut pas que je traîne."
msgstr "Aku nggak boleh kelamaan santai."

#. Character:`saito`
msgctxt "LE_MA_TRE_M_ATTEND_D_J_PROBABL_3C6CD7"
msgid "Le maître m'attend déjà, probablement."
msgstr "Si tuan udah nungguin aku, kayaknya sih."

#. Character:`natsume`
msgctxt "CET_IDIOT_EST_ENFIN_PARTI_C_ES_F2B1C2"
msgid "Cet idiot est enfin parti, c’est pas trop tôt !"
msgstr "Bangsat itu akhirnya cabut juga, lama banget sih!"

#. Character:`hanako`
msgctxt "HEY_D6DEE6"
msgid "Hey !"
msgstr "Hei!"

#. Character:`natsume`
msgctxt "HANAKO_N_3F467C"
msgid "{{hanako.n}} !"
msgstr "{{hanako.n}}!"

#. Character:`hanako`
msgctxt "JE_CROIS_BIEN_AVOIR_APER_U_UN_7A492C"
msgid "Je crois bien avoir aperçu un dangereux criminel en fuite..."
msgstr "Kayaknya aku baru aja liat penjahat bahaya yang kabur..."

#. Character:`natsume` | Attributes:`happy`
msgctxt "MERCI_ENCORE_POUR_LES_FRINGUES_D3F1B1"
msgid "Merci encore pour les fringues."
msgstr "Makasih lagi buat bajunya."

#. Character:`hanako`
msgctxt "PAS_DE_SOUCI_CE_SONT_DE_VIEUX_540A7E"
msgid "Pas de souci, ce sont de vieux trucs que le père de {{kenji.n}} n’a jamais voulu mettre."
msgstr "Santai, itu barang lama yang bapaknya {{kenji.n}} nggak pernah mau pake."

#. Character:`hanako`
msgctxt "IL_EN_AURA_PLUS_BESOIN_QUE_LUI_B40D06"
msgid "Il en aura plus besoin que lui."
msgstr "Dia bakal butuh itu lebih dari dia."

#. Character:`natsume` | Attributes:`bad`
msgctxt "C_EST_TOI_LA_MEILLEURE_B45655"
msgid "C’est toi la meilleure !"
msgstr "Kamu yang terbaik!"

#. Character:`hanako`
msgctxt "VIDEMMENT_C6ED99"
msgid "Évidemment !"
msgstr "Jelas dong!"

#. Character:`hanako`
msgctxt "BREF_IL_EST_TEMPS_DE_SE_METTRE_44FC7F"
msgid "Bref, il est temps de se mettre au boulot. Fais-moi signe si tu as besoin d’autre chose."
msgstr "Pokoknya, saatnya kerja. Kasih tau aku kalau kamu butuh apa-apa lagi."

#. Character:`hanako`
msgctxt "CE_SERA_MA_FA_ON_DE_L_AIDER_3C3A63"
msgid "Ce sera ma façon de l’aider."
msgstr "Itu cara aku bantu dia."

#. Character:`natsume` | Attributes:`neutral`
msgctxt "JE_NE_SAIS_PAS_COMMENT_TU_AS_F_4D6755"
msgid "Je ne sais pas comment tu as fait ça, {{saito.n}}, mais..."
msgstr "Aku nggak tau gimana kamu bisa ngelakuin itu, {{saito.n}}, tapi..."

#. Character:`natsume`
msgctxt "TU_R_USSIS_TROUVER_DU_SOUTIEN_BA0B51"
msgid "Tu réussis à trouver du soutien même dans les pires situations."
msgstr "Kamu bisa dapetin dukungan bahkan di situasi terburuk sekalipun."

#. Character:`saito`
msgctxt "ON_DIRAIT_QU_ELLE_A_FINI_PAR_B_AF94AD"
msgid "On dirait qu'elle a fini par baisser un peu sa garde."
msgstr "Kayaknya dia akhirnya mulai sedikit menurunin kewaspadaannya."

#. Character:`saito`
msgctxt "ELLE_ME_FAIT_SUFFISAMMENT_CONF_5E2984"
msgid "Elle me fait suffisamment confiance pour parler un peu de sa vie."
msgstr "Dia cukup percaya sama aku buat cerita sedikit tentang hidupnya."

#. Character:`saito`
msgctxt "C_EST_D_J_UN_D_BUT_D70BCA"
msgid "C’est déjà un début."
msgstr "Itu sudah langkah awal."

#. Character:`saito`
msgctxt "CELA_DIT_ELLE_A_RAISON_EN_PARL_288E04"
msgid "Cela dit... elle a raison, en parler ne change rien."
msgstr "Tapi... dia benar, ngomongin itu nggak bakal ngubah apa-apa."

#. Character:`saito` | Attributes:`sad`
msgctxt "JE_NE_PEUX_RIEN_FAIRE_POUR_L_I_6D9F42"
msgid "Je ne peux rien faire pour l’instant."
msgstr "Aku nggak bisa ngapa-ngapain buat sekarang."

#. Character:`saito` | Attributes:`upset`
msgctxt "ET_SI_JE_M_EN_PRENDS_MINATO_N_28D92B"
msgid "Et si je m’en prends à {{minato.n}}, je compromettrais aussi son plan pour protéger sa mère."
msgstr "Kalau aku nyerang {{minato.n}}, aku juga bakal ngerusak rencananya buat jagain ibunya."

#. Character:`saito`
msgctxt "MIEUX_VAUT_LAISSER_A_DE_C_T_P_A8CA3E"
msgid "... Mieux vaut laisser ça de côté pour l’instant."
msgstr "... Mendingan aku tunda dulu deh urusan ini."

#. Character:`saito` | Attributes:`neutral`
msgctxt "LE_MA_TRE_DIRAIT_S_REMENT_DE_N_2C8D7C"
msgid "Le Maître dirait sûrement de ne pas me prendre la tête avec ce que je ne peux pas contrôler."
msgstr "Si Bos pasti bakal bilang jangan pusingin hal yang nggak bisa aku kontrol."

#. Character:`saito`
msgctxt "ET_IL_DOIT_D_J_M_ATTENDRE_DBDD34"
msgid "Et il doit déjà m’attendre..."
msgstr "Dan dia pasti udah nungguin aku..."

#. Character:`natsume`
msgctxt "warehouse_exterior_6fff042c"
msgid "Franchement je ne te comprends pas..."
msgstr "Jujur aku nggak ngerti kamu..."

#. Character:`natsume`
msgctxt "warehouse_exterior_c1d31789"
msgid "Pourquoi as-tu voulu perdre ton temps pour quelque chose d'aussi inutile !"
msgstr "Kenapa kamu mau buang-buang waktu buat hal yang sebenernya nggak penting gitu!"

#. Character:`minato`
msgctxt "warehouse_exterior_5b4b3873"
msgid "Ça te semblait inutile ?"
msgstr "Kamu pikir itu nggak penting ya?"

#. Character:`natsume`
msgctxt "warehouse_exterior_115da5d2"
msgid "Plutôt oui."
msgstr "Iya, sebenernya sih."

#. Character:`minato`
msgctxt "warehouse_exterior_6951da06"
msgid "Tu savais qu'elle m'a rejeté ?"
msgstr "Kamu tahu dia udah nolak aku nggak?"

#. Character:`natsume`
msgctxt "warehouse_exterior_fbee4af3"
msgid "... en même temps, vu ta façon de leur parler, il fallait s'y attendre non ?"
msgstr "... ya, ngeliat cara kamu ngomong sama mereka, ya wajar sih ya?"

#. Character:`minato`
msgctxt "warehouse_exterior_52437a41"
msgid "{{natsume.n}}... Ne me prends pas pour un idiot, je sais que tu y as mis ton grain de sel."
msgstr "{{natsume.n}}... Jangan anggep aku bodoh, aku tahu kamu ikut campur."

#. Character:`natsume`
msgctxt "warehouse_exterior_3d00c747"
msgid "Tu n'es pas fâché ?"
msgstr "Kamu nggak marah ya?"

#. Character:`minato`
msgctxt "warehouse_exterior_f179e732"
msgid "Tu n'as pas idée mais..."
msgstr "Kamu nggak nyangka tapi..."

#. Character:`minato`
msgctxt "warehouse_exterior_a0436c6e"
msgid "Quelque chose de bien plus intéressant est en train de se produire."
msgstr "Ada sesuatu yang jauh lebih menarik lagi yang lagi kejadian."

#. Character:`natsume`
msgctxt "warehouse_exterior_ce0e7f9f"
msgid "... et ? Qu'est-ce qui te semble aussi intéressant ?"
msgstr "... terus? Apa yang menurut kamu menarik banget?"

#. Character:`minato`
msgctxt "warehouse_exterior_47755bde"
msgid "Une divergence..."
msgstr "Ada perbedaan pendapat..."

#. Character:`natsume` | Attributes:`bad`
msgctxt "warehouse_exterior_e906b873"
msgid "... Mouais en gros tu t'es pris un râteau et tu as juste du mal à le digérer..."
msgstr "... Ya, intinya kamu kena ghosting dan susah buat nerima kenyataan..."

#. Character:`natsume`
msgctxt "warehouse_exterior_6547ca09"
msgid "Ah les mecs...[w] Vous me faites marrer !"
msgstr "Ah, bocah-bocah...[w] Kamu bikin aku ketawa!"

#. Character:`takeo`
msgctxt "warehouse_exterior_dff7e4b9"
msgid "Je suis blasé... On travaille cette crevette au corps depuis des heures."
msgstr "Aku udah bosen... Udah berjam-jam kita ngebujuk cewek ini."

#. Character:`takeo`
msgctxt "warehouse_exterior_f8e2b7b2"
msgid "J'aime bien faire ce genre de choses quand on a une info ou un truc à soutirer, mais là..."
msgstr "Aku suka banget ngelakuin hal kayak gini kalo ada info atau sesuatu yang harus didapetin, tapi kali ini..."

#. Character:`kenji` | Attributes:`disgusted`
msgctxt "warehouse_exterior_598c2b07"
msgid "Ça me laisse un goût amer dans la bouche moi-aussi."
msgstr "Ini juga ninggalin rasa pahit di mulut aku."

#. Character:`kenji`
msgctxt "warehouse_exterior_adad4ae1"
msgid "On l'a tellement giflé que j'en ai mal aux mains !"
msgstr "Kita tampar dia sampe tangan aku sakit!"

#. Character:`nobu` | Attributes:`mocking`
msgctxt "warehouse_exterior_3ae0fec4"
msgid "Moi, sa tête me fait rire, elle a doublé de volume !"
msgstr "Aku, mukanya bikin aku ketawa, mukanya jadi dua kali lipat gede!"

#. Character:`nobu`
msgctxt "warehouse_exterior_08d830dc"
msgid "Il ressemble à un hamster."
msgstr "Dia mirip hamster."

#. Character:`takeo` | Attributes:`neutral`
msgctxt "warehouse_exterior_cb942a1c"
msgid "Sérieux, des fois, je me demande pourquoi on te laisse trainer avec nous !"
msgstr "Serius, kadang aku mikir kenapa kamu masih boleh nongkrong bareng kita!"

#. Character:`kenji`
msgctxt "warehouse_exterior_141c6914"
msgid "T'es vraiment un putain de psychopathe !"
msgstr "Kamu emang psikopat parah!"

#. Character:`nobu` | Attributes:`angry`
msgctxt "warehouse_exterior_a1e9b7cd"
msgid "Quoi ?! Mais vos gueules ! Moi aussi ça me fait chier d'être là pour rien."
msgstr "Apa?! Tapi pada diem! Aku juga sebel banget ada di sini buat gak jelas."

#. Character:`nobu`
msgctxt "warehouse_exterior_c00923aa"
msgid "Je préférerais mille fois aller à la salle d'arcade plutôt que de me faire chier ici à taper un type pendant des heures."
msgstr "Aku mending seribu kali ke arena game daripada ngabisin waktu di sini mukulin orang selama berjam-jam."

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "warehouse_exterior_86a56c0a"
msgid "Mais c'est pas comme si on avait le choix..."
msgstr "Tapi gak kayak kita punya pilihan lain..."

#. Character:`kenji` | Attributes:`neutral`
msgctxt "warehouse_exterior_0f6d8792"
msgid "Il est censé venir à quelle heure le boss ?"
msgstr "Bossnya katanya datang jam berapa sih?"

#. Character:`takeo`
msgctxt "warehouse_exterior_773bc3e5"
msgid "Il devrait déjà être là normalement..."
msgstr "Seharusnya dia udah ada di sini nih..."

#. Character:`akira`
msgctxt "warehouse_exterior_9e69f401"
msgid "Yo les tarlouzes !"
msgstr "Yo, kalian para banci!"

#. Character:`akira`
msgctxt "warehouse_exterior_6fd93a33"
msgid "Encore en train de vous branler mutuellement ?"
msgstr "Masih pada saling ngentot ya?"

#. Character:`nobu` | Attributes:`angry`
msgctxt "warehouse_exterior_dc13f7cc"
msgid "Y'a rien qui te concerne ici, casse-toi !"
msgstr "Aku gak ada urusan sama kamu di sini, cabut sana!"

#. Character:`takeo` | Attributes:`disgusted`
msgctxt "warehouse_exterior_a91cfbc6"
msgid "..."
msgstr "..."

#. Character:`kenji` | Attributes:`disgusted`
msgctxt "warehouse_exterior_20243432"
msgid "..."
msgstr "..."

#. Character:`akira`
msgctxt "warehouse_exterior_06bec25d"
msgid "C'est bien d'ouvrir sa gueule {{nobu.n}}..."
msgstr "Buka mulut emang gampang {{nobu.n}}..."

#. Character:`akira`
msgctxt "warehouse_exterior_43f7fb83"
msgid "Mais, derrière, faut savoir assumer."
msgstr "Tapi, di belakangnya harus bisa tanggung jawab juga."

#. Character:`nobu`
msgctxt "warehouse_exterior_fc964f52"
msgid "Va te f-"
msgstr "Mampus lu-"

#. Character:`akira`
msgctxt "warehouse_exterior_eabbc6ce"
msgid "Vous en faites une de ces têtes..."
msgstr "Kalian pada kelihatan bete banget..."

#. Character:`akira`
msgctxt "warehouse_exterior_77a5f9f6"
msgid "Vous cachez quoi dans l'entrepôt ?"
msgstr "Sembunyiin apa sih di gudang itu?"

#. Character:`takeo` | Attributes:`neutral`
msgctxt "warehouse_exterior_8869df2b"
msgid "...Un mec qui a cherché des ennuis..."
msgstr "...Cowok yang nyari ribut..."

#. Character:`akira` | Attributes:`happy`
msgctxt "warehouse_exterior_7d9f3db8"
msgid "Oh, intéressant !"
msgstr "Oh, menarik nih!"

#. Character:`nobu`
msgctxt "warehouse_exterior_923fdc75"
msgid "Putain {{takeo.n}}, tu pourrais pas arrêter de faire la balance ?"
msgstr "Sialan {{takeo.n}}, kamu nggak bisa berhenti jadi informan ya?"

#. Character:`kenji` | Attributes:`angry`
msgctxt "warehouse_exterior_8872c79e"
msgid "Ferme ta gueule {{nobu.n}}, c'est toi qui vas l'empêcher d'aller voir peut-être ?"
msgstr "Tutup mulut kamu {{nobu.n}}, kamu yang bakal ngehalangin dia pergi ya?"

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "warehouse_exterior_d1f0b07f"
msgid "[font_size=19]Ouais, mais si on s'y met ensemble, peut-être que...[/font_size]"
msgstr "[font_size=19]Iya, tapi kalo kita barengan, mungkin aja...[/font_size]"

#. Character:`takeo`
msgctxt "warehouse_exterior_d0287ee6"
msgid "Oublie, {{akira.n}} est pas humain, tu te souviens pas du massacre du konbini ?"
msgstr "Lupain aja, {{akira.n}} bukan manusia, kamu nggak ingat pembantaian di konbini?"

#. Character:`nobu` | Attributes:`mocking`
msgctxt "warehouse_exterior_0161572d"
msgid "J'en ai entendu parler vaguement, mais c'est trop loufoque. C'est juste une légende urbaine."
msgstr "Aku cuma denger sekilas, tapi itu terlalu gila. Cuma legenda urban doang."

#. Character:`kenji` | Attributes:`neutral`
msgctxt "warehouse_exterior_ba6b63cd"
msgid "Non, détrompe-toi, c'est vraiment arrivé !"
msgstr "Nggak, salah kamu, itu beneran kejadian!"

#. Character:`kenji`
msgctxt "warehouse_exterior_05094e14"
msgid "Le chef d'une bande rivale était en balade à moto dans le coin avec une vingtaine de ses gars."
msgstr "Bos geng saingan lagi jalan-jalan naik motor di sekitar situ sama sekitar dua puluhan anak buahnya."

#. Character:`takeo`
msgctxt "warehouse_exterior_2fc2f8ea"
msgid "Ils se sont tous arrêtés sur le parking du konbini."
msgstr "Mereka semua berhenti di parkiran konbini."

#. Character:`takeo`
msgctxt "warehouse_exterior_30dd551d"
msgid "{{akira.n}} était encore au lycée à l'époque. C'était une soirée d'été et la chaleur était toujours étouffante. Il dégustait tranquillement une glace à l'eau, quand..."
msgstr "{{akira.n}} masih di SMA waktu itu. Waktu itu malam musim panas dan panasnya masih ngerasa pengap banget. Dia lagi santai makan es air, pas tiba-tiba..."

#. Character:`nobu` | Attributes:`angry`
msgctxt "warehouse_exterior_9883a758"
msgid "Putain ! J'ai pas besoin de tout ce genre de détails, viens-en aux faits."
msgstr "Sialan! Aku gak butuh semua detail kayak gitu, langsung ke intinya aja."

#. Character:`takeo` | Attributes:`angry`
msgctxt "warehouse_exterior_8dd6d657"
msgid "Ta gueule, je pose l'ambiance alors écoute !"
msgstr "Bokong kamu! Aku lagi bangun suasana, jadi dengerin!"

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "warehouse_exterior_b4c5fae4"
msgid "[font_size=19]Mais, putain...[/font_size]"
msgstr "[font_size=19]Tapi, sialan...[/font_size]"

#. Character:`takeo` | Attributes:`neutral`
msgctxt "warehouse_exterior_46981053"
msgid "Un des gars s'est approché de lui et a voulu lui donner un coup de pied."
msgstr "Salah satu cowok itu maju ke arahnya dan mau nendang dia."

#. Character:`nobu`
msgctxt "warehouse_exterior_44e88e30"
msgid "Et... ?"
msgstr "Terus...?"

#. Character:`kenji` | Attributes:`neutral`
msgctxt "warehouse_exterior_a0fb95d6"
msgid "Il lui a enfoncé le bâtonnet de glace dans l'œil."
msgstr "Dia nyelametin stik es krimnya ke matanya."

#. Character:`kenji`
msgctxt "warehouse_exterior_00fcb418"
msgid "Quand les autres ont vu ça, ils se sont jetés sur lui, mais il les a tous massacrés."
msgstr "Pas yang lain liat itu, mereka langsung nyerbu dia, tapi dia bantai semuanya."

#. Character:`kenji`
msgctxt "warehouse_exterior_a246de44"
msgid "Ça a été un vrai bain de sang !"
msgstr "Itu benar-benar jadi kubangan darah!"

#. Character:`nobu`
msgctxt "warehouse_exterior_c77b7142"
msgid "Mais... et le chef du gang ?"
msgstr "Tapi... gimana sama bos gengnya?"

#. Character:`takeo` | Attributes:`neutral`
msgctxt "warehouse_exterior_70f768b1"
msgid "Il s'est tiré quand il a vu son gars se faire crever l'œil. Il a dû savoir à l'instinct que ce type était le genre de gars dangereux que tu ne fais chier sous aucun prétexte..."
msgstr "Dia kabur waktu liat temennya matanya ditusuk. Dia pasti ngerasa dari insting kalau cowok itu tipe orang berbahaya yang nggak boleh kamu ganggu apapun alasannya..."

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "warehouse_exterior_b05e30a7"
msgid "Putain... Merde alors..."
msgstr "Sialan... Sial banget..."

#. Character:`takeo` | Attributes:`angry`
msgctxt "warehouse_exterior_211c7b72"
msgid "Donc, arrête de chercher des ennuis avec lui... On te suivra pas, tu te démerdes."
msgstr "Jadi, berhenti nyari masalah sama dia... Kita gak bakal ikut campur, kamu urusin sendiri."

#. Character:`nobu`
msgctxt "warehouse_exterior_ec9996db"
msgid "Okay c'est bon, j'ai pigé..."
msgstr "Oke, aku ngerti..."

#. Character:`akira`
msgctxt "warehouse_exterior_578e9445"
msgid "Mais, quelle bande de demeurés..."
msgstr "Dasar bodoh semua..."

#. Character:`akira`
msgctxt "warehouse_exterior_8900f687"
msgid "Ils n'ont même pas pensé à le fouiller."
msgstr "Mereka bahkan gak kepikiran buat ngecek dia."

#. Character:`akira`
msgctxt "warehouse_exterior_c7d7eafa"
msgid "Ça m'arrange qu'ils soient aussi cons, sinon je ne serais pas tombé sur ça..."
msgstr "Aku seneng mereka sebodoh itu, kalo nggak aku gak bakal nemu ini..."

#. Character:`akira` | Attributes:`neutral`
msgctxt "warehouse_exterior_cb927443"
msgid "Alors voyons, qu'est-ce que ça dit...[w] Oh putain ![w] Ce bâtard !"
msgstr "Yuk lihat, apa katanya...[w] Oh sialan![w] Bajingan itu!"

#. Character:`akira` | Attributes:`upset`
msgctxt "QUI_AURAIT_PENS_QUE_CETTE_RACL_13469E"
msgid "Qui aurait pensé que cette raclure de chiotte s'etait trouvé une chatte ?"
msgstr "Siapa nyangka bajingan sialan itu punya cewek?"

#. Character:`akira` | Attributes:`upset`
msgctxt "warehouse_exterior_15ca3cb4"
msgid "Qui aurait pensé que cette raclure de chiotte se tapait deux femmes à la fois ?"
msgstr "Siapa nyangka bajingan sialan itu selingkuh sama dua cewek sekaligus?"

#. Character:`akira` | Attributes:`upset`
msgctxt "warehouse_exterior_254c5efd"
msgid "Qui aurait pensé que cette raclure de chiotte avait autant de succès ?"
msgstr "Siapa sangka bajingan sialan itu bisa sesukses itu?"

#. Character:`akira` | Attributes:`arrogant`
msgctxt "warehouse_exterior_7f4270f9"
msgid "... et visiblement, ça lui a attiré des ennuis...[w] Oh-ho avec cette pute en plus !"
msgstr "... dan jelas, itu bikin dia kena masalah...[w] Wah-wah apalagi sama pelacur itu!"

#. Character:`akira` | Attributes:`neutral`
msgctxt "warehouse_exterior_36604d17"
msgid "Dire que j'ai failli sortir avec cette cinglée... Il faut que je voie ça de mes propres yeux !"
msgstr "Bayangin aja aku hampir pacaran sama gila itu... Aku harus liat sendiri!"

#. Character:`akira` | Attributes:`arrogant`
msgctxt "warehouse_exterior_dd35a870"
msgid "Je pourrais peut-être prendre quelques photos compromettantes, et elle finira par devoir m'obéir au doigt et à l'œil."
msgstr "Mungkin aku bisa ambil beberapa foto skandal, biar dia nantinya harus nurut aku tiap perintah."

#. Character:`minato`
msgctxt "warehouse_exterior_015d895b"
msgid "... Dans quel état il se trouve ?"
msgstr "... Keadaannya gimana?"

#. Character:`takeo`
msgctxt "warehouse_exterior_6a57807a"
msgid "Il a repris conscience il y a quelques minutes."
msgstr "Dia sadar beberapa menit yang lalu."

#. Character:`takeo`
msgctxt "warehouse_exterior_56429154"
msgid "Vous vouliez l'interroger ?"
msgstr "Kamu mau interogasi dia?"

#. Character:`minato` | Attributes:`happy`
msgctxt "warehouse_exterior_fde503aa"
msgid "Non..."
msgstr "Gak..."

#. Character:`takeo`
msgctxt "warehouse_exterior_75330050"
msgid "Dans ce cas, que comptez-vous faire de lui ?"
msgstr "Kalau gitu, mau ngapain dia?"

#. Character:`minato`
msgctxt "warehouse_exterior_ecc130fd"
msgid "J'ai quelques mots à lui dire, après, vous irez jeter son cadavre dans la forêt..."
msgstr "Aku ada beberapa hal buat dia denger, abis itu kamu buang mayatnya ke hutan..."

#. Character:`takeo` | Attributes:`disgusted`
msgctxt "warehouse_exterior_5d0297aa"
msgid "Mais... Nous n'avons jamais t-"
msgstr "Tapi... Kita nggak pernah s-"

#. Character:`minato` | Attributes:`neutral`
msgctxt "warehouse_exterior_13a2c332"
msgid "Si vous voulez vous faire une place au soleil sous mes ordres, il faudra obéir sans rechigner."
msgstr "Kalau kamu mau dapetin tempat di bawah perintah aku, kamu harus nurut tanpa ngeluh."

#. Character:`minato`
msgctxt "warehouse_exterior_f412b377"
msgid "Si quelqu'un m'est inutile, je m'en débarrasse..."
msgstr "Kalau ada yang nggak berguna buat aku, aku bakal singkirin..."

#. Character:`minato`
msgctxt "warehouse_exterior_48d8b73a"
msgid "Je me suis bien fait comprendre ?"
msgstr "Aku udah jelas, kan?"

#. Character:`takeo`
msgctxt "warehouse_exterior_8ea38eb4"
msgid "Oui, boss..."
msgstr "Iya, bos..."

#. Character:`minato`
msgctxt "warehouse_exterior_702d6a2b"
msgid "Ne t'en fais pas, si tu te salis les mains pour moi, je t'assure que tu n'auras plus jamais à t'inquiéter pour ton avenir."
msgstr "Nggak usah khawatir, kalau kamu kotorin tangan buat aku, aku jamin kamu nggak bakal pernah lagi pusing soal masa depan kamu."

#. Character:`takeo` | Attributes:`angry`
msgctxt "warehouse_exterior_fe169cb2"
msgid "...[w] Putain !"
msgstr "...[w] Sialan!"

#. Character:`minato`
msgctxt "warehouse_exterior_3a565dd8"
msgid "Eh bien, si je m'attendais à ça..."
msgstr "Ya ampun, aku nggak nyangka gini..."

#. Character:`minato`
msgctxt "warehouse_exterior_3ff8c92c"
msgid "Toi qui traînes souvent en ville, tu as une idée de qui peut être cette montagne de muscles ?"
msgstr "Kamu yang sering nongkrong di kota, kamu tau nggak siapa si otot segede gunung itu?"

#. Character:`natsume` | Attributes:`bad`
msgctxt "warehouse_exterior_b278dbf7"
msgid "Un gars accro à l'entraînement... {{saito.n}} traîne souvent avec."
msgstr "Orang yang kecanduan latihan... {{saito.n}} sering nongkrong sama dia."

#. Character:`minato`
msgctxt "warehouse_exterior_6b234c33"
msgid "{{saito.n}}... Je vais de surprise en surprise."
msgstr "{{saito.n}}... Aku terus-terusan kaget nih."

#. Character:`natsume` | Attributes:`surprised`
msgctxt "warehouse_exterior_5ce88067"
msgid "Tu ne veux plus te débarrasser de l'autre ?"
msgstr "Kamu gak mau ngusir yang satunya lagi?"

#. Character:`minato`
msgctxt "warehouse_exterior_3652562c"
msgid "Non... ça n'a plus aucun intérêt, mais j'ai trouvé quelque chose de bien plus intéressant à faire."
msgstr "Gak... udah gak ada artinya lagi, tapi aku nemu sesuatu yang jauh lebih menarik buat dilakuin."

#. Character:`minato`
msgctxt "warehouse_exterior_40a8017e"
msgid "Trouve-moi tout ce qu'il y a à savoir sur la montagne de muscles."
msgstr "Cariin aku semua info tentang gunungan otot itu."

#. Character:`natsume` | Attributes:`neutral`
msgctxt "warehouse_exterior_de206ed7"
msgid "Et, pour les trois, j'appelle une ambulance ?"
msgstr "Terus, buat ketiganya, aku panggil ambulan?"

#. Character:`minato` | Attributes:`happy`
msgctxt "warehouse_exterior_16a6dc9b"
msgid "Pour ces guignols ?"
msgstr "Buat bocah-bocah itu?"

#. Character:`natsume` | Attributes:`shame,blush`
msgctxt "warehouse_exterior_33450653"
msgid "Non, pardon, c'était une question bête..."
msgstr "Gak, maaf, itu pertanyaan bodoh..."

#. Character:`minato` | Attributes:`-happy`
msgctxt "warehouse_exterior_c8581708"
msgid "Je te laisse t'occuper du reste..."
msgstr "Aku serahin sisanya ke kamu..."

#. Character:`natsume` | Attributes:`sad`
msgctxt "warehouse_exterior_21706b61"
msgid "..."
msgstr "..."

#. Character:`minato` | Attributes:`upset`
msgctxt "warehouse_exterior_8b3748d3"
msgid "Je vais finir par penser que vous ne me servez à rien..."
msgstr "Aku mulai mikir kalo kalian gak ada gunanya buat aku..."

#. Character:`takeo` | Attributes:`disgusted`
msgctxt "warehouse_exterior_38e5b8d8"
msgid "Je sais qu'on a merdé mais c'est pas de notre faute non plus."
msgstr "Aku tau kita udah salah, tapi itu juga bukan salah kita sepenuhnya."

#. Character:`minato`
msgctxt "warehouse_exterior_2bd39b08"
msgid "Tu sais ce que je pense des gens qui se trouvent des excuses ?"
msgstr "Kamu tau nggak aku mikir apa soal orang yang suka cari alasan?"

#. Character:`takeo`
msgctxt "warehouse_exterior_24643aca"
msgid "Non... j-"
msgstr "Nggak... gua-"

#. Character:`minato` | Attributes:`angry`
msgctxt "warehouse_exterior_506224b4"
msgid "Vous aviez la responsabilité de me débarrasser de ce parasite et vous avez merdé c'est tout."
msgstr "Kamu bertanggung jawab buat ngilangin parasit itu dari aku, tapi kamu gagal, itu aja."

#. Character:`minato`
msgctxt "warehouse_exterior_21705c6f"
msgid "Vous vous êtes fait surprendre, vous n'avez pas agi assez vite, vous avez eu des remords que sais-je ?"
msgstr "Kamu ketangkap basah, kamu nggak cukup cepet bertindak, kamu ngerasa bersalah apa, aku nggak tau?"

#. Character:`minato`
msgctxt "warehouse_exterior_8b25c843"
msgid "Le résultat est là, vous avez merdé et je me retrouve avec plus d'ennuis sur les bras par votre incompétence."
msgstr "Hasilnya jelas, kamu gagal dan aku jadi kebanyakan masalah gara-gara ketidakmampuan kamu."

#. Character:`takeo`
msgctxt "warehouse_exterior_21295b0e"
msgid "...[w] On a merdé c'est vrai..."
msgstr "...[w] Iya, kita emang gagal..."

#. Character:`minato` | Attributes:`upset`
msgctxt "warehouse_exterior_b40232e6"
msgid "Pffff eh bien voilà, c'était pas si dur à admettre ?"
msgstr "Pfff, ya udah, kan nggak susah ngakuinnya?"

#. Character:`minato`
msgctxt "warehouse_exterior_dd764038"
msgid "Qu'est-ce que je vais bien pouvoir branler de vous à présent ?"
msgstr "Sekarang aku harus ngapain sama kamu nih?"

#. Character:`takeo` | Attributes:`neutral`
msgctxt "warehouse_exterior_13ba4309"
msgid "[font_size=14]On aimerait devenir plus forts.[/font_size]"
msgstr "[font_size=14]Kita pengen jadi lebih kuat.[/font_size]"

#. Character:`minato`
msgctxt "warehouse_exterior_ce60f9c2"
msgid "Pardon ?! Tu peux répéter ? Je crois que j'ai mal compris."
msgstr "Mau? Kamu bisa ulangin? Kayaknya aku salah denger nih."

#. Character:`takeo`
msgctxt "warehouse_exterior_6aba7299"
msgid "On veut devenir plus forts."
msgstr "Kita pengen jadi lebih kuat."

#. Character:`takeo`
msgctxt "warehouse_exterior_1fd87d89"
msgid "Le gros black continuera de nous tomber dessus et de nous ridiculiser si on ne fait rien."
msgstr "Si gendut hitam itu bakal terus ngejatuhin kita dan ngejek kalau kita gak ngelakuin apa-apa."

#. Character:`takeo`
msgctxt "warehouse_exterior_6daf9b7e"
msgid "Rien ne peut l'arrêter, pas même {{akira.n}}."
msgstr "Gak ada yang bisa ngelawannya, bahkan {{akira.n}} sekalipun."

#. Character:`takeo`
msgctxt "warehouse_exterior_4e7d20b5"
msgid "Et après lui, il y aura toujours quelqu'un de plus fort."
msgstr "Dan setelah dia, bakal selalu ada orang yang lebih kuat."

#. Character:`takeo`
msgctxt "warehouse_exterior_94cc93f1"
msgid "On veut être pris au sérieux mais tant qu'il sera là..."
msgstr "Kita pengen dianggap serius tapi selama dia masih ada..."

#. Character:`minato`
msgctxt "warehouse_exterior_01fc644f"
msgid "... D'accord je vois. Casse-toi maintenant, je vais voir ce que je peux faire."
msgstr "... Oke aku ngerti. Pergi sekarang, aku bakal liat apa yang bisa aku lakuin."

#. Character:`takeo` | Attributes:`mocking`
msgctxt "warehouse_exterior_d9d006b2"
msgid "Merci Boss, on promet de tout donner pour vous."
msgstr "Makasih Bos, kita janji bakal ngasih semua buat kamu."

#. Character:`minato`
msgctxt "warehouse_exterior_aae97457"
msgid "Ouais ouais j'ai compris, dégage vite !"
msgstr "Iya iya aku ngerti, cepetan cabut!"

#. Character:`minato`
msgctxt "warehouse_exterior_83ffb293"
msgid "..."
msgstr "..."

#. Character:`natsume`
msgctxt "warehouse_exterior_3523c6a4"
msgid "Ça ne te ressemble pas."
msgstr "Kamu gak kayak biasanya."

#. Character:`minato`
msgctxt "warehouse_exterior_c194a550"
msgid "Je n'avais pas anticipé ça..."
msgstr "Aku gak nyangka bakal kayak gini..."

#. Character:`natsume` | Attributes:`bad`
msgctxt "warehouse_exterior_ee6ffb7c"
msgid "Comment veux-tu anticiper un truc pareil, ce type est une montagne de muscles et..."
msgstr "Gimana kamu mau nyiapin diri buat hal kayak gitu, cowok itu ototnya segunung dan..."

#. Character:`minato`
msgctxt "warehouse_exterior_ec7cc8a6"
msgid "Je ne parle pas de l'autre monstre."
msgstr "Aku nggak ngomongin monster yang itu."

#. Character:`natsume` | Attributes:`surprised`
msgctxt "warehouse_exterior_db54a795"
msgid "Alors de qui ?"
msgstr "Terus ngomongin siapa nih?"

#. Character:`minato`
msgctxt "warehouse_exterior_bb5780c2"
msgid "C'est la première fois que les thugs se remettent en question et souhaitent progresser."
msgstr "Ini pertama kalinya para preman itu mulai mikir ulang dan pengen maju."

#. Character:`natsume` | Attributes:`bad`
msgctxt "warehouse_exterior_31fef4c5"
msgid "... C'est si exceptionnel que ça ?"
msgstr "... Seriusan itu sehebat itu?"

#. Character:`minato` | Attributes:`happy`
msgctxt "warehouse_exterior_a056af1d"
msgid "Tu n'as pas idée."
msgstr "Kamu nggak kebayang deh."

#. Character:`minato`
msgctxt "warehouse_exterior_4f47b4c4"
msgid "On va commencer par se débarrasser du géant."
msgstr "Kita mulai dari ngeberesin si raksasa dulu."

#. Character:`minato`
msgctxt "warehouse_exterior_f0f18cda"
msgid "Ça nous laissera plus de marge de manœuvre."
msgstr "Biar kita punya ruang gerak lebih."

#. Character:`natsume`
msgctxt "warehouse_exterior_feb01e81"
msgid "Tu ne veux pas l'avertir ou le menacer d'abord ?"
msgstr "Kamu nggak mau ngasih peringatan atau ancaman dulu?"

#. Character:`minato`
msgctxt "warehouse_exterior_007cecac"
msgid "Non, on n'a plus le temps pour ça. L'échéance est pour bientôt, je refuse de perdre davantage de temps."
msgstr "Nggak, kita nggak punya waktu buat itu. Waktunya mepet, aku nggak mau buang-buang waktu lagi."

#. Character:`minato`
msgctxt "warehouse_exterior_a3dc7202"
msgid "Contente-toi d'obeir, je perds mon temps à chaque fois si je dois t'expliquer pourquoi."
msgstr "Cukup nurut aja, aku buang-buang waktu tiap kali harus jelasin kenapa."

#. Character:`natsume` | Attributes:`angry`
msgctxt "warehouse_exterior_bafec45c"
msgid "... Enfoiré !"
msgstr "... Bajingan!"

#. Character:`narrator`
msgctxt "warehouse_exterior_a74033b0"
msgid "La voilà... et avec les trois en plus !"
msgstr "Nah tuh... dan malah ada tiga!"

#. Character:`narrator`
msgctxt "warehouse_exterior_99164391"
msgid "Merde ! Tout ça va beaucoup trop loin."
msgstr "Sialan! Ini udah kelewat batas banget."

#. Character:`kenji` | Attributes:`disgusted`
msgctxt "warehouse_exterior_60316333"
msgid "... Je comprendrais jamais pourquoi tu le détestes autant."
msgstr "... Aku nggak bakal ngerti kenapa kamu benci dia segitunya."

#. Character:`kenji`
msgctxt "warehouse_exterior_ab83c167"
msgid "C'est ton frangin pourtant ?!"
msgstr "Itu kan saudara kamu?!"

#. Character:`takeo` | Attributes:`disgusted`
msgctxt "warehouse_exterior_ad3f4d97"
msgid "En effet, la famille se serre les coudes, en toutes circonstances."
msgstr "Iya, keluarga itu harus saling dukung, apapun keadaannya."

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "warehouse_exterior_7175f65d"
msgid "C'est clair."
msgstr "Bener banget."

#. Character:`noriko` | Attributes:`angry`
msgctxt "warehouse_exterior_9bec0fe7"
msgid "Ce n'est pas mon frère, arrêtez avec ça !"
msgstr "Dia bukan saudara aku, berhenti deh sama omongan itu!"

#. Character:`kenji`
msgctxt "warehouse_exterior_f224086a"
msgid "Wow wow wow une minute, la famille ce n'est pas forcément les liens du sang."
msgstr "Tunggu dulu, keluarga nggak harus selalu soal darah."

#. Character:`takeo`
msgctxt "warehouse_exterior_2f530d2d"
msgid "La famille c'est tous les gens qui comptent pour toi et auxquels tu tiens."
msgstr "Keluarga itu semua orang yang penting buat kamu dan yang kamu sayang."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "warehouse_exterior_49caf651"
msgid "Oui eh bien c'est bien ce que je dis... Ce n'est pas ma famille."
msgstr "Iya, ya itu juga yang aku bilang... Dia bukan keluarga aku."

#. Character:`nobu` | Attributes:`bad`
msgctxt "warehouse_exterior_f9805b89"
msgid "T'as vraiment un cœur de glace."
msgstr "Kamu bener-bener punya hati yang beku."

#. Character:`kenji`
msgctxt "warehouse_exterior_eb3b3553"
msgid "Peu importe... On n'est pas là pour juger."
msgstr "Gak masalah... Kita gak di sini buat nge-judge."

#. Character:`kenji` | Attributes:`bad`
msgctxt "warehouse_exterior_bef969de"
msgid "Tu veux qu'on lui fasse comme d'habitude ?"
msgstr "Kamu mau kita lakuin dia kayak biasanya?"

#. Character:`narrator`
msgctxt "warehouse_exterior_f97f7f83"
msgid "Comment ça comme d'habitude ? C'est quoi ce bordel ?"
msgstr "Gimana maksudnya kayak biasanya? Ini apaan sih?"

#. Character:`noriko` | Attributes:`shame`
msgctxt "warehouse_exterior_bdaa0a3d"
msgid "Oui mais n'y allez pas trop fort non plus."
msgstr "Iya, tapi jangan kelewat kasar juga."

#. Character:`takeo` | Attributes:`mocking`
msgctxt "warehouse_exterior_d95fc6b9"
msgid "Juste assez pour lui faire passer l'envie de faire le malin."
msgstr "Cuma cukup biar dia kapok buat sok jagoan."

#. Character:`kenji` | Attributes:`bad`
msgctxt "warehouse_exterior_bf0e4134"
msgid "Tu veux lui faire passer un message ?"
msgstr "Kamu mau ngasih dia pesan?"

#. Character:`noriko`
msgctxt "warehouse_exterior_56d13396"
msgid "Non, ça reste entre nous, on ne change rien."
msgstr "Gak, ini rahasia kita aja, gak ada yang berubah."

#. Character:`takeo` | Attributes:`mocking`
msgctxt "warehouse_exterior_ff2ae0b4"
msgid "Ça marche... Par contre... va falloir payer."
msgstr "Oke deh... Tapi... harus bayar dulu ya."

#. Character:`noriko` | Attributes:`angry`
msgctxt "warehouse_exterior_d38a1f91"
msgid "QUOI ?! Il n'a jamais été question de payer pour ça !"
msgstr "APA?! Gak pernah bilang harus bayar buat itu!"

#. Character:`takeo`
msgctxt "warehouse_exterior_a917dd72"
msgid "Les temps changent... Le coût de la vie devient plus difficile même pour des thugs comme nous."
msgstr "Zaman berubah... Biaya hidup makin susah, bahkan buat preman kayak kita."

#. Character:`kenji` | Attributes:`neutral`
msgctxt "warehouse_exterior_8bffad9e"
msgid "Tu as sincèrement cru qu'on ferait ça juste pour tes beaux yeux ?"
msgstr "Serius kamu kira kita bakal ngelakuin ini cuma buat ngebiarin kamu doang?"

#. Character:`noriko` | Attributes:`shame`
msgctxt "warehouse_exterior_13d8606f"
msgid "Mais..."
msgstr "Tapi..."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "warehouse_exterior_c744c7e0"
msgid "Bon très bien... Combien ?"
msgstr "Ya udah deh... Berapa?"

#. Character:`narrator`
msgctxt "warehouse_exterior_4cef0fe1"
msgid "Dites-moi que je rêve... {{noriko.n}}, tu vas pas payer les thugs pour qu'ils me tabassent ?"
msgstr "Katakan aku mimpi... {{noriko.n}}, kamu gak bakal bayar preman buat ngeluarin aku kan?"

#. Character:`nobu` | Attributes:`bad`
msgctxt "warehouse_exterior_40a76c63"
msgid "Tu sais... si jamais un jour t'es à court d'argent, je ne suis pas contre le fait tu paies en nature."
msgstr "Tau gak... kalo suatu hari kamu kehabisan duit, aku gak keberatan kalo kamu bayar dengan cara lain."

#. Character:`noriko` | Attributes:`angry`
msgctxt "warehouse_exterior_37539408"
msgid "Va te faire foutre, plutôt mourir !"
msgstr "Mampus kamu, mending mati aja!"

#. Character:`kenji` | Attributes:`angry`
msgctxt "warehouse_exterior_c923f59b"
msgid "Doucement toi, surveille un peu ton langage, on fait peut-être du business ensemble mais reste polie."
msgstr "Santai dong, jaga omongan kamu, kita mungkin bisnis bareng tapi tetep sopan."

#. Character:`kenji`
msgctxt "warehouse_exterior_495aec04"
msgid "Je me suis bien fait comprendre ?"
msgstr "Aku udah jelas, kan?"

#. Character:`noriko` | Attributes:`shame`
msgctxt "warehouse_exterior_def6e9da"
msgid "...[w] Oui..."
msgstr "...[w] Iya..."

#. Character:`takeo`
msgctxt "warehouse_exterior_c7763037"
msgid "C'est 10000 ou rien..."
msgstr "Itu 10000 atau nggak sama sekali..."

#. Character:`takeo`
msgctxt "warehouse_exterior_1c626065"
msgid "Casse-toi maintenant, je te garantis qu'on va lui tomber dessus et que tu en auras pour ton argent."
msgstr "Mampus sekarang juga, aku jamin kita bakal nyerang dia dan kamu bakal dapet apa yang kamu bayar."

#. Character:`takeo` | Attributes:`neutral`
msgctxt "warehouse_exterior_d168ebf6"
msgid "Bon qui se charge de défoncer l'autre déchet ?"
msgstr "Oke, siapa yang bakal ngeluarin si bangsat itu?"

#. Character:`takeo` | Attributes:`mocking`
msgctxt "warehouse_exterior_57b380ac"
msgid "{{nobu.n}} ?"
msgstr "{{nobu.n}}?"

#. Character:`kenji` | Attributes:`neutral`
msgctxt "warehouse_exterior_ccafd182"
msgid "Laisse tomber, cet incapable ne peut pas le gérer en 1v1."
msgstr "Lupain aja, si nggak becus itu nggak bakal bisa ngelawan 1 lawan 1."

#. Character:`takeo` | Attributes:`angry`
msgctxt "warehouse_exterior_bf49c5ce"
msgid "Putain {{nobu.n}} tu sers à quoi ?"
msgstr "Sialan {{nobu.n}} kamu ngapain sih?"

#. Character:`takeo`
msgctxt "warehouse_exterior_ff83141e"
msgid "Si tu te sors pas les doigts on va se passer de toi à l'avenir."
msgstr "Kalo kamu nggak gerak, kita bakal lepasin kamu ke depannya."

#. Character:`nobu` | Attributes:`angry`
msgctxt "warehouse_exterior_9bf4e4b1"
msgid "T'es un putain d'enfoiré, c'est pas toi qui disais que la famille se serre les coudes en toutes circonstances ?"
msgstr "Kamu emang bajingan banget, bukannya kamu bilang keluarga itu harus saling dukung kapan pun?"

#. Character:`kenji`
msgctxt "warehouse_exterior_5f8940a3"
msgid "Pour le moment t'es pas encore de la famille, t'es juste un foutu parasite."
msgstr "Untuk sekarang kamu belum dianggap keluarga, kamu cuma parasit sialan doang."

#. Character:`takeo`
msgctxt "warehouse_exterior_28e336e9"
msgid "Montre-nous qu'on peut compter sur toi."
msgstr "Buktikan kalo kita bisa ngandelin kamu."

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "warehouse_exterior_4783ecee"
msgid "Okay c'est bon je m'en occupe ! Mais passe-moi la thune alors !"
msgstr "Oke, aku urusin! Tapi kasih aku duitnya dulu dong!"

#. Character:`takeo` | Attributes:`mocking`
msgctxt "warehouse_exterior_2a052980"
msgid "Non tu auras l'argent seulement si tu réussis ton coup."
msgstr "Gak, kamu cuma dapet duitnya kalau berhasil ngelakuin aksinya."

#. Character:`nobu`
msgctxt "warehouse_exterior_96c44689"
msgid "[font_size=14]Putain d'enfoirés...[/font_size]"
msgstr "[font_size=14]Sialan bajingan...[/font_size]"

#. Character:`saito`
msgctxt "warehouse_exterior_ba1150d2"
msgid "Bordel {{noriko.n}} tout ça venait de toi !"
msgstr "Sialan {{noriko.n}} semua ini dari kamu!"

#. Character:`saito`
msgctxt "warehouse_exterior_27d3513f"
msgid "Oh tu vas voir ce que tu vas prendre..."
msgstr "Oh, kamu bakal lihat apa yang bakal kamu dapetin..."

#. Character:`noriko`
msgctxt "warehouse_exterior_b049ccd1"
msgid "... Non mais vous êtes sérieux ?"
msgstr "... Serius nih kamu?"

#. Character:`noriko`
msgctxt "warehouse_exterior_5d748e89"
msgid "C'est ce que vous aviez de mieux ?"
msgstr "Itu yang terbaik yang kalian punya?"

#. Character:`noriko`
msgctxt "warehouse_exterior_17f2e548"
msgid "Cet idiot s'est laminer en un seul coup."
msgstr "Bodohnya itu langsung hancur cuma sekali pukul."

#. Character:`takeo` | Attributes:`disgusted`
msgctxt "warehouse_exterior_0fc484bb"
msgid "... {{nobu.n}} n'est pas le plus fort de nous trois mais ça aurait dû suffire."
msgstr "... {{nobu.n}} bukan yang terkuat dari kita bertiga tapi itu harusnya cukup."

#. Character:`noriko`
msgctxt "warehouse_exterior_271f90c6"
msgid "Rendez-moi mon argent !"
msgstr "Balikin duit aku!"

#. Character:`kenji` | Attributes:`angry`
msgctxt "warehouse_exterior_d236f206"
msgid "Wow wow doucement miss, il n'y a pas de remboursement pour ce genre de choses."
msgstr "Wow, wow, santai, miss, gak ada refund buat hal-hal kayak gini."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "warehouse_exterior_f13c1163"
msgid "Dans ce cas faites votre boulot correctement !"
msgstr "Kalau gitu, kerjain tugas kamu dengan bener!"

#. Character:`takeo` | Attributes:`neutral`
msgctxt "warehouse_exterior_64aff333"
msgid "{{kenji.n}} doit s'en occuper, ce sera plié rapidement."
msgstr "{{kenji.n}} yang urus, bakal kelar cepet kok."

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "warehouse_exterior_be060441"
msgid "Pfff... Quel bande de charlots..."
msgstr "Pfff... Gila, bodoh banget sih mereka..."

#. Character:`kenji`
msgctxt "warehouse_exterior_7d15b81c"
msgid "Elle commence sérieusement à me casser les couilles celle-là..."
msgstr "Dia mulai bener-bener nyebelin aku nih..."

#. Character:`takeo`
msgctxt "warehouse_exterior_803e25cb"
msgid "Oui mais pas touche pour le moment."
msgstr "Iya, tapi jangan diapa-apain dulu."

#. Character:`takeo`
msgctxt "warehouse_exterior_a973ff60"
msgid "{{akira.n}} semble avoir un lien avec elle et j'ai pas envie d'avoir à gérer un second psychopathe."
msgstr "{{akira.n}} kayaknya ada hubungannya sama dia dan aku nggak mau ribet ngurusin psikopat kedua."

#. Character:`kenji` | Attributes:`neutral`
msgctxt "warehouse_exterior_df0a156f"
msgid "C'est pas faux..."
msgstr "Bener juga sih..."

#. Character:`kenji`
msgctxt "warehouse_exterior_cac219f9"
msgid "Bon... Je vais lui refaire le portrait et je reviens."
msgstr "Oke... Aku bakal bikin dia kapok, ntar aku balik lagi."

#. Character:`takeo` | Attributes:`mocking`
msgctxt "warehouse_exterior_4e3c2cc6"
msgid "Fume-le !"
msgstr "Tembak dia!"

#. Character:`saito`
msgctxt "warehouse_exterior_790a33f2"
msgid "Toujours rien ?"
msgstr "Masih belum ada kabar?"

#. Character:`asami`
msgctxt "warehouse_exterior_e20225e1"
msgid "Non, il n'est pas non plus à l'intérieur."
msgstr "Nggak, dia juga nggak ada di dalam."

#. Character:`asami`
msgctxt "warehouse_exterior_08cb7d31"
msgid "Il y a personne ici."
msgstr "Gak ada orang di sini."

#. Character:`kimochi`
msgctxt "warehouse_exterior_5a821bff"
msgid "Personne en centre-ville non plus..."
msgstr "Gak ada orang di pusat kota juga..."

#. Character:`asami`
msgctxt "warehouse_exterior_48195058"
msgid "On devrait retourner auprès de {{noriko.n}}. Ce n'est plus comme si on avait trop le choix."
msgstr "Kita harus balik ke {{noriko.n}}. Kita udah nggak punya banyak pilihan lagi."

#. Character:`saito`
msgctxt "warehouse_exterior_c1e5a46e"
msgid "... Je voulais gérer ça discrètement mais je crois que tu as raison."
msgstr "... Aku pengen ngurus ini diam-diam tapi kayaknya kamu benar."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "warehouse_exterior_e469d7fc"
msgid "On n'a pas encore été voir au canal !"
msgstr "Kita belum cek di kanal!"

#. Character:`asami` | Attributes:`surprised`
msgctxt "warehouse_exterior_dd021dfd"
msgid "Mais c'est à l'autre bout de la ville !"
msgstr "Tapi itu di ujung kota yang lain!"

#. Character:`kimochi`
msgctxt "warehouse_exterior_207914dd"
msgid "Oui mais ça reste un endroit qu'il fréquente souvent..."
msgstr "Iya, tapi itu tempat yang sering dia datengin..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "warehouse_exterior_7aad5c79"
msgid "Comment tu le sais ?"
msgstr "Gimana kamu tau?"

#. Character:`kimochi`
msgctxt "warehouse_exterior_96d4bad2"
msgid "C'est l'un des endroits les plus tranquilles que je connaisse après ici."
msgstr "Itu salah satu tempat paling tenang yang aku tau setelah sini."

#. Character:`kimochi`
msgctxt "warehouse_exterior_791dcc5e"
msgid "Et puis il traîne régulièrement là-bas."
msgstr "Terus dia sering nongkrong di sana juga."

#. Character:`saito`
msgctxt "warehouse_exterior_31e12a1a"
msgid "Okay essayons ça..."
msgstr "Oke, coba deh..."

#. Character:`saito`
msgctxt "warehouse_exterior_09c43b81"
msgid "Après nous rentrerons et surveillerons {{noriko.n}}."
msgstr "Abis itu kita pulang dan awasin {{noriko.n}}."

#. Character:`asami` | Attributes:`sad`
msgctxt "warehouse_exterior_8cb4c195"
msgid "Je ne pourrai pas vous accompagner par contre."
msgstr "Aku nggak bisa nemenin kalian sih."

#. Character:`asami`
msgctxt "warehouse_exterior_b9f2c580"
msgid "Ma mère m'a demandée de rentrer plus tôt ce soir."
msgstr "Ibu minta aku pulang lebih cepet malam ini."

#. Character:`asami`
msgctxt "warehouse_exterior_dbfd29fd"
msgid "Si tu as du nouveau préviens-moi, j'ai besoin de savoir si cette histoire avec {{noriko.n}} s'est arrangée ou pas."
msgstr "Kalau ada kabar baru, kasih tau ya, aku perlu tau apa masalah sama {{noriko.n}} udah kelar atau belum."

#. Character:`saito` | Attributes:`happy`
msgctxt "warehouse_exterior_05113d15"
msgid "Je te tiendrai informée, c'est promis."
msgstr "Aku bakal kabarin, janji deh."

#. Character:`natsume` | Attributes:`afraid`
msgctxt "tecd1b08cab"
msgid "Ce type me fout les jetons !"
msgstr "Cowok itu bikin aku ngeri!"

#. Character:`natsume`
msgctxt "ta8cd2d5151"
msgid "Tu comptes travailler avec lui encore longtemps ?"
msgstr "Kamu mau kerja bareng dia lama-lama gitu?"

#. Character:`minato`
msgctxt "t774ce11009"
msgid "C'est plutôt rare de te voir aussi sur tes gardes avec quelqu'un, il y a quelque chose chez lui qui ne te plait pas ?"
msgstr "Jarang banget liat kamu waspada banget sama orang, ada apa ya sama dia yang bikin kamu nggak suka?"

#. Character:`natsume` | Attributes:`neutral`
msgctxt "t5823db9768"
msgid "Mon instinct ne me trompe jamais."
msgstr "Insting aku nggak pernah salah."

#. Character:`minato`
msgctxt "tb7abf8a635"
msgid "Pourtant ton instinct ne t'a pas dit de te méfier de moi..."
msgstr "Tapi insting kamu nggak bilang buat waspada sama aku..."

#. Character:`natsume`
msgctxt "tb439a47d02"
msgid "Il faut toujours une exception pour confirmer la règle."
msgstr "Selalu ada pengecualian buat ngegampangin aturan."

#. Character:`minato` | Attributes:`upset`
msgctxt "t254f7b73d6"
msgid "Bref, garde ton avis pour ceux que ça intéresse."
msgstr "Pokoknya, simpen pendapat kamu buat yang peduli aja."

#. Character:`minato`
msgctxt "tca2cc3c4fa"
msgid "Ce type aussi rebutant soit il, est efficace."
msgstr "Orang itu, meskipun ngeselin, dia efektif."

#. Character:`minato`
msgctxt "tf97d0c51ad"
msgid "Ne jamais gâcher une bonne ressource potentielle."
msgstr "Jangan pernah nyia-nyiain sumber daya potensial yang bagus."

#. Character:`minato` | Attributes:`happy`
msgctxt "tcb8fe05c0f"
msgid "Tant qu'il reste fiable et obéissant, je travaillerai avec lui autant de temps que nécessaire."
msgstr "Selama dia bisa diandalin dan nurut, aku bakal kerja sama dia selama yang dibutuhin."

#. Character:`minato`
msgctxt "t58b7dfbf04"
msgid "Il se rendra vite compte que travailler pour moi lui apportera des opportunités qu'il n'aurait jamais pu rencontrer en temps normal."
msgstr "Dia bakal cepet nyadar kalau kerja sama aku bakal ngasih kesempatan yang nggak bakal dia dapetin biasanya."

#. Character:`natsume` | Attributes:`shame`
msgctxt "t8c34b43550"
msgid "Tu joues toujours à des jeux dangereux..."
msgstr "Kamu emang suka main-main di bahaya terus..."

#. Character:`minato` | Attributes:`neutral`
msgctxt "tf293c60cd9"
msgid "Fais attention à toi {{natsume.n}}, si cet odieux bâtard performe mieux que toi, tu risquerais de perdre ta place de privilégiée."
msgstr "Hati-hati ya {{natsume.n}}, kalo bajingan busuk itu perform lebih baik dari kamu, bisa-bisa kamu kehilangan posisi spesial kamu."

#. Character:`natsume` | Attributes:`sad`
msgctxt "t5f74ae7a1f"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "C_EST_ICI_E78BAC"
msgid "C'est ici ?"
msgstr "Ini di sini?"

#. Character:`sakuya`
msgctxt "OUI_TOUTEFOIS_JE_DOIS_T_AVERTI_CD4883"
msgid "Oui... Toutefois, je dois t'avertir qu'il n'a pas été très coopératif."
msgstr "Iya... Tapi, aku harus kasih tau kamu, dia nggak terlalu kooperatif."

#. Character:`saito` | Attributes:`sad`
msgctxt "OUI_JE_ME_DOUTE_TU_N_AS_RIEN_I_37C56E"
msgid "Oui, je me doute... Tu n'as rien ? Il ne t'a pas fait de mal ?"
msgstr "Iya, aku curiga... Kamu nggak apa-apa? Dia nggak nyakitin kamu kan?"

#. Character:`sakuya` | Attributes:`happy,blush`
msgctxt "OH_TU_T_INQUI_TES_POUR_MOI_MON_AE01DC"
msgid "Oh, tu t'inquiètes pour moi, mon amour ?"
msgstr "Oh, kamu khawatir sama aku, sayang?"

#. Character:`saito` | Attributes:`happy`
msgctxt "BIEN_S_R_86E137"
msgid "Bien sûr !"
msgstr "Tentu aja!"

#. Character:`sakuya`
msgctxt "QUELQU_UN_COMME_LUI_N_EST_PAS_4DFDE5"
msgid "Quelqu'un comme lui n'est pas en mesure de me faire quoi que ce soit..."
msgstr "Orang kayak dia nggak bakal bisa ngapa-ngapain aku..."

#. Character:`sakuya`
msgctxt "NE_SOIS_JUSTE_PAS_TONN_QUAND_T_4CB1D4"
msgid "Ne sois juste pas étonné quand tu le verras."
msgstr "Jangan kaget pas kamu liat dia nanti."

#. Character:`sakuya`
msgctxt "J_AI_D_L_ATTACHER_FERMEMENT_PO_4554D7"
msgid "J'ai dû l'attacher fermement pour ne pas qu'il s'échappe."
msgstr "Aku harus ngiket dia erat-erat supaya dia nggak kabur."

#. Character:`saito`
msgctxt "HONN_TEMENT_JE_ME_MOQUE_BIEN_D_113C1F"
msgid "Honnêtement, je me moque bien de ce qu'il peut lui arriver, ce type ne mérite aucune pitié."
msgstr "Jujur aja, aku nggak peduli apa yang terjadi sama dia, bocah itu nggak pantas dapet belas kasihan."

#. Character:`sakuya`
msgctxt "C_EST_BON_SAVOIR_63DF1E"
msgid "C'est bon à savoir..."
msgstr "Bagus juga buat diketahui..."

#. Character:`sakuya`
msgctxt "LAISSE_MOI_FAIRE_MON_AMOUR_DA1991"
msgid "Laisse-moi faire, mon amour."
msgstr "Biarin aja aku yang urus, sayang."

#. Character:`akira`
msgctxt "FONT_SIZE_14_LOIGNE_CETTE_FOL_1635C2"
msgid "[font_size=14]Éloigne cette folle de moi, je ne dirai rien de toute façon.[/font_size]"
msgstr "[font_size=14]Jauh-jauhin si gila itu dari aku, aku nggak bakal ngomong apa-apa juga.[/font_size]"

#. Character:`sakuya`
msgctxt "JE_TE_GARANTIS_QUE_DEMAIN_MATI_6AD134"
msgid "Je te garantis que demain matin il sera prêt à discuter."
msgstr "Aku jamin besok pagi dia bakal siap buat ngomong."

#. Character:`sakuya`
msgctxt "J_AI_JUSTE_BESOIN_DE_SAVOIR_JU_6BDE80"
msgid "J'ai juste besoin de savoir jusqu'où je peux aller avec lui ?"
msgstr "Aku cuma perlu tahu sejauh mana aku bisa pergi sama dia?"

#. Character:`saito` | Attributes:`upset`
msgctxt "FAIS_TOUT_CE_QUI_TE_SEMBLE_N_C_9C3494"
msgid "Fais tout ce qui te semble nécessaire."
msgstr "Lakuin aja apa yang menurut kamu perlu."

#. Character:`saito`
msgctxt "JE_ME_MOQUE_COMPL_TEMENT_DE_CE_90A96A"
msgid "Je me moque complètement de ce qu'il peut lui arriver."
msgstr "Aku sama sekali nggak peduli apa yang bakal kejadian sama dia."

#. Character:`sakuya`
msgctxt "A_VA_ME_FACILITER_LES_CHOSES_66662B"
msgid "Ça va me faciliter les choses."
msgstr "Ini bakal bikin semuanya jadi lebih gampang buat aku."

#. Character:`sakuya`
msgctxt "VA_DORMIR_MON_AMOUR_JE_M_OCCUP_A67107"
msgid "Va dormir, mon amour, je m'occupe de tout."
msgstr "Tidur aja, sayang, aku yang urus semuanya."

#. Character:`sakuya`
msgctxt "ET_MAINTENANT_3C7C19"
msgid "Et maintenant ?"
msgstr "Terus sekarang gimana?"

#. Character:`saito`
msgctxt "A_FAIT_BEAUCOUP_D_INFOS_JE_DO_5F4612"
msgid "Ça fait beaucoup d'infos, je dois faire le point avec {{kimochi.n}} et {{noriko.n}}."
msgstr "Banyak banget info-nya, aku harus ngobrol dulu sama {{kimochi.n}} dan {{noriko.n}}."

#. Character:`saito` | Attributes:`happy`
msgctxt "VIENS_AVEC_NOUS_A59CB6"
msgid "Viens avec nous !"
msgstr "Ikut sama kita!"

#. Character:`sakuya` | Attributes:`happy,blush`
msgctxt "AVEC_PLAISIR_MON_AMOUR_MAIS_QU_6C0E43"
msgid "Avec plaisir, mon amour, mais que dois-je faire de lui ?"
msgstr "Dengan senang hati, sayang, tapi aku harus ngapain sama dia?"

#. Character:`akira`
msgctxt "FONT_SIZE_14_LAISSEZ_MOI_PART_11EE17"
msgid "[font_size=14]LAISSEZ-MOI PARTIR ! PUTAIN !!![/font_size]"
msgstr "[font_size=14]BIARIN AKU CABUT! SIALAN!!![/font_size]"

#. Character:`sakuya`
msgctxt "DOIS_JE_M_EN_D_BARRASSER_D_FIN_135ABE"
msgid "Dois-je m'en débarrasser définitivement ?"
msgstr "Haruskah aku ngilangin dia selamanya?"

#. Character:`saito` | Attributes:`sad`
msgctxt "JE_LE_REGRETTERAI_S_REMENT_UN_8078D3"
msgid "... Je le regretterai sûrement un jour, mais il a déjà été puni en consommant sa propre drogue. Et puis maintenant qu'il a parlé, il ne peut plus rester ici, il est obligé de vivre caché."
msgstr "... Aku pasti bakal nyesel suatu hari nanti, tapi dia udah dihukum dengan ngehisap narkobanya sendiri. Terus sekarang dia udah ngomong, dia gak bisa lagi tinggal di sini, dia harus hidup sembunyi-sembunyi."

#. Character:`sakuya` | Attributes:`neutral`
msgctxt "TR_S_BIEN_JE_FERAI_COMME_TU_VO_AF75A0"
msgid "Très bien, je ferai comme tu voudras."
msgstr "Oke, aku bakal ngelakuin sesuai yang kamu mau."

#. Character:`narrator`
msgctxt "JE_DOIS_RESTER_DISCRET_LE_TEMP_A1BED7"
msgid "Je dois rester discret le temps de trouver une solution."
msgstr "Aku harus jaga-jaga dulu sambil nyari solusi."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_2d6a3cc2"
msgid "Bien, je crois que je suis arrivé avant lui."
msgstr "Sip, kayaknya aku nyampe duluan sebelum dia."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_127c0a59"
msgid "Si je me planque derrière cet escalier, je pourrai savoir dans quel appartement il vit."
msgstr "Kalo aku ngumpet di belakang tangga ini, aku bisa tau dia tinggal di apartemen mana."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_0491ee34"
msgid "Vite, je crois qu'il arrive."
msgstr "Cepet, kayaknya dia udah dateng."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_2ed5959a"
msgid "Enfin ! Je l'ai enfin semé."
msgstr "Akhirnya! Aku akhirnya berhasil ngacir dari dia."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_0f888b67"
msgid "J'en peux plus."
msgstr "Aku udah nggak kuat lagi."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_kimochi_exterior_a438fbf2"
msgid "Je vais devoir y retourner, encore un peu et {{chiaki.n}} sera à m-"
msgstr "Aku harus balik lagi, bentar lagi {{chiaki.n}} bakal ada di m-"

#. Character:`saito`
msgctxt "t7cbb45cd4f"
msgid "Je vais devoir mettre un terme à tes projets."
msgstr "Aku harus ngehentikan rencana kamu."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_kimochi_exterior_9d4f7911"
msgid "Waaah, tu sors d'où comme ça, foutu stalker."
msgstr "Waaah, kamu muncul dari mana gitu aja, stalker sialan."

#. Character:`saito`
msgctxt "home_kimochi_exterior_01be32e4"
msgid "Venant de toi, je ne sais pas comment je dois le prendre."
msgstr "Dari kamu sih, aku nggak tahu harus gimana nerimanya."

#. Character:`saito`
msgctxt "home_kimochi_exterior_058c937b"
msgid "Tu ne peux pas continuer comme ça."
msgstr "Kamu nggak bisa terus-terusan kayak gitu."

#. Character:`saito`
msgctxt "home_kimochi_exterior_af281b8c"
msgid "Tu ne peux pas t'amuser à faire le stalker sans conséquence."
msgstr "Kamu nggak bisa main-main jadi stalker tanpa konsekuensi."

#. Character:`saito`
msgctxt "home_kimochi_exterior_bdcf78b1"
msgid "Je te conseille d'arrêter tout de suite avant que je ne contacte la police."
msgstr "Saran aku, mending berhenti sekarang juga sebelum aku laporin polisi."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_exterior_7639bcca"
msgid "..."
msgstr "..."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_971093c5"
msgid "Tu crois que c'est facile ?"
msgstr "Kamu kira ini gampang?"

#. Character:`saito`
msgctxt "home_kimochi_exterior_280743fc"
msgid "Quoi donc ?"
msgstr "Kenapa gitu?"

#. Character:`kimochi` | Attributes:`-sad`
msgctxt "home_kimochi_exterior_bbc669bd"
msgid "Je ne fais pas ça pour le plaisir..."
msgstr "Aku nggak ngelakuin ini buat seneng-seneng..."

#. Character:`saito`
msgctxt "home_kimochi_exterior_112359f1"
msgid "Quoi, tu vas prétendre une maladie imaginaire qui te pousse à faire ça ?"
msgstr "Apa, kamu bakal pura-pura sakit yang bikin kamu ngelakuin ini?"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_exterior_e8340db0"
msgid "Quoi ? Non, tu me prends pour qui ?"
msgstr "Apa? Nggak, kamu kira aku siapa?"

#. Character:`saito`
msgctxt "home_kimochi_exterior_6c8b3e93"
msgid "Un pervers, un stalker, un fou, choisis celui que tu veux."
msgstr "Pecah, stalker, gila, pilih aja yang mana."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_79e28736"
msgid "Hey ho !"
msgstr "Hei ho!"

#. Character:`saito`
msgctxt "home_kimochi_exterior_9e4215ed"
msgid "Dépêche-toi de prendre une décision, {{minato.n}} ne va pas tarder et je pense qu'il ne sera pas aussi gentil que moi."
msgstr "Cepetin buat mutusin, {{minato.n}} bakal dateng dan aku rasa dia nggak bakal sebaik aku."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_kimochi_exterior_8fec7da5"
msgid "Merde tu n'aurais jamais dû faire ça..."
msgstr "Sialan, kamu nggak seharusnya ngelakuin itu..."

#. Character:`saito`
msgctxt "home_kimochi_exterior_6cfac831"
msgid "Ce n'est pas moi qui fais le stalker."
msgstr "Bukan aku yang jadi stalker."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_b40c7144"
msgid "Tu ne comprends pas !"
msgstr "Kamu nggak ngerti!"

#. Character:`saito`
msgctxt "home_kimochi_exterior_094b6b74"
msgid "Qu'est-ce que je dois comprendre ?"
msgstr "Aku harus ngerti apa nih?"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_exterior_96cb08f6"
msgid "{{minato.n}} n'est pas ce qu'il prétend être."
msgstr "{{minato.n}} nggak seperti yang dia bilang."

#. Character:`saito`
msgctxt "teafa83b487"
msgid "C'est la seconde fois que tu me le dis..."
msgstr "Ini udah kedua kali kamu ngomong gitu ke aku..."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_260b25df"
msgid "Je ne suis pas le seul à penser que quelque chose cloche."
msgstr "Aku bukan satu-satunya yang ngerasa ada yang nggak beres."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_exterior_14a97d90"
msgid "Est-ce que tu as des preuves ?"
msgstr "Kamu punya bukti nggak?"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_dbd8fa22"
msgid "Malheureusement non, seulement la détresse dans ses yeux."
msgstr "Sayangnya nggak, cuma lihat kesedihan di matanya aja."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_da91b93a"
msgid "S'il te plait, mon seul but, c'est de la protéger de ce monstre."
msgstr "Tolong, tujuan aku cuma pengen ngejaga dia dari monster itu."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_5e6e62f4"
msgid "S'il me trouve, je suis fini !"
msgstr "Kalau dia nemuin aku, aku beres!"

#. Character:`saito`
msgctxt "home_kimochi_exterior_5ed92da2"
msgid "...[w] D'accord, planque-toi vite !"
msgstr "...[w] Oke, sembunyi cepet!"

#. Character:`minato`
msgctxt "home_kimochi_exterior_6104ba68"
msgid "IL EST OÙ CE BÂTARD ?"
msgstr "DI MANA SI BABI ITU?"

#. Character:`minato`
msgctxt "home_kimochi_exterior_7038caf8"
msgid "DANS QUEL APPARTEMENT ?!"
msgstr "DI APARTEMEN YANG MANA?!"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_exterior_a3a313b3"
msgid "Je ne sais plus, je suis passé par la voie ferrée pour espérer le bloquer, mais il a continué sa route en direction du quartier industriel."
msgstr "Aku lupa, aku lewat rel kereta buat nyoba ngehalangin dia, tapi dia tetep lanjut ke arah kawasan industri."

#. Character:`minato` | Attributes:`suspicious`
msgctxt "home_kimochi_exterior_0ddd3e6f"
msgid "Et tu attends quoi pour le suivre ?"
msgstr "Terus kamu nunggu apa buat ngejar dia?"

#. Character:`saito`
msgctxt "home_kimochi_exterior_3f098b8d"
msgid "Je... J'avais un point de côté et je l'ai perdu de vue."
msgstr "Aku... tadi kena sakit di samping perut dan aku kehilangan jejaknya."

#. Character:`saito`
msgctxt "home_kimochi_exterior_2bf1a90c"
msgid "Déso-"
msgstr "Maaf ya-"

#. Character:`minato` | Attributes:`angry`
msgctxt "home_kimochi_exterior_d757a1cb"
msgid "Putain, tu sers vraiment à rien !"
msgstr "Sialan, kamu bener-bener nggak guna!"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_8d2b8b61"
msgid "Merci !"
msgstr "Makasih!"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_exterior_ea697831"
msgid "Je ne l'ai pas fait pour toi."
msgstr "Aku nggak ngelakuinnya buat kamu."

#. Character:`saito`
msgctxt "home_kimochi_exterior_c8698086"
msgid "Quelque chose me gêne dans l'attitude de {{minato.n}}, je ne le reconnais plus."
msgstr "Ada yang aneh dari sikap {{minato.n}}, aku nggak ngenalin dia lagi."

#. Character:`saito`
msgctxt "home_kimochi_exterior_00f2ab18"
msgid "Je ne te fais toujours pas confiance."
msgstr "Aku masih nggak percaya sama kamu."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_exterior_66a4f78c"
msgid "Mais... et {{chiaki.n}} ?"
msgstr "Tapi... gimana sama {{chiaki.n}}?"

#. Character:`saito`
msgctxt "home_kimochi_exterior_6673da62"
msgid "Si tu retournes là-bas, il te tombera dessus."
msgstr "Kalau kamu balik ke sana, dia bakal nyerang kamu."

#. Character:`saito` | Attributes:`-upset`
msgctxt "home_kimochi_exterior_45b06fe7"
msgid "Je te promets d'essayer de trouver une solution."
msgstr "Aku janji bakal coba cari solusi."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_0c6cc7c8"
msgid "...Okay, mais fais vite."
msgstr "...Oke, tapi cepet ya."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_e8b69145"
msgid "Toute cette histoire sent mauvais."
msgstr "Semua cerita ini berbau nggak enak."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_a271a195"
msgid "Pour tirer un trait sur tout ça, je vais devoir me retrouver seul avec {{chiaki.n}}."
msgstr "Buat nutup semua ini, aku harus sendirian sama {{chiaki.n}}."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_caf0a714"
msgid "Et quelque chose me dit que ça va être compliqué."
msgstr "Dan ada firasat ini bakal ribet banget."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_d59a8bb4"
msgid "Bref, il est tard, je ferais mieux de rentrer."
msgstr "Pokoknya, udah malem, mendingan aku pulang deh."

#. Character:`nobu`
msgctxt "home_kimochi_exterior_143ec67b"
msgid "TU N'IRAS PAS PLUS LOIN !"
msgstr "AKU GAK BAKAL BIAR KAMU MAJU LAGI!"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_75622339"
msgid "[font_size=14]Allez {{saito.n}} revient, je déconnais...[/font_size]"
msgstr "[font_size=14]Ayo {{saito.n}} balik, aku cuma becanda...[/font_size]"

#. Character:`saito`
msgctxt "home_kimochi_exterior_2d74e29a"
msgid "Quel enfoiré !"
msgstr "Dasar bajingan!"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_exterior_df8d7c0a"
msgid "Je ferais mieux d'aller bosser, ça me changera les idées."
msgstr "Mending aku kerja dulu deh, biar pikiran aku bisa berubah."

#. Character:`saito`
msgctxt "home_kimochi_exterior_03775ec8_1"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "home_kimochi_exterior_a6ecb8b1"
msgid "Je ne sais pas ce qui se trouve sur cette clef USB, mais si le contenu peut me mener droit en prison..."
msgstr "Aku gak tau isi flashdisk ini apa, tapi kalo isinya bisa bikin aku langsung masuk penjara..."

#. Character:`saito`
msgctxt "home_kimochi_exterior_b02e37fe"
msgid "Je suis partagé entre la curiosité et l'effroi."
msgstr "Aku campur aduk antara penasaran sama takut."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_kimochi_exterior_5e490ec1"
msgid "...[w] Non, c'est pour {{macumba.n}}, c'est quelqu'un de foncièrement bon, ça ne peut pas être si terrible que ça."
msgstr "...[w] Nggak, itu buat {{macumba.n}}, dia orang baik banget, gak mungkin seserem itu."

#. Character:`saito`
msgctxt "home_kimochi_exterior_0042be29"
msgid "{{kimochi.n}}, t'es là ?"
msgstr "{{kimochi.n}}, kamu di sana?"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_5bbe1271"
msgid "[font_size=14]Oh bordel, {{saito.n}} qui frappe avant d'entrer ![/font_size]"
msgstr "[font_size=14]Sialan, {{saito.n}} ketuk pintu dulu sebelum masuk![/font_size]"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_d5021639"
msgid "[font_size=14]Entre ![/font_size]"
msgstr "[font_size=14]Masuk![/font_size]"

#. Character:`saito` | Attributes:`angry`
msgctxt "home_kimochi_exterior_f991ad51"
msgid "BORDEL {{kimochi.n}} !"
msgstr "SIALAN {{kimochi.n}}!"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_exterior_fdb76c45"
msgid "Pourquoi tu m'en veux autant ?!"
msgstr "Kenapa kamu benci aku banget sih?!"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_79e67898"
msgid "[font_size=14]Je n'adresse pas la parole aux gens qui essaient de se faire leur harem ![/font_size]"
msgstr "[font_size=14]Aku gak ngomong sama orang yang nyoba bikin harem sendiri![/font_size]"

#. Character:`saito`
msgctxt "home_kimochi_exterior_26666cbb"
msgid "Mais je ne veux pas me faire un harem justement !"
msgstr "Tapi aku nggak mau bikin harem justru!"

#. Character:`saito` | Attributes:`sad`
msgctxt "JE_VEUX_QU_ELLE_ME_LAISSE_TRAN_BB250B"
msgid "Je veux qu'elle me laisse tranquille !"
msgstr "Aku pengen dia ninggalin aku sendiri!"

#. Character:`saito`
msgctxt "MOI_ET_TOUTES_CELLES_QUI_JE_TI_789DAE"
msgid "Moi et toutes celles à qui je tiens."
msgstr "Aku sama semua cewek yang aku sayang."

#. Character:`kimochi`
msgctxt "FONT_SIZE_14_A_C_EST_PAS_POSS_194A3D"
msgid "[font_size=14]Ça c'est pas possible, tu t'es fait rattraper par le karma, maintenant faut assumer.[/font_size]"
msgstr "[font_size=14]Itu nggak mungkin, kamu ketangkep karma, sekarang ya harus tanggung jawab.[/font_size]"

#. Character:`saito`
msgctxt "S_IL_TE_PLA_T_J_AI_BESOIN_D_UN_3CF751"
msgid "S'il te plaît, j'ai besoin d'une idée brillante."
msgstr "Tolong, aku butuh ide brilian nih."

#. Character:`kimochi`
msgctxt "FONT_SIZE_14_TU_VEUX_UNE_ID_E_0FD012"
msgid "[font_size=14]Tu veux une idée brillante ? Très bien, mais je te préviens ça va pas te plaire.[/font_size]"
msgstr "[font_size=14]Kamu mau ide brilian? Oke, tapi aku kasih tau dulu, kamu nggak bakal suka.[/font_size]"

#. Character:`saito` | Attributes:`upset`
msgctxt "PEU_IMPORTE_JE_DOIS_SAVOIR_3BF43D"
msgid "Peu importe, je dois savoir !"
msgstr "Nggak peduli, aku harus tau!"

#. Character:`saito`
msgctxt "home_kimochi_exterior_3afa4b77"
msgid "Je cherche à me débarrasser de cette folle !"
msgstr "Aku nyari cara buat ngusir si gila itu!"

#. Character:`saito`
msgctxt "home_kimochi_exterior_b45bfad9"
msgid "Je ne veux pas passer ma vie avec une personne que j'ai pas choisie !"
msgstr "Aku nggak mau ngejalani hidup sama orang yang nggak aku pilih!"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_1adf14f8"
msgid "..."
msgstr "..."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_bd9eec60"
msgid "[font_size=14]Ce sont tes actions irréfléchies qui t'ont entraîné là-dedans ![/font_size]"
msgstr "[font_size=14]Itu semua gara-gara tindakan gegabah kamu yang bawa kamu ke sini![/font_size]"

#. Character:`saito`
msgctxt "home_kimochi_exterior_257d9e72"
msgid "Je sais..."
msgstr "Aku tau..."

#. Character:`saito`
msgctxt "home_kimochi_exterior_e3bf3f29"
msgid "J'ai agi comme un idiot en pensant que je pouvais faire ce que je voulais."
msgstr "Aku udah berperilaku kayak idiot karena mikir bisa ngelakuin apa aja sesuka aku."

#. Character:`saito`
msgctxt "home_kimochi_exterior_7ab189dc"
msgid "Mais j'ai jamais pensé aux conséquences..."
msgstr "Tapi aku nggak pernah mikirin akibatnya..."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_e35c200f"
msgid "[font_size=14]Il y a moment où tu seras bien obligé d'en choisir une...[/font_size]"
msgstr "[font_size=14]Ada saatnya kamu harus milih salah satu...[/font_size]"

#. Character:`saito`
msgctxt "home_kimochi_exterior_51975987"
msgid "Je sais... mais j'ai besoin de temps."
msgstr "Aku tau... tapi aku butuh waktu."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_0ce14179"
msgid "A force d'être gentil avec toutes les filles que tu croises tu renvois un mauvais signal."
msgstr "Kalau kamu terus-terusan baik sama semua cewek yang kamu temui, itu ngasih sinyal yang salah."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_106f691b"
msgid "J'ai l'impression que c'est la premiere fois que tu te retrouve avec autant d'attention."
msgstr "Kayaknya ini pertama kalinya kamu dapet perhatian sebanyak ini."

#. Character:`saito`
msgctxt "home_kimochi_exterior_c1221fe2"
msgid "C'est possible..."
msgstr "Bisa aja sih..."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_b2a52ef6"
msgid "C'est pas sans conséquences... Tu ne peux pas laisser les gens en attente comme ça."
msgstr "Ini nggak tanpa konsekuensi... Kamu nggak bisa ninggalin orang-orang nunggu gitu aja."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_a5efdba8"
msgid "Parfois il est préférable de dire qu'on est pas intéressé, même si ça fait mal, tu leur rend service."
msgstr "Kadang mending bilang nggak tertarik, walau nyakitin, itu malah bantu mereka."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_2a7fb1e0"
msgid "Personne n'a envie de rester éternellement dans la friendzone."
msgstr "Gak ada yang mau selamanya terjebak di friendzone."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_4f26d386"
msgid "A moins d'être masochiste."
msgstr "Kecuali kamu masokis."

#. Character:`saito`
msgctxt "home_kimochi_exterior_7cd71a94"
msgid "Je sais... Tu as raison."
msgstr "Aku tau... Kamu bener."

#. Character:`narrator`
msgctxt "BON_COURAGE_12088F"
msgid "Bon... Courage !"
msgstr "Oke... Semangat ya!"

#. Character:`narrator`
msgctxt "JE_SUIS_CERTAIN_QU_ELLE_COMPRE_38D313"
msgid "Je suis certain qu’elle comprendra."
msgstr "Aku yakin dia bakal ngerti."

#. Character:`narrator`
msgctxt "SAKUYA_N_EST_INTELLIGENTE_ELL_B66F5F"
msgid "{{sakuya.n}} est intelligente, elle saura se montrer raisonnable."
msgstr "{{sakuya.n}} pinter, dia pasti bakal bisa mikir rasional."

#. Character:`narrator`
msgctxt "ET_NOUS_POURRONS_M_ME_RESTER_A_709CBB"
msgid "Et nous pourrons même rester amis."
msgstr "Dan kita bahkan masih bisa jadi temen."

#. Character:`narrator`
msgctxt "JE_SUIS_S_R_QUE_C_EST_JUSTE_UN_C730B5"
msgid "Je suis sûr que c’est juste une fille qui a du mal à gérer sa frustration."
msgstr "Aku yakin sih dia cuma cewek yang susah ngatur frustrasinya."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_f89cfa7d"
msgid "Bon... Les préparatifs sont terminés."
msgstr "Oke... Persiapan udah kelar."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_0110616b"
msgid "Ça fait du bien pour une fois d'avoir un coup d'avance."
msgstr "Enak juga buat sekali-kali punya keunggulan."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_bb415418"
msgid "Par contre... devoir rejeter {{asami.n}} et {{yasuka.n}}... Ça me fend le cœur."
msgstr "Tapi... harus nolak {{asami.n}} dan {{yasuka.n}}... Bikin aku sakit hati banget."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_3c3fec30"
msgid "Même temporairement..."
msgstr "Walaupun cuma sementara..."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_1dfcf31e"
msgid "Mais si je ne le fais pas... Tout ça va se transformer en un fait divers."
msgstr "Tapi kalau aku nggak lakuin... Semua ini bakal jadi berita gosip doang."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_2e20c3d3"
msgid "Et si je m'autorisais vite fait un petit détour."
msgstr "Dan kalau aku cepet-cepet nyempetin buat muter dikit."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_5986d376"
msgid "Avec un peu de chance, je croiserais peut-être {{chiaki.n}}."
msgstr "Semoga aja aku ketemu {{chiaki.n}}."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_4e661424"
msgid "Et avec encore plus de chance, elle acceptera de me suivre, car je ne suis pas du tout un type louche."
msgstr "Dan kalau beruntung banget, dia bakal mau ikut aku, soalnya aku sama sekali nggak mencurigakan."

#. Character:`saito`
msgctxt "t9fa98a6d83"
msgid "Il est tard, je reviendrai le voir demain."
msgstr "Udah malem, aku bakal balik lagi besok buat ketemu dia."

#. Character:`saito`
msgctxt "home_kimochi_exterior_8d00d0e9"
msgid "{{kimochi.n}} ?"
msgstr "{{kimochi.n}}?"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_2541e7b4"
msgid "[font_size=14]{{saito.n}} ! Mais ne reste pas dehors, entre mon ami, entre ![/font_size]"
msgstr "[font_size=14]{{saito.n}}! Tapi jangan di luar, masuk dong temanku, masuk![/font_size]"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_exterior_67b67686"
msgid "C'est suspect ça..."
msgstr "Ini mencurigakan..."

#. Character:`saito`
msgctxt "home_kimochi_exterior_0d685cb3"
msgid "Merde... {{kimochi.n}} avait raison."
msgstr "Sial... {{kimochi.n}} bener."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_5e1cc29e"
msgid "Alors ?"
msgstr "Jadi gimana?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_exterior_05827ffa"
msgid "C'est même pire que tout..."
msgstr "Ini malah lebih parah dari semuanya..."

#. Character:`saito`
msgctxt "home_kimochi_exterior_4b698217"
msgid "C'est {{minato.n}} qui les a pistonnés pour entrer au dojo."
msgstr "Itu {{minato.n}} yang ngatur biar mereka bisa masuk dojo."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_exterior_8bc54340"
msgid "Ce type est vraiment trempé dans toutes les affaires."
msgstr "Orang itu emang nyangkut dalam semua urusan."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_exterior_d8fcee66"
msgid "Bordel ! Je fais quoi moi maintenant ?!"
msgstr "Sial! Aku harus ngapain sekarang?!"

#. Character:`saito`
msgctxt "home_kimochi_exterior_cb66aba0"
msgid "Comment je suis censé me reprendre en main et savoir me défendre si toutes les ordures de la ville apprennent les arts martiaux ?"
msgstr "Gimana aku harus bangkit dan belajar bela diri kalo semua sampah di kota ini malah belajar seni bela diri?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_exterior_99ac2cd6"
msgid "Quand la difficulté du jeu est trop élevée il n'y a qu'une seule solution."
msgstr "Kalo tingkat kesulitan gamenya kebanyakan, cuma ada satu solusi."

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_kimochi_exterior_1d9ff189"
msgid "Ah ?! Laquelle ?"
msgstr "Ah?! Apa tuh?"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_exterior_1713f135"
msgid "Tricher !"
msgstr "Curang!"

#. Character:`saito`
msgctxt "home_kimochi_exterior_ac030055"
msgid "Comment tu veux tricher là-dessus ?"
msgstr "Gimana kamu bisa curang soal itu?"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_a7247490"
msgid "Demande un coup de main à notre ami commun."
msgstr "Minta bantuan temen kita yang sama."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_exterior_852ed986"
msgid "Non, je ne veux pas faire appel à lui chaque fois que j'ai un problème."
msgstr "Gak, aku gak mau minta dia tiap kali ada masalah."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_kimochi_exterior_e942e909"
msgid "Tu fais bien appel à moi pourtant ?"
msgstr "Kamu memang panggil aku kan?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_kimochi_exterior_ad6d4460"
msgid "...[w] C'est différent. Réfléchir à deux sur un problème ne nous met pas en danger."
msgstr "...[w] Ini beda. Pikir bareng soal masalah nggak bikin kita dalam bahaya."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_exterior_64f8fa42"
msgid "Mais demander à {{macumba.n}} de se battre à ma place, j'aurais l'impression de l'utiliser."
msgstr "Tapi minta {{macumba.n}} buat berantem ganti aku, aku bakal ngerasa kayak ngegunain dia."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_exterior_b430a6b0"
msgid "Et même si je sais qu'il serait partant. Je préfère être un véritable ami qui ne profite pas de sa gentillesse."
msgstr "Dan walaupun aku tahu dia bakal mau, aku lebih milih jadi temen beneran yang nggak nyalahin kebaikannya."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_kimochi_exterior_1e504a7b"
msgid "Pfff on croirait entendre un vieux con."
msgstr "Pfff, kayak dengerin orang tua bodoh aja."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_8240fc9d"
msgid "Okay et maintenant ? Tu comptes résoudre ta situation comment ?"
msgstr "Oke, sekarang gimana? Kamu mau nyelesain situasi kamu gimana?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_exterior_93468d4d"
msgid "J'en sais rien... Je vais rentrer et y réfléchir."
msgstr "Aku nggak tau... Aku bakal pulang dan mikirin itu."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_exterior_bd831c09"
msgid "C'est toi qui vois, mais ne viens pas te plaindre quand tu seras obligé de faire appel à lui."
msgstr "Terserah kamu, tapi jangan ngeluh nanti pas kamu harus minta bantuan dia."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_9f0a1664"
msgid "Tout ce que tu auras de moi c'est juste un \"Je te l'avais dit !\""
msgstr "Yang bakal kamu dapetin dari aku cuma \"Udah aku bilangin!\""

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_exterior_251d0441"
msgid "Merde ! Il doit bien y avoir une solution autre que faire appel à un ami."
msgstr "Sial! Pasti ada cara lain selain minta tolong temen."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_bbbe0ea6"
msgid "... J'avancerai pas plus en restant ici, autant rentrer à la maison pour y réfléchir plus sérieusement."
msgstr "... Aku gak bakal maju kalo terus diem di sini, mending balik rumah aja buat mikir lebih serius."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_a4221157"
msgid "Merde... Toute cette situation devient ingérable."
msgstr "Sialan... Situasi ini makin gak terkendali."

#. Character:`narrator`
msgctxt "home_kimochi_exterior_50dd9ba0"
msgid "J'ai besoin d'un moment pour faire le tri dans ma tête sinon elle va exploser."
msgstr "Aku butuh waktu sebentar buat nyusun pikiran, kalo gak kepala aku bisa meledak."

#. Character:`saito`
msgctxt "home_kimochi_exterior_a817bdb9"
msgid "Nous y sommes..."
msgstr "Kita udah sampai..."

#. Character:`noriko`
msgctxt "home_kimochi_exterior_99f3c83a"
msgid "Ça va, je m'attendais à un endroit plus craignos que ça."
msgstr "Lumayan, aku kira tempatnya bakal lebih jelek dari ini."

#. Character:`saito`
msgctxt "home_kimochi_exterior_ce594674"
msgid "{{kimochi.n}} ?"
msgstr "{{kimochi.n}}?"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_e137ad23"
msgid "[size=14]Oh! Mais si ce n'est pas ce cher {{saito.n}} ! Entre mon ami.[/size]"
msgstr "[font_size=14]Oh! Kalo itu bukan si {{saito.n}} yang keren! Ayo masuk, bro.[/font_size]"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_exterior_17d9df9a"
msgid "mhhh c'est suspect çà."
msgstr "hmm, ini mencurigakan nih."

#. Character:`noriko` | Attributes:`bad`
msgctxt "home_kimochi_exterior_3bb45e89"
msgid "Ce n'est que maintenant que tu t'en rends compte ?"
msgstr "Baru sekarang kamu nyadar?"

#. Character:`noriko`
msgctxt "home_kimochi_exterior_d5d72848"
msgid "Au premier regard ça se voyait que c'était un dégénéré."
msgstr "Dari pandangan pertama aja udah keliatan dia orang yang rusak."

#. Character:`noriko`
msgctxt "home_kimochi_exterior_58f51b51"
msgid "Combien que tu paries qu'il vit dans une porcherie ?"
msgstr "Berani taruhan dia tinggal di tempat yang bau babi?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_kimochi_exterior_859dc21e"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`bad`
msgctxt "home_kimochi_exterior_2231e975"
msgid "Pffff je le savais, c'est même pas amusant."
msgstr "Pffff aku udah tau, ini nggak lucu sama sekali."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_2b628a83"
msgid "Bah mon vieux, tu t'es fait rouler dessus par un camion ou quoi ?"
msgstr "Eh bro, kamu kayaknya ketabrak truk atau gimana?"

#. Character:`noriko` | Attributes:`happy`
msgctxt "home_kimochi_exterior_71c2d60f"
msgid "Il a tenté un 3 contre 1 contre les thugs."
msgstr "Dia coba lawan 3 orang thug sekaligus."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_kimochi_exterior_f3e74ff6"
msgid "Mais quel idée à la con, pourquoi avoir fait un truc aussi débile ?!"
msgstr "Ide bodoh banget, kenapa harus ngelakuin hal sesatunya itu?!"

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_kimochi_exterior_201415c3"
msgid "Je me demande bien pourquoi aussi..."
msgstr "Aku juga bingung kenapa..."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_kimochi_exterior_bdb7310b"
msgid "Arrête de te plaindre ! Tu as passé trop de temps a avoir peur de ces trois débiles."
msgstr "Berhenti ngeluh! Kamu udah terlalu lama takut sama tiga bodoh itu."

#. Character:`noriko`
msgctxt "home_kimochi_exterior_5b8f9739"
msgid "Il était temps que tu te rendes compte qu'ils ne valent rien."
msgstr "Udah saatnya kamu sadar mereka nggak ada nilainya."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "home_kimochi_exterior_e4dfe972"
msgid "Oh je vois !"
msgstr "Oh aku paham!"

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_4307b1b1"
msgid "L'idée est bonne en soit mais... Il va falloir mettre en place une stratégie bien plus efficace que simplement foncer dans le tas et croiser les doigts en espérant que ça passe."
msgstr "Idenya sebenernya bagus tapi... Kita harus bikin strategi yang jauh lebih efektif daripada cuma nyerbu dan berharap aja berhasil."

#. Character:`noriko` | Attributes:`bad`
msgctxt "home_kimochi_exterior_e8f5641a"
msgid "Oh ! Voyez vous ça ! Tu suggères quoi ?"
msgstr "Oh! Lihat deh! Kamu nyaranin apa?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_exterior_ea5bc5a9"
msgid "[font_size=14]Dites si je vous dérange dites-le moi...[/font_size]"
msgstr "[font_size=14]Katakan aja kalau aku ganggu, bilang ke aku...[/font_size]"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_exterior_579e085b"
msgid "La peur doit changer de camp. Il doit leur instiller une peur bien plus profonde."
msgstr "Rasa takut harus pindah sisi. Dia harus buat mereka ngerasa takut yang jauh lebih dalam."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_bb0fe94c"
msgid "Il doit les isoler."
msgstr "Dia harus bikin mereka terisolasi."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_79c3945f"
msgid "Leur tomber dessus au moment où ils ne s'y attendront pas."
msgstr "Ngadepin mereka pas mereka nggak nyangka."

#. Character:`kimochi`
msgctxt "home_kimochi_exterior_e1d95c44"
msgid "Ils doivent apprendre que s'il s'en prennent à lui ils y laisseront des plumes."
msgstr "Mereka harus belajar kalau nyerang dia, mereka bakal rugi parah."

#. Character:`saito`
msgctxt "home_kimochi_exterior_255ec56a"
msgid "[font_size=14]Je vous rappelle que c'est moi qui suis concerné ![/font_size]"
msgstr "[font_size=14]Inget, yang aku maksud itu aku sendiri![/font_size]"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_kimochi_exterior_240f92eb"
msgid "Très bien définissons un programme qui tient la route !"
msgstr "Oke deh, kita bikin rencana yang bener-bener jalan!"

#. Character:`kimochi` | Attributes:`neutral`
