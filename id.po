#. Character:`saito` | Attributes:`guilty`
msgctxt "EUH_C_TAIT_IL_Y_A_LONGTEMPS_D8456F"
msgid "Euh... c'était... il y a longtemps."
msgstr "Euh... itu... sudah lama sekali."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "JE_VEUX_SAVOIR_0D2D08"
msgid "Je veux savoir !"
msgstr "Aku ingin tahu!"

#. Character:`saito`
msgctxt "PROMIS_JE_T_EN_PARLERAIS_LE_MO_59129A"
msgid "Promis je t'en parlerais le moment venu !"
msgstr "Janji aku akan ceritakan saat waktunya tiba!"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "TU_PROMETS_D4DC28"
msgid "Tu promets ?"
msgstr "Kamu janji?"

#. Character:`saito` | Attributes:`happy`
msgctxt "OUI_JE_TE_LE_PROMET_027AA2"
msgid "Oui je te le promet."
msgstr "Iya, aku janji."

#. Character:`sakuya`
msgctxt "DANS_CE_CAS_JE_NE_T_EMBETERAIS_2969E7"
msgid "Dans ce cas je ne t'embeterais plus avec ça, à demain {{saito.n}}."
msgstr "Kalau begitu aku nggak akan ganggu kamu lagi soal itu, sampai jumpa besok {{saito.n}}."

#. Character:`saito`
msgctxt "A_DEMAIN_E79C04"
msgid "À demain !"
msgstr "Sampai besok!"

#. Character:`natsume` | Attributes:`bad`
msgctxt "FINALEMENT_LES_CHOSES_S_ARRANG_863E3F"
msgid "Finalement, les choses s'arrangent bien pour toi, tu as une fille mignonne à consoler."
msgstr "Akhirnya, semuanya berjalan baik buatmu, kamu punya cewek manis buat dihibur."

#. Character:`natsume`
msgctxt "AVEC_UN_PEU_D_EFFORT_JE_SUIS_C_1D5916"
msgid "Avec un peu d'effort, je suis certaine que vous ferez un super couple tout mignon."
msgstr "Dengan sedikit usaha, aku yakin kalian bakal jadi pasangan yang super imut."

#. Character:`saito` | Attributes:`neutral`
msgctxt "ET_TON_TRUC_C_EST_DE_PRENDRE_T_AE865A"
msgid "Et ton truc, c'est de prendre ton pied en regardant les autres être heureux à ta place ?"
msgstr "Dan kamu, senang banget ya lihat orang lain bahagia menggantikanmu?"

#. Character:`natsume` | Attributes:`pouting`
msgctxt "C_EST_M_CHANT_A_A15DBB"
msgid "C'est méchant, ça !"
msgstr "Kejam banget sih!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "D_SOL_7175EE"
msgid "Désolé..."
msgstr "Maaf..."

#. Character:`natsume` | Attributes:`neutral`
msgctxt "QUOI_QU_IL_EN_SOIT_JE_VAIS_CON_E3179F"
msgid "Quoi qu'il en soit, je vais continuer de prendre mon pied à vous observer."
msgstr "Bagaimanapun juga, aku bakal terus senang ngeliatin kalian."

#. Character:`natsume`
msgctxt "DONC_TU_AS_PLUT_T_INT_R_T_FAIR_2AA1E9"
msgid "Donc tu as plutôt intérêt à faire attention à ce que tu vas faire avec elle !"
msgstr "Jadi kamu harus hati-hati sama apa yang bakal kamu lakuin sama dia!"

#. Character:`saito`
msgctxt "POURQUOI_TU_LA_CONNAIS_C_EST_U_5B9EAE"
msgid "Pourquoi ? Tu la connais, c'est une amie à toi ?"
msgstr "Kenapa? Kamu kenal dia, dia temanmu ya?"

#. Character:`natsume` | Attributes:`cute`
msgctxt "NOPE_DEE221"
msgid "Nope."
msgstr "Enggak."

#. Character:`natsume` | Attributes:`pouting`
msgctxt "MAIS_C_EST_UNE_FILLE_AVEC_LE_C_3C970A"
msgid "Mais c'est une fille avec le cœur brisé, donc je te surveille, ne fais pas n'importe quoi !"
msgstr "Tapi dia cewek yang hatinya lagi hancur, jadi aku awasi kamu, jangan asal-asalan!"

#. Character:`saito` | Attributes:`sad`
msgctxt "JE_NE_SAIS_M_ME_PAS_SI_ELLE_A_FEBA5B"
msgid "Je ne sais même pas si elle a envie de me revoir..."
msgstr "Aku bahkan nggak tahu dia mau ketemu aku lagi atau nggak..."

#. Character:`natsume` | Attributes:`bad`
msgctxt "TU_ES_MIGNON_MAIS_TU_ES_BIEN_T_9ACCDA"
msgid "Tu es mignon, mais tu es bien trop naïf."
msgstr "Kamu imut, tapi kamu terlalu polos."

#. Character:`narrator` | Attributes:`guilty`
msgctxt "JE_NE_SAIS_JAMAIS_SUR_QUEL_PIE_AD29C1"
msgid "Je ne sais jamais sur quel pied danser avec elle."
msgstr "Aku nggak pernah tahu harus gimana sama dia."

#. Character:`narrator` | Attributes:`happy`
msgctxt "MAIS_ELLE_N_A_PAS_L_AIR_D_AVOI_DBC8A1"
msgid "Mais elle n'a pas l'air d'avoir de mauvaises intentions non plus."
msgstr "Tapi dia juga nggak kelihatan punya niat buruk kok."

#. Character:`narrator` | Attributes:`guilty`
msgctxt "BON_SANG_CHAQUE_FOIS_QUE_J_AI_C4841E"
msgid "Bon sang... À chaque fois que j'ai une discussion avec cette fille, je dors toujours mal..."
msgstr "Sialan... Setiap kali aku ngobrol sama cewek itu, aku selalu susah tidur..."

#. Character:`narrator`
msgctxt "ELLE_ME_RETOURNE_LE_CERVEAU_A30C13"
msgid "Elle me retourne le cerveau."
msgstr "Dia bikin aku bingung banget."

#. Character:`narrator` | Attributes:`happy`
msgctxt "JE_FERAIS_MIEUX_D_ALLER_COURIR_5BF30C"
msgid "Je ferais mieux d'aller courir pour me réveiller."
msgstr "Mending aku lari dulu biar melek."

#. Character:`noriko`
msgctxt "RESTE_L_DA0CE2"
msgid "Reste là !"
msgstr "Tunggu!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "MAIS_J_ALLAIS_SORT_E2C993"
msgid "Mais j'allais sort-"
msgstr "Tapi aku mau ke-"

#. Character:`noriko`
msgctxt "OUI_BAH_A_ATTENDRA_89C153"
msgid "Oui, bah ça attendra !"
msgstr "Ya sudah, tunggu aja!"

#. Character:`saito` | Attributes:`sad`
msgctxt "MAIS_QU_EST_CE_QUE_TU_ME_VEUX_6A48A6"
msgid "Mais qu'est-ce que tu me veux encore ? Je t'avais demandé de juste me laisser tranquille."
msgstr "Tapi kamu mau apa lagi sih? Aku sudah bilang biarin aku sendiri."

#. Character:`noriko` | Attributes:`shame`
msgctxt "OUI_EH_BIEN_CE_N_EST_PAS_TOI_Q_7358D1"
msgid "Oui, eh bien ce n'est pas toi qui vis avec une épée de Damoclès qui mettrait fin à ma réputation !!"
msgstr "Ya, tapi bukan kamu yang hidup dengan pedang Damocles yang bisa merusak reputasiku!!"

#. Character:`noriko`
msgctxt "A_SERA_MIEUX_CETTE_FOIS_CI_628BD4"
msgid "Ça sera mieux cette fois-ci..."
msgstr "Kali ini pasti bakal lebih baik..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "TU_VAS_ENCORE_ME_7F894F"
msgid "Tu vas encore me..?!!"
msgstr "Kamu mau ngapain lagi sama aku..?!!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "J_AI_PAS_ENVIE_QUE_TU_ME_MORDE_33F20A"
msgid "J'ai pas envie que tu me mordes encore !"
msgstr "Aku nggak mau kamu gigit aku lagi!"

#. Character:`noriko`
msgctxt "JE_VAIS_PAS_TE_MORDRE_W_FONT_S_FAE107"
msgid "Je vais pas te mordre ![w] [font_size=14]Je me suis entraînée...[/font_size]"
msgstr "Aku nggak bakal gigit kamu! [w] [font_size=14]Aku sudah latihan...[/font_size]"

#. Character:`noriko`
msgctxt "CONTENTE_TOI_DE_RESTER_SILENCI_2B1ADF"
msgid "Contente toi de rester silencieux."
msgstr "Cukup diam aja."

#. Character:`saito`
msgctxt "T_EN_FAIS_VRAIMENT_QU_TA_T_TE_ACBC5F"
msgid "T'en fais vraiment qu'à ta tête !"
msgstr "Kamu emang keras kepala banget!"

#. Character:`narrator`
msgctxt "PUTAIN_CETTE_SITUATION_EST_COM_1C4B2A"
msgid "Putain cette situation est complètement surréaliste."
msgstr "Sial, situasi ini benar-benar nggak masuk akal."

#. Character:`narrator`
msgctxt "J_AI_JAMAIS_DEMAND_UN_TRUC_PAR_004E9C"
msgid "J'ai jamais demandé un truc pareil moi."
msgstr "Aku nggak pernah minta hal kayak gini."

#. Character:`narrator`
msgctxt "EN_PLUS_SI_YASUKA_N_NOUS_SURPR_17A425"
msgid "En plus si {{yasuka.n}} nous surprend comment je lui explique ça ?!"
msgstr "Apalagi kalau {{yasuka.n}} tiba-tiba lihat, gimana aku jelasin?"

#. Character:`narrator`
msgctxt "UNE_SECONDE_C_EST_P_UT_TRE_CE_76F861"
msgid "Une seconde... C'est peut-être ce qu'elle cherche à..."
msgstr "Tunggu sebentar... Mungkin itu yang dia cari..."

#. Character:`noriko`
msgctxt "HEY_ARRETE_DE_PENSER_AUTRE_CHO_265154"
msgid "Hey ! Arrête de penser à autre chose !"
msgstr "Hei! Berhenti mikirin hal lain!"

#. Character:`saito`
msgctxt "D_SOL_JE_614014"
msgid "Désolé je..."
msgstr "Maaf aku..."

#. Character:`narrator`
msgctxt "MERDE_ELLE_SE_D_BROUILLE_VRAIM_0508AD"
msgid "Merde ! Elle se débrouille vraiment mieux !"
msgstr "Sial! Dia memang jauh lebih jago!"

#. Character:`noriko`
msgctxt "ALORS_C_TAIT_MIEUX_472277"
msgid "Alors... c'était mieux ?"
msgstr "Jadi... gimana, lebih baik?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "JE_DOIS_VRAIMENT_R_PONDRE_A_333C26"
msgid "Je dois vraiment répondre à ça ?"
msgstr "Aku harus bales itu beneran?"

#. Character:`noriko`
msgctxt "OUI_18FC43"
msgid "Oui !!"
msgstr "Iya!!"

#. Character:`saito`
msgctxt "OUI_A_N_AVAIT_RIEN_VOIR_813E2A"
msgid "...Oui... ça... n'avait rien à voir."
