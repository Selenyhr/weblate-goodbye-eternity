msgstr "{{saito.n}}."

#. Character:`hanako`
msgctxt "JE_M_EN_SOUVIENDRAI_BONNE_CHAN_93E2EF"
msgid "Je m'en souviendrai. Bonne chance !"
msgstr "Aku bakal inget. Semoga beruntung!"

#. Character:`kenji` | Attributes:`disgusted`
msgctxt "PUTAIN_MAMAN_POURQUOI_JE_SUIS_9DB3F6"
