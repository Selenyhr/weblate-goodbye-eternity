msgstr "Oke, seharusnya cukup di sini, ayo kita cek di konbini."

#. Character:`saito`
msgctxt "KENJI_N_J_AI_BESOIN_DE_TE_PAR_961913"
msgid "{{kenji.n}}, j'ai besoin de te parler, tu as un moment ?"
msgstr "{{kenji.n}}, aku butuh ngomong sama kamu, ada waktu?"

