msgctxt "QU_EST_CE_QUE_TU_VOULAIS_SAVOI_C27CB6"
msgid "Qu'est-ce que tu voulais savoir ? Peut-être que je peux t'aider ?"
msgstr "Kamu mau tau apa? Mungkin aku bisa bantu?"

