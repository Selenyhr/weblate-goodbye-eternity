#. Character:`saito` | Attributes:`surprised`
msgctxt "pc_noriko_9302ef11"
msgid "Quoi ? Mais..."
msgstr "Apa? Tapi..."

#. Character:`noriko`
msgctxt "pc_noriko_cd1ef043"
msgid "J'ai dit..."
msgstr "Aku bilang..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "pc_noriko_34e61ed7"
msgid "À GENOUX !"
msgstr "BERLUTUT!"

#. Character:`saito`
msgctxt "pc_noriko_00296699"
msgid "Outch !"
msgstr "Aduh!"

#. Character:`noriko`
msgctxt "pc_noriko_dae92ccc"
msgid "Tu vas devoir comprendre, qu'ici..."
msgstr "Kamu harus ngerti, di sini..."

#. Character:`noriko`
msgctxt "pc_noriko_5c7d1578"
msgid "Tu n'es..."
msgstr "Kamu itu..."

#. Character:`noriko`
msgctxt "pc_noriko_25d2851c"
msgid "rien de plus qu'un..."
msgstr "gak lebih dari..."

#. Character:`noriko`
msgctxt "pc_noriko_7ab81800"
msgid "...misérable."
msgstr "...sampah."

#. Character:`noriko`
msgctxt "pc_noriko_657a7a37"
msgid "Putain de..."
msgstr "Sialan..."

#. Character:`noriko`
msgctxt "pc_noriko_569d390a"
msgid "CLÉBARD !"
msgstr "ANJING GILA!"

#. Character:`saito`
msgctxt "pc_noriko_3e20ec33"
msgid "Arrête ça... !"
msgstr "Berhenti dong...!"

#. Character:`noriko`
msgctxt "pc_noriko_78450098"
msgid "Chuuut, pas un mot, ni maintenant, ni jamais."
msgstr "Diam, jangan ngomong sepatah kata pun, sekarang atau kapan pun."

#. Character:`noriko`
msgctxt "pc_noriko_bebcd775"
msgid "Dorénavant, tu m'obéiras au doigt et à l'œil..."
msgstr "Mulai sekarang, kamu harus nurut aku banget..."

#. Character:`saito`
msgctxt "pc_noriko_ce8f4e97"
msgid "Et si je refuse ?"
msgstr "Kalau aku nolak gimana?"

#. Character:`noriko`
msgctxt "pc_noriko_b2f72d90"
msgid "J'irai voir maman et lui dirais que tu m'as violé plusieurs fois dans mon enfance."
msgstr "Aku bakal bilang ke mama kalau kamu udah perkosa aku berkali-kali waktu kecil."

#. Character:`saito`
msgctxt "pc_noriko_4ef9bc25"
msgid "Quoi ?! Mais j'ai jam... !"
msgstr "Apa?! Tapi aku gak pernah...!"

#. Character:`noriko`
msgctxt "pc_noriko_e17c6ce8"
msgid "TU OBÉIRAS !"
msgstr "KAMU HARUS NURUT!"

#. Character:`saito`
msgctxt "pc_noriko_b14bf260"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "pc_noriko_b3183e43"
msgid "Parfait ! Maintenant dégage de ma chambre !"
msgstr "Sip! Sekarang cabut dari kamarku!"

#. Character:`noriko`
msgctxt "pc_noriko_e100ab91"
msgid "Maman te l'a emprunté. Je ne touche pas à tes affaires, j'ai pas envie de choper le cancer !"
msgstr "Mama kamu pinjemin. Aku gak mau sentuh barang kamu, gak mau kena kanker juga!"

#. Character:`narrator`
msgctxt "pc_noriko_a21e86ee"
msgid "..."
msgstr "..."

#. Character:`narrator`
msgctxt "pc_noriko_f5f4e555"
msgid "Qu'est-ce qu-"
msgstr "Apa-apa-"

#. Character:`narrator`
msgctxt "pc_noriko_29621d39"
msgid "Merde... Mais qu'est-ce qui vient de se passer ?!"
msgstr "Sialan... Tapi tadi apaan sih yang baru aja kejadian?!"

#. Character:`narrator`
msgctxt "pc_noriko_acd28135"
msgid "Je savais qu'elle était odieuse, mais pas qu'elle avait un côté sadique."
msgstr "Aku tau dia nyebelin, tapi gak nyangka dia juga sadis gitu."

#. Character:`narrator`
msgctxt "pc_noriko_025cac24"
msgid "Je me suis bien fait baiser la gueule, j'avais oublié ce chantage..."
msgstr "Aku benar-benar ketipu, aku lupa sama ancaman itu..."

#. Character:`narrator`
msgctxt "pc_noriko_2b81833a"
msgid "Je suis coincé à obéir à tous ses caprices !"
msgstr "Aku terjebak harus nurutin semua kemauannya!"

#. Character:`narrator`
msgctxt "pc_noriko_a21e86ee_1"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "pc_noriko_17e596ff"
msgid "FERME LÀ !"
msgstr "BUNGEMU!"

#. Character:`saito`
msgctxt "pc_noriko_27fe91d9"
msgid "Si tu t'étais contentée de me répondre dès le départ, on n'en serait pas arrivé là !"
msgstr "Kalau dari awal kamu jawab aku, gak bakal sampe segini!"

#. Character:`narrator`
msgctxt "pc_noriko_2b82e184"
msgid "Il faut que je me sorte de là avant que ça ne dégénère..."
msgstr "Aku harus keluar dari sini sebelum makin parah..."

#. Character:`narrator`
msgctxt "pc_noriko_093f4a70"
msgid "Il me faut une idée et vite..."
msgstr "Aku butuh ide, cepet..."

#. Character:`narrator`
msgctxt "pc_noriko_4b35a18b"
msgid "Je vais tenter quelque chose..."
msgstr "Aku bakal coba sesuatu..."

#. Character:`saito`
msgctxt "pc_noriko_e0cc54b7"
msgid "Je ne sais plus quoi faire avec toi {{noriko.n}} !"
msgstr "Aku udah gak tau lagi harus gimana sama kamu {{noriko.n}}!"

#. Character:`saito`
msgctxt "pc_noriko_52971ce2"
msgid "Tu abuses de ma patience depuis bien trop longtemps."
msgstr "Kamu udah kebanyakan nyoba kesabaran aku."

#. Character:`saito`
msgctxt "pc_noriko_6150a6d5"
msgid "Je ne sais pas pourquoi tu ne me prends pas au sérieux, mais ça va changer..."
msgstr "Aku gak ngerti kenapa kamu gak anggap aku serius, tapi itu bakal berubah..."

#. Character:`noriko`
msgctxt "pc_noriko_102ef7ee"
msgid "Va... te... faire foutre !"
msgstr "Pergi... sana... cium pantat kamu!"

#. Character:`saito`
msgctxt "pc_noriko_dae531e8"
msgid "...[w] Tu as peut-être besoin que je joigne les actes à la parole ?"
msgstr "...[w] Mungkin kamu butuh aku buktiin omongan aku?"

#. Character:`saito`
msgctxt "pc_noriko_666b9ce6"
msgid "Si tu aimes ce genre de chose, peut-être qu'on peut trouver une sorte d'arrangement ?"
msgstr "Kalau kamu suka yang beginian, mungkin kita bisa cari kesepakatan?"

#. Character:`saito`
msgctxt "pc_noriko_f2e8ce36"
msgid "J'aurais peut-être dû t'accorder plus d'attention..."
msgstr "Mungkin aku harusnya lebih perhatian sama kamu..."

#. Character:`noriko`
msgctxt "pc_noriko_850db9ee"
msgid "Arrête... Je..."
msgstr "Berhenti... Aku..."

#. Character:`saito`
msgctxt "pc_noriko_df83df6a"
msgid "Je ne te savais pas aussi vicieuse !"
msgstr "Aku gak nyangka kamu sejahat ini!"

#. Character:`noriko`
msgctxt "pc_noriko_a4f00544"
msgid "Ah..."
msgstr "Ah..."

#. Character:`saito`
msgctxt "pc_noriko_67bc1bbf"
msgid "À partir de maintenant, tu vas arrêter de me prendre pour ton esclave."
msgstr "Mulai sekarang, kamu harus berhenti nganggap aku budak kamu."

#. Character:`saito`
msgctxt "pc_noriko_6eff81b7"
msgid "C'est à moi que tu obéiras !"
msgstr "Aku yang bakal kamu taatin!"

#. Character:`noriko`
msgctxt "pc_noriko_f16779f7"
msgid "Je..."
msgstr "Aku..."

#. Character:`saito`
msgctxt "pc_noriko_f8001b90"
msgid "Est-ce que je me suis bien fait comprendre cette fois-ci ?"
msgstr "Apa aku udah jelas kali ini?"

#. Character:`noriko`
msgctxt "pc_noriko_9fc616da"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "pc_noriko_3fbad6b5"
msgid "Oui..."
msgstr "Iya..."

#. Character:`saito`
msgctxt "pc_noriko_e2cb7a2e"
msgid "Finalement... Je vais finir par croire que c'était ce que tu voulais depuis le début..."
msgstr "Akhirnya... aku mulai percaya itu emang yang kamu mau dari awal..."

#. Character:`noriko`
msgctxt "pc_noriko_9fc616da_1"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "pc_noriko_03f06f03"
msgid "Où est le baladeur {{noriko.n}} !?"
msgstr "Mana pemutar musiknya {{noriko.n}}!?"

#. Character:`noriko`
msgctxt "pc_noriko_cefb0a59"
msgid "C'est maman qui t'a emprunté le baladeur, pas moi..."
msgstr "Mama yang pinjam pemutar musik itu, bukan aku..."

#. Character:`saito` | Attributes:`happy`
msgctxt "pc_noriko_d19ce8a2"
msgid "Tu vois ? Tu aurais dû commencer par ça dès le début."
msgstr "Lihat? Harusnya kamu mulai dari situ dari awal."

#. Character:`narrator`
msgctxt "pc_noriko_3b23c22d"
msgid "Putain de bordel de merde !"
msgstr "Sialan, gila banget dah!"

#. Character:`narrator`
msgctxt "pc_noriko_901d3cde"
msgid "Je ne sais pas ce qui m'a pris, mais visiblement, je m'en suis sorti vivant..."
msgstr "Aku nggak tau kenapa, tapi ternyata aku selamat..."

#. Character:`narrator`
msgctxt "pc_noriko_0a80aabf"
msgid "Ma relation avec ma chère {{noriko.n}} devrait évoluer d'une bien étrange façon..."
msgstr "Hubunganku sama sayangku {{noriko.n}} bakal berkembang dengan cara yang aneh banget..."

#. Character:`narrator`
msgctxt "pc_noriko_a4dc08cc"
msgid "J'espère que tout ça aura suffi... J'ai vraiment pris de trop gros risques cette fois-ci !"
msgstr "Aku harap semua ini cukup... Aku bener-bener ambil risiko gede banget kali ini!"

#. Character:`narrator`
msgctxt "pc_noriko_1b354464"
msgid "Toutes ces conneries ont fini par m'exciter..."
msgstr "Semua omong kosong ini malah bikin aku horny..."

#. Character:`saito` | Attributes:`happy`
msgctxt "pc_noriko_8a9a83e4"
msgid "Bref..."
msgstr "Pokoknya..."

#. Character:`saito`
msgctxt "pc_noriko_3bf75143"
msgid "Allons voir {{yasuka.n}} pour ce foutu baladeur CD !"
msgstr "Yuk, kita datengin {{yasuka.n}} buat ambil pemutar CD sialan itu!"

#. Character:`noriko`
msgctxt "home_player_noriko_room_b9b10a29"
msgid "HEY ! T'AS RIEN À FAIRE DANS MA CHAMBRE !"
msgstr "HEY! KAMU GAK ADA URUSAN MASUK KAMAR KU!"

#. Character:`saito`
msgctxt "home_player_noriko_room_41613f0d"
msgid "Arrête ça, tu sais très bien pourquoi je suis là !"
msgstr "Berhenti deh, kamu tau banget aku di sini buat apa!"

#. Character:`noriko` | Attributes:`-angry`
msgctxt "home_player_noriko_room_a4009c4c"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "home_player_noriko_room_bd8a548e"
msgid "Je t'ai déjà prévenu plusieurs fois."
msgstr "Aku udah bilang berkali-kali."

#. Character:`saito`
msgctxt "home_player_noriko_room_453dbe3a"
msgid "Et je t'ai déjà dit que si tu recommençais, j'allais m'occuper de toi."
msgstr "Dan aku juga udah bilang kalau kamu ngulang lagi, aku bakal ngurusin kamu."

#. Character:`noriko`
msgctxt "home_player_noriko_room_85be0407"
msgid "Pose à peine un doigt sur moi et tu peux être sûr que j'irais voir maman et lui dirais que tu m'as violé par le passé !"
msgstr "Sentuh aku dikit aja, bisa dipastikan aku bakal bilang ke mama kalau kamu pernah ngencengin aku dulu!"

#. Character:`narrator`
msgctxt "home_player_noriko_room_7ffd9815"
msgid "Nous y voilà..."
msgstr "Kita sampai juga..."

#. Character:`narrator`
msgctxt "home_player_noriko_room_8c087e43"
msgid "J'ai bien la preuve que ce n'était pas qu'un simple rêve."
msgstr "Aku punya bukti jelas kalau ini bukan cuma mimpi belaka."

#. Character:`narrator`
msgctxt "home_player_noriko_room_6c7476b4"
msgid "Tout ce que j'ai vécu s'est réellement produit !"
msgstr "Semua yang aku alami itu beneran terjadi!"

#. Character:`narrator`
msgctxt "home_player_noriko_room_f0f3b580"
msgid "Je dois sortir mon meilleur jeu d'acteur."
msgstr "Aku harus nunjukin akting terbaikku."

#. Character:`narrator`
msgctxt "home_player_noriko_room_547cf7f2"
msgid "Et faire en sorte de révéler toute sa vraie personnalité."
msgstr "Dan bikin dia ngeluarin kepribadian aslinya."

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_player_noriko_room_d6aa7458"
msgid "Mais... T'es complètement folle ?!"
msgstr "Tapi... Kamu gila beneran, ya?!"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_player_noriko_room_db77f6fb"
msgid "Tu sais très bien que j'ai jamais fait un truc pareil !"
msgstr "Kamu tau banget aku nggak pernah ngelakuin hal kayak gitu!"

#. Character:`saito`
msgctxt "home_player_noriko_room_0b5ed9e7"
msgid "{{yasuka.n}} ne croira jamais un mensonge pareil !"
msgstr "{{yasuka.n}} nggak bakal percaya kebohongan kayak gitu!"

#. Character:`noriko`
msgctxt "home_player_noriko_room_61aada6b"
msgid "Pfff... Peu importe si c'est pas la vérité !"
msgstr "Pfff... Gak masalah kalau itu bukan kebenaran!"

#. Character:`noriko`
msgctxt "home_player_noriko_room_94f22c85"
msgid "Maman croira tout ce que je lui dirai !"
msgstr "Mama bakal percaya semua yang aku bilang!"

#. Character:`noriko`
msgctxt "home_player_noriko_room_22afa39e"
msgid "Surtout si je lui dis qu'on a fait du mal à sa petite chérie..."
msgstr "Apalagi kalo aku bilang kita udah nyakitin pacar kecilnya..."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_player_noriko_room_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "home_player_noriko_room_a4668afa"
msgid "Bien... Je pense que tu comprends ce qu'il va arriver..."
msgstr "Oke... Aku rasa kamu ngerti apa yang bakal terjadi..."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_noriko_room_9d2bd8fd"
msgid "J'en ai peur..."
msgstr "Aku takut banget..."

#. Character:`noriko`
msgctxt "home_player_noriko_room_29cd7803"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_noriko_room_7f4df03b"
msgid "Pourquoi t'es en train de sourire ?"
msgstr "Kenapa kamu malah senyum gitu?"

#. Character:`noriko`
msgctxt "home_player_noriko_room_ee4eaef2"
msgid "Tu réalises ce qui va arriver pour toi ?"
msgstr "Kamu sadar nggak apa yang bakal kejadian sama kamu?"

#. Character:`noriko`
msgctxt "home_player_noriko_room_d1124181"
msgid "C'est ton cerveau qui a lâché gros débile ?"
msgstr "Otak kamu yang udah error, bodoh banget sih?"

#. Character:`noriko`
msgctxt "home_player_noriko_room_48a9f185"
msgid "Tu vas commencer par me donner tout ton argent !"
msgstr "Kamu bakal mulai dengan ngasih semua duit kamu ke aku!"

#. Character:`noriko`
msgctxt "home_player_noriko_room_8774f8f6"
msgid "Ensuite, tu seras mon chien !"
msgstr "Abis itu, kamu bakal jadi anjing aku!"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_player_noriko_room_68771bf7"
msgid "Tu obéiras à tout ce que je te dem..."
msgstr "Kamu bakal nurut semua yang aku suruh..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_noriko_room_50dd8dd0"
msgid "POURQUOI TU SOURIS COMME UN PUTAIN D'ATTARDÉ ?!!"
msgstr "KENAPA KAMU SENYUM KAYAK ANJING BODOH GITU?!!"

#. Character:`saito`
msgctxt "home_player_noriko_room_6a052d56"
msgid "Oh, pour rien..."
msgstr "Oh, nggak apa-apa..."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_noriko_room_5e15bd98"
msgid "Juste que... Je me demande ce que pensera {{yasuka.n}} de cet enregistrement..."
msgstr "Cuma... Aku penasaran, {{yasuka.n}} bakal mikir apa ya soal rekaman ini..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_noriko_room_080e5f7e"
msgid "...Mais... Mais... Tu as..."
msgstr "...Tapi... Tapi... Kamu udah..."

#. Character:`saito`
msgctxt "home_player_noriko_room_391aad38"
msgid "Tout enregistré oui, je t'avais prévenue {{noriko.n}} que je montrerais quelle salope tu peux être..."
msgstr "Semua terekam, iya, aku udah bilang ke kamu {{noriko.n}} kalau aku bakal nunjukin seberapa jalangnya kamu..."

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "home_player_noriko_room_e8a4876f"
msgid "Non... Non non non non... NOOONNNNN !!!"
msgstr "Nggak... Nggak nggak nggak nggak... NGGAAAKKK!!!"

#. Character:`noriko`
msgctxt "home_player_noriko_room_d15fe766"
msgid "[font_size=19]Nooonn...[/font_size]"
msgstr "[font_size=19]Nggaaaak...[/font_size]"

#. Character:`noriko`
msgctxt "home_player_noriko_room_cfc5152c"
msgid "[font_size=14]Nonn...[/font_size]"
msgstr "[font_size=14]Nggak...[/font_size]"

#. Character:`saito`
msgctxt "home_player_noriko_room_4a14d581"
msgid "Bien, pour commencer..."
msgstr "Oke, buat mulai..."

#. Character:`noriko`
msgctxt "td139b6d726"
msgid "[next]"
msgstr "[next]"

#. Character:`notice`
msgctxt "t8fc53e68f6"
msgid "Vous obtenez le baladeur MP3."
msgstr "Kamu dapet pemutar MP3."

#. Character:`saito` | Attributes:`neutral`
msgctxt "menu_rejet_noriko_final_b81fcf6d"
msgid "Et, bien voilà... Ce n'était pas si compliqué {{noriko.n}}."
msgstr "Dan, ya udah deh... Gak sesulit itu kok {{noriko.n}}."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_03775ec8"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_26ea0a25"
msgid "Tant que tu te tiens tranquille avec moi, je ne ferais rien."
msgstr "Selama kamu diem aja sama aku, aku gak bakal ngapa-ngapain."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_0f230e58"
msgid "Recommence ton cinéma et soit sûre que je l'utiliserais."
msgstr "Coba kamu ulangin drama kamu, dan yakin deh aku bakal make itu."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_ea3796f0"
msgid "[font_size=19]Oui...[/font_size]"
msgstr "[font_size=19]Iya...[/font_size]"

#. Character:`narrator`
msgctxt "t6dfeb25814"
msgid "[hint=ROUTE REJET]Donne-moi le baladeur MP3."
msgstr "[hint=ROUTE REJET]Kasih aku MP3 player-nya."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "menu_rejet_noriko_final_6a640c96"
msgid "Co... Comment ça ?"
msgstr "Ca... Gimana tuh?"

#. Character:`saito` | Attributes:`upset`
msgctxt "menu_rejet_noriko_final_4d72610e"
msgid "Les rôles se sont inversés {{noriko.n}}. Tu ne pensais quand même pas que tu allais t'en tirer aussi facilement ?"
msgstr "Situasinya sekarang kebalik, {{noriko.n}}. Kamu gak mungkin mikir bisa lolos gitu aja kan?"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_46159041"
msgid "Pas après toutes ces années à m'avoir pourri la vie."
msgstr "Gak setelah bertahun-tahun bikin hidup aku hancur."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_dddbcc71"
msgid "Pas après toutes les insultes[w], les humiliations[w], les crasses que tu m'as faites."
msgstr "Gak setelah semua hinaan[w], penghinaan[w], dan kejahatan yang kamu lakuin ke aku."

#. Character:`saito` | Attributes:`happy`
msgctxt "menu_rejet_noriko_final_59ad3fd8"
msgid "J'ai juste à donner ceci à {{yasuka.n}} pour faire de ta vie un enfer."
msgstr "Aku cuma perlu ngasih ini ke {{yasuka.n}} buat bikin hidup kamu jadi neraka."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_9778a29a"
msgid "...[w] Je vois..."
msgstr "...[w] Aku ngerti..."

#. Character:`noriko` | Attributes:`cute`
msgctxt "menu_rejet_noriko_final_96092db1"
msgid "Alors, je pense que j'ai quelque chose pour toi..."
msgstr "Jadi, aku rasa aku punya sesuatu buat kamu..."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_07f849c3"
msgid "Je suis certain qu'un puceau comme toi n'en a jamais vu en vrai."
msgstr "Aku yakin cowok perjaka kayak kamu belum pernah liat yang beneran."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_2ba3329d"
msgid "Alors, satisfait ?"
msgstr "Jadi, puas gak?"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_21a93eab"
msgid "Profites-en, car tu n'en verras jamais d'autres."
msgstr "Nikmatin aja, soalnya kamu gak bakal pernah liat yang lain."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_86fc5973"
msgid "Je suis sûr que tu meurs d'envie de les toucher."
msgstr "Aku yakin kamu mati-matian pengen nyentuhnya."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_686a2fd7"
msgid "Aaah, ma chère {{noriko.n}}... Je ne m'attendais pas à ça, mais..."
msgstr "Aaah, sayangku {{noriko.n}}... Aku gak nyangka bakal kayak gini, tapi..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_7ab112f5"
msgid "Je pense que ça ne suffira pas..."
msgstr "Aku rasa itu gak bakal cukup..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_8c66181f"
msgid "Tu m'emmerdes depuis tant d'années, tu crois qu'en voyant ta poitrine une fois ça va effacer ton ardoise ?"
msgstr "Kamu udah ngeselin aku bertahun-tahun, kamu pikir cuma liat payudara kamu sekali bisa ngapus semua utang kamu?"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_e305091d"
msgid "C'est clairement pas suffisant."
msgstr "Jelas itu nggak cukup."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_7da22726"
msgid "...Je vais te t-"
msgstr "...Aku bakal m-mu-"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_305ba402"
msgid "Attention {{noriko.n}} ! Ne fais pas quelque chose que tu pourrais regretter."
msgstr "Hati-hati {{noriko.n}}! Jangan lakuin sesuatu yang nanti bisa bikin kamu nyesel."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_c13b3356"
msgid "Rhabille-toi, et donne ce que je suis venu chercher. Tiens-toi prête pour ma prochaine visite."
msgstr "Pakai baju lagi, dan kasih apa yang aku cari. Siap-siap buat kunjungan aku berikutnya."

#. Character:`notice`
msgctxt "t6a2e1e2138"
msgid "Vous obtenez le baladeur MP3."
msgstr "Kamu dapet pemutar MP3."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_ff54907f"
msgid "...Quand ?"
msgstr "...Kapan?"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_74450f95"
msgid "Quand j'en aurai décidé !"
msgstr "Pas aku yang mutusin!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_5ea74534"
msgid "MAIS...!"
msgstr "TAPI...!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_b867a4ca"
msgid "Ce n'est plus toi qui décides à présent."
msgstr "Sekarang bukan kamu yang mutusin lagi."

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "menu_rejet_noriko_final_7fef2aea"
msgid "...fait chier !"
msgstr "...sialan!"

#. Character:`narrator`
msgctxt "tf77c3e2d7c"
msgid "[hint=ROUTE CHANTAGE]Jusqu'à quel point tu ne veux pas que ça se sache {{noriko.n}} ?"
msgstr "[hint=ROUTE CHANTAGE]Sampai sejauh mana kamu nggak mau ini ketahuan, {{noriko.n}}?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_noriko_00b62d92"
msgid "{{noriko.n}} !"
msgstr "{{noriko.n}} !"

#. Character:`saito`
msgctxt "talk_noriko_ab94ab29"
msgid "J'ai besoin de toi immédiatement !"
msgstr "Aku butuh kamu sekarang juga!"

#. Character:`noriko` | Attributes:`angry`
msgctxt "talk_noriko_5ac10f1f"
msgid "PUTAIN !"
msgstr "SIALAN!"

#. Character:`noriko`
msgctxt "talk_noriko_162c6915"
msgid "Tu peux pas frapper avant d'entrer comme tout le monde ?"
msgstr "Kamu nggak bisa ketok pintu dulu kayak orang lain sih?"

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_noriko_ebf61c11"
msgid "On s'en tape !"
msgstr "Aku nggak peduli!"

#. Character:`saito`
msgctxt "talk_noriko_c5099605"
msgid "De quelle couleur sont mes yeux ?"
msgstr "Mata aku warnanya apa?"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "talk_noriko_ad9c1117"
msgid "Quoi ?"
msgstr "Apa?"

#. Character:`saito`
msgctxt "talk_noriko_9b1c4351"
msgid "{{noriko.n}} juste... répond moi, de quelle couleur sont mes yeux ?"
msgstr "{{noriko.n}} cuma... jawab aku, mata aku warnanya apa?"

#. Character:`noriko` | Attributes:`shame`
msgctxt "talk_noriko_898b1990_2"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "talk_noriko_403a83ce"
msgid "Marron, tu as les yeux marron."
msgstr "Coklat, mata kamu coklat."

#. Character:`noriko`
msgctxt "talk_noriko_a8ddeb9f"
msgid "Tu avais juste à regarder dans la salle de bain..."
msgstr "Kamu cuma tinggal liat di kamar mandi doang..."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_noriko_070865d3"
msgid "Merci !"
msgstr "Makasih!"

#. Character:`noriko`
msgctxt "talk_noriko_6764641e"
msgid "Pourqu-"
msgstr "Karena-"

#. Character:`noriko`
msgctxt "talk_noriko_d385f1f5"
msgid "Noisette... Tu as les yeux couleur noisette."
msgstr "Noisette... Matamu warnanya coklat kacang."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_noriko_9f34edda"
msgid "Merci {{noriko.n}} !"
msgstr "Makasih {{noriko.n}} !"

#. Character:`noriko`
msgctxt "talk_noriko_200e1f01"
msgid "Attends-je..."
msgstr "Tunggu... aku..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_noriko_64ae250a"
msgid "Quoi ?"
msgstr "Apa?"

#. Character:`noriko`
msgctxt "talk_noriko_f6039c86"
msgid "...Non, laisse tomber."
msgstr "...Enggak, sudahlah."

#. Character:`saito`
msgctxt "talk_noriko_1446a0d4"
msgid "S'il te plait..."
msgstr "Tolong dong..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "talk_noriko_045e61d8"
msgid "De la merde !"
msgstr "Sialan!"

#. Character:`saito`
msgctxt "talk_noriko_84f6a032"
msgid "Attends, quoi ?"
msgstr "Tunggu, apa?"

#. Character:`noriko`
msgctxt "talk_noriko_8ce77e83"
msgid "Tes yeux ont la même couleur que de la merde !"
msgstr "Matamu warnanya sama kayak sialan!"

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_noriko_86926d74"
msgid "Hmm, oh, tu veux dire marron ?"
msgstr "Hmm, oh, maksudnya coklat?"

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_noriko_9f34edda_1"
msgid "Merci {{noriko.n}} !"
msgstr "Makasih {{noriko.n}} !"

#. Character:`noriko`
msgctxt "talk_noriko_50516910"
msgid "...[w] Taré."
msgstr "...[w] Gila."

#. Character:`noriko` | Attributes:`afraid`
msgctxt "talk_noriko_76daba04"
msgid "Que... Qu'est-ce que tu veux ?"
msgstr "Apa... Kamu mau apa?"

#. Character:`noriko`
msgctxt "talk_noriko_374ea508"
msgid "Tu vas encore me brutaliser c'est ça ?"
msgstr "Kamu mau brutal sama aku lagi ya?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_noriko_e4a64377"
msgid "Quoi ? Bien sûr que non."
msgstr "Apa? Jelas enggak."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_noriko_eadd7ccf"
msgid "Il s'agit d'autre chose..."
msgstr "Ini soal hal lain..."

#. Character:`noriko` | Attributes:`bad`
msgctxt "talk_noriko_2cccb1ce"
msgid "HEY !"
msgstr "HEI!"

#. Character:`noriko`
msgctxt "talk_noriko_90bc6a7a"
msgid "Qui t'a permis de rentrer dans ma chambre sans prévenir ?"
msgstr "Siapa yang ngasih izin kamu masuk kamar aku nggak bilang dulu?"

#. Character:`noriko`
msgctxt "talk_noriko_08c316a9"
msgid "Dégage !"
msgstr "Pergi sana!"

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_noriko_113b6635"
msgid "Désolé, mais c'est important."
msgstr "Maaf, tapi ini penting."

#. Character:`noriko`
msgctxt "talk_noriko_181efd45"
msgid "Qu'est-ce que tu veux ?"
msgstr "Kamu mau apa?"

#. Character:`noriko` | Attributes:`afraid`
msgctxt "talk_noriko_c78c394d"
msgid "Qu'est-ce que tu me veux ?"
msgstr "Kamu mau apa sama aku?"

#. Character:`noriko` | Attributes:`shame`
msgctxt "talk_noriko_f5c961f2"
msgid "Tu veux encore que je te s-"
msgstr "Kamu mau aku s- lagi?"

#. Character:`saito`
msgctxt "talk_noriko_19fbe169"
msgid "Non, je ne suis pas venu pour ça !"
msgstr "Enggak, aku nggak dateng buat itu!"

#. Character:`saito`
msgctxt "talk_noriko_c67f735e"
msgid "{{noriko.n}}, tu aurais un instant, j'ai besoins de toi."
msgstr "{{noriko.n}}, kamu ada waktu sebentar, aku butuh kamu."

#. Character:`noriko` | Attributes:`bad`
msgctxt "talk_noriko_b2f32b08"
msgid "Pfff, je croyais que tu n'en avais plus rien à faire de moi justement."
msgstr "Pfff, aku kira kamu udah nggak peduli lagi sama aku justru."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_noriko_ffa08594"
msgid "...Écoute au moins ce que j'ai à dire."
msgstr "...Dengerin dulu deh apa yang mau aku bilang."

#. Character:`saito`
msgctxt "talk_noriko_750f38c2"
msgid "À vrai dire, j'ai besoins d'un conseil vestimentaire."
msgstr "Sebenarnya, aku butuh saran soal pakaian."

#. Character:`noriko`
msgctxt "talk_noriko_c30c9b33"
msgid "Un conseil vestimentaire ?"
msgstr "Saran soal pakaian?"

#. Character:`saito`
msgctxt "talk_noriko_f56a80d0"
msgid "J'ai besoins d'un costume plutôt chic pour un club privé !"
msgstr "Aku butuh kostum yang agak keren buat club privat!"

#. Character:`noriko` | Attributes:`bad`
msgctxt "talk_noriko_22497002"
msgid "...Laisse-moi deviner, tu veux voir où travaille maman ?"
msgstr "...Biar aku nebak, kamu pengen liat tempat kerja mamah?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_noriko_c4c6f267"
msgid "Oui, j'aimerais m'assurer que tout se passe bien pour elle."
msgstr "Iya, aku pengen pastiin semuanya baik-baik aja buat dia."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "talk_noriko_bab56ba2"
msgid "Qu'est-ce que j'y gagne dans tout ça ?"
msgstr "Aku dapat apa dari semua ini?"

#. Character:`saito`
msgctxt "talk_noriko_c78344cb"
msgid "...La satisfaction d'avoir aidé {{yasuka.n}} ?"
msgstr "...Kepuasan udah bantuin {{yasuka.n}}?"

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "talk_noriko_033a7dca"
msgid "Débrouille-toi tout seul alors."
msgstr "Ya udah, urusin sendiri aja deh."

#. Character:`noriko`
msgctxt "talk_noriko_970887f9"
msgid "Maman n'a pas besoins de toi, elle se débrouille très bien toute seule."
msgstr "Mama nggak butuh kamu, dia bisa ngurus dirinya sendiri dengan baik."

#. Character:`noriko`
msgctxt "talk_noriko_62ce77a5"
msgid "La preuve, on a enfin de l'argent de poche."
msgstr "Buktinya, akhirnya kita punya uang jajan."

#. Character:`narrator`
msgctxt "talk_noriko_2cc1d08a"
msgid "Je ne peux pas lui donner tort."
msgstr "Aku nggak bisa bilang dia salah."

#. Character:`narrator`
msgctxt "talk_noriko_bc29aa1c"
msgid "Mais je peux pas lui dire qu'il y a deux connards qui cherchent à me faire du mal en passant par {{yasuka.n}}."
msgstr "Tapi aku nggak bisa bilang ke dia kalau ada dua brengsek yang nyari cara nyakitin aku lewat {{yasuka.n}}."

#. Character:`narrator`
msgctxt "talk_noriko_85dca400"
msgid "Qu'est-ce que je pourrais lui promettre ?"
msgstr "Apa yang bisa aku janjiin ke dia?"

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_noriko_1363899f"
msgid "Bon... voici ma proposition, la prochaine fois qu'elle nous donne de l'argent de poche, tout est pour toi."
msgstr "Oke... ini tawaran aku, kali berikutnya dia ngasih kita uang jajan, semua buat kamu."

#. Character:`saito`
msgctxt "talk_noriko_206b361c"
msgid "Alors ?"
msgstr "Jadi gimana?"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "talk_noriko_5bc1f7ae"
msgid "...Okay."
msgstr "...Oke deh."

#. Character:`saito`
msgctxt "talk_noriko_9cc7eb13"
msgid "Alors, tu connais une boutique ?"
msgstr "Jadi, kamu tau toko mana?"

#. Character:`noriko` | Attributes:`happy`
msgctxt "talk_noriko_6d4da199"
msgid "Oui, à côté du Konbini !"
msgstr "Iya, di sebelah Konbini!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_noriko_fceaf5df"
msgid "Du konbini ? Mais... il n'y a rien à part..."
msgstr "Konbini? Tapi... nggak ada apa-apa selain..."

#. Character:`noriko` | Attributes:`bad`
msgctxt "talk_noriko_e819b89d"
msgid "Des poubelles exactement !"
msgstr "Persis, tempat sampah!"

#. Character:`noriko` | Attributes:`angry`
msgctxt "talk_noriko_a6fb9f62"
msgid "Tu crois que tu peux m'acheter avec un peu d'argent de poche ?"
msgstr "Kamu kira bisa beli aku dengan sedikit uang jajan?"

#. Character:`noriko`
msgctxt "talk_noriko_7cd51e75"
msgid "DÉGAGE DE MA CHAMBRE !"
msgstr "KELUAR DARI KAMAR KU!"

#. Character:`noriko` | Attributes:`angry`
msgctxt "talk_noriko_236d552c"
msgid "Tu crois que j'ai oublié ce que tu m'as fait ?"
msgstr "Kamu kira aku lupa apa yang kamu lakuin ke aku?"

#. Character:`noriko`
msgctxt "talk_noriko_88c1d780"
msgid "Dégage de ma chambre et débrouille-toi !"
msgstr "Keluar dari kamar aku dan cari cara sendiri!"

#. Character:`asami`
msgctxt "menu_rejet_noriko_final_d2c15ef3"
msgid "Du coup, t'as jamais eu envie de..."
msgstr "Jadi, kamu gak pernah pengen..."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_2a59c441"
msgid "En fait..."
msgstr "Sebenarnya..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_6e42cc7d"
msgid "Bon bon bon, je crois qu'on va s'arrêter ici."
msgstr "Oke oke oke, kayaknya kita berhenti di sini aja."

#. Character:`saito` | Attributes:`happy`
msgctxt "menu_rejet_noriko_final_02e28f57"
msgid "J'ai pas envie que tous mes secrets soient dévoilés."
msgstr "Aku gak mau semua rahasia aku ketahuan."

#. Character:`asami` | Attributes:`pouting`
msgctxt "menu_rejet_noriko_final_b5ad9c74"
msgid "Oh, c'est dommage, j'apprenais plein de choses intéressantes."
msgstr "Ah, sayang banget, aku lagi dapet banyak hal menarik nih."

#. Character:`asami` | Attributes:`neutral`
msgctxt "menu_rejet_noriko_final_c8493ef1"
msgid "{{noriko.n}}, merci d'avoir discuté un peu avec moi, la prochaine fois ça te dit de sortir en ville ensemble ?"
msgstr "{{noriko.n}}, makasih udah ngobrol sama aku sebentar, lain kali mau gak kita jalan bareng ke kota?"

#. Character:`noriko` | Attributes:`happy`
msgctxt "menu_rejet_noriko_final_790ebbaa"
msgid "C'est vrai ?! Euh... Mmhh... Bien sûr, avec plaisir."
msgstr "Serius?! Euh... Mmhh... Tentu aja, dengan senang hati."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_5562ec2c"
msgid "J'ai encore quelques dossiers sur {{saito.n}}."
msgstr "Aku masih punya beberapa berkas tentang {{saito.n}}."

#. Character:`noriko` | Attributes:`bad`
msgctxt "J_AI_SON_HISTORIQUE_WEB_RECENT_DBF1C1"
msgid "J'ai son historique web récent... Tu vas pas être déçue !"
msgstr "Aku punya riwayat web terbarunya... Kamu pasti nggak akan kecewa!"

#. Character:`asami` | Attributes:`happy`
msgctxt "menu_rejet_noriko_final_0bef7a8f"
msgid "Excellent, c'est exactement le genre de chose que j'attendais !"
msgstr "Mantap, itu persis yang aku tunggu-tunggu!"

#. Character:`saito` | Attributes:`sad`
msgctxt "menu_rejet_noriko_final_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_9d53f045"
msgid "T'es dans la merde mon pauvre !"
msgstr "Kamu lagi dalam masalah berat, kasian deh!"

#. Character:`saito`
msgctxt "JE_NE_PEUX_PAS_SIMPLEMENT_VENI_66539C"
msgid "Je ne peux pas simplement venir te voir et discuter avec toi ?"
msgstr "Aku nggak bisa cuma datang buat ketemu dan ngobrol sama kamu?"

#. Character:`noriko`
msgctxt "J_AI_RIEN_TE_DIRE_3DF1D5"
msgid "J'ai rien à te dire."
msgstr "Aku nggak punya apa-apa buat dibilang."

#. Character:`saito`
msgctxt "MAIS_MOI_PAR_CONTRE_J_AI_DES_C_EA918E"
msgid "Mais moi par contre j'ai des choses à dire."
msgstr "Tapi aku malah punya banyak yang mau kukatakan."

#. Character:`saito` | Attributes:`neutral`
msgctxt "JE_NE_SUIS_PAS_SURPRIS_QUE_TU_D178E8"
msgid "Je ne suis pas surpris que tu t'entendes aussi bien avec {{asami.n}} et que vous soyez devenues amies."
msgstr "Aku nggak kaget kamu bisa akrab banget sama {{asami.n}} sampai kalian jadi teman."

#. Character:`saito`
msgctxt "C_EST_UNE_FILLE_VRAIMENT_CHOUE_5BE000"
msgid "C'est une fille vraiment chouette !"
msgstr "Dia cewek yang benar-benar asik!"

#. Character:`noriko` | Attributes:`bad`
msgctxt "C_EST_CLAIR_TU_NE_LA_M_RITES_P_394A84"
msgid "C'est clair ! Tu ne la mérites pas."
msgstr "Iya banget! Kamu nggak pantas dapat dia."

#. Character:`saito` | Attributes:`upset`
msgctxt "CE_CE_N_EST_DE_TOUTE_FA_ON_PAS_F39025"
msgid "Ce... Ce n'est de toute façon pas à toi d'en décid-"
msgstr "Itu... Itu bukan urusanmu buat mutusin-"

#. Character:`saito`
msgctxt "PEU_IMPORTE_D9B1F0"
msgid "Peu importe..."
msgstr "Terserah..."

#. Character:`saito`
msgctxt "JE_VEUX_ENTRERRER_LA_HACHE_DE_B19F0D"
msgid "Je veux entrerrer la hache de guerre avec toi."
msgstr "Aku mau mengubur perang dingin ini sama kamu."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_25e3c5d8"
msgid "On passe la plupart de notre temps à se crier dessus, à s'éviter, à se faire des crasses."
msgstr "Kita habisin waktu kebanyakan buat teriak-terikan, ngindar, dan saling nyakitin."

#. Character:`saito` | Attributes:`happy`
msgctxt "menu_rejet_noriko_final_fac73f92"
msgid "Peut-on faire la paix une bonne fois pour toutes ?"
msgstr "Bisa nggak kita damai sekali aja?"

#. Character:`noriko` | Attributes:`angry`
msgctxt "menu_rejet_noriko_final_854ba06d"
msgid "Non !"
msgstr "Nggak!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "menu_rejet_noriko_final_8f3ab287"
msgid "M-"
msgstr "M-"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_0210f28c"
msgid "Je refuse !"
msgstr "Aku nolak!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "menu_rejet_noriko_final_be653c95"
msgid "Les choses ont été bien trop loin pour passer à autre chose."
msgstr "Kejadiannya udah kelewat jauh buat langsung move on."

#. Character:`saito` | Attributes:`sad`
msgctxt "menu_rejet_noriko_final_95699640"
msgid "Écoute je suis prêt à faire des effort et pardonner certaines choses et..."
msgstr "Dengerin, aku siap usaha dan maafin beberapa hal, dan..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "menu_rejet_noriko_final_4ddfdea3"
msgid "ARRÊTE ! C'est pas à toi de décider ça, c'est pas à toi de me pardonner !"
msgstr "BERHENTI! Bukan kamu yang mutusin itu, bukan kamu yang harus maafin aku!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "menu_rejet_noriko_final_63807d1b"
msgid "Mais... Je comprends pas..."
msgstr "Tapi... Aku nggak ngerti..."

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "menu_rejet_noriko_final_d2a5baa5"
msgid "Tu passes ton temps à faire la victime...[w] Tout ça pour...[w] rien."
msgstr "Kamu terus-terusan jadi korban...[w] Semua ini cuma buat...[w] nggak ada artinya."

#. Character:`saito` | Attributes:`sad`
msgctxt "menu_rejet_noriko_final_5f66ed1e"
msgid "{{noriko.n}}, je veux vraiment devenir une meilleure personne et si tu ne me dis pas pourquoi tu me hais autant je..."
msgstr "{{noriko.n}}, aku beneran pengen jadi orang yang lebih baik dan kalo kamu nggak bilang kenapa kamu benci aku banget, aku..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "menu_rejet_noriko_final_3611390a"
msgid "VOILÀ ! Il s'agit encore de toi et de personne d'autre, il faut tout te donner, tout te dire, tout faire pour toi !"
msgstr "INI DIA! Masih tentang kamu dan nggak orang lain, harus dikasih semua, dikasih tau semua, dilakuin semua buat kamu!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_74e47000"
msgid "Y'A RIEN QUI CHANGE JAMAIS AVEC TOI !"
msgstr "GAK ADA YANG PERNAH BERUBAH SAMA KAMU!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_bbdc0057"
msgid "Tu ne te souviens même plus..."
msgstr "Kamu bahkan nggak ingat lagi..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_d0a9f7cc"
msgid "Me souvenir ?"
msgstr "Ingat?"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_a7c19159"
msgid "VA-T-EN !"
msgstr "CABUT!"

#. Character:`noriko` | Attributes:`angry`
msgctxt "menu_rejet_noriko_final_115ee30e"
msgid "Hey !!!"
msgstr "Hey!!!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_8108a2e8"
msgid "On doit parler !"
msgstr "Kita harus ngomong!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "menu_rejet_noriko_final_fc34e3c8"
msgid "Oui mais moi j'ai rien à te dire !"
msgstr "Iya tapi aku gak punya apa-apa buat kamu bilang!"

#. Character:`saito` | Attributes:`upset`
msgctxt "menu_rejet_noriko_final_f02845f2"
msgid "Tu faisais quoi aujourd'hui ?"
msgstr "Kamu ngapain hari ini?"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_c9abca40"
msgid "Que... En quoi ça te regarde ?"
msgstr "Apa... Kenapa kamu peduli?"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_1b2d6437"
msgid "Ça me regarde dans le sens où tu prétends avoir passé la journée avec {{asami.n}} alors que ce n'est pas le cas."
msgstr "Ini soal aku karena kamu ngaku udah ngabisin hari sama {{asami.n}} padahal kenyataannya enggak."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "menu_rejet_noriko_final_6bbac01e"
msgid "... Et alors ? Je n'avais pas envie de rendre des comptes à ma mère."
msgstr "... Terus? Aku gak pengen ngasih laporan ke ibu aku."

#. Character:`saito`
msgctxt "JE_NE_COMPRENDS_ET_NE_SUPPORTE_EE13A7"
msgid "Je ne comprends et ne supporte plus cette animosité que tu as envers moi."
msgstr "Aku nggak ngerti dan nggak tahan lagi sama permusuhan yang kamu punya ke aku."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_0395eddb"
msgid "Je ne sais pas ce que j'ai pu te faire pour qu'on en arrive là, mais j'aimerais comprendre."
msgstr "Aku gak tau aku ngapain ke kamu sampe jadi kayak gini, tapi aku pengen ngerti."

#. Character:`noriko` | Attributes:`bad`
msgctxt "menu_rejet_noriko_final_f3655e6b"
msgid "Si tu te préoccupais un peu plus de toi et moins de moi on n'en serait pas là !"
msgstr "Kalau kamu lebih mikirin diri kamu sendiri daripada aku, gak bakal sampe segini!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_d7b86515"
msgid "Attention à toi {{noriko.n}}. Je veux bien être gentil, mais je ne suis plus le garçon docile sur lequel tu pouvais marcher."
msgstr "Hati-hati ya {{noriko.n}}. Aku bisa baik, tapi aku bukan lagi cowok penurut yang kamu bisa injek-in."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_499d7d45"
msgid "Tout ce que j'essaie de faire c'est de comprendre pourquoi on en arrive là aujourd'hui."
msgstr "Yang aku coba lakuin cuma pengen ngerti kenapa kita sampe segini hari ini."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_9b26c03c"
msgid "Je sais que tu me caches des choses, et crois-moi je finirai par les découvrir."
msgstr "Aku tahu kamu nyimpen sesuatu dari aku, dan percayalah aku bakal nemuin itu akhirnya."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_f2c92a0a"
msgid "... Va... va-t-en ! Laisse-moi tranquille. Ne t'occupe pas de mes affaires."
msgstr "... Pa... pergi sana! Biarin aku sendiri. Jangan urusin urusanku."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_01bf2617"
msgid "On n'en restera pas là."
msgstr "Ini nggak bakal berhenti di sini."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_cfaa5842"
msgid "Bonne soirée."
msgstr "Selamat malam."

#. Character:`saito`
msgctxt "talk_noriko_f772442c"
msgid "Bon ça suffit les conneries, maintenant tu vas t'expliquer !"
msgstr "Udah cukup omong kosongnya, sekarang kamu harus jelasin semuanya!"

#. Character:`saito`
msgctxt "talk_noriko_feea393d"
msgid "Pourquoi tu es complètement à poil d'ailleurs ?"
msgstr "Kenapa kamu malah telanjang bulat sih?"

#. Character:`saito` | Attributes:`angry`
msgctxt "talk_noriko_f29a8032"
msgid "T'es en train de me rendre complètement fou."
msgstr "Kamu bikin aku jadi gila banget."

#. Character:`saito`
msgctxt "talk_noriko_1fcf040e"
msgid "Je sais pas à quel jeu tu joues mais..."
msgstr "Aku nggak tau kamu main apa tapi..."

#. Character:`noriko` | Attributes:`bad`
msgctxt "talk_noriko_21ed9f39"
msgid "Tu vas me punir ?"
msgstr "Kamu mau hukum aku?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "talk_noriko_40121d8e"
msgid "Oui je vais te... Attends quoi ?"
msgstr "Iya aku mau... Tunggu, apaan nih?"

#. Character:`noriko`
msgctxt "talk_noriko_a6b8a84e"
msgid "Prouve-le !"
msgstr "Buktikan dong!"

#. Character:`saito`
msgctxt "talk_noriko_01de4c42"
msgid "Bordel de...[w] Mais... mais de quoi tu parles ?"
msgstr "Sialan...[w] Tapi... tapi kamu ngomongin apa sih?"

#. Character:`saito`
msgctxt "talk_noriko_d83c5729"
msgid "Tu crois que tout ceci n'est qu'une vaste plaisanterie pour toi ?"
msgstr "Kamu kira semua ini cuma guyonan buat kamu doang?"

#. Character:`noriko`
msgctxt "talk_noriko_b4651e0d"
msgid "Donc... tu ne me puniras pas ? Tu te dégonfles ?"
msgstr "Jadi... kamu gak bakal hukum aku? Kamu jadi pengecut ya?"

#. Character:`saito` | Attributes:`angry`
msgctxt "talk_noriko_befd0cab"
msgid "Quoi ?! Mais... putain {{noriko.n}} !"
msgstr "Apa?! Tapi... sialan {{noriko.n}}!"

#. Character:`saito`
msgctxt "talk_noriko_44fc70a1"
msgid "Tu crois que je ne te sauterai pas dessus ?"
msgstr "Kamu kira aku gak bakal ngegas ke kamu?"

#. Character:`noriko`
msgctxt "talk_noriko_910623fe"
msgid "Visiblement non... il semblerait que tu sois seulement une grande bouche..."
msgstr "Kayaknya nggak deh... kayaknya kamu cuma mulut besar doang..."

#. Character:`saito` | Attributes:`angry`
msgctxt "talk_noriko_11b4c513"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "talk_noriko_daef296a"
msgid "J'attends toujours..."
msgstr "Aku masih nunggu..."

#. Character:`saito`
msgctxt "talk_noriko_ae4363f2"
msgid "Je vais le faire."
msgstr "Aku bakal lakuin."

#. Character:`noriko`
msgctxt "talk_noriko_b1602e4c"
msgid "Alors vas-y !"
msgstr "Yaudah, cepetan!"

#. Character:`saito`
msgctxt "talk_noriko_68172d73"
msgid "Je ne plaisante pas !"
msgstr "Aku nggak bercanda!"

#. Character:`noriko`
msgctxt "talk_noriko_356a5fed"
msgid "J'attends encore..."
msgstr "Aku masih nunggu nih..."

#. Character:`saito`
msgctxt "talk_noriko_d20fe92e"
msgid "... Très bien si c'est ce que tu souhaites."
msgstr "... Ya udah deh kalo emang itu yang kamu mau."

#. Character:`saito`
msgctxt "talk_noriko_0d32894d"
msgid "Alors tu penses toujours que je ne vais pas le faire ?"
msgstr "Jadi kamu masih mikir aku nggak bakal ngelakuin?"

#. Character:`noriko`
msgctxt "talk_noriko_027ebe58"
msgid "Non, aucune chance, t'auras pas le cran !"
msgstr "Nggak, nggak mungkin, kamu nggak bakal berani!"

#. Character:`saito`
msgctxt "talk_noriko_49458075"
msgid "... Non tu as raison, je ne vais pas la mettre."
msgstr "... Iya kamu bener, aku nggak bakal make itu."

#. Character:`noriko`
msgctxt "talk_noriko_649da96d"
msgid "Quoi ?!"
msgstr "Apa?!"

#. Character:`noriko`
msgctxt "talk_noriko_25230ebd"
msgid "NON ! Mets-la ! Mets-la moi !"
msgstr "GAK! Pasangin! Pasangin ke aku!"

#. Character:`saito`
msgctxt "talk_noriko_324d2d97"
msgid "... et le mot magique ?"
msgstr "... terus katanya magic word-nya?"

#. Character:`noriko`
msgctxt "talk_noriko_1003269d"
msgid "Mets-la moi s'il te plaît..."
msgstr "Tolong pasangin ke aku ya..."

#. Character:`saito`
msgctxt "talk_noriko_8c56b39f"
msgid "... eh bien voilà !"
msgstr "... Nah kan!"

#. Character:`noriko`
msgctxt "talk_noriko_2fe49844"
msgid "Mhhh... mhhh"
msgstr "Mhhh... mhhh"

#. Character:`saito`
msgctxt "talk_noriko_969d36df"
msgid "Tu sais, tu n'es pas obligée de retenir ta voix."
msgstr "Kamu tahu, kamu gak perlu nahan suara kamu."

#. Character:`saito`
msgctxt "talk_noriko_9d53056b"
msgid "Si tu apprécies, lâche-toi !"
msgstr "Kalau kamu suka, lepas aja!"

#. Character:`noriko`
msgctxt "talk_noriko_f65a964f"
msgid "Y'a aucun moyen qu... que... ça me... fasse du... bien !"
msgstr "Gak mungkin... bisa... bikin aku... enak... gini!"

#. Character:`saito`
msgctxt "talk_noriko_1cbfbee9"
msgid "Très bien, augmentons la cadence alors !"
msgstr "Oke deh, kita tambah kecepatan!"

#. Character:`noriko`
msgctxt "talk_noriko_0b0667c1"
msgid "Mmhhhh... mhhh... aaah..."
msgstr "Mmhhhh... mhhh... aaah..."

#. Character:`saito`
msgctxt "talk_noriko_1a0711b1"
msgid "Toujours aussi fière ?"
msgstr "Masih sombong aja nih?"

#. Character:`noriko`
msgctxt "talk_noriko_38862f98"
msgid "Non... Je... C'est..."
msgstr "Gak... Aku... Ini..."

#. Character:`saito`
msgctxt "talk_noriko_f7320604"
msgid "Tu as raison, je peux y mettre plus de force."
msgstr "Kamu benar, aku bisa kasih lebih keras."

#. Character:`noriko`
msgctxt "talk_noriko_35b49e60"
msgid "Quoi ?! Non... Je suis déjà..."
msgstr "Apa?! Gak... Aku udah..."

#. Character:`noriko`
msgctxt "talk_noriko_282cef29"
msgid "Aaaah aaaah aaaah... Oui !"
msgstr "Aaaah aaaah aaaah... Iya!"

#. Character:`saito`
msgctxt "talk_noriko_67c85a93"
msgid "Beaucoup mieux ![w] Je te préfère quand tu es honnête avec toi-même..."
msgstr "Jauh lebih enak![w] Aku lebih suka kamu pas jujur sama diri sendiri..."

#. Character:`noriko`
msgctxt "talk_noriko_5468a594"
msgid "Oui pardon, ne t'arrête pas !"
msgstr "Iya maaf, jangan berhenti!"

#. Character:`noriko`
msgctxt "talk_noriko_04cebda8"
msgid "Mmhh Ouiiii !"
msgstr "Mmhh Iyaaaa!"

#. Character:`noriko`
msgctxt "talk_noriko_e15dd9fd"
msgid "Hannn hannn..."
msgstr "Hannn hannn..."

#. Character:`noriko`
msgctxt "talk_noriko_a0055cf4"
msgid "Retire-toi !"
msgstr "Tarik keluar!"

#. Character:`saito`
msgctxt "talk_noriko_5431b506"
msgid "Al-"
msgstr "Al-"

#. Character:`noriko` | Attributes:`angry`
msgctxt "talk_noriko_988c494f"
msgid "Dégage de ma chambre maintenant !!!"
msgstr "Keluar dari kamarku sekarang juga!!!"

#. Character:`saito`
msgctxt "talk_noriko_56609df8"
msgid "Bordel mais pourquoi t'es encore à poil ?"
msgstr "Sialan, kenapa kamu masih telanjang?"

#. Character:`noriko`
msgctxt "talk_noriko_847cdc2c"
msgid "Je t'attendais !"
msgstr "Aku udah nungguin kamu!"

#. Character:`saito`
msgctxt "talk_noriko_ea095bd7"
msgid "Quoi ?! Mais bordel, je ne veux pas jouer à ton petit jeu j'aimerais juste..."
msgstr "Apa?! Sialan, aku gak mau main permainan kamu, aku cuma pengen..."

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "talk_noriko_476f4808"
msgid "Je le savais tu t'es dégonflé..."
msgstr "Aku tau kamu ciut..."

#. Character:`saito`
msgctxt "talk_noriko_6a1ae8b4"
msgid "Non ! Non non non et non ! Tu ne m'auras pas une seconde fois comme ça !"
msgstr "Gak! Gak gak gak dan gak! Kamu gak bakal dapetin aku kayak gitu dua kali!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "talk_noriko_a5469489"
msgid "C'est dommage... j'avais bien aimé moi..."
msgstr "Sayang banget... aku sebenernya suka tuh..."

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_noriko_8784c6cc"
msgid "...[w] Bordel."
msgstr "...[w] Sialan."

#. Character:`noriko`
msgctxt "talk_noriko_8e500ab0"
msgid "Donc tu te dégonfles... c'est bien ce que je disais."
msgstr "Jadi kamu ciut... ya kan aku udah bilang."

#. Character:`noriko` | Attributes:`bad`
msgctxt "talk_noriko_2209c0e1"
msgid "Tu avais un côté sauvage... J'avais l'impression d'avoir un alpha."
msgstr "Kamu punya sisi liar... Aku ngerasa punya alfa."

#. Character:`noriko`
msgctxt "talk_noriko_e11d8581"
msgid "Mais là... J'ai plus l'impression d'avoir un b-"
msgstr "Tapi sekarang... Aku gak ngerasa punya b-"

#. Character:`saito`
msgctxt "talk_noriko_8fbd428b"
msgid "Okay stop ! C'est du sauvage que tu veux ?"
msgstr "Oke berhenti! Kamu mau yang liarnya?"

#. Character:`saito`
msgctxt "talk_noriko_41f629b5"
msgid "Pas de problème ! Mais après on va discuter toi et moi !"
msgstr "Gak masalah! Tapi abis ini kita bakal ngomong, kamu dan aku!"

#. Character:`noriko`
msgctxt "talk_noriko_2492d629"
msgid "Alors tu comptes la rentrer, ou il faut demander de l'aide ?"
msgstr "Jadi kamu mau masukin itu, atau mau minta tolong?"

#. Character:`saito`
msgctxt "talk_noriko_7caf2eae"
msgid "Il me semble que c'est ce que tu veux... Demande-le moi poliment !"
msgstr "Kayaknya itu yang kamu mau... Minta aja dengan sopan!"

#. Character:`noriko`
msgctxt "talk_noriko_22a349d1"
msgid "... Je... Je veux pas demander quelque chose d'aussi gênant."
msgstr "... Aku... Aku nggak mau minta sesuatu yang sebegitu malu."

#. Character:`saito`
msgctxt "talk_noriko_34033223"
msgid "Dans ce cas, on peut rester longtemps comme ça !"
msgstr "Kalau gitu, kita bisa terus kayak gini lama-lama!"

#. Character:`noriko`
msgctxt "talk_noriko_d742e1c3"
msgid "Mais...[w] D'accord...[w] Mets... Mets-la en moi[w] s'il te plaît."
msgstr "Tapi...[w] Oke...[w] Masukin... Masukin ke aku[w] please."

#. Character:`noriko`
msgctxt "talk_noriko_0c2c5f65"
msgid "Mmhhh ouiii !"
msgstr "Mmhhh iyaaa!"

#. Character:`saito`
msgctxt "talk_noriko_171cb176"
msgid "... J'ai jamais vu une fille aussi dérangée que toi !"
msgstr "... Aku belum pernah liat cewek se-gila kamu!"

#. Character:`saito`
msgctxt "talk_noriko_d8e7dd6c"
msgid "Je comprends vraiment pas t-"
msgstr "Aku bener-bener nggak ngerti k-"

#. Character:`noriko`
msgctxt "talk_noriko_e8414074"
msgid "Shhhhht ! Arrête de réfléchir et pousse plus fort !"
msgstr "Shhhhht! Berenti mikir, dorong lebih keras!"

#. Character:`saito`
msgctxt "talk_noriko_5d23f633"
msgid "Oh bordel !"
msgstr "Sialan!"

#. Character:`noriko`
msgctxt "talk_noriko_a5b84aaa"
msgid "Oui c'est... doucement... doucement je..."
msgstr "Iya, pelan... pelan aku..."

#. Character:`saito`
msgctxt "talk_noriko_eae959f1"
msgid "Désolé je n'entends pas un mot."
msgstr "Maaf, aku nggak denger sepatah kata pun."

#. Character:`noriko`
msgctxt "talk_noriko_14556aeb"
msgid "Aaaah... aaah... ahhh..."
msgstr "Aaaah... aaah... ahhh..."

#. Character:`saito`
msgctxt "talk_noriko_e5584940"
msgid "Maintenant que tu as eu ce que tu voulais..."
msgstr "Sekarang kamu udah dapetin yang kamu mau..."

#. Character:`saito`
msgctxt "talk_noriko_901837ca"
msgid "Je veux des explications."
msgstr "Aku mau penjelasan."

#. Character:`saito`
msgctxt "talk_noriko_3e32a7a6"
msgid "Je sais que tu as payé les thugs pour qu'ils viennent me tabasser."
msgstr "Aku tahu kamu bayar preman buat nyuruh mereka ngehajar aku."

#. Character:`saito`
msgctxt "talk_noriko_ed15802e"
msgid "Je sais également que tu fais ça depuis longtemps."
msgstr "Aku juga tahu kamu udah lama ngelakuin ini."

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_noriko_f3f8be00"
msgid "Je ne m'énerverai pas... J'aimerais juste comprendre."
msgstr "Aku nggak bakal marah... Aku cuma pengen ngerti."

#. Character:`saito`
msgctxt "talk_noriko_c12e5234"
msgid "Pourquoi {{noriko.n}} ?"
msgstr "Kenapa {{noriko.n}}?"

#. Character:`noriko`
msgctxt "talk_noriko_9d36ecf3"
msgid "...[w] Tu ne comprendrais pas."
msgstr "...[w] Kamu nggak bakal ngerti."

#. Character:`saito`
msgctxt "talk_noriko_4006214c"
msgid "Commence déjà par me l'expliquer."
msgstr "Mulai aja jelasin dulu."

#. Character:`saito`
msgctxt "talk_noriko_ee42977b"
msgid "Si tu n'essaies pas... comment veux tu qu-"
msgstr "Kalau kamu nggak nyoba... gimana kamu mau-"

#. Character:`noriko`
msgctxt "talk_noriko_16f5c3aa"
msgid "Tu ne pourras jamais me pardonner de toute façon donc à quoi bon..."
msgstr "Kamu nggak bakal pernah bisa maafin aku juga, jadi buat apa..."

#. Character:`noriko`
msgctxt "talk_noriko_ec497736"
msgid "Ce que je fais depuis des années...[w] est bien trop grave."
msgstr "Apa yang udah aku lakuin bertahun-tahun...[w] itu udah kelewat parah."

#. Character:`noriko`
msgctxt "talk_noriko_c5fc98f5"
msgid "Je me suis mise là-dedans toute seule."
msgstr "Aku masukin diri aku sendiri ke situasi ini."

#. Character:`noriko`
msgctxt "talk_noriko_e1ef8947"
msgid "Je m'en sortirai toute seule."
msgstr "Aku bakal keluar dari ini sendirian."

#. Character:`saito`
msgctxt "talk_noriko_03775ec8_1"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "talk_noriko_cb534121"
msgid "Il n'est pas possible d'effacer autant de haine en un claquement de doigts."
msgstr "Gak mungkin ngapus semua kebencian sebanyak itu cuma dengan jentikan jari."

#. Character:`noriko` | Attributes:`shame`
msgctxt "talk_noriko_e59d4a37"
msgid "Et même si toi, tu me pardonnes..."
msgstr "Dan bahkan kalau kamu, maafin aku..."

#. Character:`noriko`
msgctxt "talk_noriko_3727be54"
msgid "Je ne pourrai jamais me pardonner pour tout ce que je t'ai fait subir."
msgstr "Aku gak bakal pernah bisa maafin diri aku sendiri buat semua yang udah aku bikin kamu alami."

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_noriko_8f3ab287"
msgid "M-"
msgstr "M-"

#. Character:`noriko` | Attributes:`afraid`
msgctxt "talk_noriko_65d8e093"
msgid "S'il te plaît, sors d'ici. J'arrêterai toute cette folie moi-même."
msgstr "Tolong, keluar dari sini. Aku bakal berhentiin semua kegilaan ini sendiri."

#. Character:`noriko`
msgctxt "talk_noriko_3f4e98e6"
msgid "Et plus jamais je ne donnerai de l'argent à qui que ce soit pour te faire du mal."
msgstr "Dan aku gak bakal pernah lagi ngasih uang ke siapapun buat nyakitin kamu."

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_noriko_68701303"
msgid "{{noriko.n}} j-"
msgstr "{{noriko.n}} j-"

#. Character:`noriko` | Attributes:`shame`
msgctxt "talk_noriko_c87216c5"
msgid "Va-t-en !"
msgstr "Pergi sana!"

#. Character:`akira`
msgctxt "menu_rejet_noriko_final_2cd7eae5"
msgid "Donc ça c'est ta chambre..."
msgstr "Jadi ini kamar kamu ya..."

#. Character:`akira`
msgctxt "menu_rejet_noriko_final_af78149d"
msgid "Intéressant, c'est plutôt sympa."
msgstr "Menarik, lumayan keren juga."

#. Character:`akira`
msgctxt "menu_rejet_noriko_final_23e7e2a3"
msgid "C'est à peu près ce à quoi je m'attendais."
msgstr "Ini kurang lebih sesuai sama yang aku expect."

#. Character:`noriko` | Attributes:`shame`
msgctxt "menu_rejet_noriko_final_38de776a"
msgid "Arrête de regarder partout comme ça !"
msgstr "Berhenti ngelihatin kemana-mana gitu dong!"

#. Character:`akira`
msgctxt "menu_rejet_noriko_final_42f7d168"
msgid "Pourquoi ? En quoi ça dérange ?"
msgstr "Kenapa? Emang ganggu apa?"

#. Character:`akira` | Attributes:`happy`
msgctxt "menu_rejet_noriko_final_59c9ebcb"
msgid "On a conclu un accord non ?"
msgstr "Kita udah sepakat kan?"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_d6e8a40a"
msgid "...[w] Oui..."
msgstr "...[w] Iya..."

#. Character:`akira`
msgctxt "menu_rejet_noriko_final_66524a55"
msgid "Donc on doit officialiser ça correctement."
msgstr "Jadi kita harus resminin ini dengan bener."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_86653964"
msgid "Je sais..."
msgstr "Aku tau..."

#. Character:`akira` | Attributes:`arrogant`
msgctxt "menu_rejet_noriko_final_1078c727"
msgid "Commence donc déjà par me sucer !"
msgstr "Mulai aja dulu dengan ngisepin aku!"

#. Character:`akira`
msgctxt "menu_rejet_noriko_final_21f49ad1"
msgid "Alors ? Tu attends quoi ?"
msgstr "Gimana? Kamu nunggu apa sih?"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_e71b20ff"
msgid "Je ne veux pas faire ça ici...h"
msgstr "Aku nggak mau ngelakuin ini di sini...h"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_df6d7189"
msgid "Ma mère pourrait rentrer à tout moment et je pourrais avoir des problèmes..."
msgstr "Ibuku bisa aja pulang kapan aja dan aku bisa kena masalah..."

#. Character:`akira` | Attributes:`arrogant`
msgctxt "menu_rejet_noriko_final_a9ff1c9a"
msgid "Ta mère peut nous rejoindre si tu veux verux, ça ne me dérange pas du tout !"
msgstr "Ibumu bisa gabung sama kita kalo mau, aku sih nggak masalah sama sekali!"

#. Character:`noriko` | Attributes:`angry`
msgctxt "menu_rejet_noriko_final_a65b6a2c"
msgid "Non mais ça va pas la tête ?!"
msgstr "Gila kamu, nggak waras ya?!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_13637dc2"
msgid "Il y a aussi {{saito.n}}... Je n'ai aucun contrôle sur ses allées-et-venues."
msgstr "Ada juga {{saito.n}}... Aku nggak bisa ngatur dia bolak-balik seenaknya."

#. Character:`akira`
msgctxt "menu_rejet_noriko_final_4b604da9"
msgid "...[w] Ça me donne une idée !"
msgstr "...[w] Aku dapat ide nih!"

#. Character:`akira`
msgctxt "menu_rejet_noriko_final_740b3d4b"
msgid "Montre moi sa chambre !"
msgstr "Tunjukin kamar dia ke aku!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_6b210338"
msgid "Quoi ?! Mais..."
msgstr "Apa?! Tapi..."

#. Character:`akira` | Attributes:`upset`
msgctxt "menu_rejet_noriko_final_68dbe274"
msgid "Discute pas !"
msgstr "Jangan ngomong banyak!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "menu_rejet_noriko_final_898b1990"
msgid "..."
msgstr "..."

#. Character:`yasuka`
msgctxt "menu_rejet_noriko_final_80661a29"
msgid "Mes chéris je dois vous laisser, j'ai une course à faire en ville."
msgstr "Sayang-sayang, aku harus ninggalin kalian dulu, ada urusan di kota."

#. Character:`yasuka`
msgctxt "menu_rejet_noriko_final_d772d9ce"
msgid "À plus tard !"
msgstr "Sampai nanti ya!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_60a76012"
msgid "[font_size=14]Elle est partie ?[/font_size]"
msgstr "[font_size=14]Dia udah pergi?[/font_size]"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_a438a2d4"
msgid "[font_size=14]Je crois...[/font_size]"
msgstr "[font_size=14]Kayaknya...[/font_size]"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_a4551ab0"
msgid "Alors qu'est ce que t'attends ? Un carton d'invitation ?!"
msgstr "Jadi kamu nunggu apaan sih? Undangan resmi gitu?!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_4ad7276e"
msgid "T'as toujours un caractère de merde !"
msgstr "Sifat kamu emang nyebelin banget!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_ed85b032"
msgid "T'attends quoi pour venir me punir ?"
msgstr "Kamu nunggu apa buat datang hukum aku?"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_926dc966"
msgid "Ohhh sale petite... Attends un peu !"
msgstr "Ohhh, bocah nakal... Tunggu bentar!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_ecb7c0fd"
msgid "Allez ! Arrête de vouloir me faire attendre..."
msgstr "Ayo! Berhenti bikin aku nunggu..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_b11d758e"
msgid "Je ne sais pas trop... J'hésite..."
msgstr "Aku nggak yakin nih... Bingung..."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_94c337ae"
msgid "Allez !"
msgstr "Ayo!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_a1c5c607"
msgid "Satisfaite ?"
msgstr "Puaskah kamu?"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_5efecf68"
msgid "... Tu peux refaire comme hier ?"
msgstr "... Kamu bisa ulangin kaya kemaren nggak?"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_ef2a085b"
msgid "Je peux !"
msgstr "Bisa!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_f3e074df"
msgid "Mmh c'est... encore mieux !"
msgstr "Mmh ini... malah makin enak!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_1f956caa"
msgid "Alors accroche-toi, je vais commencer à aller plus vite !"
msgstr "Jadi siap-siap, aku bakal mulai ngebut nih!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_5efa119c"
msgid "Quoi !? Non je suis pas encore..."
msgstr "Apa!? Enggak, aku belum..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_82186b9e"
msgid "Je m'en fiche !"
msgstr "Aku nggak peduli!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_dbcd1650"
msgid "Aaaah aaahh aaah"
msgstr "Aaaah aaahh aaah"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_abd71e16"
msgid "Plus vite, plus vite !"
msgstr "Cepet, cepet!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_a5fbaab1"
msgid "Je.... Putain c'est trop bon !"
msgstr "Aku... Sial, ini enak banget!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_d12ab627"
msgid "Et c'est encore que le début !"
msgstr "Dan ini baru awal doang!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_c5456ce7"
msgid "Prends-moi en levrette par derrière !"
msgstr "Bawa aku dari belakang, posisi doggy!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_b485483d"
msgid "Je veux tout essayer !"
msgstr "Aku mau coba semuanya!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_2c06a353"
msgid "Ohlàlà oui !"
msgstr "Wah iya, mantap!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_4a1a069b"
msgid "Oh putain !"
msgstr "Oh sialan!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_4023c988"
msgid "Plus vite, plus vite bordel !"
msgstr "Cepet, cepet banget, sialan!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_09ca2f4b"
msgid "Continue de te plaindre et je te laisse en plan !"
msgstr "Terus ngeluh, gua tinggalin kamu!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_115596c5"
msgid "Non ! Non ! Pardon !"
msgstr "Gak! Gak! Maaf!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_33622361"
msgid "Je te promets que je serai obéissante à présent !"
msgstr "Aku janji bakal nurut sekarang!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_e6268444"
msgid "À la bonne heure !"
msgstr "Pas banget!"

#. Character:`saito`
msgctxt "t9f474f55f7"
msgid "Tu sais je peux aussi arreter et aller voir ailleurs."
msgstr "Kamu tau kan aku juga bisa berhenti dan cari yang lain."

#. Character:`noriko`
msgctxt "t3948b597b1"
msgid "Si tu fais ça je pourrirais encore plus la vie qu'avant !"
msgstr "Kalau kamu ngelakuin itu, aku bakal bikin hidup kamu makin hancur dari sebelumnya!"

#. Character:`saito`
msgctxt "t3f9c49d299"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "td41137fc8e"
msgid "Je plaisantais ! Allez !"
msgstr "Aku cuma bercanda! Ayo!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_0bf3ffe0"
msgid "IL NE POURRA SE SORTIR DE CETTE SITUATION S'IL EST CONSTAMMENT SURPROTÉGÉ !"
msgstr "GAK BISA KELUAR DARI SITUASI INI KALAU TERUS TERLINDUNGI GILA-GILAAN!"

#. Character:`asami`
msgctxt "menu_rejet_noriko_final_a7153541"
msgid "LE METTRE EN DANGER N'EST PAS UNE SOLUTION NON PLUS !"
msgstr "NGEBUATNYA BERBAHAYA JUGA BUKAN SOLUSI!"

#. Character:`asami`
msgctxt "menu_rejet_noriko_final_ff63257f"
msgid "TU FAIS QUOI SI L'UN DE CES TROIS IDIOTS SORT UN COUTEAU ET..."
msgstr "APA YANG AKAN KAMU LAKUKAN JIKA SALAH SATU DARI TIGA ORANG BODOH ITU MENGELUARKAN PISAU DAN..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_e70e98c9"
msgid "Bon ça suffit, vous allez trop loin toutes les deux."
msgstr "Udah deh, kalian berdua udah kelewatan."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_3021a9c0"
msgid "Je me sens touché que vous vous fassiez autant de soucis pour moi mais j'aimerais quand même avoir mon mot à dire sur toute cette histoire."
msgstr "Aku ngerasa tersentuh loh kalian sampe segitunya peduli sama aku, tapi aku tetep pengen punya suara soal semua kejadian ini."

#. Character:`asami`
msgctxt "menu_rejet_noriko_final_c3703306"
msgid "Désolée..."
msgstr "Maaf ya..."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_8dbc4975"
msgid "Pfff si tu veux..."
msgstr "Pfff, kalo kamu mau..."

#. Character:`saito` | Attributes:`upset`
msgctxt "menu_rejet_noriko_final_f0b633f9"
msgid "Arrêtez de vous mêler de mes affaires !"
msgstr "Berhenti ikut campur urusan aku!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_e701ac91"
msgid "Si vous devez vous fâcher toutes les deux à cause de moi je préfère encore me débrouiller seul."
msgstr "Kalo kalian sampe marahan gara-gara aku, mending aku urusin sendiri aja."

#. Character:`asami`
msgctxt "menu_rejet_noriko_final_6a1adb7c"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_29cd7803_1"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_c32bd976"
msgid "Bon... Je peux savoir ce qui se p-"
msgstr "Oke... Aku boleh tau nih seb-"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_cb628197"
msgid "C'est moi !"
msgstr "Itu aku!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_39728dee"
msgid "Si tu te fais sans cesse harceler par les thugs c'est à cause de moi !"
msgstr "Kalo kamu terus-terusan diganggu sama preman itu gara-gara aku!"

#. Character:`saito` | Attributes:`upset`
msgctxt "menu_rejet_noriko_final_13292e4b"
msgid "Je ne suis pas sûr de comprendre... Pourquoi ce serait ta faute ?"
msgstr "Aku nggak yakin ngerti... Kenapa itu salah kamu?"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_438dad13"
msgid "C'est parce que je leur ai demandé de le faire."
msgstr "Soalnya aku yang nyuruh mereka buat ngelakuin itu."

#. Character:`saito` | Attributes:`angry`
msgctxt "menu_rejet_noriko_final_637ce628"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`sad`
msgctxt "menu_rejet_noriko_final_236905ba"
msgid "Ce qui explique pourquoi {{asami.n}} s'est mise en colère. Je comprend mieux a présent."
msgstr "Makanya {{asami.n}} jadi marah. Sekarang aku lebih paham."

#. Character:`saito` | Attributes:`upset`
msgctxt "menu_rejet_noriko_final_41aedebf"
msgid "Je veux une explication sinon crois moi j'en ai terminé avec toi."
msgstr "Aku mau penjelasan, kalo nggak percaya deh, aku udah selesai sama kamu."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_b788d0f7"
msgid "...Je... J'en avais plus qu'assez..."
msgstr "...Aku... Aku bener-bener udah muak..."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_fb0870e4"
msgid "Tu te fais harceler depuis tellement longtemps, tu ne disais rien a personne."
msgstr "Kamu udah lama banget dibully, tapi nggak pernah bilang ke siapa-siapa."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_b79539b1"
msgid "Tu étais trop gentil avec tous les autres... Tu te faisais marcher sur les pieds sans jamais lever la voix."
msgstr "Kamu terlalu baik sama semua orang... Kamu diem aja waktu diinjek-in tanpa pernah ngelawan."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_7200eb5a"
msgid "Tu t'es laissé faire en pensant que ça passerait avec le temps."
msgstr "Kamu ngalah karena mikirnya bakal kelar sendiri seiring waktu."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_ba9834eb"
msgid "Ils t'ont fait vivre un enfer."
msgstr "Mereka bikin kamu hidup kayak neraka."

#. Character:`noriko` | Attributes:`angry`
msgctxt "menu_rejet_noriko_final_08ff9204"
msgid "Je voulais que tu réagisses... Que pour une fois tu puisses faire face."
msgstr "Aku pengen kamu bereaksi... Biar sekali aja kamu bisa ngadepin semuanya."

#. Character:`noriko` | Attributes:`shame`
msgctxt "menu_rejet_noriko_final_e21dc606"
msgid "Alors..."
msgstr "Jadi..."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_f22f2d10"
msgid "J'ai demandé aux thugs de te mener la vie dure pour qu'un jour tu prennes confiance en toi et que tu t'affirmes."
msgstr "Aku suruh para preman itu buat bikin hidup kamu susah biar suatu hari kamu percaya diri dan bisa tegas."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_7999945b"
msgid "Ces trois idiots ne valent rien !"
msgstr "Tiga bodoh itu nggak ada nilainya!"

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_e9bd6bd0"
msgid "Facile à dire..."
msgstr "Mudah banget ngomongnya..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "menu_rejet_noriko_final_ad2285e9"
msgid "ILS NE VALENT RIEN !"
msgstr "MEREKA EMANG NGGAK ADA NILAINYA!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "menu_rejet_noriko_final_cc4ca906"
msgid "Je ne sais pas pourquoi tu es si effrayé par eux mais ils ne sont rien..."
msgstr "Aku nggak ngerti kenapa kamu takut banget sama mereka, tapi mereka cuma omong kosong..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_406dcdec"
msgid "C'est quand même fou... C'est moi qui ai subi tout ça... et tu me donnes l'impression d'avoir été la victime."
msgstr "Gila juga sih... Aku yang harus ngadepin semua itu... tapi kamu malah kayak korban."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_216311fa"
msgid "C'est..."
msgstr "Ini..."

#. Character:`saito` | Attributes:`sad`
msgctxt "menu_rejet_noriko_final_67f017b0"
msgid "Bref... J'en ai assez entendu pour aujourd'hui je crois."
msgstr "Pokoknya... Kayaknya aku cukup dengerin hari ini."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_fb95b21e"
msgid "Je vais...[w] J'ai besoin de faire le point."
msgstr "Aku mau...[w] Butuh waktu buat mikir."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_8f035b01"
msgid "Non ! Ne pars pas !"
msgstr "Nggak! Jangan pergi!"

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_e196db52"
msgid "J'ai été odieuse je le sais, a cause de moi tu as souffert mais je voulais seulement arranger les choses, je voulais..."
msgstr "Aku sadar aku udah kejam, gara-gara aku kamu menderita tapi aku cuma pengen benerin semuanya, aku cuma pengen..."

#. Character:`saito` | Attributes:`happy`
msgctxt "menu_rejet_noriko_final_ae7a3404"
msgid "{{noriko.n}}... Même si je t'ai détesté voir hais toutes ces années... Comprendre enfin la raison derrière tout ça me fait voir les choses sous un autre angle."
msgstr "{{noriko.n}}... Meskipun aku benci dan benci banget sama kamu selama bertahun-tahun... akhirnya ngerti alasan di balik semua ini bikin aku lihat semuanya dari sudut pandang lain."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_6fa2a78d"
msgid "Laisse moi faire le tri dans mes idées et je te promets que que ça ira mieux demain."
msgstr "Biarin aku rapihin pikiran dulu, aku janji besok bakal lebih baik."

#. Character:`noriko`
msgctxt "menu_rejet_noriko_final_ec5e0aba"
msgid "D'accord..."
msgstr "Oke..."

#. Character:`narrator`
msgctxt "menu_rejet_noriko_final_f4a3689b"
msgid "Merde... Si j'avais su tout ça avant..."
msgstr "Sialan... Kalau aku tahu semua ini dari dulu..."

#. Character:`narrator`
msgctxt "menu_rejet_noriko_final_8861fab6"
msgid "J'étais à ce point pathétique.."
msgstr "Ternyata aku sebegitu payahnya.."

#. Character:`narrator`
msgctxt "menu_rejet_noriko_final_db51f401"
msgid "En pensant pouvoir gérer mes problèmes moi-même je me rends compte que je n'ai fait qu'inquiéter ceux qui tenaient à moi."
msgstr "Sangka bisa ngurus masalah sendiri, ternyata cuma bikin yang peduli sama aku makin khawatir."

#. Character:`narrator`
msgctxt "menu_rejet_noriko_final_9f91fa65"
msgid "J'étais vraiment à côté de la plaque."
msgstr "Aku bener-bener salah kaprah."

#. Character:`noriko`
msgctxt "talk_noriko_95fd66a9"
msgid "Prêt pour ta récompense ?"
msgstr "Siap buat dapetin hadiahnya?"

#. Character:`saito`
msgctxt "talk_noriko_18a5829e"
msgid "Quoi ?! Mais... Je croyais que tu allais juste..."
msgstr "Apa?! Tapi... Aku kira kamu cuma mau..."

#. Character:`noriko`
msgctxt "talk_noriko_0e7d3bd5"
msgid "Faire un gâteau ?"
msgstr "Bikin kue?"

#. Character:`noriko` | Attributes:`bad,blush`
msgctxt "talk_noriko_78e4fd33"
msgid "Comment tu as pu penser un truc pareil ?"
msgstr "Gimana bisa kamu mikir hal kayak gitu?"

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_noriko_0b7519e0"
msgid "Je me le demande...[w] Et donc ? Pourquoi tu es... nue ?"
msgstr "Aku juga gak ngerti...[w] Jadi? Kenapa kamu... telanjang?"

#. Character:`noriko`
msgctxt "talk_noriko_0cb72bb2"
msgid "Tu vas bien manger mais pas ce que tu croyais.."
msgstr "Kamu bakal makan enak tapi bukan yang kamu kira.."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_noriko_695320b8"
msgid "J'ai pas envie de jouer a ça {{noriko.n}} !"
msgstr "Aku gak pengen main-main kayak gini {{noriko.n}}!"

#. Character:`noriko`
msgctxt "talk_noriko_6bf1a80d"
msgid "Ah oui ? Tu es sur de toi, c'est probablement ta seule chance..."
msgstr "Oh ya? Kamu yakin? Ini mungkin satu-satunya kesempatan kamu..."

#. Character:`noriko`
msgctxt "talk_noriko_659c843b"
msgid "Tu va la saisir ou te comporter comme un lâche une fois de plus ?"
msgstr "Kamu mau ambil atau bakal ngelakuin pengecut lagi?"

#. Character:`saito`
msgctxt "talk_noriko_5852b62f"
msgid "Mais bordel jusqu'ou tu compte aller pour..."
msgstr "Sialan, sampai sejauh mana sih kamu mau ngelakuin ini..."

#. Character:`noriko` | Attributes:`neutral,blush`
msgctxt "talk_noriko_f46dbb43"
msgid "C'est maintenant que tu dois te décider !"
msgstr "Sekarang saatnya kamu harus mutusin!"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "choice_noriko_cunni_97d407ad"
msgid "Tu es sur de toi ?"
msgstr "Kamu yakin?"

#. Character:`noriko`
msgctxt "choice_noriko_cunni_78240909"
msgid "Tu risques probablement de le regretter tu sais..."
msgstr "Kamu mungkin bakal nyesel, tau gak..."

#. Character:`noriko` | Attributes:`shame,blush`
msgctxt "choice_noriko_cunni_7844d295"
msgid "..."
msgstr "..."

#. Character:`narrator`
msgctxt "t408003a491"
msgid "Je ne jouerai pas à tes jeux pervers !"
msgstr "Aku gak bakal mainin permainan mesum kamu!"

#. Character:`narrator`
msgctxt "tc771d71017"
msgid "Finalement... Pourquoi pas ?"
msgstr "Akhirnya... Kenapa enggak?"

#. Character:`narrator`
msgctxt "t14df079ce9"
msgid "Sortir de la chambre"
msgstr "Keluar dari kamar"

#. Character:`narrator`
msgctxt "t9493cdfee5"
msgid "Plonger sa tête entre les cuisses de {{noriko.n}}"
msgstr "Naruh kepala di antara paha {{noriko.n}}"

#. Character:`noriko`
msgctxt "t5c0f6cf729"
msgid "Allez ne soit pas timide !"
msgstr "Ayo jangan malu-malu gitu!"

#. Character:`noriko`
msgctxt "td96b0485c7"
msgid "Ces derniers temps tu avais la langue bien pendue."
msgstr "Belakangan ini kamu tuh ngomongnya lancar banget."

#. Character:`noriko`
msgctxt "t8aa812a473"
msgid "Autant rendre ça... utile."
msgstr "Mending kita bikin ini... berguna."

#. Character:`saito`
msgctxt "tc86cddc9dc"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "t782c2647ba"
msgid "C'est... pas mal... C'est la première fois que tu fais ça ?"
msgstr "Ini... lumayan... Ini pertama kali kamu ngelakuinnya ya?"

#. Character:`noriko`
msgctxt "t2617e12123"
msgid "Voilà c'est mieux.. Oh ! Oui, beaucoup mieux."
msgstr "Nah, itu lebih oke.. Oh! Iya, jauh lebih oke."

#. Character:`noriko`
msgctxt "tee9d9c26a5"
msgid "mhhh... oui... ouiiii"
msgstr "mhhh... iya... ouiiii"

#. Character:`noriko`
msgctxt "t1445c48258"
msgid "Oh bon sang !"
msgstr "Astaga!"

#. Character:`noriko`
msgctxt "t62f9a14f41"
msgid "Ahhh Ah ça vient !"
msgstr "Ahhh Ah itu dia!"

#. Character:`noriko`
msgctxt "t8260429204"
msgid "Oh mon dieu oui..."
msgstr "Astaga iya..."

#. Character:`noriko`
msgctxt "t0cf6c1a1fa"
msgid "Qui aurait cru que tu cachais ce talent ?"
msgstr "Siapa sangka kamu nyimpen bakat kayak gini?"

#. Character:`saito`
msgctxt "tcab9fc6df0"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "t6b92b65428"
msgid "Tu ne t'es pas fait prier en tout cas."
msgstr "Kamu juga nggak minta-minta buat ini kan."

#. Character:`noriko`
msgctxt "t8379656e4a"
msgid "Peut-être que tu attendais ça depuis longtemps ?"
msgstr "Mungkin kamu udah nungguin ini dari lama ya?"

#. Character:`noriko`
msgctxt "choice_noriko_cunni_391e7ae0"
msgid "Hmmm ça suffit !"
msgstr "Hmmm, cukup deh!"

#. Character:`noriko`
msgctxt "choice_noriko_cunni_0295de52"
msgid "On se revoit demain pour la prochaine étape."
msgstr "Kita ketemu lagi besok buat tahap selanjutnya."

#. Character:`saito` | Attributes:`guilty`
msgctxt "choice_noriko_cunni_1550b49a"
msgid "Mais je..."
msgstr "Tapi aku..."

#. Character:`noriko` | Attributes:`shame`
msgctxt "choice_noriko_cunni_c76ed81b"
msgid "...Encore un peu plus et je lui aurais sauté dessus..."
msgstr "...Sedikit lagi aku udah pengen banget nyeruduk dia..."

#. Character:`saito`
msgctxt "menu_rejet_noriko_final_dcc20267"
msgid "Non elle n'est pas là visiblement..."
msgstr "Nggak, dia kayaknya nggak di sini..."

#. Character:`yasuka`
msgctxt "menu_rejet_noriko_final_758bf0c1"
msgid "Tu cherches {{noriko.n}} mon chéri ?"
msgstr "Kamu nyari {{noriko.n}} sayang?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "menu_rejet_noriko_final_60da636f"
msgid "Elle n'est pas à la maison ?"
msgstr "Dia nggak di rumah?"

#. Character:`yasuka` | Attributes:`sad`
msgctxt "menu_rejet_noriko_final_ef39e117"
msgid "Non... Elle est partie tôt ce matin, elle n'avait pas l'air dans son assiette."
msgstr "Nggak... Dia pergi pagi-pagi, kayaknya lagi nggak enak badan."

#. Character:`yasuka`
msgctxt "menu_rejet_noriko_final_f1d28687"
msgid "Je suis inquiète, tu crois que tu pourrais...?"
msgstr "Aku khawatir, kamu pikir kamu bisa...?"

#. Character:`saito` | Attributes:`upset`
msgctxt "menu_rejet_noriko_final_00719994"
msgid "Je m'en occupe !"
msgstr "Aku urus deh!"

#. Character:`noriko`
msgctxt "tbe8eb9f805"
msgid "Allez à poil !"
msgstr "Ayo telanjang!"

#. Character:`saito`
msgctxt "t7d4b07f29c"
msgid "Quoi ?! Là comme ça en plein milieu de la journée ?"
msgstr "Apa?! Di sini gitu aja tengah hari bolong?"

#. Character:`noriko` | Attributes:`bad`
msgctxt "t2bdcab08ea"
msgid "Tu as mieux à faire peut-être ?"
msgstr "Mungkin kamu ada hal lain yang lebih penting?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "tf1658c74d0"
msgid "Non mais..."
msgstr "Gak, tapi..."

#. Character:`noriko`
msgctxt "t7670df62f8"
msgid "Et bien alors, qu'est ce que tu attend ?"
msgstr "Ya terus, kamu nunggu apa?"

#. Character:`noriko`
msgctxt "BORDEL_CE_N_EST_PLUS_POSSIBLE_ED2BE1"
msgid "Bordel... Ce n'est plus possible !"
msgstr "Sialan... Gak bisa ditoleransi lagi!"

#. Character:`noriko` | Attributes:`angry`
msgctxt "JE_D_TESTE_CETTE_SITUATION_00B4A0"
msgid "Je déteste cette situation !"
msgstr "Aku benci situasi ini!"

#. Character:`noriko`
msgctxt "JE_D_TESTE_RESTER_COINC_E_ICI_6687E5"
msgid "Je déteste rester coincée ici !"
msgstr "Aku benci jadi terjebak di sini!"

#. Character:`noriko`
msgctxt "JE_D_TESTE_CES_FOUTUS_THUGS_582AE7"
msgid "Je déteste ces foutus thugs !"
msgstr "Aku benci bajingan-bajingan sialan ini!"

#. Character:`noriko`
msgctxt "JE_D_TESTE_CE_PUTAIN_DE_FLIC_A7B174"
msgid "Je déteste ce putain de flic !"
msgstr "Aku benci polisi sialan ini!"

#. Character:`noriko`
msgctxt "JE_LES_D_TESTE_TOUS_68AC10"
msgid "Je les déteste tous !!!"
msgstr "Aku benci semuanya!!!"

#. Character:`noriko`
msgctxt "RHAAAAA_786D8E"
msgid "Rhaaaaa !"
msgstr "Rhaaaaa!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "JE_VAIS_DEVENIR_FOLLE_ABCA98"
msgid "Je vais devenir folle..."
msgstr "Aku bakal gila..."

#. Character:`noriko`
msgctxt "MAMAN_B7A376"
msgid "Maman...!"
msgstr "Mami...!"

#. Character:`noriko`
msgctxt "JE_DEVIENS_FOLLE_JE_NE_PARVIEN_B9E7A7"
msgid "Je deviens folle, je ne parviens plus à rester calme !"
msgstr "Aku makin gila, gak bisa tenang lagi!"

#. Character:`noriko`
msgctxt "COMMENT_FAIS_TU_POUR_NE_PAS_EX_5E58CC"
msgid "Comment fais-tu pour ne pas exploser ?"
msgstr "Gimana caranya kamu gak meledak?"

#. Character:`noriko`
msgctxt "J_AI_JUSTE_ENVIE_D_HURLER_849585"
msgid "J'ai juste envie d'hurler..."
msgstr "Aku cuma pengen teriak..."

#. Character:`noriko`
msgctxt "MAMAN_W_TOUT_VA_BIEN_9E14F0"
msgid "Maman ?[w] Tout va bien ?"
msgstr "Mami?[w] Apa semuanya baik-baik aja?"

#. Character:`yasuka` | Attributes:`depressed`
msgctxt "JE_SUIS_D_SOL_E_MA_CH_RIE_JE_S_08CE73"
msgid "Je suis désolée ma chérie, je suis un peu préoccupée en ce moment."
msgstr "Maaf ya sayang, aku lagi agak pusing sekarang."

#. Character:`noriko`
msgctxt "TU_PARLES_DE_SAITO_N_ED978A"
msgid "Tu parles de {{saito.n}} ?"
msgstr "Kamu ngomongin {{saito.n}}?"

#. Character:`yasuka` | Attributes:`sad`
msgctxt "PAS_SEULEMENT_SAYURI_N_LA_M_RE_35E8EA"
msgid "Pas seulement... {{sayuri.n}}, la mère d'{{asami.n}}, est coincée chez elle depuis deux jours. Ils ont également un agent de police qui la surveille."
msgstr "Gak cuma itu... {{sayuri.n}}, ibu dari {{asami.n}}, udah terjebak di rumahnya selama dua hari. Mereka juga punya polisi yang jagain dia."

#. Character:`noriko` | Attributes:`angry`
msgctxt "COMME_NOUS_E65F81"
msgid "Comme nous..."
msgstr "Kayak kita juga..."

#. Character:`yasuka` | Attributes:`upset`
msgctxt "NON_C_EST_DIFF_RENT_ILS_M_EMP_D95AC9"
msgid "Non, c'est différent, ils m'empêchent d'aller la voir."
msgstr "Nggak, beda, mereka ngelarang aku buat ngunjungin dia."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "JE_L_AI_ENTENDUE_CRIER_ET_JE_N_D37873"
msgid "Je l'ai entendue crier et je ne crois pas à leurs explications."
msgstr "Aku denger dia teriak dan aku nggak percaya sama alasan mereka."

#. Character:`yasuka`
msgctxt "ILS_SONT_S_REMENT_EN_TRAIN_DE_E0B82F"
msgid "Ils sont sûrement en train de lui faire quelque chose et il m'est impossible de lui venir en aide."
msgstr "Mereka pasti lagi ngelakuin sesuatu ke dia dan aku gak bisa nolongin dia."

#. Character:`yasuka`
msgctxt "ILS_CACHENT_D_FINITIVEMENT_QUE_E4962B"
msgid "Ils cachent définitivement quelque chose..."
msgstr "Mereka pasti nyembunyiin sesuatu..."

#. Character:`noriko` | Attributes:`afraid`
msgctxt "TOUT_A_EST_COMPL_TEMENT_FOU_D06408"
msgid "Tout ça est complètement fou !"
msgstr "Semua ini gila banget!"

#. Character:`noriko`
msgctxt "TU_VEUX_DIRE_QU_ILS_SONT_TOUS_8BCDD4"
msgid "Tu veux dire qu'ils sont tous corrompus ?"
msgstr "Maksud kamu mereka semua korupsi ya?"

#. Character:`yasuka` | Attributes:`upset`
msgctxt "JE_NE_SAIS_PAS_0E0A05"
msgid "Je ne sais pas..."
msgstr "Aku nggak tau..."

#. Character:`yasuka`
msgctxt "J_AI_BEAU_ME_CREUSER_LA_T_TE_J_C53737"
msgid "J'ai beau me creuser la tête, je ne trouve pas de solution."
msgstr "Udah pusing banget mikirin, tapi aku nggak nemu solusi."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "TROUVER_DE_L_AIDE_EST_COMPLIQU_B89A50"
msgid "Trouver de l'aide est compliqué quand tu ne sais plus à qui tu peux faire confiance."
msgstr "Mencari bantuan itu ribet banget kalau kamu udah nggak tau lagi siapa yang bisa kamu percaya."

#. Character:`noriko` | Attributes:`shame`
msgctxt "C_EST_DONC_UNE_SITUATION_D_SES_ED0891"
msgid "C'est donc une situation désespérée... hmmm..."
msgstr "Jadi ini bener-bener situasi putus asa... hmmm..."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "DANS_CE_CAS_J_AI_PEUT_TRE_QUEL_37553A"
msgid "Dans ce cas, j'ai peut-être quelqu'un de parfait pour ça !"
msgstr "Kalau gitu, mungkin aku punya orang yang pas buat itu!"

#. Character:`noriko`
msgctxt "SUIS_MOI_0A0AA7"
msgid "Suis-moi !"
msgstr "Ikutin aku!"

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "O_ALLONS_NOUS_472BDB"
msgid "Où allons-nous ?"
msgstr "Kita mau kemana?"

#. Character:`noriko`
msgctxt "FAIS_MOI_CONFIANCE_18E321"
msgid "Fais-moi confiance !"
msgstr "Percaya aja sama aku!"

#. Character:`narrator`
msgctxt "JE_DOIS_RESTER_DISCRET_LE_TEMP_427DD5"
msgid "Je dois rester discret le temps de trouver une solution."
msgstr "Aku harus jaga-jaga dulu sambil nyari solusi."

#. Character:`saito`
msgctxt "restaurant_exterior_17076e69"
msgid "Je ne me trompais pas, ici ça recrute !"
msgstr "Aku nggak salah, di sini bener-bener lagi nyari orang!"

#. Character:`saito`
msgctxt "restaurant_exterior_7d8bfc6e"
msgid "Voyons voir... Un restaurant spécialisé dans les Udons..."
msgstr "Coba liat... Restoran yang spesialisasi di Udons..."

#. Character:`saito`
msgctxt "restaurant_exterior_d40c32b9"
msgid "C'est encore mieux !"
msgstr "Malah jadi makin enak!"

#. Character:`saito`
msgctxt "restaurant_exterior_7739e333"
msgid "Alors..."
msgstr "Jadi..."

#. Character:`narrator`
msgctxt "restaurant_exterior_94d9a438"
msgid "[i]Nous cherchons un jeune homme dynamique, volontaire et en bonne condition physique.[/i]"
msgstr "[i]Kami nyari cowok muda yang enerjik, mau kerja, dan kondisi fisiknya oke.[/i]"

#. Character:`saito`
msgctxt "restaurant_exterior_d68b3175"
msgid "C'est tout moi ça !"
msgstr "Itu emang aku banget!"

#. Character:`narrator`
msgctxt "restaurant_exterior_6f34aff7"
msgid "[i]Horaires souples, idéals pour étudiants.[/i]"
msgstr "[i]Jam kerja fleksibel, cocok banget buat mahasiswa.[/i]"

#. Character:`saito`
msgctxt "restaurant_exterior_9dbf3c2c"
msgid "En vacances en ce moment donc pour la disponibilité, c'est bon !"
msgstr "Lagi liburan sekarang, jadi soal ketersediaan, aman deh!"

#. Character:`narrator`
msgctxt "restaurant_exterior_ed610b5d"
msgid "[i]Promotion possible si travailleur dévoué.[/i]"
msgstr "[i]Promosi mungkin kalau kerja keras banget.[/i]"

#. Character:`saito`
msgctxt "restaurant_exterior_33c269b3"
msgid "Selon mon rêve, je n'ai fait que des boulots ingrats, donc faire la plonge ne devrait pas poser de problème."
msgstr "Menurut mimpi aku, aku cuma dapet kerjaan yang nggak enak, jadi cuci piring pasti nggak masalah."

#. Character:`narrator`
msgctxt "restaurant_exterior_4dacbbb1"
msgid "[i]600¥/h URGENT[/i]"
msgstr "[i]600¥/jam DARURAT[/i]"

#. Character:`saito`
msgctxt "restaurant_exterior_aea3e315"
msgid "Ça m'a l'air pas trop mal !"
msgstr "Kayaknya sih nggak terlalu buruk!"

#. Character:`narrator`
msgctxt "restaurant_exterior_753b7a2e"
msgid "Je crois que le chef prend sa pause, c'est peut-être le moment ou jamais."
msgstr "Kayaknya si bos lagi istirahat, mungkin ini saatnya."

#. Character:`chef`
msgctxt "talk_chef_dd15909a"
msgid "Pourquoi tu me fixes, gamin ?"
msgstr "Kenapa kamu ngeliatin aku, bocah?"

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_chef_36ee4570"
msgid "Je... J'ai vu votre annonce et... J'aimerais postuler pour l'offre !"
msgstr "Aku... Aku liat iklan kamu dan... Aku mau daftar buat lowongannya!"

#. Character:`saito`
msgctxt "talk_chef_99a1d326"
msgid "S'il vous plait !"
msgstr "Tolong dong!"

#. Character:`chef`
msgctxt "talk_chef_b7ecfc18_1"
msgid "..."
msgstr "..."

#. Character:`chef` | Attributes:`angry`
msgctxt "talk_chef_899e1d32"
msgid "C'est une blague ?"
msgstr "Ini guyonan ya?"

#. Character:`chef`
msgctxt "talk_chef_188a662c"
msgid "Allez, tire-toi de là, ne me fais pas perdre mon temps !"
msgstr "Ayo, cabut sana, jangan buang-buang waktu aku!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_chef_3ea7f0e7"
msgid "Mais..."
msgstr "Tapi..."

#. Character:`chef`
msgctxt "talk_chef_99ce78ce"
msgid "Allez, du balai, dégage !"
msgstr "Ayo, cabut sana, pergi sana!"

#. Character:`chef` | Attributes:`mocking`
msgctxt "talk_chef_aa351982"
msgid "Je n'ai jamais vu une loque pareille..."
msgstr "Aku belum pernah liat orang selemah itu..."

#. Character:`chef`
msgctxt "talk_chef_dae01123"
msgid "Reviens quand tu auras des muscles !"
msgstr "Balik lagi kalau kamu udah ada otot!"

#. Character:`saito`
msgctxt "talk_chef_03775ec8"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_chef_e5b4e709"
msgid "Putain, mais quel connard !"
msgstr "Sialan, dasar bajingan!"

#. Character:`chef` | Attributes:`angry`
msgctxt "talk_chef_40031217"
msgid "Bon, tu commences sérieusement à me faire chier gamin !"
msgstr "Oke, kamu mulai bener-bener bikin aku kesel, bocah!"

#. Character:`chef`
msgctxt "talk_chef_31f7b49e"
msgid "Arrête de me faire perdre mon temps !"
msgstr "Berhenti bikin aku buang-buang waktu!"

#. Character:`chef`
msgctxt "talk_chef_09b232f9"
msgid "J'ai un putain de restaurant à diriger et il me faut des employés qui ne vont pas s'effondrer au moindre courant d'air !"
msgstr "Aku punya restoran sialan yang harus aku jalanin dan aku butuh pegawai yang gak langsung ambruk kena angin sepoi-sepoi!"

#. Character:`saito`
msgctxt "talk_chef_863d75ab"
msgid "Je... Ferait le nécessaire !"
msgstr "Aku... bakal lakuin yang perlu!"

#. Character:`saito`
msgctxt "talk_chef_9d28c10f"
msgid "Si dans les jours qui viennent, vous ne trouvez personne, vous me laisserez une autre chance ?"
msgstr "Kalau beberapa hari ke depan kalian gak nemu siapa-siapa, kalian bakal kasih aku kesempatan lagi gak?"

#. Character:`chef` | Attributes:`mocking`
msgctxt "talk_chef_a3f6f516"
msgid "Bah voyons, gamin, tu places la barre un peu haut. Mais soit..."
msgstr "Ya udah, bocah, kamu naruh standar lumayan tinggi. Tapi ya udah..."

#. Character:`chef`
msgctxt "talk_chef_1c7e9081"
msgid "J'accepte, montre-moi ce que tu as dans le ventre..."
msgstr "Aku terima, tunjukin apa yang kamu punya..."

#. Character:`chef`
msgctxt "talk_chef_46e1700a"
msgid "Si impatient que ça de commencer gamin ? Continue de t'entraîner, tu ne tiendras jamais le rythme."
msgstr "Keburu banget pengen mulai, bocah? Terus latihan aja, kamu nggak bakal kuat sama ritmenya."

#. Character:`chef`
msgctxt "talk_chef_a039f7d6"
msgid "Laisse-moi savourer ma pause, gamin."
msgstr "Biarin aku nikmatin istirahat dulu, bocah."

#. Character:`chef`
msgctxt "talk_chef_a09ad975"
msgid "Tu n'as pas des trucs à faire ?"
msgstr "Kamu nggak ada kerjaan lain ya?"

#. Character:`akira`
msgctxt "restaurant_exterior_2517edc1"
msgid "...et pourquoi pas, {{sakuya.n}} ?"
msgstr "...dan kenapa nggak, {{sakuya.n}}?"

#. Character:`akira`
msgctxt "restaurant_exterior_2074f98b"
msgid "Je t'assure que sortir avec moi sera la meilleure décision de ta vie."
msgstr "Aku jamin keluar sama aku bakal jadi keputusan terbaik dalam hidup kamu."

#. Character:`sakuya`
msgctxt "restaurant_exterior_7d45ccf7"
msgid "Je... Je ne sais pas, j'ai besoin de temps pour y réfléchir."
msgstr "Aku... Aku nggak tau, butuh waktu buat mikir."

#. Character:`akira`
msgctxt "restaurant_exterior_5a3a13bb"
msgid "À un moment, réfléchir devient contre-productif, tu sais. Tu es une femme qui sait ce qu'elle veut."
msgstr "Kadang mikir itu malah bikin nggak efektif, tau nggak. Kamu cewek yang tau apa yang kamu mau."

#. Character:`akira`
msgctxt "restaurant_exterior_07012011"
msgid "Tu as le droit d'être impulsive de temps en temps."
msgstr "Kamu boleh kok kadang-kadang ngelakuin sesuatu secara impulsif."

#. Character:`akira`
msgctxt "restaurant_exterior_53baa3b9"
msgid "En particulier quand ce genre d'occasion se présente à toi."
msgstr "Apalagi pas kesempatan kayak gini dateng ke kamu."

#. Character:`akira`
msgctxt "restaurant_exterior_8ca637a3"
msgid "Ton rêve... Je ferais tout pour le réaliser."
msgstr "Mimpi kamu... Aku bakal lakuin apa aja buat wujudinnya."

#. Character:`akira`
msgctxt "restaurant_exterior_b076dd8f"
msgid "Et même bien plus encore."
msgstr "Bahkan lebih dari itu."

#. Character:`akira`
msgctxt "restaurant_exterior_15adb43e"
msgid "Pour une fois, oublie un peu toutes ces obligations."
msgstr "Sekali-kali, lupain dulu semua kewajiban itu."

#. Character:`sakuya`
msgctxt "restaurant_exterior_031ba670"
msgid "..."
msgstr "..."

#. Character:`akira`
msgctxt "restaurant_exterior_8ff9db19"
msgid "Tu passes ta vie à travailler pour ton père dans son restaurant pourri."
msgstr "Kamu habisin hidup cuma buat kerja di restoran bobrok bapak kamu."

#. Character:`akira`
msgctxt "restaurant_exterior_f3acd951"
msgid "Sans perspective d'avenir."
msgstr "Gak ada masa depan sama sekali."

#. Character:`akira`
msgctxt "restaurant_exterior_57616eb6"
msgid "Tu as le droit d'être heureuse et de penser à toi avant de toujours penser aux autres."
msgstr "Kamu punya hak buat bahagia dan mikirin diri sendiri sebelum terus-terusan mikirin orang lain."

#. Character:`sakuya`
msgctxt "restaurant_exterior_0b05caf3"
msgid "Tu as raison !"
msgstr "Kamu benar!"

#. Character:`akira`
msgctxt "restaurant_exterior_c0bba6cc"
msgid "Bien sûr que j'ai raison."
msgstr "Tentu aja aku bener."

#. Character:`akira`
msgctxt "restaurant_exterior_3b036fdd"
msgid "Je vais t'embrasser à présent."
msgstr "Sekarang aku bakal cium kamu."

#. Character:`akira`
msgctxt "restaurant_exterior_afd8d0d4"
msgid "Scellons notre accord."
msgstr "Kita ikat kesepakatan ini."

#. Character:`sakuya`
msgctxt "tc560d7eed2"
msgid "Non ! Je ne veux pas, c'est hors de question !"
msgstr "Gak! Aku gak mau, itu gak boleh!"

#. Character:`akira`
msgctxt "restaurant_exterior_dac976c1"
msgid "Shhhhhh, il est trop tard pour revenir en arrière, laisse-toi faire."
msgstr "Shhhhhh, udah telat buat mundur, santai aja deh."

#. Character:`akira`
msgctxt "restaurant_exterior_8f68ff84"
msgid "...Putain {{saito.n}} tu vas rester combien de temps à mater ?"
msgstr "...Sialan {{saito.n}} kamu mau ngintip berapa lama?"

#. Character:`akira`
msgctxt "restaurant_exterior_5c8eea65"
msgid "Casse-toi ! Tu captes pas l'ambiance ?"
msgstr "Pergi sana! Kamu gak ngerasain suasananya apa?"

#. Character:`saito`
msgctxt "restaurant_exterior_7ef6bf2c"
msgid "Je ne suis pas celui qui a un problème pour lire l'ambiance."
msgstr "Aku bukan yang nggak ngerti suasana."

#. Character:`saito`
msgctxt "restaurant_exterior_cecaa001"
msgid "Il me semble qu'elle ne veut pas t'embrasser."
msgstr "Kayaknya dia gak mau nyium kamu."

#. Character:`akira` | Attributes:`angry`
msgctxt "restaurant_exterior_03e6dadc"
msgid "...Tu commences sérieusement à me casser les couilles."
msgstr "...Kamu mulai bener-bener ngeselin aku."

#. Character:`akira`
msgctxt "restaurant_exterior_d243728f"
msgid "Barre-toi maintenant ou je te jure que..."
msgstr "Pergi sekarang atau aku sumpahin..."

#. Character:`narrator`
msgctxt "restaurant_exterior_c48d66f6"
msgid "Je me suis assez fait écraser par {{akira.n}} dans ma vie d'avant !"
msgstr "Aku udah cukup sering diinjek sama {{akira.n}} di hidup aku sebelumnya!"

#. Character:`narrator`
msgctxt "restaurant_exterior_01183ae4"
msgid "Je dois lui rentrer dedans."
msgstr "Aku harus lawan dia."

#. Character:`narrator`
msgctxt "restaurant_exterior_55052cde"
msgid "Je ne dois plus me laisser faire."
msgstr "Aku gak boleh diem aja lagi."

#. Character:`narrator`
msgctxt "restaurant_exterior_2688927e"
msgid "Je vais lui en coller une !"
msgstr "Aku bakal tampar dia!"

#. Character:`saito` | Attributes:`neutral`
msgctxt "restaurant_exterior_3d5eb5fc"
msgid "Je..."
msgstr "Aku..."

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_58bfb8e8"
msgid "...et merde."
msgstr "...sialan."

#. Character:`chef` | Attributes:`angry`
msgctxt "restaurant_exterior_0d8a2293"
msgid "Espèce de salle vaurien, écarte-toi de ma fille !"
msgstr "Dasar bajingan kotor, jauh-jauh dari cewek aku!"

#. Character:`chef`
msgctxt "restaurant_exterior_eebce560"
msgid "Tire-toi vite d'ici ou je te jure que ta petite gueule d'ange va finir sur le grill de mon restaurant pourri."
msgstr "Cabut dari sini cepet, atau aku jamin muka imut kamu bakal berakhir di panggangan restoran aku yang becek ini."

#. Character:`akira` | Attributes:`upset`
msgctxt "restaurant_exterior_bb6b5760"
msgid "Ahem... Ce n'est pas ce que je voulais d-"
msgstr "Ehem... Bukan itu yang aku mau k-"

#. Character:`akira`
msgctxt "restaurant_exterior_a6aa04ea"
msgid "..."
msgstr "..."

#. Character:`akira` | Attributes:`angry`
msgctxt "restaurant_exterior_7cfc3e89"
msgid "On se retrouvera {{saito.n}} et je te garantis que tu le regretteras."
msgstr "Kita bakal ketemu {{saito.n}} dan aku jamin kamu bakal nyesel."

#. Character:`chef`
msgctxt "restaurant_exterior_dbef479b"
msgid "Qu'est-ce que tu fais là gamin ?"
msgstr "Kamu ngapain di sini, bocah?"

#. Character:`saito` | Attributes:`happy`
msgctxt "restaurant_exterior_dbef479b232"
msgid "J'aimerais postuler pour..."
msgstr "Aku pengen daftar buat..."

#. Character:`chef`
msgctxt "restaurant_exterior_291b62f0"
msgid "...Putain qu'est-ce que vous avez tous à me faire perdre mon temps aujourd'hui ?"
msgstr "...Sialan, kalian semua kenapa sampe bikin aku buang-buang waktu hari ini?"

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_7ecbf22f"
msgid "S'il vous plait, j'ai vraiment besoin de ce travail !"
msgstr "Tolong dong, aku beneran butuh kerjaan ini!"

#. Character:`chef`
msgctxt "restaurant_exterior_38861200"
msgid "Et moi, j'ai besoin de quelqu'un de sérieux qui tienne la route et qui ne passe pas son temps à tourner autour de ma fille."
msgstr "Dan aku butuh orang yang serius, yang bisa diandalkan dan nggak cuma muter-muter aja sama anak aku."

#. Character:`chef`
msgctxt "restaurant_exterior_b4f16729"
msgid "Si tu es sérieux, reviens quand tu auras meilleure mine..."
msgstr "Kalau kamu serius, balik lagi kalau kelihatan lebih oke..."

#. Character:`saito`
msgctxt "restaurant_exterior_a9b99e8c"
msgid "Désolé si j'ai interrompu quelque chose d'important avec {{akira.n}}..."
msgstr "Maaf kalau aku ganggu sesuatu yang penting sama {{akira.n}}..."

#. Character:`sakuya` | Attributes:`melancholic`
msgctxt "restaurant_exterior_e39e9cb8"
msgid "Non, tu as bien fait."
msgstr "Nggak, kamu udah bener."

#. Character:`saito` | Attributes:`happy`
msgctxt "restaurant_exterior_beeed2ce"
msgid "Alors, je ne suis pas désolé."
msgstr "Jadi, aku nggak nyesel."

#. Character:`sakuya` | Attributes:`-melancholic`
msgctxt "tae4034358f"
msgid "{{akira.n}} est toujours insistant, j'ai de plus en plus de mal à le repousser."
msgstr "{{akira.n}} masih ngotot terus, aku makin susah buat nolak dia."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "t28acd83ffc"
msgid "Bref, je m'égare, merci encore, j'espère que mon père t'embauchera."
msgstr "Pokoknya, aku ngelantur, makasih lagi ya, semoga ayah aku mau ngambil kamu kerja."

#. Character:`sakuya`
msgctxt "restaurant_exterior_5a04c5bb"
msgid "À très bientôt, j'espère."
msgstr "Sampai ketemu lagi, aku harap gitu."

#. Character:`saito`
msgctxt "restaurant_exterior_961d3e80"
msgid "Oui, je l'espère aussi."
msgstr "Iya, aku juga harap."

#. Character:`saito` | Attributes:`upset`
msgctxt "restaurant_exterior_816a0278"
msgid "...Putain d'{{akira.n}} !"
msgstr "...Sialan {{akira.n}}!"

#. Character:`narrator`
msgctxt "restaurant_exterior_e5f87dd5"
msgid "Une seconde... Il me semble que {{sakuya.n}} était sa petite amie aussi loin que je me souvienne..."
msgstr "Tunggu sebentar... Kayaknya {{sakuya.n}} juga pacarnya dari dulu, sejauh yang aku ingat..."

#. Character:`narrator`
msgctxt "restaurant_exterior_af57bd08"
msgid "Il a dû parvenir à ses fins."
msgstr "Dia pasti udah dapetin apa yang dia mau."

#. Character:`narrator`
msgctxt "restaurant_exterior_c98c0d0a"
msgid "Je crois qu'elle avait d'ailleurs fini par réaliser des films pour adultes."
msgstr "Aku denger dia malah akhirnya bikin film dewasa juga."

#. Character:`narrator`
msgctxt "restaurant_exterior_8a5cdb72"
msgid "Cela avait apporté la honte sur sa famille et le restaurant avait dû fermer."
msgstr "Itu bikin malu keluarganya dan restorannya sampai harus tutup."

#. Character:`narrator`
msgctxt "restaurant_exterior_0e0129b5"
msgid "C'est donc ici qu'il l'avait rencontré..."
msgstr "Jadi di sinilah dia ketemu sama dia..."

#. Character:`saito`
msgctxt "restaurant_exterior_03775ec8"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "restaurant_exterior_e822282f"
msgid "Eh bien, il est peut-être temps de jouer avec le destin."
msgstr "Yah, mungkin udah saatnya main sama takdir."

#. Character:`saito`
msgctxt "restaurant_exterior_03775ec8_1"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "restaurant_exterior_d981cc6d"
msgid "Mince, il est trop tard, il faudra que je repasse demain matin ou dans l'après-midi."
msgstr "Sial, udah keburu malam, aku harus datang lagi besok pagi atau siang."

#. Character:`akira`
msgctxt "restaurant_exterior_8b9ab530"
msgid "Alors ? Tu as bien réfléchi à ma proposition ?"
msgstr "Jadi? Udah mikir matang-matang soal tawaran aku?"

#. Character:`akira`
msgctxt "restaurant_exterior_2e54cc2f"
msgid "Tu poursuis tes rêves avec moi ou tu restes à moisir dans ce restaurant le restant de ta vie ?"
msgstr "Kamu mau kejar mimpi bareng aku atau mau terus terpuruk di restoran ini sisa hidup kamu?"

#. Character:`akira`
msgctxt "restaurant_exterior_957537c2"
msgid "Je serais toujours là pour te soutenir."
msgstr "Aku bakal selalu ada buat dukung kamu."

#. Character:`akira`
msgctxt "restaurant_exterior_fcceff92"
msgid "En plus j'ai un ami qui travaille dans ce milieu, je pourrais facilement te présenter à lui et je suis certain que ta carrière décollerait très vite."
msgstr "Selain itu aku punya temen yang kerja di bidang ini, aku bisa gampang ngenalin kamu ke dia dan aku yakin karier kamu bakal langsung melesat."

#. Character:`sakuya`
msgctxt "t146e392351"
msgid "Je... j'ai réfléchi et c'est non !"
msgstr "Aku... udah mikir-mikir dan jawabannya nggak!"

#. Character:`akira`
msgctxt "t6e796be6de"
msgid "Désolé mais ce n'était pas une question, juste de la rhétorique."
msgstr "Maaf, tapi itu bukan pertanyaan, cuma retorika doang."

#. Character:`akira`
msgctxt "t49c49212d2"
msgid "Il est évident que tu acceptes !"
msgstr "Jelas banget kamu bakal nerima!"

#. Character:`akira`
msgctxt "restaurant_exterior_3091922f"
msgid "Scellons notre accord avec un bai-"
msgstr "Tandain kesepakatan kita dengan sebuah ciuman-"

#. Character:`akira`
msgctxt "restaurant_exterior_4ce3d3a2"
msgid "Putain {{saito.n}}, arrête de te rincer l'œil, casse-toi, tu vois pas que tu me déranges ?"
msgstr "Sialan {{saito.n}}, berhenti ngintip, cabut sana, nggak lihat aku lagi ganggu?"

#. Character:`narrator`
msgctxt "restaurant_exterior_3282dae6"
msgid "Allez ! C'est le moment de briller !"
msgstr "Ayo! Ini saatnya bersinar!"

#. Character:`narrator`
msgctxt "restaurant_exterior_07fb550d"
msgid "Je ne dois rien lâcher."
msgstr "Aku nggak boleh nyerah."

#. Character:`saito` | Attributes:`upset`
msgctxt "restaurant_exterior_afba5ee2"
msgid "Non, j'ai des choses à faire ici."
msgstr "Nggak, aku ada urusan di sini."

#. Character:`akira` | Attributes:`angry`
msgctxt "restaurant_exterior_5c730bca"
msgid "Tu cherches visiblement à mourir."
msgstr "Kamu jelas-jelas pengen mati."

#. Character:`saito` | Attributes:`happy`
msgctxt "restaurant_exterior_00fa585e"
msgid "Tes contacts... C'est pas des gens qui tournent des films pour adultes hardcores ?"
msgstr "Kontak-kontak kamu... Bukannya mereka yang bikin film dewasa hardcore ya?"

#. Character:`akira`
msgctxt "restaurant_exterior_b5fd0add"
msgid "Et alors ? Qu'est-ce que ça peut bien te foutre pine d'huitre ?"
msgstr "Terus? Kamu peduli apa, dasar penis tiram?"

#. Character:`sakuya` | Attributes:`angry`
msgctxt "restaurant_exterior_7fc6a4d9"
msgid "Des films hardcores... ?!"
msgstr "Film hardcore...?!"

#. Character:`akira`
msgctxt "restaurant_exterior_8a599553"
msgid "Je vais te tuer."
msgstr "Aku bakal bunuh kamu."

#. Character:`sakuya` | Attributes:`sad`
msgctxt "restaurant_exterior_26523fd9"
msgid "{{akira.n}} va-t'en ! Je ne sais même pas pourquoi j'espérais que tu faisais réellement ça pour m'aider."
msgstr "{{akira.n}} pergi sana! Aku bahkan nggak ngerti kenapa aku masih berharap kamu beneran ngelakuin itu buat nolongin aku."

#. Character:`sakuya`
msgctxt "t051437fb4d"
msgid "Tu n'as jamais voulu m'aider pour mon rêve au final... Tout ce que tu voulais c'était moi, m'ajouter à ta liste ! Je me trompe non ?"
msgstr "Kamu sebenernya nggak pernah pengen nolongin aku buat mimpi aku... Semua yang kamu pengen itu aku, masukin aku ke daftar kamu! Aku salah kan?"

#. Character:`akira`
msgctxt "restaurant_exterior_c0e03836"
msgid "Ferme là ! Si tu m'avais écouté, tu aurais au moins pu avoir une carrière en dehors de ta vie merdique..."
msgstr "Diam! Kalo kamu dengerin aku, kamu setidaknya bisa punya karir di luar hidup kamu yang sampah itu..."

#. Character:`akira`
msgctxt "restaurant_exterior_e01e5da1"
msgid "Maintenant, démerde-toi toute seule."
msgstr "Sekarang, urusin diri kamu sendiri."

#. Character:`sakuya`
msgctxt "restaurant_exterior_6bd0b308"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_12d1a46d"
msgid "Ne l'écoute pas, ce connard ne pense qu'à lui, c'est juste un putain de pervers narcissique."
msgstr "Jangan dengerin dia, bajingan itu cuma mikirin dirinya sendiri, dia cuma seorang narsis fucker."

#. Character:`sakuya`
msgctxt "restaurant_exterior_4cda1b5b"
msgid "Va-t'en, s'il te plait, j'ai besoins d'être seule."
msgstr "Pergi sana, tolong, aku butuh sendiri."

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_24eb94b1"
msgid "Merde, {{akira.n}} a vraiment dépassé les bornes cette fois-ci..."
msgstr "Sial, {{akira.n}} bener-bener kelewatan kali ini..."

#. Character:`chef`
msgctxt "restaurant_exterior_0c5fb6fb"
msgid "Putain gamin, qu'est-ce que t'as foutu ? Je viens de voir ma fille en pleur."
msgstr "Brengsek bocah, kamu ngapain sih? Aku baru aja liat anak aku nangis."

#. Character:`chef`
msgctxt "restaurant_exterior_f730d697"
msgid "J'avais pourtant été clair."
msgstr "Padahal aku udah jelas banget."

#. Character:`saito`
msgctxt "restaurant_exterior_ee2f378b"
msgid "Oui, mais je ne suis pas responsable de-"
msgstr "Iya, tapi aku nggak bertanggung jawab buat-"

#. Character:`chef`
msgctxt "restaurant_exterior_b2d0eab2"
msgid "Déguerpis et que je ne te revois jamais !"
msgstr "Mampus sana dan jangan pernah aku liat lagi!"

#. Character:`saito` | Attributes:`upset`
msgctxt "restaurant_exterior_9f06ba2c"
msgid "Merde, c'était pas censé se passer comme ça..."
msgstr "Sial, seharusnya nggak kayak gini..."

#. Character:`saito`
msgctxt "restaurant_exterior_85499806"
msgid "Et voilà."
msgstr "Nah, itu dia."

#. Character:`sakuya`
msgctxt "restaurant_exterior_f559356f"
msgid "Merci pour tout {{saito.n}}."
msgstr "Makasih buat semuanya {{saito.n}}."

#. Character:`saito`
msgctxt "restaurant_exterior_29c9caeb"
msgid "C'est à moi de te remercier, je voulais un travail et maintenant, je vais en avoir deux."
msgstr "Aku yang harusnya makasih, aku pengen kerja dan sekarang, aku bakal punya dua kerjaan."

#. Character:`sakuya` | Attributes:`neutral`
msgctxt "restaurant_exterior_b3d96d8b"
msgid "C'est bonne façon de voir les choses."
msgstr "Itu cara yang bagus buat lihat semuanya."

#. Character:`sakuya`
msgctxt "restaurant_exterior_4c1abdc8"
msgid "Néanmoins..."
msgstr "Tapi tetap aja..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "restaurant_exterior_b0c0867a"
msgid "Un souci ?"
msgstr "Ada masalah?"

#. Character:`sakuya` | Attributes:`sad`
msgctxt "restaurant_exterior_2538e2fd"
msgid "Oui... Mon père ne devra jamais être au courant et..."
msgstr "Iya... Ayah aku nggak boleh tau sama sekali dan..."

#. Character:`saito`
msgctxt "restaurant_exterior_3b896f1b"
msgid "Ça, je peux le comprendre."
msgstr "Itu sih aku bisa ngerti."

#. Character:`sakuya`
msgctxt "restaurant_exterior_2dd8f783"
msgid "Et il est extrêmement sévère avec ses employés."
msgstr "Dan dia super galak sama karyawannya."

#. Character:`sakuya`
msgctxt "restaurant_exterior_85d61204"
msgid "Ça va être difficile, vraiment difficile."
msgstr "Bakalan susah, bener-bener susah."

#. Character:`saito` | Attributes:`happy`
msgctxt "restaurant_exterior_314b3aac"
msgid "Je pense que je m'en sortirai."
msgstr "Aku yakin aku bakal bisa ngatasinnya."

#. Character:`saito`
msgctxt "restaurant_exterior_3571eab9"
msgid "Je me fais courser tous les jours par une montagne de muscle qui me menace de m'insérer du mobilier urbain dans le cul si je ne cours pas assez vite."
msgstr "Aku tiap hari dikejar sama bukit otot yang ancam mau masukin perabotan kota ke pantat aku kalo aku nggak lari cukup cepat."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "restaurant_exterior_8281db32"
msgid "Je ne suis pas sûr de comprendre..."
msgstr "Aku nggak yakin ngerti maksud kamu..."

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_c7214ad0"
msgid "Ahem... Oublie ce que je viens de dire."
msgstr "Ehem... Lupakan aja yang barusan aku bilang."

#. Character:`saito` | Attributes:`happy`
msgctxt "restaurant_exterior_b6bc163f"
msgid "Je me donnerai à fond, ne t'en fais pas."
msgstr "Aku bakal ngasih yang terbaik, tenang aja."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_exterior_c4ea180d"
msgid "Merci pour tout. Passe une bonne nuit {{saito.n}}. On se revoit demain ?"
msgstr "Makasih buat semuanya. Tidur yang nyenyak ya {{saito.n}}. Ketemu lagi besok?"

#. Character:`saito`
msgctxt "restaurant_exterior_e63f58d5"
msgid "Bonne nuit {{sakuya.n}}, avec plaisir."
msgstr "Selamat malam {{sakuya.n}}, dengan senang hati."

#. Character:`narrator`
msgctxt "restaurant_exterior_4d5c0d9e"
msgid "Eh bien, je crois que les choses se mettent doucement en place."
msgstr "Yah, aku rasa semuanya mulai pelan-pelan berjalan."

#. Character:`narrator`
msgctxt "restaurant_exterior_eaa3d458"
msgid "Quel enfoiré cet {{akira.n}} quand même..."
msgstr "Anjing bener {{akira.n}} itu ya..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "restaurant_exterior_dee02dbf"
msgid "Oula, il est tard, je ferais mieux de rentrer."
msgstr "Wah, udah malem nih, mending aku pulang aja."

#. Character:`akira`
msgctxt "restaurant_exterior_461e4e52"
msgid "Je vais tuer ce fils de pute."
msgstr "Aku bakal bunuh bajingan itu."

#. Character:`saito`
msgctxt "restaurant_exterior_93ba1dbd"
msgid "{{chiaki.n}} ?"
msgstr "{{chiaki.n}}?"

#. Character:`narrator`
msgctxt "restaurant_exterior_9d165919"
msgid "Merde, toujours rien."
msgstr "Sial, masih belum ada kabar."

#. Character:`narrator`
msgctxt "restaurant_exterior_5afa27f0"
msgid "Où est-ce qu'une fille comme elle pourrait aller dans cette ville ?"
msgstr "Dia cewek kayak dia bisa kemana ya di kota ini?"

#. Character:`narrator`
msgctxt "restaurant_exterior_7e53d06a"
msgid "Timide comme elle est..."
msgstr "Pemalu banget dia..."

#. Character:`narrator`
msgctxt "restaurant_exterior_d7cc6f56"
msgid "J'espère quand même qu'il ne lui est rien arrivé."
msgstr "Tapi aku harap dia nggak kenapa-kenapa."

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_82627d98"
msgid "Je devrais essayer d'aller voir ailleurs."
msgstr "Kayaknya aku harus coba cari di tempat lain."

#. Character:`saito`
msgctxt "restaurant_exterior_3a353e62"
msgid "Je finirais bien par tomber sur elle."
msgstr "Pasti akhirnya aku bakal ketemu dia juga."

#. Character:`saito` | Attributes:`surprised`
msgctxt "restaurant_exterior_d7d6c2db"
msgid "Oh ! Maintenant que j'y pense, je n'ai pas encore essayé le konbini !"
msgstr "Oh! Sekarang aku inget, aku belum pernah nyoba konbini nih!"

#. Character:`saito` | Attributes:`happy`
msgctxt "restaurant_exterior_dd1ea67d"
msgid "Je crois me souvenir qu'ils y vendent des glaces..."
msgstr "Kayaknya aku ingat mereka jual es krim di sana..."

#. Character:`saito`
msgctxt "restaurant_exterior_ef8cca36"
msgid "Elle sera peut-être là-bas !"
msgstr "Mungkin dia bakal ada di sana!"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "talk_sakuya_f82263e5"
msgid "Merci encore pour ton travail."
msgstr "Makasih lagi buat kerja keras kamu."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_sakuya_1ef2c84c"
msgid "C'est moi qui te remercie, c'est grâce à toi que j'ai obtenu ce travail au final."
msgstr "Justru aku yang harus makasih, gara-gara kamu aku akhirnya dapetin kerjaan ini."

#. Character:`saito`
msgctxt "talk_sakuya_5d57d102"
msgid "Bon, c'est vrai que je ne m'attendais pas être pris à ce point au sérieux, mais maintenant que je suis au courant, je sais à quoi m'attendre."
msgstr "Ya, emang sih aku nggak nyangka bakal dianggap serius segini, tapi sekarang aku udah tau, jadi tahu harus ngapain."

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_sakuya_9648a849"
msgid "Sinon... Quand veux-tu que... enfin que nous commencions..."
msgstr "Kalau nggak... Kapan kamu mau... ya, kita mulai aja..."

#. Character:`sakuya`
msgctxt "t5dc1b1f70c"
msgid "Pour le moment c'est compliqué, mon père va garder un oeil sur toi."
msgstr "Untuk sekarang sih ribet, ayah aku bakal ngawasin kamu terus."

#. Character:`sakuya`
msgctxt "t5dee050404"
msgid "Une fois que tu aura gagné sa confiance alors nous pourrons commencer."
msgstr "Begitu kamu dapet kepercayaan dia, baru kita bisa mulai."

#. Character:`saito` | Attributes:`sad`
msgctxt "t392c988515"
msgid "Je comprend."
msgstr "Aku paham."

#. Character:`chef`
msgctxt "t7c1499d49f"
msgid "[font_size=14]{{sakuya.n}} qu'est-ce que tu fais encore dehors à cette heure-ci ?![/font_size]"
msgstr "[font_size=14]{{sakuya.n}} kamu masih ngapain di luar jam segini?![/font_size]"

#. Character:`sakuya`
msgctxt "talk_sakuya_cb47b76a"
msgid "...[w] Je dois te laisser, j'entends mon père qui m'appelle."
msgstr "...[w] Aku harus pergi, aku denger bapak aku manggil."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "talk_sakuya_19c4613a"
msgid "À bientôt {{saito.n}}."
msgstr "Sampai ketemu lagi {{saito.n}}."

#. Character:`narrator`
msgctxt "t1ea44ade22"
msgid "J'ai aucune idée de comment l'aider dans son rêve..."
msgstr "Aku gak tau gimana bantu dia di mimpinya..."

#. Character:`narrator`
msgctxt "t34e2a56e7f"
msgid "Mais peu importe."
msgstr "Tapi gak papa."

#. Character:`narrator`
msgctxt "t097014b608"
msgid "Le plus important, c'est que j'ai un travail et que je vais pouvoir aider {{yasuka.n}} à rembourser les dettes de la maison."
msgstr "Yang penting sekarang aku punya kerjaan dan bisa bantu {{yasuka.n}} bayar utang rumah."

#. Character:`saito`
msgctxt "t2b5561d2a3"
msgid "Maintenant qu'une source de revenu régulière est sécurisé je vais pouvoir aller voir {{asami.n}} dès demain !"
msgstr "Sekarang setelah dapet penghasilan tetap, besok aku bakal datengin {{asami.n}}!"

#. Character:`netoru` | Attributes:`angry`
msgctxt "restaurant_exterior_e6d5dd1f"
msgid "Merde, où est-elle passée ?"
msgstr "Sial, dia kemana ya?"

#. Character:`netoru`
msgctxt "restaurant_exterior_4e06e472"
msgid "Fait chier, j'avais presque réussi à la convaincre !"
msgstr "Bete banget, aku hampir aja berhasil ngeyakinin dia!"

#. Character:`netoru`
msgctxt "restaurant_exterior_130c9644"
msgid "J'ai horreur de perdre mon temps."
msgstr "Aku benci buang-buang waktu."

#. Character:`saito`
msgctxt "restaurant_exterior_a198c07c"
msgid "Cette espèce d'ordure a vraiment essayé de profiter d'elle."
msgstr "Jenis sampah itu beneran nyoba nge-manipulasi dia."

#. Character:`saito` | Attributes:`upset`
msgctxt "restaurant_exterior_8541bbf7"
msgid "Au moins il n'a pas eu ce qu'il espérait."
msgstr "Setidaknya dia gak dapet apa yang dia harapin."

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_6a4cf7c8"
msgid "{{yasuka.n}} reste toujours introuvable."
msgstr "{{yasuka.n}} masih belum ketemu juga."

#. Character:`saito` | Attributes:`neutral`
msgctxt "restaurant_exterior_7b821704"
msgid "Je ferais mieux de me dépêcher."
msgstr "Mending aku buru-buru deh."

#. Character:`saito`
msgctxt "tc3e37b1984"
msgid "Je dois faire mon service auprès du {{chef.n}}."
msgstr "Aku harus ngelayanin {{chef.n}} dulu."

#. Character:`saito`
msgctxt "t200378e520"
msgid "Le restaurant est encore fermé pour le moment, je ferais mieux d'y travailler cet après-midi."
msgstr "Restoran masih tutup sekarang, mending aku kerja di situ sore nanti."

#. Character:`saito`
msgctxt "tca82b2cdac"
msgid "Il est tard, je dois aller dormir. Si je commence à travailler au [color=yellow]restaurant[/color] plus tôt, j'aurai un peu de temps libre."
msgstr "Udah malam, aku harus tidur. Kalo aku mulai kerja di [color=yellow]restoran[/color] lebih awal, aku bakal punya waktu santai dikit."

#. Character:`saito`
msgctxt "restaurant_exterior_62079a45"
msgid "La journée est enfin terminée."
msgstr "Akhirnya hari ini kelar juga."

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_fd6a3ad4"
msgid "Je suis complètement épuisé."
msgstr "Aku capek banget."

#. Character:`saito`
msgctxt "restaurant_exterior_aab36613"
msgid "Je ferais mieux d'aller prendre des nouvelles de {{yasuka.n}}."
msgstr "Mending aku cek gimana kabar {{yasuka.n}}."

#. Character:`saito` | Attributes:`happy`
msgctxt "restaurant_exterior_2e070ae7"
msgid "Je me demande ce qu'elle a bien pu faire aujourd'hui..."
msgstr "Aku penasaran dia ngapain aja hari ini..."

#. Character:`kenji`
msgctxt "restaurant_exterior_8f2dc921"
msgid "On va te traquer toute la nuit s'il le faut !"
msgstr "Aku bakal ngejar kamu semalaman kalo perlu!"

#. Character:`takeo`
msgctxt "restaurant_exterior_7c785028"
msgid "Genre ta vie se termine aujourd'hui."
msgstr "Kayak hidup kamu bakal berakhir hari ini aja."

#. Character:`nobu`
msgctxt "restaurant_exterior_01e867c1"
msgid "MAIS PUTAIN LES MECS ! CHOPEZ-LE AU LIEU DE DIRE DE LA MERDE !"
msgstr "TAPI ANJING KAMU COK! Tangkap dia daripada cuma ngomong omong kosong!"

#. Character:`saito`
msgctxt "restaurant_exterior_f6eda8f4"
msgid "Je ferais mieux de me dépêcher de gagner plus d'argent."
msgstr "Mending aku buru-buru cari duit lebih banyak."

#. Character:`saito`
msgctxt "restaurant_exterior_3915e569"
msgid "Plus vite j'aiderai {{yasuka.n}} à rembourser ses dettes."
msgstr "Semakin cepet aku bantuin {{yasuka.n}} lunasin hutangnya."

#. Character:`saito`
msgctxt "restaurant_exterior_1d3c9ed7"
msgid "Plus vite elle pourra retrouver une vie un peu normale."
msgstr "Semakin cepet dia bisa balik ke hidup yang agak normal."

#. Character:`unknown`
msgctxt "restaurant_exterior_aa355a44"
msgid "Tiens tiens tiens, mais qui voilà ?!"
msgstr "Wah wah wah, siapa tuh?!"

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_1eac8432"
msgid "Oh non."
msgstr "Oh nggak."

#. Character:`kenji`
msgctxt "restaurant_exterior_0204b678"
msgid "Oh que si !"
msgstr "Oh iya dong!"

#. Character:`kenji`
msgctxt "restaurant_exterior_0af4f921"
msgid "Tu croyais pas qu'on t'aurait oublié ?"
msgstr "Kamu kira kita bakal lupain kamu gitu aja?"

#. Character:`nobu`
msgctxt "restaurant_exterior_f59063f0"
msgid "On a déjà dépensé tous ton fric."
msgstr "Kita udah habisin semua duit kamu."

#. Character:`nobu`
msgctxt "restaurant_exterior_df49ab36"
msgid "Tu en aurais pas encore un peu à tout hasard ?"
msgstr "Kamu nggak ada sisa dikit nggak, siapa tau?"

#. Character:`sakuya`
msgctxt "restaurant_exterior_7e8870a8"
msgid "{{saito.n}} ! Tu es enfin là !"
msgstr "{{saito.n}} ! Akhirnya kamu dateng juga!"

#. Character:`sakuya`
msgctxt "restaurant_exterior_33058b56"
msgid "Je t'attendais."
msgstr "Aku udah nungguin kamu."

#. Character:`takeo`
msgctxt "restaurant_exterior_7f6c3c66"
msgid "Oh la vache !"
msgstr "Gila banget!"

#. Character:`takeo`
msgctxt "restaurant_exterior_0bdaedae"
msgid "T'es vraiment trop bonne toi !"
msgstr "Kamu emang bener-bener enak banget nih!"

#. Character:`kenji`
msgctxt "restaurant_exterior_2ddaba3a"
msgid "C'est fou, depuis quelque temps, il traine tout le temps avec des filles mignonnes."
msgstr "Gila, belakangan ini dia selalu nongkrong sama cewek-cewek imut terus."

#. Character:`kenji`
msgctxt "restaurant_exterior_a3c492bb"
msgid "Tu veux pas laisser cette grosse merde et venir t'amuser avec nous plutôt ?"
msgstr "Kamu nggak mau ninggalin omong kosong itu terus ikut seneng-seneng sama kita aja?"

#. Character:`nobu`
msgctxt "restaurant_exterior_36193be8"
msgid "Oui après tout, je veux bien te pardonner si tu nous laisses ta nouvelle copine."
msgstr "Iya deh, aku rela maafin kamu asal kamu kasih cewek baru kamu ke kita."

#. Character:`nobu`
msgctxt "restaurant_exterior_5e2bc015"
msgid "Je suis plutôt sympa, non ?"
msgstr "Aku kan baik, kan?"

#. Character:`saito` | Attributes:`angry`
msgctxt "restaurant_exterior_0f2f29fb"
msgid "Allez vous faire foutre, vous ne poserez pas un doigt sur elle !"
msgstr "Pergi sana kamu, kamu nggak bakal nyentuh dia sama sekali!"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_exterior_33b053ce"
msgid "..."
msgstr "..."

#. Character:`sakuya`
msgctxt "restaurant_exterior_7e2ec9a9"
msgid "{{saito.n}} ne t'en fais pas, je vais gérer ça !"
msgstr "{{saito.n}} santai aja, aku yang urus ini!"

#. Character:`sakuya`
msgctxt "restaurant_exterior_f28cd4d6"
msgid "Rejoins mon père à l'intérieur, tu sais comment il est quand on a trop de retard."
msgstr "Gabung aja sama bokap aku di dalam, kamu tau gimana dia kalo kita telat banget."

#. Character:`saito` | Attributes:`upset`
msgctxt "restaurant_exterior_72bbcda3"
msgid "Mais... Je vais pas te laisser avec ces..."
msgstr "Tapi... Aku nggak bakal ninggalin kamu sama mereka..."

#. Character:`nobu` | Attributes:`angry`
msgctxt "restaurant_exterior_d8b45f6e"
msgid "Ferme ta gueule, ta copine viens avec nous, c'est elle qui propose donc va récurer les chiottes et casse-toi."
msgstr "Bebek mulut kamu, pacar kamu ikut sama kita, dia yang ngajak, jadi mending kamu gosok toilet terus cabut."

#. Character:`sakuya`
msgctxt "restaurant_exterior_117eefff"
msgid "[font_size=14]Fais-moi confiance, ne t'inquiète pas.[/font_size]"
msgstr "[font_size=14]Percaya sama aku, santai aja.[/font_size]"

#. Character:`saito`
msgctxt "restaurant_exterior_bae558fc"
msgid "[font_size=14]Très bien... Mais je ne serais pas loin.[/font_size]"
msgstr "[font_size=14]Oke deh... Tapi aku nggak bakal jauh-jauh.[/font_size]"

#. Character:`nobu` | Attributes:`bad`
msgctxt "restaurant_exterior_d5c70915"
msgid "Tu veux qu'on fasse un karaoké ou on passe directement aux choses sérieuses ?"
msgstr "Kamu mau karaoke dulu atau langsung ke bagian seriusnya?"

#. Character:`takeo`
msgctxt "restaurant_exterior_4e602e52"
msgid "Regarde-moi cette paire de loches..."
msgstr "Liat deh cewek-cewek itu..."

#. Character:`takeo`
msgctxt "restaurant_exterior_b6c5b85c"
msgid "On pourrait mourir étouffé avec."
msgstr "Kita bisa mati sesak napas gara-gara mereka."

#. Character:`kenji`
msgctxt "restaurant_exterior_83833378"
msgid "Moi, j'attends un peu de voir le reste."
msgstr "Aku sih nunggu dulu liat sisanya."

#. Character:`kenji`
msgctxt "restaurant_exterior_16fc1dc5"
msgid "Je préfère plutôt les jolis petits culs."
msgstr "Aku lebih suka bokong kecil yang imut."

#. Character:`nobu` | Attributes:`mocking`
msgctxt "restaurant_exterior_9488f573"
msgid "Tu ne dis plus rien tout à coup, tu as peur ?"
msgstr "Kok tiba-tiba kamu diem aja, takut ya?"

#. Character:`nobu`
msgctxt "restaurant_exterior_d820de51"
msgid "On ne va pas te faire de mal, bien au contraire."
msgstr "Aku nggak bakal nyakitin kamu, malah sebaliknya."

#. Character:`nobu` | Attributes:`angry`
msgctxt "restaurant_exterior_d9b54a35"
msgid "Pourquoi tu me regardes comme ça ?"
msgstr "Kenapa kamu liatin aku kayak gitu?"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_exterior_6089c533"
msgid "Je suis simplement en train de graver vos visages dans ma tête."
msgstr "Aku cuma lagi ngukir muka kalian di otak aku."

#. Character:`takeo` | Attributes:`mocking`
msgctxt "restaurant_exterior_a38a7207"
msgid "Et alors ? Tu aime ce que tu vois ?"
msgstr "Terus? Kamu suka apa yang kamu liat?"

#. Character:`takeo`
msgctxt "restaurant_exterior_226fdcd4"
msgid "Tu veux pas plutôt graver ma b-"
msgstr "Mau nggak sih ngukir b- aku aja?"

#. Character:`chef`
msgctxt "restaurant_exterior_722c712f"
msgid "PUTAIN DE PETITS MERDEUX !"
msgstr "ANJING KAMU PADA CILIK BANGSAT!"

#. Character:`chef`
msgctxt "restaurant_exterior_0458a7db"
msgid "TIREZ-VOUS TOUS !"
msgstr "CABUT SEMUA KAMU!"

#. Character:`chef`
msgctxt "restaurant_exterior_29a8d0be"
msgid "Le premier qui dit un mot de travers, je lui fais bouffer ses couilles !"
msgstr "Siapa pun yang ngomong asal, aku bikin dia makan testisnya sendiri!"

#. Character:`sakuya` | Attributes:`neutral`
msgctxt "restaurant_exterior_a36e6735"
msgid "C'est bon papa, je les retenais juste le temps que la police n'arrive."
msgstr "Santai, Pa, aku cuma nahan mereka sampai polisi datang."

#. Character:`kenji` | Attributes:`angry`
msgctxt "restaurant_exterior_89fba8c5"
msgid "Les flics ? Merde, tirons-nous."
msgstr "Polisi? Sialan, kita cabut."

#. Character:`nobu` | Attributes:`angry`
msgctxt "restaurant_exterior_56a26167"
msgid "Fais chier !"
msgstr "Sialan!"

#. Character:`chef`
msgctxt "restaurant_exterior_99e85c66"
msgid "Putain de vauriens."
msgstr "Bajingan bodoh."

#. Character:`sakuya` | Attributes:`melancholic`
msgctxt "restaurant_exterior_7a43449b"
msgid "Tu... tu t'inquiétais pour moi ?"
msgstr "Lu... kamu khawatir sama aku?"

#. Character:`saito`
msgctxt "restaurant_exterior_2ad13cfa"
msgid "Évidement, je ne voulais pas qu'ils te fassent quoi que ce soit."
msgstr "Jelas, aku nggak mau mereka nyakitin kamu."

#. Character:`sakuya`
msgctxt "restaurant_exterior_0122bda4"
msgid "Tu es vraiment..."
msgstr "Kamu bener-bener..."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_exterior_5feeb033"
msgid "Je...[w] merci."
msgstr "Aku...[w] makasih."

#. Character:`saito` | Attributes:`upset`
msgctxt "restaurant_exterior_70c66934"
msgid "Maintenant, j'ai surtout peur qu'ils reviennent te voir..."
msgstr "Sekarang, aku malah takut mereka balik lagi buat kamu..."

#. Character:`sakuya`
msgctxt "restaurant_exterior_564442e7"
msgid "Hihi"
msgstr "Hihi"

#. Character:`saito`
msgctxt "restaurant_exterior_0bc55e34"
msgid "Tu as l'air de plutôt bien le prendre."
msgstr "Kamu kelihatan cukup santai ngadepin itu."

#. Character:`sakuya`
msgctxt "restaurant_exterior_32e8b081"
msgid "Ne t'en fais pas, il n'y a aucune chance qu'ils reviennent ici."
msgstr "Santai aja, nggak ada kemungkinan mereka bakal balik ke sini."

#. Character:`saito` | Attributes:`happy`
msgctxt "restaurant_exterior_f63986e0"
msgid "Si tu le dis..."
msgstr "Kalau kamu bilang gitu..."

#. Character:`saito`
msgctxt "restaurant_exterior_db88a80c"
msgid "Les trois connards ont décidé de lâcher l'affaire..."
msgstr "Tiga brengsek itu mutusin buat nyerah..."

#. Character:`saito`
msgctxt "restaurant_exterior_3f3e520a"
msgid "Pour le moment."
msgstr "Untuk saat ini."

#. Character:`saito`
msgctxt "restaurant_exterior_914cdc28"
msgid "J'irais bien au bar à hôtesse une dernière fois."
msgstr "Aku pengen banget ke bar hostess sekali lagi."

#. Character:`saito`
msgctxt "restaurant_exterior_aa0aa39f"
msgid "J'espère que tout iras bien pour {{macumba.n}}."
msgstr "Aku harap semuanya bakal baik-baik aja buat {{macumba.n}}."

#. Character:`saito`
msgctxt "restaurant_exterior_651fd040"
msgid "...Je dois croire en lui !"
msgstr "...Aku harus percaya sama dia!"

#. Character:`centered`
msgctxt "restaurant_exterior_17919d53"
msgid "{{saito.n}} passa la journée à travailler sous les regards plutôt insistant de {{sakuya.n}}."
msgstr "{{saito.n}} ngejalanin hari dengan kerja sambil terus dilirik-lirik sama {{sakuya.n}} yang cukup agresif."

#. Character:`centered`
msgctxt "restaurant_exterior_fe2075e1"
msgid "Malgré ça, il décida de l'ignorer et de se concentrer avant que le {{chef.n}} ne lui tombe dessus."
msgstr "Tapi dia mutusin buat cuekin dan fokus sebelum {{chef.n}} datang ngegertak dia."

#. Character:`narrator`
msgctxt "restaurant_exterior_bff54b7d"
msgid "Encore une bonne journée de travail."
msgstr "Hari kerja yang bagus lagi nih."

#. Character:`narrator`
msgctxt "restaurant_exterior_97fe03cf"
msgid "C'était épuisant, mais rien qu'à l'idée de ce qui m'attend ce soir, ma fatigue s'envole déjà."
msgstr "Capek banget, tapi cuma mikirin apa yang nunggu aku malem ini aja, capeknya langsung ilang."

#. Character:`saito`
msgctxt "restaurant_exterior_eac2144c"
msgid "J'arrive {{yasuka.n}} !"
msgstr "Aku datang {{yasuka.n}}!"

#. Character:`sakuya`
msgctxt "restaurant_exterior_a8af99a6"
msgid "Tu sembles de bonne humeur {{saito.n}}."
msgstr "Kamu keliatan lagi seneng nih {{saito.n}}."

#. Character:`saito`
msgctxt "restaurant_exterior_9680c572"
msgid "Oh {{sakuya.n}} ! Je ne t'avais pas entendu."
msgstr "Oh {{sakuya.n}}! Aku nggak denger kamu dateng."

#. Character:`sakuya`
msgctxt "restaurant_exterior_98a59f5b"
msgid "Je suis de nature plutôt discrète."
msgstr "Aku emang orangnya cukup pendiem."

#. Character:`sakuya`
msgctxt "restaurant_exterior_27dfe0bc"
msgid "Toutefois... J'ai bien peur que les choses n'aillent pas dans ton sens."
msgstr "Tapi... Kayaknya aku takut hal-hal nggak bakal sesuai sama keinginan kamu."

#. Character:`saito`
msgctxt "restaurant_exterior_879ee063"
msgid "Quoi ? Comment ça ?"
msgstr "Apa? Maksud kamu gimana?"

#. Character:`sakuya`
msgctxt "restaurant_exterior_5a28719a"
msgid "Vois-tu, je t'observe depuis longtemps à présent."
msgstr "Liat nih, aku udah lama ngamatin kamu sekarang."

#. Character:`sakuya`
msgctxt "restaurant_exterior_612737d1"
msgid "J'ai appris de nombreuses choses sur toi..."
msgstr "Aku udah tau banyak hal tentang kamu..."

#. Character:`sakuya`
msgctxt "restaurant_exterior_77e153b3"
msgid "Je veille aussi sur ta sécurité... à ma façon."
msgstr "Aku juga jaga keamananmu... dengan caraku sendiri."

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_ba367093"
msgid "Ça veut dire quoi ça ?! Tu me fais peur !"
msgstr "Maksud kamu apa tuh?! Kamu bikin aku takut!"

#. Character:`sakuya`
msgctxt "restaurant_exterior_74c02cb8"
msgid "J'y viens justement..."
msgstr "Itu yang mau aku bilang..."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "restaurant_exterior_d964f18a"
msgid "Je me suis occupée à plusieurs reprises de ceux qui te voulaient du mal."
msgstr "Aku udah beberapa kali ngurusin orang-orang yang mau nyakitin kamu."

#. Character:`saito` | Attributes:`surprised`
msgctxt "restaurant_exterior_201f24bc"
msgid "Quoi ?! Les thugs ?! Tu veux dire que la personne qui les prenait en chasse, c'était toi ?"
msgstr "Apa?! Preman?! Kamu maksud orang yang ngejar mereka itu kamu?"

#. Character:`sakuya`
msgctxt "restaurant_exterior_0b25b15c"
msgid "Et pas seulement, je me suis occupée également de l'ex-propriétaire de la boutique de café."
msgstr "Dan nggak cuma itu, aku juga ngurus mantan pemilik toko kopi itu."

#. Character:`sakuya`
msgctxt "restaurant_exterior_7b0619e4"
msgid "Il n'a désormais plus les moyens de faire du chantage à qui que ce soit."
msgstr "Sekarang dia udah nggak punya kemampuan buat ngancem siapa pun."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_exterior_65cb1f20"
msgid "Mais ce n'est pas une grande perte pour le genre humain..."
msgstr "Tapi itu bukan kerugian besar buat manusia..."

#. Character:`saito` | Attributes:`upset`
msgctxt "restaurant_exterior_d63b1486"
msgid "Wow wow wow, il lui est arrivé quoi exactement ?"
msgstr "Woy woy woy, dia kena apa sih sebenernya?"

#. Character:`sakuya`
msgctxt "restaurant_exterior_fcb996ba"
msgid "J'ai brulé sa maison."
msgstr "Aku bakar rumah dia."

#. Character:`saito` | Attributes:`surprised`
msgctxt "restaurant_exterior_b37e98ac"
msgid "Put-"
msgstr "Put-"

#. Character:`sakuya` | Attributes:`angry`
msgctxt "restaurant_exterior_47edca00"
msgid "Tu ne pensais pas que tous tes problèmes allaient se révolver d'eux même {{saito.n}} ?"
msgstr "Kamu gak nyangka semua masalah kamu bakal beres sendiri, {{saito.n}}?"

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_exterior_0fad4aa0"
msgid "Bien sûr que non... C'était trop beau pour être vrais."
msgstr "Jelas enggak... Itu terlalu bagus buat jadi kenyataan."

#. Character:`saito`
msgctxt "restaurant_exterior_55e559de"
msgid "Qu'est-ce que tu attends de moi exactement ?"
msgstr "Kamu sebenernya pengen apa dari aku?"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_exterior_2f29512a"
msgid "Trois fois rien... Juste un peu d'honnêteté."
msgstr "Gak seberapa... Cuma pengen sedikit kejujuran."

#. Character:`saito` | Attributes:`surprised`
msgctxt "restaurant_exterior_a5df51b7"
msgid "De l'honnêteté ?"
msgstr "Kejujuran?"

#. Character:`sakuya` | Attributes:`neutral`
msgctxt "restaurant_exterior_cc319ec6"
msgid "Ça peut te sembler dérisoire, mais c'est important pour moi."
msgstr "Mungkin kelihatan sepele, tapi itu penting buat aku."

#. Character:`sakuya`
msgctxt "restaurant_exterior_b951616b"
msgid "Que diraient {{asami.n}} ou encore {{yasuka.n}} si elles savaient qu'elles partagent le même homme ?"
msgstr "Gimana reaksi {{asami.n}} atau {{yasuka.n}} kalo mereka tau mereka punya cowok yang sama?"

#. Character:`sakuya`
msgctxt "restaurant_exterior_26a092f6"
msgid "Tu ne peux pas te permettre de batifoler avec toutes les femmes qui t'entourent sans conséquences, tu ne crois pas ?"
msgstr "Kamu gak bisa seenaknya main sama semua cewek di sekitar kamu tanpa konsekuensi, kan?"

#. Character:`saito` | Attributes:`upset`
msgctxt "restaurant_exterior_c2cffe85"
msgid "..."
msgstr "..."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_exterior_d649b9d0"
msgid "Moi aussi, j'aimerais faire des choses coquines avec toi."
msgstr "Aku juga pengen ngelakuin hal mesum sama kamu."

#. Character:`sakuya`
msgctxt "restaurant_exterior_c3e1f0b5"
msgid "Mais je suis très exclusive {{saito.n}}."
msgstr "Tapi aku tipe yang sangat eksklusif, {{saito.n}}."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "restaurant_exterior_c34e7bf7"
msgid "Donc, à partir de maintenant, tu ne le feras qu'avec moi !"
msgstr "Jadi, mulai sekarang, kamu cuma boleh lakuin itu sama aku doang!"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_exterior_5e304f4d"
msgid "Je vais à présent te laisser... Tu dois être épuisé après cette longue journée."
msgstr "Sekarang aku bakal ninggalin kamu... Kamu pasti capek banget abis hari yang panjang ini."

#. Character:`sakuya`
msgctxt "restaurant_exterior_c4b13a55"
msgid "Et n'oublie pas que j'ai toujours un œil sur toi mon cher {{saito.n}}."
msgstr "Dan jangan lupa, aku selalu ngawasin kamu, sayang {{saito.n}}."

#. Character:`narrator`
msgctxt "restaurant_exterior_e192ffec"
msgid "Putain de merde, c'était quoi ça ?!"
msgstr "Sialan, itu apaan sih?!"

#. Character:`narrator`
msgctxt "restaurant_exterior_9461e4ea"
msgid "J'en ai eu des sueurs froides."
msgstr "Aku sampai keringetan dingin."

#. Character:`narrator`
msgctxt "restaurant_exterior_2f454538"
msgid "J'ai l'impression qu'elle est sérieuse."
msgstr "Aku ngerasa dia beneran serius."

#. Character:`narrator`
msgctxt "restaurant_exterior_9d3d5a43"
msgid "Fait chier ! À peine, je me sors d'une situation merdique, que je me retrouve dans une encore pire."
msgstr "Sialan! Baru aja aku keluar dari situasi busuk, eh malah kejebak yang lebih parah lagi."

#. Character:`narrator`
msgctxt "restaurant_exterior_b3c719d0"
msgid "Je dois rentrer en vitesse !"
msgstr "Aku harus cepet-cepet pulang!"

#. Character:`saito`
msgctxt "VOIL_VOUS_SAVEZ_PEU_PR_S_TOUT_9220A7"
msgid "Voilà... Vous savez à peu près tout..."
msgstr "Nah... Kalian udah tau hampir semuanya..."

#. Character:`chef` | Attributes:`upset`
msgctxt "BON_SANG_JE_NE_COMPRENDS_PAS_C_D4828F"
msgid "Bon sang, je ne comprends pas comment un père peut se comporter de façon aussi indigne."
msgstr "Sial, aku nggak ngerti gimana bisa ada bapak yang berperilaku seburuk itu."

#. Character:`chef`
msgctxt "C_EST_JUSTE_0BCD9E"
msgid "C'est juste..."
msgstr "Cuma..."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "CALME_TOI_BEAF58"
msgid "Calme-toi !"
msgstr "Tenang dulu!"

#. Character:`chef` | Attributes:`neutral`
msgctxt "TCHHH_TOUT_A_ME_LAISSE_UN_GO_CDD8C0"
msgid "... Tchhh tout ça me laisse un goût bien amer dans la bouche."
msgstr "... Tchhh semua ini ninggalin rasa pahit banget di mulut aku."

#. Character:`chef`
msgctxt "TU_AS_EU_DES_NOUVELLES_DE_LUI_FE584E"
msgid "Tu as eu des nouvelles de lui depuis tout ce temps ? Même de ta mère ?"
msgstr "Kamu dapet kabar dia sejak lama? Bahkan dari nyokap kamu?"

#. Character:`saito` | Attributes:`sad`
msgctxt "NON_IL_DEVAIT_AVOIR_BIEN_PLUS_44ABA6"
msgid "Non... Il devait avoir bien plus de problèmes qu'une simple dette pour choisir de disparaître du système comme ça. Quant à ma mère... le peu dont je me souvienne c'est qu'elle est partie très tôt en me laissant avec lui."
msgstr "Gak... Dia pasti punya masalah jauh lebih berat daripada cuma utang buat milih ilang dari sistem kayak gitu. Soal nyokap aku... yang aku ingat dia pergi waktu aku masih kecil, ninggalin aku sama dia."

#. Character:`chef` | Attributes:`happy`
msgctxt "DES_INCAPABLES_SI_TU_AS_BESOIN_121204"
msgid "Des incapables ! Si tu as besoin de soutien mon garçon, tu peux compter sur nous !"
msgstr "Orang-orang gak becus! Kalo kamu butuh dukungan, bro, kamu bisa andelin kita!"

#. Character:`saito` | Attributes:`happy`
msgctxt "C_EST_TR_S_GENTIL_VOUS_MERCI_M_D85B25"
msgid "C'est très gentil à vous, merci mais j'ai un endroit où on s'est quand même bien occupé de moi et où je n'ai manqué de rien. Tout n'a pas été rose mais je n'ai pas mal tourné donc c'est bon signe."
msgstr "Makasih banget ya, tapi aku punya tempat di mana aku dirawat dengan baik dan gak kekurangan apa-apa. Gak semuanya mulus, tapi aku gak jadi orang buruk, jadi itu pertanda baik."

#. Character:`saito`
msgctxt "JE_NE_VEUX_PLUS_TRE_UN_POIDS_P_FA3D20"
msgid "Je ne veux plus être un poids pour eux, c'est pour ça que je dois rembourser cette dette à tout prix."
msgstr "Aku gak mau jadi beban buat mereka lagi, makanya aku harus bayar utang ini dengan segala cara."

#. Character:`chef`
msgctxt "TU_ES_COURAGEUX_ET_JE_VOIS_BIE_FBBDF7"
msgid "Tu es courageux et je vois bien comment tu te donnes du mal, à ce train-là ça sera vite réglé. Allez je vous laisse entre vous."
msgstr "Kamu pemberani dan aku liat gimana kerasnya kamu berjuang, kalo terus gini bakal cepet kelar deh. Oke, aku kasih kalian waktu berdua."

#. Character:`saito` | Attributes:`happy`
msgctxt "TON_P_RE_EST_BIEN_PLUS_SYMPA_Q_F6913A"
msgid "Ton père est bien plus sympa que je pensais, il fait peur avec sa grosse moustache mais il a un cœur d'or."
msgstr "Bapak kamu jauh lebih asik dari yang aku kira, keliatan serem sama kumis tebelnya tapi hatinya emas."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "S_IL_POUVAIT_TRE_UN_PEU_MOINS_EFC318"
msgid "S'il pouvait être un peu moins têtu parfois ça serait parfait."
msgstr "Kalo dia bisa agak gak keras kepala kadang-kadang pasti bakal sempurna."

#. Character:`sakuya` | Attributes:`melancholic`
msgctxt "TU_SAIS_J_AI_DES_CONOMIES_ET_A_4EDF5D"
msgid "Tu sais... J'ai des économies et ça ne me gêne pas de te les donner si ça peut t'aider !"
msgstr "Kamu tahu... Aku punya tabungan dan aku nggak masalah ngasih itu ke kamu kalau itu bisa bantu kamu!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "QUOI_NON_C_EST_TON_ARGENT_IL_N_D197DC"
msgid "Quoi ?! Non ! C'est ton argent, il n'appartient qu'à toi mais... Merci infiniment pour le geste."
msgstr "Apa?! Gak! Itu uang kamu, cuma kamu yang punya tapi... Makasih banget ya atas niat baiknya."

#. Character:`saito` | Attributes:`happy`
msgctxt "TA_GENTILLESSE_ME_TOUCHE_BEAUC_4CA0AA"
msgid "Ta gentillesse me touche beaucoup !"
msgstr "Kebaikanmu bener-bener nyentuh aku!"

#. Character:`sakuya` | Attributes:`happy,blush`
msgctxt "A_NE_ME_D_RANGE_PAS_TU_SAIS_C_CC073E"
msgid "Ça ne me dérange pas tu sais... Ce qui est à moi... est aussi à t-"
msgstr "Aku nggak keberatan, tau nggak... Apa yang punya aku... juga punya k-"

#. Character:`saito` | Attributes:`upset`
msgctxt "JE_DOIS_SURMONTER_A_SEUL_2D210B"
msgid "Je dois surmonter ça seul."
msgstr "Aku harus ngadepin ini sendiri."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "A_A_VEUT_DIRE_QUE_NOUS_ALLONS_0FACE7"
msgid "Ça... Ça veut dire que nous allons travailler ensemble pendant un certain temps !"
msgstr "Ini... Ini artinya kita bakal kerja bareng untuk beberapa waktu!"

#. Character:`saito` | Attributes:`happy`
msgctxt "J_EN_AI_BIEN_PEUR_47CAA8"
msgid "J'en ai bien peur."
msgstr "Aku takut iya."

#. Character:`sakuya`
msgctxt "DANS_CE_CAS_C_EST_PLUT_T_UNE_B_102CE6"
msgid "Dans ce cas c'est plutôt une bonne nouvelle pour moi."
msgstr "Kalau gitu, ini malah kabar bagus buat aku."

#. Character:`saito`
msgctxt "ALLEZ_JE_VAIS_RENTRER_MERCI_PO_8FD3E8"
msgid "Allez je vais rentrer, merci pour cette discussion et à demain !"
msgstr "Yuk aku pulang dulu, makasih buat obrolannya dan sampai besok!"

#. Character:`sakuya`
msgctxt "DEMAIN_SAITO_N_879771"
msgid "À demain {{saito.n}} !"
msgstr "Sampai besok {{saito.n}}!"

#. Character:`saito` | Attributes:`happy`
msgctxt "BONJOUR_45EDBF"
msgid "Bonjour !"
msgstr "Halo!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "SALUT_461921"
msgid "Salut..."
msgstr "Hai..."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "BONJOUR_TOI_AUSSI_C55E81"
msgid "... bonjour à toi aussi..."
msgstr "... halo juga buat kamu..."

#. Character:`sakuya`
msgctxt "IL_NE_FALLAIT_PAS_TE_SENTIR_OB_772818"
msgid "Il ne fallait pas te sentir obligée de venir."
msgstr "Gak usah merasa wajib buat dateng."

#. Character:`asami`
msgctxt "OH_MAIS_JE_FAIS_A_AVEC_PLAISIR_688EE5"
msgid "Oh mais je fais ça avec plaisir."
msgstr "Ah, aku malah seneng ngelakuinnya."

#. Character:`saito` | Attributes:`sad`
msgctxt "LES_FILLES_S_IL_VOUS_PLA_T_FBF93B"
msgid "Les filles s'il vous plaît..."
msgstr "Cewek-cewek, santai dong..."

#. Character:`asami` | Attributes:`happy`
msgctxt "H_H_D_SOL_E_D07174"
msgid "Héhé désolée..."
msgstr "Hehe, maaf ya..."

#. Character:`sakuya` | Attributes:`sad`
msgctxt "TOUTES_MES_EXCUSES_JE_NE_SAIS_90CE1D"
msgid "Toutes mes excuses, je ne sais pas pourquoi j'ai réagi comme ça."
msgstr "Maaf banget, aku gak ngerti kenapa aku bereaksi kayak gitu."

#. Character:`asami` | Attributes:`pouting`
msgctxt "J_AI_BIEN_UNE_PETITE_ID_E_53CB06"
msgid "J'ai bien une petite idée..."
msgstr "Aku sih ada sedikit ide..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "BON_JE_VAIS_TE_LAISSER_LE_TRAV_96BA6C"
msgid "Bon, je vais te laisser, le travail m'appelle !"
msgstr "Oke, aku cabut dulu, kerjaan manggil!"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "NE_T_INQUI_TE_PAS_JE_M_OCCUPER_387B12"
msgid "Ne t'inquiète pas, je m'occuperai bien de lui."
msgstr "Santai aja, aku bakal rawat dia dengan baik."

#. Character:`asami`
msgctxt "JE_N_EN_DOUTE_PAS_1BE0CC"
msgid "Je n'en doute pas."
msgstr "Aku nggak ragu sama sekali."

#. Character:`asami` | Attributes:`upset`
msgctxt "TSS_POUR_QUI_ELLE_SE_PREND_673EAE"
msgid "Tss pour qui elle se prend ?!"
msgstr "Tss, dia kira dia siapa sih?!"

#. Character:`sakuya`
msgctxt "TU_SEMBLES_DE_BONNE_HUMEUR_4445E8"
msgid "Tu sembles de bonne humeur !"
msgstr "Kamu keliatan lagi mood bagus nih!"

#. Character:`saito` | Attributes:`happy`
msgctxt "OUI_J_AI_PASS_LA_MATIN_E_AVEC_223C5A"
msgid "Oui j'ai passé la matinée avec {{asami.n}}."
msgstr "Iya, aku habisin pagi sama {{asami.n}}."

#. Character:`saito`
msgctxt "A_M_A_FAIT_UN_PEU_OUBLIER_LA_EF54BC"
msgid "Ça m'a fait un peu oublier la pression que j'avais sur les épaules."
msgstr "Itu bikin aku agak lupa tekanan yang aku rasain di pundak."

#. Character:`sakuya` | Attributes:`sad`
msgctxt "TU_SEMBLES_DE_MAUVAISE_HUMEUR_D4F5DC"
msgid "Tu sembles de mauvaise humeur !"
msgstr "Kamu keliatan lagi bad mood nih!"

#. Character:`saito` | Attributes:`sad`
msgctxt "A_SE_VOIT_TANT_QUE_A_62F524"
msgid "Ça se voit tant que ça ?"
msgstr "Sampai segitu jelas ya?"

#. Character:`sakuya`
msgctxt "UN_PEU_QUE_SE_PASSE_T_IL_2CB603"
msgid "Un peu... Que se passe-t-il ?"
msgstr "Sedikit... Ada apa sih?"

#. Character:`saito` | Attributes:`upset`
msgctxt "J_AI_REPENS_CE_QUE_TU_M_AS_DIT_A42108"
msgid "J'ai repensé à ce que tu m'as dit au sujet de cet homme et ça m'a travaillé toute la nuit."
msgstr "Aku terus mikirin apa yang kamu bilang soal cowok itu, dan itu bikin aku nggak bisa tidur semaleman."

#. Character:`saito`
msgctxt "JE_LUI_EN_AI_PARL_CE_MATIN_MAI_955402"
msgid "Je lui en ai parlé ce matin mais... J'ai l'impression qu'elle sous-estime la capacité de certaines personnes à la manipulation."
msgstr "Aku udah ngomong ke dia pagi ini tapi... Kayaknya dia ngeremehin kemampuan beberapa orang buat manipulasi."

#. Character:`saito`
msgctxt "ET_COMME_ELLE_EST_ASSEZ_NA_VE_6FC56B"
msgid "Et comme elle est assez naïve par nature j'ai peur qu'elle se fasse avoir."
msgstr "Dan karena dia emang agak polos, aku takut dia bakal ketipu."

#. Character:`sakuya` | Attributes:`neutral`
msgctxt "W_TU_VEUX_QUE_JE_M_EN_OCCUPE_B6E8D2"
msgid "..[w] Tu veux que je m'en occupe ?"
msgstr "..[w] Kamu mau aku yang urusin?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "TOI_MAIS_TU_VOUDRAIS_FAIRE_QUO_7B3CAE"
msgid "Toi ? Mais tu voudrais faire quoi ?"
msgstr "Lo? Tapi kamu mau ngapain sih?"

#. Character:`sakuya` | Attributes:`angry`
msgctxt "JE_POURRAIS_LE_T_BF258E"
msgid "Je pourrais le t-"
msgstr "Aku bisa aja nge-lak-"

#. Character:`chef`
msgctxt "FONT_SIZE_14_ALLEZ_AU_BOULOT_848DA0"
msgid "[font_size=14]Allez au boulot ![/font_size]"
msgstr "[font_size=14]Ayok kerja![/font_size]"

#. Character:`sakuya` | Attributes:`sad`
msgctxt "PLUS_LES_JOURS_PASSENT_PLUS_TU_1EFA8B"
msgid "Plus les jours passent, plus tu as une mine sombre."
msgstr "Hari-hari berlalu, muka kamu makin kelihatan suram."

#. Character:`saito` | Attributes:`sad`
msgctxt "OUI_JE_JE_NE_SAIS_PAS_SI_JE_ME_EFE9A3"
msgid "Oui je... je ne sais pas si je me fais du soucis pour rien."
msgstr "Iya aku... aku nggak yakin aku cemas tanpa alasan."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "DANS_CE_CAS_EXPLIQUE_MOI_ET_PE_F8D7CF"
msgid "Dans ce cas explique-moi et peut-être que je pourrais t'aider à y voir plus clair."
msgstr "Kalau gitu jelasin ke aku, mungkin aku bisa bantu kamu biar lebih jelas."

#. Character:`saito` | Attributes:`upset`
msgctxt "C_EST_TOUJOURS_PROPOS_DE_CE_TY_01E7F6"
msgid "C'est toujours à propos de ce type, j'ai l'impression qu'il a jeté son dévolu sur {{yasuka.n}}."
msgstr "Ini masih soal cowok itu, aku ngerasa dia udah ngincer {{yasuka.n}}."

#. Character:`sakuya` | Attributes:`neutral`
msgctxt "ET_TU_PENSES_QU_IL_LUI_VEUT_DU_925A66"
msgid "Et tu penses qu'il lui veut du mal ?"
msgstr "Terus kamu pikir dia mau nyakitin dia ya?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "HONNETEMENT_JE_NE_SAIS_PAS_MAI_4CA581"
msgid "Honnêtement je ne sais pas, mais j'ai un mauvais pressentiment."
msgstr "Jujur aku gak tau, tapi aku punya firasat buruk."

#. Character:`sakuya`
msgctxt "TU_PENSES_QU_ELLE_N_EST_PAS_CA_7D964C"
msgid "Tu penses qu'elle n'est pas capable de se defendre seule ? Tu n'as pas confiance en elle ?"
msgstr "Kamu pikir dia gak bisa bela diri sendiri? Kamu gak percaya sama dia?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "TR_S_BONNE_QUESTION_3B21C2"
msgid "Très bonne question..."
msgstr "Pertanyaan yang bagus banget..."

#. Character:`sakuya` | Attributes:`melancholic`
msgctxt "JE_COMPREND_COMMENCE_LE_SERVIC_CBD947"
msgid "Je comprends... Commence le service sans moi, il y a quelque chose dont je dois m'occuper."
msgstr "Aku ngerti... Mulai aja tugasnya tanpa aku, aku ada urusan yang harus aku beresin."

#. Character:`saito` | Attributes:`surprised`
msgctxt "MAIS_TU_VAS_O_E0ED85"
msgid "Mais tu vas où ?!"
msgstr "Tapi kamu mau kemana?!"

#. Character:`sakuya`
msgctxt "UNE_PETITE_COURSE_A_FAIRE_JE_R_04892B"
msgid "Une petite course à faire, je reviens vite, c'est promis !"
msgstr "Ada sedikit urusan, aku bakal balik cepet, janji!"

#. Character:`narrator`
msgctxt "CE_N_EST_PAS_EN_ELLE_QUE_JE_N_60A1F2"
msgid "Ce n'est pas en elle que je n'ai pas confiance mais en lui."
msgstr "Bukan dia yang aku gak percaya, tapi dia."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "PARFAIT_JE_VOIS_QUE_TU_AS_MIS_590D6D"
msgid "Parfait, je vois que tu as mis de l'ordre dans ton esprit !"
msgstr "Sip, aku liat kamu udah beresin pikiran kamu!"

#. Character:`sakuya`
msgctxt "TU_VIENS_LE_SERVICE_VA_COMMENC_0978FB"
msgid "Tu viens ? Le service va commencer !"
msgstr "Kamu ikut gak? Tugasnya bakal mulai nih!"

#. Character:`saito`
msgctxt "J_ARRIVE_TOUT_DE_SUITE_EA0C0B"
msgid "J'arrive tout de suite !"
msgstr "Aku langsung dateng!"

#. Character:`narrator`
msgctxt "ELLE_EST_ADULTE_ELLE_SAURA_S_272C99"
msgid "Elle est adulte, elle saura s'en occuper."
msgstr "Dia sudah dewasa, dia pasti bisa ngurusin sendiri."

#. Character:`saito` | Attributes:`happy`
msgctxt "FINALEMENT_TU_AS_PRIS_TA_JOURN_344563"
msgid "Finalement tu as pris ta journée..."
msgstr "Akhirnya kamu ambil libur juga ya..."

#. Character:`sakuya` | Attributes:`sad`
msgctxt "D_SOL_E_A_A_PRIS_BIEN_PLUS_DE_EFD9E8"
msgid "Désolée, ça a pris bien plus de temps que je ne l'aurais pensé."
msgstr "Maaf, ini makan waktu lebih lama dari yang aku kira."

#. Character:`saito`
msgctxt "C_EST_PAS_GRAVE_C_TAIT_S_REMEN_342B15"
msgid "C'est pas grave, c'était sûrement important !"
msgstr "Gak apa-apa, pasti itu penting banget!"

#. Character:`sakuya`
msgctxt "TU_ES_UN_AMOUR_TU_NE_M_EN_VEUX_6A130C"
msgid "Tu es un amour, tu ne m'en veux même pas."
msgstr "Kamu baik banget, bahkan gak marah sama aku."

#. Character:`saito`
msgctxt "TU_AVAIS_TES_RAISONS_3E975E"
msgid "Tu avais tes raisons..."
msgstr "Kamu pasti punya alasan..."

#. Character:`saito` | Attributes:`guilty`
msgctxt "MAIS_NE_ME_FAIS_PAS_A_TOUS_LES_DAC20A"
msgid "Mais ne me fais pas ça tous les jours non plus."
msgstr "Tapi jangan sering-sering gitu ya."

#. Character:`saito`
msgctxt "LE_CHEF_NE_M_A_PAS_L_CH_D_UNE_32EB07"
msgid "Le chef ne m'a pas lâché d'une semelle aujourd'hui."
msgstr "Bos gak lepasin aku sedetik pun hari ini."

#. Character:`sakuya`
msgctxt "HAHA_JE_SAURAI_ME_FAIRE_PARDON_D9EF51"
msgid "Haha... Je saurai me faire pardonner."
msgstr "Haha... Aku bakal cari cara buat minta maaf."

#. Character:`saito`
msgctxt "PASSE_UNE_BONNE_SOIR_853947"
msgid "Passe une bonne soir-"
msgstr "Semoga malammu menyenang-"

#. Character:`asami` | Attributes:`happy`
msgctxt "TE_VOILA_MON_AMOUR_359611"
msgid "Te voila mon amour !"
msgstr "Ini dia sayangku!"

#. Character:`asami` | Attributes:`happy`
msgctxt "TE_VOILA_ENFIN_D4FD85"
msgid "Te voila enfin !"
msgstr "Akhirnya kamu datang juga!"

#. Character:`asami`
msgctxt "TU_M_AS_MANQU_TU_SAIS_B3CEDE"
msgid "Tu m'as manqué tu sais."
msgstr "Aku kangen kamu, tau nggak."

#. Character:`asami`
msgctxt "ON_VA_CHEZ_TOI_7A48F9"
msgid "On va chez toi ?"
msgstr "Kita ke rumah kamu?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "OH_EUH_D_ACCORD_1BF5C5"
msgid "Oh euh d'accord..."
msgstr "Oh ya udah deh..."

#. Character:`saito` | Attributes:`happy`
msgctxt "BIENT_T_SAKUYA_N_9F1D72"
msgid "À bientôt {{sakuya.n}}."
msgstr "Sampai ketemu lagi {{sakuya.n}}."

#. Character:`asami` | Attributes:`pouting`
msgctxt "OUAIS_C_EST_A_PLUS_F21687"
msgid "Ouais c'est ça, à plus !"
msgstr "Iya iya, sampai nanti!"

#. Character:`saito`
msgctxt "restaurant_exterior_ae580556"
msgid "Tu ne pourras pas me retenir éternellement ici, tu sais..."
msgstr "Kamu nggak bakal bisa tahan aku di sini terus, tau nggak..."

#. Character:`saito`
msgctxt "restaurant_exterior_caa451d0"
msgid "À un moment, ma famille va s'inquiéter en voyant que je ne reviens pas."
msgstr "Nanti keluargaku bakal mulai khawatir kalau aku nggak balik-balik."

#. Character:`saito`
msgctxt "restaurant_exterior_277565dc"
msgid "Et ton père... tu crois qu'il me laissera rester ici même en dehors des heures de travail ?"
msgstr "Dan ayah kamu... kamu pikir dia bakal ngijinin aku tinggal di sini di luar jam kerja?"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_exterior_a1471b81"
msgid "Que tu es bête. Bien sûr que je vais te laisser rentrer chez toi..."
msgstr "Dasar kamu bodoh. Tentu aja aku bakal biarin kamu pulang ke rumah..."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "restaurant_exterior_d211722f"
msgid "Toutefois, tu ne dois avoir aucune interaction avec une autre femme que moi."
msgstr "Tapi, kamu nggak boleh ada interaksi sama cewek lain selain aku."

#. Character:`saito` | Attributes:`upset`
msgctxt "restaurant_exterior_d9ca128d"
msgid "{{sakuya.n}}... même avec toute la meilleure volonté du monde, ça ne fonctionnera pas."
msgstr "{{sakuya.n}}... meskipun kamu punya niat sebaik apapun, itu nggak bakal berhasil."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_exterior_78c137fd"
msgid "Je crois que tu as tendance à oublier ce dont je suis capable..."
msgstr "Kayaknya kamu suka lupa aku bisa ngapain aja ya..."

#. Character:`saito`
msgctxt "restaurant_exterior_03775ec8_2"
msgid "..."
msgstr "..."

#. Character:`sakuya` | Attributes:`angry`
msgctxt "restaurant_exterior_ad3b6f63"
msgid "Nous ferons comme je le dis et tout se passera très bien !"
msgstr "Kita bakal ngelakuin sesuai kata aku dan semuanya bakal lancar!"

#. Character:`chef`
msgctxt "restaurant_exterior_56476e68"
msgid "Allez, vous deux, assez bavardé !"
msgstr "Ayo, kalian berdua, cukup ngobrolnya!"

#. Character:`chef`
msgctxt "restaurant_exterior_48c3da10"
msgid "Il est temps de se mettre au boulot !"
msgstr "Saatnya kerja!"

#. Character:`asami` | Attributes:`neutral`
msgctxt "ON_AURAIT_D_FINITIVEMENT_DU_CO_1077A6"
msgid "On aurait définitivement dû commencer par là !"
msgstr "Kita seharusnya mulai dari sini!"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "SI_TU_KIDNAPPE_QUELQU_UN_TU_RE_0DD137"
msgid "Si tu kidnappais quelqu'un... Tu retournerais faire ta petite vie tranquillement chez toi ?"
msgstr "Kalau kamu menculik seseorang... Apa kamu bakal balik dan menjalani hidupmu dengan tenang di rumah?"

#. Character:`asami`
msgctxt "JE_NE_SAIS_PAS_J_AI_JAMAIS_KID_366079"
msgid "Je ne sais pas, je n'ai jamais kidnappé personne."
msgstr "Aku nggak tahu, aku belum pernah menculik siapa pun."

#. Character:`sakuya` | Attributes:`angry`
msgctxt "restaurant_exterior_b0bbba30"
msgid "Je peux savoir ce que vous faites à trainer devant notre restaurant ?!"
msgstr "Boleh tau kalian ngapain nongkrong di depan restoran kita?!"

#. Character:`asami` | Attributes:`happy`
msgctxt "restaurant_exterior_d888fb8c"
msgid "Oh ! Enfin !"
msgstr "Oh! Akhirnya!"

#. Character:`sakuya`
msgctxt "restaurant_exterior_f44ec712"
msgid "Allez-vous-en ! Ce n'est pas un endroit pour vous ici !"
msgstr "Pergi sana! Ini bukan tempat buat kalian!"

#. Character:`noriko` | Attributes:`angry`
msgctxt "restaurant_exterior_a10f6673"
msgid "Hey ! On a le droit d'aller où bon nous semble !"
msgstr "Hei! Kita berhak ke mana aja yang kita mau!"

#. Character:`noriko` | Attributes:`-angry`
msgctxt "restaurant_exterior_69991313"
msgid "De plus, le restaurant est encore ouvert non ?"
msgstr "Lagipula, restoran ini masih buka kan?"

#. Character:`sakuya`
msgctxt "restaurant_exterior_3ce0a30a"
msgid "Pas pour vous ! Allez-vous en tout de suite !"
msgstr "Gak buat kalian! Pergi sekarang juga!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "restaurant_exterior_d4ee49ad"
msgid "... On partira juste après y avoir jeté un coup d'œil !"
msgstr "... Kita cuma bakal pergi setelah lihat-lihat dulu!"

#. Character:`sakuya`
msgctxt "restaurant_exterior_39adb155"
msgid "Ne me faites pas répéter. Allez-vous-en, ou vous allez avoir des problèmes !"
msgstr "Jangan suruh aku ulangin. Pergi, atau kalian bakal dapat masalah!"

#. Character:`noriko`
msgctxt "restaurant_exterior_2fdbcb5f"
msgid "Cette fille est complètement tarée..."
msgstr "Gadis ini bener-bener gila..."

#. Character:`asami` | Attributes:`upset`
msgctxt "restaurant_exterior_dc69a1c8"
msgid "Écoute... On ne cherche pas à avoir de problèmes, nous sommes à la recherche d'une personne qu-"
msgstr "Dengerin... Kita gak mau cari masalah, kita lagi nyari seseorang yang-"

#. Character:`sakuya`
msgctxt "restaurant_exterior_d9e68ba2"
msgid "Il n'est pas ici, maintenant partez !"
msgstr "Dia nggak ada di sini, sekarang pergi sana!"

#. Character:`asami` | Attributes:`bored`
msgctxt "restaurant_exterior_3708318b"
msgid "... Très bien, nous partons, désolées d'avoir dérangé."
msgstr "... Oke deh, kita pergi, maaf sudah ganggu."

#. Character:`noriko` | Attributes:`angry`
msgctxt "restaurant_exterior_637eccb0"
msgid "Quoi ?! Mais..."
msgstr "Apa?! Tapi..."

#. Character:`asami`
msgctxt "restaurant_exterior_74c95242"
msgid "[font_size=14]Je t'expliquerai après...[/font_size]"
msgstr "[font_size=14]Nanti aku jelasin...[/font_size]"

#. Character:`sakuya`
msgctxt "restaurant_exterior_50e93b7d"
msgid "Tchh... foutues emmerdeuses."
msgstr "Tchh... brengsek emang cewek nyebelin kayak gitu."

#. Character:`narrator`
msgctxt "restaurant_exterior_3e12dbac"
msgid "Bordel, j'ai dit que je m'en occupais, mais je vois pas ce que je pourrais faire contre {{akira.n}}."
msgstr "Sialan, aku udah bilang aku yang urus, tapi aku nggak tau harus ngapain lawan {{akira.n}}."

#. Character:`narrator`
msgctxt "restaurant_exterior_45432928"
msgid "De plus, il vient d'avoir sa troisième dose et je suis sa cible..."
msgstr "Apalagi dia baru aja dapet dosis ketiga dan aku jadi targetnya..."

#. Character:`narrator`
msgctxt "restaurant_exterior_96bd0dd6"
msgid "C'est trop demander d'avoir la paix pour une fois ?"
msgstr "Minta damai sekali aja susah banget ya?"

#. Character:`macumba`
msgctxt "restaurant_exterior_98fe6f3c"
msgid "Petit frère, tu vas bien ?"
msgstr "Adik kecil, kamu baik-baik aja?"

#. Character:`macumba`
msgctxt "restaurant_exterior_3e4481b5"
msgid "Cela faisait tellement longtemps !"
msgstr "Udah lama banget nggak ketemu!"

#. Character:`saito` | Attributes:`happy`
msgctxt "restaurant_exterior_d7bc1d3b"
msgid "{{macumba.n}} ! Je suis trop content que tu sois là ! As-tu croisé {{akira.n}} ?"
msgstr "{{macumba.n}}! Aku seneng banget kamu di sini! Kamu ketemu {{akira.n}} nggak?"

#. Character:`macumba` | Attributes:`-happy`
msgctxt "restaurant_exterior_75010a1c"
msgid "Oui, il est parti en courant en direction du canal !"
msgstr "Iya, dia kabur lari ke arah kanal!"

#. Character:`saito`
msgctxt "restaurant_exterior_1a307b36"
msgid "Il a pris quelque chose que je dois récupérer..."
msgstr "Dia bawa sesuatu yang harus aku ambil kembali..."

#. Character:`saito`
msgctxt "restaurant_exterior_b794ac8e"
msgid "Une course poursuite à travers la ville, ça te branche ?"
msgstr "Kejar-kejaran keliling kota, kamu mau?"

#. Character:`macumba` | Attributes:`happy`
msgctxt "restaurant_exterior_377a5381"
msgid "Oh-ho petit frère ! J'attendais ça avec impatience, j'ai justement besoin de digérer un peu."
msgstr "Oh-ho adik kecil! Aku udah nungguin ini, aku emang perlu cerna dulu nih."

#. Character:`macumba`
msgctxt "restaurant_exterior_5f9d007c"
msgid "Let's go !"
msgstr "Ayo gas!"

#. Character:`narrator`
msgctxt "restaurant_exterior_7d9104ae"
msgid "Au moins avec lui en soutien en cas de problème, je devrais m'en sortir vivant !"
msgstr "Setidaknya ada dia yang dukung kalau ada masalah, aku harusnya bisa selamat deh!"

#. Character:`noriko`
msgctxt "restaurant_exterior_6190d991"
msgid "Hey ! Et nous alors ?"
msgstr "Hei! Terus kita gimana dong?"

#. Character:`kimochi`
msgctxt "restaurant_exterior_52301862"
msgid "Je pose juste une petite question comme ça, mais..."
msgstr "Aku cuma nanya santai aja, tapi..."

#. Character:`kimochi`
msgctxt "restaurant_exterior_461dcfd8"
msgid "Qui va payer pour le restaurant ?"
msgstr "Siapa yang bakal bayarin restoran?"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "restaurant_exterior_4d58e97a"
msgid "D'après toi, tête de bite ?"
msgstr "Menurut kamu, otak penis?"

#. Character:`kimochi` | Attributes:`horny`
msgctxt "restaurant_exterior_a4ab5bff"
msgid "Évidemment... une attaque sur le physique."
msgstr "Jelas... serangan ke fisik."

#. Character:`kimochi`
msgctxt "restaurant_exterior_1fd2daae"
msgid "Elle est folle de moi, c'est sûr !"
msgstr "Dia gila banget sama aku, itu pasti!"

#. Character:`notice`
msgctxt "restaurant_exterior_b5ce2f20"
msgid "Vous êtes libéré de toutes restrictions qui vous étaient imposées par {{sakuya.n}}. Vous pouvez désormais vous déplacer comme vous le souhaitez."
msgstr "Kamu bebas dari semua batasan yang sebelumnya {{sakuya.n}} terapin ke kamu. Sekarang kamu bisa bergerak sesuka hati kamu."

#. Character:`asami`
msgctxt "ALORS_834F13"
msgid "Alors ?!"
msgstr "Jadi?!"

#. Character:`saito`
msgctxt "IL_NE_L_A_PAS_VUE_DEPUIS_UN_MO_D3FD33"
msgid "Il ne l'a pas vue depuis un moment, mais il va essayer de la raisonner dès qu'il la verra."
msgstr "Dia udah nggak liat dia beberapa waktu, tapi bakal coba bikin dia sadar pas ketemu nanti."

#. Character:`asami` | Attributes:`upset`
msgctxt "ON_DEVRAIT_PEUT_TRE_PR_VENIR_L_1C0C09"
msgid "On devrait peut-être prévenir la police, tu ne crois pas ?"
msgstr "Mungkin kita harus ngabarin polisi, gimana menurut kamu?"

#. Character:`saito`
msgctxt "IL_ME_L_A_D_CONSEILL_A_SERAIT_DEECB8"
msgid "... Il me l'a déconseillé, ça serait pire que tout."
msgstr "... Dia nyaranin jangan, itu malah bakal makin parah."

#. Character:`saito`
msgctxt "ON_NE_DOIT_ABSOLUMENT_PAS_LA_C_A9F4BC"
msgid "On ne doit absolument pas la contrarier."
msgstr "Kita nggak boleh bikin dia kesel sama sekali."

#. Character:`asami` | Attributes:`pouting`
msgctxt "ET_ELLE_PEUT_S_EN_DONNER_C_UR_0B4689"
msgid "Et elle peut s'en donner à cœur joie autant qu'elle le veut."
msgstr "Dan dia bisa puas-puasin sepuasnya sesuka hati dia."

#. Character:`asami` | Attributes:`upset`
msgctxt "D_SOL_E_CETTE_SITUATION_ME_REN_68C798"
msgid "Désolée, cette situation me rend folle !"
msgstr "Maaf ya, situasi ini bikin aku gila!"

#. Character:`asami` | Attributes:`neutral`
msgctxt "ON_DEVRAIT_PEUT_TRE_LA_CHERCHE_810C64"
msgid "On devrait peut-être la chercher partout en ville ?"
msgstr "Mungkin kita harus nyari dia di seluruh kota?"

#. Character:`saito` | Attributes:`upset`
msgctxt "NON_J_AI_BIEN_PEUR_QUE_CELA_NE_776322"
msgid "Non, j'ai bien peur que cela ne serve à rien, elle sait être particulièrement discrète..."
msgstr "Gak deh, aku takut itu gak bakal ngaruh, dia emang jago banget buat nyamar..."

#. Character:`asami`
msgctxt "ET_NORIKO_N_ELLE_NE_RISQUE_RIE_C912FC"
msgid "Et {{noriko.n}} ? Elle ne risque rien ?"
msgstr "Terus {{noriko.n}} gimana? Dia gak bakal kena apa-apa kan?"

#. Character:`asami`
msgctxt "JE_VEUX_DIRE_SI_ELLE_S_EN_PREN_7337C4"
msgid "Je veux dire, si elle s'en prend à toutes les filles proches de toi..."
msgstr "Maksud aku, kalo dia menyerang semua cewek yang deket sama kamu..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "MERDE_TU_AS_RAISON_NOUS_DEVONS_4AA83B"
msgid "Merde ! Tu as raison, nous devons la prévenir, dépêchons-nous !"
msgstr "Sialan! Kamu bener, kita harus ngasih tau dia, cepet dong!"

#. Character:`narrator`
msgctxt "tb00168585f"
msgid "Finalement ce n'était pas si terrible que ça..."
msgstr "Ternyata gak seburuk yang aku kira..."

#. Character:`narrator`
msgctxt "ta493e53379"
msgid "Et grâce à elle j'ai enfin pu obtenir la réponse que je j'attendais."
msgstr "Dan berkat dia aku akhirnya bisa dapetin jawaban yang aku tunggu."

#. Character:`narrator`
msgctxt "teff6fe3abd"
msgid "Sans devoir trop sacrifier."
msgstr "Tanpa harus terlalu banyak ngorbanin."

#. Character:`narrator`
msgctxt "t796f5dfbcc"
msgid "Je suis sur que {{sayuri.n}} sera ravie !"
msgstr "Aku yakin {{sayuri.n}} bakal seneng banget!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t8c0d51d6f7"
msgid "Je dois me dépêcher à présent, c'est bientôt l'heure du rendez vous. !"
msgstr "Sekarang aku harus buru-buru, bentar lagi waktunya janjian!"

#. Character:`saito`
msgctxt "INSTALLONS_QUELQUES_AFFICHES_I_19B322"
msgid "Installons quelques affiches ici."
msgstr "Pasang beberapa poster di sini."

#. Character:`saito`
msgctxt "BON_A_DEVRAIT_SUFFIRE_POUR_ICI_9D8B08"
msgid "Bon, ça devrait suffire pour ici, allons voir du côté du konbini."
msgstr "Oke, seharusnya cukup di sini, ayo kita cek di konbini."

#. Character:`noriko`
msgctxt "JE_SUIS_CERTAINE_QUE_TOUT_A_ES_155F46"
msgid "Je suis certaine que tout ça est encore lié à l'autre folle !"
msgstr "Aku yakin semua ini masih ada hubungannya sama gila itu!"

#. Character:`noriko`
msgctxt "ELLE_N_A_PAS_PU_S_EMP_CHER_DE_BC6734"
msgid "Elle n'a pas pu s'empêcher de recommencer ses conneries."
msgstr "Dia nggak bisa nahan diri buat nggak ngelakuin omong kosongnya lagi."

#. Character:`noriko`
msgctxt "ET_J_EN_AURAI_LA_PREUVE_286746"
msgid "Et j'en aurai la preuve..."
msgstr "Dan aku bakal punya buktinya..."

#. Character:`noriko` | Attributes:`bad`
msgctxt "J_AI_H_TE_DE_VOIR_LA_T_TE_DE_S_029C12"
msgid "J'ai hâte de voir la tête de {{saito.n}} quand j'aurai résolu toute cette histoire."
msgstr "Aku nggak sabar liat ekspresi {{saito.n}} pas aku udah beresin semua masalah ini."

#. Character:`noriko`
msgctxt "NORMALEMENT_SI_J_ESCALADE_ICI_31B873"
msgid "Normalement... si j'escalade ici... je devrais pouvoir..."
msgstr "Seharusnya... kalo aku panjat di sini... aku harusnya bisa..."

#. Character:`noriko`
msgctxt "ET_VOIL_BFEAEB"
msgid "Et voilà !"
msgstr "Nah, kan!"

#. Character:`chef`
msgctxt "A_SUFFIT_ALLEZ_VOUS_EN_VOUS_F_47EB34"
msgid "Ça suffit allez-vous-en, vous faites fuir les clients !"
msgstr "Udah cukup, pergi sana, kalian malah bikin pelanggan kabur!"

#. Character:`cop` | Attributes:`neutral`
msgctxt "JE_REGRETTE_MAIS_IL_FAUDRA_VOU_363268"
msgid "Je regrette mais il faudra vous y faire, ce n'est que temporaire !"
msgstr "Maaf ya, tapi kamu harus terima, ini cuma sementara!"

#. Character:`chef` | Attributes:`angry`
msgctxt "TEMPORAIRE_MON_CUL_OUI_90E559"
msgid "Temporaire mon cul oui !"
msgstr "Sementara? Bodoh banget kamu!"

#. Character:`chef`
msgctxt "A_FAIT_D_J_TROIS_JOURS_ET_VOU_51C084"
msgid "Ça fait déjà trois jours et vous me sortez le même refrain encore et encore."
msgstr "Ini udah tiga hari dan kamu masih aja ngulangin alasan yang sama terus."

#. Character:`cop` | Attributes:`angry`
msgctxt "MONSIEUR_VOUS_ALLEZ_BAISSER_D_4CA299"
msgid "Monsieur, vous allez baisser d'un ton ! Je vous ai déjà expliqué que nous devons placer sous surveillance les lieux où notre fugitif pourrait se réfugier."
msgstr "Bro, turunin volume suaramu! Aku udah jelasin kalo kita harus ngawasin tempat-tempat yang mungkin jadi tempat persembunyian buronan kita."

#. Character:`chef`
msgctxt "J_AI_D_J_DIT_QUE_CE_GAR_ON_N_A_0A5D15"
msgid "J'ai déjà dit que ce garçon n'a pas pu faire ce dont vous l'accusez ! C'est impossible !"
msgstr "Aku udah bilang kalau cowok itu gak mungkin ngelakuin apa yang kalian tuduhin! Gak mungkin!"

#. Character:`chef`
msgctxt "VOUS_POUVIEZ_TOUJOURS_FAIRE_A_AC4CF2"
msgid "Vous pouviez toujours faire ça discrètement et mettre quelqu'un en planque."
msgstr "Kalian masih bisa lakuin itu secara diam-diam dan naro seseorang buat ngawasin."

#. Character:`chef`
msgctxt "TOUT_A_RESSEMBLE_BIEN_TROP_DE_8F180A"
msgid "Tout ça ressemble bien trop à de l'intimidation !"
msgstr "Semua ini terlalu mirip sama bentuk intimidasi!"

#. Character:`chef`
msgctxt "CE_SONT_DES_M_THODES_DE_MAFIEU_9EC586"
msgid "Ce sont des méthodes de mafieux et je n'attends pas à ça de la police !"
msgstr "Ini cara-cara preman dan aku gak harap kayak gini dari polisi!"

#. Character:`cop` | Attributes:`bad`
msgctxt "CONTINUEZ_COMME_A_ET_JE_VAIS_D_F23B09"
msgid "Continuez comme ça et je vais demander au service de l'hygiène de faire une petite inspection..."
msgstr "Terus gitu aja, aku bakal minta dinas kesehatan buat ngecek sedikit..."

#. Character:`chef` | Attributes:`mocking`
msgctxt "DONC_JE_NE_R_VAIS_PAS_CE_SONT_20F8B4"
msgid "Donc je ne rêvais pas, ce sont bien des menaces ! Eh bien allez-y ! Mon restaurant est impeccable !"
msgstr "Jadi aku gak ngelantur, ini emang ancaman! Ya udah, lanjut aja! Restoran aku bersih banget!"

#. Character:`chef`
msgctxt "LES_TOILETTES_SONT_TELLEMENT_P_05641D"
msgid "Les toilettes sont tellement propres qu'on–"
msgstr "Toiletnya bersih banget sampe–"

#. Character:`chef`
msgctxt "LAISSEZ_TOMBER_W_QU_EST_CE_QUE_A2E087"
msgid "Laissez tomber...[w] Qu'est-ce que je peux faire pour vous ?"
msgstr "Lupain aja...[w] Ada apa yang bisa aku bantu?"

#. Character:`noriko`
msgctxt "ON_EST_VENUES_VOIR_SAKUYA_N_85A37B"
msgid "On est venues voir {{sakuya.n}} !"
msgstr "Kami dateng buat ketemu {{sakuya.n}}!"

#. Character:`chef` | Attributes:`upset`
msgctxt "JE_VEUX_SAVOIR_CE_QUE_VOUS_LU_76766E"
msgid "... Je veux savoir ce que vous lui voulez ! La maintenir ici est déjà une épreuve en soi."
msgstr "... Aku pengen tau kalian mau apa sama dia! Nahan dia di sini aja udah berat banget."

#. Character:`chef`
msgctxt "CETTE_SITUATION_TANT_D_J_BIEN_43AA36"
msgid "Cette situation étant déjà bien assez compliquée comme ça, je ne veux pas ajouter d'huile sur le feu."
msgstr "Situasi ini udah cukup ribet, aku nggak mau bikin tambah panas aja."

#. Character:`noriko` | Attributes:`afraid`
msgctxt "C_EST_IMPORTANT_S_IL_VOUS_PLA_52B16C"
msgid "C'est important, s'il vous plaît..."
msgstr "Ini penting, tolong ya..."

#. Character:`sakuya`
msgctxt "PAPA_C_EST_BON_LAISSE_LES_ENTR_CF6A63"
msgid "Papa c'est bon, laisse-les entrer !"
msgstr "Papa, udah deh, biarin mereka masuk!"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "J_AI_UN_PETIT_CREUX_PEUT_TRE_P_CFD0A2"
msgid "J'ai un petit creux, peut-être pouvez-vous nous servir votre spécialité le temps que nous discutions avec votre fille ?"
msgstr "Aku agak laper nih, mungkin kalian bisa ngasih kita spesialitas rumah sambil kita ngobrol sama cewek kamu?"

#. Character:`sakuya`
msgctxt "TU_PEUX_T_OCCUPER_DE_A_CEAC76"
msgid "Tu peux t'occuper de ça ?"
msgstr "Kamu bisa urusin ini?"

#. Character:`chef` | Attributes:`happy`
msgctxt "SI_VOUS_TES_DES_CLIENTS_C_EST_3275DA"
msgid "Si vous êtes des clients... C'est différent ! Allez-y !"
msgstr "Kalau kalian pelanggan... beda cerita! Ayo masuk!"

#. Character:`noriko`
msgctxt "MAMAN_JE_SUIS_D_SOL_E_JE_NE_PE_F4D49E"
msgid "Maman... Je suis désolée, je ne pensais pas que ça se passerait aussi mal."
msgstr "Mama... Maafin aku ya, aku nggak nyangka bakal jadi seburuk ini."

#. Character:`noriko`
msgctxt "C_TAIT_UNE_ERREUR_DE_VENIR_ICI_7B9A4D"
msgid "C'était une erreur de venir ici, cette fille est bien trop folle."
msgstr "Datang ke sini emang salah, cewek ini gila banget."

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "NORIKO_N_NE_T_EN_FAIS_PAS_J_A_76C4D4"
msgid "{{noriko.n}} ne t'en fais pas, j'ai eu affaire à des gens bien plus effrayants que ça dans ma vie."
msgstr "{{noriko.n}} santai aja, aku pernah ketemu orang yang jauh lebih serem dari dia."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "ELLE_AVAIT_RAISON_JE_LUI_DEMAN_006B76"
msgid "Elle avait raison, je lui demande de prendre des risques pour moi car je ne peux pas le faire."
msgstr "Dia bener, aku nyuruh dia ambil risiko buat aku karena aku nggak bisa ngelakuinnya."

#. Character:`yasuka`
msgctxt "C_EST_ELLE_QUI_SE_RETROUVERA_L_15DD2D"
msgid "C'est elle qui se retrouvera la plus exposée."
msgstr "Dia yang bakal paling terekspos."

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "MON_ERREUR_TAIT_DE_PENSER_QUE_DEFD74"
msgid "Mon erreur était de penser que je discutais avec une jeune fille alors qu'il s'agit déjà d'une femme redoutable."
msgstr "Kesalahanku adalah mikir kalau aku lagi ngobrol sama cewek muda, padahal ini udah cewek yang berbahaya banget."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "CE_N_EST_PAS_COMME_SI_NOUS_AVI_F801D3"
msgid "Ce n'est pas comme si nous avions le choix non plus, je devais faire mon possible pour {{sayuri.n}}."
msgstr "Bukan kayak kita punya pilihan juga, aku harus ngelakuin yang terbaik buat {{sayuri.n}}."

#. Character:`noriko`
msgctxt "JE_SAIS_BIEN_W_MAIS_W_C_EST_CO_2FBFDE"
msgid "Je sais bien...[w] mais...[w] c'est comme ça aussi que {{saito.n}} gérait ses problèmes."
msgstr "Aku tahu...[w] tapi...[w] {{saito.n}} juga ngadepin masalahnya kayak gitu."

#. Character:`noriko`
msgctxt "CHAQUE_FOIS_QU_IL_PENSAIT_EN_A_0E93E2"
msgid "Chaque fois qu'il pensait en avoir fini, il y en avait un nouveau qui apparaissait."
msgstr "Setiap kali dia pikir udah kelar, selalu ada masalah baru yang muncul."

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "W_QUOI_QU_IL_EN_SOIT_ME_VOIL_E0F5BD"
msgid "...[w] Quoi qu'il en soit, me voilà avec une rivale bien plus problématique que prévu..."
msgstr "...[w] Pokoknya, sekarang aku punya saingan yang jauh lebih ribet dari yang kukira..."

#. Character:`yasuka` | Attributes:`upset`
msgctxt "PEUT_TRE_QU_L_AVENIR_CERTAINES_BC5C11"
msgid "Peut-être qu'à l'avenir certaines contre-mesures devront être prises."
msgstr "Mungkin nanti harus ada langkah antisipasi yang diambil."

#. Character:`asami`
msgctxt "tc50fe37427"
msgid "[next]"
msgstr "[next]"

#. Character:`asami`
msgctxt "menu_asami_room_waiting_40045615"
msgid "Salut toi !"
msgstr "Hai kamu!"

#. Character:`asami`
msgctxt "menu_asami_room_waiting_f6cde10a"
msgid "Je pensais justement à toi."
msgstr "Aku lagi mikirin kamu nih."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_f261baf5"
msgid "Tu as envie de quelque chose ?"
msgstr "Kamu pengen apa?"

#. Character:`narrator`
msgctxt "t68e1a8a4dc"
msgid "Discuter"
msgstr "Ngobrol"

#. Character:`narrator`
msgctxt "t547040b4c2"
msgid "J'ai envie de toi"
msgstr "Aku pengen kamu"

#. Character:`narrator`
msgctxt "t6c1c64ba4a"
msgid "Retour"
msgstr "Kembali"

#. Character:`asami` | Attributes:`happy`
msgctxt "menu_asami_room_waiting_a628ed32"
msgid "Oh, voyez-vous ça !"
msgstr "Oh, liat tuh!"

#. Character:`asami`
msgctxt "menu_asami_room_waiting_743fefe0"
msgid "C'est plutôt rare de te voir aussi entreprenant."
msgstr "Jarang banget liat kamu segini agresif."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_2222dfd7"
msgid "Mais je ne m'en plaindrais pas."
msgstr "Tapi aku nggak bakal ngeluh soal itu."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_e62753a3"
msgid "À vrai dire... J'en avais envie moi aussi."
msgstr "Jujur aja... aku juga pengen."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_95329bae"
msgid "Alors, qu'est-ce que tu attends ?"
msgstr "Jadi, kamu tunggu apa lagi?"

#. Character:`asami`
msgctxt "menu_asami_room_waiting_a26e802e"
msgid "C'est moi ou bien mon petit poney semble bien plus excité que d'habitude ?"
msgstr "Apa ini aku aja, atau poni kecilku keliatan jauh lebih bergairah dari biasanya?"

#. Character:`saito`
msgctxt "menu_asami_room_waiting_c360c9d3"
msgid "C'est...[w] possible."
msgstr "Ini...[w] mungkin."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_fd966c1f"
msgid "Héhé..."
msgstr "Hehe..."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_e61642e6"
msgid "Je ne veux plus jamais me disputer avec toi !"
msgstr "Aku nggak mau pernah berantem sama kamu lagi!"

#. Character:`saito`
msgctxt "menu_asami_room_waiting_eb76599e"
msgid "Moi non plus."
msgstr "Aku juga gitu."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_6fd40c44"
msgid "La prochaine fois que tu dois me dire quelque chose d'important..."
msgstr "Lain kali kalau kamu mau bilang sesuatu yang penting ke aku..."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_2d5b9e56"
msgid "Insiste plus !"
msgstr "Tekan terus dong!"

#. Character:`saito`
msgctxt "menu_asami_room_waiting_f2baee58"
msgid "Promis."
msgstr "Janji deh."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_82233579"
msgid "Oh mon Dieu ! Oh mon Dieu !"
msgstr "Ya Tuhan! Ya Tuhan!"

#. Character:`asami`
msgctxt "menu_asami_room_waiting_0b7d8a15"
msgid "Je..."
msgstr "Aku..."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_3095e9ea"
msgid "Je vais jouir !"
msgstr "Aku bakal cum nih!"

#. Character:`asami`
msgctxt "menu_asami_room_waiting_82e7a915"
msgid "Franchement, c'est bien mieux lorsqu'on n'est pas dérangés."
msgstr "Jujur aja, enakan banget kalau nggak diganggu."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_2c02546e"
msgid "Tu ne crois pas ?"
msgstr "Kamu nggak setuju?"

#. Character:`saito`
msgctxt "menu_asami_room_waiting_0b853865"
msgid "Je n'osais pas le dire..."
msgstr "Aku nggak berani bilang sih..."

#. Character:`asami`
msgctxt "home_asami_asami_room_ec8e6ef7"
msgid "Pfff... Quelle situation nulle !"
msgstr "Duh... situasinya payah banget!"

#. Character:`asami`
msgctxt "home_asami_asami_room_ee95d5b9"
msgid "Je comprends pas comment j'en suis arrivée là !"
msgstr "Aku nggak ngerti gimana bisa sampai sini!"

#. Character:`sayuri`
msgctxt "home_asami_asami_room_a18e7070"
msgid "Ma chérie, tout va bien ?"
msgstr "Sayang, kamu baik-baik aja?"

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_asami_room_42a9600a"
msgid "C'est rien maman, j'ai juste un choix à faire et je ne suis pas sûre de savoir si je prendrais la bonne décision."
msgstr "Gak apa-apa, Ma, aku cuma harus milih dan aku nggak yakin bisa ambil keputusan yang bener."

#. Character:`asami`
msgctxt "home_asami_asami_room_523bebc0"
msgid "C'est juste un choix compliqué et je ne m'en sors pas..."
msgstr "Ini cuma pilihan yang ribet dan aku bener-bener bingung..."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "home_asami_asami_room_88eeb506"
msgid "Oh ! Alors peut-être que l'amie qui est venue te rendre visite pourra t'aider ?"
msgstr "Oh! Mungkin temen cewek yang tadi mampir bisa bantu kamu?"

#. Character:`asami` | Attributes:`surprised`
msgctxt "home_asami_asami_room_bef97d0f"
msgid "Une amie ?"
msgstr "Temen cewek?"

#. Character:`natsume`
msgctxt "home_asami_asami_room_75507adf"
msgid "Merci beaucoup madame, je vais prendre le relais !"
msgstr "Makasih banyak, Bu, aku bakal lanjutin dari sini!"

#. Character:`sayuri` | Attributes:`depressed`
msgctxt "home_asami_asami_room_a3efa4b0"
msgid "C'est {{sayuri.n}}, madame c'est trop... Bref ! Ravie d'avoir fait ta connaissance."
msgstr "Ini {{sayuri.n}}, Bu, ini terlalu... Pokoknya! Seneng kenal sama kamu."

#. Character:`natsume`
msgctxt "home_asami_asami_room_f5459b45"
msgid "C'est vraiment sympa ici, j'aime beaucoup !"
msgstr "Di sini beneran asik, aku suka banget!"

#. Character:`asami` | Attributes:`bored`
msgctxt "home_asami_asami_room_4543f9cf"
msgid "T'es la fille qui traînait avec {{minato.n}} hier près du canal."
msgstr "Kamu cewek yang kemarin nongkrong bareng {{minato.n}} deket kanal, kan?"

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_asami_room_2b840516"
msgid "Tu es qui exactement pour lui ?"
msgstr "Kamu sebenernya siapa buat dia?"

#. Character:`natsume` | Attributes:`happy`
msgctxt "home_asami_asami_room_2eed7b0c"
msgid "Quelqu'un qui ne te veut que du bien..."
msgstr "Seseorang yang cuma pengen yang terbaik buat kamu..."

#. Character:`natsume`
msgctxt "home_asami_asami_room_e8fce8f6"
msgid "Alors, tu as pris une décision ?"
msgstr "Jadi, kamu udah ambil keputusan?"

#. Character:`asami`
msgctxt "home_asami_asami_room_ae147d17"
msgid "... Je ne sais pas trop, j'ai désiré ça depuis si longtemps et maintenant que je l'ai, je ne suis plus sûre d'en vouloir."
msgstr "... Aku nggak yakin sih, aku udah pengen ini dari lama banget tapi sekarang setelah dapet, aku malah ragu mau nggak."

#. Character:`natsume` | Attributes:`smug`
msgctxt "home_asami_asami_room_dbd63f36"
msgid "Je constate que tu es sur la bonne voie..."
msgstr "Aku liat kamu udah di jalur yang bener..."

#. Character:`natsume`
msgctxt "home_asami_asami_room_4c92cb72"
msgid "Mais j'aimerais néanmoins que tu écoutes ça."
msgstr "Tapi aku pengen kamu dengerin ini dulu."

#. Character:`asami`
msgctxt "home_asami_asami_room_b62f03e1"
msgid "Qu'est-ce que c'est ?"
msgstr "Ini apaan sih?"

#. Character:`natsume`
msgctxt "home_asami_asami_room_b9284e40"
msgid "Un petit enregistrement. Ça te sera sûrement très utile."
msgstr "Rekaman kecil. Pasti bakal sangat berguna buat kamu."

#. Character:`natsume` | Attributes:`neutral`
msgctxt "home_asami_asami_room_a646827f"
msgid "Toutefois j'ai une condition... Détruis-le après l'avoir écouté."
msgstr "Tapi aku ada syarat... Hancurin setelah dengerin ya."

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_asami_room_fe73a7a5"
msgid "On dirait un truc d'espions..."
msgstr "Kedengerannya kayak halnya mata-mata..."

#. Character:`natsume` | Attributes:`pouting`
msgctxt "home_asami_asami_room_9ee1d2c9"
msgid "C'est à peu près ça, mais j'aurais des ennuis si ça s'apprend donc promets-le moi."
msgstr "Ya kurang lebih gitu, tapi aku bakal kena masalah kalau sampai ketahuan jadi janjiin ya."

#. Character:`asami`
msgctxt "home_asami_asami_room_f555ad92"
msgid "C'est promis !"
msgstr "Janji deh!"

#. Character:`asami`
msgctxt "home_asami_asami_room_9c702275"
msgid "Alors... Voyons ça..."
msgstr "Oke... Kita dengerin dulu nih..."

#. Character:`asami` | Attributes:`pouting`
msgctxt "IL_FAUT_ME_COMPRENDRE_AUSSI_J_EE1B85"
msgid "Il faut me comprendre aussi, j'ai de gros besoins à satisfaire."
msgstr "Kamu juga harus ngerti, aku punya kebutuhan gede yang harus dipenuhi."

#. Character:`saito` | Attributes:`happy`
msgctxt "IL_ME_SEMBLAIT_POURTANT_QU_IL_B72794"
msgid "Il me semblait pourtant qu'il n'y a pas si longtemps tu n'avais jamais fait ça."
msgstr "Aku kira sih dulu kamu nggak pernah ngelakuin itu."

#. Character:`asami`
msgctxt "PEUT_TRE_BIEN_MAIS_MAINTENANT_34BB1E"
msgid "Peut-être bien mais... Maintenant que j'ai goûté je suis accro, c'est encore plus fort que le chocolat!"
msgstr "Mungkin iya, tapi... Sekarang aku udah coba, aku kecanduan, ini lebih kuat dari cokelat!"

#. Character:`asami`
msgctxt "DONC_SI_JE_N_AI_PAS_MA_DOSE_DE_73E431"
msgid "Donc si je n'ai pas ma dose de toi régulièrement je vais être de mauvaise humeur."
msgstr "Jadi kalo aku nggak dapet dosis dari kamu secara rutin, aku bakal bad mood nih."

#. Character:`saito` | Attributes:`guilty`
msgctxt "OULA_D464D4"
msgid "Oula !"
msgstr "Wah!"

#. Character:`asami`
msgctxt "DONC_JE_COMPTE_SUR_TOI_POUR_VE_F70247"
msgid "Donc je compte sur toi pour venir passer du temps régulièrement avec moi, c'est compris ?"
msgstr "Jadi aku ngandelin kamu buat sering-sering ngabisin waktu bareng aku, ngerti ya?"

#. Character:`saito` | Attributes:`happy`
msgctxt "VOS_ORDRES_322038"
msgid "À vos ordres !"
msgstr "Siap, bos!"

#. Character:`asami`
msgctxt "D_AILLEURS_SI_TU_ES_D_ATTAQUE_4F3C69"
msgid "D'ailleurs... Si tu es d'attaque, j'enchaînerais bien sur un second round..."
msgstr "Ngomong-ngomong... Kalo kamu siap, aku pengen lanjut ronde kedua..."

#. Character:`saito` | Attributes:`guilty`
msgctxt "EN_TEMPS_NORMAL_JE_N_AURAIS_M_E1E727"
msgid "En temps normal je n'aurais même pas attendu que tu le demandes mais malheureusement je dois y aller."
msgstr "Biasanya sih aku nggak bakal nunggu kamu minta, tapi sayangnya aku harus pergi dulu."

#. Character:`asami` | Attributes:`pouting`
msgctxt "PFFF_QU_EST_CE_QUE_JE_FAIS_MOI_BCF584"
msgid "Pfff... Qu'est-ce que je fais moi en attendant ?"
msgstr "Huh... Aku ngapain dong nunggu?"

#. Character:`saito` | Attributes:`happy`
msgctxt "A_C_EST_TON_PROBL_ME_928863"
msgid "Ça c'est ton problème !"
msgstr "Itu urusan kamu!"

#. Character:`asami` | Attributes:`happy`
msgctxt "ALLEZ_VAS_Y_MON_BEL_TALON_TRAV_C0F864"
msgid "Allez vas-y mon bel étalon ! Travaille dur !"
msgstr "Ayo, kerjain tuh, jagoan aku! Kerja keras!"

#. Character:`asami`
msgctxt "JE_NE_T_ACCOMPAGNE_PAS_SINON_T_17E95D"
msgid "Je ne t'accompagne pas sinon ta collègue va encore me fusiller du regard."
msgstr "Aku nggak nemenin kamu, nanti temen kerja kamu malah ngelihatin aku kayak mau nembak."

#. Character:`saito`
msgctxt "DANS_CE_CAS_PLUS_TARD_8A290A"
msgid "Dans ce cas à plus tard !"
msgstr "Kalau gitu, sampai nanti ya!"

#. Character:`asami` | Attributes:`happy`
msgctxt "AAAAH_A_M_AVAIT_MANQU_E38FA3"
msgid "Aaaah, ça m'avait manqué !"
msgstr "Aaaah, aku kangen banget nih!"

#. Character:`asami`
msgctxt "ON_DEVRAIT_VRAIMENT_SE_FAIRE_A_888B41"
msgid "On devrait vraiment se faire ça plus souvent."
msgstr "Kita harus sering-serius ngelakuin ini."

#. Character:`saito` | Attributes:`happy`
msgctxt "TU_DIS_A_PARCE_QUE_TU_GAGNES_666DB2"
msgid "Tu dis ça parce que tu gagnes."
msgstr "Kamu bilang gitu soalnya kamu menang."

#. Character:`asami`
msgctxt "NON_PAS_SEULEMENT_JE_DIS_A_PAR_3A1B51"
msgid "Non pas seulement... Je dis ça parce que j'aime bien quand tu es là."
msgstr "Nggak cuma itu... Aku bilang gitu karena aku suka pas kamu ada di sini."

#. Character:`asami`
msgctxt "JE_ME_SENS_PLUS_D_TENDUE_2B42BC"
msgid "Je me sens plus détendue."
msgstr "Aku ngerasa lebih santai."

#. Character:`saito`
msgctxt "EH_BIEN_DANS_CE_CAS_SI_TU_ES_B_716A0F"
msgid "Eh bien dans ce cas, si tu es bien détendue je vais te laisser."
msgstr "Kalau gitu, kalo kamu udah santai, aku bakal ninggalin kamu."

#. Character:`asami` | Attributes:`pouting`
msgctxt "QUOI_D_J_NONNNN_F51D3D"
msgid "Quoi déjà ? Nonnnn"
msgstr "Udah? Nggakkkk"

#. Character:`saito`
msgctxt "C_EST_LA_VIE_Y_EN_A_QUI_DOIVEN_7700EE"
msgid "C'est la vie, y en a qui doivent bosser malheureusement..."
msgstr "Itulah hidup, ada yang harus kerja sayangnya..."

#. Character:`asami` | Attributes:`happy`
msgctxt "JE_SUIS_DE_TOUT_C_UR_AVEC_TOI_FA79F3"
msgid "Je suis de tout cœur avec toi !"
msgstr "Aku benar-benar dukung kamu!"

#. Character:`saito` | Attributes:`neutral`
msgctxt "QU_EST_CE_QUE_TU_VAS_FAIRE_E8A68A"
msgid "Qu'est-ce que tu vas faire ?"
msgstr "Kamu mau ngapain?"

#. Character:`asami`
msgctxt "CONTINUER_DE_JOUER_F54B56"
msgid "Continuer de jouer !"
msgstr "Lanjut main!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "BAH_QUOI_49ED32"
msgid "Bah quoi ?"
msgstr "Emang kenapa?"

#. Character:`asami`
msgctxt "PAS_DE_TEMPS_PERDRE_4313A2"
msgid "Pas de temps à perdre !"
msgstr "Jangan buang waktu!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_asami_asami_room_30ac16f2"
msgid "Oh !"
msgstr "Oh!"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_asami_room_19dd112e"
msgid "J'en suis !"
msgstr "Aku ikut!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_asami_room_6ef90bb7"
msgid "Je préfère me dépêcher avant que ma mère ne rentre pour essayer de faire sa curieuse !"
msgstr "Aku mending buru-buru sebelum ibu aku pulang buat ngintip!"

#. Character:`asami`
msgctxt "home_asami_asami_room_bcb277b4"
msgid "On devrait avoir une petite heure devant nous."
msgstr "Kita seharusnya punya waktu sekitar satu jam."

#. Character:`saito`
msgctxt "home_asami_asami_room_00759abf"
msgid "J'ai bien peur que ce soit loin d'être suffisant."
msgstr "Aku takut itu jauh dari cukup."

#. Character:`asami`
msgctxt "home_asami_asami_room_444b3b66"
msgid "Je... Je sais.... Mais..."
msgstr "Aku... Aku tahu.... Tapi..."

#. Character:`asami`
msgctxt "home_asami_asami_room_97ef1cfe"
msgid "Les vacances sont loin d'être...[w] terminées !"
msgstr "Liburannya jauh dari...[w] selesai!"

#. Character:`asami`
msgctxt "home_asami_asami_room_152b77d0"
msgid "Oh, bon sang..."
msgstr "Astaga..."

#. Character:`saito`
msgctxt "home_asami_asami_room_23ea0e6b"
msgid "Tu étais si pressée pour ne pas me laisser le temps d'enlever mes vêtements ?"
msgstr "Kamu buru-buru banget sampe nggak ngasih aku waktu buat lepas baju?"

#. Character:`asami`
msgctxt "home_asami_asami_room_326f75f5"
msgid "Oh mon Dieu... Ça vient !"
msgstr "Ya Tuhan... Ini datang!"

#. Character:`asami`
msgctxt "home_asami_asami_room_38bbf4d6"
msgid "Ne t'arrête pas !"
msgstr "Jangan berhenti!"

#. Character:`asami`
msgctxt "home_asami_asami_room_8901eed1"
msgid "Je vais j-"
msgstr "Aku mau me-"

#. Character:`sakuya`
msgctxt "home_asami_asami_room_9961f383"
msgid "Non non non non non !"
msgstr "Nggak nggak nggak nggak nggak!"

#. Character:`sakuya`
msgctxt "home_asami_asami_room_a6bb7c57"
msgid "Je t'avais prévenu, {{saito.n}} !"
msgstr "Aku udah bilang, {{saito.n}}!"

#. Character:`asami`
msgctxt "HEY_POURQUOI_CETTE_FOLLE_EST_C_5F2F36"
msgid "Hey, pourquoi cette folle est collée à ma fenêtre ?!!"
msgstr "Hei, kenapa si gila itu nempel di jendelaku?!!"

#. Character:`sakuya`
msgctxt "home_asami_asami_room_33df8099"
msgid "{{saito.n}} est à moi et à moi seule !"
msgstr "{{saito.n}} cuma milikku doang!"

#. Character:`asami`
msgctxt "home_asami_asami_room_8cea69bc"
msgid "Si tu es plutôt rétro-gaming j'ai la Super-NES..."
msgstr "Kalau kamu suka retro-gaming, aku punya Super-NES..."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_asami_room_520326bd"
msgid "Peu importe, montre-moi celui que tu préfères."
msgstr "Gak masalah, tunjukin aja yang kamu suka."

#. Character:`asami`
msgctxt "home_asami_asami_room_3cf5a21e"
msgid "Oui mais... C'est un jeu solo, donc ça va pas être drôle si tu passes ton temps à regarder."
msgstr "Iya sih... tapi itu game solo, jadi gak bakal asik kalau kamu cuma nonton terus."

#. Character:`asami`
msgctxt "home_asami_asami_room_678df1d6"
msgid "Que penses-tu d'un petit bomberman ?"
msgstr "Gimana kalau main bomberman dikit?"

#. Character:`saito`
msgctxt "home_asami_asami_room_18c21cb3"
msgid "Ah ! Ça ça me parle ! Très bon choix !"
msgstr "Ah! Itu baru nyantol di aku! Pilihan yang oke banget!"

#. Character:`sakuya`
msgctxt "home_asami_asami_room_bef49bc0"
msgid "Mon amour pourquoi es-tu entré dans cette maison ?"
msgstr "Sayang, kenapa kamu masuk ke rumah ini?"

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "home_asami_asami_room_dae2e233"
msgid "C'est qui cette fille ?!"
msgstr "Itu cewek siapa?!"

#. Character:`sakuya`
msgctxt "home_asami_asami_room_d0a47177"
msgid "Je suis sûre qu'elle en a après lui !"
msgstr "Aku yakin dia ngincer dia!"

#. Character:`sakuya` | Attributes:`angry`
msgctxt "home_asami_asami_room_fc6a8dba"
msgid "{{saito.n}} est à moi et à personne d'autre !"
msgstr "{{saito.n}} milikku dan bukan milik siapa pun selain aku!"

#. Character:`asami`
msgctxt "home_asami_asami_room_44fc3c3e"
msgid "Ahah tu te défendais mieux chez toi !"
msgstr "Hahaha, kamu lebih jago ngelawan di rumahmu sendiri!"

#. Character:`saito`
msgctxt "home_asami_asami_room_60271c6f"
msgid "Ahhh c'est juste que... ça fait longtemps, laisse-moi retrouver mes réflexes !"
msgstr "Ahhh, cuma... udah lama banget, kasih aku waktu buat ngembaliin refleks aku!"

#. Character:`asami`
msgctxt "home_asami_asami_room_d3d69929"
msgid "Pas de soucis grand-père !"
msgstr "Santai aja, kakek!"

#. Character:`saito`
msgctxt "home_asami_asami_room_f110498d"
msgid "Insolente !"
msgstr "Sombong banget!"

#. Character:`asami`
msgctxt "home_asami_asami_room_dadb39bd"
msgid "Haha !"
msgstr "Haha!"

#. Character:`asami`
msgctxt "home_asami_asami_room_f3f0c139"
msgid "Au fait pourquoi tu t'es assis aussi loin de moi ?"
msgstr "Ngomong-ngomong, kenapa kamu duduk jauh banget dariku?"

#. Character:`asami`
msgctxt "home_asami_asami_room_cd50a907"
msgid "Tu as peur que je te mange ou quoi ?"
msgstr "Kamu takut aku makan kamu atau gimana?"

#. Character:`saito`
msgctxt "home_asami_asami_room_9d723b0b"
msgid "Oh je..."
msgstr "Oh aku..."

#. Character:`asami`
msgctxt "home_asami_asami_room_7f674549"
msgid "Allez sois pas timide, rejoins-moi sur le lit, c'est plus confortable !"
msgstr "Ayo, jangan malu-malu, gabung yuk di tempat tidur, lebih nyaman!"

#. Character:`sakuya`
msgctxt "home_asami_asami_room_02024b09"
msgid "NON NON NON !"
msgstr "ENGGAK ENGGAK ENGGAK!"

#. Character:`sakuya`
msgctxt "home_asami_asami_room_3ad4cb3e"
msgid "Écarte-toi de lui tout de suite !"
msgstr "Jauhin dia dari dia sekarang juga!"

#. Character:`asami`
msgctxt "ENCORE_ELLE_A25FD3"
msgid "Encore elle !?"
msgstr "Dia lagi!?"

#. Character:`asami`
msgctxt "home_asami_asami_room_ae537cf2"
msgid "Qu'est-ce qu'elle fait dans mon jardin !"
msgstr "Apa dia ngapain di halaman aku!"

#. Character:`sakuya`
msgctxt "home_asami_asami_room_6ed4cc59"
msgid "[font_size=14]{{saito.n}} est à moi, t'approche pas de lui sinon...[/font_size]"
msgstr "[font_size=14]{{saito.n}} itu milik aku, jangan deketin dia kalo nggak mau...[/font_size]"

#. Character:`asami`
msgctxt "home_asami_asami_room_9bd3d4fa"
msgid "Je rêve ou elle me menace ?!"
msgstr "Aku mimpi apa dia ngeancem aku?!"

#. Character:`asami` | Attributes:`sad`
msgctxt "SAITO_N_FAIS_QUELQUE_CHOSE_S_D64E0F"
msgid "{{saito.n}}, fais quelque chose s'il te plait !"
msgstr "{{saito.n}}, tolong lakukan sesuatu!"

#. Character:`saito`
msgctxt "home_asami_asami_room_7b3994fe"
msgid "Oui... Il semble qu'elle soit un peu trop accrochée à moi."
msgstr "Iya... Kayaknya dia nempel banget sama aku."

#. Character:`saito`
msgctxt "JE_SUIS_D_SOL_JE_VAIS_ALLER_LU_9F7018"
msgid "Je suis désolé, je vais aller lui parler."
msgstr "Maaf, aku akan pergi bicara sama dia."

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_asami_room_42d87205"
msgid "Dépêche-toi, elle me fait flipper !"
msgstr "Cepetan, dia bikin aku ngeri!"

#. Character:`asami`
msgctxt "home_asami_asami_room_34079a9f"
msgid "Son regard m'a donnée la chair de poule."
msgstr "Tatapannya bikin bulu kuduk aku merinding."

#. Character:`asami`
msgctxt "JE_R_VE_OU_ELLE_TAIT_CARR_MENT_A6BA78"
msgid "Je rêve ou elle était carrément entrée dans la maison ?"
msgstr "Apa aku bermimpi atau dia benar-benar masuk ke dalam rumah?"

#. Character:`saito`
msgctxt "home_asami_asami_room_33d92d00"
msgid "Tu n'as pas rêvé, mais je vais faire en sorte que tout ça ne se produise plus jamais."
msgstr "Aku nggak mimpi, tapi aku bakal bikin supaya itu nggak pernah kejadian lagi."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_asami_asami_room_00e5327d"
msgid "Je m'en occupe tout de suite !"
msgstr "Aku bakal urusin sekarang juga!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_asami_room_dbda7cc9"
msgid "Elle a gâché notre moment rien qu'à nous..."
msgstr "Dia udah ngerusak momen kita berdua..."

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_asami_room_fbd82e2f"
msgid "Elle a gâché notre journée jeu..."
msgstr "Dia juga ngerusak hari main kita..."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_asami_asami_room_7a00707c"
msgid "De toute façon, ta mère est rentrée plus tôt que prévu."
msgstr "Pokoknya, nyokap kamu pulang lebih cepet dari yang direncanain."

#. Character:`asami` | Attributes:`surprised`
msgctxt "home_asami_asami_room_6dcc601c"
msgid "Quoi ?! Mais, elle avait dit au moins une heure, voire deux !"
msgstr "Apa?! Tapi kan dia bilang minimal sejam, bahkan dua jam!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_asami_room_dfb6681d"
msgid "Tant pis ! On remet ça à plus tard, tu promets de faire attention à toi ?"
msgstr "Ya sudahlah! Kita tunda aja, janji deh kamu bakal hati-hati?"

#. Character:`asami`
msgctxt "home_asami_asami_room_f987b077"
msgid "Je n'ai pas aimé son regard. Rien que d'y penser... Brrrr."
msgstr "Aku nggak suka tatapannya. Cuma mikirin aja... Brrr."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_asami_room_d65773fa"
msgid "Je te promets de faire attention !"
msgstr "Aku janji bakal hati-hati!"

#. Character:`asami`
msgctxt "home_asami_asami_room_4e0a0b76"
msgid "Hey salut toi !"
msgstr "Hey, hai kamu!"

#. Character:`asami`
msgctxt "home_asami_asami_room_0a55fd05"
msgid "Si j'avais su que tu viendrais me voir ce soir, je me serais préparée..."
msgstr "Kalau aku tau kamu bakal dateng malam ini, aku pasti udah siap-siap..."

#. Character:`asami`
msgctxt "home_asami_asami_room_2ffa91d2"
msgid "Tu veux regarder un film, jouer à la console ou faire la bête à deux dos ?"
msgstr "Mau nonton film, main game, atau bercinta berdua?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_asami_asami_room_88892c3b"
msgid "Écoute..."
msgstr "Dengerin ya..."

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_asami_asami_room_cf3c3a75"
msgid "Oh désolé, je ne pensais pas que tu serais habillée en..."
msgstr "Oh maaf, aku gak nyangka kamu bakal pake baju..."

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_asami_room_16672cb8"
msgid "C'est bon... C'est juste une nuisette !"
msgstr "Santai aja... Ini cuma baju tidur tipis kok!"

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_asami_room_fbdc6eba"
msgid "Qu'est-ce que tu fais la ? Tu voulais te mater un film avec moi ?"
msgstr "Kamu ngapain di situ? Mau nonton film sama aku?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_asami_asami_room_bfdca012"
msgid "Écoute... Je... Je pense que notre amitié va un peu trop loin justement et..."
msgstr "Dengerin... Aku... Aku rasa persahabatan kita udah kebawa jauh banget dan..."

#. Character:`asami` | Attributes:`upset,blush`
msgctxt "home_asami_asami_room_1b5491b9"
msgid "Écoute ? J'ai la forte impression que je ne vais pas du tout aimer ce que je vais entendre."
msgstr "Dengerin? Aku punya firasat jelek aku gak bakal suka apa yang bakal kudenger."

#. Character:`saito`
msgctxt "JE_SUIS_D_SOL_MAIS_JE_DOIS_FAI_5C5F56"
msgid "Je suis désolé, mais... Je dois faire le point seul quelques temps pour..."
msgstr "Maaf, tapi... Aku harus menyendiri dulu untuk memikirkan semuanya..."

#. Character:`asami` | Attributes:`angry`
msgctxt "home_asami_asami_room_699750f6"
msgid "Stop ![w] Ne dit plus rien, je ne veux pas l'entendre !"
msgstr "Berhenti![w] Jangan ngomong apa-apa lagi, aku gak mau denger!"

#. Character:`asami`
msgctxt "home_asami_asami_room_1e9c2377"
msgid "Pars !"
msgstr "Pergi!"

#. Character:`saito`
msgctxt "home_asami_asami_room_d6d5effb"
msgid "Mais, je..."
msgstr "Tapi, aku..."

#. Character:`asami`
msgctxt "home_asami_asami_room_0998b887"
msgid "TOUT DE SUITE !"
msgstr "SEKARANG JUGA!"

#. Character:`sayuri` | Attributes:`sad`
msgctxt "home_asami_asami_room_34bfe681"
msgid "Allez, explique-moi un peu ce qui t'a mise dans cet état-là ?"
msgstr "Ayo, ceritain dong apa yang bikin kamu jadi kayak gitu?"

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_asami_room_4e57b26a"
msgid "... **[i]sniff[/i]**"
msgstr "... **[i]sniff[/i]**"

#. Character:`sayuri`
msgctxt "home_asami_asami_room_40719d0e"
msgid "Ma puce... Si tu ne me dis rien, je ne pourrai pas t'aider."
msgstr "Sayang... Kalau kamu nggak cerita, aku nggak bakal bisa bantu."

#. Character:`asami`
msgctxt "home_asami_asami_room_aa41547b"
msgid "Il m'a quittée ! Voilà !"
msgstr "Dia ninggalin aku! Itu dia!"

#. Character:`asami`
msgctxt "home_asami_asami_room_c3c9680a"
msgid "Tout se passait bien entre nous."
msgstr "Semuanya baik-baik aja antara kita."

#. Character:`asami`
msgctxt "home_asami_asami_room_34292516"
msgid "Hier matin, c'était encore le bonheur et le soir..."
msgstr "Kemarin pagi, kita masih bahagia, tapi malemnya..."

#. Character:`sayuri`
msgctxt "home_asami_asami_room_44f01d7b"
msgid "Oh ! Je vois... Ce sont malheureusement des choses qui arrivent."
msgstr "Oh! Aku ngerti... Sayangnya, hal kayak gitu emang suka kejadian."

#. Character:`sayuri` | Attributes:`neutral`
msgctxt "home_asami_asami_room_db66cda3"
msgid "Ce qui explique pourquoi je l'ai vu aussi peiné quand il est parti."
msgstr "Itu yang jelasin kenapa aku liat dia sedih banget pas dia pergi."

#. Character:`sayuri`
msgctxt "home_asami_asami_room_9e54475d"
msgid "Est-ce qu'il t'a au moins donnée une explication ?"
msgstr "Dia nggak ngasih kamu penjelasan sama sekali?"

#. Character:`sayuri` | Attributes:`moved`
msgctxt "home_asami_asami_room_6b4e06c6"
msgid "Les gens ne quittent pas une personne du jour au lendemain comme ça."
msgstr "Orang nggak ninggalin seseorang begitu aja tiba-tiba gitu."

#. Character:`sayuri` | Attributes:`moved`
msgctxt "home_asami_asami_room_781ddc0b"
msgid "Les gens ne mettent pas fin à une amitié comme ça, c'est même plutôt rare, à moins de..."
msgstr "Orang nggak ngakhirin persahabatan kayak gitu, itu malah jarang banget, kecuali kalau..."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "home_asami_asami_room_69ee5d41"
msgid "Quelle était la raison ?"
msgstr "Apa alasannya?"

#. Character:`asami`
msgctxt "home_asami_asami_room_e70245f3"
msgid "... Je... je ne sais pas."
msgstr "... Aku... aku nggak tau."

#. Character:`sayuri` | Attributes:`neutral`
msgctxt "home_asami_asami_room_fc99bce2"
msgid "Comment ça ?"
msgstr "Maksud kamu gimana?"

#. Character:`asami`
msgctxt "home_asami_asami_room_f4ea11dc"
msgid "Je... je savais ce qu'il allait me dire alors... je l'ai mis à la porte avant qu'il ne dise quoi que ce soit."
msgstr "Aku... aku udah tau dia bakal bilang apa jadi... aku suruh dia pergi sebelum dia ngomong apapun."

#. Character:`asami`
msgctxt "home_asami_asami_room_992d111b"
msgid "Mamannnn, j'ai tellement mal au cœur... **[i]sniff[/i]**"
msgstr "Mamaaa, hati aku sakit banget... **[i]sniff[/i]**"

#. Character:`sayuri` | Attributes:`sad`
msgctxt "home_asami_asami_room_099e868e"
msgid "Ma puce, vient là !"
msgstr "Sayang, sini deh!"

#. Character:`sayuri`
msgctxt "home_asami_asami_room_4220d53b"
msgid "Tu sais... Tu risques de te morfondre pendant longtemps si tu restes sans savoir."
msgstr "Kamu tau nggak... Kamu bisa sedih berlarut-larut kalau kamu terus galau tanpa tau apa-apa."

#. Character:`sayuri`
msgctxt "home_asami_asami_room_17bd08db"
msgid "Tu dois lui laisser l'opportunité de t'expliquer ce qu'il s'est passé."
msgstr "Kamu harus kasih dia kesempatan buat jelasin apa yang sebenernya terjadi."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "home_asami_asami_room_5f5a9612"
msgid "Et après, seulement après, tu pourras décider de ce que tu pourras faire."
msgstr "Terus, baru setelah itu, kamu bisa mutusin mau ngapain."

#. Character:`sayuri`
msgctxt "home_asami_asami_room_ef315b0b"
msgid "Rester sans savoir serait pour moi la pire des choses..."
msgstr "Buat aku, gak tau apa-apa itu hal terburuk..."

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_asami_room_2a6fea30"
msgid "..."
msgstr "..."

#. Character:`sayuri`
msgctxt "home_asami_asami_room_8354a82d"
msgid "Je peux t'accompagner. Discrètement, bien entendu."
msgstr "Aku bisa nemenin kamu. Diam-diam, tentu aja."

#. Character:`asami`
msgctxt "home_asami_asami_room_5bfed1ee"
msgid "Je... tu as raison... **[i]sniff[/i]**"
msgstr "Aku... kamu bener... **[i]sniff[/i]**"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_asami_room_4a6589db"
msgid "J'ai le droit à des explications et je les aurai."
msgstr "Aku punya hak buat dapet penjelasan dan aku bakal dapetin itu."

#. Character:`asami`
msgctxt "home_asami_asami_room_444ad035"
msgid "Et, si c'est à cause d'une autre fille..."
msgstr "Dan, kalo ini gara-gara cewek lain..."

#. Character:`asami`
msgctxt "home_asami_asami_room_56748238"
msgid "Ses oreilles vont chauffer !"
msgstr "Telinganya bakal panas banget!"

#. Character:`sayuri`
msgctxt "home_asami_asami_room_9f73a617"
msgid "Exactement, s'il a fait pleurer ma petite puce sans raison valable, je ne lui pardonnerai pas !"
msgstr "Bener banget, kalo dia bikin bocah kecil aku nangis tanpa alasan jelas, aku gak bakal maafin dia!"

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_asami_room_0f5d3e6a"
msgid "Merci, maman ! **[i]sniff[/i]**"
msgstr "Makasih, Ma! **[i]sniff[/i]**"

#. Character:`sayuri`
msgctxt "home_asami_asami_room_1239c8b6"
msgid "Allez, sèche tes larmes ma puce, nous allons chercher nos réponses nous-même !"
msgstr "Ayolah, keringin air matamu, sayang, kita bakal cari jawaban sendiri!"

#. Character:`noriko`
msgctxt "home_asami_asami_room_1be4764b"
msgid "Pourquoi tu n'as rien dit sur la fille en kimono ?! C'était vraiment louche comme situation."
msgstr "Kenapa kamu nggak bilang apa-apa soal cewek kimono itu?! Situasinya bener-bener aneh."

#. Character:`noriko`
msgctxt "home_asami_asami_room_d4290819"
msgid "De plus, je ne comprends pas pourquoi tu as lâché l'affaire aussi vite avec elle."
msgstr "Selain itu, aku nggak ngerti kenapa kamu cepet banget nyerah sama dia."

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_asami_room_0bb2846c"
msgid "C'est elle..."
msgstr "Itu dia..."

#. Character:`noriko`
msgctxt "home_asami_asami_room_2e59a69e"
msgid "Quoi ?"
msgstr "Apa?"

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_asami_room_163006f9"
msgid "C'est elle qui a dû faire quelque chose à {{saito.n}}."
msgstr "Dia yang pasti ngelakuin sesuatu ke {{saito.n}}."

#. Character:`noriko` | Attributes:`shame`
msgctxt "home_asami_asami_room_b7cee375"
msgid "Mais, comment tu le sais ? Elle n'a rien dit."
msgstr "Tapi, kamu tau darimana? Dia kan nggak ngomong apa-apa."

#. Character:`asami`
msgctxt "home_asami_asami_room_8f1a7083"
msgid "Elle en a dit bien assez... Tu te souviens quand j'ai dit que nous étions à la recherche d'une personne ?"
msgstr "Dia udah bilang cukup banyak... Kamu ingat waktu aku bilang kita lagi nyari seseorang?"

#. Character:`noriko`
msgctxt "home_asami_asami_room_bfffd62c"
msgid "Oui... et donc ?"
msgstr "Iya... terus?"

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_asami_room_007b6fed"
msgid "Je n'ai jamais précisé que c'était un homme ou une femme."
msgstr "Aku nggak pernah bilang itu cowok atau cewek."

#. Character:`asami`
msgctxt "home_asami_asami_room_7e9178ef"
msgid "Pourtant, elle m'a bien répondu..."
msgstr "Tapi, dia jawab aku dengan jelas..."

#. Character:`noriko`
msgctxt "home_asami_asami_room_347db39a"
msgid "\"Il\" n'est pas ici..."
msgstr "\"Dia\" nggak ada di sini..."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_asami_room_0eef4f76"
msgid "Exactement !"
msgstr "Bener banget!"

#. Character:`noriko` | Attributes:`bad`
msgctxt "home_asami_asami_room_44293725"
msgid "Ah la salope, je savais bien qu'elle était suspecte !"
msgstr "Ah, jalang itu, aku emang curiga sama dia!"

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_asami_room_c32756c6"
msgid "Maintenant, quand je repense à l'homme qui s'est enfui quand nous avons mentionné cette fille, ça me fait penser qu'elle est dangereuse."
msgstr "Sekarang, kalo aku inget cowok yang kabur waktu kita nyebutin cewek itu, aku mikir dia itu bahaya."

#. Character:`noriko`
msgctxt "home_asami_asami_room_e068a087"
msgid "On n'a qu'à y aller à plusieurs en force, ou on appelle la police tout simplement !"
msgstr "Mending kita dateng rame-rame, atau panggil polisi aja!"

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_asami_room_fccb8b59"
msgid "Et si, en voyant la police arriver, elle décidait de lui faire du mal ?"
msgstr "Tapi kalo pas polisi datang, dia malah nyakitin dia gimana?"

#. Character:`noriko` | Attributes:`shame`
msgctxt "home_asami_asami_room_898b1990"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "home_asami_asami_room_4e0e0969"
msgid "Tu... tu penses qu'elle le..."
msgstr "Lu... kamu pikir dia bakal..."

#. Character:`asami` | Attributes:`angry`
msgctxt "home_asami_asami_room_a976f51a"
msgid "NON ![w] Non... Je ne veux même pas envisager cette possibilité."
msgstr "GAK! [w] Gak... Aku bahkan gak mau bayangin kemungkinan itu."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_asami_room_cf857fa1"
msgid "Je suis sûre qu'il va bien."
msgstr "Aku yakin dia baik-baik aja."

#. Character:`asami`
msgctxt "home_asami_asami_room_5069d51b"
msgid "On va pas simplement s'introduire dans sa chambre comme ça... On doit juste réfléchir à un plan..."
msgstr "Kita gak bisa sembarangan masuk kamar dia gitu aja... Kita harus mikir rencana dulu..."

#. Character:`noriko` | Attributes:`shame`
msgctxt "home_asami_asami_room_e6ceb20b"
msgid "Oui, je me doute bien."
msgstr "Iya, aku juga mikir gitu."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_asami_room_967a95cb"
msgid "Qui serait assez idiot pour faire ça ?"
msgstr "Siapa yang cukup bodoh buat ngelakuin itu?"

#. Character:`noriko` | Attributes:`happy`
msgctxt "home_asami_asami_room_82c30439"
msgid "C'est clair !"
msgstr "Bener banget!"

#. Character:`asami`
msgctxt "home_asami_livingroom_bd6263be"
msgid "Pff, j'ai passé une nuit horrible."
msgstr "Pff, aku ngalamin malem yang parah banget."

#. Character:`asami`
msgctxt "home_asami_livingroom_239aef49"
msgid "Je n'ai pas arrêté de faire des cauchemars..."
msgstr "Aku nggak berhenti mimpi buruk terus..."

#. Character:`noriko` | Attributes:`afraid`
msgctxt "home_asami_livingroom_9319ce46"
msgid "La fille en kimono ?"
msgstr "Cewek yang pake kimono?"

#. Character:`asami`
msgctxt "home_asami_livingroom_9ed96646"
msgid "Oui... Je la voyais qui me pourchassait, brûlant tout ce à quoi je tenais..."
msgstr "Iya... Aku liat dia ngejar aku, ngebakar semua yang aku sayang..."

#. Character:`asami`
msgctxt "home_asami_livingroom_ac48cbde"
msgid "Il n'y a rien qui pouvait l'arrêter."
msgstr "Nggak ada yang bisa ngebuat dia berhenti."

#. Character:`noriko`
msgctxt "home_asami_livingroom_8197319f"
msgid "J'avais aussi l'impression qu'elle était venue nous observer à la fenêtre."
msgstr "Aku juga ngerasa dia dateng buat ngintip kita dari jendela."

#. Character:`noriko` | Attributes:`shame`
msgctxt "home_asami_livingroom_4de30304"
msgid "Cette fille est trop flippante !"
msgstr "Cewek itu serem banget!"

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_livingroom_343ccd6d"
msgid "On doit sortir {{saito.n}} de là !"
msgstr "Kita harus ngeluarin {{saito.n}} dari situ!"

#. Character:`asami`
msgctxt "home_asami_livingroom_bd382ff5"
msgid "On sait qu'elle nous empêchera d'entrer dans ce restaurant, mais avec une diversion."
msgstr "Kita tau dia bakal ngelawan kita buat masuk ke restoran itu, tapi pake pengalihan."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_asami_livingroom_e8a67789"
msgid "Elle ne pourra pas nous retenir toutes les deux à la fois."
msgstr "Dia nggak bakal bisa nahan kita berdua sekaligus."

#. Character:`noriko`
msgctxt "home_asami_livingroom_8687512d"
msgid "Une de nous doit l'occuper, tandis que l'autre ira jeter un coup d'œil dans sa chambre discrètement."
msgstr "Salah satu dari kita harus ngelakuin pengalihan, sementara yang lain diam-diam ngeintip ke kamarnya."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_livingroom_85f11fac"
msgid "Ça me parait être un bon plan..."
msgstr "Kedengarannya itu rencana yang oke..."

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_livingroom_63157619"
msgid "Il reste certains petits détails à régler encore."
msgstr "Masih ada beberapa detail kecil yang harus diurus."

#. Character:`asami`
msgctxt "home_asami_asami_room_c356cad9"
msgid "Je vois..."
msgstr "Aku ngerti..."

#. Character:`asami`
msgctxt "home_asami_asami_room_346597e6"
msgid "Quelque chose a donc dû se passer à ce moment-là."
msgstr "Jadi pasti ada sesuatu yang terjadi waktu itu."

#. Character:`asami`
msgctxt "home_asami_asami_room_93f1d0c2"
msgid "Mais ça veut pas forcément dire que tu es responsable."
msgstr "Tapi itu nggak berarti kamu yang salah."

#. Character:`asami`
msgctxt "home_asami_asami_room_a39a18bf"
msgid "Il a dû se passer quelque chose... D'accord. Mais est-ce que tu es fautif pour autant ?"
msgstr "Pasti ada sesuatu yang kejadian... Oke. Tapi apa kamu benar-benar bersalah?"

#. Character:`asami`
msgctxt "home_asami_asami_room_e84df6c9"
msgid "On n'en sait rien !"
msgstr "Kita nggak tahu!"

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_asami_room_c66600a8"
msgid "Et surtout... le fait que tu aies oublié tout ça prouve que toi aussi tu as vécu une mauvaise expérience."
msgstr "Dan yang paling penting... fakta bahwa kamu lupa semua itu nunjukin kalau kamu juga ngalamin pengalaman buruk."

#. Character:`kimochi`
msgctxt "home_asami_asami_room_02896704"
msgid "Exactement !"
msgstr "Bener banget!"

#. Character:`kimochi`
msgctxt "home_asami_asami_room_f57d118d"
msgid "C'est un mécanisme de protection du cerveau."
msgstr "Itu mekanisme perlindungan otak."

#. Character:`kimochi`
msgctxt "home_asami_asami_room_8a5e0d41"
msgid "Quand on vit un évènement traumatisant, le cerveau nous le fait oublier, surtout si c'est un souvenir douloureux !"
msgstr "Kalau kita ngalamin kejadian traumatis, otak kita bakal bikin kita lupa, apalagi kalau itu kenangan yang nyakitin!"

#. Character:`asami` | Attributes:`angry`
msgctxt "home_asami_asami_room_331252ef"
msgid "Qu'est-ce qu'il fait chez moi lui ?"
msgstr "Dia ngapain di rumah aku?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_asami_asami_room_02996aab"
msgid "Je n'en sais rien, je ne l'ai pas invité."
msgstr "Aku gak tau, aku gak pernah ngundang dia."

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_asami_asami_room_7d40780c"
msgid "J'ai entendu toute votre conversation."
msgstr "Aku denger semua obrolan kalian."

#. Character:`kimochi`
msgctxt "home_asami_asami_room_96d7d49e"
msgid "Vous faites ça pour aider {{noriko.n}} et je veux en être !"
msgstr "Kalian ngelakuin ini buat bantuin {{noriko.n}} dan aku pengen ikutan!"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_asami_asami_room_34d661de"
msgid "Oui m-"
msgstr "Iya m-"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_asami_asami_room_c9dd0846"
msgid "{{saito.n}} ne dis plus rien, je t'ai souvent aidé maintenant c'est mon tour."
msgstr "{{saito.n}} jangan ngomong lagi, aku sering bantuin kamu sekarang giliran aku."

#. Character:`kimochi`
msgctxt "home_asami_asami_room_e7793bd5"
msgid "Je veux en être !"
msgstr "Aku pengen ikutan!"

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_asami_asami_room_567db389"
msgid "Si tu veux mais tu te fais des idées si tu penses que {{noriko.n}} te..."
msgstr "Kalau kamu mau, tapi kamu salah kalau pikir {{noriko.n}} bakal..."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_asami_asami_room_25cc286d"
msgid "Elle est folle de moi et je le prouverai !"
msgstr "Dia gilain aku dan aku bakal buktiin!"

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_asami_room_bdaef415"
msgid "J'en connais un qui va tomber de haut..."
msgstr "Ada yang bakal kaget banget nih..."

#. Character:`kimochi`
msgctxt "home_asami_asami_room_63a0ce90"
msgid "J'ai l'habitude de ne pas être pris au sérieux. Vous verrez bien qui aura raison à la fin."
msgstr "Aku biasa nggak dianggap serius. Nanti kalian bakal liat siapa yang bener di akhir."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_asami_asami_room_071390b5"
msgid "Vous cherchez des réponses dans le passé mais vous n'en aurez pas."
msgstr "Kalian nyari jawaban dari masa lalu tapi nggak bakal dapet."

#. Character:`kimochi`
msgctxt "home_asami_asami_room_7433a804"
msgid "Les réponses vous les trouverez seulement dans le présent."
msgstr "Jawaban cuma bakal kalian temuin di saat ini."

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_asami_room_f708c55d"
msgid "Vas-y monsieur l'expert, qu'est-ce que tu proposes ?"
msgstr "Ayo dong pak jagoan, kamu nawarin apa?"

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_asami_asami_room_54fd9c17"
msgid "Je sens comme une petite animosité... Est-ce comme ça qu'on traite un ami ?"
msgstr "Aku ngerasa ada benci-bencinya dikit... Emang gitu cara kamu ngadepin temen?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_asami_asami_room_de14923e"
msgid "Bref...[w] Que fait-elle de ses journées ? A-t-elle une passion ? Des amies qu'elle retrouve en ville ?"
msgstr "Pokoknya...[w] Dia ngapain aja sehari-hari? Punya hobi nggak? Temen-temen yang dia ketemu di kota?"

#. Character:`kimochi`
msgctxt "home_asami_asami_room_83c3ee2f"
msgid "A-t-elle peur de quelque chose en particulier ? Quelle est sa couleur préférée ? A-t-elle un ou une petite amie ?"
msgstr "Dia takut sama sesuatu khusus nggak? Warna favoritnya apa? Punya pacar cowok atau cewek nggak?"

#. Character:`kimochi`
msgctxt "home_asami_asami_room_b739d42b"
msgid "Plus tu as d'informations sur elle, plus on pourra dresser un portrait précis de sa personnalité, de sa façon de penser."
msgstr "Makin banyak info soal dia, makin jelas kita bisa gambarin kepribadiannya, cara pikirnya."

#. Character:`kimochi`
msgctxt "home_asami_asami_room_5e1cc29e"
msgid "Alors ?"
msgstr "Jadi gimana?"

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_asami_room_1be57732"
msgid "C'est cohérent... Alors {{saito.n}} ?"
msgstr "Masuk akal... Jadi {{saito.n}}?"

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_asami_asami_room_9fce4963"
msgid "...[w] Tout ce que tu sais de {{noriko.n}} c'est qu'elle regarde du porno ?"
msgstr "...[w] Semua yang kamu tau soal {{noriko.n}} cuma dia nonton porno doang?"

#. Character:`narrator`
msgctxt "t492e707036"
msgid "Je... Elle regarde du porno."
msgstr "Aku... Dia nonton porno."

#. Character:`narrator`
msgctxt "t7f13f54e25"
msgid "Je suppose qu'elle passe son temps sur internet..."
msgstr "Kayaknya dia lebih sering habisin waktu di internet..."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_asami_asami_room_2519e44f"
msgid "Tu te fiches de moi ?"
msgstr "Kamu ngelawak apa gimana?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_asami_asami_room_00d0bed0"
msgid "Non... je ne me fiche pas de toi. Cela fait des années qu'elle m'évite, me harcèle et j'en passe."
msgstr "Gak... aku gak cuek sama kamu. Udah bertahun-tahun dia ngindarin aku, ganggu aku, dan masih banyak lagi."

#. Character:`saito`
msgctxt "home_asami_asami_room_1f6a629d"
msgid "Rares sont les moments où j'ai eu une conversation normale avec elle."
msgstr "Jarang banget aku sempet ngobrol normal sama dia."

#. Character:`saito`
msgctxt "home_asami_asami_room_98481c39"
msgid "Je pense simplement qu'elle me déteste."
msgstr "Aku cuma mikir dia benci sama aku."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_asami_asami_room_7120aa32"
msgid "On ne déteste pas quelqu'un sans raison {{saito.n}}."
msgstr "Gak bakal benci orang tanpa alasan, {{saito.n}}."

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_asami_room_80c098d0"
msgid "Il a raison, quand tu as disparu à cause de {{sakuya.n}}, {{noriko.n}} a semblé vraiment inquiète."
msgstr "Dia bener, waktu kamu hilang gara-gara {{sakuya.n}}, {{noriko.n}} keliatan bener-bener khawatir."

#. Character:`asami`
msgctxt "home_asami_asami_room_53b2c94b"
msgid "Elle m'a beaucoup aidée."
msgstr "Dia udah banyak bantuin aku."

#. Character:`saito`
msgctxt "home_asami_asami_room_909130c6"
msgid "Je... je ne savais pas."
msgstr "Aku... aku gak tau."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_asami_asami_room_393657d9"
msgid "Tu vois ? Les choses ne sont pas aussi manichéennes, il semblerait bien qu'elle tienne un tant soit peu à toi mais pour une raison qui nous est inconnue..."
msgstr "Kamu liat gak? Semua nggak sesederhana itu, kayaknya dia peduli dikit sama kamu tapi entah kenapa kita nggak tau alasannya..."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_asami_asami_room_f1914ee0"
msgid "Elle ne peut pas te le montrer directement."
msgstr "Dia nggak bisa nunjukin itu langsung ke kamu."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_asami_room_09874022"
msgid "Finalement... tu n'as pas l'air si mauvais que ça."
msgstr "Akhirnya... kamu nggak keliatan seburuk itu juga."

#. Character:`kimochi`
msgctxt "home_asami_asami_room_0e48caf3"
msgid "{{saito.n}} tu dois suivre {{noriko.n}} jour et nuit, nous devons tout savoir d'elle, je t'apprendrai à stalker comme un pro."
msgstr "{{saito.n}} kamu harus ngikutin {{noriko.n}} siang malam, kita harus tau semuanya tentang dia, aku bakal ajarin kamu stalking kayak pro."

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_asami_room_c3789aff"
msgid "Oublie ce que je viens de dire."
msgstr "Lupain apa yang baru aja aku bilang."

#. Character:`asami`
msgctxt "home_asami_asami_room_0a0c785e"
msgid "{{saito.n}} n'écoute pas cet idiot, tout ce que tu risques c'est de finir en prison."
msgstr "{{saito.n}} jangan dengerin si bodoh itu, yang kamu resikoin cuman masuk penjara."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_asami_asami_room_23e2a435"
msgid "Il n'y a pas d'autres solutions, elle ne lui dira rien, ni à lui ou même à toi."
msgstr "Gak ada cara lain, dia nggak bakal bilang apa-apa ke dia, bahkan ke kamu sekalipun."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_asami_room_b688970b"
msgid "Mais quand même... C'est un peu..."
msgstr "Tapi tetep aja... Ini agak..."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_asami_asami_room_935bccad"
msgid "{{kimochi.n}} a raison, {{noriko.n}} semble garder quelque chose pour elle depuis trop longtemps."
msgstr "{{kimochi.n}} bener, {{noriko.n}} kayaknya nyimpen sesuatu buat dia terlalu lama."

#. Character:`saito`
msgctxt "home_asami_asami_room_62ff1840"
msgid "Si ça peut m'aider à me réconcilier définitivement avec elle, je dois le tenter."
msgstr "Kalau ini bisa bantu aku damai beneran sama dia, aku harus coba."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_asami_asami_room_9dc8c52d"
msgid "Exactement !"
msgstr "Bener banget!"

#. Character:`kimochi`
msgctxt "home_asami_asami_room_29174d83"
msgid "Enfin une petite aventure entre hommes !"
msgstr "Akhirnya petualangan kecil antar cowok!"

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_asami_room_ce34becf"
msgid "Hors de question ! Je viens avec vous, hors de question de te voir corrompre mon {{saito.n}} !"
msgstr "Gak mungkin! Aku ikut kalian, gak mau liat kamu ngerusak {{saito.n}} aku!"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_asami_asami_room_7dc6b5c7"
msgid "{{saito.n}} dis quelque chose !"
msgstr "{{saito.n}} ngomong dong!"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_asami_room_6e385087"
msgid "J'en dis que c'est une très bonne idée."
msgstr "Aku bilang itu ide yang keren banget."

#. Character:`asami`
msgctxt "home_asami_asami_room_b9d68f22"
msgid "Parfait ! On commence par quoi grand maître stalker ?"
msgstr "Sip! Mulai dari mana nih, master stalker?"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_asami_asami_room_c7ef26d8"
msgid "Tchhh..."
msgstr "Tchhh..."

#. Character:`kimochi`
msgctxt "home_asami_asami_room_a49c597e"
msgid "On campe devant chez toi et on attend qu'elle bouge."
msgstr "Kita ngecamp depan rumah kamu dan nunggu dia gerak."

#. Character:`asami`
msgctxt "home_asami_asami_room_e938a59f"
msgid "Pfff je n'arrive pas à trouver le sommeil."
msgstr "Duh, aku gak bisa tidur nih."

#. Character:`asami` | Attributes:`pouting`
msgctxt "tc89ed41127"
msgid "Je me demande ce que fais {{saito.n}}... Ça aurait été sympa de passer la soirée ensemble."
msgstr "Aku penasaran {{saito.n}} ngapain... Asik juga kalo kita habisin malem bareng."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_asami_room_cdaa8c85"
msgid "Est-ce que j'en profiterais pas pour aller me glisser dans le lit de mon petit poney ?"
msgstr "Apa aku gak sekalian nyelinap ke kasur poni kecil aku ya?"

#. Character:`asami` | Attributes:`surprised`
msgctxt "home_asami_asami_room_db729cbb"
msgid "Oh ! Ça doit être lui !"
msgstr "Oh! Pasti dia nih!"

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_asami_room_c8b37d8c"
msgid "J'espère que la situation avec {{noriko.n}} s'est enfin arrangée !"
msgstr "Semoga situasi sama {{noriko.n}} akhirnya udah beres ya!"

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_asami_room_56f008bd"
msgid "J'ARRIVE !"
msgstr "AKU DATENG!"

#. Character:`sayuri` | Attributes:`happy`
msgctxt "tccb49eb2f3"
msgid "Ma puce tu es l-"
msgstr "Sayang, kamu itu-"

#. Character:`sayuri` | Attributes:`neutral`
msgctxt "t0503cc3099"
msgid "...[w]Visiblement non."
msgstr "...[w]Ternyata enggak."

#. Character:`sayuri`
msgctxt "t2e0d710aad"
msgid "Elle du passer la nuit chez {{saito.n}}..."
msgstr "Kayaknya dia nginep di rumah {{saito.n}}..."

#. Character:`sayuri` | Attributes:`surprised`
msgctxt "t3162f4c42d"
msgid "Est-ce qu'elle aurait enfin sautée le pas ?"
msgstr "Apa dia akhirnya nekat juga ya?"

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "tc20b2cc87b"
msgid "Ils n'arrêtent jamais tous deux !"
msgstr "Mereka berdua nggak pernah berhenti!"

#. Character:`sayuri` | Attributes:`moved`
msgctxt "tb46d8c401d"
msgid "Ah c'est beau la jeunesse !"
msgstr "Ah, enak banget jadi muda!"

#. Character:`sayuri` | Attributes:`sad`
msgctxt "t6b2b1e6806"
msgid "Mais ça ne change rien, elle aurait au moins pu m'envoyer un message."
msgstr "Tapi tetep aja, dia setidaknya bisa ngirimin aku pesan."

#. Character:`sayuri`
msgctxt "t895b00d3d4"
msgid "Pfff..."
msgstr "Pfff..."

#. Character:`noriko`
msgctxt "home_nobu_exterior_b1f98bf3"
msgid "Nous y voilà !"
msgstr "Akhirnya sampai juga!"

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_nobu_exterior_2cc40ea1"
msgid "Il nous aura fait poireauter toute la journée mais cette fois-ci c'est bon !"
msgstr "Dia bikin kita nungguin seharian, tapi kali ini udah oke!"

#. Character:`noriko`
msgctxt "home_nobu_exterior_0758151b"
msgid "Va remettre ce connard à sa place et fais le bien regretter."
msgstr "Bikin si bangsat itu balik ke tempatnya dan bikin dia nyesel abis."

#. Character:`noriko`
msgctxt "home_nobu_exterior_ea0f30bc"
msgid "Ne t'arrête pas même s'il se met à pleurer !"
msgstr "Jangan berhenti walau dia sampe nangis sekalipun!"

#. Character:`noriko`
msgctxt "home_nobu_exterior_82db5108"
msgid "Pense à tout ce qu'il t'a fait !"
msgstr "Inget semua yang udah dia lakuin ke kamu!"

#. Character:`saito` | Attributes:`angry`
msgctxt "home_nobu_exterior_c2356fa4"
msgid "Tu n'as pas besoin de me le vendre davantage."
msgstr "Aku nggak perlu kamu jelasin lagi."

#. Character:`saito`
msgctxt "home_nobu_exterior_17a006b5"
msgid "J'ai une vie entière de regrets à évacuer."
msgstr "Aku punya seumur hidup penuh penyesalan buat dikeluarin."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_nobu_exterior_0310003f"
msgid "Comment ça une vie ?"
msgstr "Gimana maksud kamu seumur hidup?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_nobu_exterior_810212b6"
msgid "Euh.. Je veux dire toute mon adolescence."
msgstr "Euh.. maksud aku selama masa remaja aku."

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_nobu_exterior_867ed625"
msgid "On s'en fout, fonce ! Il va rentrer chez lui sinon !"
msgstr "Gak usah mikir, gas aja! Kalo enggak dia bakal pulang!"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_4741be4b"
msgid "C'est moi ! Ouvre la porte connasse !"
msgstr "Ini aku! Buka pintunya, brengsek!"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_51e7174e"
msgid "Non ! C'est pas une façon de parler à sa grande soeur !"
msgstr "Gak! Gitu bukan cara ngomong ke kakak cewek kamu!"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_a3f7cb25"
msgid "Tant que tu ne seras pas plus poli tu resteras dehors."
msgstr "Selama kamu gak lebih sopan, kamu bakal tetap di luar."

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_532012eb"
msgid "Mais putain tu fais chier !"
msgstr "Bangsat, kamu ngeselin banget!"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_6e3827a6"
msgid "Grouille toi j'ai vraiment passé une grosse journée, je suis claqué."
msgstr "Cepetan, aku beneran capek banget hari ini, aku capek parah."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_e0630f15"
msgid "Menteur."
msgstr "Pembohong."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_b971ea1b"
msgid "Je suis sûre que tu as encore passé la plupart de ton temps à traîner avec les deux autres branleurs."
msgstr "Aku yakin kamu masih ngabisin sebagian besar waktu kamu nongkrong sama dua bocah bodoh itu."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_b23ab5dd"
msgid "Et tu as sûrement fini ta journée a l'arcade center..."
msgstr "Dan pasti kamu nutup hari kamu di arcade center..."

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_70e89da9"
msgid "[font_size=14]...Putain tu fais chié.[/font_size]"
msgstr "[font_size=14]...Bangsat, kamu ngeselin banget.[/font_size]"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_85396649"
msgid "Je le savais !"
msgstr "Aku udah tau!"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_a4481e29"
msgid "PUTAIN OUVRE GROSSE CONNE !"
msgstr "BANGSAT BUKA, ANJING BODOH!"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_6fd004e4"
msgid "Je fais ce que je veux, c'est mon pognon !"
msgstr "Aku ngelakuin apa aja aku mau, itu duit aku!"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_d283bc5b"
msgid "...Tu travailles pas, d'ou viendrais cet argent alors ?"
msgstr "...Kamu gak kerja, terus duit itu dari mana dong?"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_f74a28d6"
msgid "..Je... l'ai trouvé."
msgstr "..Aku... nemu."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_ccfa2413"
msgid "C'est la pire excuse que j'ai jamais entendue."
msgstr "Itu alasan paling gila yang pernah aku denger."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_3a2c2077"
msgid "Je suis certaine que tu l'as volé."
msgstr "Aku yakin kamu maling."

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_4f8c7135"
msgid "Pfff et alors ? Qu'est ce que tu va faire ?"
msgstr "Pfff terus? Mau ngapain?"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_a5595a7a"
msgid "T'en profites bien quand je ramène à manger."
msgstr "Kamu enak aja pas aku bawa makan."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_f1b9df69"
msgid "Tu vas t'attirer encore plus de problèmes."
msgstr "Kamu bakal makin banyak masalah."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_0f1ab9c6"
msgid "...Tu es vraiment le pire des frères !"
msgstr "...Kamu emang saudara paling bodoh!"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_20b00240"
msgid "Ouais ouais c'est ça allez ouvre la porte !"
msgstr "Iya iya, ya udah buka pintunya!"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_8754c855"
msgid "Un jour tu tomberas sur quelqu'un que tu n'auras jamais dû emmerder."
msgstr "Suatu saat kamu bakal ketemu orang yang gak boleh kamu ganggu."

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_bbc51ada"
msgid "[font_size=14]Hey qu'est ce que...[/font_size]"
msgstr "[font_size=14]Hei, apa sih...[/font_size]"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_4b225ce5"
msgid "Et tu peux être sur qu'il te fera bouffer ta putain d'assurance."
msgstr "Dan kamu bisa yakin dia bakal bikin kamu makan asuransi gilaan kamu itu."

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_3ed8832c"
msgid "[font_size=14]Aie stop ![/font_size]"
msgstr "[font_size=14]Aduh, berhenti![/font_size]"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_b1b98cff"
msgid "[font_size=14]Aaah ![/font_size]"
msgstr "[font_size=14]Aaah![/font_size]"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_06b650bd"
msgid "Ce jour là ne compte pas sur moi pour t'aider."
msgstr "Hari itu jangan harap aku bakal nolong kamu."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_d50a58c7"
msgid "Ce sera un juste retour de karma."
msgstr "Itu bakal jadi karma yang pas buat kamu."

#. Character:`notice`
msgctxt "t7de386b02c"
msgid "Vous avez récupéré l'argent de {{sayuri.n}}."
msgstr "Kamu udah dapet duit dari {{sayuri.n}}."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_386b7e7b"
msgid "Tu m'écoutes ?"
msgstr "Kamu dengerin aku gak?"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_00793742"
msgid "{{nobu.n}} ?"
msgstr "{{nobu.n}} ?"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_2ccc1168"
msgid "Mais... Qu'est ce que tu fous allongé par terre ?"
msgstr "Tapi... kenapa kamu tidur-tiduran di lantai gitu?"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_6cf844e7"
msgid "Je... J'ai glissé."
msgstr "Aku... aku keselip."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_0b382599"
msgid "..."
msgstr "..."

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_719cde8d"
msgid "Tu me fais vraiment de la peine... Tu va faire quoi le jour ou je ne serais plus là ?"
msgstr "Aku bener-bener kasian sama kamu... Kamu bakal ngapain pas aku udah nggak ada?"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_d62d54f0"
msgid "Y'a bien un jour ou je me trouverais un mec et je partirais."
msgstr "Pasti suatu saat aku bakal nemuin cowok dan cabut dari sini."

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_b41dbe4e"
msgid "Pfff faudrait déjà qu'un mec arrive a te supporter !"
msgstr "Pfff, harusnya dulu ada cowok yang sanggup nerima kamu!"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_5f367bb1"
msgid "Va te faire foutre enfoiré !"
msgstr "Pergi saja, dasar bajingan!"

#. Character:`unknown`
msgctxt "event_nobu_fight_at_home_e8b17a2b"
msgid "Vu ta gueule, je suppose que c'était mérité !"
msgstr "Liat muka kamu, aku rasa itu pantas banget!"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_216888cb"
msgid "...[font_size=14]Fait chié...[/font_size]"
msgstr "...[font_size=14]Bete banget...[/font_size]"

#. Character:`nobu`
msgctxt "event_nobu_fight_at_home_e083e6b5"
msgid "[font_size=14]Il m'a même volé mon fric cet enfoiré ![/font_size]"
msgstr "[font_size=14]Bangsat itu bahkan nyolong duit aku![/font_size]"

#. Character:`noriko`
msgctxt "home_nobu_exterior_8130e2d5"
msgid "Haha... On l'a entendu couiner jusqu'ici !"
msgstr "Haha... Suaranya kedengeran sampe sini nih!"

#. Character:`noriko`
msgctxt "home_nobu_exterior_491e1e0e"
msgid "C'était plaisant à voir."
msgstr "Asik juga ya ngeliatnya."

#. Character:`noriko`
msgctxt "home_nobu_exterior_c94927cb"
msgid "Tu te sens comment à présent ?"
msgstr "Sekarang kamu ngerasa gimana?"

#. Character:`saito`
msgctxt "home_nobu_exterior_36358795"
msgid "Je... Je ne sais pas trop, j'ai un peu mal aux phalanges mais..."
msgstr "Aku... Aku gak yakin, jari-jariku agak sakit tapi..."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_nobu_exterior_d621b759"
msgid "Je me sens... bien !"
msgstr "Aku ngerasa... enak!"

#. Character:`saito`
msgctxt "home_nobu_exterior_d4d8dcc7"
msgid "C'est agréable comme sensation."
msgstr "Rasanya enak banget."

#. Character:`saito`
msgctxt "home_nobu_exterior_03775ec8"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "home_nobu_exterior_db29a4c4"
msgid "J'ai l'impression qu'un poids énorme a été retiré de mes épaules."
msgstr "Aku merasa kayak beban berat udah diangkat dari pundakku."

#. Character:`narrator`
msgctxt "home_nobu_exterior_35efdef7"
msgid "Si j'avais su que se lâcher faisait autant de bien..."
msgstr "Kalau aku tahu melepaskan diri bakal selega ini..."

#. Character:`narrator`
msgctxt "home_nobu_exterior_c40c1b24"
msgid "Je l'aurais fait plus tôt dans ma vie antérieure."
msgstr "Mungkin aku bakal ngelakuin itu lebih awal di hidupku sebelumnya."

#. Character:`narrator`
msgctxt "home_nobu_exterior_4c232cfd"
msgid "Ca m'aurait évité bien des problèmes."
msgstr "Itu bakal ngindarin aku dari banyak masalah."

#. Character:`narrator`
msgctxt "home_nobu_exterior_4effff8d"
msgid "Il est trop tard pour pour avoir des regrets de toute façon..."
msgstr "Tapi udah telat buat nyesel deh..."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_nobu_exterior_44784a8a"
msgid "{{saito.n}} !"
msgstr "{{saito.n}} !"

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_nobu_exterior_aa965593"
msgid "mhh.. Quoi ?"
msgstr "mhh.. Apa?"

#. Character:`noriko`
msgctxt "home_nobu_exterior_f2f590a5"
msgid "Arrête de rêvasser, on rentre !"
msgstr "Udah stop ngelamun, kita pulang!"

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_nobu_exterior_bbe8055f"
msgid "Tu as raison, ne traînons pas."
msgstr "Kamu bener, jangan lama-lama."

#. Character:`saito`
msgctxt "INSTALLONS_QUELQUES_AFFICHES_I_950C8D"
msgid "Installons quelques affiches ici."
msgstr "Pasang beberapa poster di sini."

#. Character:`saito`
msgctxt "BON_A_DEVRAIT_SUFFIRE_POUR_ICI_30534A"
msgid "Bon, ça devrait suffire pour ici, allons voir du côté du konbini."
msgstr "Oke, seharusnya cukup di sini, ayo kita cek di konbini."

#. Character:`nobu`
msgctxt "PUTAIN_MAIS_T_ES_S_RIEUX_9AED1C"
msgid "... Putain, mais t'es sérieux ?"
msgstr "... Sialan, seriusan kamu?"

#. Character:`nobu`
msgctxt "QU_EST_CE_QUE_TU_AS_ME_SUIVRE_5D1F78"
msgid "Qu'est-ce que tu as à me suivre comme ça partout, t'es gay ?"
msgstr "Kenapa sih kamu ngikutin aku terus gini, kamu gay ya?"

#. Character:`saito`
msgctxt "JE_PENSE_QUE_J_AI_T_ASSEZ_PATI_44AFE6"
msgid "Je pense que j'ai été assez patient jusqu'ici, mais visiblement, tu n'as pas envie de répondre à mes questions."
msgstr "Aku rasa aku udah cukup sabar sampai sekarang, tapi jelas kamu nggak mau jawab pertanyaan aku."

#. Character:`saito`
msgctxt "J_EN_AI_PLUS_QU_ASSEZ_DE_JOUER_78B461"
msgid "J'en ai plus qu'assez de jouer au gentil garçon à présent."
msgstr "Aku sudah benar-benar muak berpura-pura menjadi anak baik sekarang."

#. Character:`nobu`
msgctxt "HEY_QU_EST_CE_QUE_2BCB2A"
msgid "Hey, qu'est-ce que..."
msgstr "Hei, apaan sih..."

#. Character:`saito`
msgctxt "TU_VAS_ME_DIRE_TOUT_CE_QUE_TU_8FD6FC"
msgid "Tu vas me dire tout ce que tu sais ou..."
msgstr "Kamu bakal bilang semua yang kamu tahu atau gimana..."

#. Character:`nobu`
msgctxt "VA_TE_FAIRE_FOUTRE_A083B8"
msgid "Va te faire foutre !"
msgstr "Mampus kamu!"

#. Character:`saito`
msgctxt "COMME_TU_VOUDRAS_3C008E"
msgid "Comme tu voudras..."
msgstr "Terserah kamu deh..."

#. Character:`saito`
msgctxt "TOUJOURS_PAS_ENVIE_DE_PARLER_FDEC43"
msgid "Toujours pas envie de parler ?"
msgstr "Masih nggak mau ngomong juga?"

#. Character:`nobu`
msgctxt "N_4159A2"
msgid "... N-"
msgstr "... N-"

#. Character:`saito`
msgctxt "PARFAIT_J_AVAIS_PAS_ENVIE_DE_M_D1422E"
msgid "Parfait, j'avais pas envie de m'arrêter non plus !"
msgstr "Sempurna, aku juga nggak pengen berhenti kok!"

#. Character:`nobu`
msgctxt "NON_ATTENDS_J_EDEF02"
msgid "Non ! Attends, j-"
msgstr "Nggak! Tunggu, aku-"

#. Character:`nobu`
msgctxt "STOP_PITI_C_EST_BON_037AED"
msgid "Stop ! Pitié... c'est bon."
msgstr "Berhenti! Tolong... udah cukup."

#. Character:`saito`
msgctxt "QU_EST_CE_QUE_TU_SAIS_PROPOS_D_07D0CE"
msgid "Qu'est-ce que tu sais à propos de l'enlèvement d'{{asami.n}} ?!"
msgstr "Kamu tau apa soal penculikan {{asami.n}}?!"

#. Character:`nobu`
msgctxt "RIEN_J_TE_JURE_ON_NE_FAIT_PAS_7A9635"
msgid "Rien ! J'te... jure, on ne fait pas des trucs comme ça et..."
msgstr "Nggak tau! Aku... sumpah, kita nggak ngelakuin hal kayak gitu dan..."

#. Character:`saito`
msgctxt "JE_NE_TE_CROIS_PAS_86D1EE"
msgid "Je ne te crois pas !"
msgstr "Aku nggak percaya sama kamu!"

#. Character:`nobu`
msgctxt "C_EST_LA_V_RIT_J_Y_SUIS_POUR_R_4EED9C"
msgid "C'est la vérité ! J'y suis pour rien !"
msgstr "Itu beneran! Aku nggak ada hubungannya sama itu!"

#. Character:`saito`
msgctxt "OKAY_DANS_CE_CAS_O_EST_AKIRA_N_E152EF"
msgid "Okay, dans ce cas... Où est {{akira.n}} ?"
msgstr "Oke, kalo gitu... {{akira.n}} di mana?"

#. Character:`nobu`
msgctxt "JE_C56EA5"
msgid "...Je..."
msgstr "...Aku..."

#. Character:`saito`
msgctxt "O_EST_AKIRA_N_E57440"
msgid "OÙ EST {{akira.N}} ?!!"
msgstr "DI MANA {{akira.N}}?!!"

#. Character:`nobu`
msgctxt "JE_NE_SAIS_PAS_6E4D00"
msgid "JE NE SAIS PAS !!!"
msgstr "AKU GAK TAU!!!"

#. Character:`nobu`
msgctxt "ON_NE_TRA_NE_PAS_AVEC_LUI_CE_T_582F7F"
msgid "On ne traîne pas avec lui, ce type me fout les jetons..."
msgstr "Jangan deket-deket sama dia, cowok itu bikin aku ngeri..."

#. Character:`nobu`
msgctxt "PEUT_TRE_QUE_KENJI_N_OU_TAKEO_9BB72D"
msgid "Peut-être que {{kenji.n}} ou {{takeo.n}} en sauront plus ?!"
msgstr "Mungkin {{kenji.n}} atau {{takeo.n}} tau lebih banyak?!"

#. Character:`nobu`
msgctxt "C_EST_TOUT_CE_QUE_JE_SAIS_JE_T_AE2613"
msgid "C'est tout ce que je sais, je t'assure !"
msgstr "Itu aja yang aku tau, aku jamin!"

#. Character:`nobu`
msgctxt "OUCH_F8F093"
msgid "Ouch !!"
msgstr "Aduh!!"

#. Character:`erika`
msgctxt "C_EST_PAS_UN_PEU_FINI_73B50C"
msgid "C'est pas un peu fini ?!"
msgstr "Udah nggak cukup nih?!"

#. Character:`erika`
msgctxt "T_AS_QUEL_GE_POUR_CRIER_COMME_872F2F"
msgid "T'as quel âge pour crier comme un porc dehors comme ça ?"
msgstr "Kamu umur berapa sih sampe teriak kayak babi di luar gitu?"

#. Character:`erika` | Attributes:`surprised`
msgctxt "WOAH_MAIS_QU_EST_CE_QUI_T_EST_4FB50C"
msgid "Woah ! Mais... qu'est-ce qui t'est arrivé ?!"
msgstr "Woah! Tapi... kamu kenapa sih?!"

#. Character:`nobu`
msgctxt "TA_GUEULE_JE_ME_SUIS_BATTU_C_CFF7CD"
msgid "... Ta... gueule... Je me suis battu, c'est tout..."
msgstr "... Tutup mulut kamu... Aku cuma berantem, itu aja..."

#. Character:`erika` | Attributes:`neutral`
msgctxt "VOIR_TA_T_TE_TU_T_ES_PLUT_T_B_E8A516"
msgid "À voir ta tête, tu t'es plutôt bien fait défoncer !"
msgstr "Liat muka kamu, kamu malah keliatan kayak abis dipukulin parah!"

#. Character:`erika`
msgctxt "QU_EST_CE_QUE_TU_AS_ENCORE_FOU_724126"
msgid "Qu'est-ce que tu as encore foutu ?"
msgstr "Kamu ngapain lagi sih?"

#. Character:`nobu` | Attributes:`angry`
msgctxt "RIEN_PUTAIN_POURQUOI_A_SERAIT_F66F3B"
msgid "Rien, putain !!! Pourquoi ça serait ma faute ?"
msgstr "Gak ngapain, bangsat!!! Kenapa harus salahin aku?"

#. Character:`erika` | Attributes:`pouting`
msgctxt "ON_NE_CASSE_PAS_LA_FIGURE_QUEL_652BF4"
msgid "On ne casse pas la figure à quelqu'un sans raison et je te connais trop bien."
msgstr "Aku gak bisa seenaknya ngeluarin pukulan tanpa alasan dan aku kenal kamu banget."

#. Character:`erika`
msgctxt "SI_CE_N_EST_PAS_UN_TRUC_QUE_TU_196BFD"
msgid "Si ce n'est pas un truc que tu as fait, c'est forcément un truc que tu as dit !"
msgstr "Kalo bukan gara-gara kamu ngelakuin sesuatu, pasti kamu ngomong sesuatu!"

#. Character:`erika`
msgctxt "TU_AS_UNE_TROP_GRANDE_GUEULE_E_EC925B"
msgid "Tu as une trop grande gueule et tu ne sais pas quand la fermer !"
msgstr "Mulut kamu kebanyakan omong dan gak tau kapan harus diem!"

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "C_EST_BON_J_AI_COMPRIS_FOUS_M_0E072B"
msgid "... C'est bon, j'ai compris, fous-moi la paix !"
msgstr "... Ya udah, aku ngerti, tinggalin aku sendiri!"

#. Character:`nobu`
msgctxt "QUOI_ENCORE_7292CD"
msgid "Quoi encore ?"
msgstr "Apa lagi sekarang?"

#. Character:`erika`
msgctxt "TU_T_TAIS_PAS_INSCRIT_AU_DOJO_EE2830"
msgid "Tu t'étais pas inscrit au dojo pour pouvoir défoncer tous ceux qui te manquaient de respect ?"
msgstr "Kamu kan daftar di dojo biar bisa ngelundungin semua yang gak hormatin kamu, kan?"

#. Character:`nobu`
msgctxt "MAIS_MERDE_ARR_TE_POURQUOI_TU_0BCC63"
msgid "Mais merde, arrête ! Pourquoi tu retournes le couteau dans la plaie comme ça ?"
msgstr "Sialan, berhenti dong! Kenapa kamu malah ngaduk-aduk luka gitu?"

#. Character:`erika` | Attributes:`sad`
msgctxt "PARCE_QUE_PAPA_ET_MAMAN_NE_SON_8FC1DE"
msgid "Parce que papa et maman ne sont pas là et qu'il ne reste que moi pour m'inquiéter pour toi."
msgstr "Soalnya bokap nyokap gak ada dan cuma aku yang peduli sama kamu."

#. Character:`nobu`
msgctxt "FICHE_MOI_LA_PAIX_JE_NE_T_AI_795D8E"
msgid "... Fiche-moi la paix, je ne t'ai rien demandé !"
msgstr "... Tinggalin aku, aku nggak minta apa-apa sama kamu!"

#. Character:`saito`
msgctxt "hostess_club_interior_390c5c91"
msgid "Bon sang, j'y suis enfin après tout ce temps !"
msgstr "Sialan, akhirnya aku sampai juga setelah sekian lama!"

#. Character:`saito`
msgctxt "hostess_club_interior_f219ed97"
msgid "Ce club est bien mieux que tous ceux que j'ai pu fréquenter dans mon ancienne vie."
msgstr "Klub ini jauh lebih keren daripada semua yang pernah aku datengin di kehidupan aku sebelumnya."

#. Character:`saito`
msgctxt "hostess_club_interior_ae839375"
msgid "{{yasuka.n}} ne devrait pas être loin !"
msgstr "{{yasuka.n}} pasti nggak jauh dari sini!"

#. Character:`macumba`
msgctxt "hostess_club_interior_b1bc8d50"
msgid "Hé, petit frère !"
msgstr "Hei, adik kecil!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "hostess_club_interior_10249b75"
msgid "{{macumba.n}} ?!"
msgstr "{{macumba.n}}?!"

#. Character:`saito` | Attributes:`happy`
msgctxt "hostess_club_interior_2b5459a8"
msgid "Je ne t'avais pas reconnu, ça te change vraiment le costard !"
msgstr "Aku nggak ngenalin kamu, beneran beda banget gayanya pake jas itu!"

#. Character:`macumba` | Attributes:`happy`
msgctxt "hostess_club_interior_d0464d1e"
msgid "Toi aussi !"
msgstr "Kamu juga!"

#. Character:`saito`
msgctxt "hostess_club_interior_d013e49b"
msgid "...C'est vrai."
msgstr "...Iya sih."

#. Character:`saito`
msgctxt "hostess_club_interior_44545f7a"
msgid "Je ne savais pas que tu travaillais ici, si je l'avais su, les choses auraient été plus simples."
msgstr "Aku nggak tau kamu kerja di sini, kalo tau, semuanya pasti bakal lebih gampang."

#. Character:`macumba` | Attributes:`sad`
msgctxt "hostess_club_interior_ffcb7302"
msgid "Tu as des problèmes mon frère ?"
msgstr "Kamu ada masalah, bro?"

#. Character:`saito` | Attributes:`sad`
msgctxt "hostess_club_interior_2b779620"
msgid "Je... Je ne veux pas t'embêter avec ça, je dois apprendre à ne pas toujours compter sur toi à chaque fois que j'ai des ennuis."
msgstr "Aku... Aku nggak mau nyusahin kamu soal ini, aku harus belajar buat nggak selalu ngandelin kamu tiap kali aku kena masalah."

#. Character:`macumba` | Attributes:`neutral`
msgctxt "hostess_club_interior_b6d6c439"
msgid "Vouloir résoudre les choses par soit même est honorable."
msgstr "Mau nyelesain sendiri itu terhormat."

#. Character:`macumba`
msgctxt "hostess_club_interior_d96a3cc5"
msgid "Mais n'oublis pas, tu pourras toujours compter sur moi !"
msgstr "Tapi jangan lupa, kamu selalu bisa ngandelin aku!"

#. Character:`macumba`
msgctxt "hostess_club_interior_d6fafa5a"
msgid "Dis-moi ce que je peux faire pour toi."
msgstr "Bilang aja apa yang bisa aku lakuin buat kamu."

#. Character:`saito` | Attributes:`happy`
msgctxt "hostess_club_interior_b7629b45"
msgid "Tu es vraiment la meilleure personne que j'ai rencontrée..."
msgstr "Kamu bener-bener orang terbaik yang pernah aku temuin..."

#. Character:`saito`
msgctxt "hostess_club_interior_c1f275b0"
msgid "Il y a une personne... qui travaille ici auquel je tiens beaucoup !"
msgstr "Ada seseorang... yang kerja di sini yang aku sayang banget!"

#. Character:`saito` | Attributes:`upset`
msgctxt "hostess_club_interior_ca862fc3"
msgid "Et j'ai bien trop de personnes qui veulent me causer des ennuis qui n'hésiteront pas à passer par elle pour m'atteindre."
msgstr "Dan aku punya banyak orang yang pengen nyusahin aku, dan mereka nggak ragu buat lewat dia buat nyerang aku."

#. Character:`macumba` | Attributes:`upset`
msgctxt "hostess_club_interior_c56e8622"
msgid "Alors ce ne sont pas des hommes !"
msgstr "Kalau gitu mereka bukan orang jantan!"

#. Character:`macumba`
msgctxt "hostess_club_interior_870d7761"
msgid "Je crois avoir vu un banc un peu plus loin."
msgstr "Aku kira aku liat bangku agak jauh dari sini."

#. Character:`macumba`
msgctxt "hostess_club_interior_d0e29d9f"
msgid "Cite-moi un nom et j'irai lui enfoncer dans son cul !"
msgstr "Sebutin nama aja, aku bakal tancapin itu ke dalam pantatnya!"

#. Character:`saito` | Attributes:`happy`
msgctxt "hostess_club_interior_20b5e089"
msgid "Même si j'aimerais beaucoup assister à ça, tu risquerais d'avoir des soucis."
msgstr "Meski aku pengen banget ngeliat itu, kamu bisa aja kena masalah."

#. Character:`saito` | Attributes:`neutral`
msgctxt "hostess_club_interior_a4250fca"
msgid "Fais juste attention à lui, il s'appelle {{akira.n}}."
msgstr "Hati-hati sama dia, namanya {{akira.n}}."

#. Character:`saito`
msgctxt "hostess_club_interior_234d945b"
msgid "Il va vouloir s'approcher d'elle avec de mauvaises intentions..."
msgstr "Dia bakal pengen deketin dia dengan niat jahat..."

#. Character:`macumba`
msgctxt "hostess_club_interior_6527820f"
msgid "Je crois... que j'ai déjà dû avoir affaire à lui."
msgstr "Aku rasa... aku pernah berurusan sama dia."

#. Character:`macumba`
msgctxt "hostess_club_interior_6b238c4f"
msgid "Il n'avait pas d'argent, dans ce cas-là, je n'ai pas besoins de le ménager."
msgstr "Dia gak punya duit, jadi aku gak perlu ngasih dia perlakuan khusus."

#. Character:`macumba` | Attributes:`happy`
msgctxt "hostess_club_interior_d0d51087"
msgid "Je te promets, mon frère, que pas un homme ici, ne posera ses mains sur elle, parole de {{macumba.n}}."
msgstr "Aku janji, bro, gak ada cowok di sini yang bakal nyentuh dia, sumpah {{macumba.n}}."

#. Character:`saito` | Attributes:`happy`
msgctxt "hostess_club_interior_330f74fb"
msgid "Tu m'enlèves un poids des épaules, tu n'imagines même pas..."
msgstr "Kamu bikin aku lega banget, kamu gak bakal nyangka..."

#. Character:`macumba`
msgctxt "hostess_club_interior_0e7ca8fc"
msgid "Tout pour mon frère !"
msgstr "Semua buat bro aku!"

#. Character:`saito` | Attributes:`upset`
msgctxt "hostess_club_interior_61108a20"
msgid "Fais aussi attention à un homme assez corpulent, je crois qu'il s'appelle {{netoru.n}}."
msgstr "Hati-hati juga sama cowok yang cukup gede, aku rasa namanya {{netoru.n}}."

#. Character:`macumba` | Attributes:`neutral`
msgctxt "hostess_club_interior_a74ee73a"
msgid "Il n'y aura pas de problèmes avec lui, c'est un bon client qui s'est toujours bien comporté et qui n'a jamais touché aucune hôtesses."
msgstr "Nggak bakal ada masalah sama dia, dia pelanggan baik yang selalu berperilaku sopan dan nggak pernah sentuh cewek-cewek di sini."

#. Character:`saito` | Attributes:`happy`
msgctxt "hostess_club_interior_ade985dd"
msgid "Alors, je me suis probablement inquiété pour rien."
msgstr "Jadi, mungkin aku khawatir nggak perlu deh."

#. Character:`saito`
msgctxt "hostess_club_interior_89f2437c"
msgid "Merci {{macumba.n}}."
msgstr "Makasih {{macumba.n}}."

#. Character:`macumba`
msgctxt "hostess_club_interior_84d6ffed"
msgid "Laisse-moi tous tes problèmes, je m'en occupe."
msgstr "Tinggalin semua masalah kamu, aku yang urusin."

#. Character:`macumba`
msgctxt "hostess_club_interior_8a5433b5"
msgid "Ne pense qu'à ton entrainement !"
msgstr "Fokus aja sama latihan kamu!"

#. Character:`saito`
msgctxt "hostess_club_interior_b85f9f11"
msgid "C'est promis !"
msgstr "Janji deh!"

#. Character:`macumba` | Attributes:`happy`
msgctxt "hostess_club_interior_36b5db1c"
msgid "Allez, je dois retourner à mon poste, bonne soirée mon frère !"
msgstr "Ayo, aku harus balik kerja, selamat malam bro!"

#. Character:`saito`
msgctxt "talk_macumba_79d64d6a"
msgid "Hey, salut {{macumba.n}} !"
msgstr "Hey, halo {{macumba.n}}!"

#. Character:`macumba` | Attributes:`happy`
msgctxt "talk_macumba_b85a1cff"
msgid "Hey petit frère, ça me fait plaisir de te voir."
msgstr "Hey adik kecil, seneng banget liat kamu."

#. Character:`macumba` | Attributes:`neutral`
msgctxt "talk_macumba_24c950f2"
msgid "Comme promis, je n'ai laissé personne s'approcher d'elle avec de mauvaises intentions !"
msgstr "Kayak yang dijanjikan, aku nggak biarin siapapun deket dia dengan niat jahat!"

#. Character:`saito`
msgctxt "talk_macumba_2edf935e"
msgid "Merci, tu ne peux pas savoir à quel point ça me soulage de savoir ça."
msgstr "Makasih, kamu nggak tau betapa lega aku denger itu."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_macumba_b427421a"
msgid "{{akira.n}} est-il revenu ?"
msgstr "{{akira.n}} udah balik?"

#. Character:`macumba`
msgctxt "talk_macumba_0ebd781b"
msgid "Oui, et il a été banni définitivement."
msgstr "Iya, dan dia udah kena banned permanen."

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_macumba_c12d048d"
msgid "Ah !? Que s'est-il passé ?"
msgstr "Ah!? Kenapa bisa gitu?"

#. Character:`macumba` | Attributes:`upset`
msgctxt "talk_macumba_ca741ae4"
msgid "Je l'ai surpris en train de vouloir glisser quelque chose dans un verre."
msgstr "Aku nangkep dia waktu mau nyelipin sesuatu ke gelas."

#. Character:`saito`
msgctxt "talk_macumba_dd0da554"
msgid "Une drogue ?!"
msgstr "Narkoba?!"

#. Character:`macumba`
msgctxt "talk_macumba_5a4084eb"
msgid "Je ne sais pas trop, je l'ai secoué tellement fort qu'il a fait tomber tout ce qu'il avait sur lui."
msgstr "Aku nggak yakin, aku goyangin dia sampe semua barang yang dia bawa jatuh semua."

#. Character:`macumba`
msgctxt "talk_macumba_4a6feccf"
msgid "Je l'ai ensuite trainé dehors en lui tirant l'oreille."
msgstr "Abis itu aku seret dia keluar sambil narik kupingnya."

#. Character:`macumba` | Attributes:`neutral`
msgctxt "talk_macumba_4132cb17"
msgid "Quand la police est arrivée, il avait réussi à s'enfuir."
msgstr "Pas polisi dateng, dia udah berhasil kabur."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_macumba_2d70dea1"
msgid "Une fois de plus, tu es toujours là au bon moment !"
msgstr "Sekali lagi, kamu selalu datang di waktu yang tepat!"

#. Character:`saito`
msgctxt "talk_macumba_c8b502b6"
msgid "Je ne sais pas comment je pourrais te remercier."
msgstr "Aku nggak tau gimana caranya buat bales budi kamu."

#. Character:`macumba` | Attributes:`happy`
msgctxt "talk_macumba_8d45fa37"
msgid "Tu n'as pas besoins de me remercier petit frère."
msgstr "Gak usah makasih, adik kecil."

#. Character:`macumba`
msgctxt "talk_macumba_e75f2b2d"
msgid "J'ai fait mon travail, le patron était content de moi, j'ai même eu un bonus."
msgstr "Aku udah ngejalanin tugas, bos juga seneng sama aku, bahkan aku dapet bonus."

#. Character:`saito`
msgctxt "talk_macumba_364b65dd"
msgid "C'était mérité ! Merci encore pour tout."
msgstr "Emang pantas! Makasih lagi buat semuanya."

#. Character:`macumba` | Attributes:`-happy`
msgctxt "talk_macumba_24f47f28"
msgid "Pas de problème, petit frère !"
msgstr "Gak masalah, adik kecil!"

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_macumba_51029668"
msgid "Tiens au fait... Je ne vois pas {{yasuka.n}}, elle est en pause ?"
msgstr "Eh ngomong-ngomong... Aku gak liat {{yasuka.n}}, dia lagi istirahat ya?"

#. Character:`macumba`
msgctxt "talk_macumba_a73c4366"
msgid "Il me semble l'avoir vu quitter le bar avec précipitation tout à l'heure."
msgstr "Kayaknya aku liat dia buru-buru ninggalin bar tadi."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_macumba_dfe3c35a"
msgid "Ah ?! D'accord, je vais voir ça. Bonne soirée."
msgstr "Ah?! Oke, aku cek dulu. Selamat malam."

#. Character:`macumba` | Attributes:`happy`
msgctxt "talk_macumba_533bc9b1"
msgid "À la prochaine, petit frère."
msgstr "Sampai ketemu lagi, adik kecil."

#. Character:`narrator`
msgctxt "JE_DOIS_RESTER_DISCRET_LE_TEMP_60EB9B"
msgid "Je dois rester discret le temps de trouver une solution."
msgstr "Aku harus jaga-jaga dulu sambil nyari solusi."

#. Character:`kimochi`
msgctxt "t8dead9b441"
msgid "Laissez-moi !"
msgstr "Lepasin aku!"

#. Character:`narrator`
msgctxt "tf04737fa4e"
msgid "Merde... {{takeo.n}}, {{kenji.n}} et {{nobu.n}}, les trois brutes qui m'ont tabassé durant toute une partie de mon adolescence."
msgstr "Sial... {{takeo.n}}, {{kenji.n}} dan {{nobu.n}}, tiga preman yang nyiksa aku waktu aku remaja."

#. Character:`narrator`
msgctxt "t2627415f88"
msgid "Ces enfoirés ont fini leurs jours en prison, mais bien trop tard."
msgstr "Bajingan itu akhirnya mati di penjara, tapi telat banget."

#. Character:`narrator`
msgctxt "tb2217cff1b"
msgid "Entre-temps, ils ont causé bien trop de mal autour d'eux."
msgstr "Sementara itu, mereka udah nyebarin banyak malapetaka di sekitar."

#. Character:`narrator`
msgctxt "t2b54dd286b"
msgid "Si j'ai la possibilité, il faudrait que je trouve un moyen de les mettre hors d'état de nuire dans cette nouvelle vie."
msgstr "Kalau aku bisa, aku harus cari cara buat ngelumpuhin mereka di hidup yang baru ini."

#. Character:`takeo`
msgctxt "t85b9a1ff07"
msgid "Allez, serre bien la mâchoire, sinon tu risquerais de te mordre la langue."
msgstr "Ayo, kencengin gigimu, jangan sampai kamu gigit lidah sendiri."

#. Character:`kenji` | Attributes:`bad`
msgctxt "t05aa721bec"
msgid "C'est clair que ça la foutrait mal si tu finissais par te vider de ton sang sur un parking."
msgstr "Jelas bakal parah banget kalau kamu sampe berdarah-darah di parkiran."

#. Character:`takeo` | Attributes:`bad`
msgctxt "t7282f0433e"
msgid "Attention... Ça va arriver..."
msgstr "Hati-hati... Ini bakal terjadi..."

#. Character:`saito`
msgctxt "te0be9cc3ae"
msgid "Monsieur l'agent, par ici vite, une agression est en cours, venez vite !"
msgstr "Pak polisi, ke sini cepat, ada penyerangan lagi, cepetan datang!"

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "t22358cd1d0"
msgid "Faut se tirer d'ici et vite !"
msgstr "Kita harus kabur dari sini, cepet!"

#. Character:`kenji` | Attributes:`angry`
msgctxt "t09e15b6f30"
msgid "T'es chanceux, mais je te garantis qu'on te retrouvera !"
msgstr "Kamu beruntung, tapi aku jamin kita bakal nemuin kamu!"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "t72bd12acc2"
msgid "Ouais, c'est ça, tirez-vous !!! Bande de... de..."
msgstr "Iya, iya, cabut kalian!!! Anjing... anjing..."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "te89e8fef08"
msgid "Merde, j'ai trop mal..."
msgstr "Sial, aku sakit banget..."

#. Character:`saito`
msgctxt "t60d84f6a06"
msgid "Ça va aller ?"
msgstr "Kamu baik-baik aja?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "t467cfb3488"
msgid "...T'es qui, toi ?"
msgstr "...Kamu siapa, sih?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "t8871d2c35b"
msgid "Juste quelqu'un qui passait par là et qui a essayé de t'aider."
msgstr "Cuma orang yang kebetulan lewat dan coba bantu kamu."

#. Character:`saito` | Attributes:`upset`
msgctxt "t7a99d8a08d"
msgid "J'ai déjà eu affaire à eux par le passé donc... je peux comprendre."
msgstr "Aku pernah berurusan sama mereka sebelumnya jadi... aku ngerti deh."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "ta1bc91e18e"
msgid "Merci..."
msgstr "Makasih..."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "t49a5f3c42d"
msgid "Où as-tu trouvé un agent de police assez courageux pour intervenir dans ce genre d'embrouille ?"
msgstr "Kamu nemu polisi yang cukup berani buat campur tangan di keributan kayak gini di mana?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t8ee5a7bb73"
msgid "Il n'y en avait pas. J'ai juste tenté un coup de bluff."
msgstr "Gak ada sih. Aku cuma coba nge-bluff aja."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "t40684dca16"
msgid "Hahaha... C'était bien joué alors."
msgstr "Hahaha... Ya bagus tuh mainnya."

#. Character:`saito` | Attributes:`neutral`
msgctxt "t3794a03c7d"
msgid "Ça va aller ? Pourquoi ils t'ont agressé à la base ?"
msgstr "Aku baik-baik aja? Kenapa mereka sampe nyerang kamu dari awal?"

#. Character:`kimochi`
msgctxt "t300f800df8"
msgid "Oh ça ?! héhé, c'était voulu."
msgstr "Oh itu?! Hehe, itu emang aku sengaja."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "t64c803cfbd"
msgid "J'ai fait en sorte qu'ils me volent mon bento."
msgstr "Aku bikin mereka maling bento aku."

#. Character:`saito`
msgctxt "t0140ea5e85"
msgid "Mais... Pourquoi vouloir un truc pareil ?!"
msgstr "Tapi... Kenapa pengen hal gitu?!"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "t9f0ef11f7e"
msgid "J'ai mis tellement de laxatif dedans qu'ils vont passer la meilleure nuit de leur vie, et moi aussi."
msgstr "Aku masukin banyak banget pencahar ke dalamnya, mereka bakal punya malam terbaik dalam hidup mereka, dan aku juga."

#. Character:`saito` | Attributes:`happy`
msgctxt "ta06954a1ce"
msgid "Hahaha"
msgstr "Hahaha"

#. Character:`saito`
msgctxt "t487c72e803"
msgid "Je ne sais pas si tu es courageux, fou ou masochiste."
msgstr "Aku gak tau kamu berani, gila, atau masokis."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "tb89eaf5c61"
msgid "Pourquoi pas un peu des trois ?"
msgstr "Kenapa gak sekalian tiga-tiganya?"

#. Character:`kimochi`
msgctxt "t87282d9230"
msgid "Tu sais quoi ? Je sens que notre rencontre était prédestinée. Si jamais tu as besoin d'un second cerveau pour résoudre un problème, fais appel à moi."
msgstr "Tau gak? Aku ngerasa pertemuan kita ini udah takdir. Kalo kamu butuh otak kedua buat nyelesain masalah, panggil aku aja."

#. Character:`kimochi`
msgctxt "t03c48aa7e4"
msgid "Je t'en dois une."
msgstr "Aku berhutang sama kamu."

#. Character:`saito` | Attributes:`neutral`
msgctxt "t0694266daa"
msgid "Ça marche ! Je te raccompagne chez toi ?"
msgstr "Oke deh! Mau aku antar pulang?"

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "t7db30c9a56"
msgid "Désolé, je suis hétéro."
msgstr "Maaf, aku hetero."

#. Character:`saito` | Attributes:`happy`
msgctxt "td44d3a8f3c"
msgid "L'enfoiré..."
msgstr "Bajingan..."

#. Character:`saito`
msgctxt "konbini_exterior_310c427c"
msgid "{{chiaki.n}} !"
msgstr "{{chiaki.n}} !"

#. Character:`chiaki`
msgctxt "konbini_exterior_3eef1488"
msgid "!!!"
msgstr "!!!"

#. Character:`saito`
msgctxt "konbini_exterior_ad84629d"
msgid "Je t'ai cherché partout en ville."
msgstr "Aku nyariin kamu ke mana-mana di kota."

#. Character:`saito`
msgctxt "konbini_exterior_7008915d"
msgid "{{minato.n}} était très inquiet qu'il ne te soit arrivé quelque chose, comme d'habitude tu me diras."
msgstr "{{minato.n}} bener-bener khawatir kalau ada apa-apa sama kamu, kayak biasa bakal bilang gitu kan."

#. Character:`saito` | Attributes:`happy`
msgctxt "konbini_exterior_895c03e8"
msgid "Si tu veux trainer un peu plus dehors, dis-le, je sais à quel point il peut être étouffant."
msgstr "Kalau mau nongkrong lebih lama di luar, bilang aja, aku tau betapa nyebelin dia bisa jadi."

#. Character:`chiaki` | Attributes:`sad`
msgctxt "konbini_exterior_15ce8a60"
msgid "Je ne veux pas y retourner."
msgstr "Aku nggak mau balik ke sana."

#. Character:`saito` | Attributes:`sad`
msgctxt "konbini_exterior_5c2e1b34"
msgid "Je crois savoir pourquoi..."
msgstr "Aku kira tau kenapa..."

#. Character:`chiaki`
msgctxt "konbini_exterior_fb39dd37"
msgid "Tu as promis..."
msgstr "Kamu janji..."

#. Character:`chiaki`
msgctxt "konbini_exterior_97e42995"
msgid "Tu as promis que tu ne dirais rien !"
msgstr "Kamu janji nggak bakal bilang apa-apa!"

#. Character:`saito` | Attributes:`neutral`
msgctxt "konbini_exterior_4dd8d5c2"
msgid "Oui, mais en échange, dis-moi pourquoi tu sembles si terrifié par ton propre frère ?"
msgstr "Iya, tapi sebagai gantinya, bilang dong kenapa kamu keliatan takut banget sama abang sendiri?"

#. Character:`saito` | Attributes:`upset`
msgctxt "konbini_exterior_640c5da6"
msgid "J'ai le sentiment qu'il n'est pas seulement étouffant, je me trompe ?"
msgstr "Aku ngerasa dia nggak cuma nyebelin doang, aku salah?"

#. Character:`chiaki` | Attributes:`shy`
msgctxt "konbini_exterior_db6b4839"
msgid "Je..."
msgstr "Aku..."

#. Character:`chiaki`
msgctxt "konbini_exterior_138d3400"
msgid "Je n'ai pas le droit d'en parler..."
msgstr "Aku nggak boleh cerita..."

#. Character:`narrator`
msgctxt "konbini_exterior_5184afc6"
msgid "Ah, je n'aime pas la tournure de cette conversation."
msgstr "Ah, aku nggak suka arah pembicaraan ini."

#. Character:`narrator`
msgctxt "konbini_exterior_bc2387be"
msgid "Je ne sais pas ce que cache {{minato.n}}, mais je n'aime pas ça."
msgstr "Aku nggak tau apa yang disembunyiin {{minato.n}}, tapi aku nggak suka itu."

#. Character:`saito`
msgctxt "konbini_exterior_bba623a1"
msgid "Quel genre de..."
msgstr "Jenis apa sih..."

#. Character:`minato`
msgctxt "konbini_exterior_b73b3bf5"
msgid "Enfin !"
msgstr "Akhirnya!"

#. Character:`minato`
msgctxt "konbini_exterior_9020032d"
msgid "{{chiaki.n}}, je t'assure que si jamais tu recommences à t'enfuir de la maison sans prévenir..."
msgstr "{{chiaki.n}}, aku janji kalau kamu ngulang lagi kabur dari rumah tanpa bilang..."

#. Character:`minato`
msgctxt "konbini_exterior_812a84ad"
msgid "Je vais me mettre vraiment en colère."
msgstr "Aku bakal bener-bener marah."

#. Character:`chiaki`
msgctxt "konbini_exterior_4c6bf402"
msgid "Non..."
msgstr "Gak..."

#. Character:`saito` | Attributes:`upset`
msgctxt "konbini_exterior_de5336a5"
msgid "Hey, une seconde {{minato.n}} ! Je pense que tu lui fais vraiment peur."
msgstr "Hei, tunggu dulu {{minato.n}}! Kayaknya kamu bikin dia takut banget."

#. Character:`saito` | Attributes:`sad`
msgctxt "konbini_exterior_8e570e1d"
msgid "C'est ta sœur !"
msgstr "Itu saudara cewek kamu!"

#. Character:`minato` | Attributes:`suspicious`
msgctxt "konbini_exterior_2d7d09bc"
msgid "Mec, tu veux bien te mêler de tes affaires ? Tu ne m'aides pas vraiment là."
msgstr "Bro, bisa nggak urusin urusan kamu sendiri? Kamu nggak bantu sama sekali nih."

#. Character:`saito`
msgctxt "konbini_exterior_78ddf259"
msgid "Je suis désolé, mais tout ce que je vois, c'est toi en train de la forcer à faire quelque chose dont elle n'a pas envie."
msgstr "Maaf ya, tapi yang aku liat cuma kamu maksa dia ngelakuin sesuatu yang dia nggak mau."

#. Character:`saito`
msgctxt "konbini_exterior_34d72609"
msgid "Qu'est-ce que tu lui as fait ?"
msgstr "Kamu ngapain sama dia?"

#. Character:`minato` | Attributes:`upset`
msgctxt "konbini_exterior_ccd4fc58"
msgid "Oh, oh, doucement, c'est quoi ces accusations ?!"
msgstr "Oh, oh, santai, itu tuduhan apaan sih?!"

#. Character:`minato` | Attributes:`angry`
msgctxt "konbini_exterior_f7c4062a"
msgid "Je rêve ou on dirait que tu me prends pour un putain de pervers ?"
msgstr "Aku mimpi apa ya, kok kayaknya kamu nganggep aku cowok mesum banget?"

#. Character:`minato`
msgctxt "konbini_exterior_9e0efe8c"
msgid "Je veux bien être sympa avec toi {{saito.n}}, mais faut pas déconner avec ça."
msgstr "Aku sih pengen baik sama kamu {{saito.n}}, tapi jangan main-main sama yang beginian."

#. Character:`minato` | Attributes:`upset`
msgctxt "konbini_exterior_ce3ffa61"
msgid "...pff, bon que t'a-t-elle dit ?"
msgstr "...pff, ya udah, dia bilang apa?"

#. Character:`saito`
msgctxt "konbini_exterior_e3e5e311"
msgid "Rien justement, elle n'en a pas le droit."
msgstr "Gak ada, dia gak punya hak buat bilang itu."

#. Character:`minato` | Attributes:`neutral`
msgctxt "konbini_exterior_d356b16e"
msgid "...Quoi et c'est tout ?"
msgstr "...Serius, cuma itu doang?"

#. Character:`minato`
msgctxt "konbini_exterior_abdb1aa5"
msgid "Bon Dieu, t'es pas croyable quand même ?"
msgstr "Ya ampun, kamu gak nyangka juga ya?"

#. Character:`minato` | Attributes:`happy`
msgctxt "konbini_exterior_187f15d2"
msgid "Tu serais prêt à foutre en l'air une amitié à cause de mots aussi vagues, ou d'une formulation de phrase un peu bancale ?"
msgstr "Kamu rela ngerusak persahabatan cuma gara-gara kata-kata yang samar-samar, atau cara ngomong yang agak ngaco gitu?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "konbini_exterior_d5102300"
msgid "Explique-moi... dans ce cas, tu es toujours bien trop vague."
msgstr "Jelasin dong... dalam hal ini, kamu masih terlalu ngambang."

#. Character:`minato` | Attributes:`neutral`
msgctxt "konbini_exterior_0c533573"
msgid "Okay, okay, c'est bon, je vais tout te dire."
msgstr "Oke, oke, santai, aku bakal cerita semuanya ke kamu."

#. Character:`minato`
msgctxt "konbini_exterior_b7f91a2b"
msgid "Comme tu le sais, nos parents sont en voyage d'affaires depuis un certain temps déjà."
msgstr "Seperti yang kamu tahu, orang tua kita udah lagi perjalanan bisnis dari beberapa waktu lalu."

#. Character:`minato`
msgctxt "konbini_exterior_a38bf2bd"
msgid "Et pendant qu'eux prennent du plaisir, c'est moi qui dois tout gérer à la maison."
msgstr "Dan sementara mereka lagi nikmatin waktu, aku yang harus ngurus semuanya di rumah."

#. Character:`minato` | Attributes:`upset`
msgctxt "konbini_exterior_1d542e8e"
msgid "L'entretien, les factures, etc."
msgstr "Perawatan, tagihan, dan lain-lain."

#. Character:`minato`
msgctxt "konbini_exterior_9db2471e"
msgid "Et je n'aime pas étaler mes problèmes, donc je préfère que ça reste discret."
msgstr "Dan aku nggak suka pamer masalah, jadi aku lebih suka semuanya tetap rahasia."

#. Character:`minato` | Attributes:`neutral`
msgctxt "konbini_exterior_a05403c9"
msgid "Donc oui, je suis peut-être un peu sévère, mais nos parents m'ont dit de m'occuper d'elle et c'est exactement ce que je compte faire !"
msgstr "Jadi iya, aku mungkin agak tegas, tapi orang tua kita suruh aku ngurus dia dan itu beneran yang mau aku lakuin!"

#. Character:`saito`
msgctxt "konbini_exterior_2b27740b"
msgid "Je vois..."
msgstr "Aku ngerti..."

#. Character:`minato` | Attributes:`suspicious`
msgctxt "konbini_exterior_02482872"
msgid "Tu es rassuré maintenant ?"
msgstr "Kamu udah tenang sekarang?"

#. Character:`saito`
msgctxt "konbini_exterior_bf09d7e3"
msgid "{{chiaki.n}}, tu es d'accord avec ce qu'il dit ?"
msgstr "{{chiaki.n}}, kamu setuju sama apa yang dia bilang?"

#. Character:`chiaki` | Attributes:`shy`
msgctxt "konbini_exterior_10047fd9"
msgid "...Oui."
msgstr "...Iya."

#. Character:`minato` | Attributes:`happy`
msgctxt "konbini_exterior_a8a53231"
msgid "Voilà, tu vois bien ? Cesse de t'inquiéter."
msgstr "Lihat kan? Udah jangan khawatir terus."

#. Character:`narrator`
msgctxt "konbini_exterior_03373df9"
msgid "Mouais, elle ne va pas dire la vérité avec toi à ces côtés..."
msgstr "Hm, dia nggak bakal ngomong jujur kalo kamu masih di samping dia..."

#. Character:`narrator`
msgctxt "konbini_exterior_45f2aea1"
msgid "Il faudra vraiment que je me retrouve seul avec elle sans {{minato.n}}."
msgstr "Aku bener-bener harus bisa sendirian sama dia tanpa {{minato.n}}."

#. Character:`saito`
msgctxt "konbini_exterior_9a6e7dee"
msgid "D'accord, désolé de t'avoir suspecté, je m'inquiétais aussi pour elle, tu sais..."
msgstr "Oke, maaf udah curiga sama kamu, aku juga khawatir sama dia, tau nggak..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "konbini_exterior_765054af"
msgid "Et je n'ai pas croisé de mec louche."
msgstr "Dan aku nggak ketemu cowok mencurigakan."

#. Character:`minato`
msgctxt "konbini_exterior_6cc3471f"
msgid "Je finirais bien par le choper et à ce moment-là, il passera un sale moment."
msgstr "Aku bakal nangkep dia juga, dan pas itu, dia bakal ngerasain masa-masa buruk."

#. Character:`minato` | Attributes:`neutral`
msgctxt "konbini_exterior_1036c51c"
msgid "Bon, on doit y aller, on va te laisser ici. Merci pour le coup de main."
msgstr "Oke, kita harus pergi, kita bakal ninggalin kamu di sini. Makasih buat bantuannya."

#. Character:`saito`
msgctxt "konbini_exterior_de37314b"
msgid "Pas de problème, n'hésite pas à me laisser {{chiaki.n}} un de ces jours !"
msgstr "Nggak masalah, jangan ragu buat ninggalin {{chiaki.n}} ke aku kapan-kapan!"

#. Character:`saito` | Attributes:`happy`
msgctxt "konbini_exterior_f56abd17"
msgid "J'irai me balader avec elle et je suis sûr qu-"
msgstr "Aku bakal jalan-jalan sama dia dan aku yakin k-"

#. Character:`minato`
msgctxt "konbini_exterior_22cb0aca"
msgid "Non, tu ne sortiras pas avec ma sœur !"
msgstr "Nggak, kamu nggak bakal pacaran sama cewek aku!"

#. Character:`minato` | Attributes:`happy`
msgctxt "konbini_exterior_8456ed08"
msgid "Tu n'en n'est pas digne !"
msgstr "Kamu nggak pantas!"

#. Character:`saito`
msgctxt "konbini_exterior_03775ec8"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "konbini_exterior_f0ab5c85"
msgid "{{minato.n}} !"
msgstr "{{minato.n}}!"

#. Character:`minato`
msgctxt "konbini_exterior_a850d63b"
msgid "Putain, quoi encore ?"
msgstr "Sialan, apaan lagi nih?"

#. Character:`saito` | Attributes:`sad`
msgctxt "konbini_exterior_96c5b1e4"
msgid "Ouh, du calme, j'avais juste une dernière chose à te demander."
msgstr "Ouh, santai aja, aku cuma punya satu hal terakhir buat ditanyain ke kamu."

#. Character:`saito`
msgctxt "konbini_exterior_9f561f61"
msgid "{{asami.n}}, tu vois qui c'est ?"
msgstr "{{asami.n}}, kamu tau siapa ini nggak?"

#. Character:`minato` | Attributes:`suspicious`
msgctxt "konbini_exterior_9e180a3c"
msgid "Ma voisine ?"
msgstr "Tetangga aku?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "konbini_exterior_454e28ac"
msgid "Oui... Est-ce que ça te dérangerait si je sortais avec ?"
msgstr "Iya... Kamu keberatan nggak kalau aku pacaran sama dia?"

#. Character:`minato` | Attributes:`happy`
msgctxt "konbini_exterior_23b2cbd0"
msgid "Quoi ? Ce putain de cageot ? Mec, fait toi plaisir."
msgstr "Apa? Brengsek itu? Bro, santai aja deh."

#. Character:`minato`
msgctxt "konbini_exterior_355d3f3c"
msgid "Les garçons manqués ce n'est vraiment pas mon truc et surtout que j'ai déjà quelqu'un."
msgstr "Cewek tomboy emang bukan selera aku, apalagi aku udah punya orang."

#. Character:`minato` | Attributes:`neutral`
msgctxt "konbini_exterior_15f8a44b"
msgid "C'est bon inspecteur ? J'ai répondu à toutes vos questions ?"
msgstr "Udah cukup, detektif? Aku udah jawab semua pertanyaan kamu?"

#. Character:`saito` | Attributes:`happy`
msgctxt "konbini_exterior_1cc81edc"
msgid "Oui, merci, encore désolé."
msgstr "Iya, makasih, maaf banget ya."

#. Character:`saito`
msgctxt "konbini_exterior_b96c5869"
msgid "Eh bien... {{asami.n}}, tu viens de te prendre un sacré râteau..."
msgstr "Yah... {{asami.n}}, kamu baru aja kena ghosting parah nih..."

#. Character:`saito` | Attributes:`sad`
msgctxt "konbini_exterior_5d986194"
msgid "J'ai plus qu'à retourner la voir maintenant."
msgstr "Sekarang aku cuma bisa balik buat ketemu dia lagi."

#. Character:`narrator`
msgctxt "konbini_exterior_527f552d"
msgid "J'ai bien l'impression que {{minato.n}} ne m'a pas dit toute la vérité."
msgstr "Kayaknya {{minato.n}} nggak ngasih tau aku semua kebenarannya."

#. Character:`narrator`
msgctxt "konbini_exterior_4a5756cd"
msgid "J'essaierai de débarquer chez lui à l'improviste un de ces jours..."
msgstr "Aku bakal nyoba main ke rumah dia tiba-tiba suatu hari nanti..."

#. Character:`saito` | Attributes:`upset`
msgctxt "konbini_exterior_752678c4"
msgid "Mais quel enfoiré !"
msgstr "Dasar bajingan!"

#. Character:`kimochi`
msgctxt "konbini_exterior_709a0f85"
msgid "Ce gars est un vrai pot de colle !"
msgstr "Cowok itu nempel banget kaya perangko!"

#. Character:`saito`
msgctxt "konbini_exterior_48bb8adc"
msgid "Hey, revient ici !"
msgstr "Hei, balik sini!"

#. Character:`saito`
msgctxt "konbini_exterior_f9e1e373"
msgid "Merde, il est vraiment rapide."
msgstr "Sial, dia emang cepet banget."

#. Character:`saito`
msgctxt "konbini_exterior_733c4a7b"
msgid "Je crois qu'il se dirigeait vers le [color=yellow]dojo[/color]."
msgstr "Kayaknya dia lagi menuju ke [color=yellow]dojo[/color]."

#. Character:`saito` | Attributes:`upset`
msgctxt "konbini_exterior_bde0f877"
msgid "Merde, ils ne sont pas là !"
msgstr "Sial, mereka nggak ada di sini!"

#. Character:`saito`
msgctxt "konbini_exterior_ef9609ef"
msgid "Où est-ce qu'ils pourraient être ?"
msgstr "Mereka bisa jadi di mana ya?"

#. Character:`saito`
msgctxt "konbini_exterior_d5a60af7"
msgid "Je dois continuer à chercher, même si je dois y passer la nuit !"
msgstr "Aku harus terus nyari, meskipun harus nginep di sana!"

#. Character:`nobu`
msgctxt "konbini_exterior_74d7068b"
msgid "ARRÊTE-TOI !"
msgstr "BERHENTI!"

#. Character:`noriko`
msgctxt "konbini_exterior_35dafaae"
msgid "On a fait toute la ville de long en large, et aucune trace de cette fille..."
msgstr "Kita udah muterin kota dari ujung ke ujung, tapi nggak nemu jejak cewek itu sama sekali..."

#. Character:`asami`
msgctxt "konbini_exterior_2d27cfc0"
msgid "Et ce mec bizarre qui est parti en hurlant quand on lui a demandé des infos sur elle ?"
msgstr "Terus cowok aneh yang kabur teriak-teriak pas kita tanya soal dia?"

#. Character:`noriko` | Attributes:`bad`
msgctxt "konbini_exterior_e62fe47c"
msgid "Ce gros tas ?"
msgstr "Yang gendut itu?"

#. Character:`noriko`
msgctxt "konbini_exterior_52d97860"
msgid "Il avait juste jamais parlé à une fille de sa vie, c'est tout !"
msgstr "Dia cuma belum pernah ngomong sama cewek seumur hidupnya, itu aja!"

#. Character:`asami` | Attributes:`happy`
msgctxt "konbini_exterior_2a7e95d1"
msgid "Aïe, t'es dure."
msgstr "Aduh, kamu kejam banget."

#. Character:`noriko`
msgctxt "konbini_exterior_ad9a0f8e"
msgid "Il avait une tête de gros pervers surtout, il me faisait penser à {{saito.n}} !"
msgstr "Dia malah keliatan kayak pervert gede, dia ngingetin aku sama {{saito.n}}!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "konbini_exterior_f605ee55"
msgid "Il est pas comme ça !"
msgstr "Dia nggak kayak gitu!"

#. Character:`noriko`
msgctxt "konbini_exterior_79c16a7e"
msgid "Si tu le dis..."
msgstr "Kalau kamu bilang gitu..."

#. Character:`asami` | Attributes:`neutral`
msgctxt "konbini_exterior_34323612"
msgid "On n'a pas été voir dans la rue un peu plus loin..."
msgstr "Kita belum nyari di jalan agak jauh ke sana..."

#. Character:`asami` | Attributes:`sad`
msgctxt "konbini_exterior_d6bc5d29"
msgid "Après ça, je n'aurais plus d'idée."
msgstr "Abis ini, aku nggak punya ide lagi deh."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "konbini_exterior_7147a05d"
msgid "... On finira bien par tomber sur elle à un moment ou à un autre."
msgstr "... Kita pasti bakal ketemu dia suatu saat nanti."

#. Character:`asami`
msgctxt "konbini_exterior_156358ad"
msgid "J'espère..."
msgstr "Semoga aja..."

#. Character:`saito`
msgctxt "konbini_exterior_4c905b43"
msgid "Pourquoi est elle entrée ici à votre avis ?"
msgstr "Menurut kamu, kenapa dia masuk ke sini?"

#. Character:`kimochi`
msgctxt "konbini_exterior_c40ab4a1"
msgid "C'est un konbini, qu'est-ce que tu veux qu'elle y fasse d'après toi ?"
msgstr "Ini kan konbini, menurut kamu dia mau ngapain di sana?"

#. Character:`asami`
msgctxt "konbini_exterior_b7860484"
msgid "C'est justement là où travaille ma mère."
msgstr "Justru di situ tempat kerja ibuku."

#. Character:`kimochi`
msgctxt "konbini_exterior_6fb8f665"
msgid "Tu crois qu'elle pourrait me faire un prix d'ami à l'avenir ?"
msgstr "Kamu kira dia bakal ngasih harga spesial buat aku nanti?"

#. Character:`asami`
msgctxt "konbini_exterior_b44575b5"
msgid "Rêve !"
msgstr "Mimpi deh!"

#. Character:`saito`
msgctxt "konbini_exterior_68ad55be"
msgid "La voilà !"
msgstr "Ini dia!"

#. Character:`noriko`
msgctxt "konbini_exterior_f0a61518"
msgid "[font_size=14]Merci madame ![/font_size]"
msgstr "[font_size=14]Makasih ya, Bu![/font_size]"

#. Character:`sayuri`
msgctxt "konbini_exterior_a70605d3"
msgid "[font_size=14]C'est {{sayuri.n}} pour toi ma puce ![/font_size]"
msgstr "[font_size=14]Ini buat kamu, Sayuri kecil![/font_size]"

#. Character:`noriko`
msgctxt "konbini_exterior_29cd7803"
msgid "..."
msgstr "..."

#. Character:`kimochi`
msgctxt "konbini_exterior_c3ac1011"
msgid "[font_size=14]Elle ne bouge plus, elle se doute de quelque chose... Elle est trop maligne.[/font_size]"
msgstr "[font_size=14]Dia gak gerak lagi, kayaknya dia curiga... Emang dia pinter banget.[/font_size]"

#. Character:`asami`
msgctxt "konbini_exterior_22bf9d7f"
msgid "[font_size=14]Mon dieu que tu es stressant ![/font_size]"
msgstr "[font_size=14]Astaga, kamu bikin stres banget![/font_size]"

#. Character:`saito`
msgctxt "konbini_exterior_29b51d86"
msgid "Elle se dirige vers le centre-ville, suivez-la pendant que je vais voir si je peux apprendre quelque chose au konbini sur ses habitudes."
msgstr "Dia lagi ke pusat kota, ikutin dia sementara aku cari tahu apa ada yang bisa aku pelajari di konbini tentang kebiasaannya."

#. Character:`saito`
msgctxt "konbini_exterior_69a25f37"
msgid "On se rejoint après."
msgstr "Kita ketemu lagi nanti."

#. Character:`asami` | Attributes:`upset`
msgctxt "konbini_exterior_242f92a3"
msgid "Fais vite, sinon je risque de l'étrangler."
msgstr "Cepetin, aku bisa aja mencekiknya."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "konbini_exterior_bedac76f"
msgid "Mhh il se pourrait que j'apprécie..."
msgstr "Mhh mungkin aku suka juga nih..."

#. Character:`asami` | Attributes:`angry`
msgctxt "konbini_exterior_08d649f7"
msgid "Rhaaaa !"
msgstr "Rhaaaa!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "konbini_exterior_57f449b0"
msgid "Je constate que tu t'entends très bien avec ma mère."
msgstr "Aku liat kamu cocok banget sama ibu aku."

#. Character:`saito` | Attributes:`guilty`
msgctxt "konbini_exterior_eb2873cd"
msgid "Je ne sais pas trop quoi dire... Ta mère est vraiment intéressante."
msgstr "Aku nggak tau harus bilang apa... Ibu kamu bener-bener menarik."

#. Character:`asami`
msgctxt "konbini_exterior_e73d4fd8"
msgid "Intéressante ?[w] Dois-je en conclure que ma mère t'intéresse {{saito.n}} ?"
msgstr "Menarik?[w] Harus aku simpulin kalo ibu aku menarik buat kamu, {{saito.n}}?"

#. Character:`saito`
msgctxt "konbini_exterior_41c63fda"
msgid "Hmm ce n'est peut-être pas le bon mot."
msgstr "Hmm mungkin itu bukan kata yang tepat."

#. Character:`asami` | Attributes:`upset`
msgctxt "konbini_exterior_85cb9f6d"
msgid "Non pas du tout ! Tu vas devoir t'expliquer."
msgstr "Enggak sama sekali! Kamu harus jelasin nih."

#. Character:`saito` | Attributes:`neutral`
msgctxt "konbini_exterior_ada2a290"
msgid "Peut-être que maintenant n'est pas le meilleur moment ? Nous devons rejoindre {{kimochi.n}}."
msgstr "Mungkin sekarang bukan waktu yang tepat? Kita harus ketemu sama {{kimochi.n}}."

#. Character:`asami` | Attributes:`surprised`
msgctxt "konbini_exterior_ad2aca67"
msgid "Oh oui tu as raison ! {{noriko.n}} s'est dirigée en centre-ville, elle s'est arrêté à l'arcade center."
msgstr "Oh iya, kamu bener! {{noriko.n}} lagi ke pusat kota, dia berhenti di arcade center."

#. Character:`saito`
msgctxt "konbini_exterior_96df4b59"
msgid "L'arcade center ?!"
msgstr "Arcade center?!"

#. Character:`asami` | Attributes:`neutral`
msgctxt "konbini_exterior_9095e677"
msgid "Un problème ?"
msgstr "Ada masalah?"

#. Character:`saito` | Attributes:`upset`
msgctxt "konbini_exterior_9061d81b"
msgid "Non... mais ça m'évoque quelque chose."
msgstr "Enggak... tapi itu ngingetin aku sama sesuatu."

#. Character:`saito`
msgctxt "konbini_exterior_7afa3be3"
msgid "Dépêchons-nous."
msgstr "Cepet deh."

#. Character:`narrator`
msgctxt "konbini_exterior_ebaabf95"
msgid "Bon sang {{noriko.n}}... Après {{akira.n}} les putains de thugs ?"
msgstr "Sialan {{noriko.n}}... Abis {{akira.n}} sekarang ngadepin preman bajingan?"

#. Character:`narrator`
msgctxt "konbini_exterior_32de5c0d"
msgid "Tu fais tout pour t'attirer des ennuis ?"
msgstr "Kamu emang nyari masalah ya?"

#. Character:`narrator`
msgctxt "konbini_exterior_3925a29d"
msgid "J'espère qu'il n'est pas trop tard..."
msgstr "Aku harap belum terlambat..."

#. Character:`kenji`
msgctxt "konbini_exterior_a22b49d7"
msgid "Et moi qui pensais que tu te dégonflerais..."
msgstr "Dan aku kira kamu bakal ciut..."

#. Character:`kenji`
msgctxt "konbini_exterior_6de2010a"
msgid "Je me suis trompé visiblement."
msgstr "Sepertinya aku salah."

#. Character:`saito`
msgctxt "konbini_exterior_493cf7e2"
msgid "Et il y a probablement autre chose que tu n'avais pas anticipé."
msgstr "Dan mungkin ada hal lain yang gak kamu antisipasi."

#. Character:`kenji` | Attributes:`bad`
msgctxt "konbini_exterior_89f35539"
msgid "Ah oui ? Quoi donc ?"
msgstr "Oh ya? Apa tuh?"

#. Character:`saito` | Attributes:`angry`
msgctxt "konbini_exterior_e2a792b3"
msgid "Que c'est toi qui allais manger le sol pour une fois."
msgstr "Kamu yang bakal makan tanah buat sekali ini."

#. Character:`kenji` | Attributes:`disgusted`
msgctxt "konbini_exterior_fb80f425"
msgid "Hunnng"
msgstr "Hunnng"

#. Character:`kenji`
msgctxt "konbini_exterior_ddfb249c"
msgid "Put..."
msgstr "Sialan..."

#. Character:`saito`
msgctxt "konbini_exterior_77fdc6d0"
msgid "Hannn... hannnn... Ca y est !"
msgstr "Hannn... hannnn... Ini dia!"

#. Character:`sayuri` | Attributes:`surprised`
msgctxt "konbini_exterior_0d8860a0"
msgid "Mon dieu {{saito.n}} est-ce que tout va bien ?"
msgstr "Ya ampun {{saito.n}} apa semuanya baik-baik aja?"

#. Character:`sayuri` | Attributes:`sad`
msgctxt "konbini_exterior_edec93ff"
msgid "Viens à la maison, je vais m'occuper de toi."
msgstr "Ayo ke rumah, aku bakal urusin kamu."

#. Character:`saito` | Attributes:`happy`
msgctxt "konbini_exterior_c1ba3165"
msgid "Non merci ça ira... Je vais raccompagner {{noriko.n}} à la maison, une bonne nuit de sommeil et tout ira mieux."
msgstr "Gak usah, makasih... Aku bakal antar {{noriko.n}} pulang, tidur yang nyenyak, nanti semuanya bakal lebih baik."

#. Character:`sayuri` | Attributes:`sad`
msgctxt "konbini_exterior_c3a175de"
msgid "Tu es sûr ?"
msgstr "Kamu yakin?"

#. Character:`saito`
msgctxt "konbini_exterior_d63342a2"
msgid "Affirmatif."
msgstr "Yoi."

#. Character:`sayuri`
msgctxt "konbini_exterior_c4561d6e"
msgid "Prends soin de lui {{noriko.n}} !"
msgstr "Jaga dia baik-baik ya {{noriko.n}}!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "konbini_exterior_898b1990"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "konbini_exterior_f922d802"
msgid "Il n'est pas là non plus..."
msgstr "Dia juga nggak ada di situ..."

#. Character:`saito`
msgctxt "konbini_exterior_a4731885"
msgid "Toi qui traîne souvent en ville tu n'as pas une idée, même vague ?"
msgstr "Kamu yang sering nongkrong di kota, nggak ada ide, walau sekilas?"

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "konbini_exterior_103a3f9f"
msgid "Si je le savais, tu crois que je m'amuserais à garder l'info pour moi ?"
msgstr "Kalau aku tau, kira-kira aku bakal seneng-seneng nyimpen info itu sendiri nggak?"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "konbini_exterior_9c12aaa6"
msgid "Tu parles de la femme de ma vie là !"
msgstr "Kamu ngomongin cewek terpenting dalam hidup aku nih!"

#. Character:`asami` | Attributes:`upset`
msgctxt "konbini_exterior_9aec311a"
msgid "On doit absolument le trouver avant qu'il ne trouve {{noriko.n}}, ce type est capable du pire !"
msgstr "Kita harus banget nemuin dia sebelum dia nemuin {{noriko.n}}, itu orang bisa ngelakuin hal terburuk!"

#. Character:`saito`
msgctxt "konbini_exterior_415e16bc"
msgid "Je sais, mais ne t'inquiète pas, on va la retrouver et il ne lui arrivera rien."
msgstr "Aku tau, tapi tenang aja, kita bakal nemuin dia dan nggak bakal ada apa-apa sama dia."

#. Character:`kimochi`
msgctxt "konbini_exterior_d0ddfe2a"
msgid "Hors de question ! Plutôt mourir que de voir cet enfoiré poser ses mains sur elle."
msgstr "Gak mungkin! Mending mati daripada liat bajingan itu nyentuh dia."

#. Character:`yasuka`
msgctxt "konbini_exterior_1096b23c"
msgid "Oh mon dieu..."
msgstr "Astaga..."

#. Character:`yasuka`
msgctxt "konbini_exterior_ddee37bc"
msgid "Je n'avais pas vu le temps passer."
msgstr "Aku nggak nyadar waktu udah lewat."

#. Character:`yasuka`
msgctxt "konbini_exterior_f0f7284b"
msgid "Ça fait déjà plus de deux heures..."
msgstr "Udah lebih dari dua jam nih..."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "konbini_exterior_dda05a98"
msgid "Ils doivent probablement s'inquiéter."
msgstr "Mereka pasti lagi khawatir banget."

#. Character:`asami`
msgctxt "konbini_exterior_e858a9e0"
msgid "Qu'est ce qui s'est passé ?! Tu as la tête de quelqu'un qui est tombé dans les escaliers !"
msgstr "Apa yang terjadi?! Kamu keliatan kayak orang yang jatuh dari tangga!"

#. Character:`saito` | Attributes:`happy`
msgctxt "konbini_exterior_ad4cbbaf"
msgid "Boh c'est rien t'en fais pas, juste le quotidien."
msgstr "Ah, nggak apa-apa, cuma hal biasa aja."

#. Character:`asami` | Attributes:`pouting`
msgctxt "konbini_exterior_d2d8fa20"
msgid "Tu es sûre ? Tu ne me caches rien ?"
msgstr "Kamu yakin? Kamu nggak nyembunyiin apa-apa dari aku?"

#. Character:`noriko`
msgctxt "konbini_exterior_c563a0d5"
msgid "Bien sûr qu'il te cache des choses, tu serais bien trop inquiète sinon."
msgstr "Tentu dia nyembunyiin sesuatu, kalau nggak kamu pasti bakal khawatir banget."

#. Character:`asami` | Attributes:`upset`
msgctxt "konbini_exterior_eb0ab77a"
msgid "Je n'aime pas savoir que mon chéri souffre en silence sans m'en parler !"
msgstr "Aku nggak suka tau kalo pacar aku lagi menderita diam-diam tanpa cerita ke aku!"

#. Character:`asami` | Attributes:`upset`
msgctxt "konbini_exterior_efe54fcc"
msgid "Je n'aime pas savoir que mon meilleur ami souffre en silence sans m'en parler !"
msgstr "Aku nggak suka tau kalo sahabat aku lagi menderita diam-diam tanpa cerita ke aku!"

#. Character:`noriko`
msgctxt "konbini_exterior_91a539a7"
msgid "Viens a la maison, je pourrais te dire ce qu'on prévois de faire si ça t'intéresse."
msgstr "Datang ke rumah, aku bisa kasih tau apa yang mau kita lakuin kalau kamu tertarik."

#. Character:`saito` | Attributes:`sad`
msgctxt "konbini_exterior_c620ecad"
msgid "On...?"
msgstr "Kita...?"

#. Character:`asami` | Attributes:`neutral`
msgctxt "konbini_exterior_85dec372"
msgid "Bien sûr que je viens !"
msgstr "Tentu aku datang!"

#. Character:`saito` | Attributes:`sad`
msgctxt "konbini_exterior_4a6f0a42"
msgid "Pfff une fois de plus..."
msgstr "Pfff, lagi-lagi..."

#. Character:`asami`
msgctxt "konbini_exterior_007f7612"
msgid "[font_size=14]{{saito.n}} dépêche toi, on t'attend ![/font_size]"
msgstr "[font_size=14]{{saito.n}} cepetan, kita nunggu kamu![/font_size]"

#. Character:`saito` | Attributes:`surprised`
msgctxt "konbini_exterior_8fb2f30c"
msgid "Oui, j'arrive !"
msgstr "Iya, aku nyampe!"

#. Character:`sayuri`
msgctxt "konbini_exterior_8982bdba"
msgid "[font_size=14]Ca fera 1500¥...[/font_size]"
msgstr "[font_size=14]Totalnya 1500¥...[/font_size]"

#. Character:`sayuri`
msgctxt "konbini_exterior_dcbabbe8"
msgid "[font_size=14]Hey... Vous n'av-[/font_size]"
msgstr "[font_size=14]Hei... Kalian nggak sem-"

#. Character:`nobu`
msgctxt "konbini_exterior_d9b82a80"
msgid "[font_size=14]Qu'est-ce que tu comptes faire la vieille ?![/font_size]"
msgstr "[font_size=14]Apa yang kamu mau lakuin, nenek tua?![/font_size]"

#. Character:`nobu`
msgctxt "konbini_exterior_34736219"
msgid "[font_size=14]Tu comptes appeler les flics pour si peu ?[/font_size]"
msgstr "[font_size=14]Kamu mau nelpon polisi cuma gara-gara hal sepele gitu?[/font_size]"

#. Character:`sayuri`
msgctxt "konbini_exterior_bc9811ac"
msgid "[font_size=14]Tu vas voir si je...[/font_size]"
msgstr "[font_size=14]Kamu bakal liat nih kalo aku...[/font_size]"

#. Character:`nobu`
msgctxt "konbini_exterior_b32d0c10"
msgid "[font_size=14]Allez a plus la vieille ![/font_size]"
msgstr "[font_size=14]Oke, ketemu lagi ya, tua bangka![/font_size]"

#. Character:`sayuri`
msgctxt "konbini_exterior_b0a2b2d1"
msgid "[font_size=14]Non ! Reviens ici petit c-[/font_size]"
msgstr "[font_size=14]Nggak! Balik sini bocah c-[/font_size]"

#. Character:`nobu`
msgctxt "konbini_exterior_c70a2c8a"
msgid "Ahah... Rien de tel que de manger à l'œil !"
msgstr "Ahah... Gak ada yang ngalahin makan gratis!"

#. Character:`nobu`
msgctxt "konbini_exterior_6bca033e"
msgid "Allez... assez traîner."
msgstr "Ayo... cukup ngabisin waktu."

#. Character:`noriko`
msgctxt "konbini_exterior_c412f2de"
msgid "Ça va être à toi de jouer, j'espère que tu es déterminé ?"
msgstr "Sekarang giliran kamu, aku harap kamu bener-bener niat?"

#. Character:`saito`
msgctxt "konbini_exterior_25a3d31e"
msgid "Ne t'inquiète pas... Je n'ai qu'une envie c'est de lui faire bouffer ses dents !"
msgstr "Santai aja... Aku cuma pengen bikin dia gigit jari sendiri!"

#. Character:`noriko` | Attributes:`bad`
msgctxt "konbini_exterior_aa21a1f9"
msgid "Parfait !"
msgstr "Sempurna!"

#. Character:`sayuri`
msgctxt "konbini_exterior_8a2e49fd"
msgid "Oh {{saito.n}}, {{noriko.n}} vous êtes là ?"
msgstr "Oh {{saito.n}}, {{noriko.n}} kalian di sini ya?"

#. Character:`sayuri`
msgctxt "konbini_exterior_3acd6217"
msgid "Vous n'auriez pas vu passer un garçon aux cheveux décolorés ?"
msgstr "Kalian nggak liat bocah rambutnya di-bleach lewat nggak?"

#. Character:`noriko`
msgctxt "konbini_exterior_f1fe3103"
msgid "{{saito.n}} va s'en occuper !"
msgstr "{{saito.n}} bakal urus ini!"

#. Character:`sayuri` | Attributes:`surprised`
msgctxt "konbini_exterior_e3bc9868"
msgid "Quoi ?! Vous êtes sûrs ? Ne vous mettez pas en danger pour si peu."
msgstr "Apa?! Kamu yakin? Jangan sampe kamu bahaya cuma gara-gara hal sepele."

#. Character:`saito`
msgctxt "konbini_exterior_102e657f"
msgid "Ce gamin a juste besoin qu'on lui enseigne le respect."
msgstr "Anak itu cuma butuh diajarin sopan santun."

#. Character:`saito`
msgctxt "konbini_exterior_561fc26a"
msgid "Je te rapporterai ce qu'il te doit."
msgstr "Aku bakal bawa apa yang dia hutangin ke kamu."

#. Character:`noriko`
msgctxt "konbini_exterior_c874740b"
msgid "C'est bon tu en as terminé ?"
msgstr "Udah, kamu udahan?"

#. Character:`saito` | Attributes:`happy`
msgctxt "konbini_exterior_a1a1685c"
msgid "Oui... Soit compréhensive, elle s'inquiétait."
msgstr "Iya... Sabar ya, dia khawatir."

#. Character:`noriko`
msgctxt "konbini_exterior_6112cdbb"
msgid "C'est bientôt terminé de toute façon..."
msgstr "Sebentar lagi juga kelar kok..."

#. Character:`saito`
msgctxt "konbini_exterior_cc88fd33"
msgid "Je sais...[w] Alors où va-t-on ?"
msgstr "Aku tau...[w] Jadi kita mau kemana?"

#. Character:`noriko` | Attributes:`shame`
msgctxt "konbini_exterior_ee1c7189"
msgid "Tu vas à cette adresse, je te rejoins après j'ai un truc à faire !"
msgstr "Kamu ke alamat ini, aku nyusul abis itu aku ada urusan!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "konbini_exterior_f12e4980"
msgid "Mais ! C'est à côté de..."
msgstr "Tapi! Itu deket sama..."

#. Character:`saito`
msgctxt "JE_PENSE_QU_AVEC_A_ON_A_COUVER_893FB8"
msgid "Je pense qu'avec ça, on a couvert à peu près toute la ville."
msgstr "Aku rasa dengan ini, kita udah nutup hampir seluruh kota."

#. Character:`noriko`
msgctxt "IL_NE_MANQUE_PLUS_QU_EN_METTRE_9E8C4F"
msgid "Il ne manque plus qu'à en mettre ici..."
msgstr "Tinggal taruh di sini aja..."

#. Character:`saito`
msgctxt "ENTRONS_UN_MOMENT_J_AIMERAIS_P_49BA7F"
msgid "Entrons un moment... J'aimerais prendre de ses nouvelles."
msgstr "Masuk sebentar... Aku pengen tahu kabarnya."

#. Character:`noriko`
msgctxt "ALORS_DAC7C8"
msgid "Alors ?"
msgstr "Jadi gimana?"

#. Character:`saito`
msgctxt "JE_RESTERAI_AVEC_ELLE_CETTE_NU_8A8B24"
msgid "Je resterai avec elle cette nuit."
msgstr "Aku bakal nemenin dia malam ini."

#. Character:`saito`
msgctxt "ELLE_NE_VEUT_ABSOLUMENT_PAS_SE_6E6753"
msgid "Elle ne veut absolument pas se retrouver seule avec ses pensées."
msgstr "Dia sama sekali nggak mau sendirian sama pikirannya."

#. Character:`noriko` | Attributes:`shame`
msgctxt "OUI_JE_COMPRENDS_0760B6"
msgid "Oui, je comprends..."
msgstr "Iya, aku ngerti..."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "QU_ALLONS_NOUS_FAIRE_DEMAIN_574AE8"
msgid "Qu'allons-nous faire demain ?"
msgstr "Besok kita ngapain ya?"

#. Character:`saito`
msgctxt "JE_NE_SAIS_PAS_J_AI_BESOIN_D_Y_5ADFBB"
msgid "Je ne sais pas... J'ai besoin d'y réfléchir..."
msgstr "Aku nggak tahu... Butuh mikir dulu..."

#. Character:`sayuri`
msgctxt "C_EST_BON_RENTRONS_JE_SUIS_PUI_0FD991"
msgid "C'est bon... Rentrons, je suis épuisée !"
msgstr "Oke... Pulang aja, aku capek banget!"

#. Character:`noriko` | Attributes:`cute`
msgctxt "DEMAIN_DANS_CE_CAS_FF72D6"
msgid "À demain dans ce cas !"
msgstr "Sampai besok ya!"

#. Character:`sayuri`
msgctxt "JE_SUIS_D_SOL_E_TU_AVAIS_PEUT_003BA3"
msgid "Je suis désolée, tu avais peut-être prévu quelque chose ?"
msgstr "Maaf ya, kamu mungkin ada rencana apa gitu?"

#. Character:`saito` | Attributes:`happy`
msgctxt "NON_TU_PASSES_AVANT_TOUT_LE_RE_6F15DE"
msgid "Non, tu passes avant tout le reste !"
msgstr "Nggak, kamu yang utama sebelum semuanya!"

#. Character:`sayuri` | Attributes:`moved`
msgctxt "C_EST_SI_GENTIL_SI_SEULEMENT_B33B01"
msgid "... C'est si gentil... si seulement... si seulement ma petite chérie n'était pas..."
msgstr "... Keren banget... andai aja... andai aja pacarku nggak..."

#. Character:`saito`
msgctxt "ALLEZ_VIENS_RENTRONS_161AAA"
msgid "Allez, viens, rentrons..."
msgstr "Ayo, sini, kita pulang..."

#. Character:`sakuya` | Attributes:`bored`
msgctxt "IL_EST_TRANGEMENT_LONG_C732A7"
msgid "Il est étrangement long."
msgstr "Ini anehnya lama banget."

#. Character:`saito`
msgctxt "OUI_CE_N_EST_PAS_NORMAL_836E06"
msgid "Oui, ce n'est pas normal."
msgstr "Iya, ini nggak normal."

#. Character:`master`
msgctxt "MOI_A_ME_DONNE_SOIF_TOUT_A_F8A637"
msgid "Moi, ça me donne soif tout ça !"
msgstr "Aku jadi haus banget nih gara-gara semua ini!"

#. Character:`saito`
msgctxt "S_IL_VOUS_PLA_T_LES_ENJEUX_SON_2CA536"
msgid "S'il vous plaît, les enjeux sont importants, ne gâchez pas tout."
msgstr "Tolong, ini penting, jangan sampai rusak semuanya."

#. Character:`saito`
msgctxt "CE_TYPE_EST_CAPABLE_DU_PIRE_IL_714B7E"
msgid "Ce type est capable du pire, il..."
msgstr "Orang ini bisa ngelakuin hal terburuk, dia..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "OH_NON_EE79AC"
msgid "Oh non !"
msgstr "Oh nggak!"

#. Character:`sakuya` | Attributes:`sad`
msgctxt "UN_PROBL_ME_MON_AMOUR_358B4E"
msgid "Un problème, mon amour ?"
msgstr "Ada masalah, sayang?"

#. Character:`saito` | Attributes:`upset`
msgctxt "IL_NE_PARLAIT_PAS_D_ASAMI_N_21AB41"
msgid "Il ne parlait pas d'{{asami.n}} !"
msgstr "Dia nggak ngomongin {{asami.n}}!"

#. Character:`saito`
msgctxt "JE_DOIS_INTERVENIR_ET_VITE_8E5FD0"
msgid "Je dois intervenir, et vite."
msgstr "Aku harus turun tangan, dan cepet."

#. Character:`cop`
msgctxt "JE_PASSE_MON_TEMPS_322D94"
msgid "... je passe mon temps à..."
msgstr "... aku terus-terusan..."

#. Character:`cop` | Attributes:`bad`
msgctxt "J_EN_TAIS_S_R_TOUJOURS_TOI_BB2272"
msgid "J'en étais sûr, toujours toi !"
msgstr "Aku yakin, selalu kamu!"

#. Character:`saito` | Attributes:`upset`
msgctxt "IL_Y_A_UN_PROBL_ME_DCF5F1"
msgid "Il y a un problème ?"
msgstr "Ada masalah apa?"

#. Character:`cop`
msgctxt "NE_FAIS_PAS_LE_MALIN_PARTOUT_O_EC12D1"
msgid "Ne fais pas le malin, partout où je vais, je tombe sur toi."
msgstr "Jangan sok pintar, kemana-mana aku selalu ketemu kamu."

#. Character:`saito`
msgctxt "PROBABLEMENT_PARCE_QUE_J_HABIT_915E7C"
msgid "Probablement parce que j'habite dans le coin ?"
msgstr "Mungkin soalnya aku tinggal di sekitar sini?"

#. Character:`cop` | Attributes:`disgusted`
msgctxt "ET_TU_RECOMMENCE_CETTE_AFFAIRE_0A23FD"
msgid "Et tu recommence... Cette affaire a beau être réglée, je suis sûr que tu caches quelque chose de suspect !"
msgstr "Dan kamu mulai lagi... Urusan ini udah kelar, tapi aku yakin kamu nyimpen sesuatu yang mencurigakan!"

#. Character:`sayuri` | Attributes:`upset`
msgctxt "COMMENT_A_R_GL_E_VOUS_N_ALLEZ_187669"
msgid "Comment ça, réglée ?! Vous n'allez rien faire pour retrouver ma fille ?!"
msgstr "Maksud kamu, kelar?! Kamu nggak bakal ngelakuin apa-apa buat nyari anak aku?!"

#. Character:`cop` | Attributes:`neutral`
msgctxt "TCHH_MADAME_S_IL_VOUS_PLA_T_LA_A95734"
msgid "Tchh... Madame... s'il vous plaît, laissez-nous faire notre travail, et je ne vous dirai pas comment faire le vôtre !"
msgstr "Tchh... Nyonya... tolong, biarin kami kerja, dan aku nggak bakal bilang gimana cara kamu ngurus urusan kamu!"

#. Character:`cop` | Attributes:`angry`
msgctxt "LA_PROCHAINE_FOIS_JE_VOUS_EMBA_AC2BCD"
msgid "La prochaine fois, je vous embarque pour outrage !"
msgstr "Lain kali, aku bakal bawa kamu gara-gara menghina!"

#. Character:`saito` | Attributes:`angry`
msgctxt "BORDEL_B4DC27"
msgid "... Bordel !"
msgstr "... Sialan!"

#. Character:`master` | Attributes:`sad`
msgctxt "JE_N_AI_JAMAIS_VU_UN_TYPE_AUSS_BEAEF8"
msgid "Je n'ai jamais vu un type aussi collant et désagréable..."
msgstr "Aku belum pernah liat cowok yang nyebelin dan nempel banget kayak gini..."

#. Character:`sakuya` | Attributes:`sad`
msgctxt "IL_NOUS_A_RETENUS_ICI_NOUS_N_A_A497BE"
msgid "Il nous a retenus ici, nous n'avons pas pu continuer à suivre notre cible..."
msgstr "Dia nahan kita di sini, kita nggak bisa terus ngikutin target kita..."

#. Character:`saito`
msgctxt "SAYURI_N_NOUS_L_AVONS_PERDU_D_335A48"
msgid "{{sayuri.n}}... nous l'avons perdu de vue malheureusement. Je dois faire le point avec les autres... Je te tiens au courant."
msgstr "{{sayuri.n}}... sayangnya kita kehilangan jejak dia. Aku harus koordinasi sama yang lain... Nanti aku kabarin kamu."

#. Character:`sayuri` | Attributes:`sad`
msgctxt "JE_VOUS_EN_SUPPLIE_FAITES_ATTE_AEFBE3"
msgid "Je vous en supplie, faites attention à vous !"
msgstr "Tolong, hati-hati ya!"

#. Character:`sayuri`
msgctxt "MHHH_C_EST_PLUT_T_CALME_CE_SOI_7DC7DA"
msgid "Mhhh... C'est plutôt calme ce soir."
msgstr "Mhhh... Malam ini cukup tenang."

#. Character:`sayuri`
msgctxt "C_EST_TRANGE_JE_NE_VOIS_PLUS_L_BE0BCF"
msgid "C'est étrange, je ne vois plus l'agent. Il n'était pas censé rester ?"
msgstr "Aneh, aku nggak liat agen itu lagi. Dia nggak seharusnya tetep di sini?"

#. Character:`sayuri`
msgctxt "EN_FAIT_NON_C_EST_PLUT_T_BIEN_C8513A"
msgid "En fait non... C'est plutôt bien, ça faisait fuir les clients."
msgstr "Sebenarnya nggak... Itu malah bagus, soalnya dia bikin pelanggan kabur."

#. Character:`netoru`
msgctxt "QUELLE_BELLE_SOIR_E_N_EST_CE_P_BBABC0"
msgid "Quelle belle soirée, n'est-ce pas ?"
msgstr "Malam yang indah, ya kan?"

#. Character:`sayuri`
msgctxt "VOUS_A02DC4"
msgid "Vous !"
msgstr "Lu!"

#. Character:`netoru` | Attributes:`bad`
msgctxt "MAIS_PAS_AUSSI_BELLE_QUE_QUE_L_BDD3DD"
msgid "Mais pas aussi belle que que la personne qui se trouve devant moi."
msgstr "Tapi nggak secantik orang yang ada di depan aku."

#. Character:`netoru`
msgctxt "UNE_MAGNIFIQUE_FEMME_COMME_VOU_4A9C76"
msgid "Une magnifique femme comme vous, qui se balade seule..."
msgstr "Wanita cantik kayak kamu, jalan sendirian..."

#. Character:`sayuri` | Attributes:`upset`
msgctxt "NE_VOUS_APPROCHEZ_PAS_SINON_5DACA9"
msgid "Ne vous approchez pas, sinon..."
msgstr "Jangan deketin, ntar..."

#. Character:`netoru` | Attributes:`arrogant`
msgctxt "SINON_QUOI_D905C1"
msgid "Sinon quoi ?"
msgstr "Ntar apa?"

#. Character:`sayuri`
msgctxt "JE_SAIS_QUE_VOUS_TES_DERRI_RE_47355D"
msgid "Je sais que vous êtes derrière l'enlèvement de ma fille !"
msgstr "Aku tau kamu yang ada di balik penculikan anak aku!"

#. Character:`netoru` | Attributes:`neutral`
msgctxt "OH_VRAIMENT_ET_QU_EST_CE_QUE_V_C73FCF"
msgid "Oh, vraiment ? Et qu'est-ce que vous savez exactement ?"
msgstr "Oh, beneran? Terus kamu tau apa tepatnya?"

#. Character:`sayuri`
msgctxt "VOUS_AVEZ_FAIT_PORTER_LE_CHAPE_13DEF7"
msgid "Vous avez fait porter le chapeau à des innocents et..."
msgstr "Kamu nyuruh orang nggak bersalah buat disalahin dan..."

#. Character:`netoru`
msgctxt "PARFAIT_LE_FAIT_QUE_VOUS_EN_SA_719065"
msgid "Parfait ! Le fait que vous en sachiez autant va nous faire gagner du temps."
msgstr "Bagus! Kamu tau banyak, ini bakal ngiritin waktu kita."

#. Character:`netoru` | Attributes:`bad`
msgctxt "VENEZ_JE_VAIS_VOUS_RACCOMPAGNE_568B78"
msgid "Venez, je vais vous raccompagner chez vous !"
msgstr "Ayo, aku antar kamu pulang!"

#. Character:`sayuri`
msgctxt "NE_M_APPROCHEZ_PAS_JE_VAIS_APP_4CBB26"
msgid "Ne m'approchez pas, je vais appeler la police !"
msgstr "Jangan deketin aku, aku bakal nelpon polisi!"

#. Character:`netoru`
msgctxt "MAIS_FAITES_DONC_MAIS_QU_EST_C_90B18E"
msgid "Mais faites donc... Mais qu'est-ce qui arriverait à votre fille dans ce cas ?"
msgstr "Ya udah deh... Tapi gimana kalau anak cewek kamu gimana nanti?"

#. Character:`netoru`
msgctxt "FINIRAIT_ELLE_PAR_MOURIR_DE_FA_C739AB"
msgid "Finirait-elle par mourir de faim dans une cave, sans jamais personne pour venir l'aider ?"
msgstr "Apa dia bakal mati kelaparan di gudang, nggak ada yang dateng nolongin dia?"

#. Character:`sayuri` | Attributes:`surprised`
msgctxt "VOUS_N_OSERIEZ_PAS_D658F4"
msgid "Vous n’oseriez pas..."
msgstr "Kamu nggak akan berani..."

#. Character:`netoru` | Attributes:`neutral`
msgctxt "JE_SUIS_CE_GENRE_D_HOMME_MADAM_B88393"
msgid "Je suis ce genre d’homme, madame. Celui qui fait ce qu’il faut... pour obtenir ce qu’il veut."
msgstr "Aku tipe cowok kayak gitu, Bu. Yang ngelakuin apa aja... buat dapetin apa yang dia pengen."

#. Character:`sayuri` | Attributes:`upset`
msgctxt "VOUS_N_TES_PAS_UN_HOMME_JUSTE_6DF462"
msgid "Vous n’êtes pas un homme... Juste un monstre."
msgstr "Kamu bukan cowok... Cuma monster doang."

#. Character:`netoru` | Attributes:`angry`
msgctxt "ALLEZ_TENEZ_VOUS_TRANQUILLE_PE_BE6160"
msgid "Allez, tenez-vous tranquille pendant que nous rentrons tous les deux... chez vous."
msgstr "Ayo, tenang aja dulu pas kita pulang bareng... ke rumah kamu."

#. Character:`sakuya`
msgctxt "tc5d284db8d"
msgid "[next]"
msgstr "[next]"

#. Character:`sakuya` | Attributes:`blush`
msgctxt "talk_sakuya_a1cda1d4"
msgid "Oh, toi alors..."
msgstr "Ah, kamu nih..."

#. Character:`narrator`
msgctxt "t803acfc2d4"
msgid "Sexe"
msgstr "Sex"

#. Character:`narrator`
msgctxt "td3e9c852cb"
msgid "Quitter la chambre"
msgstr "Keluar dari kamar"

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_sexe_f291607d"
msgid "Je me demandais quand est-ce que tu viendrais réclamer mon corps..."
msgstr "Aku sempet kepikiran kapan sih kamu bakal dateng minta badan aku..."

#. Character:`saito`
msgctxt "restaurant_sakuya_room_sexe_31aeeb84"
msgid "Tu sais que tu étais pas obligée de m'attacher."
msgstr "Kamu tau kan, kamu sebenernya nggak harus ngebelenggu aku."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_sexe_147b48ea"
msgid "Je le sais, mais..."
msgstr "Aku tahu, tapi..."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_sexe_960c894f"
msgid "Je trouve ça terriblement plus excitant ainsi."
msgstr "Aku rasa ini jauh lebih bikin gairah gitu."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_sexe_7ac56254"
msgid "Je constate que tu sembles aussi apprécier ma façon de faire."
msgstr "Aku lihat kamu juga kayaknya suka cara aku ngelakuinnya."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_sexe_04b8f2f1"
msgid "Je te l'ai dit, ton corps est toujours honnête au moins."
msgstr "Udah aku bilang, tubuh kamu paling jujur sih."

#. Character:`saito`
msgctxt "restaurant_sakuya_room_sexe_03775ec8"
msgid "..."
msgstr "..."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_sexe_0dbfad7f"
msgid "Mon amour, tu peux venir en moi."
msgstr "Sayang, kamu boleh masuk ke aku."

#. Character:`saito`
msgctxt "restaurant_sakuya_room_sexe_2925e026"
msgid "La dernière fois, tu m'as dit que..."
msgstr "Terakhir kali, kamu bilang kalau..."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_sexe_5cf4409b"
msgid "Shhht... Ne gâche pas ce moment."
msgstr "Shhht... Jangan ganggu momen ini."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_sexe_dfcf97e4"
msgid "Alors ?"
msgstr "Jadi gimana?"

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_sexe_b4d187c0"
msgid "Prêt à recommencer ou tu veux faire autre chose ?"
msgstr "Siap mulai lagi atau mau ngelakuin yang lain?"

#. Character:`narrator`
msgctxt "ta9b8f21bce"
msgid "Recommencer"
msgstr "Ulangi"

#. Character:`narrator`
msgctxt "ta57dc8629a"
msgid "Partir"
msgstr "Pergi"

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_bef3fdb6"
msgid "Tu peux ouvrir les yeux à présent..."
msgstr "Kamu boleh buka mata sekarang..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "restaurant_sakuya_room_e294cd55"
msgid "... Put-"
msgstr "... Sial-"

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_ddef315b"
msgid "Ça te plaît ?"
msgstr "Kamu suka nggak?"

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_2f374f04"
msgid "Comme ça, peu importe la direction dans laquelle je regarde, mon regard est toujours tourné vers toi."
msgstr "Jadi, gak peduli ke arah mana aku liat, pandanganku selalu tertuju ke kamu."

#. Character:`narrator`
msgctxt "restaurant_sakuya_room_48c5c003"
msgid "Oh putain... Elle est complètement cinglée."
msgstr "Sialan... Dia bener-bener gila."

#. Character:`narrator`
msgctxt "restaurant_sakuya_room_8c53f326"
msgid "Je ne pensais pas que c'était à ce point-là."
msgstr "Aku gak nyangka sampe segitunya."

#. Character:`narrator`
msgctxt "restaurant_sakuya_room_17a6d847"
msgid "Il faut absolument que je me tire d'ici !"
msgstr "Aku harus banget cabut dari sini!"

#. Character:`narrator`
msgctxt "restaurant_sakuya_room_d01bd3ae"
msgid "Non, ça suffira pas, elle me suivra et s'en prendra à mes proches."
msgstr "Gak cukup cuma itu, dia bakal ngikutin aku dan nyerang orang-orang deket aku."

#. Character:`narrator`
msgctxt "restaurant_sakuya_room_b8bdc75d"
msgid "Je dois prévenir la police !"
msgstr "Aku harus laporin polisi!"

#. Character:`saito`
msgctxt "restaurant_sakuya_room_0a4fa997"
msgid "Écoute tout ça, c'est magnifique -bien qu'un peu terrifiant- mais je dois partir à présent."
msgstr "Dengerin semua ini, keren banget - meskipun agak serem - tapi aku harus pergi sekarang."

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_sakuya_room_6228ca4e"
msgid "Ma famille va s'inquiéter et... j'avoue que je ne me sens pas très à l'aise de voir ma tête partout."
msgstr "Keluarga aku bakal khawatir dan... jujur aku gak nyaman liat muka aku ada di mana-mana."

#. Character:`sakuya` | Attributes:`angry`
msgctxt "restaurant_sakuya_room_f3b54cd9"
msgid "Tu n'iras nulle part."
msgstr "Kamu gak bakal kemana-mana."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_c7d9eb6c"
msgid "Tu vas rester ici encore quelque temps."
msgstr "Kamu bakal tetap di sini beberapa waktu lagi."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_3f432874"
msgid "Je ne te demande pas ton avis mon chéri..."
msgstr "Aku gak minta pendapat kamu, sayang..."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_54076623"
msgid "Et, je te conseille de m'obéir sans discuter."
msgstr "Dan, aku saranin kamu nurutin aku tanpa debat."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_a79d0213"
msgid "Ton ex est venue fouiner dans le coin avec une autre fille !"
msgstr "Mantan kamu dateng ngintip di sekitar sama cewek lain!"

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_0142393c"
msgid "Ton ex-amie est venue fouiner dans le coin avec une autre fille !"
msgstr "Temen mantan kamu dateng ngintip di sekitar sama cewek lain!"

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_2f4dc83a"
msgid "Je me suis retenue de leur faire du mal... Parce que je t'aime et que je ne veux pas que tu me détestes."
msgstr "Aku nahan diri buat gak nyakitin mereka... Soalnya aku sayang sama kamu dan gak mau kamu benci aku."

#. Character:`saito` | Attributes:`upset`
msgctxt "restaurant_sakuya_room_7965e7fa"
msgid "{{sakuya.n}}, tu auras beau me menacer, ça ne changera rien à ce que je pense."
msgstr "{{sakuya.n}}, kamu bisa aja ngancem aku, tapi itu gak bakal ngubah apa yang aku pikirin."

#. Character:`saito`
msgctxt "restaurant_sakuya_room_05ce8aac"
msgid "Il n'y a aucun moyen que je puisse t'aimer si tu me menaces, moi, ma famille et les gens auxquels je tiens !"
msgstr "Gak ada cara aku bisa sayang sama kamu kalo kamu ngancem aku, keluarga aku, dan orang-orang yang aku sayang!"

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "restaurant_sakuya_room_1b8066e2"
msgid "C'est ce que nous verrons..."
msgstr "Itu yang bakal kita liat nanti..."

#. Character:`narrator`
msgctxt "tf2c0bcecad"
msgid "Je refuse."
msgstr "Aku nolak."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "restaurant_sakuya_room_5a2ed1cc"
msgid "Le temps que ton ex arrête de te chercher partout en ville."
msgstr "Sampai mantan kamu berhenti nyari kamu kemana-mana di kota."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "restaurant_sakuya_room_6f285784"
msgid "Le temps que ton ex-amie arrête de te chercher partout en ville"
msgstr "Sambil nunggu mantan cewekmu berhenti nyariin kamu ke mana-mana di kota"

#. Character:`saito` | Attributes:`surprised`
msgctxt "restaurant_sakuya_room_4356639c"
msgid "Quoi ?! {{asami.n}} est en train de me chercher ?"
msgstr "Apa?! {{asami.n}} lagi nyari aku ya?"

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_a41e60b7"
msgid "Oublie cette fille, n'oublie pas que tu l'as trahie !"
msgstr "Lupain cewek itu, jangan lupa kamu udah ngkhianatin dia!"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "restaurant_sakuya_room_c74d0ad6"
msgid "Continue d'obéir bien sagement et il ne lui arrivera rien."
msgstr "Terus aja nurut baik-baik, dan dia nggak bakal kenapa-napa."

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_sakuya_room_e740c983"
msgid "Tu ne pourras pas me retenir indéfiniment, {{sakuya.n}} !"
msgstr "Kamu nggak bakal bisa nahan aku terus, {{sakuya.n}}!"

#. Character:`saito`
msgctxt "restaurant_sakuya_room_e4b2deee"
msgid "Même ton père se rendra compte de quelque chose au bout d'un moment !"
msgstr "Bahkan bapakmu juga bakal sadar sesuatu setelah beberapa lama!"

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_5a0804a7"
msgid "Il ne se mêle pas de mes affaires."
msgstr "Dia nggak ikut campur urusan aku."

#. Character:`sakuya`
msgctxt "restaurant_sakuya_room_2862a80c"
msgid "Maman y veille personnellement !"
msgstr "Mama yang ngurusin itu langsung!"

#. Character:`narrator`
msgctxt "te4fec99998"
msgid "Combien de temps encore ?"
msgstr "Berapa lama lagi ya?"

#. Character:`saito` | Attributes:`sad`
msgctxt "restaurant_sakuya_room_a4f74538"
msgid "S'il te plaît {{sakuya.n}}, arrête ça..."
msgstr "Tolong deh {{sakuya.n}}, berhenti dong..."

