msgstr "Beda sama {{sayuri.n}} nih!"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "t80a3ca40f4"
msgid "Explique moi en quoi ?"
msgstr "Jelasin dong kenapa?"

#. Character:`saito`
msgctxt "tb8fa6ebdf8"
msgid "Elle est mariée !"
msgstr "Dia udah nikah!"

#. Character:`noriko` | Attributes:`afraid`
msgctxt "t186315ea49"
msgid "Quoi ?! C'est tout ?"
msgstr "Apa?! Cuma itu doang?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t5591db1c51"
msgid "Et bien quoi ?"
msgstr "Terus kenapa?"

#. Character:`noriko` | Attributes:`bad`
msgctxt "t40fb58d7df"
msgid "Tu penses que le fait qu'elle soit mariée la rend intouchable ?"
msgstr "Kamu pikir dia nikah bikin dia nggak bisa disentuh?"

#. Character:`noriko`
msgctxt "t4f5f8fc6c2"
msgid "Oh tu es si naïf parfois..."
msgstr "Duh, kamu kadang polos banget..."

#. Character:`saito` | Attributes:`upset`
msgctxt "t144d043333"
msgid "Je ne suis pas assez fou pour tenter quoi que ce soit avec la mère de ma petite amie !"
msgstr "Aku nggak cukup gila buat nyoba apa-apa sama ibu cewek aku!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "t572d2fd329"
