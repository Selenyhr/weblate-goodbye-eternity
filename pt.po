msgstr ""

#. Character:`natsume`
#: game/story/home_player_exterior.dialogue
msgctxt "MAIS_C_EST_LE_CONTRAIRE_785B8D"
msgid "Mais c'est le contraire."
msgstr ""

#. Character:`natsume` | Attributes:`neutral`
#: game/story/home_player_exterior.dialogue
msgctxt "NE_FAIS_PAS_N_IMPORTE_QUOI_SAI_5DA00D"
msgid "Ne fais pas n'importe quoi, {{saito.n}}, tu as bien trop à perdre à présent."
msgstr ""

#. Character:`natsume` | Attributes:`happy`
#: game/story/home_player_exterior.dialogue
msgctxt "ALLEZ_RESTE_SAGE_D_ICI_L_ET_PE_CAC03B"
msgid "Allez, reste sage d'ici là et peut-être qu'on aura la chance de se recroiser, qui sait !"
msgstr ""

#. Character:`saito` | Attributes:`upset`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_70c72a3d"
msgid "Merde... Personne... Est-ce qu'ils sont déjà à l'intérieur ?"
msgstr "Merda... Ninguém... Será que eles já estão lá dentro?"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_c6a80c2f"
msgid "Putain, aucun moyen de le savoir."
msgstr "Porra, não tem como saber."

#. Character:`saito` | Attributes:`surprised`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_2f0a0a01"
msgid "Une seconde...[w] C'est...[w] {{kimochi.n}} ?"
msgstr "Espera um segundo...[w] Aquele é...[w] o {{kimochi.n}}?"

#. Character:`kimochi`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_50762b84"
msgid "Oh salut {{saito.n}}, toi aussi, tu traines en ville la nuit ?"
msgstr "Ah, oi {{saito.n}}! Você também fica vadiando pela cidade à noite?"

#. Character:`saito` | Attributes:`sad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_e0065b3f"
msgid "Pas vraiment, mais... Qu'est-ce que tu fais ici exactement ?"
msgstr "Não exatamente, mas... o que você está fazendo aqui, afinal?"

#. Character:`kimochi`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_81a0093f"
msgid "...Si c'est toi, je veux bien te le dire."
msgstr "...Já que é você, eu não me importo de contar."

#. Character:`kimochi` | Attributes:`horny`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_3532ed51"
msgid "Je prends en photo les couples qui vont au love hôtel."
msgstr "Eu tiro fotos dos casais que entram no love hotel."

#. Character:`kimochi`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_d2db3ccb"
msgid "Ça pourrait être utile comme moyen de pression."
msgstr "Pode ser útil como chantagem mais tarde."

#. Character:`saito` | Attributes:`surprised`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_9912113c"
msgid "Donc... Tu fais ça pour faire chanter les gens ?"
msgstr "Então... você faz isso para extorquir as pessoas?"

#. Character:`kimochi` | Attributes:`frustrated`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_64949c29"
msgid "Seulement ceux qui me manquent de respect !"
msgstr "Só aquelas que me desrespeitam!"

#. Character:`saito` | Attributes:`sad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_25ac774f"
msgid "...[w] Peu importe, plus rien ne m'étonne avec toi."
msgstr "...[w] Tanto faz, nada mais me surpreende vindo de você."

#. Character:`saito` | Attributes:`neutral`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_80a47c9d"
msgid "Mais tu vas pouvoir m'aider à nouveau."
msgstr "Mas você vai poder me ajudar de novo."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_5cbdece1"
msgid "Est-ce que tu aurais vu un gros porc entrer avec une femme aux cheveux rouge ?"
msgstr "Por acaso você viu um porco gordo entrando com uma ruiva?"

#. Character:`kimochi` | Attributes:`think`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_55b426d5"
msgid "Tu vas devoir être plus précis, des gros porcs qui vont au love hôtel, c'est assez courant."
msgstr "Você vai ter que ser mais específico, porcos gordos indo para o love hotel são bem comuns por aqui."

#. Character:`saito` | Attributes:`upset`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_b6afbb9c"
msgid "Le patron du Coffee Boutique ! Le mec de l'autre jour que tu devais retenir."
msgstr "O dono da Cafeteria! Aquele cara do outro dia que você tinha que segurar."

#. Character:`kimochi` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_59191929"
msgid "Aaaah, {{netoru.n}} ? Oui, il est passé tout à l'heure."
msgstr "Aaaah, o {{netoru.n}}? Sim, ele passou por aqui faz pouco tempo."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_2c02998f"
msgid "Merde ! Est-ce qu'ils y sont entrés ?"
msgstr "Merda! E eles entraram lá?"

#. Character:`kimochi` | Attributes:`sad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_83d33d8c"
msgid "Ho du calme ![w] Non, lui semblait le vouloir en tout cas, mais elle n'était pas d'accord."
msgstr "Ei, calma aí![w] Não, ele bem que queria, mas ela não estava topando não."

#. Character:`kimochi` | Attributes:`think`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_2dde09ab"
msgid "Maintenant que j'y pense... Je comprends mieux pourquoi il voulait de la milf..."
msgstr "Parando para pensar... agora eu entendo por que ele queria tanto uma milf..."

#. Character:`kimochi`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_b6cf4a9c"
msgid "Au moins, il sait qu'il est moche."
msgstr "Pelo menos ele sabe que é feio."

#. Character:`kimochi`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_ee810677"
msgid "Après, il s'est énervé et a continué à lui coller aux basques."
msgstr "Depois ele ficou puto e continuou no pé dela."

#. Character:`kimochi` | Attributes:`neutral`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_819d5a23"
msgid "Visiblement, il ne voulait pas lâcher l'affaire."
msgstr "Pelo visto, ele não queria largar o osso de jeito nenhum."

#. Character:`saito` | Attributes:`angry`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_2e5fbab0"
msgid "Putain ! Dans quelle direction ?!"
msgstr "Porra! Em que direção?!"

#. Character:`kimochi`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_abed959b"
msgid "Je crois qu'elle se dirigeait vers le [color=yellow]konbini[/color]."
msgstr "Acho que ela estava indo em direção à [color=yellow]loja de conveniência[/color]."

#. Character:`saito` | Attributes:`upset`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_f8d43df4"
msgid "Parfait merci, je t'en devrais une !"
msgstr "Beleza, valeu! Te devo uma!"

#. Character:`kimochi`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_3a722e95"
msgid "Non, maintenant, tu m'en dois deux."
msgstr "Não, agora você me deve duas."

#. Character:`kimochi` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_ce09cca6"
msgid "Oh, mais... C'est mon ancien prof principal ça !"
msgstr "Ah, mas... aquele ali não é o meu antigo professor?!"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_e1250044"
msgid "Ça ne devrait plus être très loin."
msgstr "Não deve estar mais muito longe."

#. Character:`unknown`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_982abe80"
msgid "CHOPEZ-LE !"
msgstr "PEGA ELE!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_b37e98ac"
msgid "Put-"
msgstr "Por-"

#. Character:`nobu`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_a83d8eeb"
msgid "Personne dans le coin, attirez-le dans la ruelle à côté et défoncez-le !"
msgstr "Não tem ninguém por perto, arrasta ele para aquele beco ali do lado e quebra ele!"

#. Character:`centered`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_43843ac8"
msgid "{{saito.n}} se fit entrainer dans une ruelle sombre."
msgstr "{{saito.n}} foi arrastado para um beco escuro."

#. Character:`centered`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_8beb1479"
msgid "Les trois thugs le passèrent à tabac à long moment, avant de finalement récupérer son argent et de le laisser là."
msgstr "Os três marginais o espancaram por um bom tempo antes de finalmente levarem seu dinheiro e o deixarem jogado ali."

#. Character:`takeo` | Attributes:`mocking`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_7eba8098"
msgid "Ouhlala, mais c'est qu'il en avait des économies cet idiot !"
msgstr "Olha só, não é que esse otário tinha uma boa grana guardada!"

#. Character:`kenji` | Attributes:`bad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_80316393"
msgid "Mec, se balader avec tout son fric sur soi quand on est une putain de cible sur pattes."
msgstr "Cara, sair andando por aí com todo o seu dinheiro nos bolsos sendo um belo de um alvo ambulante..."

#. Character:`nobu` | Attributes:`bad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_d82c7b50"
msgid "Je t'avais dit que je finirais par t'avoir et c'est que le début !"
msgstr "Eu te disse que ia acabar te pegando, e isso é só o começo!"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_07c0f38a"
msgid "Rendez-moi... mon argent !"
msgstr "Devolvam... meu dinheiro!"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_55ebd0b0"
msgid "Vous n'avez pas le droit de..."
msgstr "Vocês não têm o direito de..."

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_628e4f27"
msgid "Oh, mais nous aussi, regarde comme je transpire !"
msgstr "Ah, mas nós temos sim, olha só como eu tô suando!"

#. Character:`kenji`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_bb9c0617"
msgid "Et moi regarde, je saigne des phalanges à force de te frapper, ça mérite bien un dédommagement."
msgstr "E olha eu, meus nós dos dedos estão sangrando de tanto te bater, isso sim merece uma compensação."

#. Character:`saito` | Attributes:`sad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`takeo` | Attributes:`disgusted`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_ce3a8fac"
msgid "Toujours rien à dire ?"
msgstr "Ainda não tem nada a dizer?"

#. Character:`nobu` | Attributes:`disgusted`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_6fb65c06"
msgid "Pff, laisse tomber cette loque."
msgstr "Pff, esquece esse lixo humano."

#. Character:`kenji`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_857b36ce"
msgid "Allez on s'arrache, je cramerai bien tout son fric aux arcades."
msgstr "Bora ralar, vou torrar a grana dele inteirinha no fliperama."

#. Character:`saito` | Attributes:`upset`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_d0b5b04d"
msgid "ATTENDEZ !"
msgstr "ESPEREM!"

#. Character:`takeo` | Attributes:`angry`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_a754ebdc"
msgid "Putain, mais t'en as pas eu assez ? Tu veux qu'on en remette une couche ?"
msgstr "Porra, você ainda não apanhou o bastante? Quer que a gente te quebre mais um pouco?"

#. Character:`saito` | Attributes:`angry`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_09d97f46"
msgid "Je vous jure qu'un jour... Vous allez me payer au centuple toutes ces humiliations."
msgstr "Eu juro que um dia... vocês vão me pagar cem vezes mais por todas essas humilhações."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_2300047a"
msgid "Et ce jour-là, il n'y aura aucun pardon."
msgstr "E nesse dia, não vai ter perdão nenhum."

#. Character:`takeo` | Attributes:`mocking`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_fa0e68f1"
msgid "HAHAHA !"
msgstr "HAHAHA!"

#. Character:`nobu` | Attributes:`bad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_8dc6d726"
msgid "Mais j'en peux plus..."
msgstr "Cara, eu não aguento..."

#. Character:`kenji` | Attributes:`bad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_ec75b4b4"
msgid "Dans ce cas, bonne chance."
msgstr "Sendo assim, boa sorte."

#. Character:`kenji`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_e1021b8c"
msgid "Allez dégage d'ici !"
msgstr "Agora dá o fora daqui!"

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_a1c9f3e9"
msgid "Ce putain de petit bâtard !"
msgstr "Aquele maldito pirralho!"

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_ceaa5e00"
msgid "Il va voir ce qu'il va voir !"
msgstr "Ele vai ver só uma coisa!"

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_24f6861d"
msgid "Ils sont finis ! FINI !!!"
msgstr "Eles estão fodidos! FODIDOS!!!"

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_a06ac8a0"
msgid "Avec tout ce que j'ai sur cette pute, j'ai de quoi la faire se prostituer jusqu'à la fin de sa vie !"
msgstr "Com tudo o que eu tenho contra essa puta, eu posso fazer ela se prostituir pelo resto da vida!"

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_6d703bc6"
msgid "Elle sera à moi d'une manière ou d'une autre."
msgstr "Ela vai ser minha de um jeito ou de outro."

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_14e3e045"
msgid "Quant à lui... Je vais le... le... je vais le tuer !"
msgstr "Quanto a ele... Eu vou... eu vou... eu vou matar ele!"

#. Character:`sakuya`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_ac7728e7"
msgid "Bonsoir, Mr. {{netoru.n}}, la nuit est magnifique, vous ne trouvez pas ?"
msgstr "Boa noite, senhor {{netoru.n}}, a noite está linda, não acha?"

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_71424ba2"
msgid "Mais t'es qui bordel ?"
msgstr "Mas quem caralhos é você?"

#. Character:`sakuya`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_98625ab4"
msgid "Je crois savoir que vous êtes friand de chantage."
msgstr "Eu fiquei sabendo que o senhor é fã de uma boa chantagem."

#. Character:`sakuya`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_0bd801ec"
msgid "Et que vous possédez un réel talent..."
msgstr "E que possui um verdadeiro talento para isso..."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_8d0ce918"
msgid "Et alors, tu veux quoi ? Un autographe ?"
msgstr "E daí, você quer o quê? Um autógrafo?"

#. Character:`sakuya`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_f654124f"
msgid "Je suis simplement venue vous avertir."
msgstr "Eu vim apenas avisá-lo."

#. Character:`netoru` | Attributes:`bad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_576b27a5"
msgid "M'avertir ? C'est la meilleure blague que j'ai entendue !"
msgstr "Me avisar? Essa é a piada mais engraçada que eu já ouvi!"

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_42bc640e"
msgid "La personne qui me fera plier sous la menace n'est pas encore née."
msgstr "A pessoa que vai me fazer ceder sob ameaça ainda nem nasceu."

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_555c56f1"
msgid "Oh, mais vous faites fausse route Mr. {{netoru.n}}, je ne suis pas venue pour vous menacer."
msgstr "Ah, mas o senhor está totalmente enganado, senhor {{netoru.n}}, eu não vim aqui para ameaçá-lo."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_b4df7b91"
msgid "Je préfère agir..."
msgstr "Eu prefiro agir..."

#. Character:`sakuya`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_6b782802"
msgid "D'ailleurs à ce sujet... Vous ne trouvez pas que cela sent le brulé ?"
msgstr "Inclusive, falando nisso... Você não está sentindo cheiro de queimado?"

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_8c9f230b"
msgid "Mais de quoi tu p-"
msgstr "Mas do que você está falan-"

#. Character:`sakuya`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_75967fc5"
msgid "Il me semblait pourtant avoir senti votre maison en train de bruler..."
msgstr "É que eu tive a leve impressão de sentir o cheiro da sua casa pegando fogo..."

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_93d8ae63"
msgid "Quoi ?!"
msgstr "O quê?!"

#. Character:`netoru`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_19c3ae76"
msgid "NOON NON NON NON NONNNNN"
msgstr "NÃO! NÃO! NÃO! NÃO! NÃOOOOOO!!!"

#. Character:`sakuya`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_30349a32"
msgid "Quelle infortune !"
msgstr "Que grande infortúnio!"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_5cb11a71"
msgid "Elle doit m'attendre à l'intérieur."
msgstr "Ela deve estar me esperando lá dentro."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_c3995d9b"
msgid "Je ferais mieux de me dépêcher."
msgstr "É melhor eu me apressar."

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_5d197fe8"
msgid "Te voilà enfin !"
msgstr "Até que enfim você apareceu!"

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_761b0bfe"
msgid "J'ai cru que tu baisserais les bras mais finalement te voilà."
msgstr "Achei que ia amarelar, mas no fim das contas, olha só você aqui."

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_64391a45"
msgid "Prête à passer la meilleure nuit de ta vie ?"
msgstr "Pronta para passar a melhor noite da sua vida?"

#. Character:`noriko`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_455dabce"
msgid "Je veux juste en finir au plus vite..."
msgstr "Eu só quero acabar logo com isso o quanto antes..."

#. Character:`akira` | Attributes:`upset`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_282138dd"
msgid "Ah non ! Ça ne fonctionne pas comme ça, tu va devoir y mettre du tien sinon je ne marche plus."
msgstr "Ah, não! Não é assim que a banda toca, você vai ter que se esforçar um pouquinho, senão eu caio fora."

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_026e1a29"
msgid "Je te l'ai déjà dit, ne me fais surtout pas perdre mon temps. J'ai bien mieux à faire et t'aider ne m'apporte absolument rien."
msgstr "Eu já te disse, não me faça perder tempo. Tenho coisas muito melhores para fazer e te ajudar não me traz absolutamente nada de bom."

#. Character:`noriko` | Attributes:`shame`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_241d2dc2"
msgid "... D'accord j-"
msgstr "... Tudo bem, eu-"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_cb0e5e00"
msgid "Éloigne-toi de cette ordure {{noriko.n}} !"
msgstr "Fica longe dessa escória, {{noriko.n}}!"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_4a1f7887"
msgid "Quoi ! Mais... Qu'est-ce que tu fais ?! Ça ne te concerne pas !"
msgstr "O quê! Mas... o que você está fazendo aqui?! Isso não é da sua conta!"

#. Character:`noriko`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_f9cac87d"
msgid "Laisse-moi tranquille."
msgstr "Me deixa em paz."

#. Character:`akira` | Attributes:`angry`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_d3e7541f"
msgid "... Dégage... dé-déchet ! Sinon... Je.."
msgstr "... Cai fora... seu fra-fracassado! Senão... eu..."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_419020d5"
msgid "{{noriko.n}} maintenant ça suffit, tu vas me laisser t'aider que tu le veuilles ou non."
msgstr "{{noriko.n}}, já chega, você vai me deixar te ajudar querendo ou não."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_d9ccf413"
msgid "Je vais gérer cet abruti par moi-même."
msgstr "Eu vou dar um jeito nesse imbecil sozinho."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_3d7c6932"
msgid "Attends-moi plus loin !"
msgstr "Me espera ali na frente!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_eb7303af"
msgid "Mais il va te..."
msgstr "Mas ele vai te..."

#. Character:`saito` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_d1cecc44"
msgid "Il ne me fera plus rien, il n'en a plus la possibilité."
msgstr "Ele não vai fazer mais nada comigo, ele não tem mais capacidade para isso."

#. Character:`noriko`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_29cd7803"
msgid "..."
msgstr "..."

#. Character:`akira` | Attributes:`arrogant`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_1eb9d4f6"
msgid "Je crois que tu te surestimes un peu {{saito.n}}"
msgstr "Acho que você está se achando demais, {{saito.n}}."

#. Character:`saito` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_7e5f6a1e"
msgid "Non... c'est toi qui ne comprends pas."
msgstr "Não... é você que não está entendendo nada."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_8cdce688"
msgid "Avoue que tu es incapable de m'approcher à moins d'avoir une érection..."
msgstr "Confessa, você é incapaz de chegar perto de mim a menos que esteja de pau duro..."

#. Character:`akira` | Attributes:`angry`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_353e91f9"
msgid "Va te f-"
msgstr "Vai se fu-"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_9538550f"
msgid "C'est bien ce que je pensais !"
msgstr "Foi o que eu pensei!"

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_b403a11a"
msgid "Putain...[w] T'as de la chance... Cette maudite drogue me rend complètement fou."
msgstr "Porra...[w] Você deu sorte... Essa droga maldita está me deixando completamente insano."

#. Character:`saito` | Attributes:`upset`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_dd3638cc"
msgid "C'est pas de la chance, ça s'appelle le karma. C'est toi qui as voulu jouer avec le feu."
msgstr "Não é sorte, o nome disso é karma. Foi você quem quis brincar com fogo."

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_1b806897"
msgid "Ne crois pas que tu resteras intouchable longtemps."
msgstr "Não ache que vai continuar intocável por muito tempo."

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_16b4bf95"
msgid "Tu risques d'être surpris !"
msgstr "Você vai ter uma bela surpresa!"

#. Character:`saito` | Attributes:`angry`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_d7765cab"
msgid "Me raconte pas ta vie, n'approche plus jamais {{noriko.n}} !"
msgstr "Não me venha com conversinha fiada, nunca mais chegue perto da {{noriko.n}}!"

#. Character:`akira` | Attributes:`upset`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_61c4b671"
msgid "Tu veux t'en occuper ? Fais-toi plaisir mais tu viens juste de signer ton arrêt de mort."
msgstr "Quer cuidar dela? Fique à vontade, mas você acabou de assinar a sua sentença de morte."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_f1fa3661"
msgid "Pourquoi ça ?"
msgstr "É? E por quê?"

#. Character:`akira` | Attributes:`arrogant`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_a4511f86"
msgid "Attends, tu veux dire que tu n'es au courant de rien ?"
msgstr "Espera, você tá me dizendo que não sabe de nada?"

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_7dd954f2"
msgid "Alors que vous vivez littéralement sous le même toit ?"
msgstr "Mesmo vocês morando literalmente sob o mesmo teto?"

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_df199a0e"
msgid "Hahaha... La rentrée va être épique... si tu survis jusque là !"
msgstr "Hahaha... A volta às aulas vai ser épica... se você sobreviver até lá!"

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_c6ef15aa"
msgid "Profite de tes derniers jours !"
msgstr "Aproveite os seus últimos dias!"

#. Character:`narrator`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_65c75c43"
msgid "Ça s'est passé bien mieux que je ne l'aurais cru..."
msgstr "Isso foi muito melhor do que eu imaginava..."

#. Character:`narrator`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_a4b20747"
msgid "Après pour les menaces de mort... ça reste du {{akira.n}} tout craché."
msgstr "Mas sobre essas ameaças de morte... bem típico do {{akira.n}}."

#. Character:`narrator`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_d0661f86"
msgid "Inutile d'y accorder davantage d'attention pour le moment."
msgstr "Não vale a pena perder tempo pensando nisso por enquanto."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_9496cd11"
msgid "{{noriko.n}} ne viendra pas, il faudra se contenter de moi !"
msgstr "A {{noriko.n}} não vem, vai ter que se contentar comigo!"

#. Character:`akira` | Attributes:`angry`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_bfcda05a"
msgid "Putain... TOI !!"
msgstr "Porra... SEU!!"

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_2806bd16"
msgid "Ne t'approche pas !"
msgstr "Não chega perto!"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_f84b2f16"
msgid "Tu es donc toujours sous l'effet de cette drogue n'est-ce pas ?"
msgstr "Então você ainda está sob o efeito daquela droga, não é?"

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_06c16761"
msgid "C'est la faute de ta folle de copine !"
msgstr "A culpa é daquela maluca da sua namorada!"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_c733153f"
msgid "{{sakuya.n}} ?[w] Non je ne pense pas..."
msgstr "A {{sakuya.n}}?[w] Não, acho que não..."

#. Character:`saito` | Attributes:`angry`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_b8933dbc"
msgid "C'est toi qui avais ce truc sur toi."
msgstr "Foi você quem andou com essa merda por aí."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_a5417e4d"
msgid "Tout ce qu'il s'est passé est juste un retour de karma."
msgstr "Tudo o que aconteceu é só o karma voltando para te pegar."

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_b7f222e0"
msgid "T'approche pas bordel !"
msgstr "Não chega perto, porra!"

#. Character:`saito` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_67e96b5c"
msgid "Sinon quoi ? Tu vas avoir une erection ?"
msgstr "E se eu chegar? Vai ficar de pau duro?"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_4a67b980"
msgid "Tu ne vas pas pouvoir t'empêcher de venir me suc-"
msgstr "Você não vai conseguir se segurar e vai vir me chu-"

#. Character:`akira` | Attributes:`upset`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_41cc89af"
msgid "Putain ta gueule ! STOP ! Arrête ça !"
msgstr "Porra, cala a boca! PARA! Para com isso!"

#. Character:`saito` | Attributes:`upset`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_690bf5cc"
msgid "Si tu veux que j'arrête c'est simple... Sors de ma vie, de celle de {{noriko.n}} et de {{yasuka.n}}."
msgstr "Se você quer que eu pare, é simples... Some da minha vida, da vida da {{noriko.n}} e da {{yasuka.n}}."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_2a40481d"
msgid "Tu nous oublies et on fera de même !"
msgstr "Esquece a gente e nós faremos o mesmo!"

#. Character:`akira` | Attributes:`arrogant`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_045910c6"
msgid "Tu le regretteras de toute façon, j'étais la seule chance pour {{noriko.n}} de s'en sortir."
msgstr "Você vai se arrepender de qualquer jeito, eu era a única chance da {{noriko.n}} se safar."

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_5e59e2b9"
msgid "Qu'elle profite de sa tranquillité retrouvée si elle le veut."
msgstr "Que ela aproveite o sossego dela se quiser."

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_9125a530"
msgid "De toute façon, ça ne durera pas longtemps."
msgstr "De qualquer forma, não vai durar muito tempo."

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_f70d0b52"
msgid "Ne crois pas non plus que je ne m'en prendrais plus jamais à toi... Je trouverai une solution pour me débarrasser de... ça !"
msgstr "E não ache que eu nunca mais vou atrás de você... Eu vou achar um jeito de me livrar... disso!"

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_57e2c04c"
msgid "Allez tous vous faire foutre !"
msgstr "Vão todos se foder!"

#. Character:`narrator`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_ecd12cf6"
msgid "Voilà une bonne chose de faite !"
msgstr "Pronto, menos um problema!"

#. Character:`narrator`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_9a270151"
msgid "En ce qui concerne les menaces... C'est la routine avec {{akira.n}}."
msgstr "E quanto às ameaças... É a rotina de sempre com o {{akira.n}}."

#. Character:`narrator`
#: game/story/love_hotel_exterior.dialogue
msgctxt "love_hotel_exterior_27641333"
msgid "Je m'occuperais de ça le moment venu."
msgstr "Eu cuido disso quando a hora chegar."

#. Character:`saito` | Attributes:`surprised`
#: game/story/love_hotel_exterior.dialogue
msgctxt "tad4c7efd77"
msgid "Oh !"
msgstr "Oh!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t6f757428a9"
msgid "Tu m'attendais depuis longtemps ?"
msgstr "Você estava me esperando faz tempo?"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t63011f23af"
msgid "Depuis bien trop longtemps si tu veux mon avis !"
msgstr "Há muito tempo, caso você não tenha percebido!"

#. Character:`sayuri`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t7f929530b5"
msgid "Allez hop ! La chambre nous attend !"
msgstr "Vamos logo! O quarto está nos esperando!"

#. Character:`sayuri` | Attributes:`happy,blush`
#: game/story/love_hotel_exterior.dialogue
msgctxt "ta7036e6d69"
msgid "J'ai bien l'intention de rentabiliser la nuit complète, j'espère que tu es en forme ?"
msgstr "Eu pretendo fazer a noite inteira valer a pena, espero que você esteja em forma."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "ta0591f9a80"
msgid "Ca... Ca devrait aller !"
msgstr "C-Com certeza... Eu dou conta!"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t92ae6bfde8"
msgid "Mon dieu quel nuit !"
msgstr "Meu Deus, que noite!"

#. Character:`sayuri`
#: game/story/love_hotel_exterior.dialogue
msgctxt "tf28c19f9dc"
msgid "Tu n'as pas failli à ta réputation !"
msgstr "Você realmente faz jus à sua reputação!"

#. Character:`saito` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "te58d27dc4a"
msgid "Je donne toujours le maximum."
msgstr "Eu sempre dou o meu máximo."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t5ef3490440"
msgid "Je ferais bien de me remettre en forme sinon je tiendrais jamais la rythme..."
msgstr "É melhor eu entrar em forma, senão nunca vou conseguir aguentar o ritmo..."

#. Character:`saito` | Attributes:`guilty`
#: game/story/love_hotel_exterior.dialogue
msgctxt "ta61adcfcc4"
msgid "Dois-je conclure que tu ne souhaites pas t'arrêter là ?"
msgstr "Devo concluir que você não quer parar por aqui?"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t634cdef8e0"
msgid "...[w]Si tu es d'accord bien sur ?"
msgstr "...[w]Se você estiver a fim, é claro?"

#. Character:`narrator`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t2234a46081"
msgid "Mon dieu avec un tel regard..."
msgstr "Meu Deus, com um olhar desses..."

#. Character:`narrator`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t0127750a54"
msgid "Comment je pourrais lui refuser quoi que se soit ?"
msgstr "Como eu poderia recusar qualquer coisa para ela?"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t4a4824d082"
msgid "Tant que c'est toi qui parle de cette situation à {{asami.n}} ça me va..."
msgstr "Contanto que seja você quem vá falar dessa situação com a {{asami.n}}, por mim tudo bem..."

#. Character:`sayuri`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t9d0e980e14"
msgid "...Je suis certaine qu'elle sera compréhensible et heureuse pour sa mère...[w]Je crois..."
msgstr "...Tenho certeza de que ela vai ser compreensiva e vai ficar feliz pela mãe...[w]Eu acho..."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t229b75289f"
msgid "Allez je te raccompagne ?"
msgstr "Vamos, eu te acompanho de volta?"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/love_hotel_exterior.dialogue
msgctxt "t28869c1396"
msgid "J'espère bien ! Si avec la nuit qu'on a passée tu me laisse tomber maintenant, je vais vraiment me fâcher !"
msgstr "Acho bom! Se depois da noite que passamos você me decepcionar agora, eu vou ficar putassa de verdade!"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "INSTALLONS_QUELQUES_AFFICHES_I_BB2A16"
msgid "Installons quelques affiches ici."
msgstr "Vamos colocar alguns cartazes aqui."

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "BON_A_DEVRAIT_SUFFIRE_POUR_ICI_4899DD"
msgid "Bon, ça devrait suffire pour ici, allons voir du côté du konbini."
msgstr "Bom, por aqui já deve bastar, vamos dar uma olhada perto da loja de conveniência."

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "J_ESP_RE_QUE_TU_PASSES_UNE_BON_B49FF0"
msgid "J'espère que tu passes une bonne soirée..."
msgstr "Espero que esteja gostando da noite..."

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "J_AI_D_PENS_SANS_COMPTER_POUR_53E3AE"
msgid "J'ai dépensé sans compter pour toi, bébé."
msgstr "Eu gastei sem miséria com você, gata."

#. Character:`tsubaki` | Attributes:`pouting`
#: game/story/love_hotel_exterior.dialogue
msgctxt "OUI_C_TAIT_PAS_TROP_MAL_DB514C"
msgid "Oui, c'était pas trop mal..."
msgstr "Sim, até que não foi tão ruim..."

#. Character:`tsubaki`
#: game/story/love_hotel_exterior.dialogue
msgctxt "ET_QU_EST_CE_QU_ON_FAIT_DEVANT_9C4B15"
msgid "Et qu'est-ce qu'on fait devant le love hôtel, exactement ?"
msgstr "E o que exatamente a gente está fazendo na frente do love hotel?"

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "ALLONS_B_B_TU_DOIS_BIEN_AVOIR_F21AD2"
msgid "Allons, bébé... Tu dois bien avoir une idée... Ça fait plusieurs mois qu'on sort ensemble..."
msgstr "Qual é, gata... Você deve ter uma ideia... Já faz meses que a gente está saindo..."

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "IL_SERAIT_PEUT_TRE_TEMPS_DE_FA_4F3111"
msgid "Il serait peut-être temps de faire avancer notre relation..."
msgstr "Talvez já esteja na hora da nossa relação avançar..."

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "POUR_LE_MOMENT_C_EST_SURTOUT_T_18EA5D"
msgid "Pour le moment, c'est surtout toi qui en profites..."
msgstr "Por enquanto, é só você quem está aproveitando..."

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "IL_FAUT_QUE_TU_DONNES_UN_PEU_D_E19239"
msgid "Il faut que tu donnes un peu du tien aussi."
msgstr "Você tem que colaborar um pouco também."

#. Character:`tsubaki` | Attributes:`bored`
#: game/story/love_hotel_exterior.dialogue
msgctxt "JE_COMMENCE_COMPRENDRE_PR_SENT_0F30B3"
msgid "Je commence à comprendre à présent !"
msgstr "Agora eu comecei a entender!"

#. Character:`tsubaki` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "TU_AS_RAISON_JE_CROIS_QUE_JE_T_F98B8E"
msgid "Tu as raison, je crois que je t'ai fait attendre assez longtemps... Allons-y !"
msgstr "Você tem razão, acho que já te fiz esperar tempo demais... Vamos!"

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "OUI_PUTAIN_OUI_C_EST_LE_GRAND_D41C4A"
msgid "Oui ! Putain ! Oui, c'est le grand soir !"
msgstr "Isso! Porra! Sim, é hoje à noite!"

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "JE_VAIS_ENFIN_PERDRE_MON_PUC_A99DDD"
msgid "Je vais enfin perdre mon puc-"
msgstr "Eu vou finalmente perder a minha virginda-"

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "TAKEO_N_J_AI_BESOIN_DE_TE_PAR_2DE451"
msgid "{{takeo.n}}, j'ai besoin de te parler, ça ne sera pas long."
msgstr "{{takeo.n}}, eu preciso falar com você, vai ser rápido."

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "HEY_NON_LACHE_MOI_PUTAIN_D4CAC7"
msgid "Hey ! Non ! Lache moi putain !"
msgstr "Ei! Não! Me solta, porra!"

#. Character:`tsubaki`
#: game/story/love_hotel_exterior.dialogue
msgctxt "POURQUOI_CHAQUE_FOIS_QU_ON_SE_AE60CE"
msgid "Pourquoi à chaque fois qu'on se promène on finit toujours ici ?"
msgstr "Por que toda vez que a gente sai para passear a gente sempre acaba aqui?"

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "B_B_JE_SUIS_D_SOL_MAIS_CHAQUE_43D948"
msgid "Bébé... Je suis désolé, mais à chaque fois qu'on a voulu aller plus loin, on a été dérangés."
msgstr "Gata... Me desculpa, mas toda vez que a gente tentou ir mais longe, alguém atrapalhou."

#. Character:`tsubaki` | Attributes:`bored`
#: game/story/love_hotel_exterior.dialogue
msgctxt "QUI_LA_FAUTE_4CC663"
msgid "À qui la faute ?"
msgstr "E de quem é a culpa?"

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "JE_SAIS_JE_SAIS_A_N_ARRIVERA_P_F67D69"
msgid "Je sais... Je sais... Ça n'arrivera plus, je te le promets !"
msgstr "Eu sei... Eu sei... Não vai mais acontecer, eu prometo!"

#. Character:`takeo` | Attributes:`mocking`
#: game/story/love_hotel_exterior.dialogue
msgctxt "TU_VEUX_BIEN_ME_LAISSER_UNE_DE_CE4682"
msgid "Tu veux bien me laisser une dernière chance ?"
msgstr "Você não quer me dar uma última chance?"

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "JE_TE_PROMETS_QUE_TU_NE_LE_REG_10E686"
msgid "Je te promets que tu ne le regretteras pas."
msgstr "Eu prometo que você não vai se arrepender."

#. Character:`tsubaki` | Attributes:`arrogant`
#: game/story/love_hotel_exterior.dialogue
msgctxt "TU_M_OFFRIRAS_CE_MAGNIFIQUE_SA_A490E2"
msgid "Tu m'offriras ce magnifique sac qu'on a vu tout à l'heure ?"
msgstr "Você vai me dar aquela bolsa linda que a gente viu mais cedo?"

#. Character:`takeo` | Attributes:`disgusted`
#: game/story/love_hotel_exterior.dialogue
msgctxt "F_W_OUI_TOUT_CE_QUE_TU_VEUX_B_C867BD"
msgid "F..[w] Oui ! Tout ce que tu veux, bébé !"
msgstr "Que mer...[w] Sim! Tudo o que você quiser, gata!"

#. Character:`tsubaki` | Attributes:`smile`
#: game/story/love_hotel_exterior.dialogue
msgctxt "D_ACCORD_JE_TE_LAISSE_UNE_DERN_ED89CF"
msgid "D'accord, je te laisse une dernière chance alors."
msgstr "Está bem, então eu te dou uma última chance."

#. Character:`takeo` | Attributes:`bad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "ALLEZ_CETTE_FOIS_CI_C_EST_LA_B_902E06"
msgid "Allez, cette fois-ci c'est la bonne, personne pour venir me faire chier."
msgstr "Vamos lá, dessa vez vai dar certo, não tem ninguém para vir me encher o saco."

#. Character:`takeo`
#: game/story/love_hotel_exterior.dialogue
msgctxt "JE_VAIS_ENFIN_DIRE_ADIEU_MON_P_D2E4A2"
msgid "Je vais enfin dire adieu à mon pucelage !"
msgstr "Eu vou finalmente dizer adeus à minha virgindade!"

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "UNE_PROSTITU_E_TE_CO_TERAIT_BI_B2F2E8"
msgid "Une prostituée te coûterait bien moins cher, ducon."
msgstr "Uma prostituta te custaria bem mais barato, seu otário."

#. Character:`akira`
#: game/story/love_hotel_exterior.dialogue
msgctxt "VIENS_DISCUTER_UN_PEU_AVEC_MOI_5C429D"
msgid "Viens discuter un peu avec moi..."
msgstr "Vem conversar um pouco comigo..."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "AHH_ON_SE_SENT_TOUJOURS_MIEUX_2A9A38"
msgid "Ahh ! On se sent toujours mieux après un peu d’exercice physique."
msgstr ""

#. Character:`sakuya`
#: game/story/love_hotel_exterior.dialogue
msgctxt "SI_TU_VEUX_PASSER_LA_NUIT_AVEC_29A0E4"
msgid "Si tu veux passer la nuit avec mon {{saito.n}} ici il faudra me passer sur le corps !"
msgstr ""

#. Character:`saito`
#: game/story/love_hotel_exterior.dialogue
msgctxt "FONT_SIZE_14_OH_MAIS_C_EST_SA_026F87"
msgid "[font_size=14]Oh mais c’est {{sakuya.n}} là-bas ![/font_size]"
msgstr ""

#. Character:`asami`
