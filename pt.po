#: game/story/home_nobu_exterior.dialogue
msgctxt "home_nobu_exterior_867ed625"
msgid "On s'en fout, fonce ! Il va rentrer chez lui sinon !"
msgstr "Que se foda, vai logo! Senão ele vai entrar em casa!"

