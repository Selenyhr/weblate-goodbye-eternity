msgstr ""

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "ALLEZ_PRENDS_BIEN_SOIN_DE_YASU_5420AD"
msgid "Allez, prends bien soin de {{yasuka.n}}, je vais passer un peu de temps avec ma mère, moi aussi."
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t22d2ff6695"
msgid "[next]"
msgstr "[next]"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_c22fe00a"
msgid "Bonjour {{saito}}, tu as besoin de quelque chose ?"
msgstr "Olá, {{saito}}, precisa de alguma coisa?"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t0f72f1767e"
msgid "Discuter."
msgstr "Conversar."

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t82299edec1"
msgid "À propos de {{noriko.n}}."
msgstr "Sobre a {{noriko.n}}."

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "tcfcca545f9"
msgid "Avez-vous vu {{noriko.n}} ?"
msgstr "Você viu a {{noriko.n}}?"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t5c2e5269ef"
msgid "Mauvaises fréquentations."
msgstr "Más companhias."

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t6b428057ee"
msgid "[color=yellow]Argent volé.[/color]"
msgstr "[color=yellow]Dinheiro roubado.[/color]"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_02574cc8"
msgid "Bonjour {{saito.n}}, comment vas-tu ?"
msgstr "Olá, {{saito.n}}, como vai?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_bc3b3424"
msgid "Tu t'es déjà décidé de venir me voir ?"
msgstr "Até que enfim decidiu vir me ver, hein?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "ET_BIEN_CE_N_EST_PAS_TOUT_A_FA_65D577"
msgid "Eh bien... Ce n'est pas tout à fait désintéressé..."
msgstr ""

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "OH_VOYEZ_VOUS_A_QUE_PUIS_JE_FA_88D44E"
msgid "Oh ? Voyez-vous ça ! Que puis-je faire pour toi ?"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "C_EST_PROPOS_DE_NORIKO_N_82CB45"
msgid "C'est à propos de {{noriko.n}}."
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_64b40920"
msgid "Dis-moi tout."
msgstr "Pode falar."

#. Character:`centered`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_32ab0bcf"
msgid "Après quelques minutes d'explications..."
msgstr "Após alguns minutos de explicação..."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_663fcd80"
msgid "Malheureusement, je ne peux pas t'en dire davantage mais tu sais quoi ? Je demanderai à mon ancien collaborateur."
msgstr "Infelizmente eu não posso te dizer mais nada, mas sabe de uma coisa? Vou perguntar para o meu antigo funcionário."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_90514ef1"
msgid "Si j'apprends quelque chose d'intéressant je te le dirais."
msgstr "Se eu descobrir algo interessante, eu te aviso."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_afa36740"
msgid "Merci infiniment."
msgstr "Muito obrigado."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_6908d2b6"
msgid "Aucun problème et dis-moi juste une chose..."
msgstr "Sem problemas, e me diz só uma coisa..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t9dca5fcee6"
msgid "J'ai appris que toi et {{asami.n}} étiez seulement amis..."
msgstr "Fiquei sabendo que você e a {{asami.n}} são só amigos..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "tc7f0a37830"
msgid "Je suis surprise que tu aies réussi à résister à ses charmes."
msgstr "Estou surpresa que você tenha conseguido resistir aos encantos dela."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t8c2b2c547f"
msgid "Du coup... Je me demandais... Y a-t-il une autre fille ?"
msgstr "Por isso... Eu estava me perguntando... Tem outra garota na jogada?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2805e8a7"
msgid "Je sais que vous sortez déjà ensemble."
msgstr "Eu sei que vocês já estão namorando."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3f62267a"
msgid "Mais qu'est-ce qui t'a fait définitivement craquer chez elle ?"
msgstr "Mas o que fez você ficar caidinho por ela?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2329d961"
msgid "C'est tout moi quand j'étais jeune."
msgstr "Era igualzinha a mim quando eu era jovem."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2d6975f1"
msgid "Heureusement ça passe avec le temps."
msgstr "Felizmente isso passa com o tempo."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_604ab035"
msgid "Ça me dérange pas."
msgstr "Isso não me incomoda."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_1c9d2b50"
msgid "C'est ça qui fait son charme."
msgstr "É isso que dá o charme dela."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_c8ab143a"
msgid "Elle est vraiment bien tombée avec toi alors..."
msgstr "Ela realmente deu muita sorte com você então..."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2e8b5543"
msgid "Maman arrête avec ça, j'ai pas envie de changer."
msgstr "Mãe, para com isso, eu não quero mudar."

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_641dd2f6"
msgid "De plus {{saito.n}} m'aime pour ce que je suis donc tu devrais plutôt être contente."
msgstr "Além disso, o {{saito.n}} me ama pelo que eu sou, então você deveria estar feliz."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_d7d63da9"
msgid "Ma puce, je suis contente pour toi c'est juste... que ton manteau ressemble plus à un gros sac poubelle."
msgstr "Querida, eu estou feliz por você, é só... que o seu casaco parece mais um saco de lixo grande."

#. Character:`asami` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a85290bb"
msgid "MAMAN !!!"
msgstr "MÃEE!!!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_dd6c2daa"
msgid "On va vous laisser je crois..."
msgstr "Acho melhor eu ir andando..."

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "te25262aa89"
msgid "Son côté garçon manqué."
msgstr "O lado moleca dela."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_1250478e"
msgid "J'avoue que je suis aussi surprise que toi."
msgstr "Confesso que estou tão surpresa quanto você."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_64302154"
msgid "Je ne pensais pas qu'elle changerait aussi vite."
msgstr "Não achei que ela mudaria tão rápido."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_4b6f0ff3"
msgid "Rien de tel qu'un chagrin d'amour pour se remettre en question."
msgstr "Nada como uma desilusão amorosa para fazer a gente cair na real."

#. Character:`asami` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_ee520f13"
msgid "MAMAN !!! Qu'est-ce que tu racontes à {{saito.n}} dans mon dos ?!"
msgstr "MÃÃÃÃE! O que você está cochichando com o {{saito.n}} pelas minhas costas?!"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_34417166"
msgid "Rien ma puce, on discutait juste un peu de toi."
msgstr "Nada, querida, só estávamos conversando um pouco sobre você."

#. Character:`asami` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a57f63eb"
msgid "Oui, eh bien ne le faites pas ! Je ne suis pas une attraction !"
msgstr "Sim, bem, não façam isso! Eu não sou nenhuma atração de circo!"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "tea2543a909"
msgid "Sa détermination."
msgstr "A determinação dela."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "ta80ea91415"
msgid "Il y a bien une personne à qui je tiens beaucoup."
msgstr "Tem uma pessoa de quem eu gosto muito, sim."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "t9cb4ca02bb"
msgid "..."
msgstr "..."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "td4ee42c9b5"
msgid "Vraiment ? J'en connais une qui a de la chance."
msgstr "Sério? Conheço alguém que tirou a sorte grande."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "tc6032fcbc0"
msgid "Tu l'as déjà rencontrée ma puce ?"
msgstr "Você já conheceu ela, querida?"

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "t7ad8e7a741"
msgid "[font_size=10]Oui... et puis y'en a pas qu'une...[/font_size]"
msgstr "[font_size=10]Sim... e não é só uma...[/font_size]"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t94679766e1"
msgid "Oh ma petite chérie est jalouse !"
msgstr "Oh, a minha filhinha está com ciúmes!"

#. Character:`asami` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "t9fb87cd5ce"
msgid "MAMAN !! ARRÊTE !"
msgstr "MÃE!! PARA! JÁ CHEGA!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t8117094e13"
msgid "Tu es trop mignonne !"
msgstr "Você fica uma fofura!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "ta3a8d45b15"
msgid "Tu ne trouves pas {{saito.n}} ?"
msgstr "Você não acha, {{saito.n}}?"

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "t3cbcb8d970"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`guilty`
#: game/story/konbini_interior.dialogue
msgctxt "teac8ff8e31"
msgid "Je crois que je vais vous laisser discuter de ça entre vous deux."
msgstr "Acho que vou deixar vocês duas conversando sobre isso sozinhas."

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t4b18a33577"
msgid "Oui... Il y a bien quelqu'un."
msgstr "Sim... Tem alguém."

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_df99a1f8"
msgid "Oh-ho voyez-vous ça ?!"
msgstr "Ora, ora, olha só o que temos aqui!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_8d89a396"
msgid "Tu sembles avoir confiance en toi."
msgstr "Parece que você é bem confiante."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_58f48c02"
msgid "Mais que pourrait bien m'apporter un jeune homme comme toi ?"
msgstr "Mas o que um rapaz jovem como você teria para me oferecer?"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_0365d33f"
msgid "Je suppose que nous ne le saurons jamais..."
msgstr "Acho que nunca saberemos..."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_d62ae330"
msgid "Tu sais que si j'avais eu probablement 10 ans de moins je t'aurais dévoré ?"
msgstr "Sabe que se eu tivesse uns dez anos a menos, eu teria te devorado vivo?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2e1d93cb"
msgid "Quoi ! Sérieusement ?"
msgstr "O quê! Sério?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_669a16f5"
msgid "Je suppose que nous ne le saurons jamais !"
msgstr "Acho que nunca saberemos!"

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_d6fd98ff"
msgid "Dites... Vous voulez un coup de main tous les deux ?"
msgstr "Escuta... Vocês dois querem um quarto?"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b641c373"
msgid "Oh ma chérie ! Je taquinais juste {{saito.n}}."
msgstr "Ah, querida! Eu só estava provocando o {{saito.n}}."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_71cedfb5"
msgid "Je sais... mais ça me fait bizarre d'entendre ma propre mère dire ce genre de choses à mon petit ami."
msgstr "Eu sei... mas é bizarro ouvir a minha própria mãe falar esse tipo de coisa para o meu namorado."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2db8a73e"
msgid "Haha c'est pour ça que tu dois faire de ton mieux sinon peut-être que je garderais pour moi ?"
msgstr "Haha, é por isso que você tem que dar o seu melhor, senão quem sabe eu não fico com ele para mim?"

#. Character:`asami` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b25989d3"
msgid "Maman !!! Arrête avec ça !"
msgstr "Mãe!!! Para com isso!"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t93661763a1"
msgid "Elle n'était qu'un prétexte pour me rapprocher de vous."
msgstr "Ela era só uma desculpa para eu me aproximar de você."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_9e5b7299"
msgid "À bientôt {{sayuri.n}}."
msgstr "Até mais, {{sayuri.n}}."

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a9226adb"
msgid "Non, c'est madame pour elle !"
msgstr "Não, é senhora para você!"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_5d548632"
msgid "Oh toi, tu ne perds rien pour attendre !"
msgstr "Olha só, você não perde por esperar!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b5073a39"
msgid "Bonjour {{saito.n}}, tu es bien matinal."
msgstr "Bom dia, {{saito.n}}, você acordou cedo hoje."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_e300b9a4"
msgid "Ça ferait une bonne surprise à ma fille si c'était toi qui allais la réveiller."
msgstr "Seria uma bela surpresa para a minha filha se fosse você quem fosse acordá-la."

#. Character:`saito` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_1a4ac489"
msgid "Sûrement mais... je ne suis pas venu pour ça, auriez-vous vue {{noriko.n}} passer ce matin ?"
msgstr "Com certeza, mas... eu não vim por causa disso. Você viu a {{noriko.n}} passar por aqui hoje de manhã?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3ed7c8a3"
msgid "Oh oui ! Ce matin elle se dirigeait vers l'ancienne gare désaffectée."
msgstr "Ah, sim! Hoje cedo ela estava indo em direção à antiga estação de trem desativada."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3ba6c0a7"
msgid "D'ailleurs à ce sujet, j'ai eu des nouvelles de mon ancien collaborateur."
msgstr "Inclusive, sobre esse assunto, tive notícias do meu antigo funcionário."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3664dd15"
msgid "Quand je lui ai posé la question, il a tout de suite reconnu de qui je parlais."
msgstr "Quando perguntei para ele, ele reconheceu na hora de quem eu estava falando."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3c87d730"
msgid "Vraiment ? A-t-il vu quelque chose qui sort de l'ordinaire ?"
msgstr "Sério? Ele viu alguma coisa fora do comum?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_d77694a2"
msgid "... À vrai dire, il y a bien quelque chose."
msgstr "... Para falar a verdade, sim."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_d5702a65"
msgid "Elle semble traîner assez régulièrement avec 3 hommes un peu grossiers qui traînent souvent dans le coin."
msgstr "Ela parece andar com bastante frequência com três homens meio brutos que vivem de bobeira por aqui."

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_32742a34"
msgid "Trois hommes vous dites..."
msgstr "Três homens... é?"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_f255feac"
msgid "Malheureusement, il n'a pas pu m'en dire davantage."
msgstr "Infelizmente ele não soube me dizer mais nada."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_30026855"
msgid "Je comprends... Merci pour votre... ton aide."
msgstr "Eu entendo... Obrigado pela ajuda da senho-[w] quer dizer, pela sua ajuda."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_bc298068"
msgid "Fais attention à elle {{saito.n}}. Ils ne m'inspirent pas confiance."
msgstr "Fique de olho nela, {{saito.n}}. Aqueles caras não me inspiram nenhuma confiança."

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_9ad1c2bf"
msgid "Moi non plus, je vais m'en occuper."
msgstr "Nem a mim. Vou dar um jeito nisso."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_4b1649a0"
msgid "Bonsoir {{saito.n}}, tu as besoin de quelque chose ?"
msgstr "Boa noite, {{saito.n}}, precisa de alguma coisa?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_96d2cfce"
msgid "Bonsoir {{sayuri.n}}, j'étais simplement venu prendre de quoi manger avant de rentrer chez moi."
msgstr "Boa noite, {{sayuri.n}}, eu só passei para pegar algo para comer antes de voltar para casa."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_14c850b2"
msgid "Laisse-moi te l'offrir dans ce cas..."
msgstr "Deixa que eu pago para você então..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_f60c5a3b"
msgid "Ce n'est pas nécessaire vous savez, j'ai de quoi p-"
msgstr "Não precisa, sério, eu tenho como pa-"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2bdd416f"
msgid "Arrête un peu... Laisse-moi te remercier à ma façon de prendre soin de ma fille."
msgstr "Para com isso... Deixa eu te agradecer do meu jeito por cuidar tão bem da minha filha."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b43c820e"
msgid "Très bien j'accepte alors."
msgstr "Tudo bem, eu aceito então."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a4c6c66f"
msgid "Ce serait dommage de refuser un cadeau de ma future belle-mère c'est ça ?"
msgstr "Seria uma desfeita recusar um presente da minha futura sogra, né?"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2846bc20"
msgid "Oh mais c'est que tu comprends vite !"
msgstr "Olha só como você aprende rápido!"

#. Character:`noriko` | Attributes:`cute`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b9ab7872"
msgid "Bonsoir madame..."
msgstr "Boa noite, senhora..."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_de757a92"
msgid "{{sayuri.SPELLOUT}} !"
msgstr "É, {{sayuri.SPELLOUT}}!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_89467128"
msgid "Désolée, je n'ai pas vraiment l'habitude..."
msgstr "Desculpe, não estou muito acostumada..."

#. Character:`kenji`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_624bd72c"
msgid "[font_size=34]{{saito.n}} le déchet ! Je sais que t'es là, sors d'ici ou c'est moi qui viens te chercher.[/font_size]"
msgstr "[font_size=34]{{saito.n}}, seu fracassado! Eu sei que você está aí dentro, sai agora ou eu vou te buscar![/font_size]"

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3960521c"
msgid "Bon sang encore un de ces foutus idiots."
msgstr "Que droga, mais um desses idiotas."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_22e372c0"
msgid "Reste là {{saito.n}}, je vais passer un coup de téléphone à la police de quartier et ils interviendront rapidement."
msgstr "Fique aqui, {{saito.n}}, vou ligar para a polícia do bairro e eles vão resolver isso rapidinho."

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_efd1ea6e"
msgid "Non...[w] Je m'en charge."
msgstr "Não...[w] Eu cuido disso."

#. Character:`noriko`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_f58b1eb6"
msgid "Tu vas te faire refaire le portrait..."
msgstr "Você vai levar uma surra daquelas..."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_0b281b81"
msgid "Ça te plairait de voir ça hein..."
msgstr "Você ia adorar ver isso, né..."

#. Character:`noriko` | Attributes:`shame`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a1e2b777"
msgid "Quoi ?! Non ! Je..."
msgstr "O quê?! Não! Eu..."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_0327ff32"
msgid "S'il te plaît {{saito.n}}, sois prudent et ne fais rien d'inconsidéré."
msgstr "Por favor, {{saito.n}}, tome cuidado e não faça nenhuma besteira."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3149c73a"
msgid "Il faudra qu'on discute toi et moi {{noriko.n}} après tout ça."
msgstr "A gente vai precisar conversar muito sério, {{noriko.n}}, depois que isso acabar."

#. Character:`noriko` | Attributes:`bad`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_aeaa5445"
msgid "Et qu'est ce que tu comptes faire exactement ? Tu vas te mettre en colère ?"
msgstr "E o que você pensa que vai fazer exatamente? Vai ficar com raiva?"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a994ce0f"
msgid "C'est ça le truc {{noriko.n}}, je suis toujours en colère."
msgstr "Esse é o meu segredo, {{noriko.n}}... Eu estou sempre com raiva."

#. Character:`noriko` | Attributes:`shame`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_898b1990"
msgid "..."
msgstr "..."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_7b58153d"
msgid "J'espère que tout ira bien pour lui..."
msgstr "Espero que fique tudo bem com ele..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_61aa192b"
msgid "... eh bien il semble que tu as de la chance."
msgstr "... bem, parece que você deu sorte."

#. Character:`yasuka`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_3c5f45b1"
msgid "Oui ![w] Ça me fait énormément plaisir, ça faisait longtemps qu'on n'avait pas discuté toutes les deux comme ça."
msgstr "Sim![w] Isso me deixa muito feliz, fazia tempo que a gente não batia um papo assim, só nós duas."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_451d468e"
msgid "Je ne savais même pas qu'{{asami.n}} était ta fille !"
msgstr "Eu nem sabia que a {{asami.n}} era sua filha!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_47801297"
msgid "Mais maintenant je me rends compte à quel point j'ai été aveugle."
msgstr "Mas agora eu vejo como eu fui cega."

#. Character:`yasuka`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_469b1be1"
msgid "C'est ton portrait craché."
msgstr "É o seu retrato falado."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_c61c9f1b"
msgid "Les chiens ne font pas des chats comme on dit."
msgstr "Filho de peixe, peixinho é, como dizem por aí."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_b7613b0a"
msgid "{{saito.n}} a vraiment eu une bonne influence sur elle aussi."
msgstr "O {{saito.n}} realmente teve uma ótima influência sobre ela também."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_94fa3189"
msgid "Il n'y a pas si longtemps elle me rendait folle."
msgstr "Não faz muito tempo, ela me deixava de cabelo em pé."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_e7c09753"
msgid "Ne m'en parle pas, j'avais le même problème avec {{noriko.n}}."
msgstr "Nem me fale, eu tinha o mesmo problema com a {{noriko.n}}."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_70e002d0"
msgid "D'ailleurs il ne faut pas que je tarde, ils doivent m'attendre, on va fêter ça ensemble !"
msgstr "Bom, não posso me atrasar, eles devem estar me esperando, vamos comemorar juntos!"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_0c84bddc"
msgid "Il faudra que vous veniez tous à l'occasion, qu'on puisse tous passer une soirée ensemble."
msgstr "Vocês precisam aparecer todos juntos qualquer dia desses, para a gente passar uma noite agradável."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_e64da86f"
msgid "Avec plaisir !"
msgstr "Com certeza!"

#. Character:`yasuka`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_b348bebc"
msgid "Allez bon courage et à bientôt !"
msgstr "Bom, aguenta firme aí e a gente se fala!"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2fbe45d8"
msgid "C'est bon ! J'ai récupéré ce qu'il vous devait !"
msgstr "Prontinho! Consegui reaver o dinheiro que ele te devia!"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_15805226"
msgid "Oh {{saito.n}}, merci mais il ne fallait pas te mettre en danger pour une somme pareille tu sais..."
msgstr "Ah, {{saito.n}}, obrigada, mas você não deveria ter se arriscado por uma quantia dessas, sabe..."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_7725fc23"
msgid "Qu'est-ce que j'aurais dit à ma fille si à cause de moi il t'était arrivé quelque chose ?"
msgstr "O que eu diria para a minha filha se algo tivesse acontecido com você por minha causa?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_7dbeb66f"
msgid "Tout s'est bien passé je vous assure !"
msgstr "Deu tudo certo, eu te garanto!"

#. Character:`notice`
#: game/story/konbini_interior.dialogue
msgctxt "te23e1b8d53"
msgid "Vous avez donné l'argent à {{sayuri.n}}"
msgstr "Você entregou o dinheiro para a {{sayuri.n}}."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b8094ed7"
msgid "Une seconde..."
msgstr "Espere um segundo..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_9fc376dc"
msgid "Il y a bien plus que prévu."
msgstr "Tem muito mais aqui do que o combinado."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_9ca535b5"
msgid "Gardez-le, ce n'est sûrement pas la première fois qu'il vous fait ce coup-là."
msgstr "Pode ficar, com certeza não é a primeira vez que ele faz essa palhaçada com você."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_db36a0ac"
msgid "Non, en effet."
msgstr "Não, não é mesmo."

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_012d38c6"
msgid "...[w] Tu es un amour !"
msgstr "...[w] Você é um amor!"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b4e27a3c"
msgid "Je vous en prie, c'était normal."
msgstr "Não precisa agradecer, era o mínimo que eu podia fazer."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_44ce225c"
msgid "Au fait ! Tu devrais passer voir {{asami.n}}, je crois qu'elle était inquiète."
msgstr "A propósito! Você devia dar uma passada para ver a {{asami.n}}, acho que ela estava bem preocupada."

#. Character:`saito` | Attributes:`guilty`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_1746ad5a"
msgid "Inquiète à propos de quoi ?"
msgstr "Preocupada com o quê?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_0729f33c"
msgid "Il se pourrait que je lui ai raconté ce qu'il s'était passé hier soir."
msgstr "Pode ser que eu tenha aberto o bico e contado para ela o que aconteceu ontem à noite."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_086c3bcd"
msgid "...C'est pas grave, je verrais ça avec elle."
msgstr "... Sem problemas, eu me entendo com ela."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_1f160de3"
msgid "J'y vais à bientôt {{sayuri.n}} !"
msgstr "Já vou indo, até mais, {{sayuri.n}}!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_4d1f1162"
msgid "Qu'est-ce que tu fais là ma chérie ça ne te ressemble pas ?"
msgstr "O que você está fazendo aqui, querida? Isso não é do seu feitio."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_74698715"
msgid "Tu n'es pas avec {{saito.n}} ?"
msgstr "Você não está com o {{saito.n}}?"

#. Character:`asami` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_19a610e5"
msgid "Non en ce moment il passe tout son temps avec {{noriko.n}}..."
msgstr "Não, ultimamente ele passa todo o tempo dele com a {{noriko.n}}..."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_bf52f3d4"
msgid "Et ils n'ont pas besoin de moi."
msgstr "E eles não precisam de mim."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_f3d01191"
msgid "Ohh ma petite puce est jalouse..."
msgstr "Ah... A minha filhinha está com ciúmes!"

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_d7bb846a"
msgid "...Moi aussi j-"
msgstr "...Eu também tenho o direi-"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_9d71aca3"
msgid "Et bien tu vois, quand on parle du loup !"
msgstr "Olha só, falando no diabo!"

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_92a3063d"
msgid "Maman !!!"
msgstr "Mããããe!!!"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_e956b7e3"
msgid "Tout va bien ?"
msgstr "Tudo bem por aqui?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_b73e4318"
msgid "Et bien en fait figure toi que..."
msgstr "Bom, na verdade, para você ter uma ideia..."

#. Character:`asami` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_014c009b"
msgid "MAMAN STOP !"
msgstr "MÃE, JÁ CHEGA!"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_abc4c7f4"
msgid "C'est bon j'ai compris je vous laisse entre vous."
msgstr "Tá bom, já entendi, vou deixar vocês a sós."

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_6bc5849a"
msgid "...{{noriko.n}} n'est pas avec toi ?"
msgstr "...A {{noriko.n}} não está com você?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_77f23413"
msgid "Si si, elle attend dehors."
msgstr "Está sim, ela está esperando lá fora."

#. Character:`asami` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_a2df6564"
msgid "Vous êtes toujours dans votre projet de vengeance contre..."
msgstr "Vocês ainda estão com aquele plano de vingança..."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_3e85771d"
msgid "Oui..."
msgstr "Sim..."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_9c9606c1"
msgid "C'est bientôt terminé, il en manque un, les autres sauront qu'à l'avenir je ne serai plus une cible facile."
msgstr "Está quase terminando, só falta um. Os outros vão aprender que, no futuro, eu não vou ser um alvo fácil."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_7e7b2940"
msgid "Ils y réfléchiront à deux fois avant de s'en prendre à moi."
msgstr "Eles vão pensar duas vezes antes de mexer comigo."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_c758ffb8"
msgid "Je ne sais pas pourquoi mais j'ai peur que tout ça se termine mal..."
msgstr "Não sei por que, mas tenho medo de que tudo isso termine mal..."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_754e585a"
msgid "...Ne t'inquiète pas, je fais attention à moi et je ne fais rien dans l'excès."
msgstr "...Não se preocupe, eu estou me cuidando e não vou passar dos limites."

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_1927ceb6"
msgid "Je préférerais qu'on passe plutôt notre journée ensemble quand même."
msgstr "Mesmo assim, eu preferia que a gente passasse o dia juntos."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_a2a3ce27"
msgid "Promis dès que j'en ai terminé avec ça, on sera rien que toi et moi !"
msgstr "Prometo que assim que eu acabar com isso, vai ser só eu e você!"

#. Character:`asami` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_a5353bca"
msgid "Promis ?"
msgstr "Promete?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_a6b143ac"
msgid "Promis !"
msgstr "Prometo!"

#. Character:`asami` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_4efd7efa"
msgid "Alors dépêche-toi et fais attention à toi !"
msgstr "Então se apressa e toma cuidado!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t6c7d969cf9"
msgid "Mon dieu c'est d'un ennui..."
msgstr "Meu Deus, que tédio..."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "t6c331918d3"
msgid "Tout le monde a décidé de partir en vacance sauf moi je crois..."
msgstr "Acho que todo mundo resolveu sair de férias, menos eu..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "ta6d9455a9d"
msgid "Allez ma vielle, prend ton mal en patience, les choses vont s'arranger !"
msgstr "Aguenta firme, sua velha, engole o choro e tenha paciência... as coisas vão melhorar!"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t204a3e6b27"
msgid "..."
msgstr "..."

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "ta7bfc76e36"
msgid "......"
msgstr "......"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t3bbd1a1d60"
msgid "........."
msgstr "........."

#. Character:`sayuri` | Attributes:`depressed`
#: game/story/konbini_interior.dialogue
msgctxt "t96081ec5f7"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "tccb4bfa32a"
msgid "Ca ne va pas ?"
msgstr "Aconteceu alguma coisa?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "t0d9feb1588"
msgid "La reprise du travail est difficile ?"
msgstr "Está sendo difícil voltar ao trabalho?"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "tff5ad7b1c3"
msgid "Si ce n'était que ça..."
msgstr "Se fosse só isso..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "tc17f859a71"
msgid "J'ai bien eu la confirmation que l'assistante de mon m... de ce connard avait une relation depuis des années."
msgstr "Eu tive a confirmação de que a assistente do meu mari-[w] desse canalha tinha um caso com ele há anos."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "ted8e6d7c93"
msgid "Avoir des doutes est une chose mais... en avoir la confirmation..."
msgstr "Ter dúvidas é uma coisa, mas... ter a certeza..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t3512d7f59c"
msgid "J'ai l'impression d'avoir été stupide pendant si longtemps !"
msgstr "Sinto que fui uma estúpida por tanto tempo!"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "t1b44c5832b"
msgid "Ne soit pas si dure avec toi même..."
msgstr "Não seja tão dura consigo mesma..."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "t2dccfdcd96"
msgid "Vois ça du bon coté !"
msgstr "Olha pelo lado bom!"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "t0bd164fcde"
msgid "Il y a un bon coté ?"
msgstr "E tem um lado bom?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "t3ba2f1932e"
msgid "Tu peux désormais vivre ta vie sans culpabilité."
msgstr "Você agora pode viver a sua vida sem carregar nenhuma culpa"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "tc9ba34b532"
msgid "Oui... J'ai eu l'impression qu'un poids avait été enlevé de mes épaules."
msgstr "Sim... Sinto como se um peso enorme tivesse saído das minhas costas."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t3fddfee84a"
msgid "C'est pour ça que pour fêter ça je nous ai réservé une chambre au love hôtel, rien que pour toi et moi !"
msgstr "É por isso que, para comemorar, eu reservei um quarto no love hotel, só para mim e para você!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "t2e1b74f9b7"
msgid "Oh ! Vraiment ?"
msgstr "Ah! Sério?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t271d3f52d6"
msgid "Et cette fois ci je n'aurais plus ce petit sentiment de culpabilité, je vais pouvoir me lâcher !"
msgstr "E dessa vez eu não vou ter esse sentimento de culpa me segurando, vou poder me soltar de verdade!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/konbini_interior.dialogue
msgctxt "t38854292d1"
msgid "Je dois avoir peur ?"
msgstr "Devo ficar com medo?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t3ba68e83e7"
msgid "Peut-être...."
msgstr "Talvez..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "tb78625f7db"
msgid "Rendez-vous au Love Hôtel ce soir !"
msgstr "Me encontra no Love Hotel hoje à noite!"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "ta9a95c3bb4"
msgid "Interdiction de me poser un lapin !"
msgstr "Está proibido de me dar um bolo, hein!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/konbini_interior.dialogue
msgctxt "tb35ae9e090"
msgid "C'est pas mon genre !"
msgstr "Não é do meu feitio!"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "t187b7195f5"
msgid "Qu'est ce que tu comptes faire à présent ?"
msgstr "O que você pretende fazer agora?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "te2a9d828d8"
msgid "Penser à moi; rien qu'a moi sans culpabilité !"
msgstr "Pensar em mim; só em mim e sem culpa nenhuma!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t3932fc78bf"
msgid "Je vais pouvoir me lâcher !"
msgstr "Vou me soltar de verdade!"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "t7d858c20c1"
msgid "Préviens moi si tu veux de la compagnie !"
msgstr "Me avisa se quiser companhia!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t204fa7fa96"
msgid "Avec plaisir mais d'abord je vais vais me faire un plaisir de dégager toutes ses affaires de la maison !"
msgstr "Com prazer! Mas primeiro, vou ter o imenso prazer de esvaziar a casa com todas as coisas dele!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t5423db499c"
msgid "Passe me voir demain matin, j'aurais des nouvelles d'{{asami.n}} !"
msgstr "Passe aqui amanhã de manhã, vou ter notícias da {{asami.n}}!"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "tfe2f2a9b93"
msgid "Pas de problème !"
msgstr "Sem problemas!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "OH_BONJOUR_E87C47"
msgid "... Oh, bonjour..."
msgstr "...Ah, bom dia..."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "NOUS_AVONS_COLL_DES_AFFICHES_A_C98459"
msgid "Nous avons collé des affiches avec le portrait d'{{asami.n}} partout en ville."
msgstr "Nós espalhamos cartazes com a foto da {{asami.n}} por toda a cidade."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "AVEC_UN_PEU_DE_CHANCE_PEUT_TRE_B32713"
msgid "Avec un peu de chance, peut-être que... quelqu'un aura vu quelque chose..."
msgstr "Com um pouco de sorte, talvez... alguém tenha visto alguma coisa..."

#. Character:`noriko`
#: game/story/konbini_interior.dialogue
msgctxt "EST_CE_QU_ON_PEUT_METTRE_UNE_A_5938D7"
msgid "Est-ce qu'on peut mettre une affiche sur la vitrine ?"
msgstr "Podemos colar um cartaz na vitrine?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "JE_BIEN_S_R_ALLEZ_Y_413C46"
msgid "Je... Bien sûr... allez-y."
msgstr "Eu... Claro... Podem colar."

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "EXCUSEZ_MOI_J_AI_TELLEMENT_LA_1B5A31"
msgid "Excusez-moi... J'ai tellement la tête ailleurs."
msgstr "Me desculpem... Estou com a cabeça tão cheia."

#. Character:`saito` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "TU_N_AS_PAS_T_EXCUSER_VU_LA_SI_70E734"
msgid "Tu n'as pas à t'excuser, vu la situation."
msgstr "Você não precisa se desculpar, dada a situação."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "JE_N_ARR_TE_PAS_D_IMAGINER_LE_BB94C9"
msgid "Je n'arrête pas d'imaginer le pire et..."
msgstr "Eu não consigo parar de imaginar o pior e..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "CET_INSPECTEUR_DE_LA_POLICE_NE_329130"
msgid "Cet inspecteur de la police ne m'aide pas à aller mieux."
msgstr "Aquele inspetor da polícia não está ajudando em nada."

#. Character:`noriko`
#: game/story/konbini_interior.dialogue
msgctxt "COMMENT_A_438782"
msgid "Comment ça ?"
msgstr "Como assim?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "IL_IL_M_A_DIT_DE_ME_PR_PARER_A_D83FBB"
msgid "Il... il m'a dit de me préparer au pire et... et... et... de commencer à accepter le fait qu'elle serait déjà probablement...[w] morte..."
msgstr "Ele... ele me disse para me preparar para o pior e... e... e começar a aceitar o fato de que ela provavelmente já estaria...[w] morta..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "MAIS_QUELLE_PUTAIN_D_ORDURE_IL_3D2AF4"
msgid "Mais quelle putain d'ordure ! Ils ont à peine commencé leur enquête et n'ont encore rien fait !"
msgstr "Mas que tremendo filho da puta! Eles mal começaram a investigação e não fizeram absolutamente nada ainda!"

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "NORIKO_N_CALME_TOI_A2BE79"
msgid "{{noriko.n}}, calme-toi !"
msgstr "{{noriko.n}}, se acalme!"

#. Character:`noriko`
#: game/story/konbini_interior.dialogue
msgctxt "QUOI_NON_JE_REFUSE_DE_ME_CALME_158577"
msgid "Quoi ?! Non ! Je refuse de me calmer ! Ce type mériterait que..."
msgstr "O quê?! Não! Eu me recuso a ficar calma! Esse cara merecia era..."

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "NORIKO_N_TA_R_ACTION_ME_FAIT_0E4FCE"
msgid "{{noriko.n}}, ta réaction me fait du bien, j'ai ressenti exactement la même chose..."
msgstr "{{noriko.n}}, ver você brava assim até me conforta, eu senti exatamente a mesma coisa..."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "MAIS_PLUS_LE_TEMPS_PASSE_ET_PL_988B5F"
msgid "Mais plus le temps passe, et plus je..."
msgstr "Mas quanto mais o tempo passa, mais eu..."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "NON_JE_REFUSE_D_ABANDONNER_73B2E8"
msgid "Non, je refuse d'abandonner !"
msgstr "Não, eu me recuso a desistir!"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "JE_VAIS_CONTINUER_CHERCHER_ET_899FEA"
msgid "Je vais continuer à chercher et à y croire."
msgstr "Eu vou continuar procurando e vou continuar acreditando."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "JE_SUIS_S_R_QU_ELLE_EST_L_QU_E_53B413"
msgid "Je suis sûr qu'elle est là, qu'elle nous attend ! Qu'elle croit en nous !"
msgstr "Tenho certeza de que ela está bem, esperando por nós! Que ela acredita na gente!"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "EXACTEMENT_ON_NE_L_CHERA_RIEN_837771"
msgid "Exactement ! On ne lâchera rien !"
msgstr "Exatamente! Nós não vamos desistir de nada!"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "W_VOUS_TES_DES_AMOURS_C3D4F0"
msgid "...[w] Vous êtes des amours !"
msgstr "...[w] Vocês são uns amores!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "JE_SAIS_QUE_VOUS_AVEZ_D_J_FAIT_90F32C"
msgid "Je sais que vous avez déjà fait beaucoup mais... {{saito.n}}... Est-ce que..."
msgstr "Eu sei que vocês já fizeram muito, mas... {{saito.n}}... Será que você..."

#. Character:`noriko`
#: game/story/konbini_interior.dialogue
msgctxt "JE_VAIS_ATTENDRE_DEHORS_C2C7C5"
msgid "Je vais attendre dehors !"
msgstr "Vou esperar lá fora!"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "D_ACCORD_MERCI_39BCE8"
msgid "D'accord, merci."
msgstr "Tudo bem, obrigado."

#. Character:`sayuri` | Attributes:`depressed`
#: game/story/konbini_interior.dialogue
msgctxt "JE_NE_DORS_PLUS_ENTRE_LA_TRIST_3BC3A2"
msgid "Je... ne dors plus... entre la tristesse, le stress et les angoisses, j'ai l'impression que mon esprit est en train de lâcher."
msgstr "Eu... não durmo mais... entre a tristeza, o estresse e a ansiedade, sinto que a minha mente está prestes a desmoronar."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "TU_ACCEPTERAIS_DE_DORMIR_AVEC_D6118F"
msgid "Tu accepterais de dormir avec moi ce soir ?"
msgstr "Você aceitaria dormir comigo esta noite?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "TU_ACCEPTERAIS_DE_DORMIR_LA_MA_9DD35B"
msgid "Tu accepterais de dormir à la maison ce soir ?"
msgstr "Você aceitaria dormir lá em casa esta noite?"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "JUSTE_TA_PR_SENCE_ME_SUFFIRAIT_4E5BA7"
msgid "Juste ta présence me suffirait... s'il te plaît..."
msgstr "Só a sua presença já bastaria... por favor..."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "BIEN_S_R_TOUT_CE_QUE_TU_VOUDRA_8A95E8"
msgid "Bien sûr ! Tout ce que tu voudras !"
msgstr "Claro! O que você quiser!"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "MERCI_138A8F"
msgid "Merci..."
msgstr "Obrigada..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "LAISSE_MOI_FERMER_ET_JE_TE_REJ_B1F8D3"
msgid "Laisse-moi fermer et je te rejoins !"
msgstr "Deixa eu fechar a loja e eu te acompanho!"

#. Character:`netoru`
#: game/story/konbini_interior.dialogue
msgctxt "ET_JE_SUIS_SINC_REMENT_D_SOL_ABB8CD"
msgid "... et je suis sincèrement désolé pour votre fille."
msgstr "... e eu sinto muito sinceramente pela sua filha."

#. Character:`netoru` | Attributes:`bad`
#: game/story/konbini_interior.dialogue
msgctxt "S_IL_Y_A_QUOI_QUE_CE_SOIT_QUE_A0DEEF"
msgid "S'il y a quoi que ce soit que je puisse faire pour vous, n'hésitez pas à me demander."
msgstr "Se houver qualquer coisa que eu possa fazer pela senhora, por favor, não hesite em me pedir."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "JE_MERCI_1D4B90"
msgid "Je... merci."
msgstr "Eu... obrigada."

#. Character:`netoru`
#: game/story/konbini_interior.dialogue
msgctxt "J_AIMERAIS_BEAUCOUP_VOUS_INVIT_8BCB7A"
msgid "J'aimerais beaucoup vous inviter à boire un café, je suis sûr que cela vous fera le plus grand b-"
msgstr "Eu gostaria muito de convidá-la para tomar um café, tenho certeza de que isso faria muito bem-"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "CARTE_TOI_D_ELLE_ELLE_N_ACCEP_E4334F"
msgid "Écarte-toi d'elle ! Elle n'accepte rien de toi, tu n'as que de mauvaises intentions."
msgstr "Fica longe dela! Ela não quer nada de você, eu sei bem o que você está tramando."

#. Character:`netoru` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "TOI_3FEEC3"
msgid "Toi..."
msgstr "Seu..."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "SAITO_N_QUE_SE_PASSE_T_IL_JE_B855B0"
msgid "{{saito.n}}, que se passe-t-il ? Je ne t'ai jamais vu aussi énervé !"
msgstr "{{saito.n}}, o que está acontecendo? Eu nunca te vi tão irritado!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/konbini_interior.dialogue
msgctxt "JE_NE_SOUHAITE_CAUSER_AUCUN_PR_37C833"
msgid "Je ne souhaite causer aucun problème ici, encore une fois je suis là si besoin, ma proposition tient toujours."
msgstr "Não quero causar nenhum problema aqui. Mais uma vez, estou à disposição caso precise, a minha proposta continua de pé."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "OH_ET_UNE_DERNI_RE_CHOSE_FAITE_C548B8"
msgid "Oh, et une dernière chose, faites attention à lui, il n'est pas ce qu'il prétend être. Prenez soin de vous."
msgstr "Ah, e uma última coisa, tome cuidado com ele, ele não é quem diz ser. Cuide-se."

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "QUELLE_ORDURE_6C2E26"
msgid "Quelle ordure..."
msgstr "Que canalha..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "TU_M_EXPLIQUES_CE_QU_IL_SE_PAS_A4A119"
msgid "Tu m'expliques ce qu'il se passe ?"
msgstr "Dá para me explicar o que está acontecendo?"

#. Character:`saito` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "JE_C_EST_DIFFICILE_EXPLIQUER_E_3AB609"
msgid "Je... c'est difficile à expliquer, et je n'aimerais pas donner de faux espoirs avant d'être sûr de t'en parler."
msgstr "Eu... é difícil de explicar, e eu não queria te dar falsas esperanças antes de ter certeza do que falar."

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "JE_VEUX_JUSTE_QUE_TU_ME_PROMET_64ECEB"
msgid "Je veux juste que tu me promettes une chose. N'accepte rien à boire venant de lui, ce type est dangereux."
msgstr "Eu só quero que você me prometa uma coisa. Não aceite nada para beber vindo dele, esse cara é perigoso."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "PFFF_SI_CE_N_EST_QUE_A_JE_N_A_304FFE"
msgid "... Pfff, si ce n'est que ça... je n'avais pas l'intention d'accepter sa proposition de toute façon, mais c'est compliqué de remballer quelqu'un de courtois."
msgstr "... Pff, se é só isso... eu já não tinha intenção de aceitar o convite dele de qualquer forma, mas é complicado dar um fora em alguém que está sendo cortês."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "DIS_MOI_PLUT_T_CE_QUE_TU_AS_EN_3B444E"
msgid "Dis-moi plutôt ce que tu as en tête. C'est quoi cette histoire de faux espoirs ?!"
msgstr "Me diga logo o que você tem na cabeça. Que história é essa de falsas esperanças?!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "JE_TE_PROMET_DE_TOUT_TE_RACONT_873488"
msgid "Je te promet de tout te raconter mais là je dois absolument suivre cet homme."
msgstr "Eu prometo te contar tudo, mas agora eu preciso mesmo seguir aquele homem."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "JE_PENSE_SINCEREMENT_QU_IL_EST_B53258"
msgid "Je pense sincerement qu'il est lié a la disparition d'{{asami.n}} justement."
msgstr "Acho sinceramente que ele está ligado diretamente ao sumiço da {{asami.n}}."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "QUOI_CELUI_QUI_A_VOULU_M_OFFRI_23FED8"
msgid "Quoi ?! Celui qui a voulu m'offrir un café ?"
msgstr "O quê?! Aquele que queria me oferecer um café"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "OUI_96DBEF"
msgid "Oui."
msgstr "Sim."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "W_JE_VAIS_LE_TUER_3A7860"
msgid "...[w] Je vais le tuer !"
msgstr "...[w] Desgraçado... Eu vou matar ele!"

#. Character:`saito` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "NOUS_TIONS_EN_TRAIN_DE_LE_SUIV_D17324"
msgid "Nous étions en train de le suivre justement, mais j'avais peur qu'il s'en prenne à toi..."
msgstr "Nós estávamos seguindo ele agora mesmo, mas fiquei com medo de que ele tentasse algo contra você..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "JE_DOIS_ME_D_P_CHER_D_AILLEURS_F263E8"
msgid "Je dois me dépêcher d'ailleurs, sinon on le perdra de vue."
msgstr "Eu preciso correr, senão vamos perder ele de vista."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "DANS_CE_CAS_JE_VIENS_529848"
msgid "Dans ce cas je viens."
msgstr "Nesse caso, eu vou junto."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "D_ACCORD_6B92B6"
msgid "... D'accord."
msgstr "... Tudo bem."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "C_EST_ENFIN_TERMIN_1CC42C"
msgid "C'est enfin terminé !"
msgstr "Finalmente acabou!"

#. Character:`sayuri` | Attributes:`depressed`
#: game/story/konbini_interior.dialogue
msgctxt "UNE_JOURN_E_DE_PLUS_OU_DE_MOIN_0462BB"
msgid "Une journée de plus ou de moins... Quelle importance."
msgstr "Um dia a mais ou a menos... Que diferença faz."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "SANS_MA_PETITE_CH_RIE_JE_N_AI_F1F6FE"
msgid "Sans ma petite chérie, je n'ai même plus envie de rentrer à la maison."
msgstr "Sem a minha filhinha, eu não tenho nem mais vontade de voltar para casa."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "ET_MAINTENANT_C_EST_SAITO_QUI_71EBE5"
msgid "Et maintenant, c'est {{saito}} qui s'était si bien occupé de moi qui a des problèmes..."
msgstr "E agora até o {{saito}}, que cuidou tão bem de mim, está metido em problemas..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "JE_DOIS_PORTER_MALHEUR_76B3B7"
msgid "Je dois porter malheur..."
msgstr "Eu devo herdar o azar..."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "NON_JE_NE_DOIS_PAS_ME_MORFONDR_E28A88"
msgid "Non, je ne dois pas me morfondre ainsi. Demain, j'irai voir {{yasuka.n}} pour discuter de tout ça !"
msgstr "Não, eu não posso ficar me lamentando assim. Amanhã vou ver a {{yasuka.n}} para conversarmos sobre tudo isso!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "EN_ATTENDANT_IL_EST_TEMPS_DE_R_D7EC10"
msgid "En attendant, il est temps de rentrer."
msgstr "Por enquanto, é hora de ir para casa."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "QU_EST_CE_QUI_TE_FAIS_SOURIRE_F6750C"
msgid "Qu'est-ce qui te fait sourire comme ça ?"
msgstr ""

#. Character:`asami` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "JE_REPENSAIS_UN_TYPE_QUI_M_OBS_90074C"
msgid "Je repensais à un type qui m'observait dans le parc tout à l'heure."
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "JE_LISAIS_TRANQUILLEMENT_A_L_O_4B4CCB"
msgid "Je lisais tranquillement à l'ombre sous un arbre. Et il y avait pleins de pétales de cerisiers qui tombaient..."
msgstr ""

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "UN_TYPE_LOUCHE_62EA2B"
msgid "Un type louche ?"
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "HONNETEMENT_DES_TROIS_QUE_J_AI_6DDC39"
msgid "Honnêtement, des trois que j'ai croisés dans le parc, c'était le plus normal."
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "J_AI_BIEN_VU_SON_REGARD_INSIST_CA9CB2"
msgid "J'ai bien vu son regard insistant donc je me suis levée et je lui ai demandé pourquoi il me regardait."
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "ET_IL_MA_SORTIT_CETTE_PHRASE_T_5EE161"
msgid "Et il m'a sorti cette phrase tellement ringarde..."
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "LA_SC_NE_QUE_J_AVAIS_SOUS_LES_F53DAF"
msgid "\"La scène que j'avais sous les yeux était vraiment belle...\""
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "BON_SANG_EB34A0"
msgid "Bon sang..."
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "TU_VOIS_TOI_AUSSI_TU_TROUVES_A_08D9A4"
msgid "Tu vois ? Toi aussi tu trouves ça nul."
msgstr ""

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "C_EST_TOI_QUI_EST_NULLE_IL_A_T_D99A4E"
msgid "C'est toi qui es nulle ! Il a été franc avec toi et toi tu te moques de lui..."
msgstr ""

#. Character:`sayuri` | Attributes:`depressed`
#: game/story/konbini_interior.dialogue
msgctxt "MA_FILLE_FINIRA_SEUL_AVEC_DES_3B4274"
msgid "Ma fille finira seule avec des chats c'est sûr..."
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "MAIS_MAMAN_ARR_TE_ME_PORTE_PAS_B8761F"
msgid "Mais maman arrête, me porte pas la poisse !!"
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "ALORS_MA_CH_RIE_TU_PASSES_UNE_ADC369"
msgid "Alors ma chérie ? Tu passes une bonne journée ?"
msgstr ""

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "TU_AS_PU_REVOIR_GAR_ON_OU_MIEU_8E8995"
msgid "Tu as pu revoir le garçon ? Ou mieux... pris son numéro pour ta chère mère ?"
msgstr ""

#. Character:`asami` | Attributes:`bored`
#: game/story/konbini_interior.dialogue
msgctxt "PFF_ARRETE_TU_N_ES_M_ME_PAS_DR_04F5E7"
msgid "Pff arrête... Tu n'es même pas drôle. Tu as l'âge d'être sa mère !"
msgstr ""

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "JE_TE_TROUVE_BIEN_INSOLENTE_ED4B18"
