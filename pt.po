#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_4b225ce5"
msgid "Et tu peux être sur qu'il te fera bouffer ta putain d'assurance."
msgstr "E pode ter certeza de que ele vai fazer você engolir essa sua audácia de merda."

#. Character:`nobu`
