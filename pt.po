#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_51e7174e"
msgid "Non ! C'est pas une façon de parler à sa grande soeur !"
msgstr "Não! Isso não é jeito de falar com a sua irmã mais velha!"

#. Character:`unknown`
#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_a3f7cb25"
msgid "Tant que tu ne seras pas plus poli tu resteras dehors."
msgstr "Enquanto você não for mais educado, vai mofar aí fora."

