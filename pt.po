#: game/story/home_player_exterior.dialogue
msgctxt "TANT_QUE_TU_VIVRAS_SOUS_MON_TO_952C8D"
msgid "Tant que tu vivras sous mon toit, tu obéiras à mes règles !"
msgstr "Enquanto você estiver morando embaixo do meu teto, vai seguir as minhas regras!"

