msgctxt "BONJOUR_KIMOCHI_N_TOUJOURS_AUS_A48F12"
msgid "Bonjour {{kimochi.n}}, toujours aussi énergique."
msgstr "Olá, {{kimochi.n}}, sempre cheio de energia."

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_hallway.dialogue
msgctxt "NOUS_TIONS_POURSUIVIS_ON_A_DU_8DDD8B"
msgid "Nous étions poursuivis... On a dû courir depuis le parc."
msgstr "Estávamos sendo perseguidos... Tivemos que vir correndo lá do parque."

#. Character:`noriko`
#: game/story/home_player_hallway.dialogue
msgctxt "DEPUIS_QUE_SAITO_N_N_EST_PLUS_BBBE1F"
msgid "Depuis que {{saito.n}} n'est plus là... Certaines brutes sont revenues."
msgstr "Desde que o {{saito.n}} sumiu... alguns valentões voltaram."

#. Character:`kimochi` | Attributes:`happy`
#: game/story/home_player_hallway.dialogue
msgctxt "ATTEND_UN_PEU_QUE_MACUMBA_N_RE_37BF3E"
msgid "Attends un peu que {{macumba.n}} revienne et tu verras.."
msgstr "Espera só o {{macumba.n}} voltar e você vai ver só..."

#. Character:`noriko`
#: game/story/home_player_hallway.dialogue
msgctxt "DE_PLUS_LE_P_RE_DE_L_UNE_DE_CE_019B30"
msgid "De plus, le père de l'un de ces trois idiots n'est autre que l'inspecteur de police qui était venu chez nous..."
msgstr "E pra piorar, um daqueles três idiotas é filho do inspetor de polícia que veio aqui em casa..."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_hallway.dialogue
msgctxt "BON_SANG_NE_ME_DIS_PAS_QUE_9254D9"
msgid "Bon sang ne me dis pas que..."
msgstr "Droga, não me diga que..."

#. Character:`noriko`
#: game/story/home_player_hallway.dialogue
msgctxt "IL_NE_L_A_PAS_LAISS_FAIRE_NE_T_5E209D"
msgid "Il ne l'a pas laissé faire, ne t'inquiète pas..."
msgstr "O inspetor não deixou barato, não se preocupe..."

#. Character:`yasuka`
#: game/story/home_player_hallway.dialogue
msgctxt "MA_CH_RIE_CHAQUE_JOUR_QUI_PASS_1CAB8F"
msgid "Ma chérie, chaque jour qui passe et je suis de plus en plus inquiète, cette situation semble être de plus en plus hors de contrôle."
msgstr "Querida, a cada dia que passa eu fico mais preocupada. Essa situação parece estar saindo totalmente do controle."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_hallway.dialogue
msgctxt "CA_CA_VA_ALLER_B99D81"
msgid "Ça... ça va aller ?"
msgstr "A gente... a gente vai ficar bem?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_hallway.dialogue
msgctxt "OUI_JE_NE_ME_LAISSERAIS_PAS_AB_04C32D"
msgid "Oui ! Je ne me laisserai pas abattre pour autant."
msgstr "Sim! Eu não vou me deixar abater."

#. Character:`yasuka`
#: game/story/home_player_hallway.dialogue
msgctxt "J_AI_ENCORE_DE_LA_RESSOURCE_ET_887E51"
msgid "J'ai encore de la ressource et certains contacts qui pourraient peut-être être utile."
msgstr "Eu ainda tenho meus recursos e alguns contatos que podem ser úteis."

#. Character:`yasuka`
#: game/story/home_player_hallway.dialogue
msgctxt "M_ME_SI_J_AURAIS_PR_F_R_LAISSE_4F57FD"
msgid "Même si j'aurais préféré laisser tout ça derrière moi..."
msgstr "Mesmo que eu preferisse ter deixado tudo isso no passado..."

