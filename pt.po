msgstr "[font_size=14]Kkkk, que vergonha alheia... Estou quase ficando com pena do cara.[/font_size]"

#. Character:`noriko`
#: game/story/home_player_exterior.dialogue
msgctxt "FONT_SIZE_14_JE_N_AIME_PAS_A_98AF7C"
msgid "[font_size=14]Je n'aime pas ça, ça me donne l'impression qu'il s'adresse aussi à moi.[/font_size]"
msgstr "[font_size=14]Não gosto disso, parece até que ele está dando esse esporro em mim também.[/font_size]"

#. Character:`takeo`
#: game/story/home_player_exterior.dialogue
msgctxt "PUTAIN_F6D757"
msgid "Putain !"
msgstr "Caralho!"

