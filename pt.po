msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "MERCI_JE_CROIS_QUE_JE_VAIS_AVO_607BED"
msgid "Merci... Je crois que je vais avoir besoin de ton soutien, peu importe la décision que je vais prendre au final."
msgstr ""

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_wifi_a627f3ab"
msgid "Ah merde, {{noriko.n}} bloque le chemin, je dois faire au plus vite et fouiller [color=yellow]sa chambre[/color]."
msgstr "Ah merda, a {{noriko.n}} está bloqueando o caminho, preciso ser rápido e vasculhar [color=yellow]o quarto dela[/color]."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "corridor_lock_b9ec7245"
msgid "Ah mince, la salle de bain !"
msgstr "Ah droga, o banheiro!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "corridor_lock_112a3331"
msgid "Un peu plus et je serais parti travailler sans avoir pris ma douche."
msgstr "Por pouco eu não saio para trabalhar sem lavar a cara."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "corridor_lock_c9bf00f5"
msgid "Je dois demander à {{noriko.n}}."
msgstr "Eu preciso perguntar para a {{noriko.n}}."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "corridor_lock_17830108"
msgid "Je ne veux pas inquiéter {{yasuka.n}}."
msgstr "Não quero preocupar a {{yasuka.n}}."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_5d1e865c"
msgid "Tu voulais me dire quelque chose ?"
msgstr "Você queria me dizer algo?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t786a368cb1"
msgid "Discuter"
msgstr "Conversar"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t85a0d68f24"
msgid "Baladeur MP3"
msgstr "MP3"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t6ce0e2618b"
msgid "Baladeur MP3"
msgstr "MP3"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t4170e3a7aa"
msgid "Prendre un bain."
msgstr "Tomar um banho."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "ta3f1ded669"
msgid "Sexe"
msgstr "Sexo"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "tcb65e2b33f"
msgid "Qu'est-ce que tu fais ?"
msgstr "O que você está fazendo?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t8cbe2758f3"
msgid "Je t'attendais !"
msgstr "Eu estava te esperando!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t213bc6254b"
msgid "Tu veux dire que tu voulais qu'on..."
msgstr "Você quer dizer que queria que a gente..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t7dcfd17a5e"
msgid "Ah ! Doucement ! Je savais pas que tu étais si pressée..."
msgstr "Ah! Devagar! Eu não sabia que você estava com tanta pressa..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "tc30644acd0"
msgid "Mmhhh ferme-là !"
msgstr "Mmhhh, cala a boca!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t812f02fd06"
msgid "Mais {{yasuka.n}} pourrait nous surprendre..."
msgstr "Mas a {{yasuka.n}} pode nos pegar no flagra..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "tf90eca5426"
msgid "Alors fais moins de bruit !"
msgstr "Então faz menos barulho!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t6d9ad3331f"
msgid "Finalement tu sembles bien motivé."
msgstr "No fim das contas, você parece bem motivado."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t676db2df8d"
msgid "Tu veux que j'arrête ?"
msgstr "Você quer que eu pare?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t39ccd05bbb"
msgid "NON !"
msgstr "NÃO!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t636dac2e62"
msgid "Shhht !"
msgstr "Sshhh!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t473ad6a9c6"
msgid "[font_size=14]Je veux dire non ![/font_size]"
msgstr "[font_size=14]Eu quero dizer, não![/font_size]"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t536e6380a9"
msgid "[font_size=14]Plus fort ![/font_size]"
msgstr "[font_size=14]Mais forte![/font_size]"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t0ae29e84c6"
msgid "Mhhhh oui !"
msgstr "Mhhhh sim!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "tbf11166cbb"
msgid "[font_size=14]Je tiens plus debout...[/font_size]"
msgstr "[font_size=14]Não consigo mais ficar de pé...[/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "tf5f953dbdb"
msgid "[font_size=14]Alors laisse-toi faire.[/font_size]"
msgstr "[font_size=14]Então apenas se entregue.[/font_size]"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "tbbf445a06b"
msgid "[font_size=14]Hey ! Qu'est-ce que tu fais ?![/font_size]"
msgstr "[font_size=14]Ei! O que você está fazendo?![/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t6a32302f0d"
msgid "[font_size=14]Il me semblait pourtant que tu appréçiais.[/font_size]"
msgstr "[font_size=14]Pensei que você estivesse gostando.[/font_size]"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t733d02bdbd"
msgid "[font_size=14]Tu aurais pu me prévenir ![/font_size]"
msgstr "[font_size=14]Você poderia ter me avisado![/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_4fce3151"
msgid "Ça te dirait de prendre un bain ensemble ?"
msgstr "O que você acha de tomarmos um banho juntos?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_9885985c"
msgid "Petit coquin..."
msgstr "Seu safadinho..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_56c4a2e4"
msgid "Je prend ça pour un oui !"
msgstr "Vou considerar isso como um sim!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_7f38982e"
msgid "Ahhhhh, quel bonheur."
msgstr "Ahhhhh, que felicidade."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_e787a87b"
msgid "Après une bonne journée de travail, rien de tel qu'un bon bain chaud."
msgstr "Não há nada como um bom banho quente, depois de um bom dia de trabalho."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_5d3850be"
msgid "En bonne compagnie..."
msgstr "E em ótima companhia..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_b3ea5326"
msgid "Ce n'est pas moi qui dirai le contraire."
msgstr "Eu é que não vou dizer o contrário."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_994d89f7"
msgid "Je suis heureuse de voir qu'à présent, c'est toi qui demandes à te baigner avec moi."
msgstr "Fico feliz de ver que agora você que está pedindo pra tomar banho comigo."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_4931fc30"
msgid "Honnêtement..."
msgstr "Honestamente..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_b528a23b"
msgid "Je devais être fou. Je resterais bien collé à toi si je le pouvais."
msgstr "Eu devia estar louco. Eu ficaria grudado em você o tempo todo se pudesse."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_4aaa7430"
msgid "Idiot... Mais ça ne me déplairait pas pour autant."
msgstr "Seu bobo... Mas eu não reclamaria se você fizesse isso."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_770e3932"
msgid "Les gens pourraient être choqués par contre."
msgstr "Mas por outro lado, as pessoas poderiam ficar chocadas."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_a75b2630"
msgid "Cela ne m'importe plus..."
msgstr "Isso não importa mais para mim..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_bc6655b7"
msgid "J'ai attendu des années avant de pouvoir être aussi heureuse."
msgstr "Esperei anos para poder ser feliz assim."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_86c1ac24"
msgid "Même si personne ne l'accepte."
msgstr "Mesmo que ninguém aceite."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_9caff683"
msgid "Je veux rester avec toi..."
msgstr "Eu quero ficar com você..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_a0261f49"
msgid "Oh !"
msgstr "Oh!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_03a24dd3"
msgid "Je sens quelque chose de dur soudainement dans mon dos..."
msgstr "Senti algo duro de repente nas minhas costas..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_1e59f4d3"
msgid "Et je crois avoir une idée de ce que c'est."
msgstr "E acho que tenho uma ideia do que seja."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_a7c69adf"
msgid "...On va dans la chambre ?"
msgstr "...Vamos para o quarto?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "t675af5c640"
msgid "[next]"
msgstr "[next]"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "tf9f9a0503e"
msgid "Continuer dans la chambre de {{yasuka.n}}"
msgstr "Continuar no quarto da {{yasuka.n}}"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t65927365f7"
msgid "Arrêter là pour aujourd'hui."
msgstr "Parar por hoje."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_da14fd4f"
msgid "Je me demandais quand tu allais enfin me le demander."
msgstr "Eu estava me perguntando quando você finalmente iria me pedir isso."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_23739cd8"
msgid "Maintenant que je prends enfin du plaisir, tu n'as pas intérêt à te défiler !"
msgstr "Agora que eu finalmente estou tendo prazer, é bom você dar conta do recado!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_d8aa13e0"
msgid "Ce serait mal me connaître !"
msgstr "Se você acha isso, claramente não me conhece o suficiente!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "te0df105c29"
msgid "Tu viens ?"
msgstr "Você vem?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t3c4fb61ee5"
msgid "Discuter"
msgstr "Conversar"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t33a780d3b9"
msgid "Sexe"
msgstr "Sexo"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "tac447fde05"
msgid "Partir"
msgstr "Sair"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_14d1dd88"
msgid "Eh bien, vous en faites du bruit, que s'est-il passé ?"
msgstr "Ora, quanto barulho vocês estão fazendo! O que aconteceu?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c1b81041"
msgid "Disons que j'ai passé une très bonne nuit."
msgstr "Digamos que tive uma noite muito boa."

#. Character:`yasuka` | Attributes:`-happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d164d18b"
msgid "...En effet... Ton regard est différent ce matin..."
msgstr "..De fato... Seu olhar está diferente esta manhã..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f8ab96b4"
msgid "Ah ?"
msgstr "Ah é?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_eb97d1ff"
msgid "Tu me racontes ?"
msgstr "Vai me contar?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f7646059"
msgid "Euh... J'ai peur que tout ne soit qu'un rêve, alors pour l'instant, je préfère ne rien te dire..."
msgstr "Er... Tenho medo que tudo não passe de um sonho, então, por enquanto, prefiro não dizer nada..."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cf9964e7"
msgid "Oooh... Mais je suis curieuse moi !"
msgstr "Aaah... Mas eu estou curiosa!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_125f8002"
msgid "{{yasuka.n}} ! Je te promets de tout te raconter, mais... pas maintenant."
msgstr "{{yasuka.n}}! Eu prometo te contar tudo, mas... não agora."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_04b76371"
msgid "C'était un rêve pervers ?! C'est ça ? Bon, si tu as encore taché tes draps, n'oublie pas d'aller toi-même les laver !"
msgstr "Foi um sonho pervertido?! É isso? Bom, se você manchou os lençóis de novo, não esqueça que você mesmo vai ter que lavar!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ab119cf8"
msgid "Quoi ?! Non, ce n'est pas... Rien à voir avec ce genre de rêve !"
msgstr "O quê?! Não, não é... Não tem nada a ver com esse tipo de sonho!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_46b1901a"
msgid "En fait, c'était bien mieux !"
msgstr "Na verdade, foi muito melhor!"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2c3616ea"
msgid "Mieux ?! Eh bien, je souhaiterais avoir cette chance..."
msgstr "Muito melhor?! Bem, eu gostaria de ter essa sorte..."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d6cdaca2"
msgid "En ce moment, les miens sont déprimants."
msgstr "Ultimamente, os meus são deprimentes."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0fed46bb"
msgid "Tu sais que si quelque chose te tracasse, tu peux toujours m'en parler !"
msgstr "Você sabe que se algo estiver te incomodando, pode sempre falar comigo!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_JE_TE_D_COUVRE_UN_NOUVEAU_C_6E5622"
msgid "Oh, je te découvre un nouveau caractère, j'aime beaucoup ce nouveau {{saito.n}}, mais il s'agit de mes problèmes et je ne veux pas te préoccuper avec ça !"
msgstr "Ah, estou descobrindo um novo lado seu. Gosto muito desse novo {{saito.n}}, mas esses problemas são meus e não quero te preocupar com isso!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0b2a5dae"
msgid "{{yasuka.n}}, avec tout ce que tu as fait pour moi, je veux pouvoir t'aider ! Dis-moi ce qu'il se passe !"
msgstr "{{yasuka.n}}, depois de tudo que você fez por mim, eu quero poder te ajudar! Me diga o que está acontecendo!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1dfe9efb"
msgid "Nous sommes encore dans le rouge, et nous ne sommes encore qu'au début du mois..."
msgstr "Estamos no vermelho de novo, e ainda estamos no começo do mês..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c24e641c"
msgid "Mon travail actuel ne suffit plus pour rembourser les dettes que nous avons."
msgstr "Meu trabalho atual não é mais suficiente para pagar as dívidas que temos."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_53b3469f"
msgid "Un instant, de quelles dettes parles-tu exactement ?"
msgstr "Espere um minuto, de quais dívidas você está falando exatamente?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_da6b987f"
msgid "Je ne sais pas si c'est judicieux de..."
msgstr "Não sei se é prudente..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c111572e"
msgid "{{yasuka.n}}, pour pouvoir aider, j'ai besoin de savoir ce qu'il se passe même si c'est difficile !"
msgstr "{{yasuka.n}}, para eu poder ajudar, eu preciso saber o que está acontecendo, mesmo que seja difícil!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_efcc80f4"
msgid "D'accord, d'accord, je vais tout te dire..."
msgstr "Está bem, está bem, eu vou te contar tudo..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1d34a746"
msgid "J'ai épuisé toutes mes économies en essayant de rembourser les dettes de ton père avant qu'il ne disparaisse avec cette..."
msgstr "Esgotei todas as minhas economias tentando pagar as dívidas do seu pai antes de ele desaparecer com aquela..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_24c46895"
msgid "Bref !"
msgstr "Enfim!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_42f155da"
msgid "Les dettes de mon père ? Quoi ?! Mais il t'a laissé ses dettes ?"
msgstr "As dívidas do meu pai? O quê?! Ele deixou as dívidas dele pra você pagar?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0d896760"
msgid "{{yasuka.n}}... Je promets de tout faire pour t'aider à tout rembourser !"
msgstr "{{yasuka.n}}... Eu prometo fazer de tudo para te ajudar a quitar tudo isso!"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ca23b5c3"
msgid "C'est gentil mon chéri, mais ton argent de poche, même économisé sur plusieurs années, ne suffirait pas..."
msgstr "É muita gentileza, querido, mas sua mesada, mesmo guardada por anos, não seria suficiente..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a0f720dc"
msgid "{{yasuka.n}}... Dis-moi juste... De combien a-t-on besoin pour sortir des ennuis ?"
msgstr "{{yasuka.n}}... Só me diga... De quanto a gente precisa pra sair desse sufoco?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ae713cd0_1"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f7f9b095"
msgid "Allez, dis-moi !"
msgstr "Vamos, me diga!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8dc5c85a"
msgid "[speed=0.2]80 000 000 ¥..."
msgstr "[speed=0.2]Oitenta... milhões de ienes..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_76ba1dec"
msgid "Quoi ?![w] Mais...[w] Comment ?"
msgstr "O quê?![w] Mas...[w] Como?"

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3faca6c4"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9342aa64"
msgid "Avant de s'enfuir avec cette p... nouvelle femme, ton père avait des problèmes d'argent."
msgstr "Antes de fugir com aquela pu... com aquela mulher, seu pai tinha sérios problemas financeiros."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0a4f1966"
msgid "Il a pas mal emprunté à des gens... peu recommandables."
msgstr "Ele pegou muito dinheiro emprestado com pessoas... pouco recomendáveis."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a13d5b48"
msgid "Quand il est parti sans laisser la moindre trace, ces personnes sont remontées jusqu'à moi et m'ont bien fait comprendre qu'il était désormais de ma responsabilité de rembourser sa dette..."
msgstr "Quando ele sumiu sem deixar rastro, essas pessoas vieram atrás de mim e deixaram claro que agora era minha responsabilidade pagar a dívida dele..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f7863e92"
msgid "Toi ?! Mais pourquoi ?"
msgstr "Sua?! Mas por quê?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7aa24a09"
msgid "...Comme tu n'avais pas d'autre famille et que ton père était un ami de longue date, je t'ai recueilli chez moi..."
msgstr "...Como você não tinha mais ninguém e seu pai era um amigo de longa data, eu te acolhi..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_41476939"
msgid "Et te prendre en charge signifie également prendre en charge les dettes de ton père."
msgstr "E cuidar de você significa também assumir as dívidas do seu pai."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_349c74e9"
msgid "Putain, mais comment ça se fait que j'ai jamais entendu parler de ça ?!!"
msgstr "Porra, mas como é que eu nunca ouvi falar disso?!!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ccde9871"
msgid "Je comprends mieux pourquoi {{noriko.n}} me traite de parasite, c'est parce que j'en suis un bordel."
msgstr "Agora eu entendo por que a {{noriko.n}} me chama de parasita... É porque eu sou um mesmo, que merda."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_73486ec0"
msgid "Putain ! C'est ma faute...!"
msgstr "Caralho! A culpa é toda minha...!"

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_84029342"
msgid "Jeune homme, je le vois dans tes yeux, ne pense pas un seul instant que tu es responsable de tout ça !"
msgstr "Mocinho, estou vendo no seu olhar! Não pense nem por um segundo que você é o responsável por tudo isso!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8f8d46ef"
msgid "Mais si je..."
msgstr "Mas se eu..."

#. Character:`yasuka` | Attributes:`-upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_56b07a1b"
msgid "Ce qui est fait est fait, et je ne regrette pas un seul instant de t'avoir recueillie, d'accord ?"
msgstr "O que passou, passou, e eu não me arrependo nem por um instante de ter te acolhido, ouviu bem?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3b216443"
msgid "Merci {{yasuka.n}}..."
msgstr "Obrigado, {{yasuka.n}}..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e2439cd5"
msgid "Je te jure de faire tout mon possible pour nous sortir de cette situation !"
msgstr "Eu juro que vou fazer de tudo para tirar a gente dessa situação!"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_214c2f8d"
msgid "Rhoo... Arrête. Ne me fais pas pleurer dès le matin !"
msgstr "Aaah... Pare com isso. Não me faça chorar logo de manhã!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a547d896"
msgid "On va s'en sortir, fais-moi confiance !"
msgstr "A gente vai dar um jeito, confia em mim!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_62e76816"
msgid "Il me reste une dernière possibilité pour rembourser nos dettes... avant qu'on ne nous saisisse la maison..."
msgstr "Ainda me resta uma última cartada para quitar as dívidas... antes que tomem a nossa casa..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d1fffea7"
msgid "Ah ?"
msgstr "Ah é?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a137410f"
msgid "Même si l'idée me répugne, c'est la meilleure opportunité que j'ai trouvée."
msgstr "Embora a ideia me cause repulsa, é a melhor oportunidade que encontrei."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fb28152f"
msgid "C'est une proposition d'offre d'emploi pour un job d'hôtesse...[w] cela devrait être à ma portée même si ce n'est pas ce qu'il y a de mieux."
msgstr "É uma oferta de emprego para um trabalho de acompanhante...[w] deve estar ao meu alcance, mesmo que não seja o ideal."

#. Character:`yasuka` | Attributes:`-pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_889a55a4"
msgid "L'avantage, c'est que plus tu es populaire, plus tu gagnes d'argent..."
msgstr "A vantagem é que quanto mais popular você for, mais dinheiro você ganha..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0d3ff208"
msgid "Et je suis prête à tout pour sauver notre famille !"
msgstr "E eu estou disposta a tudo para salvar nossa família!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5555b7fc"
msgid "Qu'en penses-tu ?"
msgstr "O que você acha?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c7581d29"
msgid "Merci ! Je sais que ce n'est pas une décision facile..."
msgstr "Obrigada! Sei que não é uma decisão fácil..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1f995287"
msgid "J'ai juste à me dire qu'il s'agit d'un travail comme un autre et puis..."
msgstr "Só preciso colocar na cabeça que é um trabalho como qualquer outro e então..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_069f6a7b"
msgid "Nos dettes seront vite remboursées !"
msgstr "Nossas dívidas serão pagas rapidinho!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_02d76ce6"
msgid "Je serais vite très populaire crois-moi. Et d'ici quelques semaines, on vivra dans un château..."
msgstr "Serei muito popular rapidinho, acredite em mim. E daqui a algumas semanas, viveremos em um castelo..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b8dd6761"
msgid "Tu as l'air sûre de toi en tout cas."
msgstr "Você parece bem confiante, pelo menos."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f718c954"
msgid "Je commence ce soir !"
msgstr "Eu começo hoje à noite!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_87e25920"
msgid "Très bien, je te souhaite bon courage alors."
msgstr "Muito bem, então te desejo boa sorte."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t4e2134e9d8"
msgid "[hint=ROUTE CORRUPTION]C'est probablement une bonne idée en effet !"
msgstr "[hint=ROTA DA CORRUPÇÃO]É provavelmente uma boa ideia mesmo!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bba9737d"
msgid "...Ça ne m'enchante pas non plus, mais ce sera vite remboursé de cette façon..."
msgstr "Também não estou nada animada com isso, mas desse jeito a gente quita tudo rapidinho..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0a110496"
msgid "Oui, mais... je veux dire que, si ça s'apprend, ça pourrait engendrer un véritable scandale à la fac..."
msgstr "Sim, mas... o que eu quero dizer é que, se isso vazar, pode rolar um escândalo total na faculdade..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_89b2649b"
msgid "La vie de {{noriko.n}} pourrait aussi être impactée."
msgstr "A vida da {{noriko.n}} também pode ser afetada."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9c8bb34f"
msgid "Tu sais comment les nouvelles vont vite..."
msgstr "Você sabe como as notícias correm rápido..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7f417f1d"
msgid "Si on apprend que la mère d'une élève travaille dans un bar à hôtesse..."
msgstr "Se descobrirem que a mãe de uma aluna trabalha em um clube de acompanhantes..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4c6b9926"
msgid "Je suis sûr qu'un professeur de l'école ou encore le proviseur ne se gênerait pas pour aller vérifier ça par lui-même..."
msgstr "Tenho certeza que algum professor ou até o diretor não pensariam duas vezes antes de ir conferir isso pessoalmente..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9ef6ad7f"
msgid "Dès que les gens ont un moyen de pression sur toi, il sera facile de te faire chanter."
msgstr "Assim que as pessoas tiverem algo contra você, vai ser fácil te chantagear."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_59e5bc5b"
msgid "Je le sais bien, mais... comment faire pour l'argent dans ce cas... ?"
msgstr "Eu sei bem, mas... como faremos com o dinheiro nesse caso...?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3c1b6285"
msgid "Écoute... Je pense que ça prendra un peu plus de temps, mais j'ai quelques pistes pour un travail prometteur..."
msgstr "Escuta... Acho que vai levar um pouco mais de tempo, mas tenho algumas pistas de um trabalho promissor..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_07c71e87"
msgid "Tu as passé toutes ces années à t'occuper de moi, laisse-moi te rendre la pareille..."
msgstr "Você passou todos esses anos cuidando de mim, agora me deixa retribuir o favor."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_21525109"
msgid "Tu es vraiment un ange ! Merci..."
msgstr "Você realmente é um anjo! Obrigada..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3a632de7"
msgid "Je te l'ai dit, je ferai tout pour nous sortir de cette mauvaise passe. Fais-moi confiance."
msgstr "Eu já te disse, farei tudo para nos tirar desse sufoco. Confie em mim."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t3c1d75debd"
msgid "[hint=ROUTE AMOUR]Je ne pense pas que ce soit une bonne idée."
msgstr "[hint=ROTA DO AMOR]Eu não acho que seja uma boa ideia."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7b38df2e"
msgid "Un métier sexuel ?"
msgstr "Uma profissão sexual?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d98c38a6"
msgid "...c'est pas ça ?"
msgstr "..Não é?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c41104d2"
msgid "Je te l'ai déjà dit, les hentais te montent trop au cerveau..."
msgstr "Eu já te disse, os hentais estão subindo à sua cabeça..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e19221af"
msgid "Que des fantasmes... Tss... J'ai élevé un vrai pervers."
msgstr "Só fantasia... Tsc... Criei um verdadeiro pervertido."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_14437795"
msgid "Ahemmm..."
msgstr "Ahammm..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b620894e"
msgid "Je tiens simplement compagnie à des hommes d'affaires et je les incite juste à consommer tout en les écoutant parler..."
msgstr "Eu apenas faço companhia a homens de negócios e os incentivo a consumir enquanto os ouço falar..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f8ea880a"
msgid "Il se passe quoi dans la tête des jeunes ?"
msgstr "O que será que passa na cabeça desses jovens de hoje em dia?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d775bea4"
msgid "D'accord, d'accord, j'ai compris, je me tais !"
msgstr "Tá bom, tá bom, já entendi, vou ficar quieto!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "HINT_ROUTE_AMITI_EUH_C_EST_PA_15EE07"
msgid "[hint=ROUTE AMITIÉ]Euh... c'est pas un genre de métier sexuel ?"
msgstr "[hint=ROTA DA AMIZADE]Er... isso não é um tipo de profissão sexual?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_eabc0b08"
msgid "Bonsoir {{yasuka.n}} !"
msgstr "Boa noite, {{yasuka.n}}!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_995c921e"
msgid "Bonsoir, mon chéri, comment s'est passée ta journée... ?"
msgstr "Boa noite, querido... como foi o seu dia?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_065572e7"
msgid "J'ai connu mieux... je crois[w] et toi comment s'est passé ta première journée d'hôtesse ?"
msgstr "Já tive dias melhores... eu acho[w]. E você, como foi seu primeiro dia como acompanhante?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d05134db"
msgid "{{yasuka.n}} ?"
msgstr "{{yasuka.n}}?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_892f73c3"
msgid "Oh, excuse-moi, j'avais la tête ailleurs..."
msgstr "Ah, me desculpe, eu estava com a cabeça em outro lugar..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9b442420"
msgid "La journée était... plus difficile que je ne l'avais prévue..."
msgstr "O dia foi... mais difícil do que eu previa..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_987b7c7c"
msgid "Je suis épuisée, je vais aller me coucher tout de suite !"
msgstr "Estou exausta, vou me deitar agora mesmo!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_662473f5"
msgid "{{yasuka.n}}, cette idée n'était peut-être pas aussi bonne que prévu."
msgstr "{{yasuka.n}}, talvez essa ideia não tenha sido tão boa quanto pensamos."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "t0725bf77ae"
msgid "[next]"
msgstr "[next]"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_06e8b429"
msgid "Je le sais bien, mais je ne vais pas abandonner à la première difficulté..."
msgstr "Eu sei bem, mas não vou desistir na primeira dificuldade..."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bba90700"
msgid "Je ne pensais juste pas que les hommes pouvaient avoir les mains aussi baladeuses."
msgstr "Eu só não imaginei que os homens tivessem as mãos tão bobas assim."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_45599642"
msgid "Quelle bande de sales..."
msgstr "Que bando de desgraçados..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bff6b6f2"
msgid "Mais ça ira !"
msgstr "Mas vai ficar tudo bem!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_24af95cf"
msgid "J'ai un objectif en tête, je dois rester concentrer dessus..."
msgstr "Tenho um objetivo em mente e preciso manter o foco nele..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3e7ad73c"
msgid "Mais... Il n'y a pas moyen de le signaler à ton patron ?"
msgstr "Mas... não tem como denunciar isso para o seu patrão?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e5ac9240"
msgid "...Tu es encore jeune, tu ne connais encore pas très bien le monde du travail."
msgstr "...Você ainda é jovem, não conhece muito bem o mundo do trabalho."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_03775ec8"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_78e893a6"
msgid "Tu es sûre de toi ?"
msgstr "Você tem certeza do que está fazendo?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6c4a2977"
msgid "Oui !"
msgstr "Sim!"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1a40cf41"
msgid "Merci de t'inquiéter pour moi mon chéri, et puis si jamais j'en ai marre, je peux arrêter, n'est-ce pas ?"
msgstr "Obrigada por se preocupar comigo, meu amor. E se algum dia eu cansar, eu posso parar, não posso?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d0dec7c0"
msgid "...En effet !"
msgstr "..Com certeza!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e87cd746"
msgid "Alors ne t'inquiète plus pour moi, je suis une grande fille à présent, va donc te coucher, il est déjà très tard."
msgstr "Então não se preocupe mais comigo, já sou bem grandinha. Agora vá dormir, já está muito tarde."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_01b802fe"
msgid "D'accord. Bonne nuit {{yasuka.n}}."
msgstr "Está bem. Boa noite, {{yasuka.n}}."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "tbc542980bb"
msgid "[hint=ROUTE CORRUPTION]Tu n'as pas à t'infliger ça, tu sais..."
msgstr "[hint=ROTA DA CORRUPÇÃO]Você não precisa se sujeitar a isso, sabe..."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ae44d7a9"
msgid "Tu... tu as peut-être raison."
msgstr "Você... você talvez tenha razão."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fd8be120"
msgid "...merci pour ton soutient mon chéri."
msgstr "...obrigada pelo seu apoio, querido."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fa12e14b"
msgid "Je suis désolée de ne pas être aussi forte..."
msgstr "Me desculpe por não ser tão forte..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e740f9e9"
msgid "Ne t'en fais pas, tu as déjà fait tellement pour moi."
msgstr "Não se preocupe, você já fez tanto por mim."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_50665a20"
msgid "Je ferais tout pour te rendre la pareille..."
msgstr "Vou fazer de tudo para retribuir..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1c7dfcb7"
msgid "Ooh... Tu trouves quand même le temps de t'inquiéter pour moi malgré la journée que tu as passé."
msgstr "Ooh... Você ainda encontra tempo para se preocupar comigo apesar do dia que teve."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a98bc439"
msgid "Je veille sur toi..."
msgstr "Eu cuido de você..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5a26d0b9"
msgid "Va dormir, je pense que tu l'as méritée..."
msgstr "Vai dormir, você merece..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "te09597d652"
msgid "Je pense que je ne pourrai pas dormir seule ce soir, je peux dormir avec toi ?"
msgstr "Acho que não vou conseguir dormir sozinha esta noite. Posso dormir com você?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "tc9b99debc4"
msgid "Je me dépêche de me changer et je te rejoins."
msgstr "Vou me trocar rapidinho e já te encontro."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "tfc4bf76365"
msgid "[hint=ROUTE LOVE]Il est encore temps de changer d'avis."
msgstr "[hint=ROTA DO AMOR]Ainda dá tempo de mudar de ideia."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4fee1293"
msgid "Bonsoir, mon chéri, tu rentres tard."
msgstr "Boa noite, meu amor. Você chegou tarde."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e9115b90"
msgid "Wow, mais tu..."
msgstr "Uou, mas você..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5ef6620f"
msgid "T'es habillée en..."
msgstr "Você está vestida de..."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ea1dace8"
msgid "Une femme n'a pas le droit de se faire belle avant d'aller dormir ?"
msgstr "Uma mulher não tem o direito de se arrumar antes de dormir?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_255f7114"
msgid "Euh... Si, si, bien sûr, mais c'est pas le..."
msgstr "Er... Sim, sim, claro, mas não é esse o..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f337f75e"
msgid "Raconte-moi plutôt comment s'est passée ta journée !"
msgstr "Me conte logo como foi o seu dia!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_90487ab7"
msgid "Tu semblais si motivé ce matin et là..."
msgstr "Você parecia tão motivado hoje cedo e agora..."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b7280ae7"
msgid "J'ai l'impression que tu portes le poids du monde sur tes épaules..."
msgstr "Tenho a impressão de que você está carregando o peso do mundo nos ombros..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cd620796"
msgid "Arf... La journée ne s'est pas aussi bien déroulée que j'espérais."
msgstr "Argh... O dia não correu tão bem quanto eu esperava."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_829daf16"
msgid "Tu veux m'en parler ?"
msgstr "Quer conversar sobre isso?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2353c911"
msgid "Disons que ce matin, je me suis levé du bon pied."
msgstr "Digamos que hoje de manhã eu levantei com o pé direito."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_21f04b8c"
msgid "...Et c'est comme si j'avais marché dans la merde à chacun de mes pas."
msgstr "...Mas parece que pisei na merda a cada passo que dei."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_65b21889"
msgid "C'est... très imagé, mais je comprends très bien."
msgstr "Isso foi... bem figurado, mas eu entendi perfeitamente."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0d19ba7e"
msgid "Une petite baisse de motivation, rien de plus, ça va aller."
msgstr "Só uma queda na motivação, nada mais, vai passar."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_46adedff"
msgid "Ne te laisse pas abattre par de petits détails sans importance."
msgstr "Não se deixe abater por pequenos detalhes sem importância."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8541e47c"
msgid "Tu veux que je vienne dormir avec toi comme avant ?"
msgstr "Quer que eu vá dormir com você como antes?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9bc71647"
msgid "Si tu veux, je te câlinerai jusqu'à ce que tu trouves le sommeil."
msgstr "Se você quiser, eu te faço um cafuné até você pegar no sono."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6be75c01"
msgid "Tu dormais toujours comme un bébé après ça..."
msgstr "Você sempre dormia como um anjinho depois disso..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t99f43d79eb"
msgid "C'est pour te faire plaisir alors !"
msgstr "Só para te agradar, então!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t96ac538ecc"
msgid "Si tu veux..."
msgstr "Se você quiser..."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_BONSOIR_MON_CH_RI_TU_AS_PAS_1EB707"
msgid "Oh bonsoir mon chéri, tu as passé une bonne journée ?"
msgstr "Ah, boa noite, querido. Teve um bom dia?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "W_PAS_VRAIMENT_NON_625292"
msgid "...[w] Pas vraiment, non."
msgstr "...[w] Na verdade, não muito."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_TOI_TU_AS_R_FL_CHI_CE_QUE_T_445CAE"
msgid "Et toi ? Tu as réfléchi à ce que tu allais faire au final ?"
msgstr "E você? Já pensou no que vai fazer no fim das contas?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_LA_R_FLEXION_JE_NE_ME_SENS_BC417E"
msgid "Oui, à la réflexion je ne me sens pas vraiment à l'aise dans ce poste d'hôtesse."
msgstr "Sim. Pensando bem, não me sinto muito à vontade nesse cargo de acompanhante."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_NE_SAIS_PAS_J_AI_PEUR_QUE_L_87ECF3"
msgid "Je ne sais pas... J'ai peur que les gens attendent plus que ce que je ne pourrai leur donner."
msgstr "Não sei... Tenho medo que as pessoas esperem mais do que eu possa dar."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_2b27740b"
msgid "Je vois..."
msgstr "Entendo..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_QU_IL_EN_SOIT_JE_SUIS_D_S_833F93"
msgid "Quoi qu'il en soit, je suis désolée que ta journée se soit mal passée."
msgstr "Seja como for, sinto muito que seu dia tenha sido ruim."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_Y_A_DES_CHOSES_CONTRE_LESQU_CF5D4E"
msgid "Il y a des choses contre lesquelles on ne peut pas lutter."
msgstr "Tem coisas contra as quais não podemos lutar."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_ALLER_ME_COUCHER_JE_CR_CCFC90"
msgid "Je vais aller me coucher je crois."
msgstr "Vou me deitar, eu acho."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_COMPRENDS_GARDE_LE_COURAGE_D3F44C"
msgid "Je comprends, garde le courage surtout !"
msgstr "Eu entendo. Mantenha a coragem, acima de tudo!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "FONT_SIZE_14_JE_VAIS_ESSAYER_BBBB4E"
msgid "[font_size=14]Je vais essayer...[/font_size]"
msgstr "[font_size=14]Vou tentar...[/font_size]"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_b71128a8"
msgid "Un souci mon chéri ?"
msgstr "Algum problema, querido?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_a05c0847"
msgid "Rien de grave, je ne retrouve pas mon baladeur MP3, tu ne l'aurais pas vu à tout hasard ?"
msgstr "Nada grave, só não estou encontrando meu MP3. Você não o viu por acaso?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_d84393ed"
msgid "Hmmm, je crois que {{noriko.n}} le cherchait tout à l'heure, elle a dû te l'emprunter..."
msgstr "Hmmm, eu acho que a {{noriko.n}} estava procurando por ele agora há pouco. Ela deve ter pegado emprestado..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_325643a2"
msgid "Merci {{yasuka.n}} !"
msgstr "Obrigado, {{yasuka.n}}!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_7dcf4564"
msgid "Putain ! Je n'y crois pas !"
msgstr "Puta que pariu! Eu não acredito!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_e44d0152"
msgid "C'est à croire qu'elle me cherche exprès."
msgstr "Parece até que ela faz de propósito só para me provocar."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_97144ae9"
msgid "Je vais la tuer !"
msgstr "Eu vou matar ela!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "taf4904b6c2"
msgid "[next]"
msgstr "[next]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_676ee2b1"
msgid "Et voilà !"
msgstr "E pronto!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_647538d9"
msgid "Vivement l'internet par implant neuronal..."
msgstr "Mal posso esperar pela internet por implante neuronal..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dc70227e"
msgid "Si j'en crois mon rêve, ça devrait plus trop tarder..."
msgstr "Se o meu sonho estiver certo, não deve demorar muito..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_69e0442f"
msgid "PUTAINNNNN !"
msgstr "PUTA QUE PARIUUUUU!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_326bade1"
msgid "Ah ! Je sens déjà son taux de sel grimper en flèche ! C'est le moment d'en profiter pour se faufiler discrètement dans sa chambre."
msgstr "Ah! Já sinto o nível de \"sal\" dela subindo vertiginosamente! É a hora perfeita para me infiltrar de fininho no quarto dela."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_26b72fa2"
msgid "Putain de box de merde, toujours à planter quand il ne faut pas !"
msgstr "Roteador de merda, sempre caindo quando não deve!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_082170eb"
msgid "Allez, marche ! BORDEL !"
msgstr "Vai, funciona! CARALHO!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_66940478"
msgid "BAM !"
msgstr "BAM!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_38595c21"
msgid "Même dans mon rêve, je n'ai jamais pu poser un pied dans cette chambre..."
msgstr "Nem nos meus sonhos eu consegui colocar os pés nesse quarto..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_12e3c27b"
msgid "Elle semble bien occupée avec le wifi, je dois faire au plus vite !"
msgstr "Ela parece bem ocupada com o Wi-Fi, preciso ser rápido!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t478d42ea3b"
msgid "Couper le wifi"
msgstr "Cortar o Wi-Fi"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_eb7ee16b"
msgid "Tu ne peux pas savoir à quel point ça me fait plaisir !"
msgstr "Você não faz ideia do quanto isso me deixa feliz!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_339d426f"
msgid "Quoi donc ?"
msgstr "O que exatamente?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_4888a177"
msgid "De te voir t'amuser avec {{noriko.n}}, cela faisait si longtemps..."
msgstr "Ver você se divertindo com a {{noriko.n}}, já fazia tanto tempo..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_6b83a044"
msgid "Euhhh... S'amuser, on peut dire ça comme ça..."
msgstr "Errr... \"Divertindo\", podemos dizer assim..."

#. Character:`yasuka` | Attributes:`-happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_38085f00"
msgid "Vous n'avez pas dû voir le temps passer ?"
msgstr "Vocês nem viram o tempo passar, não é?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_7a79532e"
msgid "Ah mince... Ça va être encore râpé pour aujourd'hui."
msgstr "Ah, droga... Já era por hoje."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_2599294e"
msgid "De quoi donc, tu avais quelque chose de prévu ?"
msgstr "O que foi? Você tinha algo planejado?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_88b3e6a7"
msgid "Rien d'important, je voulais juste aller courir, mais je voulais le faire en musique..."
msgstr "Nada importante, eu só queria ir correr, mas queria fazer isso ouvindo música..."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_4de70af0"
msgid "Oh, je suis désolée, je t'avais emprunté ton baladeur pour ma séance de yoga..."
msgstr "Ah, sinto muito, eu peguei seu MP3 emprestado para a minha sessão de ioga..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_11c0ed48"
msgid "Je l'ai reposé sur ton bureau tout à l'heure."
msgstr "Eu o coloquei de volta na sua mesa agora pouco."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_f719469e"
msgid "Depuis quand tu fais du yo..."
msgstr "Desde quando você faz io..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_a1d9cd5d"
msgid "Peu importe, merci {{yasuka.n}}..."
msgstr "Tanto faz, obrigado, {{yasuka.n}}..."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "talk_yasuka_3d385be9"
msgid "Ne rentre pas trop tard."
msgstr "Não volte muito tarde."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c4d4d15b"
msgid "Bonjour {{yasuka.n}} !"
msgstr "Bom dia, {{yasuka.n}}!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_afe1994d"
msgid "Bonjour {{saito.n}}."
msgstr "Bom dia, {{saito.n}}."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6c82d5b7"
msgid "Tu sors encore aujourd'hui ?"
msgstr "Vai sair de novo hoje?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_12717347"
msgid "Oui."
msgstr "Sim."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7620126b"
msgid "Je vois... Amuse-toi bien alors."
msgstr "Entendo... Divirta-se então."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3327e9e6"
msgid "...Tout se passe bien avec ton travail ?"
msgstr "..Está tudo bem no seu trabalho?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_612d32d0"
msgid "Je ne sais pas trop."
msgstr "Não sei bem."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_08444288"
msgid "C'est plus compliqué qu'il n'y parait."
msgstr "É mais complicado do que parece."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_45a988a4"
msgid "Mais... Je suis confiante."
msgstr "Mas... estou confiante."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_191441a3"
msgid "Sache que tu as tout mon soutien."
msgstr "Saiba que você tem todo o meu apoio."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_88828c90"
msgid "Même si ça ne fait pas une grande différence..."
msgstr "Mesmo que isso não faça muita diferença..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_482deeb9"
msgid "Merci mon chéri."
msgstr "Obrigada, querido."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9a818692"
msgid "Passe une bonne journée."
msgstr "Tenha um bom dia."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_AS_L_AIR_D_AVOIR_RETROUV_LE_8382E0"
msgid "Tu as l'air d'avoir retrouvé le sourire !"
msgstr "Parece que você recuperou o sorriso!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_LES_CHOSES_SEMBLENT_S_AM_L_9530BD"
msgid "Oui, les choses semblent s'améliorer finalement."
msgstr "Sim, as coisas finalmente parecem estar melhorando."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_VRAIMENT_HEUREUSE_POUR_540187"
msgid "Je suis vraiment heureuse pour toi mon chéri, je vois que tu te donnes beaucoup de mal."
msgstr "Fico muito feliz por você, querido. Vejo que está se esforçando bastante."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "TOI_QUI_SEMBLAIS_SI_TRISTE_AVA_B63696"
msgid "Toi qui semblais si triste avant."
msgstr "Você parecia tão triste antes."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AIME_BEAUCOUP_CE_NOUVEAU_TOI_F31EDF"
msgid "J'aime beaucoup ce nouveau toi !"
msgstr "Estou gostando muito dessa nova versão sua!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_DE0C74"
msgid "Merci."
msgstr "Obrigado."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "RASSURE_MOI_TU_NE_TE_DROGUES_P_C91BDF"
msgid "Rassure-moi, tu ne te drogues pas au moins ?"
msgstr "Mas me diz uma coisa... você não está usando drogas, né?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_BIEN_S_R_QUE_NON_BDB379"
msgid "Quoi ?! Bien sûr que non !"
msgstr "O quê?! Claro que não!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_ME_SUIS_MIS_AU_SPORT_J_AI_R_8384FA"
msgid "Je me suis mis au sport, j'ai rencontré de nouvelles personnes, j'aurai bientôt un travail..."
msgstr "Comecei a malhar, conheci gente nova e logo vou conseguir um emprego..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "EH_BIEN_EH_BIEN_JE_CROIS_QUE_J_42DE0E"
msgid "Eh bien, eh bien... Je crois que je vais devoir me retrousser les manches moi aussi."
msgstr "Ora, ora... acho que também vou ter que arregaçar as mangas."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_TE_PROMETS_DE_TOUT_FAIRE_PO_0F20D2"
msgid "Je te promets de tout faire pour rembourser nos dettes !"
msgstr "Prometo que farei tudo o que estiver ao meu alcance para quitar nossas dívidas!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_ES_UN_AMOUR_MAIS_FAIS_ATTEN_884AD4"
msgid "Tu es un amour, mais fais attention à toi tout de même !"
msgstr "Você é um amor, mas tome cuidado mesmo assim!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_PROMIS_AE1312"
msgid "C'est promis."
msgstr "Eu prometo."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8cc61393"
msgid "Bonjour mon chéri."
msgstr "Bom dia, querido."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cc0b7ce8"
msgid "Bonjour {{yasuka.n}} !"
msgstr "Bom dia, {{yasuka.n}}!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c57e37b8"
msgid "Depuis peu, je te vois t'agiter dans la maison."
msgstr "Ultimamente, tenho visto você bem agitado pela casa."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d0fc804d"
msgid "On dirait que tu as trouvé une toute nouvelle énergie."
msgstr "Parece que você encontrou uma energia totalmente nova."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bbb75bef"
msgid "Cela me fait énormément plaisir de te voir ainsi."
msgstr "Me dá um prazer enorme ver você assim."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e283da46"
msgid "Avant, tu semblais si déprimé."
msgstr "Antes, você parecia tão deprimido."

#. Character:`yasuka` | Attributes:`-sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4fd38db4"
msgid "Je suis d'ailleurs surprise que tu aies réussi à relever la tête aussi vite."
msgstr "Na verdade, estou surpresa por você ter conseguido dar a volta por cima tão rápido."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e4d7aa3b"
msgid "...Oui j'ai pris de... bonnes résolutions."
msgstr "...É, tomei algumas... boas resoluções."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1e2bfeef"
msgid "Mon chéri, je ne veux pas que tu le prennes mal, mais je dois te poser la question."
msgstr "Querido, não quero que entenda mal, mas preciso te perguntar uma coisa."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2f9c43de"
msgid "Est-ce que tu te drogues ?"
msgstr "Você está usando drogas?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_798d3cc6"
msgid "Quoi ? Mais... Non, pas du tout."
msgstr "O quê? Mas... Não, claro que não."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0b86294d"
msgid "Je te taquine, mais tu as changé si vite en l'espace de si peu de temps que je me devais te poser la question."
msgstr "Estou só te provocando, mas você mudou tanto em tão pouco tempo que eu tinha que perguntar."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7c0c46da"
msgid "Je m'inquiète pour toi après tout !"
msgstr "Afinal de contas, eu me preocupo com você!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7df589fb"
msgid "Je sais..."
msgstr "Eu sei..."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_46684c23"
msgid "Mon chéri... Je sais que tu as dit que tu trouverais un travail pour m'aider à rembourser, mais le temps presse."
msgstr "Querido... Eu sei que você disse que acharia um trabalho para ajudar com as dívidas, mas o tempo está acabando."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_515fad94"
msgid "Nous n'aurons bientôt plus d'économies pour finir le mois."
msgstr "Logo não teremos mais economias para fechar o mês."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b13e83a6"
msgid "Et je devrais au final accepter ce poste qu'on m'a proposé."
msgstr "E eu talvez tenha que aceitar aquela vaga que me ofereceram."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7f741358"
msgid "Je... J'y travaille, je te garantis que je décrocherai ce job !"
msgstr "Eu... estou cuidando disso, garanto que vou conseguir esse emprego!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fee6dc39"
msgid "Si je pouvais, je te donnerais toutes mes économies, mais je n'ai même pas de quoi me payer une canette."
msgstr "Se eu pudesse, te daria todas as minhas economias, mas não tenho dinheiro nem para pagar uma latinha de refrigerante."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0a07202a"
msgid "Je comprends..."
msgstr "Eu entendo..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cbe595e0"
msgid "J'espère que nous sortirons vite de cette impasse."
msgstr "Espero que a gente saia logo desse sufoco."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d94a80c7"
msgid "Je vais te donner toutes mes économies en attendant, il n'y a pas de raison que tu sois la seule à payer."
msgstr "Vou te dar todas as minhas economias por enquanto, não tem por que só você ficar pagando as contas."

#. Character:`notice`
#: game/story/home_player_livingroom.dialogue
msgctxt "t3f5a51db02"
msgid "Vous donnez à {{yasuka.n}} la somme de {{money}}¥"
msgstr "Você dá para {{yasuka.n}} a quantia de {{money}}¥"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_66c7aee7"
msgid "Mon chéri... Je ne sais pas quoi dire."
msgstr "Querido... nem sei o que dizer."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7b3050f3"
msgid "Alors, ne dis rien, utilise tout ce que tu peux pour finir le mois."
msgstr "Então não diga nada, use tudo o que puder para terminar o mês."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_502ce2c7"
msgid "Je te garantis que je vais obtenir ce job d'une manière ou d'une autre."
msgstr "Eu te garanto que vou conseguir esse trabalho de um jeito ou de outro."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_862bc7ab"
msgid "Merci !"
msgstr "Obrigada!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3fc1a127"
msgid "Héhé"
msgstr "Hehe."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ddc109e1"
msgid "Bonjour {{yasuka.n}}, j'aimerais te présenter une amie."
msgstr "Oi, {{yasuka.n}}, gostaria de te apresentar uma amiga."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_34d22d06"
msgid "Oh, bonjour !"
msgstr "Ah, olá!"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_aea8bdee"
msgid "Bonjour madame, je m'appelle {{asami.n}} ! C'est vraiment magnifique chez vous."
msgstr "Olá, senhora, me chamo {{asami.n}}! Sua casa é realmente maravilhosa."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2feab39a"
msgid "Merci beaucoup, mais madame, c'est un peu... Je préfère que tu m'appelles par mon prénom."
msgstr "Muito obrigada, mas \"senhora\" é um pouco... Prefiro que me chame pelo meu nome."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4a7aa347"
msgid "On va juste se poser dans ma chambre un moment."
msgstr "A gente vai só ficar lá no meu quarto um pouco."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4ca870b8"
msgid "Entendu, amusez-vous bien !"
msgstr "Tudo bem, divirtam-se!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b481c03a"
msgid "...[w] Ahlala la jeunesse."
msgstr "...[w] Ah, a juventude."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_030d62c0"
msgid "Qu'est-ce que je ne donnerais pas pour perdre quelques années ?"
msgstr "O que eu não daria para perder alguns aninhos?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_76dc1cb8"
msgid "Tu t'en vas déjà {{asami.n}} ?"
msgstr "Já vai embora, {{asami.n}}?"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a5447c6c"
msgid "Oui, j'ai passé une très bonne journée, mes parents doivent m'attendre."
msgstr "Sim, passei um dia ótimo, mas meus pais devem estar me esperando."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9608964d"
msgid "Ça m'a fait plaisir de faire ta connaissance, tu es la bienvenue quand tu veux."
msgstr "Foi um prazer te conhecer, você é bem-vinda quando quiser."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4e10b9fc"
msgid "Je vais la raccompagner, à plus tard."
msgstr "Vou acompanhar ela até a porta, até mais tarde."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8061e338"
msgid "À plus tard mon chéri."
msgstr "Até mais tarde, querido."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_44e3d9e9"
msgid "Oh oui mon chéri, raccompagne-moi !"
msgstr "Isso, querido, me acompanhe!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fae9c63d"
msgid "Bonjour {{asami.n}}."
msgstr "Olá, {{asami.n}}."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d27f9559"
msgid "Je suis ravie de voir que tu sembles te plaire ici."
msgstr "Fico encantada de ver que você parece gostar de estar aqui."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_80c5bfb4"
msgid "C'est parce que {{saito.n}} prend bien soin de moi."
msgstr "É porque o {{saito.n}} cuida muito bem de mim."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_de2fe190"
msgid "Oh et mon chéri, n'hésitez pas à jouer avec {{noriko.n}} aussi."
msgstr "Ah, e querido, não hesitem em chamar a {{noriko.n}} para brincar também."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6c6bb521"
msgid "Elle avait passé la journée à écouter à la porte la dernière fois et n'a jamais eu le courage de vous rejoindre."
msgstr "Da última vez ela passou o dia ouvindo atrás da porta e não teve coragem de se juntar a vocês."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f29203ae"
msgid "Oh ! Euh, je vais voir ce que je peux faire."
msgstr "Ah! Er... vou ver o que posso fazer."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cc0146cc"
msgid "Amusez-vous bien !"
msgstr "Meus amores, divirtam-se!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0dd87365"
msgid "Bonjour, mon chéri, tu en as une triste mine."
msgstr "Bom dia, querido. Você está com uma cara tão abatida..."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_06c1a4d9"
msgid "Que se passe-t-il ?"
msgstr "Aconteceu alguma coisa?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4ac0de8a"
msgid "La nuit a été difficile."
msgstr "A noite foi complicada."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_98ae4f7f"
msgid "Je peux te poser une question, même si ça va te paraitre un peu étrange ?"
msgstr "Posso te fazer uma pergunta? Mesmo que pareça um pouco estranha..."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_57a85328"
msgid "Bien sûr que tu peux, tu sais bien que tu peux tout me dire !"
msgstr "Claro que pode! Você sabe que pode me perguntar qualquer coisa."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ea40047c"
msgid "...Si tu avais connaissance que quelque chose d'horrible arrivait à une personne que tu apprécies."
msgstr "...Se você soubesse que algo horrível vai acontecer com alguém que você gosta..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d3445ba3"
msgid "Mais que tu ne pouvais pas l'aider sous peine de te mettre toi et tous ceux que tu aimes en danger."
msgstr "Mas você não pudesse ajudar, porque se fizesse isso, colocaria você e todo mundo que ama em perigo."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6c3fec7c"
msgid "Que ferais-tu ?"
msgstr "O que você faria?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_901bf4af"
msgid "...Je dois avouer que je m'attendais à autre chose, mais ça a l'air grave."
msgstr "..Confesso que eu esperava outra coisa, mas o assunto parece sério."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_583494a0"
msgid "Ça ressemble beaucoup à ce fameux dilemme avec le tramway ou tu dois choisir soit de sauver 5 personnes ou choisir celle que tu aimes."
msgstr "Isso lembra bastante aquele famoso dilema do trem, onde você precisa escolher entre salvar cinco pessoas ou a pessoa que você ama."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_362b7712"
msgid "C'est exactement ça !"
msgstr "É exatamente isso!"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d04f3885"
msgid "Malheureusement mon chéri, il n'y a pas de bonne ou de mauvaise solution."
msgstr "Infelizmente, querido, não existe uma resposta certa ou errada."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_08080960"
msgid "Parfois, il y a juste deux mauvaises solutions et tu dois choisir la moins pire des deux..."
msgstr "Às vezes, só existem duas opções ruins e você precisa escolher a menos pior..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_30ec452e"
msgid "...Je vois merci {{yasuka.n}}."
msgstr "...Entendi. Obrigado, {{yasuka.n}}."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1f439b15"
msgid "Mais il y a peut-être une autre solution à ce problème."
msgstr "Mas talvez exista uma outra saída para esse problema."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8b5e8646"
msgid "Vraiment ?"
msgstr "Sério?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8dd56aea"
msgid "Tu n'as pas forcément besoin de porter ce fardeau tout seul."
msgstr "Você não precisa carregar esse fardo sozinho."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_884f4cc2"
msgid "Tu as probablement des amis à qui tu peux faire confiance ?"
msgstr "Você com certeza tem amigos em quem pode confiar, não tem?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3357dcbd"
msgid "À plusieurs, je suis certaine que vous arriverez à surmonter tout ça."
msgstr "Juntos, tenho certeza de que vocês vão conseguir superar isso."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_39fbac5d"
msgid "Tu n'es pas d'accord ?"
msgstr "Não acha?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a61744fb"
msgid "Tu es toujours aussi optimiste !"
msgstr "Você é sempre tão otimista!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_76a754a3"
msgid "Mais c'est ce que je préfère chez toi."
msgstr "Mas é isso que eu mais gosto em você."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dbd00681"
msgid "Tu as raison, je ne suis pas seul !"
msgstr "Você tem razão, eu não estou sozinho!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_52d79dea"
msgid "Je suis ravi de voir que j'ai pu te redonner le sourire."
msgstr "Fico feliz em ver que consegui te devolver o sorriso."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7b2c5ef2"
msgid "Passe une bonne journée mon chéri."
msgstr "Tenha um bom dia, querido."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_26bf1564"
msgid "Elle a raison, je ne suis plus tout seul."
msgstr "Ela tem razão, eu não estou mais sozinho."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f6c68de8"
msgid "{{macumba.n}}, {{asami.n}} ou encore {{kimochi.n}}."
msgstr "O {{macumba.n}}, a {{asami.n}} e até o {{kimochi.n}}."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_839774e1"
msgid "Je suis certain qu'à nous 4 on pourra trouver une solution à tout ça."
msgstr "Tenho certeza de que nós quatro vamos achar uma solução para isso."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ac6712fb"
msgid "Je devrais d'ailleurs commencer par {{macumba.n}}."
msgstr "Aliás, eu deveria começar falando com o {{macumba.n}}."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_653cafa5"
msgid "Oh bonjour !"
msgstr "Ah, olá!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_35ed0af8"
msgid "{{yasuka.n}} j'aimerais te présenter {{asami.n}}. Elle est..."
msgstr "{{yasuka.n}}, eu queria te apresentar a {{asami.n}}. Ela é..."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_81d03a78"
msgid "J'ai fait sa connaissance juste aujourd'hui et il veut déjà m'emmener dans sa chambre !"
msgstr "Eu acabei de conhecer ele hoje e ele já quer me levar para o quarto!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3b21d5b8"
msgid "Vraiment ? Dans ce cas tu n'as aucune crainte à te faire, je suis certaine d'avoir élevé un gentleman."
msgstr "É mesmo? Se for esse o caso, não precisa ter medo de nada. Tenho certeza de que criei um cavalheiro."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_960877cf"
msgid "Amusez-vous bien."
msgstr "Divirtam-se."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d766decc"
msgid "Elle a l'air vraiment gentille."
msgstr "Ela parece ser muito legal."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c7244880"
msgid "Elle n'en a pas seulement l'air, elle l'est véritablement !"
msgstr "Ela não parece ser, ela é maravilhosa de verdade!"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_aba6325c"
msgid "Oh quelqu'un n'aurait pas un petit complexe d'Œdipe ?"
msgstr "Oh, alguém aqui é um filhinho da mamãe bem mimado, hein?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bfc1d90a"
msgid "... Je regrette déjà de t'avoir invitée."
msgstr "...Já estou arrependido de ter te convidado."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ce307f46"
msgid "Aller boude pas, je plaisantais !"
msgstr "Ah, não fica emburrado, eu estava brincando!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_859dc21e"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ddd015b5"
msgid "... Tu resteras bien avec nous ce soir pour manger ?"
msgstr "..Você vai ficar para jantar com a gente hoje, não vai?"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_47267804"
msgid "C'est très gentil à vous mais je ne voudrais pas déranger..."
msgstr "É muita gentileza sua, mas eu não queria incomodar..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ce76abd4"
msgid "Tu déranges personne !"
msgstr "Você não vai incomodar ninguém!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b52a100d"
msgid "Aller accepte, au pire tout ce que tu risques c'est de passer un bon moment."
msgstr "Bobagem, aceita! O pior que pode acontecer é você passar um momento agradável."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3f63c082"
msgid "Je suis plutôt bonne cuisinière tu sais."
msgstr "E eu sou uma cozinheira de mão cheia, sabe?"

#. Character:`asami` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4f2c37c7"
msgid "Je... je"
msgstr "Eu... bem..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_df65d7d6"
msgid "Aller sois pas bête, tu vas leur faire de la peine si tu refuses."
msgstr "Deixa de bobeira, elas vão ficar chateadas se você recusar."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_964ee204"
msgid "Bon d'accord, je préviens ma mère et c'est bon!"
msgstr "Tá bom, combinado! Só vou avisar minha mãe e pronto!"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f67a45a6"
msgid "Parfait !"
msgstr "Perfeito!"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fc30a8bb"
msgid "Un peu plus et j'ai cru que tu me laisserais seule avec lui !"
msgstr "Por um segundo eu achei que você ia me largar sozinha com ele!"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e432654e"
msgid "Arrête ça se voit bien que tu l'adores !"
msgstr "Para com isso, dá para ver de longe que você adora ele!"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0c4c69cb"
msgid "Quoi ?!"
msgstr "O que?!"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dadb39bd"
msgid "Haha !"
msgstr "Haha!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e936c827"
msgid "Encore une fois tu es la bienvenue ici quand tu veux {{asami.n}}."
msgstr "Já sabe, você é bem-vinda aqui quando quiser, {{asami.n}}."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a88c6019"
msgid "Merci beaucoup ! J'essaierais quand même de ne pas vous déranger trop souvent non plus."
msgstr "Muito obrigada! Vou tentar não vir toda hora para não abusar da boa vontade de vocês."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_985af6c1"
msgid "Je te raccompagne ?"
msgstr "Quer que eu te acompanhe?"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d60a4c81"
msgid "Pourquoi ? Tu as peur que je me perde ?"
msgstr "Por quê? Está com medo de eu me perder?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cdd26adf"
msgid "...[w] Ok rentre toute seule j'ai compris."
msgstr "...[w] Tá bom, volta sozinha então, já entendi."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3e10c4e8"
msgid "Aller je plaisantais, bien sûr que tu vas me raccompagner."
msgstr "Ei, eu estava brincando! É claro que você vai me acompanhar."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fba1dc55"
msgid "... Je..."
msgstr "...Eu..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8805591f"
msgid "Tout va bien {{yasuka.n}} ?"
msgstr "Tudo bem, {{yasuka.n}}?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_10532c39"
msgid "Oui oui, je suis juste un peu fatiguée, ne t'inquiète pas."
msgstr "Sim, sim. Só estou um pouco cansada, não se preocupe."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3175ca63"
msgid "Ne rentre pas trop tard !"
msgstr "Não volte muito tarde!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bb5ec496"
msgid "Bien compris !"
msgstr "Pode deixar!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ae713cd0_2"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b38e2f9c"
msgid "Je n'ai vraiment pas envie d'y retourner..."
msgstr "Eu realmente não queria ter que voltar para aquele lugar..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3579149c"
msgid "Mais je n'ai plus vraiment le choix maintenant."
msgstr "Mas eu não tenho mais escolha agora."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cc0b7ce8_1"
msgid "Bonjour {{yasuka.n}} !"
msgstr "Bom dia, {{yasuka.n}}!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b4e69ca9"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_505d6660"
msgid "Tu n'as pas l'air d'aller bien ce matin."
msgstr "Você não parece estar muito bem hoje de manhã."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a286c9c3"
msgid "...Je suis désolée mon chéri."
msgstr "...Me desculpe, querido."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d6dc7ef2"
msgid "Je suis un peu anxieuse de retourner à mon ancien travail."
msgstr "Estou um pouco ansiosa por ter que voltar ao meu antigo trabalho."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b685928b"
msgid "Mon patron est un homme... extrêmement désagréable."
msgstr "Meu patrão é um homem... extremamente desagradável."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7580ce79"
msgid "J'avais pris quelques jours de congés pour réfléchir à cette proposition de travail d'hôtesse."
msgstr "Eu tinha tirado alguns dias de folga para pensar naquela proposta de trabalho como acompanhante."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_87423b5b"
msgid "Comme j'ai décliné la proposition, je dois retourner à mon ancien travail."
msgstr "Como eu recusei a proposta, preciso voltar ao meu antigo emprego."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f20d4937"
msgid "J'ai beau réfléchi, je ne me souviens pas lui avoir demandé, même dans ma précédente vie dans quoi elle travaillait."
msgstr "Por mais que eu puxe pela memória, não lembro de ter perguntado com o que ela trabalhava, nem mesmo na minha vida passada."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_350186c1"
msgid "J'étais vraiment une merde de ne pas y avoir fait plus attention."
msgstr "Eu fui um belo de um bosta por nunca ter prestado atenção nisso."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6d4bc18c"
msgid "J'aurais dû voir qu'elle donnait tout ce qu'elle avait pour nous élever correctement et rembourser ses dettes."
msgstr "Eu deveria ter visto que ela dava tudo de si para nos sustentar direito e pagar aquelas dívidas."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ef05c069"
msgid "Je dois changer ça à tout prix !"
msgstr "Eu preciso mudar isso de qualquer jeito!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_df28da26"
msgid "Et si je passais te voir cet aprèm ?"
msgstr "E se eu passasse lá para te ver esta tarde?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9f02d7a2"
msgid "Tu ferais ça pour moi ?"
msgstr "Você faria isso por mim?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_73ed298e"
msgid "Je ferais n'importe quoi pour toi."
msgstr "Eu faria qualquer coisa por você."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_986b47d8"
msgid "Oh, tu es un amour."
msgstr "Ah, você é um amor."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_17825842"
msgid "Viens me voir à la boutique au coin de la rue."
msgstr "Venha me ver na cafeteria na esquina da rua."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_76e41588"
msgid "On y propose des cafés et des pâtisseries faites maison."
msgstr "Nós servimos cafés e doces caseiros lá."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b9515957"
msgid "Oh ! Intéressant ça, je viendrai, c'est certain."
msgstr "Ah! Interessante, eu vou com certeza."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cd75592e"
msgid "Bon courage, je suis sûr que le retour se passera bien."
msgstr "Boa sorte, tenho certeza de que o retorno vai ser tranquilo."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_25ff028e"
msgid "Ta journée est enfin terminée, est-ce que tout s'est bien passé ?"
msgstr "Seu dia finalmente acabou, correu tudo bem?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c2ffcc80"
msgid "Oh, mon chéri, je suis désolée de ce qui s'est passé aujourd'hui."
msgstr "Ah, querido, me desculpe pelo que aconteceu hoje."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f2e50485"
msgid "Ne t'en fais pas... Je suis seulement inquiet pour toi."
msgstr "Não se preocupe com isso... Só estou preocupado com você."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c2e009cd"
msgid "Ce que j'aimerais savoir, c'est pourquoi tu continues de travailler pour cet homme horrible ?"
msgstr "O que eu queria saber é por que você continua trabalhando para aquele homem horrível?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2347b3c6"
msgid "Je suis certain que tu pourrais trouver autre chose ailleurs et..."
msgstr "Tenho certeza de que você conseguiria encontrar outra coisa em outro lugar e..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_512d3cf6"
msgid "Tu es gentil mon chéri, mais je suis complètement épuisée, si tu veux, je t'en parlerai demain."
msgstr "Você é muito gentil, querido, mas estou completamente exausta. Se quiser, a gente conversa sobre isso amanhã."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fa34544f"
msgid "Oui, je comprends, je vais te laisser te reposer."
msgstr "Sim, eu entendo, vou deixar você descansar."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7188132e"
msgid "Si tu as besoin de quoi que ce soit, fais-moi signe."
msgstr "Se precisar de qualquer coisa, é só me chamar."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a1bdea99"
msgid "Bonjour {{yasuka.n}}, tu as passé une bonne nuit ?"
msgstr "Bom dia, {{yasuka.n}}, dormiu bem?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0e938d85"
msgid "Non, pas vraiment..."
msgstr "Não, na verdade não..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6b2f74d9"
msgid "J'ai eu une crise d'angoisse qui m'a tenue éveillée une bonne partie de la nuit et quand j'ai finalement réussi à m'endormir, j'ai fait un cauchemar terrifiant."
msgstr "Tive uma crise de ansiedade que me deixou acordada boa parte da noite e, quando finalmente consegui pegar no sono, tive um pesadelo terrível."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_848a5e30"
msgid "Tu veux en parler ?"
msgstr "Quer conversar sobre isso?"

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c143836a"
msgid "Non, je préfèrerai oublier ça à tout prix."
msgstr "Não, prefiro esquecer isso a todo custo."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c6907980"
msgid "Oh... d'accord."
msgstr "Ah... tudo bem."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c336e284"
msgid "Je viendrai à nouveau te voir aujourd'hui pendant ta pause."
msgstr "Eu vou passar lá para te ver de novo hoje durante a sua pausa."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bc81768a"
msgid "Merci mon chéri, c'est gentil comme tout mais...[w] Tu n'es pas obligé, tu sais."
msgstr "Obrigada, querido, é muita gentileza sua, mas...[w] você não é obrigado, sabe?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b59a7318"
msgid "Mais je suis heureuse que tu le fasses !"
msgstr "Mas fico muito feliz que faça isso!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ac19a8c4"
msgid "À plus tard alors !"
msgstr "Até mais tarde então!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_03775ec8_1"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8a19d674"
msgid "Bon... C'est d'accord, je vais t'aider."
msgstr "Bom... Está bem, eu vou te ajudar."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dac13247"
msgid "J'ai pas envie qu'on dise que je suis une fille ingrate."
msgstr "Não quero que fiquem dizendo por aí que sou uma filha ingrata."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bea3cc93"
msgid "Mais tu m'en devras une !"
msgstr "Mas você vai ficar me devendo uma!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_03d9eec4"
msgid "Je t'en devrais une parce que tu m'aides à aider ta propre mère ?"
msgstr "Eu vou te dever uma só porque você está me ajudando a ajudar a sua própria mãe?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_29cd7803"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f35f2946"
msgid "Va te faire voir !"
msgstr "Ah, vai se foder!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f3aff511"
msgid "Peu importe, on se retrouve cet après-midi devant la boutique."
msgstr "Tanto faz, a gente se encontra esta tarde na frente da cafeteria."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7804cadd"
msgid "Tant que tu restes à plusieurs mètres de moi ça me va, j'ai pas envie qu'on croie qu'on est ensemble."
msgstr "Contanto que você fique a vários metros de distância de mim, por mim tudo bem. Não quero ninguém achando que estamos juntos."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_46315306"
msgid "On peut appeler ça un progrès."
msgstr "Já podemos considerar isso um progresso."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5ccbc92a"
msgid "Restons positifs."
msgstr "Vamos pensar positivo."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_33d3eafd"
msgid "Elle ne devrait plus trop tarder..."
msgstr "Ela não deve demorar muito..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b4e69ca9_1"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a1914562"
msgid "Je crois..."
msgstr "Eu acho..."

#. Character:`centered`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6ef3faa5"
msgid "[i]Environ 3 heures plus tard...[/i]"
msgstr "[i]Cerca de 3 horas depois...[/i]"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fff74431"
msgid "Elle aurait déjà dû arriver depuis des heures..."
msgstr "Ela já deveria ter chegado há horas..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b474e50b"
msgid "Quelque chose a dû se produire."
msgstr "Alguma coisa aconteceu."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ba281745"
msgid "J'ai un mauvais pressentiment."
msgstr "Estou com um mau pressentimento."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f09a7e33"
msgid "J'espère que ce bâtard n'a rien osé tenter."
msgstr "Espero que aquele desgraçado não tenha tentado nenhuma gracinha."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9f10abda"
msgid "Je ferais mieux d'aller voir ça moi-même."
msgstr "É melhor eu ir lá conferir isso pessoalmente."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c0a8cc48"
msgid "Merci pour tout..."
msgstr "Obrigada por tudo..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b1456aef"
msgid "Je t'ai déjà dit que c'était normal."
msgstr "Já te disse que não precisa agradecer por isso."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d0658b26"
msgid "Tu n'as pas à me remercier."
msgstr "É o mínimo que eu podia fazer."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e0231d2b"
msgid "Par contre, je veux bien que tu répondes à une question que je me pose."
msgstr "Mas, mudando de assunto, queria te fazer uma pergunta."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_92c81e47"
msgid "Pourquoi t'es-tu baladée en ville au lieu de rentrer directement à la maison ?"
msgstr "Por que você ficou rodando pela cidade em vez de voltar direto para casa?"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_01d2ccde"
msgid "Oh ! C'est parce que mon patron tenait absolument à me raccompagner à la maison pour voir où j'habitais..."
msgstr "Ah! É porque o meu patrão insistiu muito para me trazer até em casa... Ele queria ver onde eu morava..."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_09df76fb"
msgid "Et je ne voulais pas qu'il le sache."
msgstr "E eu não queria que ele soubesse de jeito nenhum."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0e5c68ce"
msgid "J'ai fait tout ce que j'ai pu pour éviter ça."
msgstr "Fiz tudo o que pude para evitar isso."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_80dad990"
msgid "Je comprends mieux."
msgstr "Agora tudo faz sentido."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f03b1f4f"
msgid "Ce type est bien trop dangereux !"
msgstr "Esse cara é perigoso demais!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a6b89e57"
msgid "Tu dois quitter ce travail, dès à présent."
msgstr "Você precisa sair desse emprego agora mesmo."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3b340770"
msgid "Oui... Tu as raison, je crois que je me voilais la face depuis trop longtemps en pensant que je pouvais le supporter."
msgstr "Sim... Você tem razão. Acho que passei muito tempo tentando tapar o sol com a peneira, achando que conseguiria aguentar tudo isso."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bb5deffe"
msgid "Tu veux bien... T'en charger pour moi ?"
msgstr "Você se importaria de... resolver isso por mim?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2bf97e97"
msgid "Bien sûr, je m'occupe de tout, fais-moi confiance."
msgstr "Claro, eu cuido de tudo, pode confiar em mim."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_94c2be50"
msgid "Repose-toi à présent."
msgstr "Agora tente descansar um pouco."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2f61b344"
msgid "Merci mon chéri..."
msgstr "Obrigada, querido..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_35bfda3e"
msgid "De veiller sur moi."
msgstr "Por cuidar de mim."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c4109149"
msgid "Tout va bien mon chéri ? J'ai entendu {{noriko.n}} crier."
msgstr "Está tudo bem, querido? Ouvi a {{noriko.n}} gritando."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c03b7c41"
msgid "Oui, ne t'en fais pas, elle a juste encore perdu le wifi comme d'habitude."
msgstr "Sim, não se preocupe, é só o Wi-Fi dela que caiu de novo, como sempre."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c1a2e1fc"
msgid "Oh, je vois."
msgstr "Ah, entendi."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dce8d35c"
msgid "Tu peux retourner te reposer, je m'occupe de ton patron."
msgstr "Pode voltar a descansar, eu resolvo as coisas com o seu patrão."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_17021d5b"
msgid "Tu es sûr ? J'ai un peu honte de te laisser faire tout ça pour moi, mais..."
msgstr "Tem certeza? Fico até sem jeito de te deixar fazer tudo isso por mim, mas..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_07c25583"
msgid "Ne dis rien, ce type est une ordure."
msgstr "Não diga nada, aquele tipo é um lixo."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_07d9cdd3"
msgid "Il doit arrêter ça."
msgstr "Ele precisa ser parado."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bb384358"
msgid "Ne te soucis plus de rien, je m'occupe de tout, fais-moi confiance."
msgstr "Não esquente a cabeça com mais nada, eu cuido de tudo, confia em mim."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fd08938f"
msgid "C'est bien beau tout ça, mais qu'est-ce que je vais lui dire ?"
msgstr "Falar é fácil, mas o que diabos eu vou dizer para aquele cara?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c4ad4b1d"
msgid "Oh, mon chéri, tu rentres si tard !"
msgstr "Ah, querido, você chegou tão tarde!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_36dbeef8"
msgid "Comment s'est passée ta journée ?"
msgstr "Como foi o seu dia?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_92673377"
msgid "La situation est déjà assez difficile comme ça, je ne dois pas l'inquiéter davantage."
msgstr "As coisas já estão difíceis demais, não posso preocupar ela ainda mais."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2f4f36c8"
msgid "Je vais prendre sur moi et tenir bon jusqu'à ce que je trouve une solution."
msgstr "Vou ter que aguentar firme e segurar a barra até achar uma saída."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_33f712ef"
msgid "Tout s'est bien passé !"
msgstr "Correu tudo bem!"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c241dfd8"
msgid "C'est vrai ?"
msgstr "Sério?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0b55651f"
msgid "Ça a été épuisant, mais je pense que je m'en suis bien sorti."
msgstr "Foi exaustivo, mas acho que me saí bem."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9bdedcde"
msgid "Il n'a pas été odieux avec toi ?"
msgstr "Ele não foi detestável com você?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_941e347c"
msgid "Je... Je l'ai à peine vue, il a passé sa journée sur la terrasse."
msgstr "Eu... mal vi o cara, ele passou o dia inteiro na varanda."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8a8117de"
msgid "Oh oui, je vois..."
msgstr "Ah sim, entendi..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_33827240"
msgid "J'étais terriblement inquiète pour toi à tel point que je ne pouvais pas me reposer."
msgstr "Eu estava tão preocupada com você que não conseguia nem descansar."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8c178d95"
msgid "J'en avais des angoisses !"
msgstr "Estava até tendo crises de ansiedade!"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3e8d1d52"
msgid "Mais de savoir que tout se passe bien..."
msgstr "Mas saber que está tudo bem..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3536e7d6"
msgid "Tout va bien, ne t'inquiète pas."
msgstr "Está tudo bem, não se preocupe."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_95e80cc4"
msgid "Repose-toi, c'est le plus important."
msgstr "Descanse, isso é o mais importante agora."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c70765ba"
msgid "Tu es un amour !"
msgstr "Você é um amor!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cdc29214"
msgid "{{yasuka.n}} ?"
msgstr "{{yasuka.n}}?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_408a514d"
msgid "Elle n'a pas l'air d'être là."
msgstr "Parece que ela não está aqui."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2031f6f3"
msgid "[font_size=14]Je suis dans ma chambre...[/font_size]"
msgstr "[font_size=14]Estou no meu quarto...[/font_size]"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e36d74eb"
msgid "Tu veux que je te laisse tranquille ?"
msgstr "Quer que eu te deixe em paz?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f64fae37"
msgid "[font_size=14]Non ! Rejoins-moi...[/font_size]"
msgstr "[font_size=14]Não! Vem aqui...[/font_size]"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f8d274b6"
msgid "J'ai beau essayer de me souvenir, mais je ne pense pas avoir déjà été un jour dans sa chambre..."
msgstr "Por mais que eu tente lembrar, acho que nunca entrei no quarto dela antes..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_49c7c8d3"
msgid "Après la mort de {{noriko.n}}, {{yasuka.n}} s'était replié sur elle-même."
msgstr "Depois que a {{noriko.n}} morreu, a {{yasuka.n}} se fechou completamente no mundo dela."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_34c13c60"
msgid "J'avais quitté la maison, car l'atmosphère était devenue trop pesante."
msgstr "Eu acabei saindo de casa porque o clima aqui tinha ficado pesado demais."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_994a90d2"
msgid "Je l'avais littéralement abandonnée maintenant que j'y pense."
msgstr "Pensando bem agora, eu a abandonei completamente."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f4de9cfb"
msgid "J'ai bien trop à me faire pardonner."
msgstr "Tenho muita coisa para me redimir."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fa8a2e36"
msgid "[font_size=14]Tu ne viens pas ?[/font_size]"
msgstr "[font_size=14]Você não vem?[/font_size]"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dd0fb42d"
msgid "Si, si, j'arrive tout de suite, pardon."
msgstr "Vou, vou sim, já estou indo. foi mal."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_29cd7803_1"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2cda0ed1"
msgid "Qu'est-ce que tu veux {{noriko.n}} ?"
msgstr "O que você quer, {{noriko.n}}?"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_eec1ad88"
msgid "Je suis désolée..."
msgstr "Me desculpa..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_98c178ef"
msgid "Quoi ?! Mais... Pourquoi tu-"
msgstr "O quê?! Mas... Por que você está-"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f9ff7016"
msgid "T'as qu'a demandé à ma mère !"
msgstr "Pergunta para minha mãe!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_defe9d51"
msgid "Mais qu'est-ce qui se passe ici ?"
msgstr "Mas que diabos está acontecendo aqui?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ba6e5f9f"
msgid "[font_size=14]Mon chéri, tu peux venir ?[/font_size]"
msgstr "[font_size=14]Querido, pode vir aqui um minuto?[/font_size]"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b97b9db1"
msgid "Euh, bien sûr, j'arrive."
msgstr "Er, claro, já estou indo."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9263e996"
msgid "Qu'est-ce que vous faisiez là-dedans ?"
msgstr "O que vocês estavam fazendo aí dentro?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bee23998"
msgid "On discutait..."
msgstr "Só conversando..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6b7cd08e"
msgid "De quoi ?"
msgstr "Sobre o quê?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1ef8e65b"
msgid "Tu es bien curieuse, tu es vraiment sûre de vouloir ?"
msgstr "Quanta curiosidade. Tem certeza de que quer mesmo saber?"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f15ff9f9"
msgid "Non, je m'en fiche !"
msgstr "Quer saber? Não me importa!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8ac83239"
msgid "...[w] Mais bon sang, pourquoi tu demandes alors ?"
msgstr "...[w] Mas que inferno, por que pergunta então?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_be8ae576"
msgid "Mon chéri, tout va bien ? Je t'ai vu parler avec mon patron, il avait l'air agité."
msgstr "Querido, está tudo bem? Vi você conversando com o meu patrão, ele parecia bem alterado."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_85ab81f8"
msgid "Je... Tout va bien en fait."
msgstr "Eu... está tudo bem, na verdade."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8c986c3a"
msgid "C'est terminé !"
msgstr "Acabou!"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bba1a917"
msgid "Que... qu'est-ce qui est terminé ? Tu me fais peur."
msgstr "O... o que acabou? Você está me assustando."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_87cb4a27"
msgid "Tu veux dire toi et... m-"
msgstr "Você quer dizer entre você e... eu-"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1431c12c"
msgid "Oh non, non, non, c'est pas ce que tu penses !"
msgstr "Ah, não, não, não! Não é nada disso que você está pensando!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_41efe727"
msgid "Je veux dire, tu n'as plus besoin de travailler pour lui dorénavant."
msgstr "Quero dizer que você não precisa mais trabalhar para ele daqui para frente."

#. Character:`notice`
#: game/story/home_player_livingroom.dialogue
msgctxt "t1b7b873e40"
msgid "Vous donnez les documents à {{yasuka.n}}."
msgstr "Você entrega os documentos para a {{yasuka.n}}."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d7ecbdb9"
msgid "La boutique est à présent à toi."
msgstr "A cafeteria agora é sua."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ef6d3f84"
msgid "Quoi ? La boutique ? Mais...[w] et tout cet argent, ça vient d'où ?"
msgstr "O quê? A cafeteria? Mas...[w] de onde veio todo esse dinheiro?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d02212ef"
msgid "C'est tout ce qu'il te devait et qu'il ne t'a jamais donné."
msgstr "É tudo o que ele te devia e nunca pagou."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_603ec36f"
msgid "Avec une prime pour se faire pardonner de son comportement."
msgstr "Com um bônus para se desculpar pelo comportamento dele."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_13ac109a"
msgid "Mais, mais, mais... C'est tellement d'argent, comment as-tu fait ça ?"
msgstr "Mas, mas, mas... É tanto dinheiro, como você conseguiu isso?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3d27d16d"
msgid "Peu importe comment j'ai fait, il a retrouvé la raison, il a eu des remords."
msgstr "Não importa como eu fiz, o importante é que ele caiu na real e se arrependeu."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1b2514ce"
msgid "Tout ça t'appartient, tu vas pouvoir faire comme tu veux dorénavant."
msgstr "Tudo isso é seu, você vai poder fazer o que quiser daqui em diante."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_34ff7b69"
msgid "Je...[w] je ne sais plus quoi dire...[w] Tout ça est merveilleux !"
msgstr "Eu...[w] nem sei o que dizer...[w] Tudo isso é maravilhoso!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f3605847"
msgid "Bonjour maman ! Que se passe-t-il, tu pleures ?"
msgstr "Oi, mãe! O que aconteceu? Você está chorando?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_156df126"
msgid "Non ma chérie, je suis simplement comblée."
msgstr "Não, querida, eu só estou muito feliz."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ef17f1fa"
msgid "{{saito.n}} m'a aidé à un point ou je ne pourrais jamais assez le remercier."
msgstr "O {{saito.n}} me ajudou de um jeito que eu nunca vou conseguir agradecer o suficiente."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_39dff64b"
msgid "Il a vraiment fait ça ?"
msgstr "Ele fez isso mesmo?"

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f09903a1"
msgid "Ahem, j'veux dire... Bien sûr qu'il a fait ça !"
msgstr "Ahem, quer dizer... É claro que ele fez!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_79ae5461"
msgid "Ma chérie, s'il te plait, prend un peu d'argent de poche et va te faire plaisir d'accord ?"
msgstr "Querida, pega uma grana aqui e vai se divertir um pouco, tá bom?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8f7d732c"
msgid "Une proposition pareille ne se refuse pas !"
msgstr "Uma oferta dessas não se recusa!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_96af6b9b"
msgid "Je rentrerai tard, ne m'attendez pas !"
msgstr "Vou voltar tarde, não me esperem!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_50dd106d"
msgid "...[w] Tu as fait exprès n'est-ce pas ?"
msgstr "...[w] Você fez de propósito, não foi?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6695022a"
msgid "Nous avons la maison rien que pour nous deux pour quelques heures."
msgstr "Nós temos a casa só para nós dois por algumas horas."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_91855c8a"
msgid "Mais avant..."
msgstr "Mas antes..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2cb4c6cb"
msgid "J'ai quelque chose à te demander."
msgstr "Tenho uma coisa para te perguntar."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_38f65e45"
msgid "[font_size=14]Est-ce que tu préfères... Quand c'est net ou tu t'en fiches ?[/font_size]"
msgstr "[font_size=14]Você prefere... Tudo lisinho ou tanto faz?[/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e73a231d"
msgid "De quoi ?"
msgstr "O quê?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c574e3e6"
msgid "[font_size=14]Grrr, tu le fais exprès, très bien, je vais être plus clair, tu préfères que je s-[/font_size]"
msgstr "[font_size=14]Grrr, você faz de propósito! Muito bem, vou ser mais clara: você prefere que eu me depi-[/font_size]"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_db8ff7ba"
msgid "Oh pardon ! Je viens de comprendre."
msgstr "Ah, desculpa! Acabei de entender."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ffe274f3"
msgid "Très bien, dans ce cas laisse-moi 5 minutes, patiente gentiment dans ma chambre."
msgstr "Muito bem, então me dá cinco minutos. Espere no meu quarto comportadamente."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5315d4b4"
msgid "Oh ! Okay"
msgstr "Ah! Beleza."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "td209b2c2a6"
msgid "Je préfère rasée."
msgstr "Prefiro depilada."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c582eb1a"
msgid "Tant mieux, moi aussi !"
msgstr "Que ótimo, eu também!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1d2f9261"
msgid "Ne perdons pas plus de temps alors !"
msgstr "Não vamos perder mais tempo então!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb512f6eedb"
msgid "Je préfère au naturel."
msgstr "Prefiro natural."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ca9344a9"
msgid "Quelle soirée... Je crois que je suis encore en plein rêve."
msgstr "Que noite... Parece que eu ainda estou sonhando."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d01ec298"
msgid "Par contre, j'ai tellement chaud que je crois que je vais exploser."
msgstr "Por outro lado, estou com tanto calor que acho que vou explodir."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1d407523"
msgid "Un peu d'air me fera du bien."
msgstr "Um pouco de ar fresco vai me fazer bem."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c6e8b355"
msgid "Prêt à passer la soirée rien que toi et moi ?"
msgstr "Pronto para passar a noite só você e eu?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b2f0b7bc"
msgid "Ce n'est pas le genre de proposition qui se refuse, mais..."
msgstr "Uma proposta dessas não se recusa, mas..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_11a90105"
msgid "Où est {{noriko.n}} ?"
msgstr "Onde está a {{noriko.n}}?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b9fc15b0"
msgid "...Dans sa chambre."
msgstr "...No quarto dela."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_db5e7a05"
msgid "Tu n'as pas peur que..."
msgstr "Você não tem medo de que..."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4c3003b8"
msgid "J'en ai assez de me cacher ou de retenir mes sentiments."
msgstr "Cansei de ficar me escondendo ou de segurar o que sinto."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b8278363"
msgid "Peu importe si elle est au courant, j'ai envie de penser à moi et de ce qui me fait plaisir !"
msgstr "Não importa se ela vai ficar sabendo, eu só quero pensar em mim e no que me dá prazer!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6e3b5bf1"
msgid "Et c'est de toi dont j'ai envie !"
msgstr "E é de você que eu estou com vontade!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9fdeed69"
msgid "Très bien, je comprends..."
msgstr "Muito bem, eu entendo..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3991d6db"
msgid "Allons prendre un bain ensemble, j'étais tellement bien dans tes bras la dernière fois..."
msgstr "Vamos tomar um banho juntos. Estava tão bom nos seus braços da última vez..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_02e9c44a"
msgid "Ça m'a trop manquée !"
msgstr "Senti tanta saudade disso!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3a1f4b0f"
msgid "À moi aussi !"
msgstr "Eu também!"

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_495cb7a4"
msgid "Woah, maman ! Je ne t'avais jamais vu aussi sexy !"
msgstr "Caramba, mãe! Eu nunca te vi tão sexy!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f847d1de"
msgid "Merci ma chérie... Et toi {{saito.n}}, tu en penses quoi ?"
msgstr "Obrigada, querida... E você, {{saito.n}}, o que achou?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_780d96ea"
msgid "Merci mon chéri."
msgstr "Obrigada, querido."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7b21e575"
msgid "J'espère que j'aurai du succès !"
msgstr "Espero fazer sucesso!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t90abfcf7f8"
msgid "Tu es magnifique."
msgstr "Você está maravilhosa."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1161be29"
msgid "C'est un bar à hôtesse !"
msgstr "É um clube de acompanhantes!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5740316b"
msgid "Il faut séduire ! Comment tu crois que ça fonctionne ?"
msgstr "Tem que seduzir! Como você acha que o negócio funciona?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t3c33ee3bf6"
msgid "C'est pas un peu trop... sexy justement?"
msgstr "Não está um pouco... sexy demais?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_647cf319"
msgid "Je suis quand même un peu tendue, je ne sais pas trop à quoi m'attendre."
msgstr "Mas ainda estou um pouco tensa, não sei bem o que me espera."

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dce8de6e"
msgid "Fais juste attention aux pervers avec leurs mains baladeuses."
msgstr "Só toma cuidado com os tarados de mãos bobas."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_147924ed"
msgid "Les hommes sont des porcs."
msgstr "Homem é tudo uns porcos."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ed6623a0_1"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_81c16521"
msgid "Bon courage pour ton premier jour !"
msgstr "Boa sorte no seu primeiro dia!"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3b2034d1"
msgid "Dis...[w] Tu ne voudrais pas m'accompagner jusqu'au club ?"
msgstr "Escuta...[w] Você não gostaria de me acompanhar até lá?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e6357cba"
msgid "S'il te plait !"
msgstr "Por favor!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fd320b15"
msgid "Tu sais bien que tu peux toujours compter sur moi !"
msgstr "Você sabe que pode sempre contar comigo!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dc79a81b"
msgid "Je t'attendrai même devant si tu veux."
msgstr "Eu até te espero lá na frente se você quiser."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_04b82f09"
msgid "Merci, tu es adorable."
msgstr "Obrigada, você é um amor."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_860cf267"
msgid "Mais je risque de rentrer très tôt demain matin."
msgstr "Mas eu corro o risco de voltar só amanhã de manhã."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fb22a69b"
msgid "C'est un travail de nuit après tout."
msgstr "É um trabalho noturno, afinal de contas."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_53149d83"
msgid "Promets-moi d'être prudente !"
msgstr "Me promete que vai tomar cuidado!"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d7140c37"
msgid "Oh, tu t'inquiètes pour moi ?"
msgstr "Ah, você está preocupado comigo?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d4f6d95d"
msgid "Ça ira, je suis confiante et puis...[w] Ce sera toujours mieux que mon ancien travail."
msgstr "Vai dar tudo certo, estou confiante...[w] E vai ser bem melhor do que o meu antigo emprego."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_eafdd494"
msgid "Ton ancien travail ? Tu faisais quoi ?"
msgstr "Seu antigo emprego? Você fazia o quê?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8d8126b7"
msgid "Je travaillais pour le petit café au coin de la rue."
msgstr "Eu trabalhava naquela cafeteria na esquina."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_901fedd4"
msgid "Mais mon patron était un homme horrible."
msgstr "Mas o meu patrão era um homem horrível."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c2f513b1"
msgid "Je suis soulagée de ne plus avoir affaire à lui."
msgstr "Estou aliviada por não ter mais que lidar com ele."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9c3fd7fa"
msgid "Je suis désolé, j'ignorais tout ça !"
msgstr "Sinto muito, eu não fazia ideia disso!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_53875209"
msgid "Il t'a laissé démissionner sans poser de problèmes ?"
msgstr "Ele deixou você se demitir sem criar problemas?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_57a70dec"
msgid "...Non, il m'a menacé de m'empêcher de travailler ailleurs, mais j'ai déjà un autre travail maintenant donc je m'en fichais un peu."
msgstr "...Não, ele me ameaçou dizendo que ia me impedir de trabalhar em outro lugar, mas como eu já consegui esse novo emprego, nem liguei muito."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c3893a2a"
msgid "Quand je pense qu'elle a dû traverser ça seule..."
msgstr "E pensar que ela teve que passar por tudo isso sozinha..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4fd30970"
msgid "J'étais vraiment une merde pour ne pas avoir vu à quel point elle pouvait souffrir de cette situation."
msgstr "Eu fui um belo de um bosta por não ter visto o quanto ela estava sofrendo com essa situação."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6f5c15a3"
msgid "En espérant que ce nouveau travail donne quelque chose de positif."
msgstr "Tomara que esse novo trabalho traga algo de positivo."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_75a316c5"
msgid "Quand j'y pense, dans mon ancienne vie, elle avait aussi travaillé en tant qu'hôtesse."
msgstr "Pensando bem, na minha vida passada, ela também tinha trabalhado como acompanhante."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_02e31a66"
msgid "Mais la mort de {{noriko.n}} l'avait complètement détruite."
msgstr "Mas a morte da {{noriko.n}} tinha acabado com ela."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1606c712"
msgid "Elle ne rentrait plus à la maison, ne me parlait plus..."
msgstr "Ela não voltava mais para casa, não falava comigo..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0168a65e"
msgid "Je dois continuer mes efforts, je ne veux pas qu'il lui arrive malheur."
msgstr "Preciso continuar me esforçando, não quero que nada de ruim aconteça com ela."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0d6ac7ed"
msgid "Mon Dieu ! Je n'ai pas vu le temps passer. Je vais être en retard pour mon premier jour."
msgstr "Meu Deus! Nem vi o tempo passar. Vou acabar me atrasando no meu primeiro dia."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6e2cc205"
msgid "C'est ma faute, allons-y !"
msgstr "A culpa é minha, vamos logo!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_476505df"
msgid "Bonjour mes chéris !"
msgstr "Olá, meus amores!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_256277c3"
msgid "Salut M'man !"
msgstr "Oi, mãe!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_19c84fda"
msgid "Comment s'est passé ton premier jour ?"
msgstr "Como foi o seu primeiro dia?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f495571f"
msgid "Je ne sais pas pourquoi je me suis autant inquiétée..."
msgstr "Eu não sei por que me preocupei tanto..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3f813edb"
msgid "Tout le monde a été très gentil avec moi, j'ai fait la connaissance d'énormément de monde."
msgstr "Todo mundo foi muito gentil comigo, conheci muita gente nova."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_28650062"
msgid "Même les clients étaient ravis de voir une nouvelle comme moi."
msgstr "Até os clientes adoraram ver uma novata como eu."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_54136832"
msgid "Génial, je suis contente pour toi !"
msgstr "Que ótimo, fico feliz por você!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7fb24f9d"
msgid "Je suis content que tout se soit bien passé."
msgstr "Que bom que correu tudo bem."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4a31f01b"
msgid "Je ne sais pas pourquoi, j'ai imaginé le pire en te voyant travailler là-bas."
msgstr "Não sei por que, mas imaginei o pior quando te vi indo trabalhar lá."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_30d1c268"
msgid "Mon chéri ne t'inquiète pas autant pour moi, ça devrait être l'inverse, tu sais."
msgstr "Querido, não se preocupe tanto comigo, deveria ser o contrário, sabe?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6f677c50"
msgid "Tu es un homme à présent."
msgstr "Você já é um homem feito."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6d8c7cc8"
msgid "Je suis certain que ta future femme sera heureuse avec quelqu'un d'aussi intentionné que toi."
msgstr "Tenho certeza de que a sua futura esposa vai ser muito feliz com alguém tão atencioso assim."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b4e69ca9_2"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_801ee4d0"
msgid "Je vais aller me reposer à présent, je tombe littéralement de sommeil et je reprends le travail ce soir."
msgstr "Vou me deitar um pouco agora, estou caindo de sono e volto a trabalhar hoje à noite."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d6369a9f"
msgid "Oui, je comprends, repose-toi bien."
msgstr "Sim, eu entendo, descanse bastante."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_17bcaacf"
msgid "Ne faites pas trop de bruits tous les deux."
msgstr "Não façam muito barulho vocês dois."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b4141f4a"
msgid "Promis !"
msgstr "Pode deixar!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e4a767b5"
msgid "{{yasuka.n}} n'est pas là ?"
msgstr "A {{yasuka.n}} não está?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e1615d6a"
msgid "Non, elle est déjà partie."
msgstr "Não, ela já saiu."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4c71155e"
msgid "Merde !"
msgstr "Merda!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2f3172d9"
msgid "Un problème ?"
msgstr "Algum problema?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_13f23864"
msgid "Oui, je vais essayer de la rattraper !"
msgstr "Sim, vou tentar alcançar ela!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c4254423"
msgid "Bonjour mon chéri, tu as passé une bonne nuit ?"
msgstr "Bom dia, querido. Dormiu bem?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ee52bdf2"
msgid "Et toi ?"
msgstr "E você?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_79d3b417"
msgid "Est-ce que tu as eu des problèmes avec..."
msgstr "Teve algum problema com..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2361752a"
msgid "Le garçon que tu avais mentionné est effectivement venu me parler, mais honnêtement, tu n'avais pas à t'inquiéter."
msgstr "Aquele rapaz que você mencionou realmente veio falar comigo, mas honestamente, você não precisava ter se preocupado."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8d6f4fee"
msgid "Son attitude était déplorable et la façon de traiter les femmes était absolument méprisable."
msgstr "A atitude dele era deplorável e o jeito como ele tratava as mulheres era absolutamente desprezível."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e980fa5c"
msgid "Il a passé le reste de la soirée assis dans un coin."
msgstr "Ele passou o resto da noite sentado num canto."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e1ec221b"
msgid "J'ai bien vu qu'il semblait furieux, mais la sécurité est vraiment efficace là-bas."
msgstr "Deu para ver que ele parecia furioso, mas a segurança de lá é realmente eficiente."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ae2141db"
msgid "C'est une excellente nouvelle !"
msgstr "Que alívio! Fico bem mais tranquilo sabendo disso."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_47e22585"
msgid "Par contre... Mr. {{netoru.n}} s'est peut-être un peu trop amusé à le provoquer."
msgstr "Por outro lado... O senhor {{netoru.n}} talvez tenha se divertido até demais provocando ele."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_91e54d91"
msgid "Il n'a rien tenté quoi que ce soit avec toi ?"
msgstr "Ele não tentou nada com você?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e9625e33"
msgid "Non, non, bien au contraire... Il a été courtois, parfois amusant, sans jamais un geste déplacé."
msgstr "Não, não, pelo contrário... Ele foi cortês, às vezes até engraçado, sem nunca ter um gesto inadequado."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_007769b1"
msgid "Ah bon ?"
msgstr "É mesmo?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c753102b"
msgid "Je suis sûr que cette ordure à le même objectif qu'{{akira.n}}."
msgstr "Tenho certeza de que esse lixo tem o mesmo objetivo que o {{akira.n}}."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f77fb6b5"
msgid "De plus, il semble bien plus calculateur."
msgstr "Além disso, ele parece ser muito mais calculista."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4eca95dc"
msgid "Putain, ça me rend fou de savoir qu'il va passer tout son temps avec des intentions aussi sales à côté d'elle."
msgstr "Porra, me deixa louco saber que ele vai passar o tempo todo perto dela com intenções tão sujas."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ec4c5ba3"
msgid "Tu vois que tu t'inquiètes trop !"
msgstr "Viu só como você se preocupa demais!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2297e48f"
msgid "La soirée d'hier soir a d'ailleurs été une très bonne soirée !"
msgstr "A propósito, a noite de ontem foi muito boa!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_826f8451"
msgid "Je suis enfin capable de vous donner un peu d'argent de poche."
msgstr "Finalmente consigo te dar um dinheirinho para gastar."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_505108b8"
msgid "Je suis si heureuse, je vais enfin pouvoir payer mes dettes et vous faire plaisir."
msgstr "Estou tão feliz, vou finalmente poder pagar minhas dívidas e dar alguns mimos para vocês."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_75c56896"
msgid "Mon chéri ne t'en fait pas, ce n'est pas 10000¥ qui changeront quoi que ce soit."
msgstr "Não se preocupe, querido, não são dez mil ienes que vão mudar as coisas."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_46c64f6d"
msgid "S'il te plait, garde les et profite en un peu aussi, les choses semblent s'arranger pour le mieux donc autant en profiter."
msgstr "Por favor, guarde e aproveite um pouco também. As coisas parecem estar melhorando, então vamos aproveitar."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5774b098"
msgid "Je gagne assez avec mon travail au restaurant. Je tiens vraiment à ce que nous puissions rembourser nos dettes le plus vite possible."
msgstr "Eu ganho o suficiente com meu trabalho no restaurante. Faço questão de que a gente quite as dívidas o quanto antes."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1bde17bc"
msgid "Tu es si sérieux... Mais tu as raison. Je vais les mettre de côté."
msgstr "Você é tão sério... Mas tem razão. Vou guardar esse valor."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t43aa4a80b9"
msgid "Merci, mais... Je préférerais que tu gardes l'argent pour rembourser les dettes."
msgstr "Obrigado, mas... Prefiro que guarde o dinheiro para as dívidas."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c6612f1f"
msgid "J'ai envie de vous faire plaisir."
msgstr "Eu faço questão de dar um agrado para vocês."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_87081007"
msgid "Alors, amusez-vous toi et à {{noriko.n}}."
msgstr "Então, divirta-se você e a {{noriko.n}}."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_159d3215"
msgid "Merci beaucoup."
msgstr "Muito obrigado."

#. Character:`notice`
#: game/story/home_player_livingroom.dialogue
msgctxt "t1291ee4082"
msgid "Vous obtenez 10000¥"
msgstr "Você recebeu 10.000¥"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "t4c0b35a2e2"
msgid "Oh, c'est gentil, mais c'était pas nécessaire, tu sais."
msgstr "Valeu, mas não precisava, sabe?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_07e7f332"
msgid "Je tombe de sommeil, je crois bien que je vais aller dormir à présent."
msgstr "Estou caindo de sono, acho que vou dormir agora."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2e5d5488"
msgid "D'accord, repose-toi bien !"
msgstr "Tudo bem, descanse bastante!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8aac915e"
msgid "Merci mon chéri."
msgstr "Obrigada, querido."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1b5723bb"
msgid "Bonjour mon chéri !"
msgstr "Bom dia, querido!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_19feb979"
msgid "Tu as passé une bonne nuit ?"
msgstr "Dormiu bem?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0f5035bd"
msgid "J'ai... J'ai fait un rêve beaucoup trop étrange cette nuit."
msgstr "Eu... tive um sonho muito estranho esta noite."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4f2af91f"
msgid "Mhh, c'est curieux, moi aussi... C'était à propos de quoi ?"
msgstr "Mhh, que curioso, eu também... Sobre o que era?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d925a004"
msgid "Euh je... Tu venais dans ma chambre et..."
msgstr "Er... bem... Você vinha no meu quarto e..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_be57f3f8"
msgid "C'est... Moi aussi, je venais dans ta chambre pour..."
msgstr "É... eu também, eu ia no seu quarto para..."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6a9a30bf"
msgid "Oh mon Dieu !"
msgstr "Ah meu Deus!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d822172f"
msgid "Qu'est-ce que j'ai fait ?"
msgstr "O que foi que eu fiz?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5f58c730"
msgid "Oh putain, c'était donc pas un rêve ?!"
msgstr "Puta merda, então não foi um sonho?!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_91b6ce49"
msgid "Bon sang, à quel point avait-elle bu pour me sauter dessus comme ça ?"
msgstr "Caramba, o quanto ela bebeu para pular em cima de mim desse jeito?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_51e8dc27"
msgid "Il faut plus que de l'alcool pour provoquer ce genre de dérapage."
msgstr "É preciso mais do que álcool para provocar um vacilo desses."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2e908f82"
msgid "À bien y réfléchir, il y a forcément autre chose."
msgstr "Parando para pensar, tem que ter algo a mais."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_890d1dd7"
msgid "{{macumba.n}} a peut être vu quelque chose de louche avant que {{yasuka.n}} s'en aille du club hier soir."
msgstr "O {{macumba.n}} pode ter visto algo suspeito antes da {{yasuka.n}} sair do clube de acompanhantes ontem à noite."

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bb0b3a57"
msgid "Oh mon chéri, je suis tellement désolée, je ne sais pas du tout ce qui m'a pris."
msgstr "Ah, querido, sinto muito, eu não sei o que deu em mim."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e3cc0e39"
msgid "J'ai vraiment fait quelque chose d'horrible."
msgstr "Eu fiz uma coisa horrível."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b74b8f38"
msgid "Je te demande pardon..."
msgstr "Me perdoa..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c9b93f69"
msgid "Je ne veux pas que tu me haïsses."
msgstr "Não quero que você me odeie."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_011a6359"
msgid "Mon chéri, je suis tellement désolée, je ne sais plus où me mettre."
msgstr "Sério, me desculpa, eu nem sei onde enfiar a cara."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f0835c28"
msgid "J'ai tellement honte de moi."
msgstr "Estou com tanta vergonha de mim mesma."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_50928fae"
msgid "Cette situation est vraiment en train de la tuer..."
msgstr "Essa situação está acabando com ela..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_17680b8c"
msgid "Il faut que je fasse quelque chose, ou elle s'en voudra toute sa vie."
msgstr "Eu preciso fazer alguma coisa, ou ela vai se culpar pelo resto da vida."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_78235b70"
msgid "Je suis sûr d'avoir rêvé en fait... J'ai du mal à me souvenir ce qui s'est exactement passé."
msgstr "Na verdade, eu tenho certeza de que foi um sonho... Mal consigo lembrar do que aconteceu exatamente."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fe4f044e"
msgid "Je t'ai vu venir dans ma chambre en lingerie et... je me vois te raccompagner après ça..."
msgstr "Eu vi você entrando no meu quarto de lingerie e... depois me vejo te levando de volta..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6c848cff"
msgid "Le trou noir total."
msgstr "Deu um branco total."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5fdf9c5f"
msgid "Oh ! Je... Tu ne te souviens pas de la suite ?"
msgstr "Oh! Eu... Você não lembra do resto?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b13e159a"
msgid "Non... Après, je crois que le toit de ta chambre s'est ouvert et tu t'es envolé comme si tu pilotais ton lit comme un avion."
msgstr "Não... Depois disso, acho que o teto do seu quarto se abriu e você saiu voando, pilotando a sua cama como se fosse um avião."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1bf78d55"
msgid "Effectivement, c'est... Un drôle de rêve..."
msgstr "Realmente, é... um sonho bem maluco..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_34b15c01"
msgid "Tu m'as fait une peur bleue, j'ai cru que j'avais...."
msgstr "Você me deu um susto enorme, achei que eu tinha...."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cd173feb"
msgid "Que tu avais... quoi ?"
msgstr "Que você tinha... o quê?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8256d083"
msgid "Rien !"
msgstr "Nada!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_946c509c"
msgid "Je dois te laisser, j'ai... à faire !"
msgstr "Preciso ir, tenho... coisas para fazer!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_392bf5ff"
msgid "Bon, elle semble avoir cru à mon mensonge..."
msgstr "Bom, parece que ela acreditou na minha mentira..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d0c3468a"
msgid "Désolé {{yasuka.n}}, mais je me souviens de tout."
msgstr "Desculpa, {{yasuka.n}}, mas eu lembro de tudo."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d64fd862"
msgid "Cette situation me rappelle quelque chose, mais je ne parviens pas à en souvenir."
msgstr "Essa situação me lembra algo, mas não consigo recordar o quê."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7d03dbb5"
msgid "Je deviens parano à force."
msgstr "Estou ficando paranoico com isso."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f0f4a033"
msgid "S'il s'agit d'une drogue, peut-être que {{kimochi.n}} en aurait entendue parler."
msgstr "Se for alguma droga, talvez o {{kimochi.n}} tenha ouvido falar de algo."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ff524161"
msgid "Il aura peut-être des choses à m'apprendre."
msgstr "Talvez ele tenha algo para me ensinar."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2e7220e7"
msgid "{{yasuka.n}} ?"
msgstr "{{yasuka.n}}?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_03775ec8_2"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ede251e5"
msgid "Elle serait déjà en train de dormir ?"
msgstr "Ela já deve estar dormindo."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8df197e8"
msgid "Merde, je devrais peut-être aller voir dans sa chambre si tout va bien..."
msgstr "Merda, talvez eu devesse ir ver no quarto dela se está tudo bem..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f8466675"
msgid "{{yasuka.n}}, tu vas bien ?"
msgstr "{{yasuka.n}}, você está bem?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_43dc78c9"
msgid "...Non, je voulais passer ma soirée et ma nuit avec toi, mais je dois aller travailler."
msgstr "...Não. Eu queria passar minha noite com você, mas tenho que ir trabalhar."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e1634ccc"
msgid "Oh je... Oui, moi aussi, j'aurais préféré ça."
msgstr "Ah, eu... É, eu também preferia que fosse assim."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d0f40cdf"
msgid "Mais tu sais quoi, j'ai une petite pause d'une heure dans ma soirée."
msgstr "Mas sabe de uma coisa? Vou ter uma pausinha de uma hora durante o turno."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e62dcc9e"
msgid "Je t'attendrai au Love Hotel !"
msgstr "Vou te esperar no Love Hotel!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d3af3e61"
msgid "Tu es certaine que..."
msgstr "Tem certeza que..."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b8d9cd1f"
msgid "Tututu, je ne veux rien entendre d'autre !"
msgstr "Shhh! Não quero ouvir nem mais um \"a\"!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_14be3314"
msgid "Rejoins-moi ce soir, nous n'aurons pas à nous inquiéter d'être vu ou entendu !"
msgstr "Me encontra lá hoje à noite, não vamos precisar nos preocupar com ninguém vendo ou ouvindo!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9c6b4cac"
msgid "Elle a raison, si je ne fais rien à la maison pendant un certain temps."
msgstr "Ela tem razão. Se eu ficar quieto em casa por um tempo..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a47145a1"
msgid "Peut-être que {{sakuya.n}} se dira que tout va bien ?"
msgstr "Talvez a {{sakuya.n}} ache que está tudo bem?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ad545b5d"
msgid "J'aurais juste à faire attention à ne pas être suivis."
msgstr "Só vou ter que tomar cuidado para não ser seguido."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_84ab5327"
msgid "Je te rejoindrai, c'est promis !"
msgstr "Eu vou te encontrar, sem falta!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e42d8709"
msgid "J'ai hâte d'y être, à tout à l'heure mon chéri."
msgstr "Mal posso esperar. Até daqui a pouco, querido."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fc469246"
msgid "Il va me falloir redoubler de vigilance."
msgstr "Vou ter que redobrar a vigilância."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7be848d3"
msgid "Mais si je fais attention, il n'y a pas de raison que les choses dégénèrent."
msgstr "Mas se eu for cuidadoso, não tem por que as coisas darem errado."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f88e0dcf"
msgid "Je pense pas que partir maintenant soit une bonne idée."
msgstr "Acho que sair agora não é uma boa ideia."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_eea59b22"
msgid "Je suis certain que {{sakuya.n}} est là à dehors à me surveiller."
msgstr "Certeza que a {{sakuya.n}} está lá fora me vigiando."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c1f4e9be"
msgid "Je devrais attendre dans la chambre et aller me coucher."
msgstr "Melhor esperar no quarto e fingir que vou deitar."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7bf9ec23"
msgid "Je sortirai en douce par la fenêtre pendant la nuit."
msgstr "Saio de fininho pela janela no meio da noite."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "BONJOUR_YASUKA_A2F9F3"
msgid "Bonjour Yasuka !"
msgstr "Bom dia, {{yasuka.n}}!"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_D_SOL_E_MON_CH_RI_8D06B8"
msgid "... Je suis désolée, mon chéri."
msgstr "... Me desculpa, querido."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AVAIS_PRIS_QUELQUES_JOURS_DE_30ED7A"
msgid "J'avais pris quelques jours de congés pour réfléchir à cette proposition de travail d'hôtesse."
msgstr "Eu tinha tirado uns dias de folga para pensar naquela proposta de trabalho como acompanhante."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_D_SOL_JE_NE_GAGNE_PAS_E9CDCD"
msgid "Je suis désolé, je ne gagne pas encore beaucoup d'argent, mais je te promets que je ferai de mon mieux pour t'aider."
msgstr "Sinto muito. Eu ainda não ganho muito dinheiro, mas prometo que vou dar o meu melhor para te ajudar."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "MON_CH_RI_TU_ES_VRAIMENT_ADORA_25E031"
msgid "Mon chéri, tu es vraiment adorable, mais... Tu n'as pas à te sentir obligé de faire ça."
msgstr "Você é um amor, querido, de verdade... Mas não precisa se sentir obrigado a isso."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_DEVRAIS_TE_CONCENTRER_SUR_T_800206"
msgid "Tu devrais te concentrer sur tes futures études et..."
msgstr "Você devia focar nos seus estudos e..."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_N_Y_AURA_DE_TOUTE_FA_ON_AUC_E82ED0"
msgid "Il n'y aura de toute façon aucune étude s'il n'y a pas d'argent."
msgstr "Não vai ter estudo nenhum se não tiver dinheiro, de qualquer jeito."

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_MOI_DE_M_EXCUSER_DANS_CE_2D4D11"
msgid "C'est à moi de m'excuser dans ce cas... Je n'ai pas été quelqu'un de très fiable."
msgstr "Então sou eu quem deve pedir desculpas... Eu não tenho sido alguém muito responsável."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "CAUSE_DE_MOI_TU_ES_OBLIG_DE_T_1501E1"
msgid "À cause de moi, tu es obligé de travailler..."
msgstr "Por minha causa, você é obrigado a trabalhar..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "A_NE_ME_D_RANGE_PAS_AU_CONTRA_41AC98"
msgid "Ça ne me dérange pas, au contraire, grâce à toi j'ai eu un semblant de vie normale."
msgstr "Isso não me incomoda. Pelo contrário, graças a você eu tive um pouco de vida normal."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VEUX_T_AIDER_ALORS_LAISSE_M_65B578"
msgid "Je veux t'aider, alors laisse-moi t'aider."
msgstr "Eu quero te ajudar, então me deixa fazer isso."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_ES_UN_AMOUR_JE_NE_M_RITE_PA_20DF8B"
msgid "Tu es un amour, je ne mérite pas un garçon aussi gentil que toi..."
msgstr "Você é um anjo, eu nem mereço um rapaz tão gentil quanto você..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_LA_MOINDRE_DES_CHOSES_51029D"
msgid "C'est la moindre des choses !"
msgstr "É o mínimo que eu posso fazer!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_SI_ON_ARRIVE_MOTIVER_NORIKO_C2BAA1"
msgid "Et si on arrive à motiver {{noriko.n}}, on pourrait même la rembourser encore plus vite, cette dette !"
msgstr "E se a gente conseguir motivar a {{noriko.n}}, daria para pagar essa dívida ainda mais rápido!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "W_FONT_SIZE_14_JE_PENSE_QU_IL_E4AF36"
msgid "...[w] [font_size=14]Je pense qu'il sera plus facile de rembourser la dette que de la motiver à trouver un travail ![/font_size]"
msgstr "...[w] [font_size=14]Acho que vai ser mais fácil quitar a dívida do que motivar ela a procurar um emprego![/font_size]"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "HAHAHA_C_EST_PAS_FAUX_708AB5"
msgid "Hahaha ! C'est pas faux..."
msgstr "Hahaha! Pior que é verdade..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "VIENS_ME_VOIR_LA_BOUTIQUE_AU_C_D15D93"
msgid "Viens me voir à la boutique au coin de la rue en début d'après-midi."
msgstr "Passa lá na cafeteria da esquina no começo da tarde."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "A_TE_DONNERA_L_OCCASION_DE_VO_CF550F"
msgid "Ça te donnera l'occasion de voir où je travaille."
msgstr "Vai ser uma chance de você ver onde eu trabalho."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_SI_MON_PATRON_N_EST_PAS_TRO_F61577"
msgid "Et si mon patron n'est pas trop grincheux, peut-être que je pourrai t'offrir quelque chose."
msgstr "E se o meu patrão não estiver muito ranzinza, talvez eu consiga te pagar alguma coisa."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_INT_RESSANT_A_JE_VIENDRAI_C_C75777"
msgid "Oh ! Intéressant, ça, je viendrai, c'est certain."
msgstr "Opa! Gostei disso. Com certeza eu vou."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_L_ESP_RE_AUSSI_JE_TE_LAISSE_770A12"
msgid "Je l'espère aussi ! Je te laisse à présent je dois y aller."
msgstr "Espero que sim! Vou indo agora, preciso ir."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "POURQUOI_J_AI_LA_SENSATION_QU_6EFE16"
msgid "Pourquoi j'ai la sensation qu'on a parlé de moi dans mon dos ?"
msgstr "Por que eu estou sentindo que estavam falando de mim pelas costas?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "EUH_J_EN_SAIS_RIEN_24BED4"
msgid "Euh... J'en sais rien."
msgstr "Er... sei lá."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_livingroom.dialogue
msgctxt "TOI_T_AS_LA_T_TE_D_UN_CHIEN_QU_9BBF91"
msgid "Toi, t'as la tête d'un chien qui a fait caca là où il n'aurait pas dû et pense que ça ne se verra pas!"
msgstr "Você está com a cara de um cachorro que fez cocô onde não devia e acha que ninguém vai perceber!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_NON_JE_D82CF9"
msgid "Mais... Non, je"
msgstr "Mas... não, eu..."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "PAS_DE_MAIS_AVEC_MOI_A6EFF0"
msgid "Pas de mais avec moi."
msgstr "Não me venha com \"mas\" pra cima de mim."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VEUX_SAVOIR_MAINTENANT_458BD3"
msgid "Je veux savoir, maintenant !"
msgstr "Eu quero saber agora!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "BON_BON_TR_S_BIEN_AF4A7F"
msgid "Bon, bon, très bien."
msgstr "Tá bom, tá bom, você venceu."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_DOIS_SAVOIR_QUE_YASUKA_N_CR_046B59"
msgid "Tu dois savoir que {{yasuka.n}} croule sous les dettes, n'est-ce pas ?"
msgstr "Você sabe que a {{yasuka.n}} está afundada em dívidas, não sabe?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUI_LA_FAUTE_SHERLOCK_A26FFD"
msgid "À qui la faute, Sherlock ?"
msgstr "E a culpa é de quem, Sherlock?"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "W_M_ME_SANS_LA_DETTE_DE_MON_P_109BCB"
msgid "...[w] Même sans la dette de mon père, il y a toujours beaucoup à rembourser."
msgstr "...[w] Mesmo sem a dívida do meu pai, ainda tem muita coisa para pagar."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "PFFF_TOUT_LE_MONDE_A_QUELQUE_C_F017D6"
msgid "Pfff... tout le monde a quelque chose à rembourser, tout le monde a un crédit, c'est ça être adulte."
msgstr "Pfff... todo mundo tem algo para pagar, todo mundo tem conta, é isso que significa ser adulto."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_ELLE_QUI_FAISAIT_N_IMPOR_B02026"
msgid "C'est elle qui faisait n'importe quoi avec son argent, pas moi, donc c'est à elle d'assumer !"
msgstr "Ela que fazia besteira com o dinheiro dela, não eu, então ela que assuma!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_N_AIDERAS_M_ME_PAS_UN_PEU_C4CE61"
msgid "Tu n'aideras même pas un peu ?"
msgstr "Você não vai ajudar nem um pouquinho?"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_ME_SAOULES_POURQUOI_JE_DEV_FAE6CD"
msgid "... Tu me saoûles, pourquoi je devrais payer pour les conneries des autres ?!"
msgstr "... Você me amola, hein? Por que eu deveria pagar pelas burradas dos outros?!"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "SI_TU_VEUX_UN_BON_CONSEIL_NE_D_B4FBC4"
msgid "Si tu veux un bon conseil, ne dépense jamais l'argent que tu n'as pas !"
msgstr "Se quer um bom conselho: nunca gaste o dinheiro que você não tem!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "DIFFICILE_DE_TE_DONNER_TORT_L_3FE286"
msgid "... Difficile de te donner tort là-dessus."
msgstr "... Difícil dizer que você está errada nisso."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_PUIS_SI_TU_VEUX_GAGNER_BEAU_AB1A42"
msgid "Et puis si tu veux gagner beaucoup d'argent, j'ai une combine pour toi."
msgstr "E se você quer ganhar muito dinheiro, eu tenho um esquema para você."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "AU_CENTRE_VILLE_IL_Y_A_UN_SALO_622C30"
msgid "Au centre-ville, il y a un salon de massage, si tu fais quelques finitions discrètement."
msgstr "Tem uma casa de massagem no centro... se você fizer umas \"finalizações\" discretas..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "Y_A_MOYEN_QUE_A_RAPPORTE_BEAUC_57D846"
msgid "Y a moyen que ça rapporte beaucoup."
msgstr "Dá para tirar uma grana preta."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "TR_S_DR_LE_2249FA"
msgid "Très drôle..."
msgstr "Engraçadinha..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "BON_SI_T_AS_COMPRIS_FICHE_MOI_E0302B"
msgid "Bon, si t'as compris, fiche moi la paix et va travailler !"
msgstr "Bom, se já entendeu, me deixa em paz e vai trabalhar!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MON_CH_RI_JE_SUIS_SINC_REMENT_8A49AF"
msgid "Mon chéri... je suis sincèrement désolée pour ce qui s'est passé cet après-midi..."
msgstr "Querido... Sinto muito por hoje à tarde..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_ESSAY_D_EN_PARLER_MON_PAT_BAA465"
msgid "J'ai essayé d'en parler à mon patron mais..."
msgstr "Eu tentei conversar com o meu patrão, mas..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_N_EST_PAS_DU_GENRE_TENIR_CO_670AFF"
msgid "Il n'est pas du genre à tenir compte de ce qu'on lui dit ?"
msgstr "Ele não é do tipo que ouve o que os outros dizem, né?"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_A91477"
msgid "Non..."
msgstr "Não..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "CE_N_EST_PAS_GRAVE_C_EST_SURTO_FB7D77"
msgid "Ce n'est pas grave, c'est surtout pour toi que je m'inquiète."
msgstr "Não tem problema. Eu me preocupo é com você."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "POURQUOI_TU_CONTINUES_DE_TRAVA_7DF794"
msgid "Pourquoi tu continues de travailler pour un homme aussi odieux ?"
msgstr "Por que você continua trabalhando para um homem tão detestável?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_TAIT_L_UNE_DES_PRINCIPALES_R_B73ECD"
msgid "C'était l'une des principales raisons pour lesquelles je voulais quitter mon travail, l'autre raison tu la connais."
msgstr "Esse era um dos principais motivos para eu querer sair, o outro você já sabe."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_NE_GAGNAIS_PAS_ASSEZ_POUR_R_39E5B7"
msgid "Je ne gagnais pas assez pour rembourser mes dettes."
msgstr "Eu não ganhava o suficiente para pagar minhas dívidas."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VOIS_MAIS_IL_Y_A_UNE_CHOSE_F55AF2"
msgid "Je vois... Mais il y a une chose que j'aimerais que tu m'expliques."
msgstr "Entendo... Mas tem uma coisa que eu queria que você me explicasse."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "CES_DETTES_JE_PEUX_COMPRENDRE_6762F4"
msgid "Ces dettes... Je peux comprendre d'où viennent celles de mon père mais d'où viennent les tiennes ?"
msgstr "Essas dívidas... Eu entendo de onde vieram as do meu pai, mas e as suas?"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_C_EST_DISONS_QUE_C_EST_UNE_764D39"
msgid "Oh... c'est... Disons que c'est une succession de très mauvaises décisions qui m'ont menée jusqu'ici."
msgstr "Ah... bem... Digamos que foi uma sucessão de decisões muito ruins que me trouxeram até aqui."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_N_AI_FAIT_DEPUIS_MON_ADOLES_1F9A5F"
msgid "Je n'ai fait depuis mon adolescence que de mauvais choix."
msgstr "Desde a adolescência, eu só fiz escolhas erradas."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_Y_A_BEAUCOUP_DE_CHOSES_QUE_BA02E7"
msgid "Il y a beaucoup de choses que je regrette et je me suis dit d'une certaine manière qu'avoir un patron aussi odieux était une façon de rééquilibrer mon karma."
msgstr "Me arrependo de muita coisa... e, de certa forma, pensei que aguentar um patrão odioso fosse um jeito de equilibrar meu carma."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_NE_COMPRENDS_PAS_POURQUOI_T_F03776"
msgid "Je ne comprends pas, pourquoi tu penses que tu mérites ce qui t'arrive ?"
msgstr "Não entendo. Por que você acha que merece passar por isso?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUAND_TU_DIS_N_AVOIR_FAIT_QUE_C15AE7"
msgid "Quand tu dis n'avoir fait que de mauvais choix... Tu penses que s'occuper de moi quand j'étais petit était donc une mauvaise décision ?"
msgstr "Quando diz que só fez escolhas erradas... Você acha que ter cuidado de mim quando eu era pequeno foi uma decisão ruim?"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_NON_MON_CH_RI_NON_JAMAIS_D4A528"
msgid "Quoi ?! Non !! Mon chéri non ! Jamais je n'ai pensé ça !"
msgstr "O quê?! Não!! Claro que não! Jamais pensei isso!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_PARL_SANS_R_FL_CHIR_JE_TE_FA3A54"
msgid "J'ai parlé sans réfléchir, je te demande pardon !"
msgstr "Eu falei sem pensar, me perdoa!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "CE_N_EST_PAS_GRAVE_MON_P_RE_NE_720816"
msgid "Ce n'est pas grave... Mon père ne t'a jamais demandé ton avis et tu as toujours fait de ton mieux de ton côté."
msgstr "Tudo bem... Meu pai nunca te pediu opinião e você sempre deu o seu melhor."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MON_CH_RI_S_IL_TE_PLA_T_B88608"
msgid "Mon chéri s'il te plaît..."
msgstr "Querido, por favor..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_ALLER_ME_COUCHER_ET_TU_D43960"
msgid "Je vais aller me coucher et tu ferais mieux d'en faire autant."
msgstr "Eu vou deitar, e você devia fazer o mesmo."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_FERAI_TOUJOURS_TOUT_MON_POS_E61864"
msgid "Je ferai toujours tout mon possible pour t'aider, sois-en sûre."
msgstr "Eu sempre vou fazer o possível para te ajudar, pode ter certeza."

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_NON_NON_SNIFF_REVIENS_AC7EB8"
msgid "Non, non, non... Sniff. Reviens..."
msgstr "Não, não, não... *Funga*... Volta aqui..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "EST_CE_QUE_TOUT_VA_BIEN_EE9AD1"
msgid "Est-ce que tout va bien ?"
msgstr "Está tudo bem?"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "W_MON_CH_RI_JE_SUIS_D_SOL_E_P_F3AAAC"
msgid "...[w] Mon chéri, je suis désolée pour hier soir..."
msgstr "...[w] Querido, eu sinto muito por ontem à noite..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_M_EN_VEUX_TELLEMENT_TU_SAIS_E9BE52"
msgid "Je m'en veux tellement tu sais, je n'aurais jamais dû dire une telle chose."
msgstr "Eu me sinto tão mal, sabe? Nunca deveria ter dito aquilo."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_N_AVAIS_VRAIMENT_PAS_BESOIN_E48FC5"
msgid "Tu n'avais vraiment pas besoin de t'excuser."
msgstr "Não precisava se desculpar."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_PORTES_TOUTE_CETTE_FAMILLE_27EE6C"
msgid "Tu portes toute cette famille seule sur tes épaules depuis toutes ces années."
msgstr "Você carregou essa família sozinha nas costas por todos esses anos."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "LES_CHOSES_DOIVENT_CHANGER_JE_62500B"
msgid "Les choses doivent changer, je suis maintenant en âge de prendre mes responsabilités."
msgstr "As coisas precisam mudar. Já tenho idade para assumir minhas responsabilidades."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_POUR_A_J_AIMERAIS_D_J_COMME_195335"
msgid "Et pour ça j'aimerais déjà commencer par m'occuper de la dette que t'a laissée mon père."
msgstr "E por isso, quero começar cuidando da dívida que meu pai deixou para você."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_MA_RESPONSABILIT_PAS_LA_ED8BC5"
msgid "C'est ma responsabilité, pas la tienne, ça t'a été imposé."
msgstr "A responsabilidade é minha, não sua. Isso foi imposto a você."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_TE_VOIS_ENCORE_PETIT_GAR_O_A30862"
msgid "... Je te vois encore petit garçon et maintenant j'ai un homme devant moi."
msgstr "... Eu ainda te via como um garotinho, mas agora tenho um homem na minha frente."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "TR_S_BIEN_DANS_CE_CAS_JE_VAIS_677CA3"
msgid "Très bien, dans ce cas je vais devoir compter sur toi à partir de maintenant."
msgstr "Tudo bem. Então, vou ter que contar com você a partir de agora."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_VERRAS_PARTIR_DE_MAINTENANT_6B9D44"
msgid "Tu verras, à partir de maintenant ça ira bien plus vite !"
msgstr "Você vai ver, as coisas vão andar bem mais rápido agora!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "CE_PROPOS_COMBIEN_S_L_VE_LA_D_205843"
msgid "À ce propos, à combien s'élève la dette de mon père ?"
msgstr "A propósito, de quanto é a dívida do meu pai?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "ENVIRON_30M_35932B"
msgid "Environ 30,000,000¥..."
msgstr "Cerca de trinta milhões de ienes..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_JE_PENSAIS_QUE_C_TAIT_PLUS_6A424A"
msgid "Oh ?! Je pensais que c'était plus."
msgstr "Ah?! Achei que fosse mais."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_ES_S_RE_QUE_C_EST_LE_BON_MO_AFB142"
msgid "Tu es sûre que c'est le bon montant ?"
msgstr "Tem certeza de que o valor é esse mesmo?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_C_EST_LE_BON_CHIFFRE_LE_RE_F48943"
msgid "Oui c'est le bon chiffre, le reste de la dette c'est moi et mes mauvaises décisions, j'ai emprunté à des taux que je ne pouvais pas gérer."
msgstr "Sim, esse é o valor dele. O resto da dívida é por minha causa e das minhas escolhas ruins... Peguei empréstimos com juros que não consegui controlar."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "BON_TR_S_BIEN_JE_M_OCCUPE_DE_M_ABA221"
msgid "Bon très bien, je m'occupe de ma partie à présent, tu peux te concentrer sur la tienne et quand j'en aurai fini de mon côté je t'aiderai pour la tienne."
msgstr "Certo. Vou cuidar da minha parte agora. Você foca na sua e, quando eu terminar, te ajudo com o resto."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_ES_TROP_GENTIL_MON_CH_RI_JE_7613E8"
msgid "Tu es trop gentil mon chéri, je ne sais pas comment je pourrais te remercier. J'ai été tellement irresponsable..."
msgstr "Você é bom demais... nem sei como agradecer. Eu fui tão irresponsável..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "A_IRA_ON_S_EN_SORTIRA_0CADE6"
msgid "Ça ira, on s'en sortira."
msgstr "Vai ficar tudo bem. A gente vai dar um jeito."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_POUR_TOUT_3329BE"
msgid "Merci pour tout."
msgstr "Obrigada por tudo."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_ALLER_TRAVAILLER_PR_SE_A98521"
msgid "Je vais aller travailler à présent, j'ai un objectif important à présent."
msgstr "Vou trabalhar agora. Tenho um objetivo importante pela frente."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAMAN_1C3608"
msgid "Maman...?"
msgstr "Mãe...?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_MA_CH_RIE_BC9F1A"
msgid "Oui ma chérie ?"
msgstr "Sim, querida?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_PEUX_FAIRE_QUELQUE_CHOSE_PO_1A8C12"
msgid "Je peux faire quelque chose pour aider moi aussi ?"
msgstr "Eu... posso fazer alguma coisa para ajudar também?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_EFE393"
msgid "Non."
msgstr "Não."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_JE_PEUX_ECAED4"
msgid "Mais..! Je peux..."
msgstr "Mas..! Eu posso..."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_C_EST_NON_CF4181"
msgid "Non c'est non !"
msgstr "Não é não!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_MA_RESPONSABILIT_EN_TANT_3FA41F"
msgid "C'est ma responsabilité en tant que mère de devoir m'occuper de ça, je n'obligerai pas ma fille à devoir arrêter ses études pour rembourser les dettes de sa mère..."
msgstr "É minha obrigação como mãe cuidar disso. Não vou obrigar minha filha a largar os estudos para pagar as dívidas da mãe..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_JE_VOULAIS_QUAND_M_ME_AID_FFDC8C"
msgid "Mais... Je voulais quand même aider moi..."
msgstr "Mas... eu só queria ajudar..."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "BONSOIR_MA_CH_RIE_EST_CE_QUE_T_7BA592"
msgid "Bonsoir ma chérie, est-ce que tout va bien ?"
msgstr "Boa noite, querida. Está tudo bem?"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_J_AI_PR_PAR_MANGER_C78F0C"
msgid "J'ai... J'ai préparé à manger."
msgstr "Eu... eu fiz o jantar."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_C_EST_VRAI_TU_AS_VRAIMENT_87B0B4"
msgid "Quoi ?! C'est vrai ? Tu as vraiment fait ça pour nous ?"
msgstr "O quê?! É sério? Você fez isso pela gente?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_C_EST_SI_TONNANT_QUE_A_C425B6"
msgid "Quoi...? C'est si étonnant que ça ?"
msgstr "O quê...? É tão estranho assim?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "EH_BIEN_TU_N_AS_JAMAIS_CUISIN_A95498"
msgid "Eh bien... Tu n'as jamais cuisiné jusqu'à aujourd'hui."
msgstr "Bem... Você nunca cozinhou na vida."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "A_N_TAIT_JAMAIS_ARRIV_AUPARAV_34AB48"
msgid "Ça n'était jamais arrivé auparavant !"
msgstr "Isso nunca aconteceu antes!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_EH_BIEN_LES_GENS_PEUVENT_C_25E932"
msgid "Oui, eh bien les gens peuvent changer !"
msgstr "É, pois as pessoas mudam, sabia?!"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_MA_CH_RIE_JE_SUIS_SI_FI_RE_3190E2"
msgid "Oh ma chérie je suis si fière de toi, tu es adorable..."
msgstr "Oh, minha filha, estou tão orgulhosa... que amor..."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "BON_APR_S_JE_NE_SUIS_PAS_CERTA_738EC5"
msgid "Bon après je ne suis pas certaine que ça soit comestible non plus, j'ai fait ce que je pouvais."
msgstr "Tá, mas eu não garanto que esteja comestível. Fiz o que deu."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "VIENS_ICI_E5E8F8"
msgid "Viens ici !"
msgstr "Vem cá me dar um abraço!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "HEY_TU_VAS_M_TOUFFER_063125"
msgid "Hey tu vas m'étouffer !"
msgstr "Ei, vai me sufocar!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_VOIR_CE_QUE_TU_NOUS_AS_7E2772"
msgid "Je vais voir ce que tu nous as préparé de bon."
msgstr "Vou lá ver que delícia você preparou."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_D_AVOIR_FAIT_A_65853A"
msgid "Merci d'avoir fait ça..."
msgstr "Obrigado por ter feito isso..."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_PEUT_TRE_VERS_DU_LAXATIF_CDADF9"
msgid "J'ai peut-être versé du laxatif dans ta part."
msgstr "Talvez eu tenha colocado laxante na sua parte."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "VIDEMMENT_NORIKO_N_RESTERA_NO_D8975C"
msgid "Évidemment, {{noriko.n}} restera {{noriko.n}}."
msgstr "É... a {{noriko.n}} vai ser sempre a {{noriko.n}}."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7176a644"
msgid "Bonjour mon chéri, bien dormi ?"
msgstr "Bom dia, querido, dormiu bem?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "LA_DIGESTION_A_T_UN_PEU_DIFFIC_2C33E3"
msgid "La digestion a été un peu difficile mais sachant que c'était la première fois que {{noriko.n}} cuisinait ça aurait pu être pire."
msgstr "A digestão foi meio difícil, mas considerando que foi a primeira vez que a {{noriko.n}} cozinhou, podia ter sido pior."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "HAHAHA_JE_SUIS_CERTAINE_QU_ELL_C6D548"
msgid "Hahaha... Je suis certaine qu'elle va s'améliorer rapidement."
msgstr "Hahaha... Tenho certeza de que ela vai melhorar rapidinho."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "FONT_SIZE_14_LA_PROCHAINE_FOI_6FEC36"
msgid "[font_size=14]La prochaine fois tu n'auras qu'à manger des nouilles instantanées ![/font_size]"
msgstr "[font_size=14]Da próxima vez, é só comer macarrão instantâneo![/font_size]"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_CROIS_QUE_TU_L_AS_VEX_E_ECD501"
msgid "Je crois que tu l'as vexée..."
msgstr "Acho que você deixou ela chateada..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "ELLE_S_EN_REMETTRA_337D91"
msgid "Elle s'en remettra."
msgstr "Ela vai sobreviver."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_ALLER_TRAVAILLER_CE_SO_4E3F90"
msgid "Je vais aller travailler, à ce soir !"
msgstr "Vou trabalhar, até de noite!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_DOIS_PARTIR_AUSSI_DE_TOUTE_954BFA"
msgid "Je dois partir aussi de toute façon."
msgstr "Eu também preciso ir, de qualquer jeito."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "ELLE_N_EST_PAS_L_5284D9"
msgid "Elle n'est pas là."
msgstr "Ela não está."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "AH_BON_MAIS_ELLE_NE_COMMENCE_P_1C9E51"
msgid "Ah bon ? Mais elle ne commence pas aussi tôt d'habitude..."
msgstr "Ah, é? Mas ela não costuma começar tão cedo..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "QU_EST_CE_QUE_J_EN_SAIS_JE_NE_E496E6"
msgid "Qu'est-ce que j'en sais, je ne suis pas sa mère."
msgstr "E eu que sei? Não sou a mãe dela."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "POURQUOI_C_TAIT_URGENT_CED1DC"
msgid "Pourquoi, c'était urgent ?"
msgstr "Por quê? Era urgente?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "DANS_CE_CAS_JE_RETOURNE_DORMIR_DC587D"
msgid "Dans ce cas je retourne dormir !"
msgstr "Então vou voltar a dormir!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_A_PEUT_ATTENDRE_9F06A6"
msgid "Non, ça peut attendre."
msgstr "Não, pode esperar."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_DEVRAIS_POUVOIR_LA_RATTRAPE_7F0BFA"
msgid "Tu devrais pouvoir la rattraper si tu cours assez vite."
msgstr "Você ainda consegue alcançar ela se correr bastante."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_JE_DOIS_ABSOLUMENT_LUI_PA_F8F708"
msgid "Oui, je dois absolument lui parler !"
msgstr "Sim, preciso falar com ela agora mesmo!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_RENTRES_TARD_CE_SOIR_4F1FCD"
msgid "Tu rentres tard ce soir..."
msgstr "Você chegou tarde hoje..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9ef71b4d"
msgid "Tout va bien ?"
msgstr "Está tudo bem?"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_MON_CH_RI_JE_SUIS_D_SOL_E_6CEDB3"
msgid "Oui mon chéri je suis désolée... La journée a été difficile et je suis épuisée."
msgstr "Sim, querido, me desculpa... O dia foi difícil e eu estou exausta."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_D_ACCORD_JE_VAIS_TE_LAISSER_DE0507"
msgid "Oh... D'accord, je vais te laisser te reposer."
msgstr "Ah... Entendo. Vou deixar você descansar."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_PASSE_UNE_BONNE_NUIT_D51CB0"
msgid "Merci, passe une bonne nuit !"
msgstr "Obrigada, tenha uma boa noite!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_NE_DOIS_PAS_ME_PERMETTRE_DE_BA37DD"
msgid "Je ne dois pas me permettre de procrastiner, je dois faire de mon mieux aussi !"
msgstr "Não posso me dar ao luxo de ficar enrolando, eu preciso dar o meu melhor também!"

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAMAN_T_ES_S_RIEUSE_66C01A"
msgid "Maman !! T'es sérieuse ?"
msgstr "Mãe!! Você está falando sério?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "POURQUOI_TU_N_EN_AS_PAS_DISCUT_FA647F"
msgid "Pourquoi tu n'en as pas discuté avec nous avant ?!"
msgstr "Por que não conversou com a gente antes?!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MA_CH_RIE_JE_SAIS_QUE_J_AURAIS_78A159"
msgid "Ma chérie je sais que j'aurais dû t'en parler avant mais ça n'aurait rien changé à la situation..."
msgstr "Minha filha, eu sei que deveria ter falado com você, mas não mudaria nada a situação..."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/home_player_livingroom.dialogue
msgctxt "BAISSE_UN_PEU_D_UN_TON_LA_SITU_74677E"
msgid "Baisse un peu d'un ton, la situation de ta mère était tellement critique que si elle n'avait pas agi, vous auriez tout perdu d'ici quelques années..."
msgstr "Abaixa o tom. A situação da sua mãe era tão crítica que, se ela não tivesse agido, vocês teriam perdido tudo em poucos anos..."

#. Character:`netoru`
#: game/story/home_player_livingroom.dialogue
msgctxt "TRE_ADULTE_C_EST_ACCEPTER_DES_0D8DD9"
msgid "Être adulte, c'est accepter des décisions que les enfants ne comprennent pas."
msgstr "Ser adulto é aceitar decisões que as crianças não entendem."

#. Character:`netoru`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_GR_CE_A_TU_POURRAS_CONTINUE_B4891D"
msgid "Et grâce à ça, tu pourras continuer tes études et faire ce que tu veux, c'était le seul souhait de ta mère !"
msgstr "E graças a isso, você poderá continuar seus estudos e fazer o que quiser. Esse era o único desejo da sua mãe!"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_JE_NE_VEUX_PAS_DE_CES_TUD_E69B56"
msgid "Mais je ne veux pas de ces études !!!"
msgstr "Mas eu não quero saber desses estudos!!!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_NE_T_AI_JAMAIS_DEMAND_DE_TE_6C39BB"
msgid "Je ne t'ai jamais demandé de te sacrifier pour moi !"
msgstr "Eu nunca te pedi para se sacrificar por mim!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_TE_D_TESTE_6FB7C6"
msgid "Je te déteste !"
msgstr "Eu te odeio!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "NORIKO_N_B21464"
msgid "{{noriko.n}}..."
msgstr "{{noriko.n}}..."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "NE_VOUS_EN_FAITES_PAS_ELLE_COM_C2EFD4"
msgid "Ne vous en faites pas, elle comprendra avec le temps que c'était la meilleure décision à prendre."
msgstr "Não se preocupe, com o tempo ela vai entender que essa foi a melhor decisão."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_L_ESP_RE_000029"
msgid "Je l'espère..."
msgstr "Espero que sim..."

#. Character:`netoru`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_ESSAYER_DE_LA_RAISONNE_B0461A"
msgid "Je vais essayer de la raisonner ma chère."
msgstr "Vou tentar fazer ela ouvir a razão, querida."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_AS_VRAIMENT_4DA568"
msgid "Tu as vraiment..."
msgstr "Você realmente..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "TOI_AUSSI_TU_VAS_ME_D_TESTER_741850"
msgid "Toi aussi tu vas me détester ?"
msgstr "Você também vai me odiar?"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_J_AIMERAIS_JUSTE_COMPRENDR_634248"
msgid "Non... J'aimerais juste comprendre..."
msgstr "Não... Eu só queria entender..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "LA_SITUATION_TAIT_BIEN_TROP_D_C3161D"
msgid "La situation était bien trop désespérée et l'échéance bien trop courte pour nous sortir de cette situation."
msgstr "A situação era desesperadora demais e o prazo curto demais para nos tirar desse buraco."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_M_A_FAIT_UNE_PROPOSITION_4A2E42"
msgid "Il m'a fait une proposition..."
msgstr "Ele me fez uma proposta..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_J_AI_ACCEPT_823879"
msgid "Et j'ai accepté."
msgstr "E eu aceitei."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_TAIT_UNE_BONNE_OPPORTUNIT_PO_2C69FB"
msgid "C'était une bonne opportunité pour moi."
msgstr "Foi uma boa oportunidade para mim."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_EN_AVAIS_ENVIE_DEPUIS_LONGTE_3CD4F9"
msgid "J'en avais envie depuis longtemps."
msgstr "Eu queria isso há muito tempo."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "S_IL_TE_PLA_T_NE_ME_D_TESTE_PA_E2B4D1"
msgid "S'il te plaît... ne me déteste pas."
msgstr "Por favor... não me odeie."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_JE_COMPRENDS_F4E3E8"
msgid "Non... je comprends."
msgstr "Não... eu entendo."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_J_ESP_RE_QUE_TU_SAIS_CE_Q_2FA452"
msgid "Mais j'espère que tu sais ce que tu fais."
msgstr "Mas espero que você saiba o que está fazendo."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_N_AS_PAS_T_INQUI_TER_POUR_M_FF81ED"
msgid "Tu n'as pas à t'inquiéter pour moi."
msgstr "Você não precisa se preocupar comigo."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SERAI_HEUREUSE_5CC986"
msgid "Je serai heureuse."
msgstr "Eu serei feliz."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_JE_DOIS_ALLER_TRAVAILLER_3E79B1"
msgid "Je... je dois aller travailler."
msgstr "Eu... eu preciso ir trabalhar."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_COMPRENDS_BONNE_JOURN_E_E98B0C"
msgid "Je comprends, bonne journée !"
msgstr "Eu entendo, tenha um bom dia!"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "WOAH_A_VOUS_VA_SUPER_BIEN_18AFB7"
msgid "Woah ça vous va super bien !"
msgstr "Uou, ficou muito bem em você!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_C_EST_MA_NOUVELLE_TENUE_890A7E"
msgid "Merci, c'est ma nouvelle tenue de travail officielle."
msgstr "Obrigada, é o meu novo uniforme oficial de trabalho."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_AS_QUITT_TON_ANCIEN_TRAVAIL_C5D638"
msgid "Tu as quitté ton ancien travail ?"
msgstr "Você saiu do seu antigo emprego?"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_VOUS_LAISSER_DISCUTER_776738"
msgid "Je vais vous laisser discuter entre vous, je t'attends dans ta chambre..."
msgstr "Vou deixar vocês conversarem. Te espero lá no seu quarto..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_C_EST_GR_CE_TOI_D_UNE_CERT_7F3FB5"
msgid "Oui... C'est grâce à toi d'une certaine manière."
msgstr "Sim... De certa forma, é graças a você."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_N_AI_PAS_SOUVENIR_D_AVOIR_F_79E12D"
msgid "Je n'ai pas souvenir d'avoir fait grand-chose pourtant."
msgstr "Mas eu não lembro de ter feito grande coisa."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_POURTANT_JE_T_ASSURE_QUE_A_220365"
msgid "Et pourtant je t'assure que ça a fait une différence."
msgstr "E no entanto, eu te garanto que fez toda a diferença."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "MON_SALAIRE_N_A_PLUS_RIEN_VOIR_3DACA1"
msgid "Mon salaire n'a plus rien à voir avec ce qu'il était auparavant, c'est là que je me dis que j'ai été bien stupide de rester aussi longtemps travailler pour cette ordure."
msgstr "Meu salário não tem nada a ver com o que era antes. É aí que eu vejo como fui boba de ficar tanto tempo trabalhando para aquele lixo."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_CONTENT_QUE_LES_CHOSES_861D75"
msgid "Je suis content que les choses s'arrangent de ton côté, tu vas pouvoir respirer un peu plus."
msgstr "Fico feliz que as coisas estejam se acertando para você, vai dar para respirar um pouco mais."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_IL_VA_FALLOIR_F_TER_A_F1CFC2"
msgid "Oui, il va falloir fêter ça !"
msgstr "Sim, vamos ter que comemorar!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "AU_FAIT_O_SE_SITUE_TON_NOUVEAU_3C73CE"
msgid "Au fait... Où se situe ton nouveau travail ?"
msgstr "A propósito... onde fica esse seu novo trabalho?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "AU_ONSEN_EN_BORDURE_DE_LA_VILL_EFE964"
msgid "Au onsen, en bordure de la ville, c'est un endroit vraiment magnifique."
msgstr "Na Casa de Banho, na saída da cidade. É um lugar realmente maravilhoso."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "FONT_SIZE_14_SAITO_N_QU_EST_C_D41583"
msgid "[font_size=14]{{saito.n}} Qu'est-ce que tu fais ?!![/font_size]"
msgstr "[font_size=14]{{saito.n}}, o que você está fazendo?!![/font_size]"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "D_SOL_62A799"
msgid "Désolé..."
msgstr "Desculpa..."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "CE_N_EST_PAS_GRAVE_NE_LA_FAIS_61BD8A"
msgid "Ce n'est pas grave, ne la fais pas attendre !"
msgstr "Não tem problema, não deixa ela esperando!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "BONNE_SOIR_E_VOUS_DEUX_253F62"
msgid "Bonne soirée à vous deux !"
msgstr "Boa noite para vocês dois!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_85fe00c0"
msgid "Elle doit probablement être dans sa chambre..."
msgstr "Ela deve estar no quarto dela..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2e0008bd"
msgid "Je te sers un thé ou autre chose ?"
msgstr "Quer um chá ou alguma outra coisa?"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3d344136"
msgid "Non merci, ça ira..."
msgstr "Não, obrigada, estou bem..."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4efc3390"
msgid "Donc... Tu es donc la dernière personne à avoir parlé à {{saito.n}} hier soir..."
msgstr "Então... você foi a última pessoa que falou com o {{saito.n}} ontem à noite..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_de909dee"
msgid "Il y a quelque chose qui sortait de l'ordinaire ?"
msgstr "Teve alguma coisa fora do comum?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6c24c501"
msgid "Était-il comme d'habitude ?"
msgstr "Ele estava agindo como sempre?"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_49ed57e4"
msgid "... À vrai dire...[w] Je crois qu'il avait l'intention de mettre fin à notre relation."
msgstr "... Para falar a verdade...[w] Acho que ele pretendia terminar comigo."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_39503e19"
msgid "... À vrai dire...[w] Je crois qu'il avait l'intention de mettre fin à notre amitié."
msgstr "... Para falar a verdade...[w] Acho que ele pretendia cortar laços comigo."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_59bd2637"
msgid "Mais... Je me suis fâchée et je l'ai chassé de la maison avant qu'il ne puisse s'expliquer."
msgstr "Mas... eu fiquei brava e expulsei ele de casa antes que pudesse se explicar."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_JE_SUIS_CERTAINE_QUE_TU_NE_3D83B3"
msgid "Oh... Je suis certaine que tu ne le pensais pas."
msgstr "Ah... Tenho certeza de que você não falou por mal."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_TAIS_VRAIMENT_FACH_E_TOUT_SE_DF5D72"
msgid "J'étais vraiment fâchée... tout se passait bien et tout a changé soudainement !"
msgstr "Eu estava com muita raiva... estava tudo indo tão bem e de repente tudo mudou!"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_NE_COMPREND_VRAIMENT_PAS_CE_EDDDF9"
msgid "Je ne comprends vraiment pas ce qui lui est passé par la tête."
msgstr "Eu realmente não entendo o que deu na cabeça dele."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_365c29ac"
msgid "[font_size=14]Donc toi aussi...[/font_size]"
msgstr "[font_size=14]Então com você também...[/font_size]"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_18318dad"
msgid "Vous avez dit quelque chose ?"
msgstr "Você disse alguma coisa?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_83ce23e6"
msgid "Non non, je marmonnais, n'y fais pas attention."
msgstr "Não, não, estava só falando sozinha, não dê importância."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_faafc679"
msgid "Avant de partir de la maison hier soir... Il semblait préoccupé."
msgstr "Antes de sair de casa ontem à noite... ele parecia preocupado."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fb0b492c"
msgid "D'où ma suggestion qu'il avait probablement des ennuis."
msgstr "Por isso eu sugeri que ele provavelmente estava com problemas."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_906c03bb"
msgid "Je... Je ne sais pas trop quoi en penser."
msgstr "Eu... não sei bem o que pensar."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_22f0d850"
msgid "Ça ne fait qu'une journée."
msgstr "Só faz um dia."

#. Character:`asami` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c45226e2"
msgid "Peut-être est-il avec quelqu'un d'autre ?"
msgstr "Será que ele está com outra pessoa?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3d5f8dae"
msgid "Et la fille en kimono ?"
msgstr "E a garota de quimono?"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_de3d0ba3"
msgid "Comment ça la fille en kimono ? Elle est venue chez vous aussi ?"
msgstr "Como assim garota de quimono? Ela veio aqui também?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "SAKUYA_N_MAIS_POURQUOI_EN_AUR_CFCEE3"
msgid "{{sakuya.n}} ? Mais pourquoi en aurait-elle après {{saito.n}}, ils travaillent ensemble tous les deux..."
msgstr "A {{sakuya.n}}? Mas por que ela estaria atrás do {{saito.n}}? Os dois trabalham juntos..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "CA_N_A_PAS_DE_SENS_8075B2"
msgid "Ça n'a pas de sens."
msgstr "Isso não faz sentido."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_707592dd"
msgid "Oh, mais oui, je l'avais oubliée, elle traînait souvent autour de la maison."
msgstr "Oh, é verdade, eu tinha esquecido dela, ela vivia rondando a casa."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7b95dc3b"
msgid "Vous pensez qu'elle a un lien dans la disparition de {{saito.n}} ?"
msgstr "Você acha que ela tem algo a ver com o sumiço do {{saito.n}}?"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9ccb3876"
msgid "Il serait parti pour une autre femme ?"
msgstr "Ele teria ido embora por causa de outra mulher?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_aeb5c3a9"
msgid "... Je ne sais pas, je pense que le mieux serait de discuter avec cette fille."
msgstr "... Não sei, acho que o melhor seria conversar com essa garota."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7231df1d"
msgid "..."
msgstr "..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a43a6be3"
msgid "{{asami.n}}, je suis certaine que {{saito.n}} t'aime de tout son cœur, et jamais il n'aurait agi ainsi sans avoir de raison valable."
msgstr "{{asami.n}}, tenho certeza de que o {{saito.n}} te ama de todo o coração, e ele nunca faria isso sem um motivo muito forte."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dac1642b"
msgid "{{asami.n}}, je suis certaine que {{saito.n}} ne pensait pas du tout ce qu'il t'a dit... Il l'a sûrement fait pour une bonne raison."
msgstr "{{asami.n}}, tenho certeza de que o {{saito.n}} não quis dizer aquilo... ele deve ter feito isso por uma boa razão."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_45c268fd"
msgid "Vous croyez ?"
msgstr "Você acha?"

#. Character:`yasuka` | Attributes:`happy,blush`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b7c124b3"
msgid "J'en suis certaine !"
msgstr "Tenho certeza!"

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "TR_S_BIEN_IL_NE_RESTE_QU_ALLER_7F5507"
msgid "Très bien, il ne reste qu'à aller voir cette sal-... cette fille !"
msgstr ""

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5e84599c"
msgid "Je l'accompagnerai !"
msgstr "Eu vou junto!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d4a1cdae"
msgid "Tu es sûre ma chérie ?"
msgstr "Tem certeza, querida?"

#. Character:`noriko` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c41c3e98"
msgid "Certaine !"
msgstr "Absoluta!"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0a9b12e1"
msgid "Ne perdons pas de temps."
msgstr "Não vamos perder tempo."

#. Character:`asami` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_921f8009"
msgid "Quoi, maintenant ? Là tout de suite ?"
msgstr "O quê, agora? Tipo, agora mesmo?"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_675c152d"
msgid "Tu préfères attendre ?"
msgstr "Prefere esperar?"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b8938434"
msgid "Non, tu as raison."
msgstr "Não, você tem razão."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b482dfc3"
msgid "Tenez-moi au courant... Je suis vraiment inquiète..."
msgstr "Me mantenham informada... estou muito preocupada..."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6b74626c"
msgid "C'est promis !"
msgstr "Pode deixar!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "BONSOIR_MON_CH_RI_TOUT_VA_BIEN_CB7E6A"
msgid "Bonsoir mon chéri, tout va bien ?"
msgstr "Boa noite, querido, está tudo bem?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_ON_NE_PEUT_MIEUX_796137"
msgid "Oui, on ne peut mieux."
msgstr "Sim, melhor impossível."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_R_GL_CERTAINS_PROBL_MES_E_6C6A79"
msgid "J'ai réglé certains problèmes et je me sens tout à coup bien plus léger."
msgstr "Resolvi alguns problemas e me sinto bem mais leve de repente."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_CONTENTE_POUR_TOI_DB0600"
msgid "Je suis contente pour toi..."
msgstr "Fico feliz por você..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "AU_FAIT_JE_SAIS_QUE_NORIKO_N_S_03A1DB"
msgid "Au fait... Je sais que {{noriko.n}} à souvent parlé de ton histoirque web par le passé et..."
msgstr "A propósito... Eu sei que a {{noriko.n}} andou falando do seu histórico de navegação e..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_NON_ENCORE_62F0BB"
msgid "Oh non encore ?"
msgstr "Ah não, de novo?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "NE_T_INQUI_TE_PAS_EN_FAIT_J_AI_F005D1"
msgid "Ne t'inquiète pas, en fait... J'aimerais essayer avec toi ce soir..."
msgstr "Não se preocupe, na verdade... Eu gostaria de tentar com você esta noite..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ESSAYER_C_EST_DIRE_TU_VEUX_DIR_66ADE3"
msgid "Essayer c'est dire... tu veux dire..."
msgstr "Tentar... como assim? Você quer dizer..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_JE_SUIS_CURIEUSE_ET_J_AI_E_6826D2"
msgid "Oui, je suis curieuse et j'ai envie de le faire avec toi."
msgstr "Sim, estou curiosa e quero fazer isso com você."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_PARLES_BIEN_DE_CE_QUE_JE_SU_993902"
msgid "Tu parles bien de ce que je suis en train de penser ?"
msgstr "Você está falando do que eu estou pensando?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_MON_CH_RI_JE_PARLE_BIEN_DE_75AF9E"
msgid "Oui mon chéri, je parle bien de \"ça\"."
msgstr "Sim, querido, estou falando \"disso\" mesmo."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_PASSERAI_ME_GLISSER_DANS_TO_FBA5B9"
msgid "Je passerai me glisser dans ton lit cette nuit quand {{noriko.n}} dormira profondément."
msgstr "Vou de fininho para a sua cama esta noite, quando a {{noriko.n}} estiver dormindo profundamente."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_J_AI_D_J_HATE_D_Y_TRE_7B9057"
msgid "J'ai... j'ai déjà hate d'y être !"
msgstr "Eu... mal posso esperar por isso!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "NORIKO_N_NORIKO_N_6460BC"
msgid "{{noriko.n}} ! {{noriko.n}} !!"
msgstr "{{noriko.n}} ! {{noriko.n}} !!"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "CALME_TOI_JE_SUIS_CERTAINE_QU_D3B5DE"
msgid "Calme-toi, je suis certaine qu'elle va bien, elle doit être dans sa chambre."
msgstr "Calma, tenho certeza de que ela está bem, deve estar no quarto dela."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_M_EN_ASSURER_AFAFBC"
msgid "Je vais m'en assurer !"
msgstr "Vou lá conferir!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "ELLE_N_EST_PAS_L_8F70D0"
msgid "Elle n'est pas là ?"
msgstr "Ela não está aqui?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ASAMI_N_ED5AC0"
msgid "{{asami.n}} ?"
msgstr "{{asami.n}}?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_NON_NON_W_MERDE_13DEF7"
msgid "Non, non, non...[w] Merde !"
msgstr "Não, não, não...[w] Merda!"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "t3e699fa5c9"
msgid "Je ne ferais pas ça à ta place !"
msgstr "Eu não faria isso se fosse você!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c320b570"
msgid "... et toi, ta journée s'est bien passée ?"
msgstr ".. e o seu dia, foi bom?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_088567f7"
msgid "Oui c'était génial, j'ai passé la journée avec {{asami.n}}."
msgstr "Sim, foi ótimo, passei o dia com a {{asami.n}}."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bf463289"
msgid "Je suis contente pour toi ma chérie, cette fille est adorable."
msgstr "Fico feliz por você, querida, aquela garota é uma fofa."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_759bad8b"
msgid "Je suis sûre qu'elle aura une bonne influence sur toi."
msgstr "Tenho certeza de que ela vai ser uma boa influência para você."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_89040705"
msgid "Tu dis ça comme si j'étais une délinquante..."
msgstr "Falando assim até parece que eu sou uma delinquente..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4cce02f4"
msgid "Avoue que tu n'as pas toujours été facile, je me trompe ?"
msgstr "Admita que você nem sempre foi fácil, vai dizer que estou errada?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_eedf9fba"
msgid "... Je vais dans ma chambre !"
msgstr "... Vou para o meu quarto!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_02628536"
msgid "Ahlala..."
msgstr "Ai, ai..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_649ac2b9"
msgid "Ça va merci... Est-ce que {{noriko.n}} est levée ?"
msgstr "Tudo certo, obrigado... A {{noriko.n}} já levantou?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b8099094"
msgid "Pour une fois elle était levée avant toi."
msgstr "Por incrível que pareça, ela acordou antes de você."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6e116a1d"
msgid "Elle a pris son argent de poche et est partie tôt ce matin."
msgstr "Pegou o dinheiro dela e saiu cedo hoje."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5856191c"
msgid "Elle est déjà partie ?"
msgstr "Ela já saiu?"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6f2f17e4"
msgid "Oui pourquoi, est-ce qu'il y a un problème ?"
msgstr "Sim, por quê? Algum problema?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_27601264"
msgid "Non non, j'essaierai de la rattraper. Tu sais où elle allait ?"
msgstr "Não, não, vou tentar encontrar com ela. Sabe para onde ela foi?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8837d170"
msgid "Elle a dit qu'elle rejoignait {{asami.n}} en ville pour une journée shopping avec elle."
msgstr "Ela disse que ia encontrar a {{asami.n}} na cidade para um dia de compras."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_50213d89"
msgid "Bordel, la voilà qui recommence ses magouilles."
msgstr "Droga, lá vem ela de novo com essas maracutaias."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_59fbc03a"
msgid "Qu'est-ce qu'elle est en train de préparer ?"
msgstr "O que será que ela está aprontando agora?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_65cb155f"
msgid "Bonjour mon chéri !"
msgstr "Bom dia, querido!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7345d539"
msgid "Tout se passe bien avec {{noriko.n}} ?"
msgstr "Está tudo bem entre você e a {{noriko.n}}?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f99847aa"
msgid "J'y travaille et je pense que nous verrons bientôt {{noriko.n}} sourire de nouveau."
msgstr "Estou cuidando disso. Acho que logo vamos ver a {{noriko.n}} sorrindo de novo."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e2f6123a"
msgid "Je savais bien que je pouvais compter sur toi."
msgstr "Eu sabia que podia contar com você."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dba3bf28"
msgid "Mais fais attention à toi, ne crois pas pas que je ne vois pas tous ces bleus sur ton corps."
msgstr "Mas se cuida... não pense que eu não vi esses hematomas no seu corpo."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7a23d7d2"
msgid "Juste... sois prudent !"
msgstr "Só... por favor, seja prudente!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_35f30c10"
msgid "Je le serai !"
msgstr "Eu vou ser!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3f9b63ba"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2bb6599a"
msgid "Mon chéri... {{noriko.n}} a quitté la maison."
msgstr "Querido... a {{noriko.n}} saiu de casa."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0ecaa08f"
msgid "On s'est disputées et elle est partie en claquant la porte."
msgstr "Nós discutimos e ela saiu batendo a porta."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2cdfeb91"
msgid "Partie ?! Depuis combien de temps ?"
msgstr "Saiu?! Faz quanto tempo?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7ccc98fa"
msgid "Il y a plusieurs dizaines de minutes, je n'ai pas pu la retenir."
msgstr "Já faz um bom tempo, eu não consegui segurá-la."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_18169932"
msgid "Elle était dans ta chambre avec... ce garçon, il avait les cheveux longs."
msgstr "Ela estava no seu quarto com... aquele rapaz, o de cabelos compridos."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f985c24e"
msgid "Je m'en veux tellement si tu savais... mais il avait l'air si..."
msgstr "Eu me sinto tão culpada, se você soubesse... mas ele parecia tão..."

#. Character:`saito` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_63a00d52"
msgid "{{akira.n}} ! Non tu as bien réagi, ce type est un psychopathe."
msgstr "O {{akira.n}}! Não, você fez o certo, esse cara é um psicopata."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bc15dea5"
msgid "Je vais la retrouver, il ne lui arrivera rien."
msgstr "Vou atrás dela, não vai acontecer nada com ela."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_69d82c4d"
msgid "Tu as une idée de l'endroit où elle pourrait être allée ?"
msgstr "Você tem ideia de para onde eles podem ter ido?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_74b78344"
msgid "Je crois qu'il a parlé d'un hôtel en centre-ville..."
msgstr "Acho que ele falou de um hotel no centro..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5185bb71"
msgid "C'est probablement le love hotel !"
msgstr "É o love hotel, com certeza!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5f0d4639"
msgid "Je t'en prie, empêche {{noriko.n}} de faire quelque chose qu'elle pourrait regretter !"
msgstr "Por favor, impeça a {{noriko.n}} de fazer algo de que possa se arrepender!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_106ea3e2"
msgid "Et fais attention à toi surtout, je ne supporterais pas s'il t'arrivait quelque chose à toi aussi."
msgstr "E tome cuidado, eu não suportaria se acontecesse algo com você também."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5b475c98"
msgid "Tout ira bien, je ne suis plus le même qu'avant."
msgstr "Vai ficar tudo bem, eu não sou mais o mesmo de antes."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_15500ec7"
msgid "{{noriko.n}} ma chérie, je suis tellement désolée..."
msgstr "{{noriko.n}}, minha filha, eu sinto tanto..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4cafc087"
msgid "Je suis si heureuse que tu ailles bien."
msgstr "Estou tão feliz que você esteja bem."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dc66d931"
msgid "Mais... vous rentrez ensemble ?!"
msgstr "Mas... vocês estão voltando juntos?!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ba7acfca"
msgid "Oui maman ne t'inquiète plus, {{saito.n}} et moi avons enfin fait la paix."
msgstr "Sim, mãe, não se preocupa mais. O {{saito.n}} e eu finalmente fizemos as pazes."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b4839780"
msgid "Je suis désolée d'avoir été aussi odieuse pendant toutes ces années."
msgstr "Me desculpa por ter sido tão detestável todos esses anos."

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_60eab4e4"
msgid "Mais... à partir d'aujourd'hui c'est terminé, tu vas retrouver la {{noriko.n}} qui souriait comme avant."
msgstr "Isso acabou. A partir de hoje, você vai ter de volta aquela {{noriko.n}} que sorria como antes."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ac77c436"
msgid "Mon dieu mes chéris... Je suis tellement heureuse !"
msgstr "Meu Deus, meus amores... Eu estou tão feliz!"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5187485a"
msgid "Je me moque de savoir comment tout ça s'est produit... Ce qui m'intéresse maintenant c'est de savoir qu'on va pouvoir se serrer les coudes comme une vraie famille !"
msgstr "Não me interessa como isso aconteceu... O que importa agora é saber que vamos nos apoiar como uma família de verdade!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ea13cfe7"
msgid "Il faut fêter ça !"
msgstr "Temos que comemorar!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bb6dbf5d"
msgid "Quoi ?! Là ? Maintenant ? Tout de suite ?"
msgstr "O quê?! Agora? Tipo, agora mesmo?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f987f274"
msgid "Ne sois pas rabat-joie, chaque bonne nouvelle devrait pouvoir être fêtée !"
msgstr "Não seja estraga-prazeres, toda notícia boa deve ser comemorada!"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_47c426f7"
msgid "Exactement {{saito.n}} ne sois pas rabat-joie !"
msgstr "Exatamente, {{saito.n}}, não seja estraga-prazeres!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_98b97b5c"
msgid "C'est bon j'ai compris..."
msgstr "Tá bom, já entendi..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cd1e30cc"
msgid "Je vais chercher quelque chose au konbini ?"
msgstr "Querem que eu busque algo na loja de conveniência?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_25eec42f"
msgid "Non surtout pas, j'y vais ! Vous avez probablement plein de choses à vous dire et à rattraper."
msgstr "Nada disso, eu vou! Vocês devem ter muito o que conversar e colocar em dia."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d12e7a0b"
msgid "Attendez-moi à la maison, je ne devrais pas en avoir pour plus d'une heure !"
msgstr "Me esperem em casa, não devo demorar mais que uma hora!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_29cd7803_2"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_03775ec8_3"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1121ed67"
msgid "C'est étrange de se retrouver ainsi devant la télé, comme si rien ne s'était jamais produit."
msgstr "É estranho ficar assim na frente da TV, como se nada tivesse acontecido."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_41628bc6"
msgid "C'est probablement la première fois depuis des années que {{yasuka.n}} a été aussi heureuse."
msgstr "Provavelmente é a primeira vez em anos que a {{yasuka.n}} fica tão feliz assim."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_20d79a6b"
msgid "À ce propos...[w] Tu as vraiment couché avec elle ?"
msgstr "Falando nisso...[w] você transou mesmo com ela?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t7f573ad0d6"
msgid "Ca fait combien de temps que tu couchais avec elle ?"
msgstr "Faz quanto tempo que você está transando com ela?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d6516fa2"
msgid "Euh..."
msgstr "Er..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_de0fb819"
msgid "Je ne suis pas idiote...[w] Tu crois que je ne vous ai pas entendus la nuit dans ta chambre ?"
msgstr "Não sou idiota...[w] você acha que eu não ouvi vocês à noite no seu quarto?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1382305a"
msgid "Si tu le savais, pourquoi me le demander ?"
msgstr "Se você já sabia, por que perguntou?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_88e97b98"
msgid "... Je voulais l'entendre de ta bouche."
msgstr "... Eu queria ouvir da sua boca."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6f2a9f74"
msgid "... Oui, c'est arrivé plusieurs fois."
msgstr "... Sim, aconteceu algumas vezes."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t6dfe63f33a"
msgid "Pauvre {{asami.n}}..."
msgstr "Coitada da {{asami.n}}..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t79344e5734"
msgid "Pourquoi tu dis ça ?"
msgstr "Por que está dizendo isso?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t9111b5deb3"
msgid "...[w]Pour rien, t'es un cas désespéré."
msgstr "...[w] Por nada. Você é um caso perdido."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1fe8d940"
msgid "Et {{asami.n}} est au courant ?"
msgstr "E a {{asami.n}} está sabendo?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_766c09de"
msgid "... Oui, aussi."
msgstr "... Sim, também."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_83ddc671"
msgid "Sérieux ?! Et elle laisse faire ?"
msgstr "Sério?! E ela deixa?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d04df73b"
msgid "Aussi incroyable que ça puisse paraître, oui."
msgstr "Por incrível que pareça, sim."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e44de8d1"
msgid "Et je pense qu'en écoutant {{yasuka.n}} lui expliquer la raison pour laquelle on en est arrivés là..."
msgstr "E acho que, depois de ouvir a {{yasuka.n}} explicar por que chegamos a esse ponto..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d6dcdb2c"
msgid "Elle s'est probablement mise à sa place."
msgstr "Ela provavelmente se colocou no lugar dela."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "CA_FAIT_DU_BIEN_DE_LA_VOIR_SE_B9403C"
msgid "Ca fait du bien de la voir se réjouir comme ça."
msgstr "Faz bem ver ela animada desse jeito."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4141febb"
msgid "Et l'autre folle ?"
msgstr "E a outra maluca?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9ed39083"
msgid "{{sakuya.n}} ? Elle n'est pas folle..."
msgstr "A {{sakuya.n}}? Ela não é maluca..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_81db9706"
msgid "Elle est juste... très passionnée."
msgstr "Só é... muito intensa."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_79c16a7e"
msgid "Si tu le dis..."
msgstr "Se você está dizendo..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d4119381"
msgid "Et moi ?"
msgstr "E eu?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8cace5a2"
msgid "Comment ça, toi ?"
msgstr "Como assim, você?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_562b59b4"
msgid "C'était comment de... coucher avec moi ?"
msgstr "Como foi... transar comigo?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f1868cc7"
msgid "Est-ce vraiment une conversation que tu veux avoir ?"
msgstr "Você quer mesmo ter essa conversa?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3a9562a6"
msgid "Je veux savoir. Tu couches avec toutes les femmes autour de toi !"
msgstr "Eu quero saber. Você come todas as mulheres à sua volta!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_027edc6f"
msgid "Ne me dis pas que tu couches aussi avec la mère d'{{asami.n}} ?"
msgstr "Não vai me dizer que está comendo a mãe da {{asami.n}} também?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2e0b7461"
msgid "Quoi ?! Non, bien sûr que non !"
msgstr "O quê?! Não, claro que não!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0fb7578a"
msgid "C'est elle la prochaine, c'est ça ?"
msgstr "Ela é a próxima da lista, é isso?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a30a6352"
msgid "T'es folle..."
msgstr "Você é louca..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ead573fb"
msgid "Laisse tomber. De toute façon, c'était une erreur."
msgstr "Esquece. De qualquer forma, foi um erro."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6a35066c"
msgid "Oh, que oui !"
msgstr "Ah, com certeza foi!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_65d0f4dd"
msgid "Toi et moi, ça ne se reproduira plus."
msgstr "Eu e você... não vai mais acontecer."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_336e9fd5"
msgid "Entièrement d'accord."
msgstr "Plenamente de acordo."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_89529c4b"
msgid "En plus, ce n'était pas si agréable que ça."
msgstr "Além do mais, nem foi lá essas coisas."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c63d9825"
msgid "Pff, tu crois que tu t'es mieux débrouillé ?"
msgstr "Pff, e você acha que mandou bem?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_525a2e1e"
msgid "...[w] Oui."
msgstr "...[w] Sim."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9cbd998e"
msgid "Ah, tu veux jouer à ça !"
msgstr "Ah, então você quer jogar assim!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_34664b90"
msgid "À poil et plus vite que ça !"
msgstr "Pelado, agora! E rápido!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a6dc6e8a"
msgid "Hein !?"
msgstr "Hein!?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_14b8c502"
msgid "Wow doucement..."
msgstr "Opa, calma aí..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b6558012"
msgid "Mmhhh laisse-moi faire... mhhhhh mhhh"
msgstr "Mmhhh deixa comigo... mhhhhh mhhh"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_616c661b"
msgid "{{yasuka.n}} pourrait rentrer à tout moment !"
msgstr "A {{yasuka.n}} pode chegar a qualquer momento!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a6d5d579"
msgid "... m'en fiche !"
msgstr "... não tô nem aí!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_11b72ba3"
msgid "Je... ça fait longtemps... peut-être qu'il faudrait que..."
msgstr "Eu... faz tempo... talvez fosse melhor a gente..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3e50ca57"
msgid "Qu'on arrête ?"
msgstr "Parar?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1ca04ffe"
msgid "Mais j'ai pas envie !"
msgstr "Mas eu não quero!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b883ebf2"
msgid "Ça tombe bien moi non plus."
msgstr "Que bom, porque eu também não."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f2773e9a"
msgid "Aaaah... aaaah"
msgstr "Aaaah... aaaah"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b3b34de5"
msgid "Ne t'arrête pas !"
msgstr "Não para!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5609c0c6"
msgid "Mmmmmh ouiiii !"
msgstr "Mmmmmh issoooo!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f946afbe"
msgid "Oh mon dieu c'est trop bon !"
msgstr "Meu Deus, é muito bom!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_51d1b869"
msgid "Dis... Tu crois qu'on pourrait... essayer... ça ?"
msgstr "Ei... você acha que a gente podia... tentar... aquilo?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c9a4bcd3"
msgid "Tu veux dire..."
msgstr "Você quer dizer..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5ead300c"
msgid "{{asami.n}} m'a dit que c'était pas si mal au final..."
msgstr "A {{asami.n}} me disse que não era tão ruim, afinal..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t9b2146bda9"
msgid "Ne m'oblige pas à le dire... Tu sais très bien de quoi je veux parler."
msgstr "Não me obriga a falar... você sabe muito bem do que eu estou falando."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f01df574"
msgid "Okay !"
msgstr "Tá bom!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2b66c7c0"
msgid "Oh la vache c'est..."
msgstr "Nossa, isso é..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_216311fa"
msgid "C'est..."
msgstr "É..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ffa56726"
msgid "Surprenant..."
msgstr "Surpreendente..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c05cd9f7"
msgid "Tu as l'air vraiment inquiète."
msgstr "Você parece bem preocupada."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2af0ec69"
msgid "Mon chéri..."
msgstr "Querido..."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f7e4d9b1"
msgid "[font_size=14]NON MAIS CA VA PAS LA TÊTE ?![/font_size]"
msgstr "[font_size=14]VOCÊ FICOU MALUCA OU O QUÊ?![/font_size]"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ef2765d9"
msgid "[font_size=14]COMMENT TU PEUX METTRE QUELQU'UN EN DANGER COMME CA ?[/font_size]"
msgstr "[font_size=14]COMO PODE COLOCAR ALGUÉM EM PERIGO ASSIM?[/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dfd1856d"
msgid "...Me dis pas qu'elles..."
msgstr "...Não me diga que elas..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e9da8b43"
msgid "Si... Elle se disputent depuis qu'elles sont arrivées."
msgstr "Sim... Elas estão discutindo desde que chegaram."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d1de9ee2"
msgid "[font_size=14]JE SAIS CE QUE JE FAIS ![/font_size]"
msgstr "[font_size=14]EU SEI O QUE ESTOU FAZENDO![/font_size]"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_90deb909"
msgid "[font_size=14]IL A BESOIN DE CA ![/font_size]"
msgstr "[font_size=14]ELE PRECISA DISSO![/font_size]"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fde9fbab"
msgid "Je n'ose pas y aller, ça me fait mal de les voir comme ça alors qu'elles s'appréciaient tellement."
msgstr "Eu não tenho coragem de ir lá. Me dói ver as duas assim, elas se davam tão bem."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_07f37322"
msgid "De plus je crois que tu es le sujet de leur dispute..."
msgstr "Além do mais, acho que o motivo da briga é você..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2fd7763f"
msgid "Ne t'en fais pas je vais m'en occuper."
msgstr "Não se preocupe, eu vou resolver isso."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ae713cd0_4"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fc8becd8"
msgid "{{noriko.n}} ?"
msgstr "{{noriko.n}}?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cc8b750d"
msgid "[font_size=14]Rejoins moi ![/font_size]"
msgstr "[font_size=14]Vem pra cá![/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_51b4dc79"
msgid "Je veux bien mais où es-tu ?"
msgstr "Eu até iria, mas onde você está?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_98127c6a"
msgid "[font_size=14]Dans la chambre de maman ![/font_size]"
msgstr "[font_size=14]No quarto da mamãe![/font_size]"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6cd29357"
msgid "Oh... Je le sens mal."
msgstr "Ah... Tenho um mau pressentimento."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5e0b7b17"
msgid "Zut zut zut ! Si elle me voit ici je vais avoir des problèmes !"
msgstr "Droga, droga, droga! Se ela me pegar aqui, estou frita!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_605e7591"
msgid "[font_size=14]Bonsoir mon chéri... {{noriko.n}} n'est pas avec toi ?[/font_size]"
msgstr "[font_size=14]Boa noite, querido... a {{noriko.n}} não está com você?[/font_size]"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ac02c3f0"
msgid "Allez {{saito.n}}... Peu importe ce que tu veux faire mais empêche-la de rentrer dans la chambre !"
msgstr "Vai, {{saito.n}}... Não importa o que você faça, mas não deixa ela entrar no quarto!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2eef2eff"
msgid "[font_size=14]Non... Je crois qu'elle était fatiguée[/font_size]"
msgstr "[font_size=14]Não... Acho que ela estava cansada.[/font_size]"

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f1bd8145"
msgid "Oui c'est bien ça comme excuse, c'est crédible, elle ne viendra pas vérifier !"
msgstr "Isso, essa desculpa é boa, é convincente. Ela não vai vir conferir!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_81a86cad"
msgid "[font_size=14]Tu ne devais pas travailler au club ce soir ?[/font_size]"
msgstr "[font_size=14]Você não ia trabalhar no clube de acompanhantes hoje à noite?[/font_size]"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_41a10d77"
msgid "[font_size=14]Si... mais finalement j'ai pu rentrer, problème de livraison d'alcool.[/font_size]"
msgstr "[font_size=14]Sim... mas acabei voltando, tivemos um problema com a entrega de bebidas.[/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bb80618f"
msgid "[font_size=14]Le problème à la boutique est réglé ?[/font_size]"
msgstr "[font_size=14]O problema na cafeteria foi resolvido?[/font_size]"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e7785f83"
msgid "[font_size=14]Une petite fuite d'eau, c'est bon à présent ![/font_size]"
msgstr "[font_size=14]Era só um vazamento de água, já está tudo certo![/font_size]"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c5b6905f"
msgid "Allez ailleurs bon sang ! Je ne peux pas sortir si vous restez tous les deux dans le salon !"
msgstr "Vão para outro lugar, caramba! Não consigo sair se vocês dois ficarem aí na sala!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_PUIS_E_JE_VAIS_ALLER_M_D7A386"
msgid "Je suis épuisée, je vais aller me coucher tout de suite."
msgstr "Estou exausta, vou logo me deitar."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_412c8af5"
msgid "[font_size=14]Étant donné que {{noriko.n}} est déjà en train de dormir... Et que tu es déjà dans la bonne tenue... Il ne te reste plus qu'à venir avec moi ![/font_size]"
msgstr "[font_size=14]Já que a {{noriko.n}} já está dormindo... e você já está vestido assim... só falta vir comigo![/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7f815e7f"
msgid "Euh oui mais.... At-"
msgstr "Er, sim, mas... Espe-"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b7f70ad9"
msgid "Non non non non non!"
msgstr "Não, não, não, não, não!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_df9f0303"
msgid "Une cachette vite !"
msgstr "Um esconderijo, rápido!"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "tbae4d5efc7"
msgid "...Il est vraiment reparti comme ça... Sans prévenir ?"
msgstr "...Ele simplesmente foi embora assim... Sem avisar?"

#. Character:`sayuri` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "t71128971aa"
msgid "Ah toi aussi ça te choque, je ne suis pas folle, c'est..."
msgstr "Ah, então você também acha estranho? Eu não estou louca, é..."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t94d5259211"
msgid "Oh bonjour {{saito.n}} !"
msgstr "Ah, bom dia, {{saito.n}}!"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "te2186388a4"
msgid "Désolé mon chéri, on t'a réveillé ?"
msgstr "Desculpa, querido, nós te acordamos?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t102709a3a7"
msgid "Non non, j'allais juste courir au parc."
msgstr "Não, não, eu só ia correr no parque."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "t16525fde98"
msgid "Toutefois je suis surpris que vous vous connaissiez ?"
msgstr "Mas estou surpreso... vocês se conhecem?"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "t4595aa5678"
msgid "{{yasuka.n}} est une amie de longue date, on s'est un peu perdues de vue avec le temps, mais le fait que tu sois proche de ma fille a permis de nous rapprocher de nouveau."
msgstr "A {{yasuka.n}} é uma amiga de longa data. A gente se perdeu de vista com o tempo, mas o fato de você ser próximo da minha filha acabou nos aproximando de novo."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t0f71f4bd02"
msgid "Je suis content pour vous deux dans ce cas."
msgstr "Fico feliz por vocês duas, então."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t69685c5056"
msgid "Je vous laisse continuer votre discussion, vous avez sûrement un millier de choses à vous raconter, ne faites pas attention à moi."
msgstr "Vou deixar vocês continuarem o papo, devem ter um milhão de coisas para contar. Nem liguem para mim."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb222c41a00"
msgid "Tu es un amour !"
msgstr "Você é um amor!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "td7fe5968d7"
msgid "A plus tard."
msgstr "Até mais tarde."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "t72b23f76d7"
msgid "Bon vous avez fini vos secrets tous les deux ?"
msgstr "Bom, vocês dois já acabaram com os segredinhos?"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "t4c05b7754b"
msgid "Je vois bien votre complicité."
msgstr "Dá para ver de longe a cumplicidade de vocês."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "t9a98a25721"
msgid "[font_size=14]Invite la à sortir ![/font_size]"
msgstr "[font_size=14]Chama ela para sair![/font_size]"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb073f11752"
msgid "Je me disais... Vu que tu as du temps libre en ce moment..."
msgstr "Estava pensando... Já que você está com tempo livre agora..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t7f77fda481"
msgid "Est-ce que ça te dirait que je t'emmène te changer les idées ?"
msgstr "O que acha de eu te levar para dar uma volta e distrair a cabeça?"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb2566d66e2"
msgid "Tu es adorable {{saito.n}} mais ne te force pas, qu'est-ce que tu irais faire avec une vieille bique comme moi ?"
msgstr "Você é um amor, {{saito.n}}, mas não precisa se forçar. O que você ia querer com uma coroa como eu?"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "ta3e3832288"
msgid "On risquerait de me prendre pour ta mère."
msgstr "Vão acabar achando que eu sou sua mãe."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t23009f53cf"
msgid "Je n'y crois pas une seconde, au pire, on pourrait te prendre pour ma grande sœur !"
msgstr "Duvido muito. Na pior das hipóteses, vão achar que você é minha irmã mais velha!"

#. Character:`sayuri` | Attributes:`moved,blush`
#: game/story/home_player_livingroom.dialogue
msgctxt "t18f2d777f6"
msgid "{{yasuka.n}} c'est toi qui as élevé ce séducteur dangereux ?!"
msgstr "{{yasuka.n}}, foi você que criou esse sedutor perigoso?!"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "t54c731a429"
msgid "Il faut toujours que tu en fasses des tonnes."
msgstr "Ele sempre exagera."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb8367f0ae9"
msgid "Accepte donc la proposition !"
msgstr "Aceita logo o convite!"

#. Character:`sayuri` | Attributes:`pouting,blush`
#: game/story/home_player_livingroom.dialogue
msgctxt "tf9ace33443"
msgid "Tu crois que je ne vois pas ce que tu es en train de faire ?"
msgstr "Você acha que eu não percebi o que você está tentando fazer?"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t7d69c77a24"
msgid "Mais j'accepte !"
msgstr "Mas eu aceito!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "ta8cce4653c"
msgid "Il y a certes un peu de {{yasuka.n}} dans cette idée mais j'aimerais aussi beaucoup apprendre à connaître la mère de ma meilleure amie."
msgstr "Tem um pouco de dedo da {{yasuka.n}} nessa ideia, mas eu também queria muito conhecer melhor a mãe da minha melhor amiga."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "te72542ea60"
msgid "Il y a certes un peu de {{yasuka.n}} dans cette idée mais j'aimerais aussi beaucoup apprendre à connaître ma future belle-mère qui sait..."
msgstr "Tem um pouco de dedo da {{yasuka.n}} nessa ideia, mas eu também queria muito conhecer melhor a minha futura sogra, quem sabe..."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "td0e143b5c8"
msgid "Mon dieu mais quel gendre idéal tu fais !"
msgstr "Meu Deus, mas que genro ideal você seria!"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "teb12b3f350"
msgid "Tu m'as convaincue, passe me chercher demain en début d'après midi."
msgstr "Me convenceu. Passa pra me buscar amanhã no começo da tarde."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t3de0ec8306"
msgid "Ca marche !"
msgstr "Fechado!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "t36d9e66e3e"
msgid "{{yasuka.n}} merci pour le thé et la discussion, je dois me... préparer."
msgstr "{{yasuka.n}}, obrigada pelo chá e pela conversa. Eu preciso ir me... preparar."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t268f9d5113"
msgid "Oui je vois ce que tu veux dire, à bientôt !"
msgstr "Sei bem o que você quer dizer. Até mais!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "te128fc9855"
msgid "Merci pour tout !"
msgstr "Obrigada por tudo!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "t8d09dad7fd"
msgid "Merci mon chéri, je suis désolé de t'imposer cette situation."
msgstr "Obrigada, querido. Sinto muito por te empurrar essa situação."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_ESP_RE_QUE_A_NE_TE_D_RANGE_P_39F924"
msgid "J'espère que ça ne te dérange pas ?"
msgstr "Espero que não se importe?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_M_EN_VOUDRAIS_DE_CAUSER_DES_A361B6"
msgid "Je m'en voudrais de causer des problèmes entre toi et {{asami.n}}."
msgstr "Não queria causar problemas entre você e a {{asami.n}}."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_CERTAIN_QU_ELLE_SERAIT_87D3ED"
msgid "Je suis certain qu’elle serait contente que je m’occupe de sa mère."
msgstr "Tenho certeza de que ela ficaria feliz de eu estar cuidando da mãe dela."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_PUIS_QU_EST_CE_QUI_POURRAIT_016D63"
msgid "Et puis... qu'est-ce qui pourrait se passer de mal ?"
msgstr "E também... o que poderia dar errado?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_MON_CH_RI_TU_M_ENL_VES_V_50341E"
msgid "Merci mon chéri, tu m'enlèves vraiment une épine du pied."
msgstr "Obrigada, querido. Você me quebra um galho enorme."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "LA_VOIR_DANS_CET_TAT_ME_FAISAI_8D036D"
msgid "La voir dans cet état me faisait bien trop de peine."
msgstr "Me dava muita pena ver ela naquele estado."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_T_INQUI_TES_INUTILEMENT_TO_5A75D1"
msgid "Tu t'inquiètes inutilement, tout ira bien"
msgstr "[hint=ROTA DA TRANSGRESSÃO]Você está se preocupando à toa, vai ficar tudo bem"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_MON_CH_RI_JE_SUIS_D_SOL_5A36E1"
msgid "Merci mon chéri ! Je suis désolée."
msgstr "Obrigada, querido! Sinto muito mesmo."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_M_ENGAGE_EXPLIQUER_ASAMI_N_2A5395"
msgid "Je m'engage à expliquer à {{asami.n}} que c’est moi qui t’ai imposé ça, c'est promis."
msgstr "Eu prometo explicar para a {{asami.n}} que fui eu que te obriguei a isso."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "COMME_A_ELLE_N_AURA_PAS_DE_RAI_99DAB8"
msgid "Comme ça elle n’aura pas de raison de t’en vouloir !"
msgstr "Assim ela não vai ter motivo para ficar brava com você!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "A_ME_MET_DANS_UNE_POSITION_D_78CFE4"
msgid "Ça me met dans une position délicate mais je le ferai pour toi."
msgstr "Isso me deixa em uma posição delicada, mas eu faço por você"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "tfd42b6cec5"
msgid "Tu ne m'imposes rien."
msgstr "Você não está me obrigando a nada."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "tc5fdcabf4d"
msgid "Ce n'est pas comme si j'avais mieux à faire en ce moment."
msgstr "Não é como se eu tivesse algo melhor para fazer agora."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t5febb6b6fb"
msgid "Et puis, comme je l'ai dit, c'est l'occasion de mieux connaitre {{sayuri.n}}."
msgstr "E como eu disse, é uma chance de conhecer melhor a {{sayuri.n}}."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "t2d57151eea"
msgid "Tu as une idée de l'endroit où tu pourrais l'emmener ?"
msgstr "Tem alguma ideia de onde pode levar ela?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t38f342a204"
msgid "Je ne sais pas encore... Je vais y réfléchir."
msgstr "Ainda não sei... Vou pensar em algo."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "tfd9481d405"
msgid "Des suggestions ?"
msgstr "Alguma sugestão?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "t39103a58a1"
msgid "Aucune j'en ai bien peur, ça fait bien trop longtemps."
msgstr "Receio que nenhuma, já faz muito tempo."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "t4212b86433"
msgid "Les seuls souvenirs que j'ai d'elle remontent à loin."
msgstr "As únicas lembranças que tenho dela são de muito tempo atrás."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "tc3220dc13e"
msgid "Et à cette époque {{sayuri.n}} était assez folle."
msgstr "E naquela época, a {{sayuri.n}} era meio doidinha."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb0cd9384a7"
msgid "Bon et bien je vais me creuser les méninges pour trouver quelque chose avant demain."
msgstr "Bom, então vou quebrar a cabeça para encontrar algo antes de amanhã."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_N_EST_TOUJOURS_PAS_RENTR_17BD7C"
msgid "Il n'est toujours pas rentré ?"
msgstr "Ele ainda não voltou?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_COMMENCE_VRAIMENT_M_INQUI_T_C8112E"
msgid "Je commence vraiment à m'inquiéter pour lui..."
msgstr "Estou começando a ficar preocupada..."

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_PEUR_QU_IL_NE_FASSE_QUELQ_DEBD0D"
msgid "J'ai peur qu'il ne fasse quelque chose qu'il puisse regretter."
msgstr "Tenho medo de que ele faça algo de que possa se arrepender."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_JE_NE_SAIS_PAS_E2AD23"
msgid "Je... je ne sais pas."
msgstr "Eu... não sei."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MA_CH_RIE_SI_TOI_AUSSI_TU_AS_B_9EB841"
msgid "Ma chérie... Si toi aussi tu as besoin d'en discuter, n'oublie pas que je serai toujours là pour toi, d'accord ?"
msgstr "Querida... Se você também precisar conversar, não esqueça que eu sempre estarei aqui, tá?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_MERCI_MAMAN_A663E7"
msgid "Oui, merci maman."
msgstr "Sim, obrigada, mãe."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_J_ENTENDS_DU_BRUIT_5E04A3"
msgid "Oh, j'entends du bruit !"
msgstr "Ah, ouvi um barulho!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_VOUS_TES_TOUTES_L_726528"
msgid "Oh, vous êtes toutes là ?!"
msgstr "Ah, vocês estão todas aqui?!"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "MON_CH_RI_TOUT_VA_BIEN_C31FF5"
msgid "Mon chéri, tout va bien ?"
msgstr "Querido, está tudo bem?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "LA_JOURN_E_A_T_FATIGANTE_64BF6D"
msgid "La journée a été... fatigante..."
msgstr "O dia foi... cansativo..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_JUSTE_BESOIN_DE_REPOS_1192FB"
msgid "J'ai juste besoin de repos."
msgstr "Só preciso descansar."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_L_SI_TU_V_C8AF83"
msgid "Je suis là si tu v-"
msgstr "Eu estou aqui se você presi-"

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "S_IL_VOUS_PLA_T_SORTEZ_DE_MA_M_89522A"
msgid "S’il vous plaît, sortez de ma maison !"
msgstr "Por favor, saiam da minha casa!"

#. Character:`cop`
#: game/story/home_player_livingroom.dialogue
msgctxt "MADAME_JE_SUIS_D_SOL_NOUS_AVON_0C4071"
msgid "Madame, je suis désolé, nous avons un mandat et vous hébergez un meurtrier."
msgstr "Minha senhora, sinto muito, mas temos um mandado e a senhora está abrigando um assassino."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ARR_TEZ_DE_DIRE_DES_B_TISES_PA_E0F173"
msgid "Arrêtez de dire des bêtises pareilles ! Ces accusations sont ridicules, et si vous faisiez votre travail correctement, vous le sauriez aussi."
msgstr "Pare de dizer bobagens! Essas acusações são ridículas e, se vocês fizessem o trabalho direito, saberiam disso."

#. Character:`cop` | Attributes:`bad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MADAME_MESUREZ_VOS_PAROLES_VOU_9FC4D3"
msgid "Madame, mesurez vos paroles ! Vous êtes probablement en état de choc face à ce qui est en train d’arriver, mais nous avons des preuves irréfutables."
msgstr "Meça suas palavras! A senhora provavelmente está em choque com o que está acontecendo, mas temos provas irrefutáveis."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUELLES_PREUVES_AVEZ_VOUS_J_AI_89F757"
msgid "Quelles preuves avez-vous ?! J’aimerais bien voir ça !"
msgstr "Que provas?! Eu adoraria ver!"

#. Character:`cop`
#: game/story/home_player_livingroom.dialogue
msgctxt "NOUS_AVONS_TROUV_DES_AFFAIRES_1AE4E4"
msgid "Nous avons trouvé des affaires appartenant à la victime, avec du sang dessus."
msgstr "Encontramos pertences da vítima com sangue."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_BIEN_S_R_VOUS_NE_TROUVEZ_PA_6DBCC6"
msgid "Et bien sûr, vous ne trouvez pas ça étrange qu’il ait gardé tout ça dans sa chambre sans s’en débarrasser ?"
msgstr "E claro, vocês não acham estranho que ele tenha guardado tudo no quarto sem se livrar de nada?"

#. Character:`cop` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "MADAME_SI_VOUS_FAISIEZ_CE_M_TI_9D838B"
msgid "Madame, si vous faisiez ce métier depuis aussi longtemps que moi, vous sauriez à quel point les jeunes de nos jours sont stupides."
msgstr "Minha senhora, se estivesse nessa profissão há tanto tempo quanto eu, saberia como os jovens de hoje em dia são burros."

#. Character:`cop`
#: game/story/home_player_livingroom.dialogue
msgctxt "TOUTES_LES_AFFAIRES_DE_LA_FILL_A7E1B5"
msgid "Toutes les affaires de la fille étaient soigneusement cachées dans un sac à dos."
msgstr "Todas as coisas da garota estavam bem escondidas em uma mochila."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "VOUS_VOULEZ_PARLER_DE_CE_SAC_I_151CE7"
msgid "Vous voulez parler de ce sac ? Il n’est même pas à lui ! C’est son ami {{minato.n}} qui le lui a rapporté, vous devriez plutôt l’interroger, lui !"
msgstr "Você quer dizer aquela mochila? Nem é dele! Foi o amigo dele, o {{minato.n}}, que trouxe. Deviam interrogar ele!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "DU_MOINS_SI_C_EST_VRAIMENT_VOT_3DA2E1"
msgid "Du moins... si c’est vraiment votre intention..."
msgstr "Isso... se a intenção de vocês for mesmo investigar algo..."

#. Character:`cop` | Attributes:`disgusted`
#: game/story/home_player_livingroom.dialogue
msgctxt "MADAME_JE_N_AIME_PAS_BEAUCOUP_2CB51A"
msgid "Madame, je n’aime pas beaucoup vos insinuations."
msgstr "Não gosto nem um pouco das suas insinuações."

#. Character:`cop`
#: game/story/home_player_livingroom.dialogue
msgctxt "NOUS_ALLONS_PARTIR_MAIS_NOUS_L_36E6A3"
msgid "Nous allons partir, mais nous laisserons un agent devant votre maison au cas où l’assassin d’{{asami.n}} viendrait prendre contact avec vous."
msgstr "Vamos embora, mas deixaremos um policial na frente da casa, caso o assassino da {{asami.n}} tente fazer contato."

#. Character:`cop` | Attributes:`bad`
#: game/story/home_player_livingroom.dialogue
msgctxt "DANS_CE_CAS_L_MERCI_DE_NOUS_CO_853FDF"
msgid "Dans ce cas-là, merci de nous contacter rapidement !"
msgstr "Se isso acontecer, faça o favor de nos avisar rápido!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "AUCUNE_CHANCE_SORTEZ_DE_CHEZ_M_5C4414"
msgid "Aucune chance ! Sortez de chez moi !"
msgstr "Nem morta! Fora da minha casa!"

#. Character:`cop`
#: game/story/home_player_livingroom.dialogue
msgctxt "BONNE_JOURN_E_MADAME_4CBF2D"
msgid "Bonne journée madame !"
msgstr "Tenha um bom dia!"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "AAAAAHH_JE_N_AI_JAMAIS_EU_AUTA_04B639"
msgid "Aaaaahh ! Je n’ai jamais eu autant envie de faire du mal à quelqu’un de ma vie !"
msgstr "Aaaaahh! Nunca tive tanta vontade de esganar alguém na minha vida!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "QU_EST_CE_QUI_S_EST_PASS_POURQ_534C5A"
msgid "Qu'est-ce qui s'est passé ?! Pourquoi la police est à la recherche de {{saito.n}} ?"
msgstr "O que aconteceu?! Por que a polícia está atrás do {{saito.n}}?"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "CE_N_EST_PAS_POSSIBLE_IL_EST_I_222487"
msgid "Ce n'est pas possible, il est innocent, je te jure que je n'ai rien à voir avec ça !"
msgstr "Não é possível, ele é inocente! Eu juro que não tenho nada a ver com isso!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "NOUS_TIONS_M_ME_ENSEMBLE_LE_JO_1D806C"
msgid "Nous étions même ensemble le jour où ma fille a été enlevée !"
msgstr "Estávamos juntos no dia em que minha filha foi levada!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_CERTAINE_QUE_LA_POLICE_6F1223"
msgid "Je suis certaine que la police a fait une erreur, je vais aller les voir et tirer ça au clair et..."
msgstr "Tenho certeza de que a polícia cometeu um erro, vou lá agora mesmo esclarecer as coisas e..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "CALME_TOI_UN_PEU_JE_SAIS_BIEN_1033BF"
msgid "Calme-toi un peu, je sais bien que tu n'y es pour rien."
msgstr "Calma um pouco, eu sei que você não tem culpa de nada."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_SI_J_TAIS_TOI_JE_N_IRAIS_EABF35"
msgid "Mais si j'étais toi, je n'irais pas voir la police."
msgstr "Mas, se eu fosse você, não iria falar com a polícia."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_COMMENT_A_BAB138"
msgid "Quoi ?! Comment ça ?"
msgstr "O quê?! Como assim?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "TOUT_A_FAIT_PARTIE_D_UNE_MISE_26286E"
msgid "Tout ça fait partie d'une mise en scène pour couvrir quelque chose de bien plus gros, et j'ai bien peur que tout ça soit lié à l'enlèvement d'{{asami.n}}."
msgstr "Tudo isso é uma armação para encobrir algo muito maior, e temo que esteja ligado ao sequestro da {{asami.n}}."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SAVAIS_BIEN_QUE_CES_FLICS_0E535A"
msgid "... Je savais bien que ces flics étaient louches depuis le début !"
msgstr "... Eu sabia que esses policiais eram estranhos desde o começo!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUEL_POINT_CETTE_SITUATION_ES_4A226F"
msgid "À quel point cette situation est-elle mauvaise ?"
msgstr "O quão feia é a situação?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "D_ABORD_ASSIEDS_TOI_ET_GARDE_L_76D46D"
msgid "D'abord, assieds-toi et garde l'esprit ouvert, car tout ce que tu vas entendre à partir de maintenant est la vérité."
msgstr "Primeiro, senta e mantém a mente aberta, porque tudo o que você vai ouvir daqui em diante é a verdade."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "A_RISQUE_AUSSI_DE_DEVENIR_DAN_CBE59C"
msgid "Ça risque aussi de devenir dangereux pour toi, tu es certaine de le vouloir ?"
msgstr "Isso também pode ser perigoso para você. Tem certeza de que quer saber?"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VEUX_TOUT_SAVOIR_E28D76"
msgid "Je veux tout savoir !"
msgstr "Eu quero saber de tudo!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "TR_S_BIEN_ALORS_W_PARLONS_DU_X_BAD890"
msgid "Très bien alors...[w] Parlons du X3."
msgstr "Tudo bem, então...[w] Vamos falar do X3."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_PARLES_DE_L_INSCRIPTION_SUR_7F162C"
msgid "Tu parles de l'inscription sur les photos de ma fille ? Tu sais ce que ça veut dire ?"
msgstr "Você diz a inscrição nas fotos da minha filha? Sabe o que significa?"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "MALHEUREUSEMENT_OUI_IL_S_AGIT_C58A4B"
msgid "Malheureusement oui... Il s'agit de..."
msgstr "Infelizmente sim... Trata-se de..."

#. Character:`centered`
#: game/story/home_player_livingroom.dialogue
msgctxt "YASUKA_N_RACONTE_SAYURI_N_TOU_773C69"
msgid "{{yasuka.n}} raconte à {{sayuri.n}} tout ce qu'elle a appris auprès de {{noriko.n}} et tout ce qui s'est passé dernièrement."
msgstr "{{yasuka.n}} conta para {{sayuri.n}} tudo o que aprendeu com a {{noriko.n}} e os últimos acontecimentos."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "BORDEL_DE_MERDE_LAISSE_MOI_ALL_6F2449"
msgid "Bordel de merde, laisse-moi aller castrer cette espèce de petit bâtard !"
msgstr "Mas que merda! Me deixa ir lá castrar esse bastardinho agora mesmo!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_ALLER_LUI_R_GLER_SON_C_169792"
msgid "Je vais aller lui régler son compte moi-même."
msgstr "Eu mesma vou acertar as contas com ele."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "RESTE_ASSISE_JE_NE_T_AI_PAS_RA_55CAA7"
msgid "Reste assise, je ne t'ai pas raconté ça pour que tu te mettes en danger inutilement."
msgstr "Fica sentada. Não te contei isso para você se colocar em perigo à toa."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ON_NE_PEUT_PAS_S_EXPOSER_OUVER_54628C"
msgid "On ne peut pas s'exposer ouvertement ou leur faire comprendre qu'on est au courant de leurs manigances, nous devons agir discrètement !"
msgstr "Não podemos nos expor ou deixar que saibam que descobrimos as jogadas deles. Temos que agir com discrição!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAMAN_IL_Y_A_LA_POLICE_DEVANT_6FE996"
msgid "Maman ! Il y a la police devant la maison !"
msgstr "Mãe! Tem polícia na frente da casa!"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "DE_PIRE_EN_PIRE_FA24C2"
msgid "De pire en pire..."
msgstr "Isso só vai de mal a pior..."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "VOTRE_TH_EST_VRAIMENT_D_LICIEU_5D151B"
msgid "Votre thé est vraiment délicieux."
msgstr "O seu chá é realmente delicioso."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "QU_EST_CE_QUE_TU_VEUX_73F2B7"
msgid "Qu’est-ce que tu veux ?"
msgstr "O que você quer?"

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SAIS_PERTINEMMENT_CE_QUE_VO_0BDBB7"
msgid "Je sais pertinemment ce que vous ressentez pour {{saito.n}}. Vous ne pourrez pas me mentir là-dessus."
msgstr "Eu sei perfeitamente o que a senhora sente pelo {{saito.n}}. Não adianta mentir para mim sobre isso."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_NE_ME_PARLEZ_PAS_D_UN_AMOUR_1D0256"
msgid "Et ne me parlez pas d’un amour filial, cela va bien au-delà."
msgstr "E nem me venha falar de amor maternal, o que sente vai muito além."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_DEVRAIS_PEUT_TRE_VOUS_LAISS_1C9F69"
msgid "Je devrais peut-être vous laisser..."
msgstr "Talvez seja melhor eu deixar vocês..."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "PAS_SI_VITE_TOI_7F61C4"
msgid "Pas si vite toi !"
msgstr "Não tão rápido, mocinha!"

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_ME_PENSES_ASSEZ_STUPIDE_POUR_B88920"
msgid "Tu me penses assez stupide pour ne pas savoir ce que tu as fait avec lui ?"
msgstr "Você me acha estúpida o bastante para não saber o que você andou fazendo com ele?"

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_TU_ES_TOUT_AUSSI_CONCERN_E_080E7F"
msgid "Non ! Tu es tout aussi concernée."
msgstr "Não! Isso também diz respeito a você."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "VOUS_ME_PENSEZ_ASSEZ_STUPIDE_P_B63980"
msgid "Vous me pensez assez stupide pour ne pas voir ce que vous avez fait avec lui, toutes les deux ?"
msgstr "Vocês me acham estúpida o bastante para não perceber o que andaram fazendo com ele, as duas?"

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_PASS_BEAUCOUP_DE_TEMPS_VO_E8AE4F"
msgid "J’ai passé beaucoup de temps à vous observer. Vous souhaitez toutes rester à ses côtés, mais aucune d’entre vous n’a la volonté d’agir et de faire ce qui est nécessaire le moment venu."
msgstr "Passei muito tempo observando vocês. Todas desejam ficar ao lado dele, mas nenhuma tem a força de vontade para agir e fazer o que é necessário quando o momento chega."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "QU_EST_CE_QUE_TU_INSINUES_EST_8109DA"
msgid "Qu’est-ce que tu insinues ? Est-ce que tu essaies de nous intimider ?"
msgstr "O que você está insinuando? Está tentando nos intimidar?"

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "W_VOTRE_REMARQUE_EST_TOUT_FAI_A464E1"
msgid "...[w] Votre remarque est tout à fait déplaisante. Vous vous méprenez..."
msgstr "...[w] O seu comentário é totalmente desagradável. A senhora está enganada..."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_NE_S_AGIT_EN_AUCUN_CAS_D_IN_6C9344"
msgid "Il ne s’agit en aucun cas d’intimidation, mais plutôt d’un avertissement."
msgstr "Não se trata de forma alguma de intimidação, mas sim de um aviso."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_LA_M_ME_CHOSE_E1AE40"
msgid "C’est la même chose !"
msgstr "É a mesma coisa!"

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VOUS_TOL_RE_UNIQUEMENT_PAR_2655CD"
msgid "Je vous tolère uniquement par amour pour {{saito.n}}, mais ma patience a des limites."
msgstr "Eu as tolero apenas por amor ao {{saito.n}}, mas a minha paciência tem limites."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "SI_VOUS_D_SIREZ_VOUS_TENIR_SES_59E3F6"
msgid "Si vous désirez vous tenir à ses côtés, montrez-vous dignes et ne vous comportez pas comme des parasites."
msgstr "Se desejam estar ao lado dele, mostrem-se dignas e não se comportem como parasitas."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_REFUSE_DE_PARTAGER_MON_FUTU_F4A7FE"
msgid "Je refuse de partager mon futur mari avec des femmes qui ne méritent pas mon respect."
msgstr "Eu me recuso a compartilhar o meu futuro marido com mulheres que não merecem o meu respeito."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "SUR_CE_MERCI_POUR_CET_EXCELLEN_C9CFA8"
msgid "Sur ce... Merci pour cet excellent thé, je vous souhaite une bonne journée."
msgstr "No mais... obrigada pelo excelente chá. Desejo a vocês um bom dia."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "BON_BON_BON_0700D3"
msgid "Bon... bon... bon..."
msgstr "Bom... então... né..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_CROIS_QUE_J_AI_UN_TRUC_FAIR_94508A"
msgid "Je crois que j’ai un truc à faire dans ma chambre."
msgstr "Acho que tenho uma coisa para fazer no meu quarto."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_DEVOIR_1819E1"
msgid "Je vais devoir..."
msgstr "Eu preciso..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_CROIS_QUE_NOUS_DEVONS_AVOIR_B600A5"
msgid "Je crois que nous devons avoir une discussion, toi et moi !"
msgstr "Eu acho que nós precisamos ter uma conversa, você e eu!"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAMAN_JE_NE_SUIS_PAS_CERTAINE_1FF9C5"
msgid "Maman... je ne suis pas certaine d’en avoir envie."
msgstr "Mãe... não tenho certeza se estou a fim."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_livingroom.dialogue
msgctxt "SURTOUT_S_IL_S_AGIT_DE_DISCUTE_399294"
msgid "Surtout s’il s’agit de discuter de ça !"
msgstr "Principalmente se for para discutir isso!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_QUE_SI_TU_VAS_POSER_TES_FES_7A0736"
msgid "Oh que si ! Tu vas poser tes fesses sur ce canapé et me raconter tout ce que tu fais dans mon dos avec {{saito.n}}."
msgstr "Ah, mas vai sim! Você vai sentar essa bunda no sofá agora e me contar tudo o que anda fazendo pelas minhas costas com o {{saito.n}}."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_Y_A_VISIBLEMENT_DES_CHOSES_3CD7DA"
msgid "Il y a visiblement des choses que j’ignore et dont cette fille est pourtant au courant."
msgstr "Pelo visto tem coisas que eu não sei, mas que aquela garota sabe muito bem."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUELLE_RELATION_ENTRETIENS_TU_838B0A"
msgid "Quelle relation entretiens-tu exactement avec lui ?"
msgstr "Que tipo de relação você tem com ele, exatamente?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "AVEZ_VOUS_COUCH_ENSEMBLE_8317A3"
msgid "Avez-vous couché ensemble ?"
msgstr "Vocês transaram?"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAMAN_662D2B"
msgid "Maman !!!"
msgstr "Mãããe!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "EH_BIEN_VOUS_TES_D_J_BIEN_BRUY_0A3C1D"
msgid "Eh bien, vous êtes déjà bien bruyants dès le matin, que s'est-il passé ?"
msgstr "Ora, ora, vocês dois já estão bem barulhentos logo cedo. O que aconteceu?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_B731A1"
msgid "Je..."
msgstr "Eu..."

#. Character:`narrator` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "ZUT_JE_NE_PEUX_PAS_LUI_DIRE_CE_E9BA36"
msgid "Zut ! Je ne peux pas lui dire ce qui m'est arrivé. La connaissant, elle risque surtout de s'inquiéter davantage."
msgstr "Droga! Não posso contar pra ela o que aconteceu comigo. Do jeito que ela é, só vai acabar se preocupando mais ainda."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "DISONS_QUE_JE_ME_SUIS_R_VEILL_A2F79E"
msgid "Disons que je me suis réveillé d'un long cauchemar."
msgstr "Digamos que eu acordei de um longo pesadelo."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "EN_EFFET_TON_REGARD_SEMBLE_DIF_7080BF"
msgid "En effet, ton regard semble différent ce matin, quelque chose a changé mais je ne parviens pas à dire quoi."
msgstr "Pois é, o seu olhar parece diferente hoje de manhã... Algo mudou, mas não consigo dizer o quê."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_DONC_CE_CAUCHEMAR_TU_ME_RAC_459769"
msgid "Et donc ce cauchemar ? Tu me racontes ?"
msgstr "E então, que pesadelo foi esse? Quer me contar?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "FONT_SIZE_14_C_TAIT_UN_R_VE_P_174A56"
msgid "[font_size=14]C'était un rêve pervers, pas un cauchemar ![/font_size]"
msgstr "[font_size=14]Foi um sonho erótico, isso sim![/font_size]"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_C_EST_VRAI_BF35E1"
msgid "Quoi, c'est vrai ?"
msgstr "O quê, é sério?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "FONT_SIZE_14_TU_SAIS_QUE_SI_T_A75DE9"
msgid "[font_size=14]Tu sais que si tu as taché tes draps, tu peux me le dire...[/font_size]"
msgstr "[font_size=14]Sabe que se você manchou os lençóis, pode me falar...[/font_size]"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_CE_N_TAIT_P_4EA2BD"
msgid "NON ! CE N'ÉTAIT P-"
msgstr "NÃO! NÃO FOI N-"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "CE_N_TAIT_PAS_CE_GENRE_DE_R_VE_A77142"
msgid "Ce n'était pas ce genre de rêve, à vrai dire j'aurais préféré..."
msgstr "Não foi esse tipo de sonho... Pra falar a verdade, eu até preferia que fosse..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_A_VA_BEAUCOUP_MIEUX_J_AI_442952"
msgid "Mais ça va beaucoup mieux ! J'ai décidé de me reprendre en main."
msgstr "Mas já estou bem melhor! Decidi tomar vergonha na cara."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_TOI_COMMENT_A_VA_7A4D85"
msgid "Et toi ? Comment ça va ?"
msgstr "E você? Como você está?"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "MOI_53E4BB"
msgid "... Moi ?"
msgstr "... Eu?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "EH_BIEN_OUI_JE_SAIS_D_J_QUE_NO_B5D379"
msgid "Eh bien oui... Je sais déjà que {{noriko.n}} est en pleine forme, elle me l'a encore démontré ce matin."
msgstr "É, ué... Eu já sei que a {{noriko.n}} está em ótima forma, ela acabou de me provar isso agorinha."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_ET_TOI_311FE1"
msgid "Mais et toi ?"
msgstr "Mas e você?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_LA_PREMI_RE_FOIS_QUE_TU_34D731"
msgid "C'est la première fois que tu me demandes..."
msgstr "É a primeira vez que você me pergunta isso..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_CROIS_QUE_JE_VAIS_PLEURER_95DDCC"
msgid "Je crois que je vais pleurer..."
msgstr "Acho que vou chorar..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_NON_NON_NON_31FCDC"
msgid "Quoi ?! Non, non, non !"
msgstr "O quê?! Não, não, não!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_NE_VOULAIS_PAS_ME_MOQUER_DE_5319B2"
msgid "Je ne voulais pas me moquer de toi, je... je suis désolé, j'aurais dû te demander ça bien plus souvent"
msgstr "Eu não queria debochar de você, eu... me desculpa, eu devia ter te perguntado isso com muito mais frequência."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "PARDON_11291A"
msgid "Pardon."
msgstr "Perdão."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_NE_T_INQUI_TE_PAS_CE_SONT_4B15C4"
msgid "Non, ne t'inquiète pas, ce sont des larmes de joie..."
msgstr "Não, não se preocupe, são lágrimas de alegria..."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_TU_EN_ES_S_RE_755C4F"
msgid "Tu... tu en es sûre ?"
msgstr "Você... tem certeza?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "VIDEMMENT_823C0B"
msgid "Évidemment !"
msgstr "É claro!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_POUR_TE_R_PONDRE_HONN_TEM_29F78B"
msgid "Mais pour te répondre honnêtement... ça ne va pas très fort en ce moment."
msgstr "Mas pra te responder com sinceridade... as coisas não andam muito bem ultimamente."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "SI_JE_PEUX_FAIRE_QUOI_QUE_CE_S_6D0ED7"
msgid "Si je peux faire quoi que ce soit pour t'aider..."
msgstr "Se tiver qualquer coisa que eu possa fazer pra te ajudar..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_MON_CH_RI_MAIS_J_AI_BIEN_06B224"
msgid "Merci mon chéri, mais j'ai bien peur que cela soit au-delà de ta portée."
msgstr "Obrigada, querido, mas receio que isso esteja fora do seu alcance."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_PEUX_QUAND_M_ME_M_EN_PARLER_81D3DE"
msgid "Tu peux quand même m'en parler ?"
msgstr "Você poderia me contar mesmo assim?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "BIEN_S_R_C_EST_55B0C3"
msgid "Bien sûr... C'est-"
msgstr "Claro... É que-"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_CAUSE_DES_DETTES_QUI_SE_4DFFCD"
msgid "C'est à cause des dettes qui se sont accumulées et je ne parviens plus à les rembourser."
msgstr "É por causa das dívidas que foram se acumulando, não estou dando conta de pagar."

#. Character:`narrator` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "COMMENT_A_LES_DETTES_B9A6B8"
msgid "Comment ça \"les\" dettes ?"
msgstr "Como assim 'as' dívidas?"

#. Character:`narrator` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_ME_SEMBLAIT_QUE_YASUKA_N_TA_610A0F"
msgid "Il me semblait que {{yasuka.n}} était un peu endettée, mais elle n'a jamais parlé de plusieurs dettes."
msgstr "Eu achava que a {{yasuka.n}} estivesse um pouco endividada, mas ela nunca falou em várias dívidas."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "DE_QUELLES_DETTES_PARLES_TU_EX_BF2F08"
msgid "De quelles dettes parles-tu exactement ?"
msgstr "De quais dívidas você está falando, exatamente?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_CROYAIS_QU_IL_N_Y_EN_AVAIT_27FCF8"
msgid "Je croyais qu'il n'y en avait qu'une !"
msgstr "Pensei que só tivesse uma!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "SI_SEULEMENT_MAIS_NON_J_AI_AUS_0AFCB3"
msgid "Si seulement... Mais non, j'ai aussi celle que ton père m'a laissée quand il m'a confié ta charge."
msgstr "Quem dera... Mas não, também tem aquela que o seu pai me deixou quando me entregou a sua guarda."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "AVANT_QU_IL_NE_DISPARAISSE_AVE_41A2C2"
msgid "Avant qu'il ne disparaisse avec-"
msgstr "Antes de ele sumir com-"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "BREF_NE_T_EMB_TE_PAS_AVEC_A_LA_ABDA6F"
msgid "Bref... Ne t'embête pas avec ça, laisse-moi gérer."
msgstr "Enfim... Não se esquente com isso, deixa que eu me viro."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "MON_P_RE_T_A_LAISS_SA_DETTE_MA_E33D28"
msgid "Mon père t'a laissé sa dette ?!! Mais... Comment..."
msgstr "O meu pai te deixou a dívida dele?!! Mas... Como..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "COMMENT_UNE_TELLE_CHOSE_A_PU_A_BA629A"
msgid "Comment une telle chose a pu arriver ? Comment as-tu pu accepter quelque chose comme-"
msgstr "Como uma coisa dessas foi acontecer? Como você pôde aceitar algo como-"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "DU_CALME_JE_SUIS_RAVIE_QUE_TU_A0152D"
msgid "Du calme... Je suis ravie que tu t'énerves pour moi, j'en avais perdu la capacité au bout de toutes ces années."
msgstr "Calma... Fico feliz que você esteja se irritando por mim, eu já tinha até perdido a capacidade de fazer isso depois de todos esses anos."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_C_EST_INJUSTE_COMMENT_POU_F48969"
msgid "Mais c'est injuste...! Comment ? Pourquoi ?"
msgstr "Mas isso é injusto...! Como? Por quê?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_T_EXPLIQUER_QUAND_TON_1D0DEA"
msgid "Je vais t'expliquer. Quand ton père t'a déposé chez moi, il m'a dit qu'il avait des problèmes et qu'il ne pouvait pas te garder près de lui pour des raisons de... sécurité."
msgstr "Vou te explicar. Quando o seu pai te deixou comigo, ele disse que estava com problemas e que não podia te manter por perto por razões de... segurança."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_ACCEPT_TOUT_DE_SUITE_TU_A_119746"
msgid "J'ai accepté tout de suite, tu avais déjà perdu ta mère par le passé, il était hors de question que tu aies à subir ça encore une fois."
msgstr "Eu aceitei na hora. Você já tinha perdido a sua mãe no passado, estava fora de cogitação você passar por isso de novo."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_J_AI_APPRIS_PLUS_TARD_QUE_018029"
msgid "Mais j'ai appris plus tard que ton père fuyait surtout ses créanciers... Et comme j'avais pris ta charge, ils m'ont fait comprendre que c'était également ma responsabilité de rembourser ce qu'il devait."
msgstr "Mas depois acabei descobrindo que o seu pai estava era fugindo dos credores dele... E como eu tinha ficado com a sua guarda, eles me deram a entender que também era minha responsabilidade pagar o que ele devia."

#. Character:`saito` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_C_EST_JUSTE_HORRIBLE_COMM_196269"
msgid "Mais c'est juste horrible, comment ont-ils pu..."
msgstr "Mas isso é horrível, como eles puderam..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "LAISSE_MOI_TE_REMBOURSER_076FA9"
msgid "Laisse-moi te rembourser !!"
msgstr "Deixa que eu assumo essa dívida!!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_GENTIL_MON_CH_RI_MAIS_TU_5D5775"
msgid "C'est gentil mon chéri, mais tu sais... même si tu économisais ton argent de poche pendant des années, tu serais toujours très loin du compte."
msgstr "É muita gentileza sua, querido, mas sabe... mesmo se você economizasse a sua mesada por anos, ainda estaria muito longe do valor."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "PUT_DE_COMBIEN_ON_PARLE_EXACTE_6C21C0"
msgid "Put- de combien on parle exactement ?"
msgstr "Porr- de quanto a gente tá falando exatamente?"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "W_PLUSIEURS_MILLIONS_J_EN_AI_252781"
msgid "...[w] Plusieurs millions, j'en ai bien peur..."
msgstr "...[w] Temo que seja... vários milhões..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_JE_SUIS_TELLEMENT_D_SOL_TOU_7A5EAE"
msgid "Je... Je suis tellement désolé, tout ça est ma faute et-"
msgstr "Eu... Sinto muito mesmo, tudo isso é culpa minha e-"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERDE_MAIS_COMMENT_J_AI_PU_PAS_23E693"
msgid "Merde, mais comment j'ai pu passer à côté de ça ?!"
msgstr "Merda, como é que eu deixei isso passar?!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_NE_SAVAIS_PAS_QUE_LA_SITUAT_36E459"
msgid "Je ne savais pas que la situation de {{yasuka.n}} était aussi critique !"
msgstr "Eu não fazia ideia de que a situação da {{yasuka.n}} era tão crítica!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "ELLE_TAIT_TOUJOURS_SOURIANTE_E_945593"
msgid "Elle était toujours souriante et ne laissait jamais rien transparaître, alors qu'elle souffrait en silence depuis tout ce temps..."
msgstr "Ela estava sempre sorrindo sem nunca deixar transparecer nada, enquanto sofria em silêncio durante todo esse tempo..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_POURTANT_C_EST_FE4BDA"
msgid "Mais pourtant, c'est-"
msgstr "Mas é por minha cau-"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "CE_QUI_EST_FAIT_EST_FAIT_ET_JE_C71E2B"
msgid "Ce qui est fait est fait, et je ne regrette pas un seul instant de t'avoir recueilli, d'accord ?"
msgstr "O que está feito, está feito, e não me arrependo nem por um segundo de ter te acolhido, tá legal?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_PUIS_J_AI_DE_LA_RESSOURCE_J_3752B6"
msgid "Et puis j'ai de la ressource ! J'ai eu une proposition pour un nouveau travail dernièrement, quelque chose qui paiera beaucoup mieux, mais c'est un peu..."
msgstr "E além do mais, eu dou o meu jeito! Recebi uma proposta para um novo trabalho ultimamente, algo que vai pagar muito melhor, mas é um pouco..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "UN_PEU_1941B8"
msgid "Un peu...?"
msgstr "Um pouco...?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "UN_PEU_TROP_DIFF_RENT_DE_CE_QU_522D56"
msgid "Un peu trop différent de ce que je fais actuellement, j'ai encore besoin d'y réfléchir, c'est pour ça que j'ai pris quelques jours de repos depuis longtemps pour faire le point."
msgstr "Um pouco diferente demais do que faço atualmente. Ainda preciso pensar sobre isso, por isso tirei uns dias de folga depois de tanto tempo, pra colocar as ideias no lugar."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "D_ACCORD_5558A7"
msgid "D'accord..."
msgstr "Entendi..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_VRAIMENT_HEUREUSE_QUE_86F1CA"
msgid "Je suis vraiment heureuse que tu aies pu montrer des émotions aussi fortes pour moi, toi qui hier avais encore du mal à me regarder dans les yeux..."
msgstr "Fico realmente feliz que você consiga demonstrar emoções tão fortes por mim, logo você que até ontem mal conseguia me olhar nos olhos..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_D_SOL_5D741F"
msgid "Je suis désolé..."
msgstr "Desculpa..."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_APPR_CIE_BEAUCOUP_CE_NOUVEAU_412E12"
msgid "J'apprécie beaucoup ce nouveau {{saito.n}}, moi !"
msgstr "Eu gostei bastante desse novo {{saito.n}}!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "CONTINUE_TES_EFFORTS_JE_T_ENCO_92C2B2"
msgid "Continue tes efforts, je t'encouragerai toujours."
msgstr "Continue se esforçando, vou sempre te apoiar."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "EH_BIEN_TU_EN_FAIS_UNE_T_TE_DB52C8"
msgid "Eh bien, tu en fais une tête ?"
msgstr ""

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "O_EST_PASS_LE_SAITO_N_PLEIN_D_FEBC63"
msgid "Où est passé le {{saito.n}} plein d'énergie que j'ai vu ce matin ?"
msgstr ""

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "CELUI_QUI_SEMBLAIT_D_TERMIN_1DA887"
msgid "Celui qui semblait déterminé ?"
msgstr ""

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "W_J_TAIS_PARTI_AVEC_UN_PLAN_E_D8E0A6"
msgid "...[w] J'étais parti avec un plan en tête, des étapes à suivre en me disant que j'aurais juste à les suivre pour résoudre mes problèmes."
msgstr ""

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_LES_CHOSES_NE_FONCTIONNEN_6D400C"
msgid "Mais les choses ne fonctionnent pas comme ça."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_SAIS_QUE_TU_N_AS_PAS_BESOIN_8C39D6"
msgid "Tu sais que tu n'as pas besoin de tout régler en un seul jour."
msgstr ""

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "CHAQUE_CHOSE_EN_SON_TEMPS_UN_P_362127"
msgid "Chaque chose en son temps, un pas après l'autre."
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_AS_RAISON_JE_NE_SAIS_PAS_PO_05A34F"
msgid "Tu as raison... Je ne sais pas pourquoi j'étais si obsédé par l'idée de vouloir changer aussi vite."
msgstr ""

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_SAIS_QUOI_CE_SOIR_JE_VAIS_D_715442"
msgid "Tu sais quoi ? Ce soir je vais dormir avec toi, comme avant !"
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_MAIS_JE_NE_SUIS_PLUS_UN_E_E3DAAC"
msgid "Quoi mais... Je ne suis plus un enfant, tu sais..."
msgstr ""

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_N_AI_PAS_ENVIE_DE_DORMIR_SE_457B59"
msgid "Je n'ai pas envie de dormir seule en ce moment, je réfléchis trop à cause de mon travail."
msgstr ""

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_NORIKO_N_B7D797"
msgid "Et {{noriko.n}} ?"
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ELLE_DONNE_DES_COUPS_DE_PIED_D_24B965"
msgid "Elle donne des coups de pied dans son sommeil..."
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "A_LUI_RESSEMBLE_TELLEMENT_E73AEC"
msgid "Ça lui ressemble tellement."
msgstr ""

