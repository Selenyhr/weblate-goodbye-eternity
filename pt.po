msgctxt "C_EST_TOUJOURS_PAREIL_AVEC_TOI_4F9D7A"
msgid "C'est toujours pareil avec toi, je ne peux jamais m'expliquer !"
msgstr "É sempre a mesma coisa com você, nunca me deixa falar porra nenhuma!"

#. Character:`cop`
#: game/story/home_player_exterior.dialogue
msgctxt "TU_VEUX_VIVRE_TA_VIE_COMME_TU_79BBE7"
msgid "Tu veux vivre ta vie comme tu l'entends ? Alors trouve-toi un travail et un appartement."
msgstr "Você quer ser o dono do próprio nariz? Então arruma um emprego e paga o seu próprio teto."

