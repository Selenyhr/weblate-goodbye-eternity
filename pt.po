#. Character:`yasuka` | Attributes:`moved`
#: game/story/love_hotel_reception.dialogue
msgctxt "love_hotel_sexe_with_yasuka_aba9bb9b"
msgid "Eh bien, j'ai failli attendre !"
msgstr "Nossa, achei que não vinha mais!"

#. Character:`saito`
#: game/story/love_hotel_reception.dialogue
msgctxt "love_hotel_sexe_with_yasuka_8397d729"
msgid "Je suis désolé, j'essayais d'être discret en quittant la maison."
msgstr "Desculpa, eu estava tentando ser discreto ao sair de casa."

#. Character:`yasuka`
#: game/story/love_hotel_reception.dialogue
msgctxt "love_hotel_sexe_with_yasuka_223cbddc"
msgid "Nous n'avons plus beaucoup de temps devant nous !"
msgstr "Nós não temos muito tempo sobrou para a gente!"

#. Character:`yasuka`
#: game/story/love_hotel_reception.dialogue
msgctxt "love_hotel_sexe_with_yasuka_dc8293d8"
msgid "J'ai envie de toi tout de suite !"
msgstr "Eu quero você agora mesmo!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/love_hotel_reception.dialogue
msgctxt "love_hotel_sexe_with_yasuka_9dec949e"
