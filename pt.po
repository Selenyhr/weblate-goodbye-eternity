#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_a5595a7a"
msgid "T'en profites bien quand je ramène à manger."
msgstr "Você aproveita bem quando eu trago comida para casa."

#. Character:`unknown`
#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_f1b9df69"
msgid "Tu vas t'attirer encore plus de problèmes."
msgstr "Você só vai arrumar ainda mais problemas."

