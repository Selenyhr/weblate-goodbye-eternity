msgctxt "talk_yasuka_ff1d94bb"
msgid "Oui !"
msgstr "Sim!"

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "taeb1bb5d11"
msgid "Prendre un moment avec toi."
msgstr "Passar um momento com você."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_275e13fb"
msgid "Pfff, quel charmeur tu fais."
msgstr "Pfff, mas que galanteador você me saiu."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_65b93099"
msgid "Mais... Tu es adorable."
msgstr "Mas... você é uma fofura."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_3ba5809c"
msgid "Je m'occuperai de toi ce soir comme il se doit."
msgstr "Eu vou cuidar de você hoje à noite como se deve."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_589f34c9"
msgid "J'ai déjà hâte d'y être."
msgstr "Mal posso esperar."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_d30d0d48"
msgid "J'espère bien !"
msgstr "Acho bom mesmo!"

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "te223796b66"
msgid "Je voulais juste voir ton sourire."
msgstr "Eu só queria ver o seu sorriso."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "tc78484a21f"
msgid "[color=yellow]À propos de {{noriko.n}}.[/color]"
msgstr "[color=yellow]A respeito da {{noriko.n}}.[/color]"

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "t77e427bf59"
msgid "Retour"
msgstr "Voltar"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_c4e3f356"
msgid "Le service de sécurité est plutôt horrible, mais je suis content d'être arrivé jusqu'à toi !"
msgstr "A segurança daqui é bem bizarra, mas estou feliz de ter conseguido chegar até você!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_1902730f"
msgid "Oh, tu es venue comme promis !"
msgstr "Ah, você veio como prometeu!"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_d35cc2e2"
msgid "Ça me fait vraiment plaisir."
msgstr "Isso me deixa realmente muito feliz."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_ea1de3c7"
msgid "Je n'allais rater ça pour rien au monde."
msgstr "Eu não perderia isso por nada no mundo."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_24004b8a"
msgid "Sinon, c'est qui la personne vraiment désagréable qui m'a sauté dessus à l'extérieur ?"
msgstr "Mas me diz, quem é aquele cara extremamente desagradável que veio de grosseria para cima de mim lá fora?"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_939e9d88"
msgid "Oh, shhht pas si fort !"
msgstr "Oh, shhht, não fale tão alto!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_35d0832c"
msgid "Il s'agit de mon responsable..."
msgstr "Aquele é o meu gerente..."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_68507bbe"
msgid "C'est le propriétaire de cette boutique."
msgstr "Ele é o dono desta loja."

#. Character:`saito` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_26ec9de7"
msgid "Mmhh, je vois."
msgstr "Mmmhh, entendi."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_7e9effde"
msgid "Il se contente de te laisser tout le travail, je suppose ?"
msgstr "Ele basicamente deixa todo o trabalho pesado nas suas costas, imagino?"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_6ad539b9"
msgid "Oui..."
msgstr "Sim..."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_ef1ad18b"
msgid "C'est donc cette espèce d'ordure qui pourrit la vie de {{yasuka.n}}."
msgstr "Então é esse tipo de lixo que fica infernizando a vida da {{yasuka.n}}."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_b87099fe"
msgid "Je comprends mieux pourquoi elle était prête à accepter ce travail d'hôtesse."
msgstr "Agora eu entendo perfeitamente por que ela estava disposta a aceitar aquele trabalho de acompanhante."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_09f7daef"
msgid "Ce mec a l'air d'être un véritable connard."
msgstr "Esse cara parece ser um baita de um cuzão."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_e489ff3e"
msgid "Même mon instinct me dit de me méfier de lui."
msgstr "Até o meu instinto está me dizendo para ficar esperto com ele."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_97ed4780"
msgid "{{yasuka.N}} !"
msgstr "{{yasuka.N}}!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_f7d46344"
msgid "Je ne te paye pas à ne rien faire !"
msgstr "Eu não te pago para ficar enrolando!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_62f021b1"
msgid "Je déduirai le temps que tu passes à discuter avec les clients de ton salaire !"
msgstr "Vou descontar do seu salário esse tempo que você passa batendo papo com cliente!"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_4f91eaac"
msgid "Quoi !? Non, mais attendez !"
msgstr "O quê?! Não, espera aí!"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_eb19d385"
msgid "Avez-vous passé commande, monsieur ?"
msgstr "O senhor já fez o seu pedido?"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_33cb5b12"
msgid "...Non, pas encore !"
msgstr "...Não, ainda não!"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_725fc51e"
msgid "Si tu comptes ne rien acheter ici, dégage !"
msgstr "Se não vai comprar porra nenhuma aqui, rala daqui!"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_a56f9613"
msgid "Je vais prendre un café !"
msgstr "Vou querer um café!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_eb611ae4"
msgid "Tsss..."
msgstr "Tsss..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_97dfaa4f"
msgid "Ne discutez pas avec les employés, cher monsieur."
msgstr "Não fique de conversinha com os funcionários, meu caro senhor."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_d4a3194e"
msgid "Je suis désolé mon chéri que tu aies à subir ça..."
msgstr "Me desculpe, querido, por você ter que passar por isso..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_735ceb80"
msgid "C'est plutôt moi qui suis désolé pour toi."
msgstr "Quem sente muito por você sou eu."

#. Character:`notice`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "t79d4b83921"
msgid "Vous avez donné 300¥ à {{yasuka.n}}."
msgstr "Você pagou ¥300 para a {{yasuka.n}}."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_e1dc171a"
msgid "Voici ton café !"
msgstr "Aqui está o seu café!"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_476718be"
msgid "Je te l'offre, tu en as bien plus besoin que moi visiblement."
msgstr "Pode ficar com ele, pelo visto você está precisando bem mais do que eu."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_efe971a9"
msgid "Tu es un amour."
msgstr "Você é um amorzinho."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_c27b4bc0"
msgid "Bon courage et à ce soir !"
msgstr "Bom trabalho e até hoje à noite!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_9d7413e7"
msgid "À ce soir, mon chéri."
msgstr "Até hoje à noite, querido."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_fc7ebca9"
msgid "Mais je voulais juste..."
msgstr "Mas eu só queria..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_9f305ee3"
msgid "Juste quoi ? Draguer le personnel ?"
msgstr "Só queria o quê? Ficar dando em cima da funcionária?"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_5ba836a8"
msgid "Elle est tellement âgée qu'elle pourrait être ta grand-mère !"
msgstr "Ela é tão velha que podia muito bem ser a sua avó!"

#. Character:`saito` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_971972aa"
msgid "Hey ! Je vous interdis de l'insulter comme ça !"
msgstr "Ei! Eu proíbo você de insultar ela desse jeito!"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_a9ad3e2c"
msgid "Sinon quoi ? Tu vas faire quoi microbe ?"
msgstr "Se não o quê? Vai fazer o que, seu merdinha?"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_1a0d491c"
msgid "TIRE-TOI OU J'APPELLE LA POLICE !"
msgstr "CAI FORA DAQUI OU EU CHAMO A POLÍCIA!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_ce85d5fe"
msgid "ET TOI RETOURNE BOSSER AU LIEU DE NE RIEN BRANLER !"
msgstr "E VOCÊ, VOLTA JÁ PRO TRABALHO EM VEZ DE FICAR ENROLANDO!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_9e283ba0"
msgid "Mon chéri !"
msgstr "Querido!"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_a6a19710"
msgid "Enfin..."
msgstr "Até que enfim..."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_07345f96"
msgid "Si tu savais tous les stratagèmes qu'il a fallu mettre en place pour juste venir te voir."
msgstr "Se você soubesse o malabarismo que eu tive que fazer só para conseguir vir te ver."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_f7e890a6"
msgid "Je suis désolée mon patron est vraiment sévère."
msgstr "Me desculpe, o meu patrão é realmente muito carrasco."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_af18c771"
msgid "Tu n'as pas à t'excuser, c'est lui qui est en tort."
msgstr "Você não tem que pedir desculpas, ele é quem está totalmente errado."

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_2321f311"
msgid "Tu as le droit de prendre une pause."
msgstr "Você tem todo o direito de tirar uma pausa."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_64486282"
msgid "Je sais... Tu as raison."
msgstr "Eu sei... você tem razão."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_d2f082b8"
msgid "Il n'y a pas de client en ce moment hormis toi."
msgstr "Não tem nenhum cliente aqui agora além de você."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_52b6b773"
msgid "Je pense que ça ne dérangera personne."
msgstr "Acho que não vai incomodar ninguém."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_9dd91079"
msgid "Tu sais..."
msgstr "Sabe de uma coisa..."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_344ff72e"
msgid "Je trouve que tu as vraiment changé ces temps-ci."
msgstr "Acho que você mudou bastante ultimamente."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_310e68bc"
msgid "Je pensais que c'était juste une passade, mais tu as vraiment l'air sérieux dans tes efforts."
msgstr "Eu pensei que fosse só uma fase, mas você parece estar realmente falando sério no seu esforço."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_658f9829"
msgid "Merci."
msgstr "Obrigado."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_9fabf88c"
msgid "Je ne pouvais plus te laisser seule, porter sur ton dos tous les problèmes que nous avions à la maison."
msgstr "Eu não podia mais te deixar sozinha, carregando nas costas todos os problemas que a gente tinha em casa."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_21bf1c4b"
msgid "Surtout que, je suis en âge de comprendre ce qu'il se passe..."
msgstr "Ainda mais que eu já tenho idade para entender muito bem o que está acontecendo..."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_00a019d4"
msgid "Mon Dieu, les enfants grandissent si vite."
msgstr "Meu Deus, os filhos crescem rápido demais."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_ada98003"
msgid "Un jour, ils sont là à pleurer dans nos jambes."
msgstr "Um dia desses você estava chorando e se agarrando nas minhas pernas."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_f4b4a2b7"
msgid "Et aujourd'hui te voilà prêt à m'aider à rembourser une montagne de dette."
msgstr "E hoje, olha só para você, pronto para me ajudar a pagar uma montanha de dívidas."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_d6eee7aa"
msgid "Je suis désolé d'avoir mis autant de temps à réaliser tout ça..."
msgstr "Me desculpe por ter demorado tanto tempo para cair na real sobre tudo isso..."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_e6413ebd"
msgid "J'aurais dû m'en rendre bien plus tôt."
msgstr "Eu deveria ter percebido bem antes."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_7f708522"
msgid "{{saito.n}} !"
msgstr "{{saito.n}}!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_120e8a66"
msgid "Je t'interdis de penser ça !"
msgstr "Eu proíbo você de pensar uma coisa dessas!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_e9e491a3"
msgid "Je voulais que tu puisses grandir avec {{noriko.n}} normalement."
msgstr "Eu queria que você pudesse crescer com a {{noriko.n}} de forma normal."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_bcbcc830"
msgid "À aucun moment, je n'aurais voulu vous imposer ça."
msgstr "Em momento algum eu quis empurrar esse fardo para vocês."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_2c652546"
msgid "Je comprends..."
msgstr "Eu entendo..."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_15a1bceb"
msgid "D'ailleurs, à ce sujet..."
msgstr "Aliás, falando nisso..."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_f1b983f3"
msgid "J'ai enfin réussi à décrocher un tr-"
msgstr "Eu finalmente consegui um traba-"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_0a7e69d0"
msgid "Je peux savoir ce qui se passe ici ?!"
msgstr "Dá para saber o que está acontecendo aqui?!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_4c17d2d2"
msgid "{{yasuka.n}}, je ne vous paye pas pour faire la causette aux clients ! Vous vous croyez dans un bar à hôtesses ?"
msgstr "{{yasuka.n}}, eu não te pago para ficar de papinho com cliente! Você por acaso acha que está num clube de acompanhantes?"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_72c2ae27"
msgid "Ce n'est pas la première fois que je te vois ici gamin !"
msgstr "Não é a primeira vez que eu te vejo por aqui, moleque!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_3c3fc224"
msgid "C'est qui cette femme pour toi ?!"
msgstr "Quem diabo essa mulher é para você?!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_759f70dc"
msgid "Vu que tu passes ton temps à revenir sans cesse pour mon employée."
msgstr "Já que você passa a vida voltando aqui sem parar por causa da minha funcionária..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_b7ec8004"
msgid "Ça me regarde."
msgstr "Então é da minha conta sim."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "tdce6f79343"
msgid "Ça ne vous regarde absolument pas !"
msgstr "Isso não é da sua conta!"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_424e960b"
msgid "Ne dis pas n'importe quoi !"
msgstr "Não me venha com mentiras!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_e27cd766"
msgid "Pour qu'elle soit ta mère, il faudrait qu'elle t'ait eu à genre 16 ans..."
msgstr "Para ela ser a sua mãe, teria que ter te parido com uns dezesseis anos..."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "tde8d9d429e"
msgid "Ma mère !"
msgstr "É a minha mãe!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_665e2b8b"
msgid "Quoi ?!"
msgstr "O quê?!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_9ccff65b"
msgid "Arrête de jouer au malin et va-t'en d'ici avant que je n'appelle la police !"
msgstr "Para de palhaçada e cai fora daqui antes que eu chame a polícia!"

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "tc900499874"
msgid "La femme de ma vie !"
msgstr "A mulher da minha vida!"

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_8005452d"
msgid "Merde, ce connard me bloque, peu importe ce que je dise."
msgstr "Merda, esse escroto me corta não importa o que eu responda."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_185adc22"
msgid "Comment je pourrais m'en débarrasser ?"
msgstr "Como é que eu posso me livrar dele?"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_8368a022"
msgid "Dites-moi {{yasuka.n}}..."
msgstr "Me diga uma coisa, {{yasuka.n}}..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_9d2bd2e7"
msgid "J'ai entendu votre conversation tout à l'heure."
msgstr "Eu ouvi a conversa de vocês agora há pouco."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_ceeccbbb"
msgid "Je ne savais pas que vous étiez endettée."
msgstr "Eu não fazia ideia de que você estava atolada em dívidas."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_ae713cd0"
msgid "..."
msgstr "..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_7e4f83cc"
msgid "Vous savez bien que vous pouvez tout me dire."
msgstr "Você sabe muito bem que pode se abrir comigo para tudo."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_f0f21b2a"
msgid "Je suis désolée, mais ce n'est pas quelque chose dont j'aime me vanter."
msgstr "Sinto muito, mas não é o tipo de assunto de que eu goste de ficar falando."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_31f8cf8d"
msgid "Ne vous en faites pas... Je vais y réfléchir, je suis sûr que je trouverai un moyen de vous aider."
msgstr "Não esquente a cabeça... Eu vou dar uma pensada nisso, tenho certeza de que vou achar um jeito de te ajudar."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_df5f3f1d"
msgid "Merci, mais je ne veux pas de..."
msgstr "Obrigada, mas eu não quero incomodar..."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_f317d5ec"
msgid "J'insiste, je ne voudrais pas que ma meilleure employée finisse sur le trottoir."
msgstr "Faço questão, eu não gostaria nem um pouco de ver a minha melhor funcionária acabasse na rua."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_e7bdf7e2"
msgid "Je vous laisse avec votre... lui."
msgstr "Vou deixar você a sós com o seu... carinha aí."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "tee9d2a10d2"
msgid "Je vous laisse avec votre... fils."
msgstr "Vou deixar você a sós com o seu... filhinho."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "td13ff2e22e"
msgid "Je vous laisse avec votre... partenaire."
msgstr "Vou deixar você a sós com o seu... parceiro."

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_d0babdf7"
msgid "Je suis désolé... Je voulais venir te soutenir et je crois que j'ai tout gâché."
msgstr "Me desculpe... Eu vim para te dar uma força e acho que acabei estragando tudo."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_bce09a57"
msgid "Ne t'inquiète pas pour ça. Le fait de savoir que je suis soutenu par un garçon aussi gentil me suffit."
msgstr "Não se preocupe com isso. Só de saber que eu tenho o apoio de um menino tão bom quanto você já é o bastante para mim."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_add43a5d"
msgid "Rentre à la maison, on en discutera quand j'aurai terminé ma journée."
msgstr "Vá para casa, a gente conversa com calma quando eu terminar o meu turno."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_b4be6f6a"
msgid "Personne à l'intérieur non plus, c'est vraiment étrange."
msgstr "Ninguém aqui dentro também, que negócio estranho."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_76e8e484"
msgid "Il a dû se passer un truc cette nuit."
msgstr "Deve ter acontecido alguma coisa esta noite."

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_019f200a"
msgid "Bonjour {{saito.n}} !"
msgstr "Bom dia, {{saito.n}}!"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_52e8a705"
msgid "{{sakuya.n}}... C'était bien toi !"
msgstr "{{sakuya.n}}... Era mesmo você!"

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_454dc301"
msgid "Tu es surpris ?"
msgstr "Está surpreso?"

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_59acee05"
msgid "Le mot est faible..."
msgstr "Surpreso é eufemismo..."

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_a0f28b52"
msgid "Tu avais des doutes ?"
msgstr "Você tinha dúvidas?"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_c41469da"
msgid "Je n'ai raconté tous mes problèmes qu'à une seule personne."
msgstr "Eu só contei os meus problemas para uma única pessoa."

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_ef90dbbb"
msgid "Et cette personne, c'était moi."
msgstr "E essa pessoa era eu."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_7648545e"
msgid "Que lui est-il arrivé ?"
msgstr "O que aconteceu com ele?"

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_6d81239f"
msgid "Oh, lui ? Il est toujours vivant."
msgstr "Ah, ele? Ainda está vivo."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_c2ee4dc9"
msgid "Il me reste deux ou trois choses à régler et toute cette histoire sera derrière nous."
msgstr "Ainda me restam duas ou três coisas para resolver e toda essa história vai ficar para trás."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_0cbce7c2"
msgid "Mais bordel, comme si j'avais pas assez de problèmes comme ça, je me retrouve à devoir gérer une folle."
msgstr "Mas que caralho, como se eu já não tivesse problemas suficientes, agora ainda tenho que lidar com uma maluca."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_536f0964"
msgid "Je savais que tout ça se passait trop bien."
msgstr "Eu sabia que tudo isso estava bom demais para ser verdade."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_ba1262f9"
msgid "Il y aurait forcément un prix à payer tôt ou tard."
msgstr "Cedo ou tarde, haveria um preço a pagar."

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_4dcd7cbf"
msgid "Tu viens ?"
msgstr "Você vem?"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_68138ac2"
msgid "Où ça ?"
msgstr "Para onde?"

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_c771531c"
msgid "Tu es bête ! Ton service va bientôt commencer, tu ne voudrais pas arriver en retard, non ?"
msgstr "Não seja bobo! O seu turno já vai começar, você não vai querer chegar atrasado, vai?"

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_169816be"
msgid "Je... Non en effet."
msgstr "Eu... Não, claro que não."

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_73d89f9c"
msgid "Alors c'est parfait, allons-y ensemble !"
msgstr "Então perfeito, vamos juntos!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_062ace96"
msgid "Bonjour mon chéri !"
msgstr "Bom dia, querido!"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_dcfbfbe3"
msgid "Je constate que tu n'as pas perdu de temps."
msgstr "Estou vendo que você não perdeu tempo."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_cd56f517"
msgid "Je ne supportais plus de rester là à ne rien faire."
msgstr "Eu não aguentava mais ficar lá parada sem fazer nada."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_4497dc2c"
msgid "Tu t'es occupé de tous mes problèmes, tu as été formidable."
msgstr "Você resolveu todos os meus problemas, você foi incrível."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_b9c66c77"
msgid "Je ne pourrais jamais assez te remercier."
msgstr "Eu nunca vou conseguir te agradecer o bastante."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_b9c9f2f8"
msgid "Tu n'as pas besoins de me remercier, mais..."
msgstr "Você não precisa me agradecer, mas..."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_5f7ace04"
msgid "Si tu insistes, je peux..."
msgstr "Se você faz tanta questão, eu posso..."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_fcf81914"
msgid "Shhh, n'en dis pas plus ! J'ai compris."
msgstr "Shiiiu, não diga mais nada! Já entendi."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_85085b88"
msgid "Retrouve-moi à la maison en fin de journée, je m'occuperais de toi."
msgstr "Me encontra em casa no fim do dia, eu vou cuidar de você."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_780a890f"
msgid "Avec plaisir alors, à ce soir !"
msgstr "Com todo prazer então, até a noite!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_41499d63"
msgid "J'ai hâte d'y être, ce soir mon chéri !"
msgstr "Mal posso esperar, até a noite, querido!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_d3f41477"
msgid "Gamin, j'espère que tu as de quoi commander, sinon tu peux ressortir tout de suite."
msgstr "Moleque, espero que você tenha dinheiro para pedir alguma coisa, senão pode dar meia-volta agora mesmo."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_f4f2b1e5"
msgid "{{yasuka.n}} m'a prévenu que son patron était un gros connard."
msgstr "A {{yasuka.n}} me avisou que o patrão dela era um tremendo de um cuzão."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_ced09ecf"
msgid "J'espère juste qu'elle l'a surestimée."
msgstr "Só espero que ela tenha exagerado."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_c5322b67"
msgid "Je ne sais pas s'il sera sensible à mes problèmes."
msgstr "Não sei se ele vai dar a mínima para os meus problemas."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_19c8916a"
msgid "Mais j'ai comme un gros doute."
msgstr "Mas estou com um baita pressentimento ruim."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_15e7b9f7"
msgid "Dépêche-toi, je n'ai pas que ça à faire !"
msgstr "Anda logo, eu não tenho o dia todo!"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_6dddebf6"
msgid "Oui, j'aimerais commander s'il vous plait."
msgstr "Sim, eu gostaria de fazer um pedido, por favor."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_1095df51"
msgid "Tchh"
msgstr "Tchh."

#. Character:`centered`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_1cd11301"
msgid "{{saito.n}} s'installa sur une banquette et passa la journée à attendre."
msgstr "{{saito.n}} se acomodou em um sofá e passou o dia inteiro esperando."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_31d77837"
msgid "Bon, je vais fermer, c'est le moment pour toi de partir."
msgstr "Bom, eu vou fechar, já passou da hora de você cair fora."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_cd8861e5"
msgid "Merde ! Ils sont encore là à m'attendre."
msgstr "Merda! Eles ainda estão lá fora me esperando."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_64067c20"
msgid "Je sais pas comment je vais me tirer de ce mauvais pas."
msgstr "Não sei como vou me livrar dessa enrascada."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_678fa7b8"
msgid "Ils sont décidés à vouloir ma peau."
msgstr "Eles estão decididos a acabar com a minha raça."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_16eef316"
msgid "Il me faut une idée brillante."
msgstr "Preciso de uma ideia genial."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_f17e1fde"
msgid "Il me semblait qu'avant, il y avait une femme qui travaillait ici."
msgstr "Eu tinha a impressão de que antes havia uma mulher que trabalhava aqui."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_a2a9adcd"
msgid "Ce n'est plus le cas ?"
msgstr "Não é mais o caso?"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_43aac03c"
msgid "Qu'est-ce que ça peut te faire ? Cette foutue ingrate a démissionné, maintenant, je me tape tout le boulot."
msgstr "O que você tem a ver com isso? Aquela ingrata de merda pediu as contas, agora eu tenho que aguentar todo o trabalho sozinho."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_bea2a22f"
msgid "Oula doucement, je ne cherche pas les problèmes."
msgstr "Calma lá, não estou procurando encrenca."

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_c6b40686"
msgid "Vous cherchez quelqu'un pour la remplacer ?"
msgstr "O senhor está procurando alguém para o lugar dela?"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_63dccf2a"
msgid "...Toi ?"
msgstr "...Você?"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_728cbd2a"
msgid "Me fait pas rire !"
msgstr "Não me faça rir!"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_356148b6"
msgid "Allez tire toi !"
msgstr "Vamos, rala daqui!"

#. Character:`nobu`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_2f904ecf"
msgid "[font_size=14]{{saito.n}}, c'est l'heure ! Arrête de faire durer le plaisir ![/font_size]"
msgstr "[font_size=14]{{saito.n}}, chegou a hora! Para de enrolar![/font_size]"

#. Character:`takeo`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_7a9476be"
msgid "[font_size=14]C'est juste un très mauvais moment à passer.[/font_size]"
msgstr "[font_size=14]Vai ser só um momento bem ruim, relaxa.[/font_size]"

#. Character:`kenji`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_56ec7904"
msgid "[font_size=14]{{akira.n}} a très envie de discuter avec toi, crois-moi, t'as pas envie de le faire attendre.[/font_size]"
msgstr "[font_size=14]O {{akira.n}} está louco para trocar uma ideia com você, e vai por mim, você não vai querer deixar ele esperando.[/font_size]"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_12e2ae94"
msgid "Je crois bien que quelqu'un va passer un sale moment."
msgstr "Pelo visto, alguém vai levar uma surra daquelas."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_9d8abc0f"
msgid "...Vous ne comptez pas m'aider ?"
msgstr "...O senhor não vai me ajudar?"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_8fd8e5da"
msgid "T'aider ? Je vais fermer la boutique, rentrez chez moi et profiter de ma soirée."
msgstr "Te ajudar? Eu vou é fechar a loja, ir para casa e curtir a minha noite."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_749d6f39"
msgid "Ce qui peut t'arriver, je n'en ai rien à branler."
msgstr "Eu estou pouco me fodendo para o que quer que acontecer com você."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_568d4ce8"
msgid "MAINTENANT DÉGAGE !"
msgstr "AGORA DA O FORA!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_a6c7a572"
msgid "Qu'est-ce que tu veux ?"
msgstr "O que você quer?"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_c6ad8508"
msgid "Je voulais vous remercier pour hier soir, sans vous, je ne sais pas si je serais encore là aujourd'hui."
msgstr "Eu queria agradecer o senhor por ontem à noite, se não fosse pelo senhor, não sei se estaria aqui hoje."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_87111c4f"
msgid "Je l'ai pas fait pour toi."
msgstr "Eu não fiz aquilo por você."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_662878fa"
msgid "Allez, tire-toi de là, j'ai du travail qui m'attend."
msgstr "Agora vamos, rala daqui, tenho trabalho me esperando."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_6537e934"
msgid "Attendez... J'aimerais avoir une copie de l'enregistrement s'il vous plait."
msgstr "Espere... Eu queria uma cópia da gravação, por favor."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_009117d1"
msgid "De quoi ?"
msgstr "Do quê?"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_0432d5ff"
msgid "L'enregistrement que vous avez réalisé hier soir !"
msgstr "Da gravação que o senhor fez ontem à noite!"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_20e217e3"
msgid "Aaaah ça, c'était du bluff ! Je n'avais rien du tout."
msgstr "Aaaah aquilo? Era blefe! Eu não tinha gravação nenhuma."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_6de8c182"
msgid "Vous plaisantez ?"
msgstr "O senhor está brincando?"

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_fd83b488"
msgid "Pourquoi j'ai la sensation qu'il se fout de ma gueule ?"
msgstr "Por que eu sinto que ele está tirando uma com a minha cara?"

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_330317d5"
msgid "Ce gars ment comme il respire."
msgstr "Esse cara mente sem nem piscar."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_98901fe8"
msgid "Il n'a jamais eu l'envie de m'aider."
msgstr "Ele nunca teve a menor intenção de me ajudar."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_75d63c26"
msgid "Jamais ! Maintenant casse-toi, tu commences à me gonfler !"
msgstr "Nunca! Agora some daqui, você já está começando a me torrar a paciência!"

#. Character:`netoru` | Attributes:`-angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_cda7fafe"
msgid "Je suis en train de vendre la boutique."
msgstr "Estou no meio da venda da loja."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_d06b2774"
msgid "Et je ne veux pas de mioches dans les pattes quand les acheteurs vont venir."
msgstr "E não quero nenhum moleque atrapalhando quando os compradores chegarem."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_0f29888d"
msgid "Vous vendez ? C'est à cause des menaces de l'autre jour ?"
msgstr "Você está vendendo? É por causa das ameaças do outro dia?"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_c980052b"
msgid "Gamin, la personne qui pourra me menacer n'est pas encore née, crois-moi."
msgstr "Moleque, a pessoa que vai conseguir me ameaçar ainda nem nasceu, pode acreditar."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_6527c470"
msgid "Je vends, car je ne veux plus m'encombrer de cette boutique."
msgstr "Estou vendendo porque não quero mais me estressar com essa loja."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_85a516d1"
msgid "Et surtout, j'ai de quoi tenir jusqu'à la fin de ma vie sans travailler."
msgstr "E, acima de tudo, eu tenho grana para viver o resto da minha vida sem precisar trabalhar."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_dbe81c42"
msgid "Et puis j'ai des projets plus intéressants..."
msgstr "Além do mais, tenho projetos bem mais interessantes em mente..."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "coffeebar_interior_632b7121"
msgid "Allez dégage d'ici !"
msgstr "Anda, dá o fora daqui!"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_COMPRENDS_MIEUX_POURQUOI_TU_B831A8"
msgid "Je comprends mieux pourquoi tu ne voulais pas revenir travailler ici."
msgstr "Agora eu entendo perfeitamente por que você não queria voltar a trabalhar aqui."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "CE_TYPE_EST_UN_ENFOIR_6D8537"
msgid "Ce type est un enfoiré !"
msgstr "Esse cara é um baita de um escroto!"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SHHHHHT_SI_JAMAIS_IL_T_ENTEND_EECF82"
msgid "Shhhhht ! Si jamais il t'entend parler de lui comme ça tu vas avoir des problèmes !"
msgstr "Shiiiu! Se ele te escuta falar dele desse jeito, você vai arrumar problemas!"

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "IL_M_A_LITT_RALEMENT_INSULT_SA_DB7B64"
msgid "Il m'a littéralement insulté sans vergogne."
msgstr "Ele literalmente me insultou sem a menor vergonha na cara."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_VAIS_TOUT_DE_SUITE_LUI_EXP_4E3E28"
msgid "... Je vais tout de suite lui expliquer qu'il ne peut pas faire ça, surtout pas avec toi !"
msgstr "...Eu vou agora mesmo falar para ele que ele não pode fazer isso, muito menos com você!"

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "NON_OUBLIE_JE_NE_VEUX_PAS_TE_C_E1FA4D"
msgid "Non, oublie, je ne veux pas te compliquer davantage la situation."
msgstr "Não, deixa para lá, não quero complicar ainda mais a sua situação."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MAIS_IL_T_A_1F9ACD"
msgid "Mais il t'a..."
msgstr "Mas ele te..."

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "A_IRA_TOUT_VA_BIEN_NORIKO_N_E_F81769"
msgid "Ça ira, tout va bien, {{noriko.n}} est bien plus sévère avec moi. Dis-moi plutôt, il est tout le temps comme ça ?"
msgstr "Vai dar tudo certo, está de boa, a {{noriko.n}} é bem mais carrasca comigo. Me diz uma coisa, ele é assim o tempo todo?"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OUI_IL_PASSE_SA_JOURN_E_EN_TER_601A24"
msgid "Oui... Il passe sa journée en terrasse à faire fuir les gens."
msgstr "Sim... Ele passa o dia inteiro na calçada espantando os clientes."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ME_REFOURGUER_TOUTES_LES_T_CH_37A51A"
msgid "À me refourguer toutes les tâches ingrates de la boutique."
msgstr "E empurrando todas as tarefas ingratas da loja para mim."

#. Character:`narrator` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_DONC_CETTE_ESP_CE_D_ORDU_9993A2"
msgid "C'est donc cette espèce d'ordure qui pourrit la vie de {{yasuka.n}}."
msgstr "Então é esse tipo de lixo que fica infernizando a vida da {{yasuka.n}}."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "CE_MEC_N_EN_A_PAS_SEULEMENT_L_C07A8D"
msgid "Ce mec n'en a pas seulement l'air, c'est un véritable connard."
msgstr "Esse cara não parece ser só um cuzão, ele é um verdadeiro verme."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MON_INSTINCT_NE_M_A_PAS_TROMP_7FA285"
msgid "Mon instinct ne m'a pas trompé."
msgstr "O meu instinto não falhou."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "YASUKA_N_JE_NE_TE_PAIE_PAS_PO_F40491"
msgid "{{yasuka.n}} !! Je ne te paie pas pour faire du charme aux clients !"
msgstr "{{yasuka.n}}!! Eu não te pago para ficar de frescura com os clientes!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_D_DUIRAI_LE_TEMPS_QUE_TU_PA_4944B4"
msgid "Je déduirai le temps que tu passes à discuter avec les gens de ton salaire."
msgstr "Vou descontar do seu salário esse tempo que você passa de conversinha fiada."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "QUOI_MAIS_IL_A_PAS_LE_DROIT_DE_F4C38D"
msgid "Quoi ?! Mais il a pas le droit de faire ça !"
msgstr "O quê?! Mas ele não tem o direito de fazer isso!"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ET_VOUS_VOUS_AVEZ_PASS_COMMAND_6A4042"
msgid "Et vous ?! Vous avez passé commande ou vous êtes là pour jouer au touriste ?"
msgstr "E você?! Já fez o seu pedido ou está aqui só para fazer hora?"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PARCE_QUE_SI_C_EST_LE_SECOND_C_914727"
msgid "Parce que si c'est le second cas c'est moi qui vous mettrai à la porte !"
msgstr "Porque se for a segunda opção, sou eu quem vai te botar para rua!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_SUIS_D_SOL_E_MON_CH_RI_QUE_CDD8AC"
msgid "Je suis désolée, mon chéri, que tu aies à subir ça..."
msgstr "Me desculpe, querido, por você ter que passar por isso..."

#. Character:`notice`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VOUS_AVEZ_DONN_300_YASUKA_4DFD82"
msgid "Vous avez donné 300¥ à {{yasuka.n}}."
msgstr "Você pagou ¥300 para a {{yasuka.n}}."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SINON_QUOI_TU_VAS_FAIRE_QUOI_M_BAB138"
msgid "Sinon quoi ? Tu vas faire quoi, microbe ?"
msgstr "Se não o quê? Vai fazer o que, seu merdinha?"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "YASUKA_N_PRENEZ_UNE_PAUSE_ET_D7595E"
msgid "{{yasuka.n}} prenez une pause et venez discuter avec moi."
msgstr "{{yasuka.n}}, tire um momento para respirar e venha conversar comigo."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AI_BIEN_VU_QUE_QUELQUE_CHOSE_EEF98B"
msgid "J'ai bien vu que quelque chose n'allait pas ce matin et j'aimerais comprendre."
msgstr "Eu notei perfeitamente que algo não estava legal esta manhã e gostaria de entender o motivo."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SI_L_UNE_DE_MES_EMPLOY_E_N_AS_7C7A72"
msgid "Si l'une de mes employée n'as pas le moral les clients vont finir par penser que je vous maltraite !"
msgstr "Se uma das minhas funcionárias fica desanimada, os clientes vão acabar achando que eu maltrato vocês!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_SUIS_D_SOL_E_MONSIEUR_MAIS_1D00ED"
msgid "Je suis désolée Monsieur mais c'est que... Je n'ai pas envie de vous embêter avec mes problèmes."
msgstr "Me desculpe, senhor, mas é que... eu não queria te alugar com os meus problemas."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_INSISTE_EN_PARLER_VOUS_FERA_5CCD6A"
msgid "J'insiste... En parler vous fera du bien !"
msgstr "Eu faço questão... Desabafar vai te fazer bem!"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_COMPREND_MERCI_MONSIEUR_MAI_FF8058"
msgid "Je comprend, merci Monsieur mais ça reste assez personnel et..."
msgstr "Eu entendo e agradeço, senhor, mas é um assunto bastante pessoal e..."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "YASUKA_N_J_ATTEND_DE_MES_EMPL_299907"
msgid "{{yasuka.n}} ! J'attends de mes employés qu'ils soient investis à 100% dans leur travail et ce n'est visiblement pas le cas !"
msgstr "{{yasuka.n}}! Eu exijo que os meus funcionários estejam cem por cento focados no trabalho, e visivelmente não é o que está acontecendo!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SI_CE_QUI_VOUS_PR_OCCUPE_TANT_99D0EF"
msgid "Si ce qui vous préoccupe tant déteint sur votre travail ce n'est plus personnel !"
msgstr "Se o que está te preocupando tanto está afetando o seu serviço, então deixou de ser pessoal!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "RACONTEZ_MOI_21A336"
msgid "Racontez moi !"
msgstr "Pode me contar!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "W_TR_S_BIEN_800DD5"
msgid "...[w] Très bien..."
msgstr "...[w] Tudo bem..."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AI_DIT_DES_CHOSES_QUE_JE_REG_1B8388"
msgid "J'ai... dit des choses que je regrette à une personne que j'aime beaucoup et depuis j'ai l'impression que ça a crée une distance entre nous. J'ai l'impression que plus rien ne sera jamais comme avant."
msgstr "Eu... falei coisas que me arrependo para uma pessoa de quem gosto muito, e desde então sinto que isso criou uma distância entre nós. Tenho a impressão de que nada mais vai ser como antes."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_NE_SAVAIS_PAS_QUE_VOUS_AVIE_928DB8"
msgid "Je ne savais pas que vous aviez quelqu'un dans votre vie..."
msgstr "Eu não sabia que você tinha alguém na sua vida..."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "QUOI_OH_NON_JE_N_AI_PERSONNE_I_5FF780"
msgid "Quoi ?! Oh non, je n'ai personne, il s'agit d'un jeune garçon qui m'a été confié quand il était bien plus jeune et aujourd'hui c'est un adulte."
msgstr "O quê?! Oh, não, eu não tenho ninguém! É que se trata de um rapaz que foi deixado sob os meus cuidados quando era bem mais novo. Eu o tenho como um filho, e hoje ele já é um homem feito."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_VOIS_CA_ME_RASSURE_ET_QUEL_537595"
msgid "Je vois.. Ça me rassure... Et quelle était l'origine de cette dispute ?"
msgstr "Entendi... Isso me deixa mais tranquilo... E qual foi o motivo desse desentendimento?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_01112C"
msgid "Je...."
msgstr "Eu..."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OUI_308D25"
msgid "Oui ?"
msgstr "Sim?"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_DOIS_REPRENDRE_LE_TRAVAIL_N_DC3210"
msgid "Je dois reprendre le travail, nous avons des clients !"
msgstr "Eu preciso voltar ao trabalho, os clientes estão esperando!"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "BIEN_TOUT_N_EST_PAS_ROSE_DANS_733BCB"
msgid "Bien... tout n'est pas rose dans ce royaume... Pour une fois que je vois une brèche."
msgstr "Muito bem... então nem tudo são flores nessa família... Pela primeira vez, encontrei uma brecha."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "CA_SERAIT_DU_G_CHIS_DE_NE_PAS_13DEF6"
msgid "Ça serait du gâchis de ne pas en profiter."
msgstr "Seria um tremendo desperdício não tirar proveito disso."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MAIS_JE_DOIS_EN_SAVOIR_PLUS_FEB607"
msgid "Mais je dois en savoir plus !"
msgstr "Mas eu preciso arrancar mais detalhes!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "YASUKA_N_PRENEZ_VOTRE_PAUSE_E_A02AE6"
msgid "{{yasuka.n}} prenez votre pause et venez discuter un moment avec moi."
msgstr "{{yasuka.n}}, tire o seu momento de descanso e venha conversar um pouco comigo."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PRENEZ_GALEMENT_CE_QUI_VOUS_FA_755C70"
msgid "Prenez également ce qui vous fait plaisir, je vous l'offre."
msgstr "Pode pedir o que quiser do cardápio, é por minha conta."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VRAIMENT_C_EST_TELLEMENT_GENTI_1170FB"
msgid "Vraiment ?! C'est tellement gentil à vous Monsieur. Merci."
msgstr "Sério?! Isso é muita gentileza da sua parte, senhor. Obrigada."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "REPRENONS_NOTRE_DISCUSSION_D_H_2BB82B"
msgid "Reprenons notre discussion d'hier si vous le voulez bien."
msgstr "Vamos retomar a nossa conversa de ontem, se você não se importar."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MAIS_JE_1AB875"
msgid "Mais je..."
msgstr "Mas eu..."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_INSISTE_DEA1D7"
msgid "J'insiste !"
msgstr "Eu faço questão!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "TR_S_BIEN_88284D"
msgid "Très bien..."
msgstr "Tudo bem..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "HIER_VOUS_AVIEZ_PARL_D_UN_FARD_AEE1FB"
msgid "Hier vous aviez parlé d'un fardeau, j'aimerais en connaître l'origine."
msgstr "Ontem você mencionou um grande fardo, eu gostaria de saber qual é a origem dele."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_QUE_C_EST_ASSEZ_PERSONNE_82AD38"
msgid "C'est que... c'est assez personnel vous savez..."
msgstr "É que... é um assunto muito íntimo, sabe..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "YASUKA_N_JE_VOUS_L_AI_D_J_R_P_CE415A"
msgid "{{yasuka.n}} je vous l'ai déjà répété plusieurs fois, si l'un des employés n'est pas au top, c'est le service qui en pâtira."
msgstr "{{yasuka.n}}, eu já te repeti isso várias vezes: se alguém da equipe não estiver bem, o atendimento vai lá para baixo."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_PENSAIS_SINC_REMENT_QUE_NOU_A656F3"
msgid "Je pensais sincèrement que nous avions franchi un cap hier et que vous pouviez vous confier à moi sans crainte."
msgstr "Eu sinceramente achei que nós tivéssemos quebrado o gelo ontem e que você pudesse se abrir comigo sem medo."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PEUT_TRE_QUE_JE_ME_TROMPAIS_FI_AB4FCA"
msgid "Peut-être que je me trompais finalement..."
msgstr "Pelo visto, eu estava redondamente enganado..."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ATTENDEZ_DE81AE"
msgid "Attendez..."
msgstr "Espere..."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_UNE_HISTOIRE_DE_DETTES_J_6B68BC"
msgid "C'est une histoire de dettes. J'ai énormément de dettes."
msgstr "É uma história de dívidas. Eu tenho uma quantidade imensa de dívidas."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_COMPRENDS_PR_SENT_MAIS_NE_V_DFEC6C"
msgid "Je comprends à présent... Mais ne vous en faites pas, je suis aussi passé par là par le passé et je m'en suis sorti."
msgstr "Agora eu compreendo... Mas não fique sofrendo por antecipação, eu também passei por uma situação parecida no passado e consegui dar a volta por cima."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VRAIMENT_2FAD55"
msgid "Vraiment ?!"
msgstr "Sério?!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "BIEN_S_R_ET_J_AI_R_USSI_REBOND_A4D76D"
msgid "Bien sûr ! Et j'ai réussi à rebondir comme vous pouvez le constater !"
msgstr "Com certeza! E consegui me reerguer muito bem, como você mesma pode notar!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_INCROYABLE_4C3615"
msgid "... C'est incroyable."
msgstr "... Isso é incrível."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PR_SENT_RACONTEZ_MOI_COMMENT_DB0C92"
msgid "À présent, racontez-moi comment vous en êtes arrivée là."
msgstr "Agora me conte, como foi que você acabou se enfiando nisso?"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AI_VRAIMENT_HONTE_D_EN_PARLE_11687B"
msgid "J'ai vraiment honte d'en parler vous savez."
msgstr "Eu tenho muita vergonha de falar sobre isso, sabe."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "IL_NE_FAUT_PAS_PARFOIS_IL_FAUT_36CE28"
msgid "Il ne faut pas, parfois il faut savoir demander de l'aide. Et si je peux vous aider d'une quelconque manière je le ferai."
msgstr "Não deveria ter. Às vezes, a gente precisa ter a humildade de pedir ajuda. E se houver qualquer coisa que eu possa fazer para te apoiar, eu farei."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "A_REMONTE_AU_TEMPS_O_JE_SUIS_A5DDB5"
msgid "Ça remonte au temps où je suis tombée enceinte, je n'avais pas terminé mes études, je voulais pouvoir élever mon enfant dans un environnement sain..."
msgstr "Isso começou na época em que eu engravidei. Eu ainda não tinha terminado os meus estudos, mas queria poder criar a minha criança em um ambiente decente, na nossa própria casa..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_TOUT_VOTRE_HONNEUR_D2470F"
msgid "C'est tout à votre honneur."
msgstr "Uma atitude muito nobre da sua parte."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OUI_MAIS_J_TAIS_JEUNE_ET_J_AI_58D082"
msgid "Oui mais... j'étais jeune et j'ai emprunté à des taux bien trop élevés sans savoir ce que je faisais. Je n'y connaissais rien et je n'avais pas la tête à m'intéresser à ça à cette époque."
msgstr "Sim, mas... eu era muito jovem e acabei pegando dinheiro emprestado com taxas de juros abusivas, sem ter a menor noção do que estava fazendo. Eu não entendia nada disso e minha cabeça estava totalmente voltada para outras coisas na época."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_VOIS_CERTAINS_ORGANISMES_MA_8D09DA"
msgid "Je vois... Certains organismes mafieux font ça volontairement pour avoir des gens qui vont payer toute leur vie."
msgstr "Compreendo... Certas organizações criminosas fazem isso de propósito para prender a pessoa e fazê-la pagar pelo resto da vida."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "APR_S_A_UNE_ANCIENNE_CONNAISSA_30E622"
msgid "Après ça, une ancienne connaissance m'a confié son enfant avant de disparaître pour échapper à ses dettes lui aussi. Mais les personnes à qui il devait de l'argent se sont retournées vers moi et m'ont demandé des comptes. Rembourser deux prêts en même temps était impossible, j'ai dû faire racheter ma dette et comme aucune banque n'a voulu le faire j'ai dû me tourner vers des organismes plus... controversés..."
msgstr "Depois disso, um antigo conhecido me deixou o filho dele antes de sumir do mapa para escapar das próprias dívidas. Mas os agiotas para quem ele devia vieram atrás de mim exigindo que eu os pagasse para não levarem o meu menino. Dar conta de dois empréstimos ao mesmo tempo era impossível, então precisei renegociar o montante. Como nenhum banco aceitou a proposta, tive que recorrer a agências bem mais... perigosas..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "BON_SANG_YASUKA_N_VOUS_VOUS_TE_2866A8"
msgid "Bon sang {{yasuka.n}}, vous vous êtes mise dedans jusqu'au cou, je comprends à présent d'où vient cette pression que vous avez sur les épaules."
msgstr "Nossa, {{yasuka.n}}, você se enterrou até o pescoço. Agora eu entendo perfeitamente o tamanho desse peso que você carrega nas costas."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VOTRE_GENTILLESSE_VOUS_PERDRA_E62741"
msgid "Votre gentillesse vous perdra. Les gens autour de vous en ont abusé..."
msgstr "O seu coração mole ainda vai te destruir. As pessoas ao seu redor se aproveitaram da sua bondade..."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OUI_JE_SAIS_C_TAIT_IL_Y_A_LONG_04BB52"
msgid "Oui je sais... C'était il y a longtemps et ça ne se reproduira plus."
msgstr "Sim, eu sei... Mas isso faz muito tempo e não vai se repetir."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ACCEPTER_ET_PRENDRE_LA_CHARGE_CF4D81"
msgid "Accepter et prendre la charge de cet enfant vous a mise dans une situation délicate."
msgstr "Aceitar a responsabilidade por esse garoto acabou te colocando em uma situação terrível."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "IL_TAIT_SI_JEUNE_IL_AVAIT_D_J_05AAFA"
msgid "Il était si jeune, il avait déjà perdu sa mère et son père l'abandonnait littéralement. Que serait-il devenu si je ne m'étais pas occupée de lui ?"
msgstr "Ele era tão novinho, já tinha perdido a mãe e o pai simplesmente o abandonou. O que teria sido dele se eu não tivesse cuidado dele?"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PFFF_JE_COMPRENDS_PARFOIS_IMPO_575212"
msgid "Pfff... Je comprends, parfois impossible d'ignorer son cœur."
msgstr "Pfff... Eu entendo, às vezes é impossível ignorar o que o coração pede."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "EXACTEMENT_452344"
msgid "Exactement !"
msgstr "Exatamente!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ET_AUJOURD_HUI_COMBIEN_DEVEZ_V_2568AE"
msgid "Et aujourd'hui combien devez-vous rembourser ?"
msgstr "E hoje em dia, de quanto é esse rombo que você precisa quitar?"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ENVIRON_50M_C16065"
msgid "... Environ 50,000,000¥"
msgstr "... Cerca de cinquenta milhões de ienes."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_UNE_SACR_E_SOMME_JE_NE_V_7087A1"
msgid "C'est une sacrée somme... Je ne vous promets rien mais je vais essayer d'y réfléchir et de revenir vers vous avec une solution."
msgstr "É uma quantia absurda... Eu não posso te prometer nada, mas vou analisar a situação e tentar bolar uma saída para você."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OH_NE_VOUS_EMB_TEZ_PAS_AVEC_A_4BED51"
msgid "Oh ne vous embêtez pas avec ça, s'il vous plaît !"
msgstr "Ah, por favor, não se dê ao trabalho com isso!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AI_PAS_MAL_DE_TEMPS_LIBRE_DO_2F751D"
msgid "J'ai pas mal de temps libre donc autant utiliser ce temps de manière constructive."
msgstr "Eu ando com bastante tempo livre, então prefiro usar essas horas de uma forma útil."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_MERCI_INFINIMENT_MONSIEUR_D848E9"
msgid "Je... merci infiniment Monsieur."
msgstr "Eu... muito obrigada de verdade, senhor."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_VAIS_REPRENDRE_LE_TRAVAIL_P_90576E"
msgid "Je vais reprendre le travail à présent, je vous ai assez pris de votre temps."
msgstr "Agora vou voltar para o balcão, já tomei muito do seu tempo."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "LA_JOURN_E_EST_TERMIN_E_LAISSE_7EC330"
msgid "La journée est terminée, laissez-moi vous raccompagner chez vous pour une fois."
msgstr "O expediente acabou, deixe-me te acompanhar até em casa por esta vez."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OH_C_EST_TR_S_GENTIL_VOUS_MAIS_DD332C"
msgid "Oh c'est très gentil à vous mais ce n'est pas..."
msgstr "Oh, é muita gentileza sua, mas não precisa se..."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AI_CERTAINS_CONTACTS_DANS_LE_F73795"
msgid "J'ai certains contacts dans le milieu et en passant quelques coups de fil nous pourrons déjà faire baisser votre taux d'intérêt."
msgstr "Eu tenho alguns contatos influentes e, com alguns telefonemas, nós já conseguimos reduzir consideravelmente essas taxas de juros."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "A_VOUS_INT_RESSE_EF4A30"
msgid "Ça vous intéresse ?"
msgstr "Te interessa?"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "QUOI_VOUS_TES_S_R_VIDEMMENT_QU_77193E"
msgid "Quoi ?! Vous êtes sûr ? Évidemment que ça m'intéresse..."
msgstr "O quê?! O senhor está falando sério? É claro que me interessa..."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PARFAIT_DANS_CE_CAS_DISCUTONS_B71263"
msgid "Parfait, dans ce cas discutons-en sur le chemin car j'aurai besoin de quelques informations supplémentaires."
msgstr "Perfeito, então vamos conversando no caminho, porque vou precisar de mais algumas informações."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "D_ACCORD_DANS_CE_CAS_J_ACCEPTE_487017"
msgid "D'accord, dans ce cas j'accepte volontiers."
msgstr "Está bem, aceito de bom grado então."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_VOUS_EN_PRIE_PASSEZ_DEVANT_F91FCE"
msgid "Je vous en prie, passez devant."
msgstr "Por favor, pode ir na frente."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "BON_J_AI_R_FL_CHI_NORM_MENT_VO_EB5301"
msgid "Bon j'ai réfléchi énormément à votre situation et après avoir refait plusieurs fois les calculs je suis arrivé à un constat qui ne vous plaira probablement pas."
msgstr "Bom, eu estive pensando muito na sua situação e, após refazer os cálculos várias vezes, cheguei a uma conclusão que provavelmente não vai te agradar em nada."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_SI_MAUVAIS_QUE_A_D750CD"
msgid "C'est si mauvais que ça ?"
msgstr "A situação está tão ruim assim?"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_SERAI_HONN_TE_AVEC_VOUS_YAS_CA7A83"
msgid "Je serai honnête avec vous {{yasuka.n}} mais au vu des dépenses nécessaires pour maintenir votre train de vie et celui de votre foyer, l'éducation de votre fille et potentiellement celle du garçon que vous hébergez, la hauteur des intérêts fait que vous ne pourrez jamais rembourser à temps."
msgstr "Vou ser bem sincero com você, {{yasuka.n}}, mas diante das despesas necessárias para manter a sua casa, os estudos da sua filha e o sustento daquele rapaz que você abriga, o valor dos juros torna simplesmente impossível que você consiga quitar tudo a tempo."

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MON_DIEU_QU_EST_CE_QUE_JE_VAI_91FB2A"
msgid "... Mon dieu... Qu'est-ce que je vais faire ?"
msgstr "... Meu Deus... O que vai ser de mim?"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "CES_GENS_QUI_VOUS_AVEZ_EMPRUNT_7A2F4E"
msgid "Ces gens à qui vous avez emprunté de l'argent savaient très bien que vous ne pourriez jamais rembourser."
msgstr "Aquelas pessoas que te emprestaram o dinheiro sabiam perfeitamente que você nunca conseguiria pagar."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_PENSE_M_ME_QU_ILS_AVAIENT_D_D4C0BA"
msgid "Je pense même qu'ils avaient d'autres projets pour vous."
msgstr "Tenho certeza de que eles tinham segundas intenções com você desde o começo."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MAIS_C_EST_HORRIBLE_EST_CE_QUE_CD5656"
msgid "Mais c'est horrible ! Est-ce que tout ça n'est pas illégal ?!"
msgstr "Mas que horror! Tudo isso não é totalmente ilegal?!"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MALHEUREUSEMENT_LES_CONTRATS_S_1F4060"
msgid "Malheureusement les contrats signés sont difficilement contestables même devant la justice."
msgstr "Infelizmente, os contratos foram assinados e são quase impossíveis de anular, mesmo na justiça."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ET_CE_N_EST_PAS_LE_PIRE_F38EA0"
msgid "Et ce n'est pas le pire..."
msgstr "E esse não é o pior cenário..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SI_MES_CALCULS_SONT_BONS_ET_IL_9BFE5B"
msgid "Si mes calculs sont bons et ils le sont toujours, même si vous n'offrez pas d'études supérieures à votre fille et que vous vendez votre maison, vous devrez encore rembourser pendant des années..."
msgstr "Se as minhas contas estiverem certas — e elas nunca falham —, mesmo que você desista de dar uma faculdade para a sua filha e venda a sua casa, você ainda passaria anos pagando essa dívida..."

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_PENSAIS_QUE_SI_JE_FAISAIS_D_36C43E"
msgid "Je pensais que si je faisais de mon mieux cela suffirait..."
msgstr "Eu achei que se fizesse o meu máximo, seria o suficiente..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PARFOIS_M_ME_LES_MEILLEURES_IN_F6C8B6"
msgid "Parfois même les meilleures intentions ne suffisent pas."
msgstr "Às vezes, nem o maior dos esforços basta."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_VAIS_VOUS_LAISSER_R_FL_CHIR_0AD5EC"
msgid "Je vais vous laisser réfléchir à tout ça mais préparez-vous à faire des choix drastiques si vous voulez vous en sortir, quitte à mettre votre fierté de côté."
msgstr "Vou deixar você digerir tudo isso, mas prepare-se para tomar atitudes drásticas se quiser se salvar, mesmo que tenha que engolir o seu orgulho."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_VOUS_TIENS_AU_COURANT_J_AI_E44D21"
msgid "Je vous tiens au courant, j'ai quelques pistes que j'aimerais éclaircir mais ne vous inquiétez pas, je serai là pour vous aider."
msgstr "Eu vou te mantendo informada. Tenho algumas alternativas que quero investigar, mas não se preocupe, eu estarei aqui para te apoiar."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MERCI_MONSIEUR_6A2D45"
msgid "Merci Monsieur..."
msgstr "Obrigada, senhor..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MAIS_C_EST_TOUT_NATUREL_45E967"
msgid "Mais c'est tout naturel !"
msgstr "Imagine, não precisa agradecer!"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_CROIS_QUE_VOUS_NE_SEREZ_PAS_12BF0C"
msgid "Je crois que vous ne serez pas déçue, j'ai trouvé une solution pour régler tous vos problèmes en une seule fois !"
msgstr "Acho que você vai ficar radiante: eu encontrei uma saída para resolver todos os seus problemas de uma única vez!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VRAIMENT_UNE_TELLE_SOLUTION_EX_1798D1"
msgid "Vraiment ?! Une telle solution existe ?"
msgstr "Sério?! Uma saída dessas existe mesmo?"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ABSOLUMENT_IL_FAUDRA_Y_METTRE_511E3E"
msgid "Absolument ! Il faudra y mettre un peu du vôtre mais vous serez à jamais débarrassée de votre dette."
msgstr "Com certeza! Vai exigir um sacrifício da sua parte, mas você vai se livrar dessa dívida para sempre."

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_SUIS_PR_TE_FAIRE_CE_QU_IL_F_0D02FA"
msgid "Je suis prête à faire ce qu'il faudra pour m'en sortir, ne faites pas autant de mystère s'il vous plaît!"
msgstr "Eu estou disposta a fazer o que for preciso para sair dessa, por favor, não fique fazendo mistério!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "YASUKA_N_J_AIMERAIS_QUE_VOUS_2664EC"
msgid "{{yasuka.n}}... J'aimerais que vous compreniez que ça ne sera pas non plus une solution facile."
msgstr "{{yasuka.n}}... Eu preciso que você entenda que não vai ser uma escolha fácil."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AI_BESOIN_DE_SAVOIR_JUSQU_O_A62D47"
msgid "J'ai besoin de savoir jusqu'où vous serez prête à aller ?"
msgstr "Eu preciso saber: até onde você está disposta a ir?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SI_GR_CE_UN_SACRIFICE_MA_FAMIL_4330AE"
msgid "Si grâce à un sacrifice ma famille peut vivre dignement et se concentrer sur son avenir alors je serai la plus heureuse qui soit."
msgstr "Se através de um sacrifício a minha família puder viver de cabeça erguida e focar no futuro, eu serei a mulher mais feliz do mundo."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AI_FAIT_BIEN_TROP_DE_MAUVAIS_AEDD24"
msgid "J'ai fait bien trop de mauvais choix dans ma vie par le passé et je dois arrêter de me voiler la face."
msgstr "Eu já tomei muitas decisões erradas na vida e preciso parar de fugir da realidade."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_DOIS_ASSUMER_LES_CONS_QUENC_9D412F"
msgid "Je dois assumer les conséquences de mes actes, quitte à souffrir un peu. Mais mon confort passera toujours après eux..."
msgstr "Eu tenho que arcar com as consequências dos meus atos, mesmo que isso me custe caro. O bem-estar deles sempre virá antes do meu conforto..."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_TOUT_FAIT_ADMIRABLE_DE_V_E76DE1"
msgid "C'est tout à fait admirable de votre part... J'en suis ému, vraiment..."
msgstr "Uma atitude admirável... Fico comovido, de verdade..."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MAINTENANT_SOYEZ_SINC_RE_AVEC_981DDE"
msgid "Maintenant... Soyez sincère avec moi, quelle est cette solution ?"
msgstr "Agora... seja sincero comigo, que solução é essa?"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "W_POUSEZ_MOI_818244"
msgid "...[w] Épousez-moi !"
msgstr "...[w] Se casar comigo!"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_JE_VOUS_DEMANDE_PARDON_BFE971"
msgid "Je... Je vous demande pardon ?"
msgstr "Eu... Como disse?"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VOUS_M_AVEZ_TR_S_BIEN_ENTENDU_C764A0"
msgid "Vous m'avez très bien entendu."
msgstr "Você me ouviu muito bem."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MAIS_510779"
msgid "Mais..."
msgstr "Mas..."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SI_VOUS_ACCEPTEZ_DE_M_POUSER_J_D0266D"
msgid "Si vous acceptez de m'épouser je m'engage à recouvrir toutes vos dettes et à traiter votre fille comme ma propre fille, je m'engagerai également à faire tout ce qui est en mon pouvoir pour financer ses études. Après tout vous voulez le meilleur pour elle n'est-ce pas ?"
msgstr "Se você aceitar se casar comigo, eu me comprometo a assumir todas as suas dívidas e a tratar a sua filha como se fosse minha, inclusive financiando totalmente os estudos dela. Afinal de contas, você quer o melhor para ela, não quer?"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "DE_PLUS_EN_M_POUSANT_LA_BOUTIQ_37156B"
msgid "De plus, en m'épousant la boutique vous appartiendra à vous aussi, ainsi que les bénéfices qu'elle rapporte."
msgstr "Além disso, com o casamento, esta cafeteria passará a ser sua também, junto com todos os lucros que ela gera."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VOUS_SEREZ_DONC_D_BARRASS_E_DE_149599"
msgid "Vous serez donc débarrassée de votre dette que je prendrai en charge, vous aurez un travail bien mieux payé et vous pourrez offrir à {{noriko.n}} tout ce dont vous n'avez jamais eu la chance d'avoir..."
msgstr "Você vai se livrar desse fardo nas costas que eu vou liquidar, terá um negócio muito mais rentável e poderá dar à {{noriko.n}} tudo o que você nunca teve a oportunidade de oferecer..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "LA_SEULE_CHOSE_QUE_JE_DEMANDE_8588F1"
msgid "La seule chose que je demande en échange, c'est vous !"
msgstr "A única coisa que eu exijo em troca é você!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MOI_082F23"
msgid "Moi ?"
msgstr "Eu?"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OUI_VOUS_TES_UNE_FEMME_MAGNIFI_80A431"
msgid "Oui... Vous êtes une femme magnifique pour qui je suis prêt à sacrifier toute une vie d'économies et à le partager avec vous. Mais je veux votre amour inconditionnel en retour. Pensez à votre fille {{yasuka.n}} ! Pensez à ce qu'ils pourraient lui faire si vous ne remboursez pas à temps !"
msgstr "Sim... Você é uma mulher deslumbrante, por quem estou disposto a abrir mão das economias de uma vida inteira para dividir meu teto com você. Mas eu quero o seu amor total em troca. Pense na sua filha, {{yasuka.n}}! Pense no que aqueles cobradores seriam capazes de fazer com ela se você não pagar a tempo!"

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ACCEPTER_LA_PROPOSITION_IF_FL_5178D2"
msgid "Accepter la proposition."
msgstr "Aceitar a proposta."

#. Character:`narrator`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "REFUSER_LA_PROPOSITION_DE8244"
msgid "Refuser la proposition."
msgstr "Recusar a proposta."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VOUS_TIENDREZ_VRAIMENT_PAROLE_E30EB2"
msgid "Vous tiendrez vraiment parole ?"
msgstr "Você vai mesmo cumprir a sua palavra?"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MA_CH_RE_SACHEZ_QUE_JE_NE_PLAI_3CF605"
msgid "Ma chère, sachez que je ne plaisante jamais à propos de ces choses-là. Je suis un homme d'honneur !"
msgstr "Minha querida, saiba que eu nunca brinco com esse tipo de assunto. Eu sou um homem de honra!"

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_FERAI_TOUJOURS_TOUT_MON_POS_0A632B"
msgid "Je ferai toujours tout mon possible pour vous rendre heureuse."
msgstr "Eu farei tudo o que estiver ao meu alcance para te fazer feliz."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MAIS_CE_CONTRAT_TOUT_DE_M_ME_54B5DF"
msgid "Mais ce contrat tout de même..."
msgstr "Mas esse contrato... mesmo assim..."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "IL_Y_A_UNE_EXPLICATION_CELA_01F396"
msgid "Il y a une explication à cela."
msgstr "Existe uma explicação perfeitamente lógica para isso."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AI_EU_UNE_EX_FEMME_IL_FUT_UN_AF16C2"
msgid "J'ai eu une ex-femme il fut un temps et ça s'est très mal terminé pour moi, j'ai été humilié et elle a pris tout ce que je possédais."
msgstr "Eu tive uma ex-mulher há um tempo e as coisas terminaram muito mal para mim. Fui humilhado e ela levou tudo o que eu tinha."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_DE_L_QUE_VENAIENT_MES_PR_62A050"
msgid "C'est de là que venaient mes problèmes à l'origine. J'ai réussi à remonter la pente et je ne me laisserai plus jamais avoir !"
msgstr "Foi daí que surgiram os meus problemas originalmente. Eu ralei muito para dar a volta por cima e nunca mais vou me deixar passar por otário!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_NE_SAVAIS_PAS_B0E734"
msgid "Je ne savais pas..."
msgstr "Eu não fazia ideia..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "CE_N_EST_PAS_NON_PLUS_QUELQUE_419A7B"
msgid "Ce n'est pas non plus quelque chose sur lequel j'aime m'étaler, vous pouvez facilement l'imaginer."
msgstr "E também não é o tipo de coisa que eu goste de ficar espalhando por aí, como você deve imaginar."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OUI_EN_EFFET_10D6E4"
msgid "Oui en effet."
msgstr "Sim, de fato."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_SUIS_DEVENU_PRUDENT_EN_VIEI_44B8F0"
msgid "Je suis devenu prudent en vieillissant... Mais tant que nous nous respecterons mutuellement l'un l'autre, il n'y aura jamais de problèmes."
msgstr "Eu me tornei um homem prudente com o passar dos anos... Mas, contanto que a gente se respeite mutuamente, nunca teremos problemas."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "W_CE_N_EST_VRAIMENT_PAS_UNE_D_3F1DD5"
msgid "...[w] Ce n'est vraiment pas une décision facile à prendre."
msgstr "...[w] Realmente não é uma decisão fácil de se tomar."

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PFFF_DE_TOUTE_FA_ON_QUELLE_AUT_0E673A"
msgid "Pfff... de toute façon quelle autre option ai-je devant moi ? Qui voudrait d'une femme qui approche la quarantaine avec une fille déjà adulte ?"
msgstr "Pfff... mas pensando bem, que outra opção eu tenho na minha frente? Quem ia querer uma mulher que está quase chegando aos quarenta e com uma filha já adulta?"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MOI_93CB3A"
msgid "Moi."
msgstr "Eu quero."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ET_JE_SUIS_PR_T_TOUT_R_GLER_84A067"
msgid "Et je suis prêt à tout régler."
msgstr "E estou disposto a resolver tudo para você."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "WJE_SUPPOSE_69ED84"
msgid "...[w] Je suppose..."
msgstr "...[w] Eu aceito então..."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SIGNEZ_ICI_ET_TOUT_DISPARA_T_3AA95B"
msgid "Signez ici et tout disparaît."
msgstr "Assine bem aqui e tudo isso desaparece."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VOS_DETTES_VOS_PEURS_VOS_DOUTE_97BBAF"
msgid "Vos dettes. Vos peurs. Vos doutes. Vos nuits blanches."
msgstr "Suas dívidas. Seus medos. Suas incertezas. Suas noites em claro."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PENSEZ_VOTRE_FILLE_AUX_TUDES_Q_8C2EB1"
msgid "Pensez à votre fille, aux études qu'elle pourra suivre, à votre maison que vous pourrez conserver..."
msgstr "Pense na sua filha, na faculdade que ela vai poder cursar, na sua casa que você vai poder manter..."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ET_SAITO_N_18416B"
msgid "Et {{saito.n}} ?"
msgstr "E o {{saito.n}}?"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "IL_EST_ADULTE_PR_SENT_IL_EST_T_10700D"
msgid "Il est adulte à présent, il est temps pour lui de rejoindre la vie active, il doit pouvoir battre de ses propres ailes à présent, vous avez fait du très bon travail en l'élevant comme une personne digne, à présent c'est à lui d'avancer seul !"
msgstr "Ele já é maior de idade, está na hora de encarar o mercado de trabalho e aprender a voar com as próprias asas. Você fez um trabalho admirável criando ele como um homem digno, agora cabe a ele seguir em frente sozinho!"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AIMERAIS_QU_IL_RESTE_ENCORE_FBD1DC"
msgid "J'aimerais qu'il reste encore quelque temps à la maison... Je ne veux pas qu'il s'en aille du jour au lendemain !"
msgstr "Eu gostaria que ele ficasse mais um tempo lá em casa... Não quero que ele suma do dia para a noite!"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "A_NE_ME_D_RANGE_PAS_TANT_QU_I_75A728"
msgid "Ça ne me dérange pas, tant qu'il n'est pas gêné par ce qu'il entendra, je compte bien donner à ma future femme toute l'attention qu'elle mérite après tout."
msgstr "Por mim tudo bem, contanto que ele não se sinta incomodado com os barulhos que pode ouvir, afinal, eu pretendo dar à minha futura esposa toda a atenção que ela merece."

#. Character:`notice`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "YASUKA_N_SIGNE_LE_CONTRAT_DE_5B19E8"
msgid "{{yasuka.n}} signe le contrat de {{netoru.n}}."
msgstr "{{yasuka.n}} assina o contrato do {{netoru.n}}."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VOIL_C_EST_SIGN_162543"
msgid "Voilà c'est signé !"
msgstr "Pronto, está assinado!"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PARFAIT_NOUS_SOMMES_L_GALEMENT_21E2BC"
msgid "Parfait nous sommes légalement mari et femme !"
msgstr "Perfeito, agora somos legalmente marido e mulher!"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_VOUS_PROMETS_QUE_NOUS_FERON_5D3274"
msgid "Je vous promets que nous ferons une belle cérémonie le moment venu mais remboursons votre dette avant tout !"
msgstr "Eu te prometo que faremos uma bela cerimônia quando a hora chegar, mas vamos liquidar a sua dívida antes de qualquer coisa!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MERCI_JE_COMPRENDS_ET_MAINTENA_DF8F14"
msgid "Merci je comprends et maintenant ?"
msgstr "Obrigada, eu entendo. E o que faremos agora?"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "EH_BIEN_MA_CH_RIE_IL_ME_SEMBLE_551F20"
msgid "Eh bien... Ma chérie il me semble bien que tout mariage doit être consommé pour être validé voyons..."
msgstr "Ora... minha querida, me parece justo que todo casamento precise ser consumado para ser validado, não acha?"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "QUOI_VOUS_VOULEZ_DIRE_L_MAINTE_16D42F"
msgid "Quoi ?! Vous voulez dire... là maintenant ? Tout de suite ?"
msgstr "O quê?! Você quer dizer... aqui e agora?"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "IL_Y_A_UN_PROBL_ME_FAB473"
msgid "Il y a un problème ?"
msgstr "Algum problema com isso?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_QUE_JE_N_AI_PAS_VRAIMENT_785EE7"
msgid "C'est que... Je n'ai pas vraiment envie de faire ça ici, il y a les clients et..."
msgstr "É que... eu não queria fazer esse tipo de coisa aqui, os clientes estão lá fora e..."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VOUS_AVEZ_RAISON_FERMONS_LA_BO_B1C140"
msgid "Vous avez raison ! Fermons la boutique quelques heures et allons au love-hotel à côté."
msgstr "Você tem toda razão! Vamos fechar a loja por algumas horas e ir para o love hotel aqui do lado."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "L_COMME_A_MAIS_JE_NE_SUIS_M_ME_6E619F"
msgid "Là comme ça ? Mais je ne suis même pas..."
msgstr "Assim, do nada? Mas eu nem estou preparada para..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VOUS_TES_PARFAITE_575C9F"
msgid "Vous êtes parfaite."
msgstr "Você está perfeita."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "FONT_SIZE_14_ET_J_ATTENDS_A_D_709720"
msgid "[font_size=14]... et j'attends ça depuis bien trop longtemps.[/font_size]"
msgstr "[font_size=14]... e eu estou esperando por esse momento há tempo demais.[/font_size]"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SAUF_SI_VOUS_VOULEZ_QU_ON_ANNU_C05A86"
msgid "Sauf si vous voulez qu'on annule tout bien sûr ?"
msgstr "A menos que você queira cancelar tudo agora, é claro?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "NON_NON_JE_TR_S_BIEN_ALLONS_Y_9D3E40"
msgid "NON ! Non... je... très bien allons-y..."
msgstr "NÃO! Não... eu... tudo bem, vamos..."

#. Character:`sakuya` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SI_J_TAIS_VOUS_JE_NE_SIGNERAIS_B8FB6C"
msgid "Si j'étais vous, je ne signerais pas une telle chose."
msgstr "Se eu fosse você, não assinaria um negócio desses."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OH_JE_TE_RECONNAIS_TU_ES_LA_FI_F18274"
msgid "Oh je te reconnais, tu es la fille qui était venue voir {{saito.n}}."
msgstr "Ah, eu me lembro de você. Você é a garota que veio ver o {{saito.n}}."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_SUIS_RAVIE_DE_VOIR_QUE_VOUS_624B95"
msgid "Je suis ravie de voir que vous ne m'avez pas oubliée."
msgstr "Fico lisonjeada em ver que você não se esqueceu de mim."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "DE_QUOI_TU_TE_M_LES_TOUT_CECI_6F69D5"
msgid "De quoi tu te mêles ? Tout ceci ne te concerne en rien. La boutique est fermée pour le moment."
msgstr "O que você está metendo o bedelho aqui? Isso não é da sua conta. A cafeteria está fechada no momento."

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "CET_ACCORD_NE_VOUS_SERA_ABSOLU_B65EF8"
msgid "Cet accord ne vous sera absolument pas favorable, j'en ai bien peur..."
msgstr "Receio que esse acordo não traga absolutamente nenhuma vantagem para a senhora..."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AI_DIT_D_GAGE_DB1E9C"
msgid "J'ai dit dégage !"
msgstr "Eu mandei você ralar daqui!"

#. Character:`yasuka` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "A_SUFFIT_LAISSEZ_LA_PARLER_JE_0745CC"
msgid "Ça suffit ! Laissez-la parler, je veux entendre ce qu'elle a à dire !"
msgstr "Já chega! Deixe ela falar, eu quero escutar o que ela tem a dizer!"

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "VOUS_TES_VRAIMENT_NA_VE_VOUS_P_EF4025"
msgid "Vous êtes vraiment naïve... Vous pensez vraiment que cet individu veut votre bien ?"
msgstr "A senhora é muito ingênua... Acha mesmo que esse sujeito quer o seu bem?"

#. Character:`sakuya` | Attributes:`bored`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "SI_JE_SUIS_L_AUJOURD_HUI_C_EST_B8F29F"
msgid "Si je suis là aujourd'hui, c'est uniquement parce que {{saito.n}} s'inquiète pour vous."
msgstr "Se eu estou aqui hoje, é única e exclusivamente porque o {{saito.n}} está morrendo de preocupação com a senhora."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "IL_PENSE_AUTANT_MOI_36012F"
msgid "Il pense autant à moi...?"
msgstr "Ele se importa tanto assim comigo...?"

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "CE_PAPIER_NE_VAUT_RIEN_IL_N_A_EB6CC5"
msgid "Ce papier... ne vaut rien. Il n'a aucune valeur légale..."
msgstr "Esse pedaço de papel não vale nada. Não tem nenhum valor legal..."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "QUOI_COMMENT_OSES_TU_TU_N_Y_CO_EF0310"
msgid "Quoi !? Comment oses-tu ? Tu n'y connais rien !!!"
msgstr "O quê?! Como você se atreve? Você não sabe de porra nenhuma!!!"

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_M_Y_CONNAIS_EN_MARIAGE_J_AI_8F3E37"
msgid "Je m'y connais en mariage. J'ai beaucoup étudié de ce côté-là pour des raisons... personnelles..."
msgstr "Eu entendo bastante sobre casamentos. Estudei muito sobre o assunto por motivos... particulares..."

#. Character:`sakuya` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ET_L_TOUT_CE_QUE_JE_VOIS_C_EST_178486"
msgid "Et là tout ce que je vois, c'est juste un faux contrat de mariage qui ferait de vous une simple esclave sexuelle, sans vouloir vous offenser..."
msgstr "E tudo o que vejo aqui, com todo o respeito, é apenas um falso contrato de união feito para transformar a senhora em uma mera escrava sexual..."

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "DE_PLUS_IL_N_Y_A_AUCUNE_MENTIO_CB82AD"
msgid "De plus... il n'y a aucune mention d'un quelconque remboursement de votre dette. Cela n'apparaît nulle part."
msgstr "Para piorar... não há uma linha sequer mencionando o pagamento da sua dívida. Isso simplesmente não consta em lugar nenhum."

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "C_EST_JUSTE_UNE_PROMESSE_ORALE_BECF31"
msgid "C'est juste une promesse orale qui ne tient qu'à lui !"
msgstr "Não passa de uma promessa verbal que fica totalmente à mercê do humor dele!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "CE_N_EST_RIEN_J_ALLAIS_JUSTE_L_37559A"
msgid "Ce n'est rien... J'allais juste l'ajouter après. {{yasuka.n}}, je vous en prie, vous me faites confiance n'est-ce pas ? Nous travaillons ensemble depuis tellement longtemps !"
msgstr "Isso não significa nada... Eu só ia anexar essa parte depois. {{yasuka.n}}, por favor, você confia em mim, não confia? Nós trabalhamos juntos há tanto tempo!"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "ET_JE_NE_PARLE_M_ME_PAS_DE_CES_8ECF3D"
msgid "Et je ne parle même pas de ces conditions spéciales... Regardez les petits caractères ici..."
msgstr "Sem contar essas cláusulas especiais aqui... Dá só uma olhada nas letras miúdas bem aqui embaixo..."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OH_MON_DIEU_COMMENT_OSEZ_VOUS_DCBA2F"
msgid "Oh mon dieu... Comment osez-vous ?!"
msgstr "Meu Deus... Como o senhor tem coragem?!"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "TOI_TU_AS_TOUT_G_CH_62D1F4"
msgid "Toi...! Tu as tout gâché !"
msgstr "Sua pirralha...! Você estragou tudo!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "J_AVAIS_VRAIMENT_ESPOIR_QUE_VO_50661B"
msgid "J'avais vraiment espoir que vous ayez changé et que vous ayez réellement envie de m'aider..."
msgstr "Eu realmente tinha esperanças de que o senhor tivesse mudado e quisesse genuinamente me ajudar..."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "MAIS_AU_FINAL_VOUS_N_TES_QU_UN_B6ED34"
msgid "Mais au final vous n'êtes qu'un porc !"
msgstr "Mas no fim das contas, o senhor não passa de um porco!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "NON_M_ME_LES_PORCS_SONT_DES_AN_D1689B"
msgid "Non... Même les porcs sont des animaux bien plus nobles que vous !"
msgstr "Não... Até os porcos são animais muito mais nobres do que o senhor!"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "TR_S_BIEN_VOUS_M_AVEZ_EU_BIEN_BF26F9"
msgid "Très bien, vous m'avez eu, bien joué. Mais ne croyez pas une seule seconde que vous allez sortir d'ici tranquillement."
msgstr "Muito bem, vocês me pegaram, parabéns. Mas não achem nem por um segundo que vão sair daqui de boa."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "OH_VOUS_D_SIREZ_DONC_JOUER_DE_177CCE"
msgid "Oh, vous désirez donc jouer de cette façon ? Ça me facilite beaucoup les choses..."
msgstr "Ah, então você quer resolver as coisas do jeito difícil? Isso facilita muito o meu lado..."

#. Character:`netoru`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "QUOI_824C32"
msgid "Quoi ?"
msgstr "O quê?"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "UN_SIMPLE_PETIT_COUP_ICI_ET_HO_68041A"
msgid "Un simple petit coup ici et hop !"
msgstr "Um golpe bem colocado aqui e... prontinho!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "PUT_VOUS_ALLEZ_LE_REGRET_7ABE33"
msgid "Put... vous allez... le... regret-"
msgstr "Desgraça... vocês vão... me... pa-"

#. Character:`sakuya`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "IL_ME_SEMBLE_QUE_JE_N_AI_PAS_F_54B191"
msgid "Il me semble que je n'ai pas frappé assez fort."
msgstr "Pelo visto, eu não acertei com força suficiente."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "YASUKA_N_SI_VOUS_SORTEZ_D_ICI_5C578B"
msgid "{{yasuka.n}} ! Si vous sortez d'ici, ce ne sera plus la peine de revenir. Vous perdrez votre travail et je ferai en sorte que plus personne ne vous embauche dans cette ville !"
msgstr "{{yasuka.n}}! Se você passar por aquela porta, não precisa se dar ao trabalho de voltar. Você está demitida e eu vou garantir que ninguém mais te contrate nesta cidade!"

#. Character:`yasuka` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_PR_F_RE_ENCORE_A_DEVOIR_PAS_B07106"
msgid "Je préfère encore ça à devoir passer une seconde de plus en votre présence !"
msgstr "Eu prefiro a miséria a ter que passar mais um segundo sequer na sua presença!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "JE_D_MISSIONNE_B04F07"
msgid "Je démissionne !"
msgstr "Eu me demito!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_279b6718"
msgid "Tu en fais une tête, ça ne va pas ?"
msgstr "Você está com uma cara... aconteceu alguma coisa?"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "talk_yasuka_6399b904"
msgid "Installe-toi sur une banquette et tu me raconteras tout d'accord ?"
msgstr "Sente-se ali no sofá e você me conta tudo, combinado?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_4ca6a0ff"
msgid "Je t'écoute !"
msgstr "Sou toda ouvidos!"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_6848e675"
msgid "Il est temps que je m'occupe de ma relation...[w] conflictuelle avec {{noriko.n}}."
msgstr "Está na hora de eu dar um jeito na minha relação...[w] complicada com a {{noriko.n}}."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_8070e4ce"
msgid "Je crois que j'ai laissé les choses se détériorer pendant trop longtemps."
msgstr "Eu acho que deixei as coisas desandarem por tempo demais."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_b61b32b4"
msgid "Et j'ai peut-être pensé à tort que le problème ne venait absolument pas de moi."
msgstr "E talvez eu estivesse errado em pensar que a culpa não era minha."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_466d716a"
msgid "Mon chéri, tu es toujours si dur avec toi-même."
msgstr "Querido, você sempre pega pesado demais com você mesmo."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_aa86aad2"
msgid "Tu n'as pas à porter tout ça seul sur tes épaules."
msgstr "Você não tem que carregar todo esse fardo sozinho nas costas."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_d9039577"
msgid "Toi et moi savons qu'elle n'est pas facile à vivre."
msgstr "Nós dois sabemos muito bem que ela não é uma pessoa fácil de lidar."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_ac5dac23"
msgid "Je suis moi-même en partie responsable de cette situation."
msgstr "Eu mesma sou em parte responsável por tudo isso estar assim."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_9cf99a43"
msgid "Être parent n'est pas vraiment pas simple..."
msgstr "Ser pai ou mãe não é nada simples..."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_16085e4a"
msgid "Il est trop tard pour regretter à présent."
msgstr "Agora já é tarde para ficar se lamentando."

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_70915082"
msgid "Autant se concentrer sur ce qui peut être changé."
msgstr "O negócio é focar no que a gente ainda pode mudar."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_47e603be"
msgid "Tu as raison !"
msgstr "Você tem toda razão!"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_ddc1268b"
msgid "Dis-moi, en quoi je peux t'être utile ?"
msgstr "Me diga, como eu posso te ajudar?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_59126e59"
msgid "Est-ce que tu te souviens de l'époque ou mon père m'a... laissé avec vous ?"
msgstr "Você se lembra de quando o meu pai me... deixou com vocês?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_9025f057"
msgid "Je m'en souviens comme si c'était hier, impossible d'oublier un tel jour."
msgstr "Lembro como se fosse ontem, é impossível esquecer aquele dia."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_3f1f43be"
msgid "J'étais à la fois heureuse et en même temps tellement en colère contre lui."
msgstr "Eu estava radiante por um lado, mas ao mesmo tempo com um ódio mortal dele."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_e0d504a2"
msgid "Abandonner un petit garçon à un si jeune âge..."
msgstr "Abandonar um garotinho daquela idade..."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_35ff5035"
msgid "{{yasuka.n}} j'ai oublié ce type depuis longtemps, ce que j'aimerais savoir c'est comment était ma relation avec {{noriko.n}} ?"
msgstr "{{yasuka.n}}, eu já esqueci esse sujeito faz tempo. O que eu queria saber de verdade é: como era a minha relação com a {{noriko.n}}?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_6f439d79"
msgid "... Vous vous entendiez à merveille, elle n'a pas connu son père, le fait d'avoir un frère a été pour elle une joie incroyable."
msgstr "... Vocês se davam super bem. Como ela não conheceu o pai, ter um irmão foi uma alegria imensa para ela."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_da63593c"
msgid "Elle parlait sans arrêt de toi..."
msgstr "Ela não parava de falar de você um minuto sequer..."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_e0f2297c"
msgid "Et puis..."
msgstr "E então..."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_fb0848cd"
msgid "Et puis ?"
msgstr "E então o quê?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_d4375a6b"
msgid "Quelque chose a dû se passer. Elle s'est progressivement renfermée sur elle-même."
msgstr "Algo deve ter acontecido. Ela foi se fechando no mundinho dela aos poucos."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_e393469e"
msgid "De ton côté tu essayais d'insister pour aller vers elle mais elle ne voulait rien savoir."
msgstr "Você bem que tentava insistir e se aproximar, mas ela não queria saber de jeito nenhum."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_4f557364"
msgid "Elle ne m'a jamais expliquée la raison."
msgstr "Ela nunca me explicou o motivo."

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_ce2414e1"
msgid "J'aurais donc fait quelque chose de si terrible que ça ?"
msgstr "Será que eu fiz alguma coisa tão terrível assim para ela?"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_ca65c9a7"
msgid "... Pourquoi penses-tu une telle chose ?"
msgstr "... Por que você está pensando uma coisa dessas?"

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_c49f6493"
msgid "Je ne sais pas...[w] J'ai dû lui faire peur à un moment ou un autre, ou pire encore..."
msgstr "Não sei...[w] Devo ter assustado ela de alguma forma, ou coisa pior..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_22f296e3"
msgid "Mon chéri... tu avais 8 ans à l'époque... Tout ce qui vous intéressait c'était de faire des cabanes, vous baigner dans le lac et vous amuser au..."
msgstr "Querido... você tinha só oito anos na época... Tudo o que vocês queriam era construir cabanas, nadar no lago e brincar no..."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_e8d0313d"
msgid "Oh... Je crois me souvenir de quelque chose."
msgstr "Ah... Acho que acabei de me lembrar de uma coisa."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_e1657287"
msgid "Un soir en rentrant du parc... {{noriko.n}} pleurait et semblait inconsolable."
msgstr "Teve uma noite, voltando do parque... a {{noriko.n}} chorava sem parar, estava inconsolável."

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_fa9cd0e2"
msgid "Toi tu étais blessé de partout mais tu faisais comme si ce n'était pas grave."
msgstr "E você estava todo machucado, mas agia como se não fosse nada de mais."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_83585be5"
msgid "Tu savais pourquoi ?"
msgstr "Você chegou a descobrir o porquê?"

#. Character:`yasuka`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_5b9226d2"
msgid "Hélas non, vous n'avez jamais voulu me le dire..."
msgstr "Infelizmente não, vocês dois se recusaram terminantemente a me contar..."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_49c45df8"
msgid "... Donc si je comprends bien... il s'est passé quelque chose dans ce parc quand nous étions petits."
msgstr "... Então, se eu entendi bem... aconteceu alguma coisa naquele parque quando a gente era criança."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_361d90a1"
msgid "Et ma relation avec {{noriko.n}} n'a fait qu'empirer depuis ce jour."
msgstr "E a minha relação com a {{noriko.n}} só veio ladeira abaixo desde aquele dia."

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_cc8a0337"
msgid "Merci pour tout."
msgstr "Obrigado por clarear as coisas."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_814d6775"
msgid "Oh je n'ai pas fait grand chose, j'aurais aimé pouvoir faire plus."
msgstr "Oh, eu não fiz quase nada, gostaria de ter ajudado mais."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_c0fed06e"
msgid "J'en sais déjà bien plus."
msgstr "Você ajudou mais do que imagina."

#. Character:`saito`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_8a0b3a25"
msgid "Je trouverai l'origine du problème et {{noriko.n}} me sourira à nouveau."
msgstr "Irei encontrar a origem do problema e a {{noriko.n}} voltará a sorrir para mim."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_interior.dialogue game/story/onsen_interior.dialogue
#: game/story/hostess_club_exterior.dialogue
msgctxt "yasuka_talk_noriko_maledom_30d7207e"
msgid "Bonne chance mon chéri, je suis certaine que tu y parviendras."
msgstr "Boa sorte, querido, eu tenho certeza absoluta de que você vai conseguir."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9f8596cc"
msgid "Je devrais prendre le baladeur MP3. Il est sur mon lit."
msgstr "Eu deveria pegar o MP3. Está em cima da minha cama."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_293b2c4f"
msgid "Pas de temps à perdre ! Je dois trouver ce qui arrive à {{yasuka.n}} !"
msgstr "Não tenho tempo a perder! Preciso descobrir o que está acontecendo com a {{yasuka.n}}!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2fe8ad28"
msgid "{{yasuka.n}} m'a appelé dans sa chambre. Je devrais la rejoindre."
msgstr "A {{yasuka.n}} me chamou no quarto dela. É melhor eu ir lá."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_554c43d4"
msgid "Je devrais aller voir {{yasuka.n}} dans sa chambre."
msgstr "Eu deveria ir ver a {{yasuka.n}} no quarto dela."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_80de7195"
msgid "Je ferais mieux d'aller prendre un peu d'air frais dehors."
msgstr "É melhor eu ir lá fora tomar um pouco de ar fresco."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f133bbfb"
msgid "Non, mais ça ne va pas de hurler comme ça dès le matin ?!"
msgstr "Qual é, tá maluco de ficar berrando desse jeito logo cedo?!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_11d3ac2a"
msgid "Y'en a marre, quand est-ce que tu te comporteras comme un mec ?"
msgstr "Já deu, quando é que você vai começar a agir feito homem?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_23584010"
msgid "T'es vraiment qu'un gamin !"
msgstr "Você não passa de um moleque!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_35288d53"
msgid "Oula, doucement... M'agresse pas dès le matin comme ça je..."
msgstr "Opa, calma aí... Não me agride logo cedo, eu só..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_864c46c2"
msgid "Ferme ta gueule !"
msgstr "Cala a sua boca!"

#. Character:`noriko` | Attributes:`-angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f5d633d9"
msgid "J'en peux plus de toi et de tes conneries, t'es qu'un foutu parasite, quand est-ce que tu te barres d'ici ?!"
msgstr "Não aguento mais você e suas merdas, você é um maldito parasita! Quando é que você vai sumir daqui?!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_78e798c2"
msgid "Quoi ?! Mais je..."
msgstr "O quê?! Mas eu..."

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_71d02d97"
msgid "J'MEN FOUT CASSE-TOI !"
msgstr "EU NÃO QUERO SABER, CAIA FORA!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_03775ec8"
msgid "..."
msgstr "..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_aa884729"
msgid "La vache..."
msgstr "Caramba..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_89778dcc"
msgid "J'avais totalement oublié son existence."
msgstr "Eu tinha esquecido totalmente da existência dela."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3ab3c167"
msgid "Comment j'ai pu oublier {{noriko.n}} et son agressivité légendaire..."
msgstr "Como eu pude esquecer da {{noriko.n}} e dessa agressividade lendária dela..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8ed9d900"
msgid "Elle a toujours été ultra-violente avec moi, j'ai essayé de savoir pourquoi elle m'en voulait tellement, mais..."
msgstr "Ela sempre foi ultra-violenta comigo. Eu tentei descobrir por que ela me odiava tanto, mas..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0b052899"
msgid "Elle m'a toujours envoyé chier."
msgstr "Ela sempre me mandava à merda."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e49418ab"
msgid "Si je me souviens bien, elle va quitter la maison en volant le peu d'argent qu'il restera à {{yasuka.n}} pour s'enfuir avec une bande de racailles."
msgstr "Se bem me lembro, ela vai fugir de casa roubando o pouco dinheiro que vai sobrar da {{yasuka.n}} para fugir com um bando de marginais."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7199d067"
msgid "Et on va la retrouver noyée dans le canal peu de temps après sa fugue, son corps totalement souillé."
msgstr "E vão encontrar ela afogada no canal pouco tempo depois, com o corpo totalmente violado."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9cd593bd"
msgid "Ça va briser {{yasuka.n}}. Elle ne pourra jamais remonter la pente après ça..."
msgstr "Isso vai destruir a {{yasuka.n}}. Ela nunca mais vai conseguir se recuperar depois disso..."

#. Character:`saito` | Attributes:`-sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_897eca85"
msgid "Je dois pouvoir changer ça !"
msgstr "Eu preciso conseguir mudar isso!"

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_43ea3f38"
msgid "Pffff, et en plus, tu te parles à toi-même maintenant... Tellement pathétique !"
msgstr "Pfff, e agora você deu pra falar sozinho... Que patético!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_dd978a3f"
msgid "Tu me donnes envie de vomir !"
msgstr "Você me dá vontade de vomitar!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_96d9d3a2"
msgid "Rien que de voir ta... tête, je..."
msgstr "Só de ver a sua... cara, eu..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f94ec740"
msgid "Beuh, je sens que ça vient..."
msgstr "Eca, sinto que está vindo..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_bc4eeee4"
msgid "...ou pas."
msgstr "...ou não."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_43ea5588"
msgid "T'as passé une mauvaise journée ?"
msgstr "Teve um dia ruim, foi?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b9ae232a"
msgid "Eh bien, tu peux pas savoir comme ça me fait plaisir !"
msgstr "Pois saiba que você não faz ideia do quanto isso me deixa feliz!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ffd6a680"
msgid "J'espère que ça sera pire encore demain !"
msgstr "Espero que amanhã seja pior ainda!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8958d958"
msgid "T'es vraiment qu'un putain de..."
msgstr "Você é mesmo um puta de um..."

#. Character:`noriko` | Attributes:`blush,cute`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e447f6d9"
msgid "Euh..."
msgstr "Er..."

#. Character:`yasuka`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_62854c6d"
msgid "Bonsoir, ma chérie, tu n'es pas encore couchée ?"
msgstr "Boa noite, querida. Ainda não foi deitar?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_847f88b0"
msgid "Si... si... j'y allais justement..."
msgstr "Sim... sim... eu já estava indo..."

#. Character:`yasuka`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3b51dcf3"
msgid "Bonne nuit alors !"
msgstr "Boa noite, então!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_29cd7803"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_dd2f5fac"
msgid "Allons-y mon chéri !"
msgstr "Vamos, querido!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a0df62e4"
msgid "Rien qu'à voir la tête de {{noriko.n}}..."
msgstr "Só de ver a cara da {{noriko.n}}..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3b81fd04"
msgid "Ça en valait la peine !"
msgstr "Já valeu a pena!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3989c296"
msgid "Je me ferai surement défoncer demain."
msgstr "Com certeza eu vou ser trucidado amanhã."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "BAH_ALORS_SALE_JOUR_29F4DD"
msgid "Bah alors sale jour-"
msgstr "E aí, como foi seu dia de mer-"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "PAS_MAINTENANT_ON_SE_PRENDRA_L_8888F1"
msgid "Pas maintenant, on se prendra la tête demain si tu veux..."
msgstr "Agora não. A gente se resolve amanhã, se você quiser..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "QUOI_QU_3BB829"
msgid "Quoi... qu-"
msgstr "O quê... O qu-"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_ace7bd46"
msgid "Mais..."
msgstr "Mas..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0c3ec198"
msgid "Une minute..."
msgstr "Espera um minuto..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_82150078"
msgid "Si je rentre ici sans être préparé, elle va encore trouver le moyen de me faire chanter..."
msgstr "Se eu entrar aqui sem estar preparado, ela vai dar um jeito de me chantagear de novo..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2075f795"
msgid "Dans mon rêve, elle m'avait accusé de l'avoir violé et avait quitté la maison peu de temps après."
msgstr "No meu sonho, ela tinha me acusado de tê-la estuprado e saiu de casa pouco tempo depois."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c9edb325"
msgid "{{yasuka.n}} ne m'avait plus jamais adressée la parole, j'avais dû quitter la maison par la suite."
msgstr "A {{yasuka.n}} nunca mais falou comigo, e eu tive que ir embora de casa depois disso."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a3deec1e"
msgid "{{noriko.n}} cette fois-ci, je ne me ferais pas avoir !"
msgstr "{{noriko.n}}... desta vez, eu não vou cair na sua armadilha!"

#. Character:`centered`
#: game/story/home_player_corridor.dialogue
msgctxt "t377300f535"
msgid "Vous avez activé l'enregistreur audio de votre tablette."
msgstr "Você ativou o gravador de áudio do seu tablet."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_317a7e66"
msgid "Enfin !!!"
msgstr "Finalmente!!!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c92622f5"
msgid "Cette fois-ci, {{noriko.n}} est hors service !"
msgstr "Desta vez, eu quebrei as pernas da {{noriko.n}}!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d756bd48"
msgid "Putain, pourquoi je n'ai jamais fait ça plus tôt ?!"
msgstr "Porra, por que eu nunca fiz isso antes?!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_20019500"
msgid "Ça fait tellement de bien..."
msgstr "Isso é bom demais..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_af6010dc"
msgid "Ah merde, je n'ai pas vu le temps passer !"
msgstr "Ah, droga, não vi o tempo passar!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f5542d4e"
msgid "J'espère que {{macumba.n}} ne m'a pas attendu toute la journée..."
msgstr "Espero que o {{macumba.n}} não tenha ficado me esperando o dia todo..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6c6c6c0d"
msgid "Bordel ! Ce qui vient de se passer..."
msgstr "Caramba! O que acabou de acontecer..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0bbf19c0"
msgid "Je n'aurais jamais pensé que {{noriko.n}} ferait un truc aussi audacieux."
msgstr "Eu nunca imaginei que a {{noriko.n}} faria algo tão ousado."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_37774e33"
msgid "Peut-être devrais-je profiter un petit temps de cette situation, je serais curieux de voir ou tout ça va me mener."
msgstr "Talvez eu devesse aproveitar essa situação por um tempo, estou curioso para ver onde tudo isso vai dar."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0f41cc13"
msgid "...[w] J'aurais peut-être dû les touchers au final."
msgstr "...[w] Talvez eu devesse ter tocado neles, afinal."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a21e86ee"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_af6010dc_1"
msgid "Ah merde, j'ai pas vu le temps passer !"
msgstr "Ah, droga, não vi o tempo passar!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f5542d4e_1"
msgid "J'espère que {{macumba.n}} ne m'a pas attendu toute la journée..."
msgstr "Espero que o {{macumba.n}} não tenha ficado me esperando o dia todo..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ce44d7ee"
msgid "C'est quoi ces bruits..."
msgstr "Que barulhos são esses..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9cd7ca42"
msgid "On dirait des... gémissements !"
msgstr "Parecem... gémidos!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_70871f4d"
msgid "Nooon, elle n'est tout de même pas en train de faire ce que je crois ?!"
msgstr "Nãooo, ela não está fazendo o que eu estou pensando, está?!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9a20b792"
msgid "Hummm..."
msgstr "Hummm..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b1c03ba5"
msgid "Oui... Juste là..."
msgstr "Isso... bem aí..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b6398ec1"
msgid "Oohhh, voilà..."
msgstr "Oohhh, agora sim..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6cdb64c2"
msgid "Oui oui oui..."
msgstr "Sim, sim, sim..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c317db21"
msgid "Han la vache..."
msgstr "Nossa..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_457162a5"
msgid "C'est... chaud !"
msgstr "Que... excitante!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_748684b1"
msgid "Hummm... Oui..."
msgstr "Hummm... Isso..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_963bae77"
msgid "Finalement, tout ce qui s'est passé l'a terriblement excitée..."
msgstr "Pelo visto, tudo o que aconteceu deixou ela excitadíssima..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b214b8fe"
msgid "Ça valait le coup de se revivre rien que pour ce moment !"
msgstr "Valeu a pena reencarnar só por esse momento!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_79e8986b"
msgid "Sacrée {{noriko.n}}..."
msgstr "Essa {{noriko.n}}..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a50ef803"
msgid "J'imagine qu'elle devait être sacrément frustrée."
msgstr "Imagino que ela estivesse bem frustrada."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_cd15d2f2"
msgid "Je pense qu'elle a terminé..."
msgstr "Acho que ela terminou..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2fe96b66"
msgid "Merde, c'est moi qui suis excité maintenant."
msgstr "Droga, agora quem ficou excitado fui eu."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "t0ce0489d37"
msgid "Continuer d'écouter"
msgstr "Continuar escutando"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "t48efb92c68"
msgid "S'en aller"
msgstr "Ir embora"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "tce29a7c279"
msgid "Coller son oreille contre la porte"
msgstr "Encostar o ouvido na porta"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "t2fdaa7cd0e"
msgid "J'ai pas que ça à faire."
msgstr "Tenho mais o que fazer."

#. Character:`saito` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_290f8954"
msgid "Je peux savoir ce que tu cherches à faire ?"
msgstr "Posso saber o que você está tentando fazer?"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_898b1990"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_1860160c"
msgid "Tu n'avais pas le droit de faire ça."
msgstr "Você não tinha o direito de fazer aquilo."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_b33eb4ad"
msgid "Je croyais t'avoir demandé de me laisser tranquille."
msgstr "Eu achei que tinha pedido para você me deixar em paz."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_31c360db"
msgid "Et tu es encore là, devant moi, à venir chercher les problèmes."
msgstr "E você continua aqui, na minha frente, vindo procurar problema."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_cca26670"
msgid "Je vais finir par penser que c'est ce que tu souhaites vraiment {{noriko.n}}."
msgstr "Vou acabar achando que é exatamente isso que você quer, {{noriko.n}}."

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_063c8601"
msgid "Qu.. Quoi ? C'est n'importe quoi ! Qui voudrait se laisser toucher par..."
msgstr "O.. O quê? Isso não faz sentido! Quem ia querer ser tocada por..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_a4836727"
msgid "Mais je rêve ou quoi, elle me sous-entend de passer à l'action ?"
msgstr "Eu estou sonhando ou ela está me provocando para eu agir?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_e6197d4f"
msgid "{{noriko.n}}, je ne sais pas ce qui te passe par la tête en ce moment."
msgstr "{{noriko.n}}, não sei o que está passando pela sua cabeça agora."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_f30e5df6"
msgid "Mais je suis curieux de voir ou tout ça va nous mener."
msgstr "Mas estou curioso para ver onde tudo isso vai dar."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_6a89a728"
msgid "Allons dans ta chambre tout de suite !"
msgstr "Vamos para o seu quarto agora mesmo!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_0d341298"
msgid "...D'accord."
msgstr "...Está bem."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_13790da0"
msgid "Si tu veux que je m'occupe de toi, tu vas devoir être plus obéissante et surtout..."
msgstr "Se você quer que eu cuide de você, vai ter que ser mais obediente e, acima de tudo..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_4f189644"
msgid "D'être plus honnête avec toi-même..."
msgstr "Ser mais honesta consigo mesma..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_6442ef52"
msgid "Mais si c'est la manière forte que tu préfères, ça ne me dérange pas..."
msgstr "Mas se você prefere do jeito difícil, por mim tudo bem..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_165eab73"
msgid "T... t... t'es vraiment un..."
msgstr "V... v... você é mesmo um..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_1b5241ef"
msgid "Un quoi ?"
msgstr "Um o quê?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_c65804e0"
msgid "Ahh..."
msgstr "Ahh..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_7f8444a5"
msgid "Je... Non... C'est..."
msgstr "Eu... Não... É..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_ef83d746"
msgid "Aah..."
msgstr "Aah..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_21ff3bd5"
msgid "Mmmm..."
msgstr "Mmmm..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_084275ae"
msgid "Je vais..."
msgstr "Eu vou..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_3665f7f6"
msgid "Han, c'est trop b-"
msgstr "Ah, é tão g-"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_415201f3"
msgid "Ça dépasse toutes mes attentes."
msgstr "Isso supera todas as minhas expectativas."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_dd67902d"
msgid "Elle semble littéralement prendre son pied."
msgstr "Ela parece estar literalmente nas nuvens."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_7a4b2c81"
msgid "Je devrais augmenter son niveau de désir."
msgstr "Eu deveria aumentar o nível de desejo dela."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_135789a9"
msgid "Rien de tel qu'un peu de frustration..."
msgstr "Nada como um pouco de frustração..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_15644477"
msgid "Ça suffit."
msgstr "Já chega."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_cf1cd077"
msgid "QUOI ? Non ! J'y suis pr-"
msgstr "O QUÊ? Não! Eu estava qua-"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_90703d21"
msgid "La prochaine fois, tu seras plus honnête avec moi."
msgstr "Na próxima vez, você vai ser mais honesta comigo."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_d3dd621b"
msgid "Oh, bon sang."
msgstr "Oh, caramba."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_09593c00"
msgid "J'ai le cœur qui bat à 200 à l'heure."
msgstr "Meu coração está batendo a mil por hora."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_dcaf134f"
msgid "Il me tarde déjà d'être à la prochaine fois."
msgstr "Já estou ansioso pela próxima vez."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_e8800765"
msgid "Pas si vite !"
msgstr "Não tão rápido!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_0891c7d4"
msgid "Ah merde, {{noriko.n}}."
msgstr "Ah, droga, {{noriko.n}}."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_85a4f684"
msgid "Elle me tient par les couilles maintenant."
msgstr "Agora ela me pegou pelas bolas."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_b10ca948"
msgid "S'il te plait {{noriko.n}}, je suis occupé en ce moment et..."
msgstr "Por favor, {{noriko.n}}, eu estou ocupado agora e..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_e6d49726"
msgid "Silence, chien."
msgstr "Silêncio, cachorro."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_8fc87ac5"
msgid "Tu ouvriras la bouche seulement quand je t'en donnerai la permission."
msgstr "Você só vai abrir a boca quando eu der permissão."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_caf9d213"
msgid "Assis !"
msgstr "Senta!"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_13517269"
msgid "J'ai dit assis !"
msgstr "Eu disse senta!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_3df9a51c"
msgid "J'ai beaucoup réfléchi depuis la dernière fois."
msgstr "Eu pensei muito desde a última vez."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_84b2077f"
msgid "Et je trouve que pour un chien, tu es drôlement désobéissant."
msgstr "E acho que, para um cachorro, você é bem desobediente."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_a525e043"
msgid "À tel point que je vais devoir reprendre ton éducation en main."
msgstr "Tanto que eu vou ter que assumir as rédeas da sua educação."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_3619d0e8"
msgid "Je ne supporte plus de te voir aller et venir à longueur de journée faire je ne sais quoi avec je ne sais qui."
msgstr "Não suporto mais ver você indo e vindo o dia todo, fazendo não sei o quê com não sei quem."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_03775ec8"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_8ce72db8"
msgid "Tu n'es qu'un animal comme tous les autres."
msgstr "Você não passa de um animal, como todos os outros."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_d6749340"
msgid "Guidé juste par ton besoin de te reproduire."
msgstr "Guiado apenas pela sua necessidade de se reproduzir."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_8f9c9cf1"
msgid "Mais ça n'arrivera plus."
msgstr "Mas isso não vai mais acontecer."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_d4bbeb03"
msgid "Si je te vois encore trainer avec une autre femme que moi, je devrais sévir."
msgstr "Se eu te vir andando com qualquer outra mulher que não seja eu, vou ter que te punir."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_09cd89ea"
msgid "Est-ce que tu comprends ?"
msgstr "Você entendeu?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_3e85771d"
msgid "Oui..."
msgstr "Sim..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_16020db7"
msgid "C'est bien, tu es un gentil chien."
msgstr "Muito bem, você é um bom garoto."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_c421c568"
msgid "Oh, mais que vois-je ?"
msgstr "Oh, mas o que temos aqui?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_96fdacd5"
msgid "On dirait que ça t'excite en plus ?"
msgstr "Não me diga que isso te deixa excitado?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_9e6a836d"
msgid "Tu aimes te faire dominer comme ça ?"
msgstr "Você gosta de ser dominado assim?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_94f76d08"
msgid "Bien sûr que t'aime ça, t'es juste un foutu pervers !"
msgstr "É claro que gosta, você é só um puta de um pervertido!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_b14bf260"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_aabe56fc"
msgid "Maintenant, la prochaine fois que je siffle, tu rappliques immédiatement, c'est compris ?"
msgstr "Agora, da próxima vez que eu assobiar, você vem correndo imediatamente, entendeu?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_3e85771d_1"
msgid "Oui..."
msgstr "Sim..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "talk_noriko_6bb38b08"
msgid "Parfait, dégage maintenant !"
msgstr "Perfeito, agora cai fora!"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0fb9f0de"
msgid "C'est qui cette fille ?"
msgstr "Quem é aquela garota?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c3b92b2b"
msgid "...personne."
msgstr "...ninguém."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e7182eb9"
msgid "C'est pas la réponse que j'attendais sale chien."
msgstr "Essa não foi a resposta que eu esperava, seu cachorro."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_89804fdd"
msgid "J'ai dit... C'est qui cette fille ?"
msgstr "Eu perguntei... Quem é aquela garota?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ad253479"
msgid "C'est bon, c'est bon, c'est la fille du patron de restaurant d'Udon."
msgstr "Tá bom, tá bom! É a filha do dono do restaurante de Udon."

#. Character:`noriko` | Attributes:`-angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a4009c4c"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_34160b06"
msgid "Pourquoi elle trainerait avec un parasite comme toi ?"
msgstr "Por que ela estaria andando com um parasita como você?"

#. Character:`saito` | Attributes:`-sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_59800ea8"
msgid "Très bonne question, et si tu me laissais y aller, j'aurais la réponse."
msgstr "Ótima pergunta. Se você me deixasse ir, eu teria a resposta."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b75a0305"
msgid "Arrête de faire le malin."
msgstr "Para de gracinha."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3d7b6407"
msgid "Connard !"
msgstr "Babaca!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_af5cde76"
msgid "C'est toujours un plaisir de discuter avec toi..."
msgstr "É sempre um prazer conversar com você..."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_11a7e02a"
msgid "...C'est qui ?"
msgstr "...Quem é ela?"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_bab9843b"
msgid "Ça ne te regarde pas. Retourne dans ta chambre !"
msgstr "Isso não te interessa. Volta para o seu quarto!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_29cd7803_1"
msgid "..."
msgstr "..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_fe51d417"
msgid "La vache, elle est vraiment devenue obéissante ma parole."
msgstr "Caramba, ela ficou obediente mesmo, hein?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6748bbf5"
msgid "Les choses s'améliorent."
msgstr "As coisas estão melhorando."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_4c7c0e64"
msgid "Je peux savoir ce que tu vas faire ?"
msgstr "Posso saber o que você vai fazer?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_afb39f28"
msgid "J'espère que tu n'as pas l'intention de montrer l'enregistrement à qui que ce soit ?"
msgstr "Espero que não tenha a intenção de mostrar essa gravação para ninguém."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8b2d3068"
msgid "Ça dépend que de toi."
msgstr "Só depende de você."

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0cb9eefa"
msgid "Tch..."
msgstr "Tch..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f16b14b5"
msgid "C'est fou à quel point elle tient à sa réputation..."
msgstr "É incrível o quanto ela preza pela reputação..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_1905619e"
msgid "Je me demande bien ce que ça cache."
msgstr "Eu me pergunto o que ela está escondendo..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3c76d392"
msgid "Tu te fiches de moi ?"
msgstr "Você tá de brincadeira comigo?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b80e0bdb"
msgid "C'est la seconde fille qui vient pour te voir."
msgstr "Já é a segunda garota que vem te ver."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d7e13433"
msgid "Qu'est-ce que tu leur as fait ? Du chantage, c'est ça ?"
msgstr "O que você fez com elas? Chantagem, é isso?"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b45aba88"
msgid "Je suis sûr qu'un pervers comme toi a fait quelque chose de louche."
msgstr "Tenho certeza que um pervertido como você fez algo de errado."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0a301055"
msgid "C'est trop difficile à croire qu'elles pourraient être là simplement parce qu'elles m'apprécient ?"
msgstr "É tão difícil acreditar que elas podem estar aqui simplesmente porque gostam de mim?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d76abc04"
msgid "Pfff, ne me fait pas rire, n'oublie pas qu'aux yeux de toute la fac, tu restes un déchet."
msgstr "Pfff, não me faça rir. Não esqueça que, para a faculdade inteira, você continua sendo um fracassado."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_1c24a0ed"
msgid "Les choses ne vont pas changer parce que tu t'es mis à courir, ou je ne sais quelle autre connerie."
msgstr "As coisas não vão mudar só porque você começou a correr ou qualquer outra palhaçada dessas."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_274f4445"
msgid "Les gens ne changent pas."
msgstr "As pessoas não mudam."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_985db49f"
msgid "Okay, super conversation."
msgstr "Beleza, ótima conversa."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e1b99375"
msgid "Ferme là !"
msgstr "Cala a boca!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d795e5c3"
msgid "Une seconde, je ne peux pas me présenter comme ça pour mon premier jour au restaurant..."
msgstr "Espera aí, não posso aparecer assim no meu primeiro dia no restaurante..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_15e69ec4"
msgid "Je devrais faire un petit tour dans la salle de bain."
msgstr "É melhor eu dar uma passada no banheiro."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_4fb6b272"
msgid "Donc tout ça est bien vrai..."
msgstr "Então tudo isso é verdade mesmo..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_810b37a0"
msgid "Je suis le seul à pouvoir le voir."
msgstr "Só eu consigo ver."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7b8ae9a7"
msgid "Je ne crois pas avoir vu de changement notable en moi."
msgstr "Não acho que vi nenhuma mudança notável em mim."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c50b522b"
msgid "Pas de pouvoirs ou autres capacités qui sortiraient de l'ordinaire."
msgstr "Sem poderes ou outras capacidades fora do comum."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_92d64b6f"
msgid "En tout cas pas à première vue..."
msgstr "Pelo menos não à primeira vista..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_977d79b0"
msgid "On verra ça avec le temps ! Je dois filer au restaurant."
msgstr "Veremos isso com o tempo! Preciso correr para o restaurante."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e84ea1c4"
msgid "Je vais me faire virer si j'arrive en retard dès le premier jour."
msgstr "Vou ser demitido se chegar atrasado logo no primeiro dia."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_55ee076d"
msgid "Qu'est-ce que tu me veux encore ?"
msgstr "O que você quer comigo agora?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e25835cc"
msgid "Tu ne donnes plus aucun signe de vie depuis plusieurs jours."
msgstr "Você não dá as caras faz dias."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_21b32491"
msgid "T'es trop occupé avec ta nouvelle copine ?"
msgstr "Tá ocupado demais com a sua namoradinha nova?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ac66cee5"
msgid "Qu'est-ce que ça peut te faire, je croyais que tu me détestais ?"
msgstr "O que te importa? Achei que você me odiasse."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_29cd7803_2"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_fb2c2502"
msgid "Tu ne comprends jamais rien toi !"
msgstr "Você não entende nada mesmo!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a6e3dbd3"
msgid "Mais bordel..."
msgstr "Mas que porra..."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_898b1990"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_df9791e6"
msgid "C'est quoi ton problème ?"
msgstr "Qual é o seu problema?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f1f84502"
msgid "Mon problème ?"
msgstr "Meu problema?"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_aab8f7a6"
msgid "C'est votre faute ! Vous avez passé toute la nuit à baiser comme des lapins !"
msgstr "A culpa é de vocês! Passaram a noite inteira fodendo que nem coelhos!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_288b676e"
msgid "Ah oui effectivement, désolé pour ça."
msgstr "Ah, sim, com certeza. Desculpa por isso."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d84fee7a"
msgid "...Je te reconnais plus."
msgstr "...Eu não te reconheço mais."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_37651377"
msgid "Tu sembles vraiment être une personne totalement différente."
msgstr "Você parece ser uma pessoa totalmente diferente agora."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_257a193b"
msgid "Peut-être, je n'allais pas éternellement me faire marcher sur les pieds."
msgstr "Talvez. Eu não ia deixar as pessoas pisarem em mim para"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3f276645"
msgid "C'est un problème ?"
msgstr "Isso é um problema?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_88a91a13"
msgid "Non, bien sûr que non... au contr-"
msgstr "Não, claro que não... pelo contrá-"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_209ab0a4"
msgid "Alors quoi ?"
msgstr "Então o quê?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_29cd7803_3"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d4e1c09c"
msgid "De toute façon, je suis sûr qu'elle simule !"
msgstr "De qualquer jeito, tenho certeza que ela está fingindo!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_88f7a8e0"
msgid "Idiot !"
msgstr "Idiota!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7643d8a5"
msgid "C'est quoi ce bordel ?"
msgstr "Mas que porra foi essa?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b55d28ab"
msgid "Une conversation presque normale avec elle ?"
msgstr "Uma conversa quase normal com ela?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6809ad10"
msgid "Je pense que certaines de mes actions sont responsables du changement de sa façon de se comporter avec moi."
msgstr "Acho que algumas das minhas ações são responsáveis pela mudança no jeito dela me tratar."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b578db8f"
msgid "Je dois continuer sur cette lancée."
msgstr "Preciso continuar nesse ritmo."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_10876d22"
msgid "Ta mère est vraiment une femme magnifique..."
msgstr "Sua mãe é realmente uma mulher magnífica..."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6f1bef95"
msgid "Si je pouvais avoir la même classe qu'elle dans dix ans, je pense que j'aurais réussi ma vie."
msgstr "Se eu tiver metade da classe dela daqui a dez anos, vou sentir que zerei a vida."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6ef525f3"
msgid "Je ne peux pas te contredire là-dessus {{yasuka.n}} est vraiment belle."
msgstr "Não posso discordar, a {{yasuka.n}} é linda mesmo."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_040d1d68"
msgid "Mais ce n'est pas ma mère..."
msgstr "Mas ela não é minha mãe..."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_5544a5a2"
msgid "Oh ! Voici donc la chambre de l'orc dont tu m'as parlé !"
msgstr "Ah! Então este é o quarto da orquesa de que você me falou!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0c694d35"
msgid "Shhht ! Pas si fort ! Tu veux ma mort ou quoi ?"
msgstr "Shhht! Não tão alto! Quer me ferrar, é?"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8e4b713f"
msgid "T'inquiète, j'ai une idée !"
msgstr "Relaxa, tive uma ideia!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_973efdac"
msgid "Oh putain, je sens déjà les nouveaux problèmes arriver à grande vitesse."
msgstr "Puta que o pariu, já estou até vendo os problemas chegando a mil por hora."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_14be133d"
msgid "Est-ce que je devrais laisser {{asami.n}} interagir avec {{noriko.n}} ?"
msgstr "Será que eu deixo a {{asami.n}} interagir com a {{noriko.n}}?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_fd5b0df6"
msgid "Je crois qu'il est trop tard..."
msgstr "Acho que já é tarde demais..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8540993c"
msgid "Putain, je t'ai déjà dit de me l-"
msgstr "Porra, eu já te disse para me dei-"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9c34fdb7"
msgid "Euh... T'es qui toi ?"
msgstr "Er... Quem é você?"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a8870111"
msgid "Bonjour ! Je suis la petite amie de {{saito.n}}."
msgstr "Olá! Eu sou a namorada do {{saito.n}}."

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_aef18ea2"
msgid "Je... La quoi ?"
msgstr "Eu... A o quê?"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0abec66e"
msgid "J'ai aussi une très forte libido, donc il est possible que tu nous entendes."
msgstr "Eu também tenho um libido muito alto, então é bem provável que você ouça a gente."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b4e40eb1"
msgid "Il y aura du sexe, énormément de sexe."
msgstr "Vai rolar sexo, muito sexo."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d9007c9d"
msgid "Donc à l'avance, j'aimerais m'excuser pour le dérangement."
msgstr "Então, já peço desculpas adiantadas pelo incômodo."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b2166ecf"
msgid "Mais... n-"
msgstr "Mas... nã-"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_4125cfb9"
msgid "Ravi d'avoir fait ta connaissance, à bientôt, j'espère ?"
msgstr "Prazer em te conhecer, espero que a gente se veja logo!"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_968d5254"
msgid "Tu viens mon étalon ?"
msgstr "Vem comigo, bonitão."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_bba66073"
msgid "Mais, mais, mais..."
msgstr "Mas, mas, mas..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_03775ec8_1"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ffbcae01"
msgid "Mais bordel ![w] Elle sort d'où celle-là ?"
msgstr "Mas que porra![w] De onde saiu essa daí?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0f357fe3"
msgid "Est-ce qu'elle sera là encore aujourd'hui ?"
msgstr "Aquela garota vai estar lá hoje de novo?"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b788e577"
msgid "...de qui tu parles ?"
msgstr "...De quem você está falando?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3d71a587"
msgid "Tss, de la fille qui était là hier !"
msgstr "Tsc, da garota que estava aqui ontem!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6cdea237"
msgid "En quoi ça te regarde ?"
msgstr "O que isso te importa?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c2ed8c01"
msgid "...Je... Je veux juste savoir."
msgstr "...Eu... Eu só quero saber."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_bcd4e942"
msgid "Je te le dis si tu me dis pourquoi tu tiens tant à le savoir."
msgstr "Eu te conto se você me disser por que quer tanto saber."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_31b3eb64"
msgid "Je... VA TE FAIRE FOUTRE !"
msgstr "Eu... VAI PRO INFERNO!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_4e9a0092"
msgid "Cette fille est vraiment une énigme."
msgstr "Essa garota é mesmo um enigma."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e0631166"
msgid "Je ne comprends rien à ses réactions..."
msgstr "Não entendo nada das reações dela..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_eedbba89"
msgid "Peu importe..."
msgstr "Tanto faz..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7b6de4f1"
msgid "Bon, je peux savoir pourquoi tu passes ton temps à écouter à ma porte ?"
msgstr "Bom, posso saber por que você passa o tempo todo ouvindo atrás da minha porta?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_743afa02"
msgid "J'- je n'écoutais pas à ta porte !"
msgstr "Eu- eu não estava ouvindo atrás da sua porta!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e733a60e"
msgid "Donc, tu me dis que tu as passé ton après-midi dans le couloir pour... ?"
msgstr "Então você está me dizendo que passou a tarde no corredor para... ?"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_23deb4f6"
msgid "Ça te regarde pas !"
msgstr "Não te interessa!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ced872a9"
msgid "Sérieusement, c'est quoi ton problème ?"
msgstr "Sério, qual é o seu problema?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e1b36b7c"
msgid "J'essaye de te parler, tu m'envoies chier, je t'ignore, tu m'envoies chier aussi."
msgstr "Eu tento falar com você, você me manda à merda. Eu te ignoro, você me manda à merda também."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8f217dd2"
msgid "Franchement, je ne sais plus comment agir avec toi..."
msgstr "Sinceramente, não sei mais como agir com você..."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a48aba28"
msgid "T'as pas le droit..."
msgstr "Você não tem o direito..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0458b6ed"
msgid "De quoi ?"
msgstr "Você não tem o direito..."

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7b43a022"
msgid "Tu n'as pas le droit d'agir comme tu fais avec moi, et du jour au lendemain totalement m'ignorer !"
msgstr "Você não tem o direito de agir como agia comigo e, de um dia para o outro, me ignorar totalmente!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_269b7a36"
msgid "Ne me dites pas qu'elle est jalouse en faite ?"
msgstr "Não me diga que ela está com ciúme, na verdade?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_076ebe10"
msgid "Malgré que je la fasse chanter, elle en redemande ?"
msgstr "Mesmo eu chantageando ela, ela ainda quer mais?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e0287887"
msgid "Même si j'ai demandé à couper les ponts, elle en redemande ?"
msgstr "Mesmo eu tendo cortado relações, ela ainda quer mais?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c4f15d27"
msgid "Même si j'ai agi de manière agressive, elle en redemande ?"
msgstr "Mesmo eu tendo agido de forma agressiva, ela ainda quer mais?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_43b51905"
msgid "Elle doit penser que je suis sa chose..."
msgstr "Ela deve achar que eu sou propriedade dela..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_bcfdd470"
msgid "Est-ce que je dois considérer ça comme une bonne chose ?"
msgstr "Devo considerar isso uma coisa boa?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c58c0217"
msgid "L'avenir le dira bien assez tôt."
msgstr "O futuro dirá bem rápido."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_89994af6"
msgid "Bref, allons voir {{kimochi.n}}."
msgstr "Enfim, vamos ver o {{kimochi.n}}."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6f32d5ab"
msgid "Pfff, c'est ta chambre avec toutes les pancartes interdiction d'entrer ?"
msgstr "Pfff, esse é o seu quarto, com todas essas placas de \"proibido entrar\"?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_737d0581"
msgid "Non justement... C'est la chambre à éviter."
msgstr "Não, na verdade... Esse é o quarto que deve ser evitado."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_61f71d48"
msgid "D'ailleurs si tu permets j'aimerais éviter de trop traîner dans le couloir avant qu'elle n-"
msgstr "Aliás, se me permite, eu adoraria não ficar moscando aqui no corredor antes que ela apare-"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7a04f3c3"
msgid "Hey je t'ai déjà dit d'arrêter d'écouter à ma p-"
msgstr "Ei, eu já te disse pra parar de ouvir atrás da minha por-"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_13a6eff2"
msgid "Salut !"
msgstr "Oi!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f0ff7c37"
msgid "Une seconde... depuis quand tu ramènes des filles toi ?"
msgstr "Espera um segundo... desde quando você traz garotas pra cá?"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8eb8dfa4"
msgid "J'ai fait sa rencontre aujourd'hui et il a tenu absolument à m'emmener dans sa chambre !"
msgstr "Conheci ele hoje e ele insistiu muito pra me trazer pro quarto dele!"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9a1bdf87"
msgid "Je devrais m'inquiéter ?"
msgstr "Eu deveria me preocupar?"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e598b3e2"
msgid "Oui tu ferais bien... Regarde pas trop la poubelle de mouchoirs sous son bureau, t'a pas envie de savoir ce qu'elle contient."
msgstr "Sim, seria bom... Não olha muito pro lixo de lenços debaixo da mesa dele, você não vai querer saber o que tem ali."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_40288dea"
msgid "Hey !"
msgstr "Ei!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_23ae582e"
msgid "C'est plutôt curieux de la part d'une fille qui passe son temps à mater du porno pendant la journée !"
msgstr "Isso é bem curioso vindo de uma garota que passa o dia assistindo pornô!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_52bc9f4a"
msgid "Pff... N'importe quoi."
msgstr "Pff... Nada a ver."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_29b0a25f"
msgid "Haha ! Vous me faites rire tous les deux."
msgstr "Haha! Vocês dois são engraçados."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_60722655"
msgid "Allez montre-moi ta chambre monsieur le pervers !"
msgstr "Vamos, me mostra o seu quarto, seu pervertido!"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3f6b8829"
msgid "Tu viens {{noriko.n}} ?"
msgstr "Você vem, {{noriko.n}}?"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3fa93862"
msgid "Je..."
msgstr "Eu..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0c7836ac"
msgid "N'y pense même pas..."
msgstr "Nem pense nisso..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_04a57020"
msgid "[font_size=14]Bien sur, impossible que je te laisse seule avec un détraqué pareille ![/font_size]"
msgstr "[font_size=14]Com certeza! É impossível eu te deixar sozinha com um maluco desses![/font_size]"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b3062610"
msgid "Fait chier..."
msgstr "Que merda..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e745c66b"
msgid "Qu'est-ce que tu voulais à ma mère ?!"
msgstr "O que você queria com a minha mãe?!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d0016190"
msgid "...je ne voulais rien de \"ta mère\" comme tu aimes si bien me le rappeler."
msgstr "...eu não queria nada da \"sua mãe\", como você adora me lembrar."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e226b9a5"
msgid "Je m'inquiétais seulement pour elle, elle n'a pas l'air d'aller bien."
msgstr "Eu só estava preocupado com ela, ela não parece estar bem."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_4c25f6c6"
msgid "Pfff, c'est parce qu'elle en a marre de se taper un parasite à nourrir en plus !"
msgstr "Pfff, é porque ela está cansada de ter que sustentar um parasita a mais!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_adcfa2f8"
msgid "{{noriko.n}}, je ne sais pas pourquoi tu m'en veux autant, mais là..."
msgstr "{{noriko.n}}, não sei por que você me odeia tanto, mas agora..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e9acf82c"
msgid "Il ne s'agit pas de moi, il s'agit de {{yasuka.n}}."
msgstr "Não se trata de mim, se trata da {{yasuka.n}}."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_135c61cb"
msgid "Okay, okay, c'est quoi le problème ?"
msgstr "Tá, tá, qual é o problema?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_15d5db41"
msgid "Tu veux bien m'aider ?"
msgstr "Você quer me ajudar?"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_084c177c"
msgid "On verra, explique-moi rapidement ce qui se passe et dépêche-toi, j'ai... un film à regarder."
msgstr "Veremos. Me explica logo o que tá rolando e rápido, eu tenho... um filme pra ver."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0c195e5e"
msgid "Oh putain !"
msgstr "Puta merda!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_116e3ce3"
msgid "C'est la première fois que je vais discuter avec elle normalement."
msgstr "É a primeira vez que vou conversar com ela normalmente."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2596ba92"
msgid "C'est sûr, quelque chose de grave va arriver."
msgstr "Com certeza algo de muito ruim vai acontecer."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6f69bdc4"
msgid "Son patron est un véritable connard."
msgstr "O patrão dela é um completo babaca."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ed1ec753"
msgid "Il passe son temps à la rabaisser."
msgstr "Ele passa o tempo todo humilhando ela."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f88cf04f"
msgid "À l'insulter."
msgstr "Insultando."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c4cdc2ba"
msgid "À lui faire perdre toute confiance et estime de soi."
msgstr "Fazendo ela perder toda a confiança e autoestima."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_35fcc418"
msgid "Attends, attends, ce type a le même caractère que toi en fait !"
msgstr "Espera aí, esse cara tem o mesmo temperamento que você, na real!"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0d280c18"
msgid "VA TE FAIRE FOUTRE !"
msgstr "VAI PRO INFERNO!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9a99b625"
msgid "Zut, j'aurais dû fermer ma bouche."
msgstr "Droga, eu deveria ter ficado de boca fechada."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_992d067e"
msgid "Peu importe... Je ne sais pas trop en quoi elle aurait pu m'aider."
msgstr "Tanto faz... não sei como ela poderia ter me ajudado mesmo."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0d7bfc80"
msgid "Je retournerai soutenir {{yasuka.n}} demain."
msgstr "Vou voltar pra apoiar a {{yasuka.n}} amanhã."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_5a183b7b"
msgid "Alors ?"
msgstr "E aí?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_209ab0a4_1"
msgid "Alors quoi ?"
msgstr "E aí o quê?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_157cea2f"
msgid "Comment ça se passe avec l'autre gros porc ?"
msgstr "Como estão as coisas com aquele porco nojento?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a3675e6c"
msgid "J'y crois pas, elle s'inquiète à nouveau pour moi ?"
msgstr "Não acredito, ela tá preocupada comigo de novo?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a6f11724"
msgid "Elle en deviendrait presque mignonne."
msgstr "Ela chega a ser quase fofa assim."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_981d9b9c"
msgid "C'est bien pire que tout ce que j'avais pu imaginer..."
msgstr "É muito pior do que eu podia imaginar..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7cce16ad"
msgid "Je ne sais pas s'il faisait subir le même traitement à {{yasuka.n}}."
msgstr "Não sei se ele fazia a {{yasuka.n}} passar pelo mesmo tratamento."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3c7c43b4"
msgid "Mais si c'est le cas...[w] Je me demande comment elle a fait toutes ses années pour tenir le coup."
msgstr "Mas se for o caso...[w] eu me pergunto como ela aguentou firme todos esses anos."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_29cd7803_4"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_5216a38b"
msgid "Tu vas continuer ?"
msgstr "Você vai continuar?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_080106a5"
msgid "Pour le moment, je n'ai pas trop le choix, je cherche une solution."
msgstr "No momento não tenho muita escolha, tô tentando achar uma solução."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f63158b6"
msgid "Je..."
msgstr "Eu..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d2018b57"
msgid "Oui ?"
msgstr "Sim?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_fafb3074"
msgid "Je peux faire quelque chose pour aider ?"
msgstr "Tem algo que eu possa fazer pra ajudar?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0ee441d7"
msgid "Pour le moment... pas grand-chose."
msgstr "Por enquanto... nada."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7a8efef1"
msgid "À part trouver un moyen de pression pour qu'il lâche l'affaire."
msgstr "A não ser achar algum podre dele pra ele largar do pé dela."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e6bc8dfe"
msgid "Mais cette ordure est trop malin."
msgstr "Mas esse lixo é muito esperto."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a6f7dd56"
msgid "Dès que j'en sais plus, je te tiendrais au courant, ça te va ?"
msgstr "Assim que eu souber de algo, te aviso, pode ser?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_29cd7803_5"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_667d1fd7"
msgid "Okay... Pars sans rien dire."
msgstr "Tá... vai embora sem dizer nada então."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_40f0691a"
msgid "Je suppose que notre relation s'améliore, mais il faut pas en demander trop non plus."
msgstr "Acho que a nossa relação tá melhorando, mas também não dá pra exigir demais."

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9a37c39d"
msgid "Quoi mais... C'était toi dans la salle de bain ?"
msgstr "O que... era você no banheiro?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6857d684"
msgid "Eh bien, si j'en sors logiquement..."
msgstr "Bom, se eu estou saindo de lá, a lógica diz que sim..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8c76442d"
msgid "Je dois te parler de quelque chose, allons dans ma chambre !"
msgstr "Preciso falar com você, vamos pro meu quarto!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ac7bad1c"
msgid "D'accord..."
msgstr "Tá bom..."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_41a61ae0"
msgid "...Si tu cherches maman, elle est déjà partie !"
msgstr "...Se tá procurando a minha mãe, ela já saiu!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f0791c35"
msgid "Ah... Tu sais où exactement ?"
msgstr "Ah... E você sabe pra onde exatamente?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_50e452d8"
msgid "À la boutique... Enfin... À sa boutique maintenant grâce à toi."
msgstr "Pra loja... Enfim... Pra loja dela agora, graças a você."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_205b6f2a"
msgid "Je ne sais pas ce que tu as fait mais..."
msgstr "Não sei o que você fez, mas..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_237fdb4e"
msgid "Mais ?"
msgstr "Mas?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_4bef5e3c"
msgid "Ça ne va pas nous retomber dessus ?"
msgstr "Isso não vai acabar sobrando pra gente?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_33ce1e7d"
msgid "Il n'y a désormais plus aucun problème."
msgstr "Não tem mais problema nenhum."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9c75f5df"
msgid "Tout est derrière nous présent."
msgstr "Tudo isso já ficou pra trás agora."

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_564552da"
msgid "Je vois..."
msgstr "Entendi..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_857e862a"
msgid "Merci pour tout ce que tu as fait, je suppose que finalement, tu ne te débrouilles pas si mal..."
msgstr "Obrigada por tudo o que você fez. Acho que, no fim das contas, você não é tão inútil assim..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "t932ee96c2f"
msgid "Mentir"
msgstr "Mentir"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_fbd61959"
msgid "Je pense que je me suis encore attiré des problèmes."
msgstr "Acho que acabei arrumando mais problema pra mim."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_29cd7803_6"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2e6175de"
msgid "Dis-moi si jamais tu as besoins d'aide..."
msgstr "Me avisa se você precisar de ajuda..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "t07a81b3e07"
msgid "Dire la vérité"
msgstr "Dizer a verdade"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_fbb10484"
msgid "Je... Je ne m'attendais pas à ça !"
msgstr "Eu... Eu não esperava por essa!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b4a7c493"
msgid "Surtout venant de toi !"
msgstr "Ainda mais vindo de você!"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_059870ea"
msgid "Hey, pour qui tu me prends ?"
msgstr "Ei, qual é a sua?! Tá me achando com cara de quê?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_21cf31c8"
msgid "Excuse-moi, c'est juste que je n'ai pas l'habitude que tu sois aussi gentille avec moi."
msgstr "Mal aí, é que eu não tô acostumado com você sendo legal comigo."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_24bbf4e1"
msgid "...Oui et bien... t'habitues pas trop !"
msgstr "...É, bom... não se acostuma muito não!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2dfa85ad"
msgid "On aura tout vu..."
msgstr "Essa é nova..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7e0d4eb8"
msgid "Mais je suis content de voir qu'elle peut se comporter comme ça avec moi maintenant."
msgstr "Mas fico feliz de ver que ela consegue me tratar assim agora."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_1dffa0c4"
msgid "Alors ? Parait que tu t'es fait courser dans toute la ville ?"
msgstr "E aí? Parece que você foi perseguido pela cidade inteira, hein."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c5a36d37"
msgid "Qu'est-ce que tu veux ?"
msgstr "O que você quer?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0bf04af4"
msgid "Tu veux encore te foutre de moi ?"
msgstr "Vai querer tirar sarro da minha cara de novo?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_569a2c46"
msgid "Tu peux continuer si tu veux, mais moi, je vais dormir."
msgstr "Pode continuar se quiser, mas eu vou dormir."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ac0d401c"
msgid "[font_size=14]Mais je t'en prie continue ! Fait comme si j'étais là[/font_size]"
msgstr "[font_size=14]Mas por favor, continue! Faz de conta que eu ainda tô ai.[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_86b507cb"
msgid "Mais j-"
msgstr "Mas e-"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3d7b6407_1"
msgid "Connard !"
msgstr "Babaca!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_fcbdf7a3"
msgid "...Zut."
msgstr "...Droga."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "POURQUOI_MAMAN_EST_EN_TRAIN_DE_653171"
msgid "Pourquoi maman est en train de pleurer ?"
msgstr "Por que a mamãe tá chorando?"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "QU_EST_CE_QUE_TU_LUI_AS_DIT_8B1A8D"
msgid "Qu'est-ce que tu lui as dit ?"
msgstr "O que você disse pra ela?"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "RIEN_DE_PARTICULIER_LA_JOURN_E_3AB6A1"
msgid "Rien de particulier, la journée a été difficile donc s'il te plaît ne viens pas en remettre une couche."
msgstr "Nada demais, o dia foi pesado, então por favor não vem encher o saco também."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_SAIS_SI_VIVRE_ICI_POSE_AUTA_9B9207"
msgid "Tu sais, si vivre ici pose autant de problèmes, tu devrais peut-être envisager de partir !"
msgstr "Sabe, se o fato de você morar aqui causa tanto problema, talvez devesse pensar em ir embora!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_AS_ENVIE_QUE_JE_PARTE_C_EST_29C2DC"
msgid "Tu as envie que je parte, c'est bien ça ?"
msgstr "Você quer que eu vá embora, é isso?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "CARR_MENT_MAIS_B8C286"
msgid "Carrément, mais..."
msgstr "Com certeza, mas..."

#. Character:`saito` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "EH_BIEN_DANS_CE_CAS_TROUVE_TOI_430A13"
msgid "Eh bien dans ce cas trouve-toi un job et aide-nous à rembourser les dettes."
msgstr "Então faz o seguinte: arruma um emprego e ajuda a pagar as dívidas."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "SINON_J_AI_BIEN_PEUR_D_TRE_L_E_6E0A30"
msgid "Sinon j'ai bien peur d'être là encore un certain temps..."
msgstr "Caso contrário, receio que ainda vou ficar por aqui um bom tempo..."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_NON_J_AI_PAS_BESOIN_DE_JE_N_57DCF8"
msgid "Je... non, j'ai pas besoin de... je ne suis pas pressée que..."
msgstr "Eu... não, não preciso que... eu não tô com pressa que..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "C_EST_BIEN_CE_QUE_JE_PENSAIS_S_A9B7F2"
msgid "C'est bien ce que je pensais, sur ce, bonne nuit !"
msgstr "Foi o que eu pensei. Enfim, boa noite!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "ZUT_C_EST_PAS_CE_QUE_JE_VOULAI_D39A77"
msgid "Zut... C'est pas ce que je voulais dire..."
msgstr "Droga... não era isso que eu queria dizer..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_DEVRAIS_VITER_DE_TRA_NER_AV_CDA578"
msgid "Tu devrais éviter de traîner avec cette fille."
msgstr "Você devia parar de andar com essa garota."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_corridor.dialogue
msgctxt "QUI_A_SAKUYA_N_POURQUOI_6701E9"
msgid "Qui ça, {{sakuya.n}} ? Pourquoi ?"
msgstr "Quem, a {{sakuya.n}}? Por quê?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "ELLE_EST_FOLLE_A_SE_VOIT_DES_K_6F1434"
msgid "Elle est folle, ça se voit à des kilomètres !"
msgstr "Ela é louca, dá pra ver de longe!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "BON_A_SUFFIT_AVEC_SAKUYA_N_FOU_1B280E"
msgid "Bon... ça suffit avec {{sakuya.n}}, foutez-lui la paix."
msgstr "Tá... chega de falar da {{sakuya.n}}, deixa ela em paz."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "C_EST_QUELQU_UN_AVEC_QUI_J_APP_014CCA"
msgid "C'est quelqu'un avec qui j'apprécie beaucoup discuter, elle déborde de gentillesse."
msgstr "Eu gosto muito de conversar com ela, ela é gente boa demais."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "HONN_TEMENT_C_EST_PLUT_T_TOI_Q_DA45DB"
msgid "Honnêtement c'est plutôt toi qui devrais apprendre à la connaître..."
msgstr "Sinceramente, você que devia aprender a conhecer ela melhor..."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "ET_ASAMI_N_DANS_TOUT_A_24CB18"
msgid "Et {{asami.n}} dans tout ça ?!"
msgstr "E a {{asami.n}} nessa história toda?!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "JUSQU_PREUVE_DU_CONTRAIRE_JE_N_A6A13A"
msgid "Jusqu'à preuve du contraire je ne suis pas en relation avec elle."
msgstr "Até que me provem o contrário, não tenho nada com ela."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "NOUS_SOMMES_JUSTE_AMIS_DONC_J_7E8E35"
msgid "Nous sommes juste amis donc j'ai encore le droit de faire ce que je veux avec qui je veux."
msgstr "Somos só amigos, então eu ainda tenho o direito de fazer o que eu quiser com quem eu quiser."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "C_EST_JUSTE_UNE_COLL_GUE_DE_TR_A2576B"
msgid "C'est juste une collègue de travail qui m'apprécie, rien de plus."
msgstr "Ela é só uma colega de trabalho que gosta de mim, nada mais."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "A_N_IRA_PAS_PLUS_LOIN_QUE_A_814EF0"
msgid "Ça n'ira pas plus loin que ça."
msgstr "Não vai passar disso."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_corridor.dialogue
msgctxt "HONN_TEMENT_ELLE_SERA_CAPABLE_5C443B"
msgid "Honnêtement... Elle sera capable de lui demander de se joindre à nous..."
msgstr "Sinceramente... ela seria capaz de pedir pra ela se juntar a nós..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "ET_PUIS_DE_TOUTE_FA_ON_EN_QUOI_4208C1"
msgid "Et puis de toute façon, en quoi ça te regarde ?"
msgstr "E de qualquer jeito, o que você tem a ver com isso?"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "MAIS_JE_A06972"
msgid "Mais... je..."
msgstr "Mas... eu..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_371a93f7"
msgid "[font_size=14]... et du coup, c'était douloureux ?[/font_size]"
msgstr "[font_size=14]... e aí, doeu muito?[/font_size]"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a53bb4c3"
msgid "[font_size=14]Oui au début, mais c'est de sa faute aussi, son truc fait la taille de mon avant-bras...[/font_size]"
msgstr "[font_size=14]Sim, no começo, mas a culpa é dele também, o negócio dele é do tamanho do meu antebraço...[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_eff90644"
msgid "[font_size=14]Oui, je sais, c'est fou ![/font_size]"
msgstr "[font_size=14]É, eu sei, é bizarro![/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8630eb0d"
msgid "[font_size=14]Il m'avait presque déboîté la mâchoire qu-[/font_size]"
msgstr "[font_size=14]Ele quase deslocou minha mandíbula quan-["

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_359c8e4b"
msgid "Oh bordel, non !"
msgstr "Puta merda, não!"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c4ca2175"
msgid "[font_size=14]Comment ça il t'a déboîtée la mâchoire !?[/font_size]"
msgstr "[font_size=14]Como assim ele deslocou sua mandíbula!?[/font_size]"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_eb19f629"
msgid "[font_size=14]Comment ça... tu sais ?[/font_size]"
msgstr "[font_size=14]Como assim... você sabe?[/font_size]"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_4edb2b84"
msgid "[font_size=14]Tu veux dire que toi et lui, vous avez déjà... ?[/font_size]"
msgstr "[font_size=14]Tá querendo dizer que você e ele já... ?[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_30355ad7"
msgid "NONN !!!"
msgstr "NÃOO!!!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_af7c4207"
msgid "[font_size=14]Euh non... je veux dire, je l'ai vu qui prenait sa douche et j'ai vu...[/font_size]"
msgstr "[font_size=14]Er, não... quero dizer, eu vi ele tomando banho e vi...[/font_size]"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_44744deb"
msgid "[font_size=14]Oh ! Mais oui, je suis bête, j'imagine toujours des situations extrêmes ![/font_size]"
msgstr "[font_size=14]Ah! Nossa, que burra eu sou, fico sempre imaginando o pior![/font_size]"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ca116351"
msgid "[font_size=14]Du coup, t'a jamais eu envie de...[/font_size]"
msgstr "[font_size=14]Mas e aí, você nunca teve vontade de...[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_99a59198"
msgid "[font_size=14]Mais... Je comprends pas, vous n'êtes pas ensemble ?[/font_size]"
msgstr "[font_size=14]Mas... não entendo, vocês não estão juntos?[/font_size]"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f35f7667"
msgid "[font_size=14]Non... ça a failli, c'est pas comme s'il ne me plaisait pas mais...[/font_size]"
msgstr "[font_size=14]Não... quase rolou, não é como se eu não estivesse a fim, mas...[/font_size]"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_41aec1ff"
msgid "[font_size=14]Il a préféré agir comme un ami plutôt que profiter de moi dans un moment où je n'avais pas les idées en ordre...[/font_size]"
msgstr "[font_size=14]Ele preferiu agir como amigo em vez de se aproveitar de mim num momento em que eu estava confusa...[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8b400eea"
msgid "[font_size=14]Tsss... Je ne suis même pas étonnée.[/font_size]"
msgstr "[font_size=14]Tsc... não fico nem surpresa.[/font_size]"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e0cd0fb3"
msgid "Bordel, faut que j'arrête cette discussion immédiatement !"
msgstr "Droga, tenho que acabar com essa conversa agora mesmo!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_beb86366"
msgid "Ça va, tu t'es bien amusée avec {{noriko.n}} ?"
msgstr "E aí, se divertiu com a {{noriko.n}}?"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_14d7fddd"
msgid "Ouiii, tu sais, elle est pas si terrible que ça."
msgstr "Simmm! Sabe, ela não é tão ruim assim."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_c2bd48aa"
msgid "Tu devrais peut être lui accorder un peu plus d'attention et je suis sûre que vous vous entendriez à merveille."
msgstr "Você devia dar um pouco mais de atenção pra ela, tenho certeza que vocês se dariam super bem."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_520c88a3"
msgid "Peut-être..."
msgstr "Pode ser..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_008c95f3"
msgid "Bon, je suppose que tu n'es pas venue ici pour discuter de {{noriko.n}} ?"
msgstr "Bom, imagino que você não veio aqui pra falar da {{noriko.n}}, né?"

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2079403a"
msgid "Non idiot ! J'étais venue pour passer un moment tranquille avec toi et peut-être même plus encore mais... Je ne savais pas qu'il y avait autant de monde chez toi."
msgstr "Não, seu bobo! Eu vim pra gente ficar um tempo de boa e talvez até algo mais, mas... eu não sabia que tinha tanta gente na sua casa."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_be80cc7a"
msgid "Non idiot ! J'étais venue pour passer un moment tranquille avec toi et jouer à la console toute la journée mais... Je ne savais pas qu'il y avait autant de monde chez toi."
msgstr "Não, seu bobo! Eu vim pra gente ficar de boa e jogar videogame o dia todo, mas... eu não sabia que tinha tanta gente na sua casa."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b5b06397"
msgid "Oui... désolé, ce matin, c'était assez mouvementé."
msgstr "É... mal aí, hoje de manhã foi bem movimentado."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_cedc81b1"
msgid "Tu sais quoi ? On va aller chez moi !"
msgstr "Quer saber? Vamos pra minha casa!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_ES_S_RE_1083EE"
msgid "Tu es sûre ?"
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_player_corridor.dialogue
msgctxt "ON_AURA_PROBABLEMENT_MA_M_RE_S_80573B"
msgid "On aura probablement ma mère sur le dos mais c'est pas grave."
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "ON_NE_POURRAS_PAS_TOUJOURS_L_E_0A3F1E"
msgid "On ne pourra pas toujours l'esquiver."
msgstr ""

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "BON_SANG_MAIS_T_AS_PAS_BIENT_T_4F4A10"
msgid "Bon sang, mais t'as pas bientôt fini de beugler comme ça ?"
msgstr "Caramba, você não vai parar de berrar desse jeito não?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_SAIS_QUOI_JE_SUIS_CONTENT_D_F41226"
msgid "Tu sais quoi, je suis content de te voir !"
msgstr "Sabe de uma coisa? Estou feliz em te ver!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "OUI_EH_BIEN_JE_NE_PEUX_PAS_EN_02B93F"
msgid "Oui, eh bien, je ne peux pas en dire autant, tu n'as pas vu maman ?"
msgstr "É, bom, eu não posso dizer o mesmo. Você não viu a minha mãe?"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "W_C_EST_JUSTEMENT_A_LE_PROBL_E3C20C"
msgid "...[w] C'est justement ça le problème."
msgstr "...[w] É justamente esse o problema."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "COMMENT_A_UN_PROBL_ME_A84E65"
msgid "Comment ça, un problème ?"
msgstr "Como assim, \"o problema?\""

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_CROIS_QUE_SAKUYA_N_S_EN_EST_D946B2"
msgid "Je crois que {{sakuya.n}} s'en est prise à elle et qu'elle a l'intention de s'en prendre à toutes celles qui sont proches de moi."
msgstr "Eu acho que a {{sakuya.n}} atacou ela, e ela pretende fazer o mesmo com todo mundo que é próximo de mim."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "AH_OUAIS_EH_BIEN_J_AIMERAIS_BI_023154"
msgid "Ah ouais ? Eh bien, j'aimerais bien voir ça ! Je l'attends de pied ferme !"
msgstr "Ah é? Pois eu adoraria ver isso! Tô esperando ela de braços abertos!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "ALLONS_REJOINDRE_ASAMI_N_DANS_51DE2A"
msgid "... Allons rejoindre {{asami.n}} dans le salon."
msgstr "... Vamos encontrar a {{asami.n}} na sala."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "QUOI_TU_CROIS_QUE_JE_NE_PEUX_P_AD5CE2"
msgid "Quoi, tu crois que je ne peux pas botter le cul de cette grande perche ?"
msgstr "O quê, você acha que eu não dou conta de chutar a bunda dessa vara pau?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "NORIKO_N_E6A671"
msgid "{{noriko.n}} ?"
msgstr "{{noriko.n}} ?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "FONT_SIZE_14_BON_SANG_TU_NE_P_247B4D"
msgid "[font_size=14]Bon sang... Tu ne pouvais pas me laisser aller aux toilettes tranquille ?[/font_size]"
msgstr "[font_size=14]Droga... Você não podia me deixar ir ao banheiro em paz?[/font_size]"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "D_SOL_W_ELLE_EST_CAPABLE_DE_TO_7976F8"
msgid "Désolé...[w] Elle est capable de tout et je ne voudrais pas qu'elle s'en prenne à toi aussi."
msgstr "Desculpa...[w] Ela é capaz de tudo e eu não queria que ela te pegasse também."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_ES_LITT_RALEMENT_LA_SEULE_P_3B2593"
msgid "Tu es littéralement la seule personne qu'il me reste."
msgstr "Você é literalmente a única pessoa que me restou."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "FONT_SIZE_14_JE_NE_SAIS_PAS_S_49DADD"
msgid "[font_size=14]Je ne sais pas si le moment est bien choisi pour ce genre de discussion.[/font_size]"
msgstr "[font_size=14]Não sei se o momento é o melhor pra esse tipo de conversa.[/font_size]"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_SAIS_PARDON_74B735"
msgid "Je sais, pardon..."
msgstr "Eu sei, foi mal..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "FONT_SIZE_14_ARR_TE_DE_T_EN_F_655348"
msgid "[font_size=14]Arrête de t'en faire, je suis littéralement enfermée à clé, par où veux-tu qu'elle passe pour s'en prendre à moi ?[/font_size]"
msgstr "[font_size=14]Para de se preocupar, eu tô literalmente trancada à chave. Por onde você acha que ela passaria pra me pegar?[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "FONT_SIZE_14_SAITO_N_TU_ES_TO_42DFFC"
msgid "[font_size=14]{{saito.n}}...? Tu es toujours là ?[/font_size]"
msgstr "[font_size=14]{{saito.n}}...? Você ainda tá aí?[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "FONT_SIZE_14_W_R_PONDS_MOI_TU_CEB8BE"
msgid "[font_size=14]...[w] Réponds-moi, tu commences à me faire peur.[/font_size]"
msgstr "[font_size=14]...[w] Me responde, você tá começando a me dar medo.[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "SAITO_N_4CAD51"
msgid "{{saito.n}} !!!!"
msgstr "{{saito.n}} !!!!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_cabcec15"
msgid "Où tu vas ?"
msgstr "Onde você vai?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f1b7c69f"
msgid "Au dojo."
msgstr "No dojo."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_48a09a2d"
msgid "Mais, je ne vois pas en quoi ça te regarde."
msgstr "Mas não vejo como isso te interessa."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_eec52dcc"
msgid "... Ça me regarde, car je suis sûre que tu vas encore t'attirer des ennuis."
msgstr "... Interessa porque eu tenho certeza que você vai se meter em encrenca de novo."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_94f25f06"
msgid "Et on va encore devoir te sauver les miches avec {{asami.n}}."
msgstr "E eu e a {{asami.n}} vamos ter que salvar a sua pele de novo."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "t99357b3de5"
msgid "Je ne me souviens pas t'avoir demandé ton avis."
msgstr "Não lembro de ter pedido a sua opinião."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "ET_MON_AVIS_MOI_DANS_TOUT_A_2336CA"
msgid "Et mon avis à moi dans tout ça ?"
msgstr ""

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "FAIS_CE_QUE_TU_VEUX_BC1E7F"
msgid "[hint=ROUTE FEMDOM]Fais ce que tu veux..."
msgstr ""

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "VA_TE_FAIRE_VOIR_9B7ECC"
msgid "...va te faire voir !"
msgstr ""

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e2193aca"
msgid "Je suppose qu'elle ne changera jamais..."
msgstr "Pelo visto ela não vai mudar nunca..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_VAIS_R_GLER_A_SEUL_JE_N_AI_0A6863"
msgid "[hint=ROUTE MALEDOM]Je vais régler ça seul, je n'ai pas besoin de toi !"
msgstr "[Dica: Rota Maledom] Eu vou resolver isso sozinho, não preciso de você!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_6ec3b905"
msgid "... Oui mais ça c'était avant !"
msgstr "... Sim, mas isso era antes!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_aae7545d"
msgid "Je peux... je veux m'occuper de ça moi-même cette fois-ci, donc merci pour la proposition mais non merci."
msgstr "Eu posso... eu quero cuidar disso sozinho desta vez. Agradeço a oferta, mas não, obrigado."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_877c0fed"
msgid "Je n'ai pas besoin de toi."
msgstr "Eu não preciso de você."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_4cec9d17"
msgid "... et bien va te faire voir !"
msgstr "... então vai se ferrar!"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_83f1b0bc"
msgid "[font_size=14]Ne t'inquiète pas, je vais lui toucher deux mots.[/font_size]"
msgstr "[font_size=14]Não se preocupa, vou trocar duas palavrinhas com ele.[/font_size]"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8c62971e"
msgid "[font_size=14]Je te jure qu'il va m'entendre ![/font_size]"
msgstr "[font_size=14]Eu juro que ele vai me ouvir![/font_size]"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_41bb8917"
msgid "Oh-ho, problèmes à l'horizon..."
msgstr "Ih, problemas à vista..."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7fe22c7a"
msgid "Toi !"
msgstr "Você!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b1d6112b"
msgid "Euh... quoi moi ?"
msgstr "Er... \"você\" o quê?"

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d66dd1a0"
msgid "Ne fais pas l'innocent ! Viens avec moi dans ta chambre, on doit discuter de certaines choses !"
msgstr "Não se faz de inocente! Vem comigo pro seu quarto, a gente precisa conversar!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_17c60c05"
msgid "Merde... Qu'est ce que {{noriko.n}} lui a raconté pour qu'elle réagisse comme ça ?"
msgstr "Merda... O que a {{noriko.n}} contou pra ela pra ela reagir assim?"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_5f1806cf"
msgid "[font_size=14]Immédiatement monsieur {{saito.n}} ![/font_size]"
msgstr "[font_size=14]Agora mesmo, senhor {{saito.n}}![/font_size]"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_790ae756"
msgid "Oulah... se faire appeler par son prénom dans ce genre de situation, c'est rarement un bon présage."
msgstr "Vixe... ser chamado de \"senhor\" nesse tipo de situação raramente é bom sinal."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f123ea5f"
msgid "Aller, un peu de courage, surtout te laisse pas faire !"
msgstr "Vamos lá, um pouco de coragem, não deixa ela montar em você!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0ef5a782"
msgid "Tout va bien se passer."
msgstr "Vai dar tudo certo."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8f8013e8"
msgid "{{noriko.n}} a changé après tout."
msgstr "Afinal, a {{noriko.n}} mudou."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2e128a10"
msgid "Bordel c'était quoi ça ?!"
msgstr "Mas que porra foi essa?!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f92b3f9f"
msgid "Je ne l'ai jamais vue aussi énervée contre moi."
msgstr "Eu nunca vi ela tão puta comigo assim."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2f3e95f6"
msgid "Bon sang... Je perds patience à chaque fois que j'interagis avec elle."
msgstr "Caramba... eu perco a paciência toda vez que tento falar com ela."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9b0b631e"
msgid "Les mensonges, ses liens avec {{akira.n}}..."
msgstr "As mentiras, os rolos dela com o {{akira.n}}..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_1db572c1"
msgid "Bordel mais qu'est ce que tu fous {{noriko.n}} ?!"
msgstr "Merda, o que é que você tá aprontando, {{noriko.n}}?!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ef84f8d8"
msgid "Est-ce que c'est à cause de ça que tu t'es faite tuer dans ma précédente vie ?"
msgstr "Será que foi por causa disso que você acabou morta na minha vida anterior?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3e013fe5"
msgid "Je vais devoir continuer de la suivre..."
msgstr "Vou ter que continuar seguindo ela..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_cfb18e92"
msgid "Avant qu'il ne soit trop tard."
msgstr "Antes que seja tarde demais."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_028371ac"
msgid "Que... Qu'est-ce qui vient de se passer là ?"
msgstr "O que... o que acabou de acontecer aqui?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_84e218e9"
msgid "Je... j'étais..."
msgstr "Eu... eu estava..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_eba788da"
msgid "Mais {{noriko.n}}, et..."
msgstr "Mas a {{noriko.n}}, e..."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f784edf6"
msgid "Tout va bien ?"
msgstr "Tá tudo bem?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0ea7260e"
msgid "Wow... Je ne t'avais pas entendue."
msgstr "Nossa... eu não te ouvi chegando."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9ec61ede"
msgid "Tu as l'air en état de choc."
msgstr "Você parece estar em estado de choque."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ff6c56af"
msgid "Toi tu t'es disputé avec {{noriko.n}} !"
msgstr "Você brigou com a {{noriko.n}}, não foi?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ba8d228d"
msgid "Je... Oui. Enfin je crois."
msgstr "Eu... é. Acho que sim."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d040475a"
msgid "{{kimochi.n}} nous attend chez lui pour faire le point sur la situation."
msgstr "O {{kimochi.n}} tá esperando a gente na casa dele pra falar da situação."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_50c77354"
msgid "Il a découvert certaines choses."
msgstr "Ele descobriu umas coisas."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_20901b20"
msgid "D'accord, j'arrive tout de suite."
msgstr "Beleza, já tô indo."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_629da202"
msgid "Je suis fatigué de tes petits jeux sournois {{noriko.n}}."
msgstr "Já tô cansado dos seus joguinhos sonsos, {{noriko.n}}."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7cb79f66"
msgid "Je sais que c'est toi qui est responsable de tout ça !"
msgstr "Eu sei que você é a responsável por tudo isso!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_df90f0b7"
msgid "J'ai besoin de m'allonger. Tu as intérêt à te trouver une bonne excuse d'ici là..."
msgstr "Preciso deitar um pouco. É bom você arrumar uma boa desculpa até lá..."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b96b4517"
msgid "M-"
msgstr "Ma-"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_29cd7803_7"
msgid "..."
msgstr "..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3b13464d"
msgid "Bon sang, c'était quoi ça ?"
msgstr "Caramba, o que foi aquilo?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d4589c13"
msgid "Merde {{noriko.n}}, pourquoi tu ne veux rien me dire ?"
msgstr "Merda, {{noriko.n}}, por que você não quer me contar nada?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_7452d276"
msgid "Quel putain d'idiot..."
msgstr "Que idiota eu sou..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_954a7335"
msgid "Je reproche à {{noriko.n}} ce que je faisais depuis le début."
msgstr "Eu tô cobrando da {{noriko.n}} a mesma coisa que eu venho fazendo desde o começo."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_0edb3cad"
msgid "En pensant pouvoir gérer mes problèmes moi-même je me rends compte que je n'ai fait qu'inquiéter ceux qui tenaient à moi."
msgstr "Achando que podia resolver meus problemas sozinho, agora percebo que só deixei quem se importa comigo preocupado."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d9539ee1"
msgid "J'étais vraiment à côté de la plaque."
msgstr "Eu tava mesmo por fora de tudo."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_528e73bd"
msgid "{{noriko.n}} peu importe ce qui s'est passé, tu pourras compter sur moi à partir de maintenant !"
msgstr "{{noriko.n}}, não importa o que aconteceu, você pode contar comigo de agora em diante!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_29cd7803_8"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t90f5acffaa"
msgid "Je peux savoir où tu vas ?"
msgstr "Posso saber onde você vai?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "t6b0817d6d5"
msgid "... Je ne vois pas en quoi ça te regarde."
msgstr "... Não vejo como isso te interessa."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t6c4376aab6"
msgid "Ça me concerne depuis que tu passes ton temps à t'attirer des problèmes."
msgstr "Interessa desde que você passou a gastar seu tempo se metendo em encrenca."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "t5392c14ef6"
msgid "Je vais au dojo..."
msgstr "Vou ao dojo..."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "t123c0249c6"
msgid "Non non, \"nous\" allons au dojo !"
msgstr "Nada disso, \"nós\" vamos ao dojo!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_corridor.dialogue
msgctxt "tc6ccb69884"
msgid "Quoi ?! Non, je peux me débrouiller sans toi."
msgstr "O quê?! Não, eu me viro sem você."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t746f84d886"
msgid "Peu importe ce que tu peux penser, je viens avec toi cette fois-ci."
msgstr "Não importa o que você acha, eu vou com você desta vez."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "tbabc5e0a15"
msgid "Que tu le veuilles ou non."
msgstr "Quer você queira ou não."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "t79d41d1b91"
msgid "...[w] Bon après tout, si ça peut te faire plaisir."
msgstr "...[w] Bom, já que você insiste tanto."

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_corridor.dialogue
msgctxt "tff74b889f6"
msgid "Parfait !"
msgstr "Perfeito!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a3e8e4fc"
msgid "Putain à quel point je suis tombé bas pour qu'on en vienne à se prendre la tête pour m'aider ?"
msgstr "Porra, quão baixo eu caí pra gente chegar ao ponto de brigar porque tentaram me ajudar?"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_5d0656e5"
msgid "Je répète les mêmes schemas que ma précédente vie... Je n'arrive pas à m'affirmer correctement."
msgstr "Tô repetindo os mesmos erros da minha vida anterior... não consigo me impor direito."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_90362c2d"
msgid "{{saito.n}} attend !"
msgstr "{{saito.n}}, espera!"

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_b1163c93"
msgid "Je suis vraiment désolée... Je ne voulais pas m'emporter contre {{noriko.n}}."
msgstr "Sinto muito... eu não queria ter perdido a paciência com a {{noriko.n}}."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_048c1b14"
msgid "Mais quand j'ai appris ce qu'elle t'avais forcé à faire.... ça m'a mise hors de moi."
msgstr "Mas quando soube o que ela te forçou a fazer... eu fiquei fora de mim."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_27498703"
msgid "Ne t'inquiète pas, je ne t'en veux pas du tout."
msgstr "Não se preocupa, não estou bravo com você."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_9839dba9"
msgid "{{noriko.n}} n'est pas quelqu'un qui sait faire preuve de tact."
msgstr "A {{noriko.n}} não é exatamente alguém que tem tato."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_59d70329"
msgid "Elle passera vite à autre chose comme à son habitude dès que ça la lassera."
msgstr "Ela logo vai cansar disso e partir pra outra, como sempre."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a4fc4062"
msgid "Hummm je n'en suis pas certaine... Il semble vraiment que cette situation l'angoisse beaucoup."
msgstr "Hummm, não tenho tanta certeza... parece que essa situação está deixando ela bem angustiada."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_cae88a0c"
msgid "Je pense que tu devrais sincèrement avoir une discussion avec elle."
msgstr "Acho que você deveria ter uma conversa séria com ela."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_15183c2b"
msgid "Je ne suis pas sûr que..."
msgstr "Não sei se..."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_88cb685b"
msgid "Mon chéri, fais moi confiance !"
msgstr "Querido, confia em mim!"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_bf8d799b"
msgid "{{saito.n}}, fais-moi confiance !"
msgstr "{{saito.n}}, confia em mim!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e8ae8d31"
msgid "...[w] Très bien, je vais aller la voir mais ne t'attends pas à un miracle non plus."
msgstr "...[w] Tudo bem, vou lá falar com ela, mas não espera nenhum milagre."

#. Character:`asami`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2420781b"
msgid "Ce sera toujours mieux que rien."
msgstr "Já vai ser melhor do que nada."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_419ee45c"
msgid "...Alors ?"
msgstr "...E aí?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d69513dd"
msgid "C'est bon, il est temps d'aller s'occuper de ces trois branleurs !"
msgstr "Tudo certo, tá na hora de dar um jeito naqueles três babacas!"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_ebe35646"
msgid "Parfait, j'avais peur que tu te defiles mais je suis contente de m'être trompée."
msgstr "Ótimo, achei que você fosse amarelar, mas fico feliz em estar errada."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_118d6e35"
msgid "On va commencer par le plus faible pour commencer."
msgstr "Vamos começar pelo mais fraco."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f975bc7d"
msgid "{{nobu.n}} ?"
msgstr "O {{nobu.n}}?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_75e68d19"
msgid "Oui, tu sais où on peut le trouver ?"
msgstr "Sim, você sabe onde a gente encontra ele?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_bd620019"
msgid "Aucune idée... Ce n'est pas comme si j'étais intime avec lui."
msgstr "Não faço ideia... não é como se eu fosse íntimo dele."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_1d90a5cc"
msgid "Et tête de bite ?"
msgstr "E o cabeça de pica?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_d6e21b05"
msgid "Tu veux dire {{kimochi.n}} ?[w] Il en saura peut être davantage."
msgstr "Você quer dizer o {{kimochi.n}}? [w] Ele deve saber de algo."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_8ec9247e"
msgid "Alors ne perdons pas de temps !"
msgstr "Então não vamos perder tempo!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_19dd51da"
msgid "Au fait...[w] Cette histoire de récompense ça tient toujours ?"
msgstr "A propósito... [w] aquela história da recompensa ainda tá de pé?"

#. Character:`noriko` | Attributes:`happy,blush`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_4b8cc7d0"
msgid "Bien sur !"
msgstr "Com certeza!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_3a49082e"
msgid "Je me demande bien ce que tu as préparé..."
msgstr "Fico imaginando o que você preparou..."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_57c01036"
msgid "Tu... Tu verras bien idiot !"
msgstr "Você... você vai ver, seu idiota!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2fef3103"
msgid "Bordel mais qu'est ce qui vient de se passer ?!"
msgstr "Caramba, o que foi que acabou de acontecer?!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_2424e376"
msgid "J'ai vraiment... fait... ça ?!"
msgstr "Eu realmente... fiz... aquilo?!"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_238f2903"
msgid "Elle voulait vraiment que je me mette a genoux pour..."
msgstr "Ela queria mesmo que eu ficasse de joelhos pra..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_a21e86ee_1"
msgid "..."
msgstr "..."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e512b865"
msgid "C'est complètement dingue."
msgstr "Isso é loucura total."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f9de7361"
msgid "Je ne pensais pas que mes actions modifieraient à ce point son comportement avec moi."
msgstr "Não achei que minhas ações mudariam tanto o comportamento dela comigo."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_f7df4fb0"
msgid "On est vraiment passés d'une extrême à l'autre."
msgstr "A gente foi de um extremo ao outro."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "home_player_corridor_e62d205a"
msgid "J'ai besoin de faire le vide... Il s'est passé bien trop de choses en trop peu de temps."
msgstr "Preciso esfriar a cabeça... foi coisa demais pra processar de uma vez só."

#. Character:`kimochi` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "t9931b8e595"
msgid "Allez, tu peux le faire !"
msgstr "Vai, você consegue!"

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "taacebc84dc"
msgid "Tu as rêvé de ça toute ta vie !"
msgstr "Você sonhou com isso a vida inteira!"

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "tfbb01380fe"
msgid "C'est ton moment, ne laisse personne te l'enlever !"
msgstr "É o seu momento, não deixa ninguém estragar!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_corridor.dialogue
msgctxt "tf01faab14a"
msgid "..."
msgstr "..."

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "t3944054ebd"
msgid "Ne dis rien ! Ne gâche pas mon heure de gloire !"
msgstr "Não diz nada! Não estraga meu momento de glória!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "te8e686c2f0"
msgid "Oh non, je t'en prie, vas-y ! Va te faire latter les couilles !"
msgstr "Ah não, por favor, vai lá! Vai lá levar um chute no saco!"

#. Character:`kimochi` | Attributes:`horny`
#: game/story/home_player_corridor.dialogue
msgctxt "t0f6371900e"
msgid "Et comment, mon frère !"
msgstr "Com certeza, meu irmão!"

#. Character:`kimochi` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "tcf664ac072"
msgid "{{noriko.n}} tiens-toi prête, j'arrive !"
msgstr "{{noriko.n}}, se prepara, que eu tô chegando!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t6663a9251c"
msgid "[font_size=14]Oh merde, c'est l'autre tête de bite ![/font_size]"
msgstr "[font_size=14]Ah, merda, é o outro cabeça de pica![/font_size]"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "t701acf2248"
msgid "Je me sens sale rien que de savoir ce qui va se passer là-dedans."
msgstr "Eu me sinto sujo só de saber o que vai rolar aí dentro."

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "t4d8fde1f4b"
msgid "[font_size=14]Je suis venu pour ma récompense ![/font_size]"
msgstr "[font_size=14]Vim buscar minha recompensa![/font_size]"

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "tf971475309"
msgid "[font_size=14]Tu n'as pas le droit de te défiler ![/font_size]"
msgstr "[font_size=14]Você não tem o direito de amarelar![/font_size]"

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "t698697627b"
msgid "[font_size=14]Et mais c'est sympa ici...[/font_size]"
msgstr "[font_size=14]Eita, mas que lugar legal...[/font_size]"

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "td1832a271f"
msgid "[font_size=14]Très mignon ![/font_size]"
msgstr "[font_size=14]Bem bonitinho![/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t0b8c0a7a3e"
msgid "[font_size=14]Arrête d'inspecter ma chambre et finissons-en rapidement, j'ai des choses à faire ![/font_size]"
msgstr "[font_size=14]Para de analisar cada canto do meu quarto e vamos acabar logo com isso, tenho mais o que fazer![/font_size]"

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "tecfb510e0b"
msgid "[font_size=14]Tu vas rentrer dans le vif du sujet ? Parfait ![/font_size]"
msgstr "[font_size=14]Já quer ir direto ao ponto? Perfeito![/font_size]"

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "t5261577289"
msgid "[font_size=14]Voici comment nous allons procéder, déjà j'aimerais que tu sois pieds nus et qu-[/font_size]"
msgstr "[font_size=14]Vai ser o seguinte: primeiro eu quero que você fique descalça e qu-[/font_size]"

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "t988e69a3a5"
msgid "[font_size=14]Put... Pourquoi tu as frappé avec le genou ?[/font_size]"
msgstr "[font_size=14]Por... Por que você deu uma joelhada? [/font_size]"

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "t06ea16b032"
msgid "[font_size=14]Arglll...[/font_size]"
msgstr "[font_size=14]Arglll...[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t7c3c1203a8"
msgid "Tu pouvais pas empêcher cet idiot d'entrer dans ma chambre ?"
msgstr "Você não podia ter impedido esse idiota de entrar no meu quarto?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "tb7cad4e7d5"
msgid "C'était impossible de l'arrêter, il était déterminé à obtenir sa récompense."
msgstr "Era impossível segurar ele, o cara tava obcecado pela tal recompensa."

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_corridor.dialogue
msgctxt "tb51918014d"
msgid "Ce type est un crétin !"
msgstr "Esse tipo é um completo imbecil!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "t0b03df2d2e"
msgid "Je sais..."
msgstr "Eu sei..."

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_corridor.dialogue
msgctxt "tf5849805d6"
msgid "Tu n'es pas avec {{asami.n}} finalement ?"
msgstr "Você não tá com a {{asami.n}} no fim das contas?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "t4857709361"
msgid "Non, son père est venu la chercher sans prévenir et elle est partie passer quelques jours avec lui."
msgstr "Não, o pai dela buscou ela sem avisar e ela foi passar uns dias com ele."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "tdffdab63ae"
msgid "Oh mon pauvre petit bichon se retrouve tout seul !"
msgstr "Ah, tadinho; ficou sozinho!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_corridor.dialogue
msgctxt "tb58226ef9d"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_corridor.dialogue
msgctxt "td62a2a62c2"
msgid "Allez, ne t'en fais pas, je m'occuperai de toi ce soir si tu veux !"
msgstr "Relaxa, eu cuido de você hoje à noite se você quiser!"

#. Character:`kimochi` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "t9c1da4a599"
msgid "Objection !"
msgstr "Objeção!"

#. Character:`kimochi`
#: game/story/home_player_corridor.dialogue
msgctxt "t9032303c74"
msgid "Occupe-toi plutôt de moi !"
msgstr "Cuida de mim em vez dele!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t3a476f7a24"
msgid "...[w]Plutôt mourir."
msgstr "..[w] Prefiro morrer."

#. Character:`kimochi` | Attributes:`frustrated`
#: game/story/home_player_corridor.dialogue
msgctxt "t1020b80467"
msgid "Mais..."
msgstr "Mas..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "t79656c7c11"
msgid "Allez, arrête les bêtises et discutons dans ma chambre plutôt !"
msgstr "Vamos, para de palhaçada e vamos conversar no meu quarto!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t4f1e0d6e50"
msgid "[font_size=14]Sa suffit, dégage ![/font_size]"
msgstr "[font_size=14]Já chega, cai fora![/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "tfb1c013bb8"
msgid "[font_size=14]Tu veux me tuer ou quoi ?[/font_size]"
msgstr "[font_size=14]Você quer me matar, é?[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t1a3c3d39db"
msgid "[font_size=14]Si on recommence une fois de plus je vais faire une crise cardiaque ![/font_size]"
msgstr "[font_size=14]Se a gente repetir mais uma vez eu vou ter um ataque cardíaco![/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "tc2593d6bca"
msgid "[font_size=14]Tu n'as qu'a te finir tout seul ![/font_size]"
msgstr "[font_size=14]Se vira sozinho agora![/font_size]"

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "tcdc4c5feca"
msgid "Mhh j'ai peut être un peu abusé."
msgstr "Vish, acho que eu abusei um pouco."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "te633e9bd8c"
msgid "Je n'aurais pas du demander une septième fois."
msgstr "Eu não devia ter pedido a sétima rodada."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "t66482ca19b"
msgid "Je suppose qu'il est temps d'aller dormir."
msgstr "Melhor eu ir dormir."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "t56ccf3cc2a"
msgid "Et maintenant c'est au tour de la mère d'{{asami.n}} ?"
msgstr "E agora é a vez da mãe da {{asami.n}}?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_corridor.dialogue
msgctxt "t54aa5fe07a"
msgid "Comment ça ?"
msgstr "Como assim?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "te34ca7e601"
msgid "Je t'en prie, tu vois très bien de quoi je veux parler."
msgstr "Ah, por favor, você sabe muito bem do que eu tô falando."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "ta54c19ad04"
msgid "Depuis quelque temps tu as une fâcheuse tendance à te retrouver intime avec toutes les filles que tu rencontres."
msgstr "De uns tempos pra cá você tem essa tendência irritante de ficar íntimo de toda mulher que encontra."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "t9515b484fd"
msgid "...Je vais pas te contredire la dessus mais..."
msgstr "...Não vou te contradizer nisso, mas..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t7b36ff4694"
msgid "Mais ?"
msgstr "Mas?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "t407d9f1bdc"
msgid "Avec {{sayuri.n}} c'est différent !"
msgstr "Com a {{sayuri.n}} é diferente!"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "t80a3ca40f4"
msgid "Explique moi en quoi ?"
msgstr "Me explica o porquê então."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "tb8fa6ebdf8"
msgid "Elle est mariée !"
msgstr "Ela é casada!"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_corridor.dialogue
msgctxt "t186315ea49"
msgid "Quoi ?! C'est tout ?"
msgstr "O quê?! Só isso?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_corridor.dialogue
msgctxt "t5591db1c51"
msgid "Et bien quoi ?"
msgstr "É... e daí?"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "t40fb58d7df"
msgid "Tu penses que le fait qu'elle soit mariée la rend intouchable ?"
msgstr "Você acha que o fato dela ser casada torna ela intocável?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t4f5f8fc6c2"
msgid "Oh tu es si naïf parfois..."
msgstr "Ai, você é tão ingênuo às vezes..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "t144d043333"
msgid "Je ne suis pas assez fou pour tenter quoi que ce soit avec la mère de ma petite amie !"
msgstr "Eu não sou louco o bastante pra tentar nada com a mãe da minha namorada!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "t572d2fd329"
msgid "Pourtant ça t'a pas gêné de le faire avec ma mère et moi."
msgstr "Mas não pareceu te incomodar nem um pouco fazer isso com a minha mãe e comigo."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_corridor.dialogue
msgctxt "ta1afcea64a"
msgid "C'est... différent."
msgstr "É... diferente."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "td2c5070b86"
msgid "En quoi ?"
msgstr "Em quê?"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "tecfe73541b"
msgid "Je plains l'autre tête de bite..."
msgstr "Coitado do outro cabeça de pica..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "t1bbf64f9ef"
msgid "Qu'est ce que {{kimochi.n}} à avoir là dedans ?"
msgstr "O que o {{kimochi.n}} tem a ver com isso?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t87b3fc6ea1"
msgid "Il va encore te voir avec une nouvelle femme à tes côtés alors que lui va probablement finir sa vie puceau."
msgstr "Ele vai ter que te ver com mais uma mulher nova do seu lado, enquanto ele provavelmente vai morrer virgem."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "t62830abfad"
msgid "Il ne se passera rien avec elle !"
msgstr "Não vai acontecer nada com ela!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t5b02d0740d"
msgid "Tu sous-estimes trop le sex-appeal d'une femme mariée mon pauvre {{saito.n}}"
msgstr "Você subestima demais o sex-appeal de uma mulher casada, meu pobre {{saito.n}}."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "t34550aa936"
msgid "...[w]N'importe quoi..."
msgstr "..[w]Nada a ver..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "te66c6edf85"
msgid "[font_size=14]Et rappelle toi...[/font_size]"
msgstr "[font_size=14]E lembra do que eu disse...[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "tb1ec01f44d"
msgid "[font_size=14]On ne touche pas pas à la mère de sa meilleure amie[/font_size]"
msgstr "[font_size=14]Não se mexe com a mãe da melhor amiga.[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t4b748d8a3a"
msgid "[font_size=14]On ne touche pas pas à la mère de sa petite amie[/font_size]"
msgstr "[font_size=14]Não se mexe com a mãe da namorada.[/font_size]"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "tc4bea41113"
msgid "Je t'ai déjà dis qu'il ne se passerait rien !"
msgstr "Já te disse que não vai acontecer nada!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "te8244f15f1"
msgid "[font_size=14]C'est ce qu'ils disent tous...[/font_size]"
msgstr "[font_size=14]É o que todos dizem...[/font_size]"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "tcaa1b16bb4"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_corridor.dialogue
msgctxt "teb79a71097"
msgid "Oh merde !"
msgstr "Eita, merda!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "t583d7b4288"
msgid "Tu m'as fait peur, je ne m'attendais pas à te trouver là."
msgstr "Que susto, eu não esperava te encontrar aqui."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "t00543a8508"
msgid "Tu rentres tard, une fois de plus."
msgstr "Chegando tarde de novo, pra variar."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "te78d30b416"
msgid "Oui je sais..."
msgstr "É, eu sei..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "t4beca839c3"
msgid "On devait passer la journée en ville et, au final, on est restés à la salle d'arcade."
msgstr "A gente ia passar o dia na cidade, mas acabamos ficando no fliperama."

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_corridor.dialogue
msgctxt "t95d51d26b9"
msgid "Donc c'est terminé ?"
msgstr "Então acabou?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_corridor.dialogue
msgctxt "tad373f642e"
msgid "mhh pas exactement..."
msgstr "Er... não exatamente..."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "tda848956db"
msgid "Tu la vois toujours demain, c'est ça ?"
msgstr "Você vai ver ela amanhã de novo, não é?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "t74d7ccd50e"
msgid "On va au parc d'attractions..."
msgstr "Vamos ao parque de diversões..."

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_corridor.dialogue
msgctxt "tb9f597cd22"
msgid "Celui pour les couples ?"
msgstr "Aquele pra casais?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_corridor.dialogue
msgctxt "t864211c504"
msgid "Comment ça pour les couples ?"
msgstr "Como assim \"pra casais\"?"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "tb232dd88a5"
msgid "C'est à se demander si tu connais la ville dans laquelle tu habites."
msgstr "Às vezes eu me pergunto se você conhece a cidade onde mora."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "te7ab29873c"
msgid "Ce parc a une particularité, c'est qu'il ne laisse entrer que et uniquement les couples."
msgstr "Esse parque tem uma regra: só entra quem for casal."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "t6bf39b97ec"
msgid "Arrête de te moquer de moi !"
msgstr "Para de zoar com a minha cara!"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "t291e1a5d24"
msgid "[font_size=14]Il ne se passera rien entre {{sayuri.n}} et moi ![/font_size]"
msgstr "[font_size=14]Não vai acontecer nada entre a {{sayuri.n}} e eu![/font_size]"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "ta6fcdcf6ca"
msgid "Bon sang ! Mais comment il peut être aussi naif ?!"
msgstr "Caramba! Como ele consegue ser tão ingênuo?!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "SALUT_BIEN_DORMI_AEBF96"
msgid "Salut... Bien dormi ?"
msgstr "Oi... Dormiu bem?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "PAS_VRAIMENT_ET_TOI_720EC2"
msgid "Pas vraiment... et toi ?"
msgstr "Nem tanto... e você?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "MOI_NON_PLUS_E81698"
msgid "Moi non plus."
msgstr "Eu também não."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "T_TE_DE_BITE_A_D_TERMINER_LES_E9DC77"
msgid "Tête de bite a dû terminer les affiches."
msgstr "O cabeça de pica deve ter terminado os cartazes."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "S_REMENT_A4EB14"
msgid "Sûrement..."
msgstr "Provavelmente..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "ON_Y_VA_ALORS_24F103"
msgid "On y va alors ?"
msgstr "Vamos então?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "AVANT_J_AIMERAIS_PASSER_VOIR_M_599669"
msgid "Avant, j'aimerais passer voir {{macumba.n}} au parc. J'aimerais m'assurer que tout va bien."
msgstr "Antes, eu queria passar pra ver o {{macumba.n}} no parque. Quero ter certeza de que tá tudo bem."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "SI_TU_VEUX_MAIS_JE_VIENS_AVEC_A07EFE"
msgid "Si tu veux, mais je viens avec toi !"
msgstr "Se você quer, mas eu vou com você!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_COMPTES_ME_DIRE_LA_V_RIT_MO_204954"
msgid "Tu comptes me dire la vérité à moi ?"
msgstr "Você pretende me contar a verdade agora?"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "W_J_AI_T_VOIR_LES_3_IDIOTS_EN_E2D30A"
msgid "...[w] J'ai été voir les 3 idiots... en espérant qu'ils pourraient m'aider à trouver {{akira.n}}, mais... ils n'ont pas été très coopératifs."
msgstr "...[w] Eu fui ver os 3 idiotas... esperando que eles pudessem me ajudar a achar o {{akira.n}}, mas... eles não foram muito cooperativos."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "CE_QUI_EXPLIQUE_LE_SANG_SUR_T_DD6AE9"
msgid "... Ce qui explique le sang sur tes poings."
msgstr ".. O que explica o sangue nos seus punhos."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "W_COMMENT_TU_FAISAIS_POUR_CON_DD446C"
msgid "...[w] Comment tu faisais pour contacter {{akira.n}} ?"
msgstr "...[w] Como você fazia pra falar com o {{akira.n}}?"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_NE_LE_FAISAIS_PAS_C_EST_TOU_578C8F"
msgid "Je ne le faisais pas... C'est toujours lui qui me contactait..."
msgstr "Eu não fazia... Era sempre ele que entrava em contato comigo..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "DONC_IL_EST_NOTRE_SEULE_PISTE_8CF711"
msgid "Donc il est notre seule piste, et lui aussi a disparu ?"
msgstr "Então a única pista que a gente tinha também sumiu?"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "J_AI_BESOIN_DE_DORMIR_BONNE_NU_E1069B"
msgid "J'ai besoin de dormir, bonne nuit."
msgstr "Preciso dormir, boa noite."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "BONNE_NUIT_473BEE"
msgid "... Bonne nuit..."
msgstr "... Boa noite..."

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "FONT_SIZE_14_MERDE_FONT_SIZE_112EAF"
msgid "[font_size=14]MERDE ![/font_size]"
msgstr "[font_size=14]MERDA![/font_size]"

#. Character:`yasuka`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_PENSES_QU_IL_A_TROUV_UN_END_C58FA3"
msgid "Tu penses qu'il a trouvé un endroit où dormir ?"
msgstr "Você acha que ele encontrou algum lugar pra dormir?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_JE_NE_SAIS_PAS_645D8E"
msgid "Je... Je ne sais pas."
msgstr "Eu... Eu não sei."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "TOUS_LES_ENDROITS_O_IL_AURAIT_E46999"
msgid "Tous les endroits où il aurait pu se réfugier sont maintenant surveillés."
msgstr "Todos os lugares onde ele poderia ter se escondido agora estão sendo vigiados."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_NE_VOIS_PAS_COMMENT_IL_POUR_ED2945"
msgid "Je ne vois pas comment il pourrait se sortir de cette situation."
msgstr "Não vejo como ele vai conseguir sair dessa situação."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "EST_CE_QU_IL_AVAIT_UN_PEU_D_AR_B7D073"
msgid "Est-ce qu'il avait un peu d'argent avec lui ? De quoi manger ?"
msgstr "Ele tinha algum dinheiro com ele? Algo pra comer?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "MAMAN_J_AIMERAIS_POUVOIR_TE_R_2F2CCE"
msgid "Maman... J'aimerais pouvoir te répondre, mais je me pose les mêmes questions."
msgstr "Mãe... eu queria poder te responder, mas tô me perguntando a mesma coisa."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "IL_DEVRAIT_S_EN_SORTIR_J_ESP_R_692683"
msgid "Il devrait s'en sortir... J'espère."
msgstr "Ele deve dar um jeito... espero."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "QUEL_GENRE_DE_D_BILE_HURLE_COM_C64FBD"
msgid "Quel genre de débile hurle comme ça dès le matin ?!"
msgstr "Que tipo de retardado grita assim logo de manhã?!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "Y_EN_A_MARRE_QUAND_EST_CE_QUE_89AADE"
msgid "Y en a marre, quand est-ce que tu te comporteras comme un homme et plus comme un gamin ?"
msgstr "Chega, né? Quando é que você vai agir feito um homem e parar de ser um moleque?"

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_ME_FAIS_VRAIMENT_DE_LA_PEIN_7C7477"
msgid "Tu me fais vraiment de la peine..."
msgstr "Você me dá pena de verdade..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_corridor.dialogue
msgctxt "WOAH_NORIKO_N_T_ES_VIVANTE_2AF67D"
msgid "Woah {{noriko.n}}, t'es vivante !?"
msgstr "Uau {{noriko.n}}, você tá viva!?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_SUIS_QUAND_M_ME_CONTENT_DE_F0DF1F"
msgid "Je suis quand même content de pouvoir te voir à nouveau."
msgstr "Ainda assim, fico feliz de poder te ver de novo."

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_corridor.dialogue
msgctxt "QU_W_NON_MAIS_A_VA_PAS_T_ES_TO_7E6F66"
msgid "Qu-[w] Non mais ça va pas ?! T'es tombé sur la tête ou quoi ce matin ?"
msgstr "Oq-[w] Ficou louco?! Bateu a cabeça ou o quê hoje de manhã?"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_corridor.dialogue
msgctxt "BIEN_S_R_QUE_JE_SUIS_VIVANTE_T_D56343"
msgid "Bien sûr que je suis vivante, tu ne te débarrasseras pas de moi comme ça !"
msgstr "É claro que eu tô viva, você não vai se livrar de mim assim tão fácil!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_corridor.dialogue
msgctxt "MAIS_NON_JE_VOULAIS_JUSTE_D544EE"
msgid "Mais non, je voulais juste-"
msgstr "Que nada, eu só queria-"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "FERME_TA_GUEULE_J_EN_PEUX_PLUS_F2F825"
msgid "Ferme ta gueule ! J'en peux plus de tes conneries, tu n'es rien d'autre qu'un parasite dans cette maison."
msgstr "Cala a boca! Não aguento mais as suas merdas, você não passa de um parasita nesta casa."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_PASSES_TON_TEMPS_ENFERM_DAN_0AFFBD"
msgid "Tu passes ton temps enfermé dans ta chambre à pleurnicher, tu crois que c'est comme ça que les choses vont changer ? Bouge-toi le cul !"
msgstr "Você passa o tempo todo trancado no seu quarto choramingando, acha que é assim que as coisas vão mudar? Mexe essa bunda!"

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_corridor.dialogue
msgctxt "S_RIEUSEMENT_QUAND_EST_CE_QUE_48B817"
msgid "Sérieusement, quand est-ce que tu te barres d'ici ?!"
msgstr "Sério, quando é que você vai vazar daqui?!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_corridor.dialogue
msgctxt "D_ACCORD_MAIS_JE_DBA2C0"
msgid "D'accord, mais je-"
msgstr "Tá bom, mas eu-"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_M_EN_FOUS_CASSE_TOI_733292"
msgid "Je m'en fous, casse-toi !"
msgstr "Não tô nem aí, cai fora!"

#. Character:`narrator` | Attributes:`surprised`
#: game/story/home_player_corridor.dialogue
msgctxt "WOAH_A_FAISAIT_LONGTEMPS_QUE_J_27E98D"
msgid "Woah... Ça faisait longtemps que je n'avais pas eu à subir la haine rafraîchissante de {{noriko.n}} de bon matin."
msgstr "Uau... Fazia tempo que eu não tinha que aguentar o ódio revigorante da {{noriko.n}} logo cedo."

#. Character:`narrator` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_VAIS_PAS_DIRE_QUE_A_M_AVAIT_559959"
msgid "Je vais pas dire que ça m'avait manqué, je ne suis pas masochiste à ce point, mais c'est quelque chose qu'il va falloir que je corrige aussi, je pense."
msgstr "Não vou dizer que estava com saudades, não sou masoquista a esse ponto, mas acho que isso é algo que eu também vou ter que ajeitar."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_N_AI_JAMAIS_TROP_COMPRIS_PO_96F544"
msgid "Je n'ai jamais trop compris pourquoi elle me détestait autant d'ailleurs, jusqu'au jour où..."
msgstr "Aliás, nunca entendi muito bem por que ela me odiava tanto, até o dia em que..."

#. Character:`narrator` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "ELLE_A_T_RETROUV_E_NOY_E_DANS_FAAF86"
msgid "Elle a été retrouvée noyée dans le canal de la ville."
msgstr "Ela foi encontrada afogada no canal da cidade."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "MINCE_J_AURAIS_D_TRE_PLUS_ATTE_C0B1DE"
msgid "Mince, j'aurais dû être plus attentif... Je ne me souviens plus de la raison, je me rappelle seulement qu'elle avait fugué de la maison en emportant avec elle le peu d'argent que sa mère avait économisé pour s'enfuir avec une bande de thugs."
msgstr "Putz, eu devia ter prestado mais atenção... Não me lembro do motivo, só me recordo de que ela tinha fugido de casa levando o pouco dinheiro que a mãe dela tinha guardado pra dar no pé com um bando de marginais."

#. Character:`narrator`
#: game/story/home_player_corridor.dialogue
msgctxt "YASUKA_N_NE_SERA_PLUS_JAMAIS_208EC8"
msgid "{{yasuka.n}} ne sera plus jamais la même après ça..."
msgstr "A {{yasuka.n}} nunca mais vai ser a mesma depois disso..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_corridor.dialogue
msgctxt "JE_DOIS_AJOUTER_A_MA_LISTE_521D4A"
msgid "Je dois ajouter ça à ma liste !"
msgstr "Tenho que adicionar isso na minha lista!"

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_corridor.dialogue
msgctxt "PFFF_TU_TE_PARLES_TOUJOURS_TOI_366361"
msgid "Pfff... Tu te parles toujours à toi-même ? C'est tellement pathétique..."
msgstr "Pfff... Falando sozinho ainda? Isso é tão patético..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "RIEN_QUE_DE_VOIR_TA_T_TE_JE_08114D"
msgid "Rien que de voir ta tête, je-"
msgstr "Você me dá vontade de vomitar!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_corridor.dialogue
msgctxt "C_EST_BON_T_AS_FINI_30AEC5"
msgid "C'est bon, t'as fini ?"
msgstr "Só de olhar pra sua cara, eu-"

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_corridor.dialogue
msgctxt "BEUHH_NON_C_EST_INCONTR_LABLE_AC68A8"
msgid "Beuhh non... C'est incontrôlable, je sens que ça vient..."
msgstr "Tá bom, já terminou?"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_corridor.dialogue
msgctxt "ELLE_NE_ME_FACILITE_PAS_LES_CH_6CEBBB"
msgid "Elle ne me facilite pas les choses non plus..."
msgstr "Eca, não... É incontrolável, tô sentindo que vem aí..."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "FONT_SIZE_14_BLWWWWARGGG_FONT_22BFEB"
msgid "[font_size=14]Blwwwwarggg...[/font_size]"
msgstr "[font_size=14]Uuuurghhhhhh...[/font_size]"

#. Character:`saito`
#: game/story/home_player_corridor.dialogue
msgctxt "A_VA_C_EST_BON_J_AI_COMPRIS_I_F1B834"
msgid "Ça va, c'est bon, j'ai compris, inutile d'en faire autant, je sors !"
msgstr "Tá, tá bom, já entendi, não precisa desse drama todo, já tô saindo!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "FONT_SIZE_14_CR_TIN_FONT_SIZE_824FDC"
msgid "[font_size=14]Crétin...[/font_size]"
msgstr "[font_size=14]Idiota...[/font_size]"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_corridor.dialogue
msgctxt "BAH_ALORS_SALE_JOURN_E_DF8EFD"
msgid "Bah alors, sale journée ?"
msgstr "Então, dia puxado?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "TU_PEUX_PAS_SAVOIR_QUEL_POINT_D8BA07"
msgid "Tu peux pas savoir à quel point ça me fait plaisir."
msgstr "Você não imagina o quanto isso me deixa feliz."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "TOI_QUI_FAISAIS_LE_MALIN_CE_MA_499B03"
msgid "Toi qui faisais le malin ce matin."
msgstr "Você estava se achando tanto hoje de manhã."

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "ET_TU_SAIS_QUOI_4E238E"
msgid "Et tu sais quoi ?"
msgstr "E sabe de uma coisa?"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
msgctxt "J_ESP_RE_QUE_A_SERA_ENCORE_PIR_8CCBB1"
msgid "J'espère que ça sera encore pire pour toi d-"
msgstr "Eu espero que isso piore ainda mais para você, para-"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_corridor.dialogue
msgctxt "QU_EST_CE_QUE_TU_FAIS_ENCORE_D_CEB062"
msgid "Qu'est-ce que tu fais encore debout à cette heure, toi ?"
msgstr "O que você ainda tá fazendo acordado(a) essa hora?"

#. Character:`yasuka`
#: game/story/home_player_corridor.dialogue
msgctxt "ALLEZ_VA_TE_COUCHER_1DE247"
msgid "Allez, va te coucher !"
msgstr "Vai, vai dormir!"

#. Character:`noriko`
#: game/story/home_player_corridor.dialogue
