msgstr "E olha que eu nem coloquei tudo ainda."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "QUOI_TU_AAAH_0C9A20"
msgid "Quoi tu... Aaah- !"
msgstr "O quê, você... Aaah- !"

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "FUCK_DOUCEMENT_J_AI_D_J_DU_MAL_B0BD8B"
