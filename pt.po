#: game/story/home_player_exterior.dialogue
msgctxt "C_EST_PLUS_UN_CONSEIL_D_UNE_AM_AD17EA"
msgid "C'est plus un conseil d'une amie qui vous veut du bien."
msgstr ""

#. Character:`natsume`
#: game/story/home_player_exterior.dialogue
msgctxt "NE_FOUILLEZ_PAS_DU_C_T_DE_MINA_07DB45"
msgid "Ne fouillez pas du côté de {{minato.n}}."
msgstr ""

#. Character:`natsume`
#: game/story/home_player_exterior.dialogue
msgctxt "VOUS_RISQUERIEZ_DE_LE_REGRETTE_66028E"
