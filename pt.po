#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_532012eb"
msgid "Mais putain tu fais chier !"
msgstr "Mas que caralho, você enche o saco!"

#. Character:`nobu`
#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_6e3827a6"
msgid "Grouille toi j'ai vraiment passé une grosse journée, je suis claqué."
msgstr "Anda logo, meu dia foi uma puta duma correria, tô morto."

#. Character:`unknown`
#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_e0630f15"
msgid "Menteur."
msgstr "Mentiroso."

#. Character:`unknown`
#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_b971ea1b"
msgid "Je suis sûre que tu as encore passé la plupart de ton temps à traîner avec les deux autres branleurs."
msgstr "Tenho certeza de que você passou a maior parte do tempo vagabundeando com os outros dois punheteiros."

#. Character:`unknown`
#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_b23ab5dd"
msgid "Et tu as sûrement fini ta journée a l'arcade center..."
msgstr "E com certeza terminou o dia no fliperama..."

#. Character:`nobu`
#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_70e89da9"
msgid "[font_size=14]...Putain tu fais chié.[/font_size]"
msgstr "[font_size=14]...Porra, você enche o saco.[/font_size]"

#. Character:`unknown`
#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_85396649"
msgid "Je le savais !"
msgstr "Eu sabia!"

#. Character:`nobu`
#: game/story/home_nobu_exterior.dialogue
msgctxt "event_nobu_fight_at_home_a4481e29"
