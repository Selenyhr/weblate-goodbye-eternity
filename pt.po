#. Character:`saito`
#: game/story/home_player_hallway.dialogue
msgctxt "J_AI_D_CID_QU_IL_TAIT_TEMPS_PO_A8211B"
msgid "J'ai décidé qu'il était temps pour moi de changer et je compte bien le faire."
msgstr ""

#. Character:`saito`
#: game/story/home_player_hallway.dialogue
msgctxt "QUE_A_TE_PLAISE_OU_NON_2B1899"
msgid "Que ça te plaise ou non."
msgstr ""

#. Character:`saito`
#: game/story/home_player_hallway.dialogue
msgctxt "ET_J_AIDERAI_AUSSI_YASUKA_N_RE_73306D"
msgid "Et j'aiderai aussi {{yasuka.n}} à rembourser sa dette."
msgstr ""

#. Character:`saito`
#: game/story/home_player_hallway.dialogue
msgctxt "ET_TOI_27F2AE"
msgid "Et toi...?"
msgstr ""

#. Character:`saito`
#: game/story/home_player_hallway.dialogue
msgctxt "QU_EST_CE_QUE_TU_COMPTES_FAIRE_5F9A10"
msgid "Qu'est-ce que tu comptes faire ? Te plaindre ? Rester à jouer dans ta chambre ?"
msgstr ""

#. Character:`saito`
#: game/story/home_player_hallway.dialogue
msgctxt "FONT_SIZE_14_TU_SAIS_COMMENT_AC7A56"
msgid "[font_size=14]Tu sais comment on appelle les gens qui font la morale aux autres mais qui n'appliquent pas leurs propres conseils ?[/font_size]"
msgstr ""

#. Character:`saito`
#: game/story/home_player_hallway.dialogue
msgctxt "FONT_SIZE_14_DES_HYPOCRITES_F_151626"
msgid "[font_size=14]Des hypocrites ![/font_size]"
msgstr ""

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_hallway.dialogue
msgctxt "VA_VA_TE_FAIRE_FOUTRE_F74745"
msgid "Va... Va te faire foutre !"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_hallway.dialogue
msgctxt "OH_BON_SANG_QU_EST_CE_QUE_A_SO_13C37E"
msgid "Oh bon sang... Qu'est-ce que ça soulage !"
msgstr ""

#. Character:`narrator` | Attributes:`guilty`
#: game/story/home_player_hallway.dialogue
msgctxt "UNE_MINUTE_SI_JE_N_AM_LIORE_PA_0DE4C4"
msgid "Une minute... Si je n'améliore pas sérieusement ma relation avec elle, je ne pourrai pas empêcher ce qui va lui arriver..."
msgstr ""

#. Character:`narrator` | Attributes:`sad`
#: game/story/home_player_hallway.dialogue
msgctxt "MERDE_LES_PROBL_MES_S_ACCUMULE_4E54EE"
msgid "Merde... Les problèmes s'accumulent bien trop vite et je ne suis même pas encore sorti de la maison..."
msgstr ""

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_hallway.dialogue
msgctxt "AH_TE_VOIL_ENFIN_JE_COMMEN_AIS_00F360"
msgid "Ah, te voilà enfin, je commençais à m'inquiéter, tu vas bien ?"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_hallway.dialogue
msgctxt "D_SOL_JE_RENTRE_UN_PEU_TARD_MA_4D572D"
msgid "Désolé, je rentre un peu tard, mais j'ai une bonne raison : j'ai décroché un travail aujourd'hui et j'ai même reçu ma première paie."
msgstr ""

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_hallway.dialogue
msgctxt "VRAIMENT_MAIS_C_EST_UNE_EXCELL_D8B1C7"
msgid "Vraiment ?! Mais c'est une excellente nouvelle, ça !"
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_hallway.dialogue
msgctxt "JE_SUIS_VRAIMENT_HEUREUSE_POUR_208007"
msgid "Je suis vraiment heureuse pour toi."
msgstr ""

#. Character:`saito`
#: game/story/home_player_hallway.dialogue
msgctxt "MERCI_JE_VAIS_POUVOIR_T_AIDER_B1C534"
msgid "Merci, je vais pouvoir t'aider un peu plus à partir de maintenant."
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_hallway.dialogue
msgctxt "MON_CH_RI_TU_N_ES_PAS_OBLIG_DE_EB38AA"
msgid "Mon chéri... Tu n'es pas obligé de faire ça..."
msgstr ""

#. Character:`saito`
#: game/story/home_player_hallway.dialogue
msgctxt "PEUT_TRE_MAIS_JE_NE_TE_LAISSER_5A2524"
msgid "Peut-être... Mais je ne te laisserai plus tout prendre en charge seule à partir de maintenant."
msgstr ""

#. Character:`yasuka` | Attributes:`moved,blush`
#: game/story/home_player_hallway.dialogue
msgctxt "ET_DIRE_QUE_MAINTENANT_C_EST_9BD4D0"
msgid "... Et dire que maintenant, c'est moi qui vais devoir compter sur toi, tu as mûri si vite !"
msgstr ""

#. Character:`saito`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_2efda0ff"
msgid "C'est ici... Qui aurait pensé qu'il vivrait dans ce quartier ?"
msgstr "É aqui... Quem imaginaria que ele moraria neste bairro?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_c98e1082"
msgid "Comme quoi... L'habit ne fait pas forcément le moine."
msgstr "Acho que não dá para julgar um livro pela capa."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_46a016fb"
msgid "Vu qu'il n'y a personne pour le moment je ferais mieux de rester planqué."
msgstr "Como não há ninguém por perto no momento, é melhor eu ficar escondido."

#. Character:`takeo`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_f25c3205"
msgid "Putain... Il fait quoi !"
msgstr "Porra... O que ele está fazendo?"

#. Character:`takeo`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_b75581c7"
msgid "Il m'a pas laissé tomber cet enfoiré j'espère ?"
msgstr "Espero que aquele bastardo não tenha me decepcionado."

#. Character:`takeo` | Attributes:`disgusted`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_fa3b2acb"
msgid "Non non il a été payé, je suis sûr qu'il est dans le coin !"
msgstr "Não, não, ele foi pago. Tenho certeza que ele está por aí!"

#. Character:`takeo` | Attributes:`angry`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_5405e992"
msgid "Putain... Toi !!!"
msgstr "Foda-se... Você!"

#. Character:`takeo` | Attributes:`mocking`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_d0f6a062"
msgid "Hehe... Tu peux sortir {{akira.n}} !"
msgstr "Hehe... Apareça, {{akira.n}}!"

#. Character:`takeo`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_4611507e"
msgid "...[w] Maintenant !"
msgstr "...[w] Agora!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_314efa50"
msgid "Je suppose qu'il ne viendra pas ?"
msgstr "Acho que ele não vem?"

#. Character:`takeo` | Attributes:`disgusted`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_e257f1c8"
msgid "Merde !"
msgstr "Merda!"

#. Character:`takeo` | Attributes:`mocking`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_b3171964"
msgid "J'ai pas besoin de ces lâcheurs de toute façon, je vais te régler ton compte moi-même !"
msgstr "Eu não preciso desses perdedores de qualquer forma. Eu vou lidar com você sozinho!"

#. Character:`takeo`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_8d44434a"
msgid "J'vais t-"
msgstr "Eu vou-"

#. Character:`saito`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_329a4db4"
msgid "Où tu étais ?"
msgstr "Onde você estava?"

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_f293e097"
msgid "J'avais un rendez-vous important, mais je constate que tu n'avais pas besoin de moi."
msgstr "Eu tinha algo importante para fazer, mas acho que você não precisava de mim."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_468a6aa7"
msgid "En même temps tu n'es pas venue te battre avec moi non plus les fois précédentes."
msgstr "Quer dizer, você também não veio brigar comigo nas outras vezes."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_463637f5"
msgid "Je suis là pour le soutien émotionnel."
msgstr "Estou aqui para apoio emocional."

#. Character:`saito`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_2bdeef48"
msgid "On en a terminé à présent !"
msgstr "Terminamos agora!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_b1d517e1"
msgid "...Oui, c'est fini."
msgstr "...Sim, acabou."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_9a59ae18"
msgid "...Quoi tout ça pour cette réaction ?"
msgstr "...O quê, tudo isso por essa reação?"

#. Character:`saito`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_f6e52d86"
msgid "C'est tout ce que ça lui fait ?"
msgstr "Foi só isso que fez por ela?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_takeo_exterior.dialogue
msgctxt "home_takeo_exterior_a7f1558e"
msgid "...Sérieusement je la comprendrai jamais."
msgstr "...Sério, eu nunca vou entendê-la."

#. Character:`saito`
#: game/story/home_takeo_exterior.dialogue
msgctxt "INSTALLONS_QUELQUES_AFFICHES_I_290709"
msgid "Installons quelques affiches ici."
msgstr "Vamos colocar alguns cartazes aqui."

#. Character:`saito`
#: game/story/home_takeo_exterior.dialogue
msgctxt "BON_A_DEVRAIT_SUFFIRE_POUR_ICI_B3F4A0"
msgid "Bon, ça devrait suffire pour ici, allons voir du côté du konbini."
msgstr "Bom, isso deve bastar por aqui. Vamos dar uma olhada na loja de conveniência."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "t1d9ac07749"
msgid "...et maintenant ?"
msgstr "...e agora?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "td03f2f5a95"
msgid "On continue comme prévue, on a justement reçu la confirmation de ce qu'on attendait."
msgstr "Continuamos como planejado, acabamos de receber a confirmação do que estávamos esperando."

#. Character:`netoru` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "tc8239fa16a"
msgid "Pile au bon moment."
msgstr "Bem na hora."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "t1d16160369"
msgid "Ca ne me surprend qu'a moitié, il reste assez prévisible."
msgstr "Isso não me surpreende nem um pouco, ele continua sendo bem previsível."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "ta766ca10b7"
msgid "J'ai hâte de pouvoir commencer."
msgstr "Mal posso esperar para começar."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "tb45372a99b"
msgid "Vous vous souvenez de tout ?"
msgstr "Você se lembra de tudo?"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/home_minato_hallway.dialogue
msgctxt "t22d27aabb7"
msgid "Je n'ai même pas besoins de jouer un rôle, j'ai fais ça toute ma vie."
msgstr "Eu nem preciso interpretar um personagem, passei a vida inteira fazendo isso."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "t9bd45407ee"
msgid "Parfait, je laisse donc ça entre vos mains expertes."
msgstr "Perfeito, então deixo isso nas suas mãos experientes."

#. Character:`chiaki`
#: game/story/home_minato_hallway.dialogue
msgctxt "t4ff6dbb309"
msgid "..."
msgstr "..."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "t33a7c81e5a"
msgid "Tiens regardez qui voilà, voici ma sœur {{chiaki.n}} !"
msgstr "Olha só quem está por aqui, esta é minha irmã {{chiaki.n}}!"

#. Character:`netoru` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "t81de502407"
msgid "Oh je crois reconnaitre l'air de famille en effet."
msgstr "Ah, acho que dá para notar a semelhança de família, com certeza."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "t44db0e9484"
msgid "Viens que je te présente à notre invité !"
msgstr "Venha cá que vou te apresentar ao nosso convidado!"

#. Character:`chiaki` | Attributes:`afraid`
#: game/story/home_minato_hallway.dialogue
msgctxt "t9259f9c0c3"
msgid "Non !"
msgstr "Não!"

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "t5ebaf809ce"
msgid "Ne le prenez pas personnellement, c'est une fille très timide."
msgstr "Não leve para o lado pessoal, ela é uma garota muito tímida."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/home_minato_hallway.dialogue
msgctxt "ta909b8220f"
msgid "Ce n'est rien, c'est juste l'histoire de ma vie."
msgstr "Tudo bem, já estou acostumado... é a história da minha vida."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "t12cfe6ee51"
msgid "haha je vois..."
msgstr "Haha, estou vendo..."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "t5118f0e07e"
msgid "Continuez de remplir vos objectifs et je vous laisserais peut-être vous amuser avec elle !"
msgstr "Continue cumprindo seus objetivos e quem sabe eu não deixo você se divertir com ela também!"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "t5d272b75c1"
msgid "Je ne comprend pas... Vous parlez de {{chiaki.n}} ou {{asami.n}} ?"
msgstr "Eu não entendi... Você está falando da {{chiaki.n}} ou da {{asami.n}}?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "t877470b687"
msgid "Pourquoi pas les deux ?"
msgstr "Por que não as duas?"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/home_minato_hallway.dialogue
msgctxt "t48dbdc6c34"
msgid "Bordel de merde..."
msgstr "Puta que pariu..."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "t3f4375129c"
msgid "Je vois que tout ça vous passionne beaucoup."
msgstr "Estou vendo que tudo isso está te empolgando bastante."

#. Character:`netoru` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "td1babdd7a7"
msgid "Je m'amuse comme un petit fou."
msgstr "Estou me divertindo feito um louco."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "tcbf1a35c11"
msgid "Après tout ce qui m'est arrivé dernièrement je pensais ne plus pouvoir prendre mon pied."
msgstr "Depois de tudo o que me aconteceu ultimamente, achei que não conseguiria mais sentir prazer."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "t6a00477153"
msgid "Mais je suis content de m'être trompé."
msgstr "Mas fico feliz em estar errado."

#. Character:`minato` | Attributes:`suspicious`
#: game/story/home_minato_hallway.dialogue
msgctxt "t110bce7a33"
msgid "Avez-vous réussi ?"
msgstr "Você conseguiu?"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/home_minato_hallway.dialogue
msgctxt "t7c25a56e9a"
msgid "Oui !"
msgstr "Sim!"

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "t6b6e749bf2"
msgid "La graine du doute a bien été plantée au fond d'elle."
msgstr "A semente da dúvida já foi bem plantada no fundo da mente dela."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "tf0af690196"
msgid "Elle semble absolument sûre d'elle, mais ça va la travailler."
msgstr "Ela parece absolutamente certa de si, mas isso vai ficar martelando na cabeça dela."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "tee1bcb99e0"
msgid "Parfait, nous allons continuer comme ça."
msgstr "Perfeito, vamos continuar assim."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "t29e3c8f294"
msgid "Je me demande quand même... Il aurait peut-être été plus simple et plus rapide de passer directement par le X3, non ?"
msgstr "Mas eu ainda me pergunto... Não teria sido mais simples e rápido usar logo o X3?"

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "t5e300e9fa9"
msgid "Aucun intérêt !"
msgstr "Onde está a diversão nisso?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "tf5ef95dd29"
msgid "Si la vengeance arrive trop vite, elle n'a que peu de saveur."
msgstr "Se a vingança vem rápido demais, perde o sabor."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "tf0dc422bef"
msgid "Tandis qu'un plan élaboré a besoin de temps, de gagner en maturité, la descente vers le désespoir doit être progressive."
msgstr "Enquanto um plano bem elaborado precisa de tempo, precisa amadurecer... a descida em direção ao desespero deve ser progressiva."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "t0c2a836a8e"
msgid "Et c'est quand toutes les pièces s'emboîtent les unes dans les autres, que la vengeance est enfin accomplie."
msgstr "E é quando todas as peças se encaixam perfeitamente umas nas outras que a vingança finalmente se concretiza."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "t95f5982b73"
msgid "Le plaisir ressenti est... Ça n'a rien à voir."
msgstr "O prazer que se sente... Não dá nem para comparar."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "taeb35c75e2"
msgid "Vous apprendrez à apprécier ce sentiment."
msgstr "Você vai aprender a saborear esse sentimento."

#. Character:`netoru` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "t1b7e32e9b2"
msgid "J'étais déjà convaincu, inutile de me le vendre davantage."
msgstr "Você já me convenceu, não precisa ficar me floreando o plano."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "tf1c589a7f9"
msgid "Je vois que même à mon âge, on peut encore apprendre."
msgstr "Estou vendo que, mesmo na minha idade, a gente ainda pode aprender."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "t5c05a9fc70"
msgid "Je serai à votre disposition pour les prochaines étapes."
msgstr "Estarei à sua disposição para os próximos passos."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "t47c3375049"
msgid "Le doute s'installe ?"
msgstr "A dúvida está se instalando?"

#. Character:`netoru` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "te1b8f06b69"
msgid "Oui, c'est elle qui a évoquée le sujet."
msgstr "Sim, foi ela mesma quem puxou o assunto."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "tea7f47c290"
msgid "C'était sûr, en même temps, c'était tellement prévisible."
msgstr "Isso era certeza. Ao mesmo tempo, era tão previsível."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "t32f03e3bdc"
msgid "Combien de temps encore ?"
msgstr "Quanto tempo mais?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "td643c77c45"
msgid "Ca ne devrait plus être très long."
msgstr "Não deve demorar muito."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "tb3ab82785a"
msgid "Avec un peu de chance, on pense que même demain il pourrait se passer des choses..."
msgstr "Com um pouco de sorte, achamos que algumas coisas podem acontecer já amanhã..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "t67a02d6b38"
msgid "Après ça...[w]Tout ira très vite !"
msgstr "Depois disso...[w]tudo vai ser muito rápido!"

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "t4567b417c3"
msgid "Combien de temps ça va encore durer ?"
msgstr "Quanto tempo mais isso vai durar?"

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_minato_hallway.dialogue
msgctxt "t1d43d817f1"
msgid "On ne va pas la garder éternellement comme ça..."
msgstr "Não podemos mantê-la trancada assim para sempre..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "EH_BIEN_JE_SUIS_MOI_M_ME_SURPR_F1F3A7"
msgid "Eh bien... Je suis moi-même surpris par le déroulement de la situation mais c'est déjà terminé."
msgstr "Bem... Eu mesmo estou surpreso com o desenrolar da situação, mas já acabou."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "HEIN_TERMIN_COMMENT_A_20947F"
msgid "Hein ?! Terminé, comment ça ?"
msgstr "Hein?! Acabou, como assim?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "TOI_AUSSI_TU_ES_SURPRISE_A_ME_692B2F"
msgid "Toi aussi tu es surprise, ça me rassure."
msgstr "Você também está surpresa? Isso me tranquiliza."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "L_OBJECTIF_TAIT_DE_TESTER_LA_N_C31353"
msgid "L'objectif était de tester la nouvelle formule du X3 pour le tester mais..."
msgstr "O objetivo era testar a nova fórmula do X3, mas..."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "MAIS_6C5701"
msgid "Mais... ?"
msgstr "Mas...?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "APR_S_AVOIR_VU_SA_M_RE_S_ENVOY_4CD905"
msgid "Après avoir vu sa mère s'envoyer en l'air avec son petit ami, disons qu'elle a craqué."
msgstr "Depois de ver a própria mãe transando com o namorado dela, digamos que ela quebrou por dentro."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "ELLE_SE_SENTAIT_TELLEMENT_MAL_BEF94F"
msgid "Elle se sentait tellement mal qu'elle a voulu oublier tout ça."
msgstr "Ela estava se sentindo tão mal que quis esquecer tudo."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "NOTRE_COLLABORATEUR_LUI_A_DONN_A916DA"
msgid "Notre collaborateur lui a donné sa première dose, l’ancienne formule, hier soir."
msgstr "Nosso colaborador deu a ela a primeira dose, da fórmula antiga, ontem à noite."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "OH_PUTAIN_NON_F2E3A4"
msgid "Oh putain, non..."
msgstr "Ah, puta merda, não..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "ELLE_A_ENSUITE_EU_LA_SECONDE_D_62F1B2"
msgid "Elle a ensuite eu la seconde dose ce matin et elle a dû prendre la troisième il y a quelques minutes..."
msgstr "Depois ela tomou a segunda dose esta manhã e deve ter tomado a terceira faz alguns minutos..."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "NON_NON_NON_594749"
msgid "Non, non, non !"
msgstr "Não, não, não!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "A_TE_POSE_UN_PROBL_ME_DB3701"
msgid "Ça te pose un problème ?"
msgstr "Isso é um problema para você?"

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "NON_C_EST_JUSTE_QUE_A_S_EST_PA_3C17AC"
msgid "Non... C'est juste que... Ça s'est passé si vite..."
msgstr "Não... É só que... Aconteceu tão rápido..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "ALLEZ_OUBLIE_A_TU_VEUX_JETER_U_1AB606"
msgid "Allez, oublie ça, tu veux jeter un coup d'œil ?"
msgstr "Qual é, esquece isso. Quer dar uma olhada?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_SUIS_CURIEUX_DE_SAVOIR_QUEL_C7A1DC"
msgid "Je suis curieux de savoir à quel point elle doit se déchaîner sur ce gros lard !"
msgstr "Estou curioso para ver o quão selvagem ela deve estar ficando em cima daquele gordo!"

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "PUTAIN_SAITO_N_QU_EST_CE_QUE_T_9089A5"
msgid "Putain {{saito.n}}, qu'est-ce que t’as foutu !!!? Ça devait pas se passer comme ça !"
msgstr "Puta que pariu, {{saito.n}}, o que você fez!!!? Não era para as coisas terem chegado a esse ponto!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "t7739140aa9"
msgid "Non c'est bon, j'ai eu la réponse que je voulais."
msgstr "Não precisa se preocupar, eu já tive a resposta que queria."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "t520b4877fc"
msgid "Les enchères vont pouvoir commencer."
msgstr "O leilão já pode começar."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "tfb149e6489"
msgid "Donne lui le premier..."
msgstr "Dê a ela a primeira..."

#. Character:`natsume` | Attributes:`afraid`
#: game/story/home_minato_hallway.dialogue
msgctxt "tb07659f46a"
msgid "Tu es certain de vouloir lui faire subir ça ? Elle ne connait rien de la vie encore..."
msgstr "Você tem certeza de que quer fazê-la passar por isso? Ela ainda não conhece nada da vida..."

#. Character:`minato` | Attributes:`angry`
#: game/story/home_minato_hallway.dialogue
msgctxt "t45bc207a90"
msgid "{{natsume.n}} quand je te demanderais ton avis je te ferais signe !"
msgstr "{{natsume.n}}, quando eu quiser a sua opinião, eu te aviso!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "t13f4a1a01a"
msgid "En attendant tu la ferme et tu lui donne !"
msgstr "Até lá, cala a boca e entrega para ela!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "td7647dba04"
msgid "C'est compris ?"
msgstr "Fui claro?"

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_hallway.dialogue
msgctxt "t2709a8f1a3"
msgid "Oui..."
msgstr "Sim..."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "tcc788ec71d"
msgid "Il est diffèrent..."
msgstr "Este é diferente..."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "td892ce23c2"
msgid "Nouvelle formule, moins d'effets secondaires."
msgstr "Fórmula nova, menos efeitos colaterais."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "tc330c88e88"
msgid "Il n'y a plus d'explosion de la libido à la première et à la seconde prise."
msgstr "Não há mais aquela explosão de libido na primeira e na segunda dose."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "tba556fdddd"
msgid "A présent il est totalement intraçable..."
msgstr "Agora ela é totalmente indetectável..."

#. Character:`natsume` | Attributes:`afraid`
#: game/story/home_minato_hallway.dialogue
msgctxt "t568f6a06a3"
msgid "Quel horreur..."
msgstr "Que horror..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "td879bfbbab"
msgid "Les affaires sont les affaires..."
msgstr "Negócios são negócios..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "tb6ca61dba2"
msgid "Dis à {{netoru.n}} de lui donner ça et de prendre la photo."
msgstr "Diga ao {{netoru.n}} para dar isso a ela e tirar a foto."

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_minato_hallway.dialogue
msgctxt "t60c774a6b5"
msgid "Pfff..."
msgstr "Pfff..."

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_hallway.dialogue
msgctxt "t0d39c3d0d1"
msgid "C'est bon je vais le faire !"
msgstr "Está bem, eu vou fazer isso!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "tfe1faf9c95"
msgid "Brave fille !"
msgstr "Boa garota!"

#. Character:`cop`
#: game/story/home_minato_hallway.dialogue
msgctxt "D_SOL_POUR_TOUT_A_CETTE_BANDE_521D15"
msgid "Désolé pour tout ça... Cette bande de gamins a tellement fait de raffut que les supérieurs n'ont pas eu d'autre choix que de nous envoyer."
msgstr "Desculpe por tudo isso... Aquele bando de moleques fez tanto barulho que os superiores não tiveram escolha a não ser nos enviar para cá."

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_COMPRENDS_TR_S_BIEN_LA_SITU_747296"
msgid "Je comprends très bien la situation."
msgstr "Eu entendo perfeitamente a situação."

#. Character:`cop`
#: game/story/home_minato_hallway.dialogue
msgctxt "SINON_POUR_CHANGER_DE_SUJET_E09623"
msgid "Sinon, pour changer de sujet..."
msgstr "Mas mudando de assunto..."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "ALLEZ_Y_JE_VOUS_COUTE_AC86F8"
msgid "Allez-y, je vous écoute..."
msgstr "Pode falar, estou ouvindo..."

#. Character:`cop` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_Y_A_UNE_PETITE_NOUVELLE_AU_B651B0"
msgid "Il y a une petite nouvelle au poste de police et..."
msgstr "Tem uma novata na delegacia e..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "N_EN_DITES_PAS_PLUS_IL_S_AGIT_86FAD6"
msgid "N'en dites pas plus. Il s'agit de la nouvelle formule, encore moins d'effets secondaires et indétectable."
msgstr "Não diga mais nada. Trata-se da fórmula nova, com ainda menos efeitos colaterais e indetectável."

#. Character:`cop`
#: game/story/home_minato_hallway.dialogue
msgctxt "QUELLE_MERVEILLE_FD5EE4"
msgid "Quelle merveille..."
msgstr "Que maravilha..."

#. Character:`cop` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "AVEC_UNE_TELLE_CHOSE_VOS_PIRES_B352FF"
msgid "Avec une telle chose, vos pires ennemis deviennent vos alliés les plus fidèles."
msgstr "Com algo assim, seus piores inimigos se tornam seus aliados mais fiéis."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "EN_EFFET_LA_LOYAUT_EST_UNE_CHO_20453D"
msgid "En effet... La loyauté est une chose bien trop rare et précieuse de nos jours."
msgstr "De fato... Lealdade é algo raro e precioso demais hoje em dia."

#. Character:`cop` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "MERCI_ENCORE_POUR_VOTRE_G_N_RO_EAC468"
msgid "Merci encore pour votre générosité. Soyez sûr que vous ne serez pas déçu."
msgstr "Obrigado mais uma vez pela sua generosidade. Pode ter certeza de que não vai se arrepender."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "MAIS_J_EN_SUIS_CERTAIN_EE1BD4"
msgid "Mais j'en suis certain."
msgstr "Ah, disso eu tenho certeza."

#. Character:`cop` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "ILS_EN_SAVENT_BEAUCOUP_VOULEZ_C1C2E5"
msgid "Ils en savent beaucoup, voulez-vous que je les fasse disparaître discrètement ?"
msgstr "Eles sabem demais, quer que eu dê um sumiço neles discretamente?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "A_ME_FACILITERAIT_LA_VIE_MAIS_C02B14"
msgid "Ça me faciliterait la vie, mais ça ne serait pas amusant."
msgstr "Isso facilitaria a minha vida, mas não teria graça nenhuma."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_PR_F_RE_ATTENDRE_DE_VOIR_JU_60C5B5"
msgid "Je préfère attendre de voir jusqu'où ils seront prêts à aller avant d'agir."
msgstr "Prefiro esperar para ver até onde eles estão dispostos a ir antes de agir."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "ET_J_AI_D_J_QUELQUE_CHOSE_EN_C_C7DC7C"
msgid "Et j'ai déjà quelque chose en cours tout spécialement pour eux..."
msgstr "E eu já tenho algo em andamento planejado especialmente para eles..."

#. Character:`cop` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "DANS_CE_CAS_JE_VOUS_FAIS_CONFI_4F344B"
msgid "Dans ce cas, je vous fais confiance, n'hésitez pas à me contacter s'ils tentent quoi que ce soit."
msgstr "Nesse caso, confio no seu julgamento. Não hesite em me contatar se eles tentarem gracinha."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "C_TAIT_DONC_A_TON_PLAN_55AFBA"
msgid "C'était donc ça, ton plan...?"
msgstr "Então era esse o seu plano...?"

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_SUPPOSE_QUE_C_EST_UNE_R_USS_50A700"
msgid "Je suppose que c'est une réussite..."
msgstr "Imagino que tenha sido um sucesso..."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "TU_NE_CROIS_PAS_SI_BIEN_DIRE_FFFF31"
msgid "Tu ne crois pas si bien dire."
msgstr "Você não faz ideia."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "QU_EST_CE_QUE_J_AURAIS_AIM_TRE_871637"
msgid "Qu'est-ce que j'aurais aimé être là pour voir sa tête !"
msgstr "Quem me dera ter estado lá para ver a cara dele!"

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_ME_DEMANDE_CE_QU_IL_VA_TENT_3D4835"
msgid "Je me demande ce qu'il va tenter de faire à présent ?"
msgstr "Eu me pergunto o que ele vai tentar fazer agora?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_NE_CESSE_JAMAIS_DE_ME_SURPR_B4CF8B"
msgid "Il ne cesse jamais de me surprendre ces derniers temps."
msgstr "Ele não para de me surpreender ultimamente."

#. Character:`natsume` | Attributes:`afraid`
#: game/story/home_minato_hallway.dialogue
msgctxt "TOUT_A_N_EST_DONC_QU_UN_JEU_PO_40C35D"
msgid "Tout ça n'est donc qu'un jeu pour toi ?"
msgstr "Então tudo isso é só um jogo para você?"

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "NE_FAIS_PAS_TA_RABAT_JOIE_LAIS_694197"
msgid "Ne fais pas ta rabat-joie, laisse-moi profiter de ces moments de bonheur."
msgstr "Não seja estraga-prazeres, me deixa curtir esses momentos de felicidade."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "DE_PLUS_CE_N_EST_PAS_ENCORE_TE_E7D622"
msgid "De plus, ce n'est pas encore terminé."
msgstr "Além disso, ainda não acabou."

#. Character:`natsume` | Attributes:`surprised`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_Y_A_PIRE_VENIR_C02A25"
msgid "Il y a pire à venir ?"
msgstr "Vem coisa pior por aí?"

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "AH_SI_TU_SAVAIS_FF7299"
msgid "Ah, si tu savais..."
msgstr "Ah, se você soubesse..."

#. Character:`natsume` | Attributes:`pouting`
#: game/story/home_minato_hallway.dialogue
msgctxt "TU_ATTENDS_QUOI_POUR_ME_LE_DIR_4E86D0"
msgid "Tu attends quoi pour me le dire, dans ce cas ?"
msgstr "Está esperando o que para me contar, então?"

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "W_LA_SURPRISE_N_EN_SERA_QUE_M_F03CCC"
msgid "...[w] La surprise n'en sera que meilleure."
msgstr "...[w] A surpresa vai ser ainda melhor."

#. Character:`natsume` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "TU_ME_DONNES_L_IMPRESSION_D_TR_92971D"
msgid "Tu me donnes l'impression d'être un fauve qui joue avec sa nourriture."
msgstr "Você me dá a impressão de ser um predador brincando com a comida."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "OH_C_EST_VRAIMENT_COMME_A_QUE_E46F58"
msgid "Oh, c'est vraiment comme ça que tu me vois ?"
msgstr "Ah, é sério que você me vê assim?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_EST_TEMPS_DE_LUI_DONNER_LA_728936"
msgid "Il est temps de lui donner la seconde dose."
msgstr "Está na hora de dar a segunda dose para ela."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "OK_CEBE85"
msgid "Ok..."
msgstr "Beleza..."

#. Character:`minato` | Attributes:`suspicious`
#: game/story/home_minato_hallway.dialogue
msgctxt "TIENS_TU_NE_BRONCHES_PAS_POUR_2B351B"
msgid "Tiens, tu ne bronches pas pour une fois ?!"
msgstr "Olha só, não vai falar nada dessa vez?!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "A_NE_TE_RESSEMBLE_PAS_W_TU_ME_502F2E"
msgid "Ça ne te ressemble pas.[w] Tu me caches quelque chose ?"
msgstr "Isso não combina com você.[w] Está me escondendo alguma coisa?"

#. Character:`natsume` | Attributes:`afraid`
#: game/story/home_minato_hallway.dialogue
msgctxt "BIEN_S_R_QUE_NON_QU_EST_CE_QUI_072A2E"
msgid "Bien sûr que non ! Qu'est-ce qui te fait dire un truc pareil ?"
msgstr "Claro que não! O que te faz pensar uma porra dessas?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "MHHH_JE_DIRAIS_QUE_DEPUIS_QUE_69E620"
msgid "Mhhh... Je dirais que depuis que tu es rentrée en contact avec {{saito.n}}, ta personnalité a quelque peu changé... Tu t'es adoucie et tu t'es mise à avoir des remords."
msgstr "Mhhh... Eu diria que, desde que você entrou em contato com o {{saito.n}}, a sua personalidade mudou um pouco... Você amoleceu e começou a ter remorsos."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "ME_DIS_PAS_QUE_TU_ES_AMOUREUSE_3CB34B"
msgid "Me dis pas que... tu es amoureuse de ce déchet ?"
msgstr "Não me diga que... você está apaixonada por aquele fracassado?"

#. Character:`natsume` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "HAHA_SI_C_EST_CE_QUE_TU_AS_TRO_848E7D"
msgid "Haha ! Si c'est ce que tu as trouvé de mieux pour te moquer de moi, il va falloir faire mieux."
msgstr "Haha! Se isso é o melhor que você conseguiu inventar para tirar sarro de mim, vai ter que se esforçar mais."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "MAIS_TU_N_AS_PAS_D_MENTI_NON_P_90AAB7"
msgid "Mais tu n'as pas démenti non plus..."
msgstr "Mas você também não negou..."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "J_AIMERAIS_DES_EXPLICATIONS_4395E6"
msgid "J'aimerais des explications !"
msgstr "Eu quero explicações!"

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_M_A_SEMBL_QUE_JE_POURRAIS_R_56B9FD"
msgid "Il m'a semblé que je pourrais récupérer cette fille pour moi."
msgstr "Eu achei que ia poder ficar com aquela garota para mim."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "MAIS_VOTRE_COLLABORATRICE_A_ME_856BC5"
msgid "Mais votre... collaboratrice a mentionné le contraire."
msgstr "Mas a sua... colaboradora disse o contrário."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "EST_IL_VRAI_QU_ELLE_SERA_PROPO_291BDC"
msgid "Est-il vrai qu'elle sera proposée à des enchères ?"
msgstr "É verdade que ela vai ser colocada num leilão?"

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "CETTE_FILLE_A_D_CID_MENT_LA_L_91672D"
msgid "... Cette fille a décidément la langue bien trop pendue !"
msgstr "... Aquela garota tem a língua comprida demais, que saco!"

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "OUI_C_EST_VRAI_LE_PLAN_A_QUELQ_38EED1"
msgid "Oui, c'est vrai, le plan a quelque peu changé."
msgstr "Sim, é verdade, o plano mudou um pouco."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "L_ORIGINE_VOUS_DEVIEZ_LA_R_CU_1CCFDF"
msgid "À l'origine, vous deviez la récupérer pour vous, mais les enchères sont montées tellement haut, à ma grande surprise, qu'on a dû revoir nos plans..."
msgstr "No começo, você ia ficar com ela, mas os lances subiram tanto, para a minha grande surpresa, que tivemos que rever nossos planos..."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "MAIS_ET_MA_VENGEANCE_E8E507"
msgid "Mais... et ma vengeance ?"
msgstr "Mas... e a minha vingança?"

#. Character:`netoru` | Attributes:`angry`
#: game/story/home_minato_hallway.dialogue
msgctxt "VOUS_AVIEZ_PROMIS_D45F26"
msgid "Vous aviez promis !"
msgstr "Você tinha prometido!"

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "SI_VOUS_AVEZ_LES_MOYENS_VOUS_P_FDD8B8"
msgid "Si vous avez les moyens, vous pouvez toujours enchérir, mais j'ai bien peur que ce ne soit pas le cas."
msgstr "Se você tiver dinheiro, pode muito bem dar um lance, mas receio bem que esse não seja o caso."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "BON_SANG_VOUS_M_AVEZ_ROUL_FC0D63"
msgid "Bon sang, vous m'avez roulé !"
msgstr "Puta merda, você me passou para trás!"

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_SUIS_CONSCIENT_DU_PROBL_ME_69F50F"
msgid "Je suis conscient du problème, aussi je peux vous proposer quelque chose qui pourrait sûrement remplacer cette perte."
msgstr "Eu entendo o problema, por isso posso te propor algo que certamente compensaria essa perda."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/home_minato_hallway.dialogue
msgctxt "ALLEZ_Y_F2063A"
msgid "Allez-y..."
msgstr "Diga..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "POUR_VITER_TOUT_PROBL_ME_FUTUR_3ED3F6"
msgid "Pour éviter tout problème futur, nous aurions besoin que vous vous occupiez de la mère de la jeune fille."
msgstr "Para evitar qualquer problema no futuro, precisaríamos que você cuidasse da mãe da garota."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_ME_SEMBLE_QU_ELLE_CORRESPON_4C9E8B"
msgid "Il me semble qu'elle correspond davantage à votre type de femme."
msgstr "Me parece que ela faz mais o seu tipo de mulher."

#. Character:`netoru` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "MHHH_EH_BIEN_VOUS_N_AVEZ_PAS_T_EE0755"
msgid "Mhhh eh bien... vous n'avez pas tort en effet."
msgstr "Mhhh, bom... você não está errado, de fato."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "VOUS_AUREZ_BIEN_S_R_ACC_S_AU_X_449FA3"
msgid "Vous aurez bien sûr accès au X3 autant de fois que nécessaire."
msgstr "Você terá, claro, acesso ao X3 quantas vezes for necessário."

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "CE_N_EST_PAS_DU_TOUT_UNE_MAUVA_5B7FB1"
msgid "Ce n'est pas du tout une mauvaise proposition, en effet !"
msgstr "Pensando bem, não é uma proposta nada ruim!"

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "PARFAIT_SI_CELA_VOUS_CONVIENT_EE2772"
msgid "Parfait ! Si cela vous convient, j'ai même quelque chose pour rendre ça encore plus intéressant !"
msgstr "Perfeito! Se isso te agrada, eu tenho até uma coisa para deixar isso ainda mais interessante!"

#. Character:`netoru`
#: game/story/home_minato_hallway.dialogue
msgctxt "VOUS_AVEZ_TOUTE_MON_ATTENTION_B85956"
msgid "Vous avez toute mon attention."
msgstr "Sou todo ouvidos."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "MES_F_LICITATIONS_VOUS_AVEZ_T_26D3D9"
msgid "Mes félicitations, vous avez été impréssionnant !"
msgstr "Meus parabéns, você foi impressionante!"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/home_minato_hallway.dialogue
msgctxt "CE_N_EST_ENCORE_QU_UN_GAMIN_ME_F9B112"
msgid "Ce n'est encore qu'un gamin à mes yeux."
msgstr "Ele ainda é só um moleque para mim."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "TOUT_DE_M_ME_PENSER_QU_IL_SERA_CFB188"
msgid "Tout de même, penser qu'il serait venu en découdre de lui-même."
msgstr "Mesmo assim, quem diria que ele viria tirar satisfação por conta própria."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_NE_SAIS_PAS_SI_C_EST_DU_COU_EDD041"
msgid "Je ne sais pas si c'est du courage ou de la folie."
msgstr "Não sei se é coragem ou loucura."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "CERTAINEMENT_UN_PEU_DES_DEUX_74E46E"
msgid "Certainement un peu des deux."
msgstr "Com certeza um pouco dos dois."

#. Character:`netoru` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "ET_MAINTENANT_00054D"
msgid "Et maintenant ?"
msgstr "E agora?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "ON_ADMIRE_LA_DERNI_RE_TAPE_DU_D00AE1"
msgid "On admire la dernière étape du plan."
msgstr "A gente admira a última etapa do plano."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "DEMAIN_MATIN_J_EN_CONNAIS_UN_Q_A80B2B"
msgid "Demain matin j'en connais un qui aura une belle surprise."
msgstr "Amanhã de manhã, eu conheço alguém que vai ter uma bela surpresa."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "ALORS_TU_L_AS_TROUV_6AD545"
msgid "Alors ? Tu l'as trouvé ?"
msgstr "E aí? Encontrou ele?"

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "OUI_C_EST_BON_4C3803"
msgid "Oui, c'est bon."
msgstr "Sim, encontrei."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "TU_VOIS_JE_SAVAIS_BIEN_QUE_TU_71A398"
msgid "Tu vois ! Je savais bien que tu serais 1000 fois plus efficace que ces idiots en uniforme."
msgstr "Está vendo! Eu sabia muito bem que você seria mil vezes mais eficiente que aqueles idiotas fardados."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "DEPUIS_LE_TEMPS_TU_DEVRAIS_SAV_2D5137"
msgid "Depuis le temps, tu devrais savoir que j'ai toujours raison."
msgstr "Depois de tanto tempo, você já deveria saber que eu sempre tenho razão."

#. Character:`natsume` | Attributes:`afraid`
#: game/story/home_minato_hallway.dialogue
msgctxt "LE_LOCALISER_N_TAIT_PAS_BIEN_D_C91279"
msgid "Le localiser n'était pas bien difficile, mais pour ce qui est de la confiance, par contre, ça va être compliqué."
msgstr "Localizar ele não foi muito difícil, mas fazer ele confiar em mim, por outro lado, vai ser complicado."

#. Character:`natsume` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_SAIT_PERTINEMMENT_QUE_JE_TR_37AB05"
msgid "Il sait pertinemment que je travaille pour toi, il est en permanence sur ses gardes."
msgstr "Ele sabe perfeitamente que eu trabalho para você, está o tempo todo ligado."

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "NATSUME_N_CE_N_EST_PAS_MON_PR_09B605"
msgid "{{natsume.n}}... Ce n'est pas mon problème, ça, c'est le tien ! Moi, je t'ai donné une mission, à toi de l'accomplir."
msgstr "{{natsume.n}}... Isso não é problema meu, é seu! Eu te dei uma missão, trate de cumprir."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "SERS_TOI_DE_TON_CORPS_A_NE_DEV_08FB21"
msgid "Sers-toi de ton corps, ça ne devrait pas être un problème, non ?"
msgstr "Use o seu corpo, isso não deve ser um problema para você, deve?"

#. Character:`natsume` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "W_ENCORE_UNE_FOIS_JE_NE_COMPR_52F86C"
msgid "...[w] Encore une fois, je ne comprends pas pourquoi gâcher autant d'énergie pour ça."
msgstr "...[w] Mais uma vez, eu não entendo por que desperdiçar tanta energia com isso."

#. Character:`minato` | Attributes:`angry`
#: game/story/home_minato_hallway.dialogue
msgctxt "TU_COMMENCES_S_RIEUSEMENT_ME_L_1D12FE"
msgid "Tu commences sérieusement à me les briser, {{natsume.n}} ! À aucun moment je ne t'ai donné le droit de remettre en question mes décisions ! Continue et tu sais très bien ce qui risque d'arriver."
msgstr "Você está começando a me encher o saco de verdade, {{natsume.n}}! Em nenhum momento eu te dei o direito de questionar as minhas decisões! Continue assim e você sabe muito bem o que vai te acontecer."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_NE_VEUX_PLUS_REVOIR_TA_T_TE_645B8F"
msgid "Je ne veux plus revoir ta tête avant que tu aies gagné sa confiance."
msgstr "Não quero ver a sua cara de novo até que você tenha ganho a confiança dele."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "EST_CE_QUE_C_EST_BIEN_COMPRIS_A478B2"
msgid "Est-ce que c'est bien compris ?"
msgstr "Fui claro?"

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "PARFAIT_MAINTENANT_TU_D_GAGES_BCDD0D"
msgid "Parfait, maintenant tu dégages !"
msgstr "Perfeito, agora suma da minha frente!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "AH_LA_FILLE_PRODIGUE_EST_DE_RE_005F00"
msgid "Ah, la fille prodigue est de retour !"
msgstr "Ah, a filha pródiga está de volta!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_SUPPOSE_QUE_SI_TU_ES_L_C_ES_99108A"
msgid "Je suppose que si tu es là, c’est que tu as de bonnes nouvelles ?"
msgstr "Suponho que, se você está aqui, é porque traz boas notícias?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "EH_BIEN_ALORS_RACONTE_MOI_QU_E_5A7F60"
msgid "Eh bien alors ? Raconte-moi, qu’est-ce qu’il est en train de faire ?"
msgstr "Bom, então? Me conta, o que ele está aprontando?"

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_IL_S_ENTRA_NE_770E70"
msgid "Il... Il s’entraîne..."
msgstr "Ele... Ele está treinando..."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_PENSE_QU_IL_PEUT_VENIR_R_GL_0A732E"
msgid "Il pense qu’il peut venir régler ça avec ses poings."
msgstr "Ele acha que pode vir resolver as coisas no soco."

#. Character:`minato` | Attributes:`suspicious`
#: game/story/home_minato_hallway.dialogue
msgctxt "HEIN_TU_ES_S_RIEUSE_FCDDB6"
msgid "Hein ?! Tu es sérieuse ?"
msgstr "Hein?! Você está falando sério?"

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "ATTENDS_ATTENDS_TU_VEUX_DIRE_Q_348649"
msgid "Attends, attends, tu veux dire qu’il est parti s’entraîner dans son coin, tout ça pour espérer venir m’affronter ?"
msgstr "Espera, espera, você está me dizendo que ele foi treinar num canto, tudo isso só na esperança de vir me enfrentar?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_PENSE_QUE_TOUT_A_VA_SE_R_GL_A214AE"
msgid "Il pense que tout ça va se régler dans un octogone ?"
msgstr "Ele acha que tudo isso vai se resolver num ringue?"

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_SAIS_M_ME_MOI_JE_RESSENS_UN_25DA0C"
msgid "Je sais... Même moi je ressens un malaise quand j’y pense."
msgstr "Eu sei... Até eu sinto vergonha alheia só de pensar."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "BON_SANG_TU_M_TONNES_5C3024"
msgid "Bon sang, tu m’étonnes..!"
msgstr "Puta merda, não me diga!"

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_ESP_RE_PARVENIR_FAIRE_QUOI_C6AC54"
msgid "Il espère parvenir à faire quoi en une ou deux semaines ?"
msgstr "Ele espera conseguir fazer o que em uma ou duas semanas?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "ON_DIRAIT_QU_IL_S_EST_CRU_TRE_A06411"
msgid "On dirait qu’il s’est cru être le protagoniste d’un foutu shonen."
msgstr "Parece até que ele achou que era o protagonista de um maldito shonen."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "BON_SANG_SAITO_N_TU_ME_SURPREN_289FE3"
msgid "Bon sang {{saito.n}}... Tu me surprendras toujours..."
msgstr "Caramba, {{saito.n}}... Você sempre vai me surpreender..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "HAHAHA_EH_BIEN_ON_VA_LUI_DONNE_BE4DA9"
msgid "Hahaha, eh bien... On va lui donner ce qu’il veut !"
msgstr "Hahaha, bom... Vamos dar a ele o que ele quer!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_L_AURA_SON_COMBAT_ET_J_EN_P_C2ABAF"
msgid "Il l’aura, son combat, et j’en profiterai pour écraser sa volonté moi-même !"
msgstr "Ele vai ter a lutinha dele, e eu vou aproveitar para esmagar a força de vontade dele eu mesmo!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "FAUDRA_FAIRE_ATTENTION_AU_POUV_26EA1F"
msgid "Faudra faire attention au pouvoir de l’amitié..."
msgstr "Vai ver ele acha que tem o poder da amizade..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "HAHAHA_CB069D"
msgid "Hahaha !"
msgstr "Hahaha!"

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "AU_FAIT_DESCENDS_LA_VOIR_ELLE_EBA0AA"
msgid "Au fait ! Descends la voir, elle est un peu trop bruyante ces derniers temps."
msgstr "A propósito! Vá lá embaixo ver ela, ela anda barulhenta demais ultimamente."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "D_J_QU_EST_CE_QUE_TU_LUI_AS_DI_930D66"
msgid "Déjà ? Qu’est-ce que tu lui as dit pour qu’elle se calme si vite ?"
msgstr "Já? O que você disse para ela sossegar tão rápido?"

#. Character:`natsume` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "QUE_SOIT_ELLE_SE_CALMAIT_SOIT_B046F6"
msgid "Que soit elle se calmait, soit elle passait les prochains jours avec le caleçon de {{netoru.n}} enfoncé dans sa bouche !"
msgstr "Que ou ela calava a boca, ou passava os próximos dias com a cueca do {{netoru.n}} enfiada na boca!"

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "HAHAHA_J_AURAIS_ARR_T_DE_PARLE_F84535"
msgid "Hahaha ! J’aurais arrêté de parler moi aussi, c’est certain !"
msgstr "Hahaha! Eu também teria parado de falar na hora, com certeza!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "TU_PEUX_RETOURNER_LA_SURVEILLA_647617"
msgid "Tu peux retourner à la surveillance de l’autre déchet !"
msgstr "Pode voltar a vigiar aquele outro fracassado!"

#. Character:`chiaki`
#: game/story/home_minato_hallway.dialogue
msgctxt "W_IL_NE_FAUT_PAS_FAIRE_A_FEB559"
msgid "...[w] Il ne faut pas faire ça !"
msgstr "...[w] Não faz isso!"

#. Character:`natsume` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "FAIRE_QUOI_4E3A43"
msgid "Faire... quoi ?"
msgstr "Não fazer... o quê?"

#. Character:`chiaki`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_SAIT_TOUJOURS_QUAND_ON_LUI_A79011"
msgid "Il sait toujours quand on lui ment..."
msgstr "Ele sempre sabe quando estão mentindo para ele..."

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_hallway.dialogue
msgctxt "W_FAIT_CHIER_2D5348"
msgid "...[w] Fait chier..."
msgstr "...[w] Que merda..."

#. Character:`asami`
#: game/story/home_minato_hallway.dialogue
msgctxt "FONT_SIZE_14_NATSUME_N_FONT_S_91A5E7"
msgid "[font_size=14]{{natsume.n}} !!![/font_size]"
msgstr "[font_size=14]{{natsume.n}}![/font_size]"

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "C_EST_BIEN_BEAU_DE_SYMPATHISER_6729A2"
msgid "C'est bien beau de sympathiser avec la marchandise, mais après c'est plus difficile d'abattre la bête quand on s'y est attaché."
msgstr "É muito bonito se afeiçoar à mercadoria, mas depois fica mais difícil dar um fim nela quando a gente se apega."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "ON_DOIT_VRAIMENT_LAISSER_CE_GR_CE746D"
msgid "On doit vraiment laisser ce gros lard faire ce qu'il veut avec la mère d'{{asami.n}} ?"
msgstr "A gente tem mesmo que deixar aquele gordo escroto fazer o que quiser com a mãe da {{asami.n}}?"

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "BIEN_S_R_QU_ON_LE_DOIT_C_EST_D_51690F"
msgid "Bien sûr qu'on le doit, c'est du gagnant-gagnant cette histoire."
msgstr "Claro que sim, essa história é uma situação de ganha-ganha."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "DE_CETTE_FA_ON_SA_M_RE_LAISSER_1A4E71"
msgid "De cette façon, sa mère laissera définitivement tomber les recherches et concentrera son attention sur autre chose."
msgstr "Desse jeito, a mãe dela vai desistir de uma vez por todas das buscas e vai focar a atenção em outra coisa."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "COMME_A_TOUT_FINIRA_PAR_SE_TAS_6A364C"
msgid "Comme ça, tout finira par se tasser très vite."
msgstr "Assim, a poeira vai acabar baixando bem rápido."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "EN_PLUS_LE_X3_FONCTIONNE_ENCOR_33A0BF"
msgid "En plus, le X3 fonctionne encore mieux quand il y a une profonde haine ou révulsion entre les deux parties."
msgstr "Além disso, o X3 funciona ainda melhor quando existe um ódio profundo ou repulsa entre as duas partes."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "COMME_SI_LES_EFFETS_TAIENT_AMP_01F3AA"
msgid "Comme si les effets étaient amplifiés."
msgstr "É como se os efeitos fossem amplificados."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "ASAMI_N_ET_SA_M_RE_VIVRONT_HE_D3229E"
msgid "{{asami.n}} et sa mère vivront heureuses comme jamais !"
msgstr "{{asami.n}} e a mãe dela vão viver felizes como nunca!"

#. Character:`minato` | Attributes:`suspicious`
#: game/story/home_minato_hallway.dialogue
msgctxt "OH_JE_VOIS_LES_REMORDS_ILS_SO_4EDB20"
msgid "... Oh, je vois... Les remords... Ils sont de plus en plus forts."
msgstr "... Ah, já estou vendo... O remorso... Ele está cada vez mais forte."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "DU_COUP_JE_ME_POSE_UNE_QUESTIO_5E5064"
msgid "Du coup, je me pose une question... est-ce que je peux toujours te faire confiance ?"
msgstr "Com isso, me vem uma pergunta... eu ainda posso confiar em você?"

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "VAS_TU_SAGEMENT_OB_IR_OU_ME_CR_0E4FDE"
msgid "Vas-tu sagement obéir ou me créer des problèmes ?"
msgstr "Você vai obedecer direitinho ou vai me criar problemas?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "AI_JE_BESOIN_DE_TE_RAPPELER_CE_C91A49"
msgid "Ai-je besoin de te rappeler ce que tu risques de perdre si jamais tu vas à l'encontre de ma volonté ?"
msgstr "Preciso te lembrar do que você corre o risco de perder se for contra a minha vontade?"

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_minato_hallway.dialogue
msgctxt "NON_C_EST_BON_JE_N_INTERVIENDR_88CD58"
msgid "Non, c'est bon... Je... n'interviendrai pas."
msgstr "Não, deixa para lá... Eu... não vou me meter."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "EH_BIEN_VOIL_TU_VOIS_QUAND_TU_DF0188"
msgid "Eh bien voilà, tu vois quand tu veux !"
msgstr "Olha aí, viu só como você consegue quando quer!"

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_hallway.dialogue
msgctxt "D_SOL_E_ASAMI_N_6288B3"
msgid "Désolée {{asami.n}}..."
msgstr "Desculpa, {{asami.n}}..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "PUTAIN_DE_MERDE_B24118"
msgid "Putain de merde..."
msgstr "Puta que pariu..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "POURQUOI_CE_GROS_PORC_D_CROCHE_5B4BA1"
msgid "Pourquoi ce gros porc décroche pas son putain de téléphone ?"
msgstr "Por que aquele porco gordo não atende a porra do telefone?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "J_ESP_RE_POUR_LUI_QU_IL_EST_PA_696699"
msgid "J’espère pour lui qu’il est pas en train de me ghoster... sinon..."
msgstr "Espero que ele não esteja me dando um bolo... se não..."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "OH_J_ARRIVE_AU_MAUVAIS_MOMENT_7A825C"
msgid "Oh, j’arrive au mauvais moment ?"
msgstr "Opa, cheguei numa hora ruim?"

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "QU_EST_CE_QUI_SE_PASSE_7ED4FC"
msgid "Qu’est-ce qui se passe ?"
msgstr "O que está acontecendo?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "W_CET_ENFOIR_EST_ENTR_CHEZ_LA_38A127"
msgid "...[w] Cet enfoiré est entré chez la daronne d’{{asami.n}} hier soir, mais..."
msgstr "...[w] Aquele desgraçado entrou na casa da mãe da {{asami.n}} ontem à noite, mas..."

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_EN_EST_JAMAIS_RESSORTI_7DC35F"
msgid "Il en est jamais ressorti."
msgstr "Ele nunca mais saiu de lá."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "ET_LE_PIRE_ELLE_VA_BIEN_2874D6"
msgid "Et le pire ? Elle va bien."
msgstr "E o pior? Ela está ótima."

#. Character:`minato` | Attributes:`angry`
#: game/story/home_minato_hallway.dialogue
msgctxt "ELLE_A_M_ME_PAS_RE_U_LA_TROISI_C19EFE"
msgid "Elle a même pas reçu la troisième dose !"
msgstr "Ela nem sequer recebeu a terceira dose!"

#. Character:`minato` | Attributes:`suspicious`
#: game/story/home_minato_hallway.dialogue
msgctxt "T_AURAIS_PAS_UNE_PETITE_ID_E_P_467B88"
msgid "T’aurais pas une petite idée, par hasard ?"
msgstr "Você não tem nenhuma pista, por acaso?"

#. Character:`natsume` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "NON_J_TAIS_AVEC_SAITO_N_TOUTE_EAA1BE"
msgid "Non... J’étais avec {{saito.n}} toute la soirée, il a pas bougé d’un poil."
msgstr "Não... Eu passei a noite toda com o {{saito.n}}, ele não se mexeu um centímetro."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "CE_D_BILE_CONTINUE_S_ENTRA_NER_D9B0D4"
msgid "Ce débile continue à s’entraîner comme un taré ?"
msgstr "Aquele idiota continua treinando que nem um condenado?"

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "OUAIS_CHAQUE_SOIR_IL_RENTRE_CO_58E587"
msgid "Ouais... Chaque soir, il rentre complètement crevé."
msgstr "É... Toda noite ele volta completamente esgotado."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "T_AS_R_USSI_L_AMADOUER_UN_PEU_002244"
msgid "T’as réussi à l’amadouer un peu ? Il commence à baisser sa garde ?"
msgstr "Você conseguiu amansar ele um pouco? Ele está começando a baixar a guarda?"

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_JE_CROIS_QU_IL_SE_D_TEND_UN_BDECF0"
msgid "Je... je crois qu’il se détend un peu avec moi. Il parle plus."
msgstr "Eu... eu acho que ele está se soltando um pouco comigo. Ele conversa mais."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "MAIS_IL_SAIT_TOUJOURS_QU_ON_BO_9CAFF4"
msgid "Mais... il sait toujours qu’on bosse ensemble, toi et moi, alors..."
msgstr "Mais... ele ainda sabe que a gente trabalha junto, você e eu, então..."

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "C_EST_TON_PROBL_ME_A_D_BROUILL_8C3A5C"
msgid "C’est ton problème, ça. Débrouille-toi pour qu’il tombe complètement sous ton charme."
msgstr "Isso é problema seu. Dá o seu jeito para ele cair de quatro por você."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "LA_FIN_C_EST_TOI_QUI_LUI_PLAN_4E6351"
msgid "À la fin, c’est toi qui lui planteras le couteau dans le dos."
msgstr "No final, vai ser você quem vai enfiar a faca nas costas dele."

#. Character:`natsume` | Attributes:`surprised`
#: game/story/home_minato_hallway.dialogue
msgctxt "QUOI_TU_VEUX_DIRE_QUOI_PAR_L_3B575D"
msgid "Quoi ?! Tu veux dire quoi par là ?"
msgstr "O quê?! O que você quer dizer com isso?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "T_AS_D_J_OUBLI_COMMENT_A_VA_FI_46A1C3"
msgid "T’as déjà oublié comment ça va finir ?"
msgstr "Já se esqueceu de como isso vai terminar?"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "ASAMI_N_VA_TRE_VENDUE_ET_SAIT_1A5396"
msgid "{{asami.n}} va être vendue, et {{saito.n}}..."
msgstr "A {{asami.n}} vai ser vendida, e o {{saito.n}}..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_SAIS_PAS_ENCORE_EXACTEMENT_CF7E1E"
msgid "Je sais pas encore exactement ce que je vais lui faire, mais j’ai quelques idées intéressantes..."
msgstr "Ainda não sei exatamente o que vou fazer com ele, mas estou com umas ideias bem interessantes..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "J_AIMERAIS_VOIR_JUSQU_QUEL_POI_2CB2FD"
msgid "J’aimerais voir jusqu’à quel point quelqu’un peut encaisser du X3 avant de perdre complètement les pédales."
msgstr "Quero ver até que ponto alguém consegue aguentar o X3 antes de enlouquecer de vez."

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_minato_hallway.dialogue
msgctxt "C_EST_MONSTRUEUX_3B24CC"
msgid "C’est monstrueux..."
msgstr "Isso é monstruoso..."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "CE_SERA_PAS_JOLI_VOIR_C_EST_S_78923A"
msgid "Ce sera pas joli à voir, c’est sûr."
msgstr "Não vai ser nada bonito de ver, com certeza."

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "VA_VOIR_ASAMI_N_J_AIME_PAS_QUA_1A5DB3"
msgid "Va voir {{asami.n}}. J’aime pas quand elle reste aussi silencieuse."
msgstr "Vá ver a {{asami.n}}. Não gosto quando ela fica quieta desse jeito."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "J_AIMERAIS_VITER_QU_ELLE_FASSE_E34A82"
msgid "J’aimerais éviter qu’elle fasse une connerie du genre se mordre la langue pour en finir."
msgstr "Quero evitar que ela faça alguma idiotice, tipo morder a própria língua para acabar com tudo."

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_minato_hallway.dialogue
msgctxt "MERDE_QU_EST_CE_QUE_JE_SUIS_EN_54FFCF"
msgid "Merde... Qu’est-ce que je suis en train de foutre... ?!"
msgstr "Merda... Que porra eu estou fazendo...?!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "TU_TOMBES_BIEN_7E3E51"
msgid "Tu tombes bien !"
msgstr "Chegou na hora certa!"

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "C_EST_LE_MOMENT_DE_LUI_DONNER_83544C"
msgid "C’est le moment de lui donner sa troisième dose."
msgstr "Está na hora de dar a terceira dose para ela."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_FAUT_FAIRE_A_RAPIDEMENT_LE_9BADD2"
msgid "Il faut faire ça rapidement, le client viendra bientôt la récupérer."
msgstr "Temos que fazer isso rápido, o cliente vem buscar ela daqui a pouco."

#. Character:`minato`
#: game/story/home_minato_hallway.dialogue
msgctxt "MONTRE_LUI_CETTE_PHOTO_SURTOUT_F69A85"
msgid "Montre-lui cette photo surtout."
msgstr "E trate de mostrar esta foto para ela."

#. Character:`natsume` | Attributes:`surprised`
#: game/story/home_minato_hallway.dialogue
msgctxt "WOAH_J_AI_JAMAIS_VU_UN_TYPE_AU_F6E65F"
msgid "Woah... ! J’ai jamais vu un type aussi moche."
msgstr "Caramba...! Eu nunca vi um cara tão feio."

#. Character:`minato` | Attributes:`suspicious`
#: game/story/home_minato_hallway.dialogue
msgctxt "PEUT_TRE_MAIS_CE_TYPE_VA_NOUS_A1F6E4"
msgid "Peut-être, mais ce type va nous permettre d’industrialiser ça à une échelle mondiale."
msgstr "Pode ser, mas esse cara vai permitir que a gente industrialize isso em escala mundial."

#. Character:`minato` | Attributes:`upset`
#: game/story/home_minato_hallway.dialogue
msgctxt "TU_NE_DOIS_PAS_TE_FOIRER_707F4B"
msgid "Tu ne dois pas te foirer !"
msgstr "Você não pode vacilar!"

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_VAIS_T_ACCOMPAGNER_POUR_DIS_9BDDF3"
msgid "Je vais t’accompagner pour discuter avec elle une dernière fois."
msgstr "Eu vou com você para falar com ela uma última vez."

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "MINATO_N_6CAF70"
msgid "{{minato.n}} !!"
msgstr "{{minato.n}}!!"

#. Character:`chiaki`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_EST_D_J_PARTI_1DA457"
msgid "Il est déjà parti..."
msgstr "Ele já foi embora..."

#. Character:`natsume` | Attributes:`bad`
#: game/story/home_minato_hallway.dialogue
msgctxt "ASAMI_N_ON_SE_CASSE_6A4A9E"
msgid "{{asami.n}} on se casse !"
msgstr "{{asami.n}}, vamos dar o fora daqui!"

#. Character:`asami`
#: game/story/home_minato_hallway.dialogue
msgctxt "FONT_SIZE_14_G_NIAL_MAIS_JE_S_A1648B"
msgid "[font_size=14]Génial, mais je suis toujours attachée au lit, je te rappelle ![/font_size]"
msgstr "[font_size=14]Que ótimo, mas eu ainda estou amarrada na cama, caso você não lembre! [/font_size]"

#. Character:`natsume` | Attributes:`cute`
#: game/story/home_minato_hallway.dialogue
msgctxt "AH_OUI_C_EST_VRAI_D_SOL_E_F14D8D"
msgid "Ah oui c'est vrai désolée."
msgstr "Ah é, verdade, desculpa."

#. Character:`chiaki` | Attributes:`shy`
#: game/story/home_minato_hallway.dialogue
msgctxt "VOUS_ALLEZ_O_182BAC"
msgid "Vous allez où ?"
msgstr "Vocês vão para onde?"

#. Character:`natsume` | Attributes:`happy`
#: game/story/home_minato_hallway.dialogue
msgctxt "ON_S_EN_VA_TU_SAIS_O_TON_FR_RE_2CA7A4"
msgid "On s’en va, tu sais où ton frère range les clefs des menottes ?"
msgstr "A gente vai embora. Você sabe onde o seu irmão esconde as chaves das algemas?"

#. Character:`chiaki` | Attributes:`smile`
#: game/story/home_minato_hallway.dialogue
msgctxt "OUI_JE_PEUX_VENIR_AVEC_VOUS_5D7AFC"
msgid "Oui ! Je peux venir avec vous ?"
msgstr "Sei! Eu posso ir com vocês?"

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "BIEN_S_R_89E6F7"
msgid "Bien sûr !"
msgstr "Claro que sim!"

#. Character:`chiaki`
#: game/story/home_minato_hallway.dialogue
msgctxt "JE_VAIS_LES_CHERCHER_JE_ME_D_P_914077"
msgid "Je vais les chercher, je me dépêche !"
msgstr "Vou pegar elas, vou correndo!"

#. Character:`natsume` | Attributes:`neutral`
#: game/story/home_minato_hallway.dialogue
msgctxt "ALLEZ_C_EST_PAS_LE_MOMENT_DE_F_7875DC"
msgid "Allez... C’est pas le moment de flancher ! Le plus dur reste à venir !"
msgstr "Vamos lá... Não é hora de fraquejar! O mais difícil ainda está por vir!"

#. Character:`chiaki`
#: game/story/home_minato_hallway.dialogue
msgctxt "IL_NE_FAUT_PAS_D_SOB_IR_MON_FR_DF6399"
msgid "Il ne faut pas désobéir à mon frère."
msgstr "Não pode desobedecer ao meu irmão."

#. Character:`chiaki` | Attributes:`afraid`
#: game/story/home_minato_hallway.dialogue
msgctxt "VOUS_N_AVEZ_PAS_LE_DROIT_DE_SO_2060E5"
msgid "Vous n’avez pas le droit de sortir !"
msgstr "Vocês não têm o direito de sair!"

#. Character:`natsume`
#: game/story/home_minato_hallway.dialogue
msgctxt "FONT_SIZE_14_CHIAKI_N_LAISSE_98F78C"
msgid "[font_size=14]{{chiaki.n}} laisse-nous sortir ! Ton frère est un putain de psychopathe ![/font_size]"
msgstr "[font_size=14]{{chiaki.n}}, deixa a gente sair! O seu irmão é a porra de um psicopata![/font_size]"

#. Character:`chiaki` | Attributes:`think`
#: game/story/home_minato_hallway.dialogue
msgctxt "NON_JE_LUI_DIRAI_QUE_VOUS_AVEZ_85BBA8"
msgid "Non ! Je lui dirai que vous avez voulu vous échapper !"
msgstr "Não! Eu vou falar para ele que vocês tentaram fugir!"

#. Character:`chiaki` | Attributes:`cry`
#: game/story/home_minato_hallway.dialogue
msgctxt "PERSONNE_NE_SORTIRA_SINON_MON_AC8842"
msgid "Personne ne sortira, sinon mon grand frère sera triste..."
msgstr "Ninguém vai sair, se não o meu irmão vai ficar triste..."

#. Character:`narrator`
#: game/story/city.dialogue
msgctxt "city_dbd25961"
msgid "Je devrais sonner à la porte."
msgstr "Eu deveria tocar a campainha."

#. Character:`narrator`
#: game/story/city.dialogue
msgctxt "city_dbd25961_1"
msgid "Je devrais sonner à la porte."
msgstr "Eu deveria tocar a campainha."

#. Character:`asami`
#: game/story/city.dialogue
msgctxt "city_c12259b9"
msgid "Non ! Je ne vais pas me dégonfler maintenant que je suis là ! Allez {{asami.n}}, appuie sur cette fichue sonnette !"
msgstr "Não! Eu não vou dar para trás agora que já estou aqui! Vai, {{asami.n}}, aperta logo a porra dessa campainha!"

#. Character:`narrator`
#: game/story/city.dialogue
msgctxt "city_1e9af604"
msgid "Je devrais récupérer le journal de {{sakuya.n}}."
msgstr "Eu deveria pegar o diário da {{sakuya.n}}."

#. Character:`narrator`
#: game/story/city.dialogue
msgctxt "NATSUME_N_EST_L_MIEUX_VAUT_NE_EFDDC9"
msgid "{{natsume.n}} est là, mieux vaut ne pas l'ignorer."
msgstr "A {{natsume.n}} está ali, melhor não ignorar ela."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "t1a8ffed855"
msgid "Je dois trouver un moyen de décrocher ce job."
msgstr "Eu preciso dar um jeito de conseguir esse emprego."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_unavailable_ba815a6b"
msgid "{{sakuya.n}} m'a dit que je commencerais à travailler d'ici quelques jours."
msgstr "A {{sakuya.n}} me disse que eu começaria a trabalhar daqui a alguns dias."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_unavailable_5184ef65"
msgid "Je reviendrai ici le moment venu."
msgstr "Eu volto aqui quando chegar a hora."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_unavailable_b02991e4"
msgid "Le restaurant n'est pas encore ouvert."
msgstr "O restaurante ainda não está aberto."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_unavailable_c46cac49"
msgid "Je reviendrai un peu plus tard !"
msgstr "Eu volto um pouco mais tarde!"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_unavailable_565e8b1d"
msgid "Le restaurant est fermé."
msgstr "O restaurante está fechado."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_unavailable_f7b53a77"
msgid "Je reviendrai demain"
msgstr "Eu volto amanhã."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_408ea2eb"
msgid "Bonjour mon amour, je peux faire quelque chose pour toi ?"
msgstr "Bom dia, meu amor, posso fazer alguma coisa por você?"

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_86c93afd"
msgid "Il est encore un peu trop tôt pour ça, mon amour."
msgstr "Ainda é um pouco cedo demais para isso, meu amor."

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_671de1ba"
msgid "Mon père me surveille un peu trop en ce moment."
msgstr "O meu pai está me vigiando demais ultimamente."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_5190b626"
msgid "Reviens me demander à la fin de mon service en soirée."
msgstr "Volte a me pedir isso no final do meu expediente, à noite."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "t91c6883610"
msgid "Demander à aller dans la chambre"
msgstr "Pedir para ir para o quarto"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_a2570e11"
msgid "Allons-y tout de suite pendant que mon père ne fait pas attention !"
msgstr "Vamos agora mesmo, enquanto o meu pai está distraído!"

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "t8a1bc8f401"
msgid "Demander à aller dans la chambre"
msgstr "Pedir para ir para o quarto"

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "t5d1fbcecac"
msgid "Retour"
msgstr "Voltar"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_76ca42b4"
msgid "À demain {{saito.n}}."
msgstr "Até amanhã, {{saito.n}}."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_47fc27c5"
msgid "À demain {{sakuya.n}}."
msgstr "Até amanhã, {{sakuya.n}}."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_82dbfc18"
msgid "Bonjour {{saito.n}}, ça a été ce matin avec ton autre travail ?"
msgstr "Bom dia, {{saito.n}}, como foi esta manhã no seu outro serviço?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_7d238564"
msgid "Salut... Eh bien, disons que travailler avec ton père à côté, c'est un peu le paradis."
msgstr "Oi... Digamos que trabalhar aqui com o seu pai parece o paraíso perto do que eu passo no outro serviço."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_adb40b95"
msgid "Même s'il me demandait de remanger dans les toilettes, je ne dirais pas non."
msgstr "Mesmo se ele me mandasse comer no banheiro de novo, eu não iria recusar."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_982c0ef1"
msgid "Oh, je vois..."
msgstr "Ah, entendo..."

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_9fc7f470"
msgid "Mais non, ne refait jamais ça, c'est dégoutant."
msgstr "Mas não, nunca mais faça isso, é nojento."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_8c1e3074"
msgid "Héhé, désolé."
msgstr "Haha, desculpa."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_c9d517d5"
msgid "Merci de t'inquiéter pour moi."
msgstr "Obrigado por se preocupar comigo."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_3d5e3779"
msgid "Oh, mais c'est normal."
msgstr "Ah, mas isso é o normal."

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_8f11946a"
msgid "Je vais aller travailler, sinon ton père risque de me passer un savon."
msgstr "Eu vou indo trabalhar, senão o seu pai vai acabar me passando um sermão."

#. Character:`sakuya` | Attributes:`-happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_6d0c49c2"
msgid "Oui, tu as raison."
msgstr "Sim, você tem razão."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_e7a77a78"
msgid "Tu as bien travaillé, à demain {{saito.n}}."
msgstr "Você trabalhou bem, até amanhã, {{saito.n}}."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_1ba03b64"
msgid "Merci à demain {{sakuya.n}}."
msgstr "Obrigado, até amanhã, {{sakuya.n}}."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_13d9671c"
msgid "Bonjour {{saito.n}}, tu tiens le coup ?"
msgstr "Bom dia, {{saito.n}}, você está aguentando firme?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_29fefe8b"
msgid "Bonjour {{sakuya.n}}."
msgstr "Bom dia, {{sakuya.n}}."

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_b42243be"
msgid "Je ne sais pas trop à vrai dire, il ne prend même plus la peine de me payer maintenant."
msgstr "Para falar a verdade, eu não sei muito bem... ele nem se dá mais ao trabalho de me pagar agora."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_14f04c87"
msgid "À croire que je travaille pour lui pour le plaisir."
msgstr "Até parece que eu trabalho para ele por puro prazer."

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_31e51380"
msgid "Plus tu m'en dis sur lui, plus je le déteste."
msgstr "Quanto mais você me fala sobre ele, mais eu o odeio."

#. Character:`saito` | Attributes:`upset`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_7c563e64"
msgid "En parlant de gens désagréables, {{akira.n}} ne t'embête plus ?"
msgstr "Falando em pessoas desagradáveis, o {{akira.n}} não está mais te incomodando?"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_650480e8"
msgid "Hihi, ça me fait plaisir que tu t'inquiètes pour moi."
msgstr "Hihi, fico feliz que você se preocupe comigo."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_f208db04"
msgid "C'est normal... Tu en fais autant avec moi."
msgstr "É o normal... Você faz o mesmo por mim."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_e4828bbc"
msgid "{{akira.n}} ne pose plus de problèmes."
msgstr "O {{akira.n}} não está mais causando problemas."

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_f15adb8f"
msgid "Mais je suis surtout inquiète pour toi."
msgstr "Mas eu estou preocupada é com você."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_72b6899e"
msgid "Ça ira, je suis plus résistant que tu ne le crois."
msgstr "Eu vou ficar bem, sou mais resistente do que você imagina."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_df06bec5"
msgid "Sur ce, je vais aller travailler, à plus tard."
msgstr "Bom, com licença, vou indo trabalhar. Até mais tarde."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_9856f7cf"
msgid "À plus tard {{saito.n}} !"
msgstr "Até mais tarde, {{saito.n}}!"

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_4ef4028e"
msgid "..."
msgstr "..."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_23a96064"
msgid "Repose-toi bien et à demain {{saito.n}}."
msgstr "Descanse bem e até amanhã, {{saito.n}}."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_77248ee0"
msgid "Merci, toi aussi {{sakuya.n}}."
msgstr "Obrigado, para você também, {{sakuya.n}}."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_721a4aab"
msgid "Bonjour {{sakuya.n}}. Tu vas bien ?"
msgstr "Bom dia, {{sakuya.n}}. Tudo bem?"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_b3d05c0f"
msgid "Oh, bonjour {{saito.n}}, tu as l'air de bonne humeur."
msgstr "Ah, bom dia, {{saito.n}}! Você parece estar de bom humor."

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_c19ce11b"
msgid "Quelque chose d'intéressant est arrivé ?"
msgstr "Aconteceu alguma coisa interessante?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_4aeada42"
msgid "Étrangement, oui..."
msgstr "Por incrível que pareça, sim..."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_2c39d02d"
msgid "L'autre personne pour qui je travaille, qui est un homme horrible, a dû énerver la personne qu'il ne fallait pas."
msgstr "A outra pessoa para quem eu trabalho, que é um homem horrível, deve ter irritado a pessoa errada."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_959c6c18"
msgid "Du coup, elle est en train de lui mettre la pression."
msgstr "Por causa disso, ela está enquadrando ele e botando pressão."

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_4d74c71f"
msgid "Oh ! Ça a l'air terrifiant."
msgstr "Oh! Isso parece assustador."

#. Character:`saito` | Attributes:`upset`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_1cb0e003"
msgid "Je ne sais pas, je n'ai aucune compassion pour ce type, il est tellement odieux que d'un certain côté, je me dis qu'il mérite ce qui lui arrive."
msgstr "Eu não sei, não tenho nenhuma pena daquele cara. Ele é tão detestável que, por um lado, acho que merece o que está passando."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_35d30814"
msgid "En tout cas, il était tellement énervé qu'il va essayer d'échafauder une sorte de plan pour attraper cette personne ce soir."
msgstr "De qualquer forma, ele ficou tão furioso que vai tentar bolar algum tipo de plano para pegar essa pessoa hoje à noite."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_42799955"
msgid "Je croise les doigts pour qu'il n'y arrive pas !"
msgstr "Estou torcendo para que ele quebre a cara!"

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_3f424cb1"
msgid "Tu as l'air d'apprécier cette situation."
msgstr "Você parece estar gostando bastante dessa situação."

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_3cdb5c9a"
msgid "Arf, je sais, je ne devrais pas, excuse-moi."
msgstr "Ah, eu sei, não deveria estar agindo assim, me desculpa."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_5f2cb120"
msgid "Je vais te laisser, je dois aller travailler."
msgstr "Vou deixar você em paz, preciso ir trabalhar."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_0aa8ce66"
msgid "À plus tard !"
msgstr "Até mais tarde!"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_b7be91bc"
msgid "Je crois que c'est la fin."
msgstr "Eu acho que é o fim da linha para ele."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_a2c6fa79"
msgid "Il est en train de craquer."
msgstr "Ele está prestes a desmoronar."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_76c3517f"
msgid "Oh, c'est une bonne nouvelle alors !"
msgstr "Oh, então isso é uma ótima notícia!"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_e1266d3e"
msgid "Tu vas pouvoir te concentrer sur ton travail ici à présent."
msgstr "Agora você vai poder se concentrar no seu trabalho aqui."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_21b9300c"
msgid "En effet."
msgstr "Com certeza."

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_5a07f73e"
msgid "Mais rien n'est encore sûr. Il a dit qu'il préférait mourir plutôt que d'aller s'excuser auprès de tous les gens qu'il a offensés."
msgstr "Mas nada está garantido ainda. Ele disse que preferia morrer a ter que ir pedir desculpas para todas as pessoas que ele ofendeu."

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_190ae73f"
msgid "Tu crois qu'il y en a tant que ça ?"
msgstr "Você acha que são tantas assim?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_47725875"
msgid "Malheureusement, oui..."
msgstr "Infelizmente, sim..."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_838ccee5"
msgid "D'ici quelques jours, je pense qu'on pourra passer plus de temps ensemble."
msgstr "Daqui a alguns dias, acho que vamos conseguir passar mais tempo juntos."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_ff53fa2b"
msgid "Hihi... J'espère bien."
msgstr "Hihi... Eu espero que sim."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_82dbf0c7"
msgid "Bonjour {{saito.n}}, prêt pour ton premier jour ?"
msgstr "Bom dia, {{saito.n}}, pronto para o seu primeiro dia?"

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_d3c56b40"
msgid "Oui ! J'attendais ce moment avec impatience."
msgstr "Sim! Eu estava esperando ansiosamente por esse momento."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_73406a90"
msgid "C'est bien de te voir aussi motivé, tu en auras besoin."
msgstr "É bom ver você tão motivado assim, você vai precisar."

#. Character:`sakuya` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_309b62e7"
msgid "Mon père est toujours de mauvaise humeur, même quand ça va bien."
msgstr "O meu pai está sempre de mau humor, mesmo quando as coisas vão bem."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_18a2e0a6"
msgid "Mais il a un bon fond, si tu fais des efforts, il te traitera bien mieux."
msgstr "Mas no fundo ele é uma boa pessoa. Se você se esforçar, ele vai te tratar muito melhor."

#. Character:`saito` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_30725d8b"
msgid "Je vois, je devrais pouvoir m'en sortir."
msgstr "Entendo, acho que vou conseguir me virar."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_4c15c8b2"
msgid "Faisons de notre mieux ensemble."
msgstr "Vamos dar o nosso melhor juntos."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_dbaa4c6e"
msgid "Oui ?"
msgstr "Sim?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_88ae0749"
msgid "Quand tu disais vouloir m'aider, tu pensais à quoi exactement ?"
msgstr "Quando você disse que queria me ajudar, estava pensando em quê exatamente?"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_aa003475"
msgid "C'est... Tu verras !"
msgstr "Isso é... Você vai ver!"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_7c9f8a34"
msgid "Ça a été aujourd'hui ?"
msgstr "Como foi o dia de hoje?"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_2e9b3497"
msgid "Mon père ne t'a pas encore proposé quelque chose de louche à faire ou à manger ?"
msgstr "O meu pai ainda não te ofereceu nenhuma comida ou serviço esquisito para fazer?"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_caa7de9f"
msgid "Bonjour {{saito.n}}."
msgstr "Bom dia, {{saito.n}}."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_sakuya_e170beed"
msgid "Prêt pour une nouvelle journée ?"
msgstr "Pronto para mais um dia?"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_99ba9b66"
msgid "Gamin, tu as déjà fait ton service."
msgstr "Moleque, você já fez o seu expediente hoje."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_8cb0dd5f"
msgid "Tu ferais mieux d'aller te reposer et d'être prêt pour demain."
msgstr "É melhor ir descansar para estar pronto amanhã."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_624cea29"
msgid "Oui, Chef."
msgstr "Sim, Chefe."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_57539e74"
msgid "Putain gamin, c'est quoi cette tête ?"
msgstr "Puta merda, moleque, que cara de acabado é essa?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_8e3892a0"
msgid "La nuit a été difficile, mais je continuerais de me donner à fond."
msgstr "A noite foi difícil, mas eu vou continuar dando o meu máximo."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_3df71a20"
msgid "T'as intérêt !"
msgstr "É bom mesmo!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_cb773d88"
msgid "Allez au boulot, les toilettes ne vont pas se nettoyer toutes seules."
msgstr "Vamos, ao trabalho, os banheiros não vão se limpar sozinhos."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_c83f2cc2"
msgid "Bonjour, Chef."
msgstr "Bom dia, Chefe."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_2dae05b4"
msgid "Salut gamin, ne perds pas plus de temps et mets-toi au boulot !"
msgstr "E aí, moleque, não perca mais tempo e vá trabalhar!"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_92c3a503"
msgid "Tout de suite, chef !"
msgstr "É para já, chefe!"

#. Character:`centered`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_d2de46f4"
msgid "{{saito.n}} travaille plusieurs heures en se donnant à fond, il est exténué, mais satisfait du travail accompli."
msgstr "{{saito.n}} trabalha por várias horas dando tudo de si. Ele está exausto, mas satisfeito com o dever cumprido."

#. Character:`chef` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_f7e10f7d"
msgid "Tu as bien bossé aujourd'hui, j'en attends pas moins la prochaine fois."
msgstr "Você mandou bem hoje, não espero menos na próxima vez."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_c72bee06"
msgid "Merci, chef."
msgstr "Obrigado, chefe."

#. Character:`notice`
#: game/story/restaurant_interior.dialogue
msgctxt "tedd640bdd1"
msgid "Vous avez gagné {{restaurant_salary}}¥."
msgstr "Você recebeu ¥{{restaurant_salary}}."

#. Character:`chef` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_9776430c"
msgid "Allez, prend ça et dégage !"
msgstr "Pronto, pega isso e some daqui!"

#. Character:`chef` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_65c6b823"
msgid "Bon gamin, on est parti du mauvais pied tous les deux."
msgstr "Bom, moleque, nós dois começamos com o pé esquerdo."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_2b0313c6"
msgid "Ma fille m'a expliqué tes intentions, et même si j'en crois pas un mot..."
msgstr "A minha filha me explicou as suas intenções, e embora eu não acredite em uma única palavra..."

#. Character:`chef` | Attributes:`-happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_1f0bc787"
msgid "J'ai quand même besoin d'une personne supplémentaire pour m'aider à gérer ce restaurant."
msgstr "Mas eu ainda preciso de mais um funcionário para me ajudar a tocar este restaurante."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_c71aa818"
msgid "Je serais sévère avec toi."
msgstr "Mas vou ser muito severo com você."

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_df2b48ae"
msgid "...Okay."
msgstr "...Tudo bem."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_a6340e2f"
msgid "Il y a un \"mais\" ?"
msgstr "Tem mais algum \"mas\"?"

#. Character:`chef` | Attributes:`upset`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_813edc3e"
msgid "Non, les excuses, c'est pour les sacs à merde."
msgstr "Não, desculpas são para os fracassados."

#. Character:`saito` | Attributes:`surprised`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_799167fe"
msgid "Ah !"
msgstr "Ah!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_055ba6ef"
msgid "Travaille jusqu'à en vomir d'épuisement et tu monteras les échelons petit à petit."
msgstr "Trabalhe até vomitar de exaustão e você vai subir de cargo aos poucos."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_ae0fa5e4"
msgid "Un jour peut-être, je dis bien peut-être, si tu as fait tes preuves, je ferais de toi mon apprenti et une centaine d'années plus tard..."
msgstr "Um dia, talvez, e eu digo \"talvez\", se você provar o seu valor, eu te transformo em meu aprendiz e, uns cem anos mais tarde..."

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_ce8c54af"
msgid "Je serais... mort ?"
msgstr "Eu vou estar... morto?"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_34b684a7"
msgid "Tu pourras reprendre le restaurant."
msgstr "Você vai poder assumir o restaurante."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_85cf4db8"
msgid "...J'ai rarement entendu de propositions aussi..."
msgstr "...Raras vezes eu ouvi uma proposta tão..."

#. Character:`chef` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_5555c90b"
msgid "Généreuse ? C'est uniquement dans le cas où tu fais tes preuves et si j'estime que tu es un être humain méritant."
msgstr "Generosa? Isso é só se você provar o seu valor e se eu achar que você é um ser humano merecedor."

#. Character:`chef` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_956ec41e"
msgid "En attendant, il y a des toilettes qui ont besoin d'être débouchées et nettoyer."
msgstr "Até lá, tem um banheiro que precisa ser desentupido e limpo."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_840af76b"
msgid "Ça fait des semaines qu'elles sont inutilisables."
msgstr "Faz semanas que ele está interditado."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_fb6e893d"
msgid "Je comprends, faites-moi confiance, à la fin, elles seront tellement propres qu'on pourra même manger dedans !"
msgstr "Entendi. Pode confiar em mim, chefe! No final, os banheiros vão estar tão limpos que vai dar até para comer lá dentro!"

#. Character:`chef` | Attributes:`mocking`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_a978fd38"
msgid "...Ah, t'es comme ça gamin."
msgstr "...Ah, então você é desse tipo, moleque."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_5e8c24e0"
msgid "Soit à la fin de la journée, tu mangeras dans les toilettes."
msgstr "Pois bem, no fim do dia, você vai comer no banheiro."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_3fa8b7b7"
msgid "Il déconne là ou pas ?"
msgstr "Ele está brincando ou não?"

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_f77a0041"
msgid "Putain, avec sa moustache, j'arrive pas à savoir."
msgstr "Puta merda, com esse bigode dele, não dá para saber."

#. Character:`chef` | Attributes:`upset`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_c0a1fc33"
msgid "Une dernière chose, interdiction de tourner autour de ma fille, sinon je te baisse ton salaire à chaque fois."
msgstr "Mais uma coisa: está proibido de ficar rondando a minha filha, senão eu reduzo o seu salário a cada vacilo."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_ed1b11c2"
msgid "ALLEZ, AU BOULOT !"
msgstr "VAMOS, AO TRABALHO!"

#. Character:`centered`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_2193ec9a"
msgid "Pour son premier jour, {{saito.n}} fit briller les toilettes comme si sa vie en dépendait."
msgstr "Em seu primeiro dia, {{saito.n}} fez o banheiro brilhar como se a sua própria vida dependesse disso."

#. Character:`centered`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_cb300d69"
msgid "Quelques heures plus tard..."
msgstr "Algumas horas mais tarde..."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_e658bec9"
msgid "J'ai terminé Chef !"
msgstr "Terminei, Chefe!"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_faabb192"
msgid "Je pense que vous serez satisfait."
msgstr "Acho que o senhor vai ficar satisfeito."

#. Character:`chef` | Attributes:`mocking`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_d18fcff3"
msgid "On peut manger dedans ?"
msgstr "Dá para comer lá dentro?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_ec19569e"
msgid "Tout à fait, c'est tellement propre qu'on pourrait manger dedans."
msgstr "Com certeza, está tão limpo que daria para comer lá dentro tranquilamente."

#. Character:`chef` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_7be22ff6"
msgid "Parfait gamin, attends-moi ici."
msgstr "Perfeito, moleque. Espere por mim aqui."

#. Character:`saito` | Attributes:`-happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_9c2591ac"
msgid "..."
msgstr "..."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_c3749ab9"
msgid "Ton premier jour s'est bien passé ?"
msgstr "O seu primeiro dia está indo bem?"

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_3d085569"
msgid "Oui, j'ai donné tout ce que j'avais afin qu'il soit satisfait."
msgstr "Sim, dei tudo de mim para que ele ficasse satisfeito."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_5937cc76"
msgid "Je lui ai même dit que c'était tellement propre qu'on pourrait manger dedans !"
msgstr "Até disse a ele que estava tão limpo que daria para comer lá dentro!"

#. Character:`sakuya` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_2d92220a"
msgid "...Tu... Tu lui as vraiment dit ça ?"
msgstr "...Você... Você realmente disse isso para ele, disse?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_d2d96c14"
msgid "Oui, pourquoi ?"
msgstr "Sim, por quê?"

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_e2e1466e"
msgid "Oh {{saito.n}}, tu n'aurais pas dû..."
msgstr "Ah, {{saito.n}}, você não devia ter feito isso..."

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_5e3ac367"
msgid "Tu commences à m'inquiéter..."
msgstr "Você já está começando a me assustar..."

#. Character:`chef` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_72a0155b"
msgid "Ah gamin, c'est bon, tout est prêt, suis-moi."
msgstr "Aí, moleque, está tudo pronto. Venha comigo."

#. Character:`saito` | Attributes:`upset`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_f6906773"
msgid "C'est quoi ce bordel ?!"
msgstr "Mas que porra é essa?!"

#. Character:`chef` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_f3e96234"
msgid "Gamin, il y a une chose avec laquelle je ne plaisante jamais, c'est la parole."
msgstr "Moleque, se tem uma coisa com a qual eu nunca brinco, é com a palavra de um homem."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_5dac4df6"
msgid "Si tu annonces haut et fort quelque chose, tu dois t'y tenir."
msgstr "Se você abre a boca para afirmar algo com tanta certeza, você tem que cumprir."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_85eb5f5e"
msgid "C'est ce qui fait la valeur d'un homme."
msgstr "É isso o que define o valor de um homem."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_09962828"
msgid "Tenir sa parole !"
msgstr "Honrar a própria palavra!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_b1d5d956"
msgid "Donc maintenant, tu as le choix..."
msgstr "Então agora você tem uma escolha..."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_190065ea"
msgid "Tu manges dans les toilettes que tu viens de nettoyer ou tu dégages ?"
msgstr "Ou você come aí no banheiro que acabou de limpar, ou está demitido!"

#. Character:`sakuya` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_9d2ba5a5"
msgid "Papa, arrête ça, tu ne peux pas demander quelque chose comme ça !"
msgstr "Papai, para com isso! Você não pode exigir uma coisa dessas!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_d9d8e099"
msgid "Silence, un homme doit tenir ses promesses, sinon c'est un gamin."
msgstr "Silêncio! Um homem honra as suas promessas, senão ele não passa de um moleque."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_f78f48e2"
msgid "Et je ne veux pas d'un gamin pour travailler dans ce restaurant !"
msgstr "E eu não quero nenhum moleque trabalhando neste restaurante!"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_47c46abd"
msgid "Tu es vraiment buté, c'est toujours le même refrain avec toi."
msgstr "Você é muito cabeçudo, é sempre a mesma ladainha com você."

#. Character:`sakuya` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_d3085430"
msgid "{{saito.n}} ne l'écoute pas, tu n'as pas à faire ça !"
msgstr "{{saito.n}}, não escuta ele! Você não é obrigado a fazer isso!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "t4d24098613"
msgid "[next]"
msgstr "[next]"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_d06f6d49"
msgid "C'est moi qui ai passé des heures à tout nettoyer."
msgstr "Fui eu quem passou horas limpando tudo aqui."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_084205b1"
msgid "Je sais que j'ai fait du bon travail."
msgstr "Eu sei que fiz um bom trabalho."

#. Character:`chef` | Attributes:`mocking`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_10f23696"
msgid "Oh putain gamin, j'ai jamais vu quelque chose d'aussi immonde."
msgstr "Puta merda, moleque... eu nunca vi algo tão nojento na minha vida."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_b66dc7bc"
msgid "Je sais que je t'ai dit qu'un homme devait tenir sa parole, mais tu dois savoir aussi imposer des limites."
msgstr "Eu sei que te disse que um homem deve manter a palavra, mas você também precisa saber impor limites."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_7e2f254d"
msgid "C'est vraiment horrible... Tu me donnes vraiment envie de vomir."
msgstr "Isso foi bizarro... Você me dá até náuseas."

#. Character:`saito` | Attributes:`surprised`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_870a5d73"
msgid "Mais... C'est vous qui..."
msgstr "Mas... Foi o senhor quem..."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_88b32d42"
msgid "C'est toi qui t'es mis dans cette histoire tout seul gamin, ne dis jamais des choses que tu pourrais regretter."
msgstr "Foi você se enfiou nessa história sozinho, moleque. Nunca diga coisas das quais possa se arrepender."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_939f79e2"
msgid "Putain, je vais le tuer."
msgstr "Puta merda, eu vou matar ele."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_ead53bf3"
msgid "Je vais lui faire bouffer sa moustache."
msgstr "Vou fazer ele engolir esse bigode."

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_58cb766d"
msgid "Papa, tu es vraiment le pire, c'est toi qui l'as poussé à faire ça..."
msgstr "Papai, você é o pior de todos, foi você quem instigou ele a fazer isso..."

#. Character:`chef` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_aa379d17"
msgid "Bon, bon, ça va... Je voulais voir de quel bois tu étais fait et il semble que tu tiennes tes promesses."
msgstr "Bom, bom, chega... Eu queria ver de que material você era feito, e parece que você cumpre o que promete."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_b6c61215"
msgid "Je vais te donner un bonus."
msgstr "Vou te dar um bônus."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_9804b8ce"
msgid "Ah, finalement, j'ai peut-être pas fait tout ça pour rien..."
msgstr "Bom, no fim das contas, talvez eu não tenha passado por essa humilhação à toa..."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "ta6e934af06"
msgid "Un homme ne revient jamais sur sa parole !"
msgstr "Um homem nunca volta atrás na sua palavra!"

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_aafdcf24"
msgid "Je sais que c'est propre, mais manger là-dedans c'est..."
msgstr "Eu sei que está limpo, mas comer aí dentro é..."

#. Character:`chef` | Attributes:`mocking`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_8a5ae384"
msgid "Bien gamin... je saurais que tu es le genre de gars qui ne tient pas ses promesses."
msgstr "Muito bem, moleque... agora eu sei que você é o tipo de sujeito que não sustenta o que diz."

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_805b1a6e"
msgid "Papa, arrête un peu, personne n'accepterait de manger dans des toilettes !"
msgstr "Papai, corta essa! Ninguém aceitaria comer em um banheiro!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_81568216"
msgid "Moi, je l'ai fait quand j'ai débuté avec mon père."
msgstr "Pois eu comi quando comecei a trabalhar com o meu pai."

#. Character:`sakuya` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_4c3949ad"
msgid "Arrête avec cette histoire, tu t'es fait avoir, grand-père était atteint de démence, il disait ça a tout le monde."
msgstr "Corta essa história! Você foi tapeado. O vovô já estava gagá e falava isso para todo mundo."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_b7ecfc18"
msgid "..."
msgstr "..."

#. Character:`chef` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_06ae4581"
msgid "Bon gamin, tu as quand même bien travaillé, prend ta paye du jour !"
msgstr "Bom, moleque, você trabalhou bem de qualquer forma, pegue o seu pagamento do dia!"

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "t28e860f577"
msgid "Hors de questions de manger là-dedans."
msgstr "Nem pensar que eu vou comer aí dentro."

#. Character:`notice`
#: game/story/restaurant_interior.dialogue
msgctxt "t86f5665b1b"
msgid "Vous avez gagné {{restaurant_salary}}¥."
msgstr "Você recebeu ¥{{restaurant_salary}}."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_e2542a74"
msgid "Allez, prend ça et déguerpis !"
msgstr "Vamos, pegue isso e suma daqui!"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "talk_chef_interior_0f3f5092"
msgid "Merci chef."
msgstr "Obrigado, chefe."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_aedbd962"
msgid "Bonjour {{saito.n}} !"
msgstr "Bom dia, {{saito.n}}!"

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_d3edb817"
msgid "Salut..."
msgstr "Oi..."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_82c45628"
msgid "...Tu n'as pas bonne mine."
msgstr "...Você está com uma cara péssima."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_9e7bdb34"
msgid "Tout va bien ?"
msgstr "Está tudo bem?"

#. Character:`sakuya` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_74e37d33"
msgid "Mon père t'a encore demandé de faire des choses étranges ?"
msgstr "O meu pai te pediu para fazer alguma coisa bizarra de novo?"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_ef4a834d"
msgid "Je vais l'étrangler !"
msgstr "Eu vou esganar ele!"

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_bcc94ffb"
msgid "Haha non, avec du recul, il est le patron le plus sympathique que je connaisse."
msgstr "Haha, não. Perto do outro lugar, trabalhar aqui com o seu pai é o próprio paraíso."

#. Character:`sakuya` | Attributes:`-angry`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_fb4d68dc"
msgid "Alors si ce n'est pas lui..."
msgstr "Então, se não é ele..."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_419bb29f"
msgid "Tu me promets de garder pour toi ce que je vais te dire ?"
msgstr "Você me promete que vai guardar segredo sobre o que eu vou te falar?"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_1d2ce00d"
msgid "Un secret ?"
msgstr "Um segredo?"

#. Character:`sakuya` | Attributes:`-happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_5e61f6ab"
msgid "J'adore les secrets, promis, je resterai muette comme une tombe."
msgstr "Eu adoro segredos! Prometo que a minha boca é um túmulo."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_a879ab89"
msgid "...Okay."
msgstr "...Tudo bem."

#. Character:`saito` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_6fe609e2"
msgid "La femme qui m'a élevée, qui a toujours pris soin de moi, a de gros problèmes d'argent."
msgstr "A mulher que me criou, que é como uma mãe pra mim, está com problemas financeiros graves."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_18645475"
msgid "Son patron la harcèle."
msgstr "O chefe dela está assediando ela."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_37c5b3ad"
msgid "Ce type est un véritable connard."
msgstr "Aquele cara é um tremendo canalha."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_3c9ac566"
msgid "Elle ne veut plus travailler pour lui et je peux le comprendre."
msgstr "Ela não quer mais trabalhar para ele, e eu super entendo."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_a0eb7d3d"
msgid "En plus de ça, cette ordure la menace de pourrir sa réputation afin qu'elle ne trouve plus aucun travail en ville si on ne fait pas ce qu'il veut."
msgstr "Para piorar, aquele lixo está ameaçando acabar com a reputação dela para que ela não consiga mais nenhum emprego na cidade, caso a gente não faça o que ele quer."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_a40e2853"
msgid "Donc voilà... Je la remplace en attendant de trouver une solution à tout ce merdier."
msgstr "Então é isso... Estou trabalhando no lugar dela enquanto tento achar uma saída para toda essa merda."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_75a410e9"
msgid "Je vois..."
msgstr "Entendo..."

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_dd2b3807"
msgid "Cette personne m'a l'air extrêmement désagréable."
msgstr "Essa pessoa me parece ser alguém extremamente desprezível."

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_70def694"
msgid "Oui... on peut dire ça."
msgstr "É... podemos dizer que sim."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_4896f4c3"
msgid "Je ne sais même pas pourquoi je lui parle de ça."
msgstr "Eu nem sei por que estou contando isso para ela."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_72b75871"
msgid "Mais... ça fait du bien de vider son sac parfois."
msgstr "Mas... às vezes faz bem desabafar."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_17e6ac4f"
msgid "Je t'aiderai !"
msgstr "Eu vou te ajudar!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_51d7fabf"
msgid "Ah ? Merci ! Mais comment exactement ?"
msgstr "Ah? Obrigado! Mas como exatamente?"

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_2fb92fd6"
msgid "Tu verras."
msgstr "Você vai ver."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_4878f482"
msgid "Cette fille est une énigme..."
msgstr "Essa garota é um mistério..."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_1ad0f390"
msgid "Je ferais bien de me mettre au travail."
msgstr "É melhor eu começar a trabalhar."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_cf536f29"
msgid "Je vois que tu rentres avec ma fille !"
msgstr "Estou vendo que você está voltando acompanhado da minha filha!"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_2394e090"
msgid "Oh chef, excusez-moi, elle m'a juste accompagnée le long du trajet, je n'ai r-"
msgstr "Ah, chefe, me desculpe! Ela só veio comigo pelo caminho, eu não fiz na-"

#. Character:`chef` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_9f693acc"
msgid "Déstresse gamin, tout va bien !"
msgstr "Relaxa, moleque, está tudo bem!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_4b66cb1a"
msgid "Je constate que tu t'entends bien avec elle, et honnêtement, ça me fait plaisir !"
msgstr "Estou vendo que você se dá bem com ela e, honestamente, fico feliz com isso!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_403ef278"
msgid "Elle n'a pas trop d'amis, donc je compte sur toi pour rester correcte avec elle !"
msgstr "Ela não tem muitos amigos, então estou contando com você para agir feito um homem honrado com ela!"

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_1aa20a2e"
msgid "Papa arrête, ça me gêne !"
msgstr "Papai, para com isso, está me deixando sem graça!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_7d037607"
msgid "Ma puce, je cherche seulement à te protéger, papa veut ce qu'il y a de mieux pour toi."
msgstr "Querida, eu só estou tentando te proteger. O papai só quer o melhor para você."

#. Character:`chef` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_b442c7ca"
msgid "Bref, si tu l'as fait pleurer, crois-moi que tu regretteras d'être venu au monde."
msgstr "Enfim, se você fizer ela chorar, acredite em mim, você vai se arrepender de ter nascido."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_b5d3d90d"
msgid "Ai-je bien été clair ?"
msgstr "Fui totalmente claro?"

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_b088c4ad"
msgid "Limpide chef !"
msgstr "Cristalino, chefe!"

#. Character:`chef` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_13fd4bf8"
msgid "Parfait ! Pour fêter ça aujourd'hui, tu auras ta première promotion, tu travailleras en salle."
msgstr "Perfeito! Para comemorar isso, hoje você vai receber a sua primeira promoção: vai trabalhar no salão."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_3d10079f"
msgid "Avec moi !"
msgstr "Comigo!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_487abe27"
msgid "Il y a même une augmentation de salaire pour toi !"
msgstr "E tem até um aumento de salário te esperando!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_6625ea0f"
msgid "Alors ?"
msgstr "E então?"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_b62fe2e1"
msgid "Oui {{saito.n}}, dépêche-toi de remercier mon père."
msgstr "Isso, {{saito.n}}, ande logo e agradeça ao meu pai."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_bffac872"
msgid "Putain, elle m'a coincé."
msgstr "Puta merda, ela me encurralou."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_0e0cb893"
msgid "Je sens que je vais regretter cette situation, mais je n'ai pas le choix."
msgstr "Sinto que vou me arrepender amargamente disso, mas não tenho escolha."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_001dce40"
msgid "Si la paie est meilleure, ça me permettra d'aider davantage {{yasuka.n}}."
msgstr "Se o pagamento é melhor, isso vai me ajudar a dar uma força extra para a {{yasuka.n}}."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_6ffb138b"
msgid "Mais je vais devoir gérer {{sakuya.n}}."
msgstr "Mas eu vou ter que aguentar a {{sakuya.n}}."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_19d25fb8"
msgid "Je ne sais pas ce qui est pire, avoir dû supporter l'autre con ou avoir à gérer une véritable folle."
msgstr "Eu já nem sei o que é pior: ter que aguentar aquele outro idiota ou ter que lidar com uma completa lunática."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_9d7c3c80"
msgid "Merci pour tout Chef !"
msgstr "Muito obrigado por tudo, Chefe!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_a0fa0c10"
msgid "C'est bien mon garçon, peut-être que si tu continues à bien travailler, je te donnerai la main de ma fille."
msgstr "Muito bem, meu rapaz. Se você continuar trabalhando direito, quem sabe eu não te dou a mão da minha filha."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_f4ecd732"
msgid "Et vous pourrez me faire des petits enfants !"
msgstr "E aí vocês podem até me dar uns netinhos!"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_ee2366ff"
msgid "Hihi, ce serait bien, n'est-ce pas {{saito.n}} ?"
msgstr "Hihi, isso seria ótimo, não seria, {{saito.n}}?"

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_1432d382"
msgid "Euh... Oui, mais il est peut-être un peu tôt pour penser à ça, non ?"
msgstr "Er... Sim, mas talvez seja um pouco cedo demais para pensar nisso, não acha?"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_4bf4cb94"
msgid "Haha, tu as raison mon garçon. Allez, au travail les enfants."
msgstr "Haha, você tem razão, meu rapaz. Vamos, ao trabalho, crianças."

#. Character:`notice`
#: game/story/restaurant_interior.dialogue
msgctxt "t8ea698d971"
msgid "Vous avez gagné {{restaurant_salary}}¥."
msgstr "Você recebeu ¥{{restaurant_salary}}."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_4e6ab53d"
msgid "Je suis tellement dans la merde..."
msgstr "Eu estou tão ferrado..."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_2a703470"
msgid "Mais mieux payé."
msgstr "Mas ganhando melhor."

#. Character:`narrator`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_9e76106e"
msgid "Mais quand même dans la merde."
msgstr "Ainda assim, completamente ferrado."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_f23760db"
msgid "Je suis sincèrement désolé pour tout ça {{chef.n}}."
msgstr "Eu sinto muito por tudo isso, {{chef.n}}."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_5b5ad7b5"
msgid "Gamin !"
msgstr "Moleque!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_414b0861"
msgid "Ne t'inquiète pas ! Je sais reconnaitre les emmerdeurs."
msgstr "Não se preocupe! Eu sei muito bem reconhecer quem é o bando de arruaceiros."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_f02db02f"
msgid "Tu es un bon garçon et personne ne viendra te chercher des ennuis ici."
msgstr "Você é um bom rapaz e ninguém vai vir aqui te arrumar problemas."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_809bcc0c"
msgid "Essayes de ne plus trop y penser pour le moment, va travailler, on essaiera de trouver une solution à tout ça."
msgstr "Tente não ficar pensando muito nisso por enquanto. Vá trabalhar e nós vamos tentar achar uma saída para toda essa situação."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_5ef94b81"
msgid "C'est... {{chef.n}}..."
msgstr "Obrigado... {{chef.n}}..."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_5bdd5f35"
msgid "Je ne peux pas passer mon temps à sans arrêt compter sur les autres pour me sortir de toutes ces situations."
msgstr "Mas eu não posso passar a vida toda dependendo dos outros para me tirarem dessas enrascadas."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_046f3b26"
msgid "Je pense que je dois surmonter ça à ma façon."
msgstr "Eu sinto que preciso superar isso do meu próprio jeito."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_eb973533"
msgid "Tu es courageux gamin, mais n'oublie pas, si tu te sens dépassé, il n'y a aucun mal à demander de l'aide, compris ?"
msgstr "Você é corajoso, moleque. Mas não se esqueça: se a barra pesar demais, não tem vergonha nenhuma em pedir ajuda, entendeu?"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_e93b342b"
msgid "Allez, au boulot !"
msgstr "Vamos, ao trabalho!"

#. Character:`centered`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_9ccaad4d"
msgid "{{saito.n}} se sentant redevable, il travailla deux fois plus que d'habitude, le chef remarqua ses efforts avec un sourire au coin."
msgstr "Sentindo-se em dívida, {{saito.n}} trabalhou o dobro do normal. O {{chef.n}} notou o esforço com um leve sorriso no rosto."

#. Character:`chef` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_1bd9110e"
msgid "Tu as bien bossé aujourd'hui, continue comme ça !"
msgstr "Você mandou bem hoje, continue assim!"

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_4c8878f2"
msgid "Merci {{chef.n}} !"
msgstr "Obrigado, {{chef.n}}!"

#. Character:`notice`
#: game/story/restaurant_interior.dialogue
msgctxt "t5e098e838d"
msgid "Vous avez gagné {{restaurant_salary}}¥."
msgstr "Você recebeu ¥{{restaurant_salary}}."

#. Character:`chef` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_70b249b3"
msgid "Allez, prend ça et fais attention à toi !"
msgstr "Pronto, pega isso e se cuida!"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_bc0a943b"
msgid "Bonjour {{saito.n}}, tu as l'air de bonne humeur aujourd'hui !"
msgstr "Bom dia, {{saito.n}}, você parece estar de bom humor hoje!"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_be45d279"
msgid "Ah oui ? Tu as raison, ça faisait longtemps que je n'avais pas aussi bien dormi."
msgstr "Ah, sério? É que fazia tempo que eu não tinha uma noite de sono tão boa."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_4e8b5878"
msgid "Les thugs sont visiblement tombés sur quelqu'un qu'ils n'aurait pas du énervé."
msgstr "Pelo visto, aqueles marginais trombaram com alguém que eles não deveriam ter irritado."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_0620a483"
msgid "Je ne les ai jamais vus aussi terrifiés."
msgstr "Eu nunca vi aqueles caras tão apavorados."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_516d90c8"
msgid "Hihi, on trouve toujours plus fort que soit."
msgstr "Hihi, a gente sempre acaba encontrando alguém mais forte."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_89cae9d2"
msgid "Mais je suis contente de te voir sourire de nouveau."
msgstr "Mas fico feliz em ver você sorrindo de novo."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_ad6ac332"
msgid "Ah, oh merci !"
msgstr "Ah, nossa, obrigado!"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_37a3da31"
msgid "Il est temps de se mettre au travail, tu ne crois pas ?"
msgstr "Bom, está na hora de começar a trabalhar, não acha?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_1e58c69b"
msgid "Oui, tu as raison !"
msgstr "Sim, você tem razão!"

#. Character:`centered`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_4bebd1fe"
msgid "En sachant qu'il était débarrassé des thugs pour un moment, {{saito.n}} ne vit pas le temps passer."
msgstr "Sabendo que estava livre daqueles marginais por um tempo, {{saito.n}} nem viu o tempo passar."

#. Character:`chef` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_1bd9110e_1"
msgid "Tu as bien bossé aujourd'hui, continue comme ça !"
msgstr "Você mandou bem hoje, continue assim!"

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_4c8878f2_1"
msgid "Merci {{chef.n}} !"
msgstr "Obrigado, {{chef.n}}!"

#. Character:`notice`
#: game/story/restaurant_interior.dialogue
msgctxt "t53c631c1c7"
msgid "Vous avez gagné {{restaurant_salary}}¥."
msgstr "Você recebeu ¥{{restaurant_salary}}."

#. Character:`chef` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_70b249b3_1"
msgid "Allez, prend ça et fais attention à toi !"
msgstr "Pronto, pega isso e se cuida!"

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "TU_ES_TOUJOURS_AUSSI_SOURIANTE_41BBCC"
msgid "Tu es toujours aussi souriante."
msgstr "Você está sempre tão radiante."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "BIEN_SUR_ACCUEILLIR_LES_GENS_A_72AC6A"
msgid "Bien sûr, accueillir les gens avec le sourire est la chose la plus importante."
msgstr "Claro, receber as pessoas com um sorriso no rosto é a coisa mais importante."

#. Character:`sakuya` | Attributes:`happy,blush`
#: game/story/restaurant_interior.dialogue
msgctxt "ET_PUIS_JE_SUIS_HEUREUSE_DE_TR_85D10D"
msgid "Et puis... Je suis heureuse de travailler avec toi."
msgstr "E além disso... eu fico muito feliz em trabalhar com você."

#. Character:`sakuya` | Attributes:`sad,-blush`
#: game/story/restaurant_interior.dialogue
msgctxt "TOI_PAR_CONTRE_TU_AS_L_AIR_D_A_EF5D2D"
msgid "Toi par contre... Tu as l'air d'avoir des soucis."
msgstr "Mas você, por outro lado... parece estar cheio de problemas."

#. Character:`saito` | Attributes:`guilty`
#: game/story/restaurant_interior.dialogue
msgctxt "POURQUOI_LES_GENS_ARRIVENT_A_L_B94A44"
msgid "Pourquoi les gens arrivent a lire en moi aussi facilement ? Ce n'est pas juste !"
msgstr "Por que as pessoas conseguem ler o que eu sinto tão facilmente? Isso não vale!"

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "CA_VA_NE_T_INQUI_TE_PAS_C12DF4"
msgid "Ça va ne t'inquiète pas..."
msgstr "Estou bem, não se preocupe..."

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "QUAND_LES_GENS_DISENT_CE_GENRE_9A41C8"
msgid "Quand les gens disent ce genre de chose ça produit l'effet inverse."
msgstr "Quando as pessoas dizem esse tipo de coisa, geralmente causa o efeito oposto."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_VEUX_SAVOIR_CE_QUI_SE_PASSE_F72374"
msgid "Je veux savoir ce qui se passe et si je peux t'aider !"
msgstr "Eu quero saber o que está acontecendo para ver se posso te ajudar!"

#. Character:`chef` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "VOUS_DISCUTEREZ_DE_A_APR_S_IL_15F93E"
msgid "Vous discuterez de ça après, il est temps de se mettre au travail !"
msgstr "Vocês discutem sobre isso depois, está na hora de começar o trabalho!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "OUI_CHEF_D2356C"
msgid "Oui chef !"
msgstr "Sim, {{chef.n}}!"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "C_EST_LA_PREMI_RE_FOIS_QUE_JE_95E769"
msgid "C'est la première fois que je le vois aussi ravi."
msgstr "É a primeira vez que eu vejo o meu pai tão contente."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "IL_NE_TARIT_PAS_D_LOGES_SUR_TO_B8EA89"
msgid "Il ne tarit pas d'éloges sur toi."
msgstr "Ele não para de te elogiar."

#. Character:`saito` | Attributes:`surprised`
#: game/story/restaurant_interior.dialogue
msgctxt "VRAIMENT_E32C67"
msgid "Vraiment ?"
msgstr "Sério?"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "OUI_LES_PR_C_DENTS_EMPLOY_S_N_6DD810"
msgid "Oui, les précédents employés n'ont jamais réussi à satisfaire ses exigences ou ne supportaient pas son mauvais caractère."
msgstr "Sim, os funcionários anteriores nunca conseguiam atender às exigências dele ou simplesmente não aguentavam o temperamento difícil dele."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_NE_COMPTE_PAS_LE_D_CEVOIR_N_A60380"
msgid "Je ne compte pas le décevoir non plus, ce travail est bien trop important pour moi."
msgstr "Eu também não pretendo decepcioná-lo. Este trabalho é importante demais para mim."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "LA_JOURN_E_EST_TERMIN_E_JE_TE_1A7172"
msgid "La journée est terminée, je te raccompagne chez toi ?"
msgstr "O expediente acabou, quer que eu te acompanhe até em casa?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_EUH_D_HABITUDE_C_EST_PLUT_T_8F14A4"
msgid "Je.. euh... d'habitude c'est plutôt l'inverse non ?"
msgstr "Eu... err... normalmente é o contrário que acontece, não?"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_T_ASSURE_QUE_JE_SUIS_TOUT_F_9F1300"
msgid "Je t'assure que je suis tout à fait apte à éliminer toute menace que nous pourrions rencontrer sur le chemin."
msgstr "Eu te garanto que sou perfeitamente capaz de eliminar qualquer ameaça que apareça no nosso caminho."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "ME_VOIL_RASSUR_DU_COUP_5F17E1"
msgid "Me voilà rassuré du coup..."
msgstr "Bom, sabendo disso eu fico bem mais tranquilo..."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_8e55169f"
msgid "Bon, je vais te laisser..."
msgstr "Bom, eu vou indo..."

#. Character:`sakuya` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_c7538e39"
msgid "...[w] [font_size=14]Pourquoi elle insiste autant... ? Elle s'est faite plaquer pourtant...[/font_size]"
msgstr "...[w] [font_size=14]Por que ela insiste tanto...? E olha que ela levou um fora...[/font_size]"

#. Character:`sakuya` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_ce5594a2"
msgid "...[w] [font_size=14]Pourquoi elle insiste autant...? Elle s'est faite rejeter pourtant...[/font_size]"
msgstr "...[w] [font_size=14]Por que ela insiste tanto...? E olha que ela foi rejeitada...[/font_size]"

#. Character:`saito` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_4d324584"
msgid "{{sakuya.n}} ?"
msgstr "{{sakuya.n}}?"

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_5e42b5f5"
msgid "Changement de programme mon chéri..."
msgstr "Mudança de planos, meu amor..."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_28744b30"
msgid "Avant de partir, j'aimerais te montrer ma chambre."
msgstr "Antes de ir embora, eu gostaria de te mostrar o meu quarto."

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_595c51d2"
msgid "Et après, je pourrais partir ?"
msgstr "E depois disso eu vou poder ir?"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_14177bd0"
msgid "Allez, ferme les yeux et suis-moi."
msgstr "Venha, feche os olhos e me siga."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_1838ee97"
msgid "Qu'est-ce que tu fais là toi ?!"
msgstr "O que você está fazendo aqui?!"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_a8412bc1"
msgid "Je croyais t'avoir dit ne plus remettre les pieds ici !"
msgstr "Eu achei que já tinha deixado claro para você nunca mais pisar aqui!"

#. Character:`noriko`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_8dbd0794"
msgid "Je sais, je sais... Mais... Je ne suis pas le genre de fille qui obéit gentiment."
msgstr "Eu sei, eu sei... Mas acontece que eu não sou o tipo de garota que obedece de cabeça baixa."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_891f4b9a"
msgid "Sors d'ici, sinon..."
msgstr "Saia daqui agora mesmo, senão..."

#. Character:`chef` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_5ac16b2a"
msgid "{{sakuya.n}} ! Tu parles à une cliente, ne me fais pas honte !"
msgstr "{{sakuya.n}}! Você está falando com uma cliente, não me faça passar vergonha!"

#. Character:`kimochi`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_db5ece5d"
msgid "Du coup, je commanderais bien aussi !"
msgstr "Aproveitando o embalo, eu também vou querer fazer um pedido!"

#. Character:`macumba`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_9e02d61a"
msgid "{{chef.n}}, vous avez des portions bien protéinées ?"
msgstr "{{chef.n}}, o senhor tem aquelas porções bem reforçadas em proteína?"

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_02f3d98d"
msgid "Mais... mais..."
msgstr "Mas... mas..."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_7e4bf646"
msgid "Tout de suite, mon grand !"
msgstr "É para já, meu chapa!"

#. Character:`chef` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_3c71a030"
msgid "Ne reste pas plantée là et aide-moi !"
msgstr "Não fica aí parada com cara de tacho e me ajuda!"

#. Character:`noriko`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_35f0c3d7"
msgid "Allez, hop hop hop !"
msgstr "Isso aí, anda logo, mexe esse esqueleto!"

#. Character:`kimochi`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_1198ece4"
msgid "On t'a jamais dit qu'il ne fallait pas provoquer une Yandere ?"
msgstr "Ninguém nunca te avisou que é uma péssima ideia provocar uma Yandere?"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_35b60ebb"
msgid "Tu veux que je t'écrase les testicules, tête de bite ?"
msgstr "Você quer que eu esmague os seus ovos, seu cabeça de pica?"

#. Character:`kimochi` | Attributes:`horny`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_e73b0276"
msgid "[font_size=14]Ça pourrait potentiellement m'intéresser...[/font_size]"
msgstr "[font_size=14]Olha... pior que isso pode até me interessar...[/font_size]"

#. Character:`macumba`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_aae3ee35"
msgid "Haha, notre groupe s'agrandit, j'aime cette ambiance !"
msgstr "Haha, a nossa galera está aumentando, estou curtindo essa vibe!"

#. Character:`macumba`
#: game/story/restaurant_interior.dialogue
msgctxt "restaurant_interior_b985fcee"
msgid "Tu as du style, petite sœur !"
msgstr "Você tem atitude, maninha!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "HEY_GAMIN_DE6C75"
msgid "Hey, gamin !"
msgstr "Ei, moleque!"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "BONJOUR_CHEF_JE_CHERCHE_SAKUYA_161D08"
msgid "Bonjour, chef, je cherche {{sakuya.n}}, vous ne sauriez pas où je pourrais la trouver, à tout hasard ?"
msgstr "Bom dia, {{chefe.n}}. Estou procurando a {{sakuya.n}}, por acaso o senhor saberia onde posso encontrá-la?"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "EH_BIEN_MOI_AUSSI_SI_TU_LA_TRO_ECE251"
msgid "Eh bien, moi aussi. Si tu la trouves, dis-lui de ramener son cul rapidement, elle est déjà en retard pour son service !"
msgstr "Pois é, eu também estou. Se você achá-la, diga para ela correr logo para cá, ela já está atrasada para o expediente!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "IL_Y_A_UN_PROBL_ME_AVEC_ELLE_C5145D"
msgid "Il y a un problème avec elle ?"
msgstr "Aconteceu algum problema com ela?"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_CROIS_QU_ELLE_S_EN_EST_PRI_28D82C"
msgid "... Je crois qu'elle s'en est prise à quelqu'un qui compte pour moi."
msgstr "... Eu acho que ela atacou uma pessoa que é muito importante para mim."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "PUTAIN_JE_SAVAIS_QU_ELLE_NE_P_5D64CC"
msgid "... Putain, je savais qu'elle ne pouvait pas se tenir tranquille !"
msgstr "... Puta merda, eu sabia que ela não conseguiria ficar quieta!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "COUTE_MON_GAR_ON_CONTENTE_TOI_3C89C9"
msgid "Écoute, mon garçon, contente-toi de ne plus la contrarier."
msgstr "Escuta, meu rapaz, trate apenas de não contrariá-la mais."

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "MAIS_767FDB"
msgid "Mais..."
msgstr "Mas..."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_M_OCCUPE_DU_RESTE_J_ESSAIER_77AE9E"
msgid "Je m'occupe du reste ! J'essaierai de lui faire entendre raison, mais cette fille est aussi dingue que sa mère."
msgstr "Do resto eu cuido! Vou tentar trazê-la à razão, mas essa garota é tão maluca quanto a mãe dela."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "ta5b9f3b380"
msgid "Oh mon amour ! Tu es venu pour passer du temps avec moi ?"
msgstr "Ah, meu amor! Você veio para passar um tempo comigo?"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "tbf68341418"
msgid "[font_size=14]Soyons discret, mon père nous observe toujours du coin de l'oeil.[/font_size]"
msgstr "[font_size=14]Sejamos discretos, o meu pai está sempre nos vigiando pelo canto do olho.[/font_size]"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "tdac4bafff0"
msgid "Je suis venu car j'avais quelque chose de particulier à te demander !"
msgstr "Eu vim porque tenho algo especial para te pedir!"

#. Character:`sakuya` | Attributes:`happy,blush`
#: game/story/restaurant_interior.dialogue
msgctxt "tb222c41a00"
msgid "Oh toi alors quel petit pervers tu fais !"
msgstr "Oh, mas que pervertidinho você me saiu!"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "tf6979bbb7a"
msgid "Allons dans ma chambre pour ça !"
msgstr "Vamos para o meu quarto resolver isso!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/restaurant_interior.dialogue
msgctxt "te6aa8d0e87"
msgid "Euh je crois que tu te méprends sur mes intent-"
msgstr "Err, eu acho que você entendeu mal as minhas inten-"

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "tf7abbcb5fe"
msgid "Dépêche toi !"
msgstr "Ande logo!"

#. Character:`saito`
#: game/story/restaurant_interior.dialogue
msgctxt "t70ad7ccf7d"
msgid "..."
msgstr "..."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "S_IL_TE_PLA_T_SAKUYA_N_NE_FAIS_A9DA7F"
msgid "S'il te plaît {{sakuya.n}}, ne fais pas de vagues !"
msgstr "Por favor, {{sakuya.n}}, não cause problemas!"

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "TU_AS_BIEN_VU_QUE_NOUS_SOMMES_DB1AD4"
msgid "Tu as bien vu que nous sommes surveillés à présent."
msgstr "Você viu muito bem que estamos sendo vigiados agora."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "MAIS_PAPA_TOUT_A_EST_RIDICULE_BE8569"
msgid "Mais papa, tout ça est ridicule, {{saito.n}} n'a rien fait de tout ce dont on l'accuse !"
msgstr "Mas, papai, tudo isso é ridículo, o {{saito.n}} não fez nada do que estão acusando ele!"

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "IL_A_T_PI_G_C6CA52"
msgid "Il a été piégé !"
msgstr "Armaram para ele!"

#. Character:`chef` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "TU_AS_CERTAINEMENT_RAISON_C_ES_23DD92"
msgid "Tu as certainement raison... C'est un brave garçon, et je ne me trompe généralement jamais quand je dois juger quelqu'un."
msgstr "Você certamente tem razão... Ele é um bom rapaz, e eu geralmente nunca me engano quando preciso julgar alguém."

#. Character:`chef` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "MAIS_TOUT_A_EST_BIEN_TROP_GROS_65FB1F"
msgid "Mais tout ça est bien trop gros, même pour toi."
msgstr "Mas essa situação é grande demais, até mesmo para você."

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "MAIS_PAPA_JE_PEUX_ED21F8"
msgid "Mais papa, je peux..."
msgstr "Mas, papai, eu posso..."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_SAIS_CE_DONT_TU_ES_CAPABLE_B15568"
msgid "Je sais ce dont tu es capable, je ferme les yeux sur beaucoup de choses, mais là tu dois arrêter."
msgstr "Eu sei bem do que você é capaz. Eu faço vista grossa para muita coisa, mas agora você precisa parar."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "TA_M_RE_EST_D_J_EN_PRISON_ET_J_F1E52E"
msgid "Ta mère est déjà en prison et je n'ai pas envie de perdre ma fille également, j'espère que tu peux le comprendre ?"
msgstr "A sua mãe já está na prisão e eu não tenho a menor intenção de perder a minha filha também, espero que consiga entender isso."

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "OUI_PAPA_909CAE"
msgid "Oui, papa..."
msgstr "Sim, papai..."

#. Character:`chef`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_SUIS_D_SOL_01F7F2"
msgid "Je suis désolé."
msgstr "Sinto muito."

#. Character:`noriko`
#: game/story/restaurant_interior.dialogue
msgctxt "ALORS_C_EST_DONC_ICI_QUE_TU_TR_08B83B"
msgid "Alors... C'est donc ici que tu travailles...?"
msgstr "Então... é aqui que você trabalha...?"

#. Character:`sakuya` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "W_TU_DEVRAIS_LE_SAVOIR_POURTA_BF72DE"
msgid "...[w] Tu devrais le savoir pourtant, toi qui es entrée par effraction dans ma chambre pendant qu–"
msgstr "...[w] Você já deveria saber disso, considerando que invadiu o meu quarto enquanto eu-"

#. Character:`noriko` | Attributes:`shame`
#: game/story/restaurant_interior.dialogue
msgctxt "HAHA_OUI_MAIS_TU_SAIS_C_TAIT_P_620BEE"
msgid "Haha ! Oui ! Mais tu sais... c'était pour..."
msgstr "Haha! Sim! Mas você sabe... aquilo foi para..."

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "A_SUFFIT_DIS_MOI_CE_QUE_TU_ME_25B8FF"
msgid "Ça suffit ! Dis-moi ce que tu me veux !"
msgstr "Já chega! Diga logo o que você quer comigo!"

#. Character:`noriko`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_687626"
msgid "Je..."
msgstr "Eu..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "MA_CH_RIE_TU_VEUX_BIEN_SORTIR_D535E7"
msgid "Ma chérie, tu veux bien sortir s'il te plait ?"
msgstr "Querida, você poderia sair um instante, por favor?"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/restaurant_interior.dialogue
msgctxt "MAIS_MAMAN_BD0DC7"
msgid "Mais maman-"
msgstr "Mas, mãe-"

#. Character:`yasuka` | Attributes:`upset`
#: game/story/restaurant_interior.dialogue
msgctxt "MAINTENANT_3C4A20"
msgid "Maintenant !"
msgstr "Agora!"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "ALORS_VOUS_VOUS_PLAISEZ_BIEN_D_EB4B46"
msgid "Alors..? Vous vous plaisez bien dans votre nouveau travail ?"
msgstr "E então...? Está gostando do seu novo trabalho?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_NE_POURRAIS_JAMAIS_ASSEZ_TE_342612"
msgid "Je ne pourrais jamais assez te remercier pour cette opportunité."
msgstr "Eu nunca serei capaz de lhe agradecer o suficiente por esta oportunidade."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "NE_CROYEZ_PAS_QUE_J_AI_FAIS_A_41058F"
msgid "Ne croyez pas que j'ai fais ça par bonté d'âme."
msgstr "Não pense que fiz isso por pura bondade."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "C_TAIT_UNIQUEMENT_PAR_AMOUR_PO_C4CF1D"
msgid "C'était uniquement par amour pour {{saito.n}}."
msgstr "Foi única e exclusivamente por amor ao {{saito.n}}."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "MA_CH_RIE_JE_VAIS_PRENDRE_LE_R_3CB613"
msgid "Ma chérie, je vais prendre le relais si tu veux bien."
msgstr "Querida, eu assumo daqui, se não se importar."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "BONJOUR_SAKUYA_N_NOUS_N_AVONS_027937"
msgid "Bonjour {{sakuya.n}}, nous n'avons pas souvent eu l'occasion de discuter toutes les deux ou la situation ne s'y prêtait pas."
msgstr "Olá, {{sakuya.n}}. Nós não tivemos muitas oportunidades de conversar a sós, ou a situação simplesmente não ajudava."

#. Character:`yasuka`
#: game/story/restaurant_interior.dialogue
msgctxt "MERCI_ENCORE_POUR_TOUTE_L_AIDE_E3E824"
msgid "Merci encore pour toute l'aide que tu nous as apportées et ton soutien indéfectible à {{saito.n}}."
msgstr "Obrigada mais uma vez por toda a ajuda que nos deu e pelo seu apoio incondicional ao {{saito.n}}."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "ET_JE_LE_REFERAIS_ENCORE_MILLE_5F369F"
msgid "Et je le referais encore mille fois si c'était nécessaire."
msgstr "E eu faria tudo de novo mil vezes se fosse necessário."

#. Character:`yasuka`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_ME_RENDS_COMPTE_QUEL_POINT_41BD2C"
msgid "Je me rends compte à quel point tu l'aimes."
msgstr "Eu percebo o quanto você o ama."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "NON_VOUS_N_AVEZ_PAS_ID_E_QUEL_E3B25A"
msgid "Non, vous n'avez pas idée à quel point."
msgstr "Não, a senhora não tem ideia do quanto."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "AVEZ_VOUS_D_J_AIM_QUELQU_UN_AU_7645FD"
msgid "Avez-vous déjà aimé quelqu’un au point d’être prête à tuer toute personne qui lui voudrait du mal ?"
msgstr "A senhora já amou alguém a ponto de estar disposta a matar qualquer pessoa que tentasse lhe fazer mal?"

#. Character:`yasuka` | Attributes:`upset`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_JE_PEUX_L_ENVISAGER_JE_SUIS_6123EC"
msgid "Je... Je peux l'envisager. Je suis une mère après tout, si quelqu’un faisait du mal à {{noriko.n}} je pourrais avoir ce genre de pensées."
msgstr "Eu... eu posso compreender isso. Afinal, eu sou mãe. Se alguém machucasse a {{noriko.n}}, eu poderia ter esse tipo de pensamento."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_NE_PARLE_PAS_DE_PENS_ES_JE_A95F98"
msgid "Je ne parle pas de pensées, je parle de pulsions que vous devez contenir de toutes vos forces, sinon vous passeriez à l'action."
msgstr "Eu não estou falando de pensamentos. Estou falando de impulsos que eu preciso conter com todas as suas forças, caso contrário, partiria para a ação."

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "LA_SEULE_CHOSE_QUI_M_EN_EMP_CH_C28000"
msgid "La seule chose qui m’en empêche c’est peut-être la peur de ne plus jamais revoir mon amour si je me faisais prendre."
msgstr "A única coisa que me impede é, talvez, o medo de nunca mais ver o meu amor se eu for pega."

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_SUIS_D_SOL_E_MAMAN_C_TAIT_P_FE6180"
msgid "Je suis désolée maman, c'était peut-être une erreur de venir ici..."
msgstr "Sinto muito, mamãe. Talvez tenha sido um erro vir aqui..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "W_TOUT_VA_BIEN_MA_CH_RIE_NOUS_5C869A"
msgid "...[w] Tout va bien ma chérie, nous ne faisons que discuter."
msgstr "...[w] Está tudo bem, querida, nós estamos apenas conversando."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/restaurant_interior.dialogue
msgctxt "NATURELLEMENT_E8545F"
msgid "Naturellement."
msgstr "Com toda certeza."

#. Character:`yasuka`
#: game/story/restaurant_interior.dialogue
msgctxt "AS_TU_EU_DES_NOUVELLES_DE_LUI_B85502"
msgid "As-tu eu des nouvelles de lui dernièrement ?"
msgstr "Você teve notícias dele ultimamente?"

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "W_NON_54C302"
msgid "...[w] Non."
msgstr "...[w] Não."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "NOUS_AVIONS_PENS_QUE_COMME_TU_CF8574"
msgid "Nous avions pensé que comme tu étais très proche de lui..."
msgstr "Nós pensamos que, como você é muito próxima dele..."

#. Character:`yasuka`
#: game/story/restaurant_interior.dialogue
msgctxt "NOUS_SOMMES_SURVEILL_ES_DE_TOU_A3266C"
msgid "Nous sommes surveillées de tous les côtés par la police et selon {{noriko.n}} tu es la seule personne capable de passer outre ce genre de problèmes."
msgstr "Estamos sendo vigiadas por todos os lados pela polícia e, segundo a {{noriko.n}}, você é a única pessoa capaz de contornar esse tipo de problema."

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_POURRAIS_FAIRE_BIEN_PLUS_EN_1D00A5"
msgid "Je pourrais faire bien plus encore ! Mais j’ai promis à mon père que je ne ferai rien qui pourrait lui faire du tort."
msgstr "Eu poderia fazer muito mais do que isso! Mas prometi ao meu pai que não faria nada que pudesse prejudicá-lo."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "MA_M_RE_TANT_D_J_EN_PRISON_IL_81A8BD"
msgid "Ma mère étant déjà en prison, il aimerait que je ne poursuive pas son exemple."
msgstr "Como a minha mãe já está na prisão, ele gostaria que eu não seguisse o exemplo dela."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "COMME_SI_UN_SIMPLE_POLICIER_PO_FF2FBF"
msgid "Comme si un simple policier pouvait faire quoi que ce soit contre moi."
msgstr "Como se um simples policial pudesse fazer qualquer coisa contra mim."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/restaurant_interior.dialogue
msgctxt "SAKUYA_N_J_AI_BESOIN_DE_TON_A_DEDF4C"
msgid "{{sakuya.n}}... J’ai besoin de ton aide."
msgstr "{{sakuya.n}}... Eu preciso da sua ajuda."

#. Character:`yasuka`
#: game/story/restaurant_interior.dialogue
msgctxt "UN_POLICIER_M_EMP_CHE_D_ALLER_9DE0E2"
msgid "Un policier m’empêche d’aller voir la mère d’{{asami.n}} qui est une amie à moi."
msgstr "Um policial está me impedindo de visitar a mãe da {{asami.n}}, que é uma grande amiga minha."

#. Character:`yasuka`
#: game/story/restaurant_interior.dialogue
msgctxt "JE_CROIS_QU_ILS_LUI_FONT_DU_MA_FE775A"
msgid "Je crois qu’ils lui font du mal et je ne peux pas l’aider."
msgstr "Eu acho que estão machucando ela e eu não consigo ajudá-la."

#. Character:`sakuya` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "TOUT_A_NE_ME_REGARDE_PAS_64B1F1"
msgid "Tout ça ne me regarde pas."
msgstr "Nada disso me diz respeito."

#. Character:`sakuya`
#: game/story/restaurant_interior.dialogue
msgctxt "POURQUOI_PRENDRAIS_JE_AUTANT_D_D22EED"
msgid "Pourquoi prendrais-je autant de risques pour une autre femme ?"
msgstr "Por que eu correria tantos riscos por outra mulher?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/restaurant_interior.dialogue
msgctxt "SI_TU_VIENS_EN_AIDE_UNE_PERSON_4F3984"
msgid "Si tu viens en aide à une personne que {{saito.n}} apprécie beaucoup, je suis certaine qu’il sera reconnaissant, non ?"
msgstr "Se você ajudar uma pessoa de quem o {{saito.n}} gosta muito, tenho certeza de que ele ficará grato, não?"

#. Character:`sakuya` | Attributes:`angry`
#: game/story/restaurant_interior.dialogue
msgctxt "NE_CROYEZ_PAS_UNE_SECONDE_QUE_16E78C"
