msgctxt "FONT_SIZE_14_QU_EST_CE_QU_ELL_14F399"
msgid "[font_size=14]Qu’est-ce qu’elle fait là celle-là ? Zut ![/font_size]"
msgstr ""

#. Character:`saito` | Attributes:`neutral`
#: game/story/love_hotel_exterior.dialogue
msgctxt "EST_CE_QUE_TOUT_VA_BIEN_5F49C5"
msgid "Est-ce que tout va bien ?"
msgstr ""

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/love_hotel_exterior.dialogue
msgctxt "OH_SAITO_N_JE_SUIS_TELLEMENT_C_925B53"
msgid "Oh {{saito.n}} je suis tellement contente de te voir..."
msgstr ""

#. Character:`sakuya` | Attributes:`sad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "JE_ME_SUIS_FAIT_AGRESSER_PAR_T_448BFE"
msgid "Je me suis faite agresser par trois hommes, ils ont voulu m’emmener dans une ruelle sombre pour..."
msgstr ""

#. Character:`saito` | Attributes:`upset`
#: game/story/love_hotel_exterior.dialogue
msgctxt "ILS_NE_T_ONT_RIEN_FAIT_E5BFB5"
msgid "Ils ne t’ont rien fait ?"
msgstr ""

#. Character:`sakuya` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "NON_C_EST_BON_276B2B"
msgid "Non c’est bon..."
msgstr ""

#. Character:`asami`
#: game/story/love_hotel_exterior.dialogue
msgctxt "JE_TROUVE_QUE_TU_TE_PORTES_PLU_CF9C60"
msgid "Je trouve que tu te portes plutôt bien pour une fille qui s’est faite agresser..."
msgstr ""

#. Character:`sakuya` | Attributes:`sad`
#: game/story/love_hotel_exterior.dialogue
msgctxt "C_EST_JE_M_EN_SUIS_SORTIE_EN_C_CCC378"
msgid "C’est... Je m’en suis sortie en criant assez fort..."
msgstr ""

#. Character:`asami` | Attributes:`neutral`
#: game/story/love_hotel_exterior.dialogue
msgctxt "JE_VOIS_JE_SUIS_SINC_REMENT_D_0F382D"
msgid "Je vois... Je suis sincèrement désolée de ce qui t’est arrivé..."
msgstr ""

#. Character:`asami`
#: game/story/love_hotel_exterior.dialogue
msgctxt "MAIS_A_DEVRAIT_ALLER_MAINTENAN_C3D8B8"
msgid "Mais ça devrait aller maintenant, je pense que tu réussiras à rentrer chez toi en sécurité."
msgstr ""

#. Character:`sakuya`
#: game/story/love_hotel_exterior.dialogue
msgctxt "NON_J_AI_BIEN_TROP_PEUR_SAITO_6BAB75"
msgid "Non j’ai bien trop peur... {{saito.n}} ne me laisse pas toute seule, s’il te plaît !"
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/love_hotel_exterior.dialogue
msgctxt "JE_5E837B"
msgid "... Je..."
msgstr ""

#. Character:`asami` | Attributes:`bored`
#: game/story/love_hotel_exterior.dialogue
msgctxt "ARGLLL_C_EST_BON_RACCOMPAGNONS_5D4CAC"
msgid "Arglll... C’est bon, raccompagnons-la chez elle !"
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/love_hotel_exterior.dialogue
msgctxt "IL_FAUDRAIT_TRE_SANS_C_UR_POUR_801B97"
msgid "Il faudrait être sans cœur pour la laisser dans cette condition."
msgstr ""

#. Character:`sakuya` | Attributes:`happy`
#: game/story/love_hotel_exterior.dialogue
msgctxt "MERCI_BEAUCOUP_ASAMI_N_E879CF"
msgid "Merci beaucoup {{asami.n}} !"
msgstr ""

#. Character:`asami`
#: game/story/love_hotel_exterior.dialogue
msgctxt "FONT_SIZE_14_G_CHEUSE_DE_SOIR_F58EA4"
msgid "[font_size=14]Gâcheuse de soirée...[/font_size]"
msgstr ""

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_64704e2b"
msgid "Ça devrait faire l'affaire et..."
msgstr "Isso deve dar conta do recado e..."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_fced261b"
msgid "Hey, mais c'est quoi ce bordel ?!"
msgstr "Ei, mas que porra é essa?!"

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_8178876c"
msgid "Mes yeux... Ils sont dorés !"
msgstr "Meus olhos... Eles estão dourados!"

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_2f893cb9"
msgid "Qu'est-ce que c'est que ce bordel ?"
msgstr "Mas que porra é essa?"

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_e2327b56"
msgid "Jusqu'à ce que je me souvienne, ils ont toujours été marron..."
msgstr "Até onde eu me lembre, eles sempre foram castanhos..."

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_4649eabc"
msgid "Ça aurait un rapport avec ma réincarnation ?"
msgstr "Será que isso tem algo a ver com a minha reencarnação?"

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_e663489e"
msgid "Je dois en avoir le cœur net !"
msgstr "Eu preciso tirar essa história a limpo!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_626857b3"
msgid "Et voilà !"
msgstr "Prontinho!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_1647e37f"
msgid "Tant de mystères..."
msgstr "Nossa, quanto mistério..."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_07d4f51a"
msgid "En fait, je trouve ça très excitant."
msgstr "Na verdade, eu acho isso bem excitante."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_58f446b9"
msgid "Tiens, tiens."
msgstr "Ora, ora."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_d1fd9e41"
msgid "Prenons le bain ensemble..."
msgstr "Vamos tomar banho juntos..."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_d6f084c8"
msgid "Allez, ferme-moi ses yeux tout de suite et déshabille-toi !"
msgstr "Vamos, feche esses olhos agora mesmo e tire a roupa!"

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_1c3da840"
msgid "Pourquoi toutes les femmes veulent toujours que je ferme les yeux à un moment si important ?!"
msgstr "Por que todas as mulheres sempre querem que eu feche os olhos em um momento tão importante?!"

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_ecf59c13"
msgid "Tu sais... Tu es déjà venue dormir nue dans ma chambre..."
msgstr "Sabe... Você já veio dormir nua no meu quarto..."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_80138a2a"
msgid "Ce... Ça n'avait rien à voir ! On ne faisait que dormir !"
msgstr "Aqu... Aquilo não tinha nada a ver! Estávamos apenas dormindo!"

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_d812661f"
msgid "Allez, laisse-moi t'aider à te rincer !"
msgstr "Vamos, deixa eu te ajudar a se enxaguar!"

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_f70630e3"
msgid "Je pouvais le faire, tu n'étais pas obligée, tu sais..."
msgstr "Eu poderia fazer isso sozinho, você não precisa se dar ao trabalho, sabe..."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_7aa29b63"
msgid "J'ai envie de prendre soin de toi, tu te donnes beaucoup de mal en ce moment."
msgstr "Eu quero cuidar de você, você tem se esforçado muito ultimamente."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_a3ae53b2"
msgid "D'accord."
msgstr "Está bem."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_5e340896"
msgid "Bon garçon !"
msgstr "Bom garoto!"

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_dccf268d"
msgid "Voilà, tu peux rentrer dans le bain à présent."
msgstr "Pronto, você pode entrar na banheira agora."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_06a705f5"
msgid "Et me voilà."
msgstr "E aqui vou eu."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_5bca1934"
msgid "Tu apprécies ?"
msgstr "Está gostando?"

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_fe5907b3"
msgid "Honnêtement ? Je nage littéralement dans le bonheur."
msgstr "Sinceramente? Estou literalmente nadando em felicidade."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_3efbffad"
msgid "Pfff."
msgstr "Pfff."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_47e17d91"
msgid "Héhé"
msgstr "Haha."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_856cf8c5"
msgid "Tu sais..."
msgstr "Sabe..."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_e6a0582a"
msgid "Je repensais à nous deux et nos longues discussions."
msgstr "Eu estava pensando em nós dois e em nossas longas conversas."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_7d5c4e4b"
msgid "J'ai adoré ça, j'ai envie d'en savoir encore plus maintenant sur ce nouveau toi."
msgstr "Eu adorei aquilo, e agora quero saber ainda mais sobre esse \"novo você\"."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_8dc0acd9"
msgid "Tu es devenue une véritable épaule sur laquelle j'ai envie de m'appuyer."
msgstr "Você se tornou um verdadeiro ombro em que eu tenho vontade de me apoiar."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_46fef55d"
msgid "Oh je... Merci, je ne m'attendais pas à une déclaration aussi adorable."
msgstr "Ah, eu... Obrigado, eu não esperava uma declaração tão adorável."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_b7484b85"
msgid "Que veux-tu savoir ?"
msgstr "O que você quer saber?"

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_eb5b503a"
msgid "Tout !"
msgstr "Tudo!"

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_c78fe368"
msgid "Ça risque d'être long..."
msgstr "Isso pode levar tempo..."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_e5a3391a"
msgid "J'ai tout mon temps, je suis en très bonne compagnie ici."
msgstr "Eu tenho todo o tempo do mundo, estou em ótima companhia aqui."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_4e46793f"
msgid "Alors voilà..."
msgstr "Então lá vai..."

#. Character:`centered`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_a898e9b8"
msgid "{{saito.n}} et {{yasuka.n}} passèrent un long moment à discuter de tout et de rien."
msgstr "{{saito.n}} e {{yasuka.n}} passaram um longo tempo conversando sobre tudo e nada."

#. Character:`centered`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_4b7ae6a4"
msgid "À force, restés blottis l'un contre l'autre... {{saito.n}} ne put davantage cacher son excitation."
msgstr "De tanto ficarem aninhados um contra o outro... {{saito.n}} não conseguiu mais esconder sua ereção."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_fe841259"
msgid "...Désolé."
msgstr "...Desculpe."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_d657c227"
msgid "Ne t'excuse pas mon chéri."
msgstr "Não se desculpe, querido."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_82b5d20f"
msgid "Je te promets de m'occuper de toi comme il se doit !"
msgstr "Prometo que cuidarei de você como se deve!"

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_4bef913d"
msgid "C'est juste que...[w] J'ai l'impression de sauter dans l'inconnu."
msgstr "É que...[w] sinto como se estivesse saltando no desconhecido."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_5fb2bda1"
msgid "Plus de marche arrière après ça..."
msgstr "E não tem mais volta depois disso..."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_56544447"
msgid "Tu pensais la même chose ?"
msgstr "Você também sente isso?"

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "t485b79496a"
msgid "Non, je suis sûr de ce que je ressens pour toi."
msgstr "Não, eu tenho certeza do que sinto por você"

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_6b6cf084"
msgid "Mais ça ne me gêne pas, prend le temps nécessaire d'accord."
msgstr "Mas isso não me incomoda, leve o tempo que precisar, está bem?"

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_8a8b6c2b"
msgid "...Je te promets que quand cela arrivera, tu ne le regretteras pas."
msgstr "...Eu prometo que, quando acontecer, você não vai se arrepender."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_ab7f11c3"
msgid "Je ne suis pas inquiet."
msgstr "Não estou preocupado."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_abf16d3b"
msgid "Bon, je vais sortir, l'eau du bain commence à être froide et {{noriko.n}} va surement se demander ce que je suis en train de faire."
msgstr "Bom, vou sair, a água do banho está começando a esfriar e a {{noriko.n}} provavelmente vai se perguntar o que estou fazendo."

#. Character:`noriko`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_5f48eaba"
msgid "[font_size=14]Maman ! C'est toi qui es dans la salle de bain ? Je peux entrer ?[/font_size]"
msgstr "[font_size=14]Mãe! É você que está no banheiro? Posso entrar?[/font_size]"

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_3d1073c4"
msgid "Oh non, mince !"
msgstr "Ah não, droga!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_8b558934"
msgid "...Je m'en occupe !"
msgstr "...Eu cuido disso!"

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_7f38982e"
msgid "Ahhhhh, quel bonheur."
msgstr "Ahhhhh, que delícia."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_e787a87b"
msgid "Après une bonne journée de travail, rien de tel qu'un bon bain chaud."
msgstr "Depois de um longo dia de trabalho, nada como um bom banho quente."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_5d3850be"
msgid "En bonne compagnie..."
msgstr "E em ótima companhia..."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_b3ea5326"
msgid "Ce n'est pas moi qui dirai le contraire."
msgstr "Eu não seria louco de dizer o contrário."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_7a605276"
msgid "Je ne comprends pourquoi avant, tu ne voulais plus prendre ton bain avec moi..."
msgstr "Eu não entendo por que, antes, você não queria mais tomar banho comigo..."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_cbfaaba5"
msgid "Je...[w] J'étais mal dans ma peau."
msgstr "Eu...[w] Eu não estava bem comigo mesmo."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_649991de"
msgid "Mais j'ai réussi à me reprendre en main."
msgstr "Mas consegui dar a volta por cima."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_b063eed8"
msgid "Oui, j'ai vu et j'adore ce nouveau toi."
msgstr "Sim, eu percebi, e adoro esse seu \"novo eu\"."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_57a3a43c"
msgid "Et tu n'as encore rien vu !"
msgstr "E você ainda não viu nada!"

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_e1343d73"
msgid "Oh, je vois..."
msgstr "Ah, eu estou vendo..."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_5305d519"
msgid "Je constate en tout cas que ton corps est tout aussi sincère."
msgstr "Pelo visto, o seu corpo é bem sincero."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_57eaec54"
msgid "Il y a quelque chose de plutôt dur dans mon dos."
msgstr "Tem algo bem duro cutucando as minhas costas."

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_9eed8622"
msgid "Et je crois savoir ce que c'est."
msgstr "E acho que sei exatamente o que é."

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_a0261f49"
msgid "Oh !"
msgstr "Oh!"

#. Character:`yasuka`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_211d2233"
msgid "On continue dans notre chambre ?"
msgstr "Vamos continuar no quarto?"

#. Character:`saito`
#: game/story/home_player_bathroom.dialogue
msgctxt "home_player_bathroom_e21757d7"
msgid "Avec plaisir !"
msgstr "Com todo prazer!"

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "MES_YEUX_POURQUOI_SONT_ILS_DOR_F8C4E7"
msgid "Mes yeux... Pourquoi sont-ils... dorés !?"
msgstr ""

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "EN_VRAI_C_EST_PAS_SI_MAL_1B000D"
msgid "En vrai... c'est pas si mal."
msgstr ""

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "JUSQU_CE_QUE_JE_M_EN_SOUVIENNE_6A4F99"
msgid "Jusqu'à ce que je m'en souvienne, ils ont toujours été marrons..."
msgstr ""

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "A_AURAIT_UN_RAPPORT_AVEC_MON_3FB62E"
msgid "Ça aurait un rapport avec mon retour ?"
msgstr ""

#. Character:`narrator`
#: game/story/home_player_bathroom.dialogue
msgctxt "POURQUOI_PERSONNE_NE_L_A_REMAR_5EFEBB"
msgid "Pourquoi personne ne l'a remarqué ?"
msgstr ""

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_a7116d26"
msgid "{{kimochi.n}} est en train de faire diversion. Je devrais en profiter pour parler à {{yasuka.n}} !"
msgstr "O {{kimochi.n}} tá distraindo ele. É a minha chance de falar com a {{yasuka.n}}!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_638d53ff"
msgid "Qu'est-ce que tu fais encore là ?"
msgstr "O que você ainda está fazendo aqui?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_f9af6ae6"
msgid "Tu ne crois pas que j'ai déjà assez vu ta tête pour aujourd'hui ?"
msgstr "Não acha que já deu de olhar para essa sua fuça por hoje?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_81181c4f"
msgid "Tire-toi de là !"
msgstr "Dê o fora daqui!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_2cc75c94"
msgid "Tu veux ma photo ?"
msgstr "Quer uma foto minha?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_16ec413d"
msgid "Dégage !"
msgstr "Suma daqui!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_21bb631c"
msgid "Ma-"
msgstr "Mas-"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_f5987766"
msgid "Non, mais tu pensais pas que tu allais pouvoir rentrer comme dans un moulin ?"
msgstr "Mas você não achou mesmo que ia poder entrar aqui como se a casa fosse sua, achou?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_a6362c16"
msgid "Je ne veux plus voir ta tête à proximité de ma boutique ou j'appelle la police."
msgstr "Não quero mais ver a sua cara perto da minha loja ou eu chamo a polícia."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_a8bd39f9"
msgid "Casse-toi, j'ai horreur de me répéter !"
msgstr "Vaza daqui, eu odeio me repetir!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_c7e603a2"
msgid "Tu sais, je serai un super beau-papa, tu verras."
msgstr "Sabe, eu vou ser um ótimo padrasto, você vai ver."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_0f328635"
msgid "Enfin... Je vais surtout m'occuper d'elle, si tu vois ce que je veux dire."
msgstr "Enfim... Eu vou principalmente cuidar bem dela, se é que você me entende."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_c47aa1d8"
msgid "Je crois que c'est ici..."
msgstr "Acho que é aqui..."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_66c269d1"
msgid "Ça a l'air plutôt chic."
msgstr "Parece bem chique."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_6cc9dafd"
msgid "Je crois bien n'être jamais venu ici auparavant."
msgstr "Acho que nunca estive aqui antes."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_0cf34c6e"
msgid "Je peux savoir ce que tu cherches ?"
msgstr "Posso saber o que você está procurando?"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_54c5c8aa"
msgid "Oh la vache, je ne l'avais pas vu arriver lui !"
msgstr "Caralho, eu não vi esse cara chegando!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_977c6c67"
msgid "Une seconde... Boss ?"
msgstr "Espera um segundo... Boss?"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_25297198"
msgid "C'est lui le patron de {{yasuka.n}} ?"
msgstr "É esse cara o patrão da {{yasuka.n}}?"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_bf5beb90"
msgid "Merde, je comprends mieux pourquoi elle semblait si angoissée à l'idée d'y retourner."
msgstr "Merda, agora eu entendo melhor por que ela parecia tão ansiosa com a ideia de voltar para cá."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_77d2c7ea"
msgid "Une seconde, je juge trop vite, peut-être qu'il est tout aussi sympa que {{macumba.n}} ?"
msgstr "Espera, estou julgando rápido demais, talvez ele seja tão legal quanto o {{macumba.n}}?"

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_caa122d1"
msgid "Je..."
msgstr "Eu..."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_8e2d1a55"
msgid "FOUS-MOI LE CAMP !"
msgstr "VÁ EMBORA DAQUI!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_fdd9d734"
msgid "Quoi ? Il faut que je le répète espèce de demeuré ?"
msgstr "O quê? Preciso repetir, seu imbecil?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_9c63b3a6"
msgid "Arrête de rester planté là-devant ma boutique."
msgstr "Para de ficar plantado aí na frente da minha loja."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_4ebbe5df"
msgid "Dégage, tu vas faire fuir les clients !"
msgstr "Suma daqui, você vai espantar os clientes!"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_c7ddf840"
msgid "Hey, je suis justement un client !"
msgstr "Ei, eu sou justamente um cliente!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_9f91f230"
msgid "...Tsss."
msgstr "...Tsc."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_bbf36726"
msgid "Dans ce cas, bienvenue cher monsieur."
msgstr "Nesse caso, seja bem-vindo, meu caro senhor."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_23514d28"
msgid "Mais quelle putain de bâtard !"
msgstr "Mas que puta de um cuzão!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_bedadfdb"
msgid "J'ai parlé avec lui 2 minutes et j'ai déjà envie de le tuer !"
msgstr "Falei com ele por dois minutos e já estou com vontade de matar esse cara!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_29c3f1e3"
msgid "Bon, je suis venu pour {{yasuka.n}}, oublions ce gros connard."
msgstr "Bom, eu vim pela {{yasuka.n}}, deixa para lá esse baita babaca."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_45797a47"
msgid "Mais quel enfoiré ce type !"
msgstr "Mas que escroto esse cara!"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_5d15ecaa"
msgid "Je dois comprendre pourquoi elle tient tant à rester travailler ici."
msgstr "Eu preciso entender por que ela faz tanta questão de continuar trabalhando aqui."

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_80f48e75"
msgid "J'espère que tout ira bien pour elle."
msgstr "Espero que fique tudo bem com ela."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_632ac3e9"
msgid "C'est ici !"
msgstr "É aqui!"

#. Character:`noriko`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_dff5d2da"
msgid "Plutôt sympa comme endroit si on exclut le gros porc assis sur chaise devant."
msgstr "Até que é um lugar legal, se você excluir o porco gordo sentado na cadeira ali na frente."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_09d8e41d"
msgid "Parle moins fort, tu vas le..."
msgstr "Fala mais baixo, você vai..."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_470fd0fc"
msgid "HEY !"
msgstr "EI!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_73bde567"
msgid "Je t'ai reconnu, tu es le petit merdeux d'hier !"
msgstr "Eu reconheci você, você é o merdinha de ontem!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_4ce04571"
msgid "Tu es venu faire le malin avec ta copine ?"
msgstr "Veio se pagar de espertinho com a sua namorada?"

#. Character:`noriko` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_f9814168"
msgid "Une seconde, le gros dégueulasse !"
msgstr "Espera aí, seu gordo nojento!"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_af1f6064"
msgid "Qu'est-ce que tu veux petite salope ?"
msgstr "O que você quer, sua piranha?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_560f9a2d"
msgid "Tu penses que tu peux faire la maline, car ton mec est derrière toi ?"
msgstr "Acha que pode se pagar de espertinha só porque o seu homem está atrás de você?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_0d01fe0e"
msgid "Dégagez en vitesse."
msgstr "Sumam daqui bem rápido."

#. Character:`noriko` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_272ec25a"
msgid "J'vais le tuer !"
msgstr "Eu vou matar ele!"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_76433045"
msgid "Un instant... Contrairement à ce que vous pensez, on n'est pas venu ici pour chercher des ennuis."
msgstr "Um momento... Ao contrário do que o senhor pensa, a gente não veio aqui para arrumar encrenca."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_529eaebf"
msgid "Nous sommes seulement passés voir..."
msgstr "Nós só passamos para ver..."

#. Character:`noriko`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_1651643c"
msgid "Ma mère ! Elle travaille ici !"
msgstr "A minha mãe! Ela trabalha aqui!"

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_204d9fe2"
msgid "Oh, je vois ! Tu dois être {{noriko.n}}, la fille de {{yasuka.n}}."
msgstr "Ah, entendi! Você deve ser a {{noriko.n}}, a filha da {{yasuka.n}}."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_a7eeb5c1"
msgid "Il y a effectivement un petit air de famille."
msgstr "Pior que vocês se parecem mesmo."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_10a3b67b"
msgid "Mais peu importe, {{yasuka.n}} a terminé sa pause, il faudra revenir une autre fois."
msgstr "Mas tanto faz, a {{yasuka.n}} já terminou o intervalo dela, vão ter que voltar outra hora."

#. Character:`noriko`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_94068052"
msgid "QUOI ?! Mais..."
msgstr "O QUÊ?! Mas..."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_f82348b6"
msgid "Est-ce qu'on peut entrer et acheter quelque chose ?"
msgstr "Será que a gente pode entrar e comprar alguma coisa?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_675954d9"
msgid "Dis-moi ce que tu veux et je vais te le chercher..."
msgstr "Me diz o que você quer e eu vou buscar para você..."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_03775ec8"
msgid "..."
msgstr "..."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_22325562"
msgid "Non ? Rien ?"
msgstr "Não? Nada?"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_f298d007"
msgid "ALORS, FOUTEZ-MOI LE CAMP !"
msgstr "ENTÃO, VÃO EMBORA DAQUI!"

#. Character:`noriko`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_4fad3cd5"
msgid "Je croyais que tu étais la personne la plus horripilante du monde."
msgstr "Eu achava que você era a pessoa mais insuportável do mundo."

#. Character:`noriko`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_e2cb3a81"
msgid "Mais je pense que j'ai trouvée pire encore..."
msgstr "Mas acho que encontrei alguém ainda pior..."

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_3fbac9ed"
msgid "Merci... Je suppose."
msgstr "Obrigado... Eu acho."

#. Character:`noriko` | Attributes:`shame`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_bc7494f4"
msgid "Et maintenant ?"
msgstr "E agora?"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_ff17a3e2"
msgid "Tant que cette espèce de... sera toujours là, nous ne passerons plus."
msgstr "Enquanto esse tipo de... ainda estiver por aqui, não vamos conseguir passar."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_09694f81"
msgid "Il faudrait une diversion..."
msgstr "Precisamos de uma distração..."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_df45c8a8"
msgid "Bon et bien, j'te laisse réfléchir à tout ça. Moi, je rentre !"
msgstr "Bom, então vou deixar você pensando nisso. Eu vou para casa!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_47e12b3e"
msgid "Il me faut quelqu'un de malin."
msgstr "Eu preciso de alguém esperto."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_3fcb3426"
msgid "Où est-ce que je pourrais trouver ça ?"
msgstr "Onde é que eu poderia encontrar alguém assim?"

#. Character:`kimochi`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_79fc129c"
msgid "Bon, laisse-moi faire. J'ai l'habitude de le gérer."
msgstr "Bom, deixa comigo. Já estou acostumado a lidar com ele."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_1077aafd"
msgid "Tu me sauves la vie !"
msgstr "Você está salvando a minha vida!"

#. Character:`kimochi`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_df254786"
msgid "N'oublie pas que tu m'en dois une."
msgstr "Não esquece que você me deve uma."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_c60cb0ae"
msgid "Je n'oublierai pas !"
msgstr "Não vou esquecer!"

#. Character:`kimochi`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_8b23f999"
msgid "Allez, c'est le moment de briller !"
msgstr "Vamos lá, é a minha hora de brilhar!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_2bcf82ba"
msgid "{{kimochi.n}} ! Tu tombes bien, je pensais justement à toi !"
msgstr "{{kimochi.n}}! Que boa surpresa, eu estava justamente pensando em você!"

#. Character:`kimochi` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_cb8f5e81"
msgid "Oh oh, que puis-je pour mon meilleur client ?"
msgstr "Oh oh, o que posso fazer pelo meu melhor cliente?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_8781cb78"
msgid "Hmm, attends, allons un peu plus loin pour discuter."
msgstr "Hmm, espera, vamos um pouco mais longe para conversar."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_d971d2e2"
msgid "Les derniers Hentai non censurés que tu m'as vendus étaient extraordinaires."
msgstr "Os últimos Hentais sem censura que você me vendeu eram extraordinários."

#. Character:`kimochi`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_6efb83ff"
msgid "Des œuvres d'art, je suis d'accord."
msgstr "Obras de arte, eu concordo."

#. Character:`kimochi`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_f41c0a51"
msgid "Que te faut-il cette fois-ci ?"
msgstr "O que você precisa desta vez?"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_ff0e0376"
msgid "...[w] Tu en as des aussi bons avec des femmes mûres et des hommes... dégoutants ?"
msgstr "...[w] Você tem alguns tão bons quanto aqueles com mulheres maduras e homens... nojentos?"

#. Character:`kimochi`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_d8dd7177"
msgid "Ah, je vois que monsieur est un homme de gout."
msgstr "Ah, vejo que o senhor é um homem de bom gosto."

#. Character:`kimochi`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_97682e23"
msgid "Mais pourquoi ce changement de gouts soudain ? D'habitude les milfs, ce n'est pas ton truc, {{netoru.n}}."
msgstr "Mas por que essa mudança repentina de gosto? Geralmente milfs não fazem o seu tipo, {{netoru.n}}."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_5e74ffee"
msgid "...Mêles-toi de tes oignons ! Tu en as ou pas ?"
msgstr "...Cuide da sua vida! Você tem ou não tem?"

#. Character:`kimochi` | Attributes:`think`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_17aadf73"
msgid "Peut-être... Laisse-moi regarder."
msgstr "Talvez... Deixe-me dar uma olhada."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_21f5520e"
msgid "Alors comme ça... Vous avez des dettes..."
msgstr "Então quer dizer... que vocês têm dívidas..."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_efd7799a"
msgid "Intéressant."
msgstr "Interessante."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_0d935c9c"
msgid "Ça ne vous regarde pas !"
msgstr "Isso não é da sua conta!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_32c02c84"
msgid "Allons, allons, ne soit pas si désagréable."
msgstr "Ora, vamos, não seja tão desagradável."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_cc741bc2"
msgid "Tu sais que j'ai pas mal d'argent de côté..."
msgstr "Você sabe que eu tenho uma boa grana guardada..."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_7faac2e6"
msgid "Je pourrais proposer mon aide pour vous aider à sortir de cette... malheureuse situation."
msgstr "Eu poderia oferecer minha ajuda para tirar vocês dessa... situação lamentável."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_bbe25598"
msgid "...Vous n'avez pas la tête à aider sans rien attendre en retour."
msgstr "...Você não tem cara de quem ajuda os outros sem esperar nada em troca."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_5bce59f7"
msgid "Je suppose que vous voulez des contreparties ?"
msgstr "Eu imagino que você vá querer alguma compensação?"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_ca085e51"
msgid "Des contreparties ?! Mon Dieu, mais quelle façon vulgaire et cynique de voir les choses."
msgstr "Compensação?! Meu Deus, mas que jeito vulgar e cínico de enxergar as coisas."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_ee40d2e0"
msgid "J'appellerai plutôt ça... une offre commerciale."
msgstr "Eu chamaria isso mais de... uma proposta comercial."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_910b7f84"
msgid "{{yasuka.n}} rembourse ses dettes et toi, tu obtiens un nouveau beau-papa."
msgstr "A {{yasuka.n}} quita as dívidas dela e você ganha um padrasto novinho em folha."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "t3d44aad72c"
msgid "Plutôt mourir !"
msgstr "Prefiro morrer!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "t2a53526e89"
msgid "[hint=ROUTE ???]C'est à elle de décider de ça, pas à moi."
msgstr "[hint=ROTA ???]A decisão é dela, não minha."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_17d89edc"
msgid "Haha, les jeunes..."
msgstr "Haha, esses jovens..."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_fb0ec684"
msgid "De toute façon, tu n'as pas ton mot à dire dans cette histoire."
msgstr "De qualquer forma, você não tem direito a dar palpite nessa história."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_d82bb78d"
msgid "Je suis certain d'arriver à la faire craquer..."
msgstr "Tenho certeza de que vou conseguir fazer ela ceder..."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_f4a6a76a"
msgid "Sur ce, à bientôt[w] fiston."
msgstr "Sendo assim, até logo[w], filhão."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_d00ed906"
msgid "Putain !"
msgstr "Filho da puta!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_fd91ba2e"
msgid "J'ai jamais eu autant envie de tuer quelqu'un de ma vie."
msgstr "Nunca tive tanta vontade de matar alguém na minha vida."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_1f4c51e5"
msgid "Je ne peux pas laisser cette ordure arriver à ses fins."
msgstr "Não posso deixar esse lixo conseguir o que quer."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_f8a5baf8"
msgid "C'est fermé !"
msgstr "Está fechado!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_8a85a199"
msgid "Où est-ce qu'elle a pu aller ?"
msgstr "Para onde será que ela foi?"

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_935e7106"
msgid "Tiens, tiens, tiens..."
msgstr "Ora, ora, ora..."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_ce381177"
msgid "{{saito.n}} le déchet."
msgstr "Se não é o fracassado do {{saito.n}}."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_1d2cd101"
msgid "Qu'est-ce que tu viens faire dans ce quartier à une heure pareille ?"
msgstr "O que você veio fazer neste bairro a uma hora dessas?"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_1b12701e"
msgid "Putain, {{akira.n}} !"
msgstr "Puta que pariu, é o {{akira.n}}!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_cb33c666"
msgid "Pourquoi faut-il toujours que je tombe sur des emmerdeurs ?!"
msgstr "Por que eu sempre dou o azar de trombar com esses caras?!"

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_29ed40e1"
msgid "Toujours aussi causant à ce que je vois..."
msgstr "Sempre tagarela desse jeito, pelo que vejo..."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_9275f7dd"
msgid "Ma foi, peu importe. J'ai trouvé un truc qui va faire parler pas mal de monde."
msgstr "Mas enfim, tanto faz. Eu descobri uma parada que vai dar o que falar por aí."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_8ff18caf"
msgid "J'ai croisé ta soi-disant mère en train de marcher avec un putain de gros porc."
msgstr "Eu cruzei com a sua dita mãe andando com a porra de um gordo escroto."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_13aa479f"
msgid "QUOI ?!"
msgstr "O QUÊ?!"

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_473276e2"
msgid "Ils se dirigeaient vers un love hôtel."
msgstr "Eles estavam indo na direção do love hotel."

#. Character:`akira` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_87d03739"
msgid "Je ne savais pas qu'elle se prostituait."
msgstr "Eu não sabia que ela era uma prostituta."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_6893fbfe"
msgid "Si j'avais su, j'aurais fait appel à ses services bien plus tôt !"
msgstr "Se eu soubesse, teria contratado os serviços dela bem antes!"

#. Character:`saito` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_ec421db8"
msgid "ESPÈCE DE..."
msgstr "SEU FILHO DA..."

#. Character:`akira` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_43b14a71"
msgid "Fais attention à ce que tu dis."
msgstr "Cuidado com o que fala."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_25255762"
msgid "Si je dois t'éclater la tête sur le trottoir, je ne me gênerais pas."
msgstr "Se eu tiver que estourar a sua cara na calçada, eu não vou pensar duas vezes."

#. Character:`akira` | Attributes:`arrogant`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_f46181a8"
msgid "À plus tocard !"
msgstr "Até mais, fracassado!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_53bb8ec4"
msgid "Merde, c'est quoi ce délire..."
msgstr "Merda, que porra é essa..."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_5e5d09fd"
msgid "Je refuse de croire un truc pareil."
msgstr "Eu me recuso a acreditar numa idiotice dessas."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_6fd549e4"
msgid "Je dois la retrouver avant qu'il ne soit trop tard."
msgstr "Eu preciso encontrar ela antes que seja tarde demais."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_fcc2f08b"
msgid "J'ai failli attendre !"
msgstr "Quase tive que esperar!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_bb45508a"
msgid "Je suis arrivé en avance !"
msgstr "Eu cheguei adiantado!"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_4efb9256"
msgid "Le travail en lui-même n'est pas compliqué, un enfant de 4 ans pourrait le faire."
msgstr "O trabalho em si não é complicado, uma criança de quatro anos conseguiria fazer."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_172c5dd1"
msgid "Contente-toi d'être serviable, de sourire, de servir les clients, de faire le nettoyage..."
msgstr "Só trate de ser prestativo, sorrir, atender os clientes, fazer a limpeza..."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_66ca2b1e"
msgid "De gérer le stock, de-"
msgstr "Controlar o estoque, além de..."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_626971b4"
msgid "Un enfant de 4 ans pourrait le faire, hein..."
msgstr "Uma criança de quatro anos conseguiria fazer, sei..."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_e6543f74"
msgid "AH ! Tu fais le malin ?"
msgstr "AH! Tá querendo se pagar de espertinho?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_8fbcfade"
msgid "100¥ en moins !"
msgstr "Menos cem ienes!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_03775ec8"
msgid "..."
msgstr "..."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_87b616bf"
msgid "AU BOULOT ESPÈCE DE BRANLEUR !"
msgstr "VÁ TRABALHAR, SEU PUNHETEIRO DO CARALHO!"

#. Character:`centered`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_813d6843"
msgid "{{saito.n}} fit de son mieux toute la journée."
msgstr "{{saito.n}} deu o seu melhor o dia inteirinho."

#. Character:`centered`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_d2857457"
msgid "Mais {{netoru.n}} passa sa journée à le rabaisser et à l'humilier devant les clients."
msgstr "Mas {{netoru.n}} passou o dia diminuindo e humilhando ele na frente dos clientes."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_9065cc7c"
msgid "Allez, ça suffit pour aujourd'hui !"
msgstr "Chega, já deu por hoje!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_afc8b2e7"
msgid "C'était un véritable désastre."
msgstr "Foi um desastre completo."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_038e35e8"
msgid "Vous n'avez pas non plus été vraiment aidant."
msgstr "Você também não ajudou em porra nenhuma."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_314c5d34"
msgid "Voilà ta paye."
msgstr "Aqui está o seu pagamento."

#. Character:`notice`
#: game/story/coffeebar_exterior.dialogue
msgctxt "ta3108b0ad9"
msgid "Vous avez gagné 1500¥."
msgstr "Você recebeu ¥1.500."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_f52f9baf"
msgid "Attendez... C'est trop peu."
msgstr "Espera... Isso é muito pouco."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_cd85e591"
msgid "Et en plus, tu te plains ? Tu as été horrible, j'ai perdu mon temps à t'expliquer comment faire le travail."
msgstr "E você ainda reclama? Você foi péssimo, perdi o meu tempo te explicando como fazer o trabalho."

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_7235f720"
msgid "Mais... C'est à vous de m'expliquer !"
msgstr "Mas... O seu dever era me explicar!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_c7d027f0"
msgid "Et j'ai pris de mon temps pour le faire, et mon temps, c'est de l'argent, donc j'ai déduit mes honoraires de ton salaire."
msgstr "E eu gastei do meu tempo para fazer isso, e meu tempo vale dinheiro, então descontei meus honorários do seu salário."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_8468f4f5"
msgid "Ce mec est pourri jusqu'à la moelle !"
msgstr "Esse cara é podre até a alma!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_bf6d45ef"
msgid "Je n'ai jamais eu autant envie de frapper quelqu'un de ma vie."
msgstr "Nunca tive tanta vontade de meter a mão na cara de alguém na minha vida."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_864ddbef"
msgid "Mais si je fais ça, je suis sûr que je vais avoir encore plus de problèmes qu'avant."
msgstr "Mas se eu fizer isso, tenho certeza de que vou arrumar ainda mais sarna pra me coçar."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_76fa3468"
msgid "ARRÊTE DE RÊVASSER ET TIRE-TOI !"
msgstr "PARA DE FICAR VIAJANDO E SOME DAQUI!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_52f2563a"
msgid "T'AS INTÉRÊT À ÊTRE LA DEMAIN À LA PREMIÈRE HEURE !"
msgstr "É BOM VOCÊ ESTAR AQUI AMANHÃ NO PRIMEIRO HORÁRIO!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_4105bc1c"
msgid "Quelle journée horrible..."
msgstr "Que dia desgraçado..."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_97cd39a3"
msgid "J'espère que {{yasuka.n}} ne subissait pas ça au quotidien."
msgstr "Espero que a {{yasuka.n}} não tivesse que aguentar isso no dia a dia."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_03bd8415"
msgid "Surtout pour un salaire pareil."
msgstr "Ainda mais por uma mixaria dessas de salário."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_a873ad2e"
msgid "Je ferais mieux de rentrer."
msgstr "É melhor eu ir para casa."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_7adbec28"
msgid "Ce n'est pas trop tôt !"
msgstr "Até que enfim!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_7f273282"
msgid "Allez, reste pas planter là et mets-toi au travail tout de suite !"
msgstr "Vamos, não fica aí plantado e vai trabalhar agora mesmo!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_ec330a3f"
msgid "Et ne me regarde pas avec ces yeux !"
msgstr "E não fica me olhando com essa cara!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_879d3fac"
msgid "Tu sais très bien ce qui peut arriver à ta chère protégée si tu déconnes."
msgstr "Você sabe muito bem o que pode acontecer com a sua querida mãezinha se você vacilar."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_c2cffe85"
msgid "..."
msgstr "..."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_3d89609b"
msgid "Parfait, si tu comprends, au boulot et plus vite que ça !"
msgstr "Perfeito, já que entendeu, ao trabalho e anda logo com isso!"

#. Character:`centered`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_c233b205"
msgid "{{saito.n}} passa une journée de plus en enfer à supporter les humiliations."
msgstr "{{saito.n}} passou mais um dia no inferno aguentando humilhações."

#. Character:`centered`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_5c1c08bf"
msgid "Après plusieurs heures à subir, {{saito.n}} estima qu'il avait assez travaillé pour aujourd'hui."
msgstr "Após várias horas engolindo sapo, {{saito.n}} achou que já tinha trabalhado o suficiente por hoje."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_9a363f10"
msgid "Désolé, mais je ne compte pas travailler 16h par jour, surtout pour 1500¥."
msgstr "Desculpe, mas não tô a fim de passar vinte e quatro horas por dia, principalmente por mil e quinhentos ienes."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_37303de5"
msgid "Ah, tu ne veux pas travailler ?"
msgstr "Ah, então você não quer trabalhar?"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_8eafefb4"
msgid "Très bien, aujourd'hui, tu ne toucheras que 500¥."
msgstr "Muito bem, hoje você só vai levar quinhentos ienes."

#. Character:`notice`
#: game/story/coffeebar_exterior.dialogue
msgctxt "tf5b6d671d7"
msgid "Vous avez gagné 500¥."
msgstr "Você recebeu ¥500."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_c2cffe85_1"
msgid "..."
msgstr "..."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_2a18bda4"
msgid "MAINTENANT, TIRE-TOI SALE INGRAT !"
msgstr "AGORA VAZA DAQUI, SEU INFELIZ INGRATO!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_f47c0f82"
msgid "Je ne peux pas continuer de travailler pour ce type plus longtemps."
msgstr "Não posso continuar trabalhando para esse sujeito por mais tempo."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_8585cbda"
msgid "Je gagne trop peu d'argent et ça ne résout pas nos problèmes."
msgstr "Estou ganhando uma miséria e isso não resolve os nossos problemas."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_c98dc509"
msgid "Je vais devoir aller travailler au restaurant si je veux aussi pouvoir aider à rembourser les dettes."
msgstr "Vou ter que ir trabalhar no restaurante se eu quiser ajudar a pagar as dívidas."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_e3ceb2b3"
msgid "J'ai l'impression de retrouver ma vie d'avant et d'enchainer les petits boulots pour survivre..."
msgstr "Tenho a impressão de estar voltando para a minha vida de antes, me desdobrando em bicos para conseguir sobreviver..."

#. Character:`saito` | Attributes:`-upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_3f3b9e95"
msgid "Ça craint."
msgstr "Isso é uma bosta."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_16ce0f73"
msgid "C'EST TOI ! JE SUIS SÛR QUE C'EST TOI !"
msgstr "FOI VOCÊ! TENHO CERTEZA DE QUE FOI VOCÊ!"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_a33b4f89"
msgid "Qu'est-ce que vous me voulez encore ?"
msgstr "O que você quer de mim agora?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_9f2107d7"
msgid "Il y a quelqu'un cette nuit qui est venue s'amuser a sonné chez moi toutes les 10 minutes."
msgstr "Teve alguém esta noite que resolveu brincar de tocar a minha campainha a cada dez minutos."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_d1708ebd"
msgid "C'était toi ! Avoue !"
msgstr "Foi você! Confessa!"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_81d395be"
msgid "Bien sûr que non ! Vous croyez que j'ai que ça à faire de ma soirée ?"
msgstr "É claro que não! Você acha que eu não tenho mais nada para fazer da minha noite?"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_1a36e399"
msgid "Je ne sais même pas où vous habitez."
msgstr "Eu nem sei onde você mora."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_976cd9bf"
msgid "BORDEL ! SI JE CHOPPE CE PETIT CON..."
msgstr "INFERNO! SE EU PEGO AQUELE PIRRALHO..."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_b401678f"
msgid "ARRÊTE DE ME REGARDER ET VA BOSSER FEIGNASSE !"
msgstr "PARA DE FICAR ME OLHANDO E VAI DAR DURO, SEU PREGUIÇOSO!"

#. Character:`centered`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_21ce37b2"
msgid "{{saito.n}} passa à nouveau une journée en enfer."
msgstr "{{saito.n}} passou outro dia no inferno."

#. Character:`centered`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_5c1c08bf_1"
msgid "Après plusieurs heures à subir, {{saito.n}} estima qu'il avait assez travaillé pour aujourd'hui."
msgstr "Após várias horas engolindo sapo, {{saito.n}} achou que já tinha trabalhado o suficiente por hoje."

#. Character:`centered`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_eb62591a"
msgid "Néanmoins, {{saito.n}} constata que le patron était moins virulent que d'habitude."
msgstr "No entanto, {{saito.n}} notou que o patrão estava menos agressivo do que de costume."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_82c0d6ca"
msgid "Allez, casse-toi, je vais fermer la boutique plus tôt aujourd'hui."
msgstr "Vamos, dê o fora, eu vou fechar a loja mais cedo hoje."

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_d6af1694"
msgid "Et mon salaire ?"
msgstr "E o meu pagamento?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_a085b9a7"
msgid "Avec le peu de clients qu'on a eu ?"
msgstr "Com a mixaria de clientes que tivemos?"

#. Character:`notice`
#: game/story/coffeebar_exterior.dialogue
msgctxt "td0239bf2d6"
msgid "Vous avez gagné 200¥."
msgstr "Você recebeu ¥200."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_129a41ef"
msgid "Estime-toi heureux de gagner de l'argent."
msgstr "Dê-se por satisfeito por estar ganhando algum dinheiro."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_ff6e704f"
msgid "Mais bordel... Je gagne plus en ramassant de l'argent par terre !"
msgstr "Mas que inferno... Eu ganho mais catando moedas no chão!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_f3f91756"
msgid "Je n'ai jamais vu un esclavagiste pareil."
msgstr "Eu nunca vi um escravagista desse nível."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_c31dc0cd"
msgid "Même dans ma précédente vie."
msgstr "Nem na minha vida passada."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_cca7d7d2"
msgid "Je ferais mieux d'aller au restaurant. Au moins, la paye est bien meilleure."
msgstr "É melhor eu ir para o restaurante. Pelo menos lá o salário é bem melhor."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_13e38ac5"
msgid "Je suis prêt à commencer ma journée..."
msgstr "Estou pronto para começar o dia..."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_60c27fa8"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_fadf996b"
msgid "Euh... Vous m'entendez ?"
msgstr "Er... Está me ouvindo?"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_87aee577"
msgid "Bordel gamin, me casse pas les couilles."
msgstr "Caralho, moleque, não fode. Não me torra o saco."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_5689fe99"
msgid "Va te mettre au boulot."
msgstr "Vai trabalhar logo."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_23f1158b"
msgid "Ça a empiré, c'est ça ?"
msgstr "As coisas pioraram, não foi?"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_c841105a"
msgid "...[w] J'ai trouvé ma boite aux lettres aspergée de sang ce matin."
msgstr "...[w] Eu encontrei a minha caixa de correio cheia de sangue hoje de manhã."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_a4381e9d"
msgid "Woah, c'est carrément flippant !"
msgstr "Nossa, isso é bizarro pra caralho!"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_993f87c3"
msgid "Tu es content ? Maintenant dégage, je ne suis pas ton pote !"
msgstr "Está feliz agora? Agora vaza, eu não sou seu amigo!"

#. Character:`centered`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_a25ad3a8"
msgid "{{saito.n}} passa pour la première fois une journée à peu près normale."
msgstr "Pela primeira vez, {{saito.n}} teve um dia de trabalho mais ou menos normal."

#. Character:`centered`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_16142624"
msgid "Après quelques heures d'effort, il termina son service."
msgstr "Após algumas horas de esforço, ele terminou o expediente."

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_539d34dc"
msgid "J'ai terminé."
msgstr "Terminei."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_adc08c67"
msgid "Génial, tu veux quoi ? Une médaille pour avoir fait ton travail ?"
msgstr "Grande bosta, quer o quê? Uma medalha por fazer a sua obrigação?"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_b58de3e1"
msgid "...[w]"
msgstr "... "

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_2b07e93c"
msgid "Je suis émotionnellement perturbé, tu peux t'en aller, j'ai besoins de repos."
msgstr "Eu estou abalado psicologicamente, pode ir embora, preciso descansar."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_ccf05981"
msgid "Vous ne comptez pas me payer ?"
msgstr "Você não vai me pagar?"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_5be1c9a2"
msgid "PUTAIN TU ME SAOULES, C'EST À CROIRE QUE VOUS PENSEZ QU'À L'ARGENT !"
msgstr "PUTA QUE PARIU, VOCÊ ME CANSA! PARECE QUE VOCÊS SÓ PENSAM EM DINHEIRO!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_15fa99fc"
msgid "TIRE-TOI ET VITE SALE PROFITEUR !"
msgstr "SOME DAQUI E ANDA LOGO, SEU INTERESSEIRO DOS INFERNOS!"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_98655990"
msgid "Cette espèce d'esclavagiste ne prend même plus la peine de me payer..."
msgstr "Esse escravagista de merda nem se dá mais ao trabalho de me pagar..."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_cc6a9130"
msgid "En même temps, à quoi je m'attendais ?"
msgstr "Mas também, o que eu estava esperando?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_203af949"
msgid "Allez {{saito.n}}, c'est l'heure du service au restaurant !"
msgstr "Vamos lá, {{saito.n}}, hora de dar duro no restaurante!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_0fffff41"
msgid "...encore toi ?!"
msgstr "...Você de novo?!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_48d4f489"
msgid "Qu'est-ce que tu me veux ?"
msgstr "O que você quer comigo?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_15d569af"
msgid "Tu n'en as pas marre de te moquer de moi ?"
msgstr "Não cansou de zombar da minha cara?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_cc0bccd7"
msgid "De vous torturer ?"
msgstr "De zombar da sua cara?"

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_dd28627b"
msgid "Euh... Vous devez faire erreur, je ne suis pas responsable de ça."
msgstr "Er... Você deve estar enganado, eu não tenho nada a ver com isso."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_0bebdcbe"
msgid "La privation de sommeil, le sang dans la boite aux lettres et maintenant les traces de coupures sur le corps quand je me réveille."
msgstr "Primeiro a privação de sono, depois o sangue na caixa de correio, e agora eu acordo cheio de marcas de cortes pelo corpo."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_188d7563"
msgid "Il y a un taré qui veut me tuer !"
msgstr "Tem um psicopata querendo me matar!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_5a59cc5e"
msgid "Appelez la police dans ce cas !"
msgstr "Chame a polícia então!"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_17e5b34d"
msgid "NON !"
msgstr "NÃO!"

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_14a617ab"
msgid "Pourquoi ? Vous avez peur qu'elle trouve des choses compromettantes chez vous ou à la boutique ?"
msgstr "Por quê? Está com medo de que achem coisas erradas na sua casa ou na loja?"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_4ff94e8a"
msgid "..."
msgstr "..."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_f16cdaa6"
msgid "Nous y voilà enfin !"
msgstr "Até que enfim as coisas estão andando!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_65acf4b4"
msgid "Je ne sais pas qui est en train de le traquer, mais ça m'arrange."
msgstr "Não faço ideia de quem está caçando ele, mas está me quebrando um galhão."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_02c95d0c"
msgid "Honnêtement, vu son comportement, il a dû provoquer la personne qu'il ne fallait pas."
msgstr "Sendo sincero, do jeito que ele é escroto, deve ter mexido com a pessoa errada."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_9b9c0a60"
msgid "Il faut que je demande à {{noriko.n}}."
msgstr "Eu preciso perguntar para a {{noriko.n}}."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_f2d7763b"
msgid "Et il faut surtout que j'en profite pour régler cette histoire avec {{yasuka.n}}."
msgstr "E preciso principalmente aproveitar a chance para resolver logo aquela história com a {{yasuka.n}}."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_5f1e7a60"
msgid "Tout ça va continuer et je dirai même que les choses vont s'aggraver."
msgstr "Tudo isso vai continuar, e eu diria até que as coisas tendem a piorar."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_b40a021d"
msgid "Quoi ?! Tu me menaces gamin ?"
msgstr "O quê?! Está me ameaçando, moleque?"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_c8f068c9"
msgid "Doucement, je ne suis pas responsable de ce qui vous arrive."
msgstr "Calma aí, eu não sou o culpado pelo que está te acontecendo."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_8e4c4d40"
msgid "Vous êtes le seul responsable de votre situation."
msgstr "você é o único culpado pela situação em que se encontra."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_5a9de8f4"
msgid "Vous êtes absolument odieux et vous avez dû énerver beaucoup de monde."
msgstr "Você é um cara completamente detestável e deve ter irritado muita gente."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_b0ad906c"
msgid "Probablement la personne qu'il ne fallait pas."
msgstr "Provavelmente a pessoa errada."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_7078d593"
msgid "PUTAIN !"
msgstr "CARALHO!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_3a9ad98b"
msgid "Je vous conseille fortement de corriger votre attitude et de vous excuser auprès de tous ceux à qui vous avez fait du tort."
msgstr "Eu aconselho fortemente que você mude de atitude e peça desculpas a todos que prejudicou."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_1d7dbb87"
msgid "HAHA ! Et puis quoi encore, je préfèrerai plutôt crever !"
msgstr "HAHA! E o que mais? Prefiro morrer do que fazer isso!"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_762108dd"
msgid "Je réussirai à chopper cet enfoiré, et je le tuerai de mes propres mains !"
msgstr "Eu vou pegar esse desgraçado, e vou matar ele com as minhas próprias mãos!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_b1d977df"
msgid "Maintenant, casse-toi, je dois préparer ma défense et je ne te veux pas dans mes pattes !"
msgstr "Agora vaza, preciso preparar a minha defesa e não quero você me atrapalhando!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_3e0a2cd2"
msgid "Je ferais mieux d'aller au restaurant, je parlerais à {{noriko.n}} ce soir."
msgstr "É melhor eu ir para o restaurante, eu falo com a {{noriko.n}} hoje à noite."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_ed9d1ef5"
msgid "Putain, putain, putain, PUTAINNNN !"
msgstr "Merda, merda, merda, MEERRRDAAA!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_1d9780d1"
msgid "MERDE ! J'EN AI RAS LE BOL !"
msgstr "CARALHO! EU NÃO AGUENTO MAIS ISSO!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_dbdaaf76"
msgid "Faites que ça s'arrête par pitié..."
msgstr "Façam isso parar, por favor..."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_4e3e2265"
msgid "Euh, tout va bien ?"
msgstr "Er, está tudo bem?"

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_2376588a"
msgid "NON ! Bien sûr que non, je hurle pour le plaisir."
msgstr "NÃO! Claro que não, eu estou berrando aqui só por esporte!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_45e558f0"
msgid "Je suppose que votre situation a empiré."
msgstr "Deixa eu adivinhar, a sua situação piorou."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_d62674ac"
msgid "Tu n'as même pas idée à quel point !"
msgstr "Você não faz a menor ideia do nível!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_eb1f2b3e"
msgid "Tout ça a complètement dégénéré."
msgstr "Essa porra toda saiu completamente do controle."

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_d169a6db"
msgid "Vous pourriez peut-être envisager de réparer vos erreurs..."
msgstr "Você talvez pudesse cogitar consertar os seus erros..."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_179ba0a0"
msgid "Non ! Je ne veux pas !"
msgstr "Não! Eu me recuso!"

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_1ed9f42a"
msgid "Mais tout ça va continuer, vous le savez..."
msgstr "Mas isso tudo vai continuar, você sabe..."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_4e2d10f8"
msgid "Parfois, il faut s'avouer vaincu et accepter la défaite."
msgstr "Às vezes, a gente tem que aceitar que perdeu e engolir a derrota."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_388d865b"
msgid "Je..."
msgstr "Eu..."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_3ba0e1ec"
msgid "PLUTÔT CREVER !"
msgstr "EU PREFIRO MORRER!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_bc151b92"
msgid "Non, mais je rêve ?!"
msgstr "Não, eu não estou acreditando nisso..."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_1173903f"
msgid "Il s'est barré comme ça en me laissant sur place ?"
msgstr "Ele foi embora correndo e me largou aqui sozinho?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_f614ad2d"
msgid "Du coup, je suppose que je devrais aller à mon vrai travail..."
msgstr "Bom, então acho que vou para o meu emprego de verdade..."

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "talk_ubs_b92aac18"
msgid "Quand même, c'est presque trop beau pour être vrai, toute cette situation qui se résolve d'elle-même."
msgstr "Mas caramba, é bom demais para ser verdade ver essa enrascada toda se resolvendo sozinha."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_d6459a06"
msgid "Tiens, c'est bizarre, il n'est pas dehors pour une fois ?"
msgstr "Ué, que esquisito, pela primeira vez aquele cara não tá aqui fora?"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_3a072529"
msgid "Il est peut-être à l'intérieur."
msgstr "Talvez esteja lá dentro."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_970a3680"
msgid "Alors ? Explique-moi un peu tout ce délire !"
msgstr "E aí? Desenrola e me explica direito essa loucura toda!"

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_18bf55b2"
msgid "Tu ne vas pas avoir des problèmes avec {{minato.n}} si tu me parles ?"
msgstr "Você não vai arrumar treta com a {{minato.n}} se ficar conversando comigo?"

#. Character:`natsume` | Attributes:`pouting`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_062c614c"
msgid "Toujours à te prendre la tête avec les autres, alors que tu ferais mieux de penser à toi..."
msgstr "Você sempre pilhado se preocupando com os outros, devia focar mais em você..."

#. Character:`natsume` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_dd17903c"
msgid "Tu n'as pas à t'inquiéter de ça."
msgstr "Não precisa esquentar a cabeça com isso."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_695f8d91"
msgid "Et puis je ne crois pas avoir demandé d'aide."
msgstr "E outra, que eu saiba eu não pedi ajuda de ninguém."

#. Character:`natsume` | Attributes:`-happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_c74028b1"
msgid "Raconte-moi ce qu'il se passe !"
msgstr "Desembucha e me conta o que está rolando!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_474fe8ef"
msgid "Je crois que je pourrais pas y couper..."
msgstr "Pelo visto eu não vou conseguir escapar dessa..."

#. Character:`natsume` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_667c48f8"
msgid "Tu commences à me connaitre !"
msgstr "Já está começando a me conhecer!"

#. Character:`centered`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_d4f81b19"
msgid "{{saito.n}} lui raconta alors tous les derniers événements."
msgstr "{{saito.n}} contou para ela tudo o que aconteceu ultimamente."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_c4ea87c7"
msgid "Tu en sais autant que moi à présent."
msgstr "Agora você já sabe tanto quanto eu."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_530c8790"
msgid "Tu es un putain d'idiot !"
msgstr "Você é um puta de um otário!"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_347b42c3"
msgid "QUOI ?!"
msgstr "O QUÊ?!"

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_4c7c0dc1"
msgid "Ah bon sang, vous les mecs, vous êtes irrécupérables."
msgstr "Ah, fala sério, vocês homens são todos uns casos perdidos."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_b9444519"
msgid "Elle ne risque rien."
msgstr "Ela não está correndo perigo nenhum."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_b15beab2"
msgid "Mais et {{akira.n}} ?"
msgstr "Mas e o {{akira.n}}?"

#. Character:`natsume` | Attributes:`pouting`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_b1c7288f"
msgid "Pourquoi tu t'inquiètes pour cette petite bite ?"
msgstr "Por que você está encanado com aquele pau fino?"

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_5d6c6e97"
msgid "Ce mec est juste un beau parleur."
msgstr "Aquele cara só tem gogó, é só fachada."

#. Character:`natsume` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_d65fec7a"
msgid "De plus, je connais bien cet établissement...[w] j'y ai déjà travaillé."
msgstr "Sem contar que eu conheço muito bem aquele lugar...[w] eu já trabalhei lá."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_13f7647f"
msgid "Tu as été hôtesse toi aussi ?!"
msgstr "Você também já foi acompanhante?!"

#. Character:`natsume` | Attributes:`pouting`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_fcaf4a57"
msgid "Ça ne te regarde pas !"
msgstr "Isso não é da sua conta!"

#. Character:`natsume` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_929fb880"
msgid "Mais crois-moi qu'ici personne ne touche les femmes à moins d'avoir un compte en banque à 10 chiffres."
msgstr "Mas bota uma coisa na cabeça: lá dentro ninguém encosta a mão nas mulheres a menos que tenha uma conta bancária com uns dez dígitos."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_6754707e"
msgid "Et encore, il faut qu'elles soient consentantes."
msgstr "E olhe lá, porque elas ainda precisam estar a fim."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_03775ec8_1"
msgid "..."
msgstr "..."

#. Character:`natsume` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_5c96e2f9"
msgid "Et puis fais-lui confiance un peu !"
msgstr "Então vê se confia um pouco nela!"

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_646651a2"
msgid "Elle semble faire ça pour vous sortir des emmerdes, pas pour s'amuser avec le premier gamin venu !"
msgstr "Dá para ver que ela está fazendo isso para tirar vocês da merda, não para ficar de safadeza com qualquer moleque que aparece!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_ccbf63c0"
msgid "T'es douée..."
msgstr "Você é boa nisso..."

#. Character:`natsume` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_1c43d75b"
msgid "Précise, y'a un tas de domaine ou j'excelle et certains sont confidentiels."
msgstr "Especifica aí, porque tem um monte de áreas em que eu sou foda, e algumas delas são segredo de estado."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_0136f5be"
msgid "Pour me rassurer."
msgstr "Em me acalmar."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_a703dd82"
msgid "Pff, idiot."
msgstr "Pff, bobo."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_883859e7"
msgid "Tiens, tu veux passer une bonne nuit ?"
msgstr "A propósito, quer passar uma noite gostosa?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_3b2b21f9"
msgid "Euh... C'est une proposition ou... ?"
msgstr "Espera... Você tá me dando mole ou eu entendi errado...?"

#. Character:`natsume` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_1ad1aa52"
msgid "Mais quel pervers, tu veux qu'on se fasse un plan à 3 avec {{asami.n}} ?"
msgstr "Mas que mente poluída, você quer que a gente faça um ménage com a {{asami.n}}?"

#. Character:`natsume` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_d1834a96"
msgid "Je me doute que tu aimerais bien mais..."
msgstr "Eu imagino que você ia adorar, mas..."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_0b704b5e"
msgid "C'était juste une blague."
msgstr "Era só zoeira."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_86a5c6d7"
msgid "Mais je peux pas t'en vouloir d'avoir cette idée en tête."
msgstr "Mas não dá nem para te culpar por ficar viajando nessa ideia."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_727a6aa3"
msgid "Deux filles sexy rien que pour toi."
msgstr "Duas garotas gatas todinhas para você."

#. Character:`natsume` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_10b487bb"
msgid "Le rêve de tout homme."
msgstr "O sonho de todo homem."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "te241345fa8"
msgid "Mais carrément !"
msgstr "Mas com certeza!"

#. Character:`natsume` | Attributes:`pouting`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_53f02ddb"
msgid "Mince, moi qui croyais que t'allais tomber dans le panneau."
msgstr "Putz, e eu achando que você ia cair direitinho na minha pegadinha."

#. Character:`natsume` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_47300511"
msgid "Mais dans d'autres circonstances... Je n'aurais pas dit non."
msgstr "Mas dependendo da situação... eu não acharia uma má ideia."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_87f3025e"
msgid "Mais à présent, tu es coincée, impossible pour toi de savoir si je suis sarcastique ou pas."
msgstr "Só que agora você ficou na mão, e vai ser impossível saber se eu estava sendo sarcástica ou não."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "tdaaab64bcf"
msgid "Arrête de te foutre de moi."
msgstr "Para de tirar sarro da minha cara."

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_146f8a9c"
msgid "Arrête de te foutre de moi."
msgstr "Dá para parar de me sacanear."

#. Character:`natsume` | Attributes:`pouting`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_82e66687"
msgid "Rho, allez le prend pas mal, je te promets que toi et moi, on se fera un truc ensemble !"
msgstr "Ah, qual é, não fica bravinho não. Eu prometo que a gente ainda vai fazer alguma coisa juntos!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_c2273609"
msgid "C'est encore une de tes blagues ?"
msgstr "Isso é mais uma das suas brincadeiras?"

#. Character:`natsume` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_57ea6d42"
msgid "Seul le temps le dira."
msgstr "Só o tempo dirá."

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_a4f2f05a"
msgid "Allez... Oublie un peu ton pénis et viens avec moi par ici, ça ne devrait plus tarder."
msgstr "Vamos logo... Esquece um pouco o seu pau e vem comigo por aqui, não deve demorar muito."

#. Character:`saito` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_4a36b24f"
msgid "Qu'est-ce que tu veux me montrer ?"
msgstr "O que você quer me mostrar?"

#. Character:`natsume`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_7765e384"
msgid "Quelque chose qui te donnera le sourire !"
msgstr "Algo que vai te arrancar um belo sorriso!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_39146d15"
msgid "Putain, ils veulent vraiment ma peau."
msgstr "Porra, eles querem mesmo a minha pele."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_c5cef682"
msgid "Mon seul espoir, c'est cette boutique."
msgstr "A minha única esperança é essa loja."

#. Character:`nobu`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_f660aabd"
msgid "ENFIN !"
msgstr "ATÉ QUE ENFIM!"

#. Character:`nobu`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_72e9885f"
msgid "IL EST COINCÉ !"
msgstr "ELE ESTÁ ENCURRALADO!"

#. Character:`takeo`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_9ff56d5a"
msgid "Putain, ferme ta gueule, laisse nous reprendre notre souffle."
msgstr "Caralho, cala a boca e deixa a gente recuperar o fôlego."

#. Character:`kenji` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_5545f95c"
msgid "De toute façon ça tombe bien, je boirai bien un truc !"
msgstr "De qualquer forma, veio em boa hora, eu bem que tomaria alguma coisa!"

#. Character:`nobu`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_6fcc4016"
msgid "Non, on le défonce d'abord !"
msgstr "Não, primeiro a gente desce o cacete nele!"

#. Character:`takeo`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_b1b72ed6"
msgid "Tu vois quand tu veux !"
msgstr "Viu só? É só você querer!"

#. Character:`kenji` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_cd693907"
msgid "Tu nous as bien fait perdre notre temps aujourd'hui, alors que tout ça aurait pu être terminé rapidement."
msgstr "Você fez a gente perder o maior tempo hoje, sendo que tudo isso podia ter acabado bem mais rápido."

#. Character:`nobu`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_14989668"
msgid "Laissez-moi lui en mettre une !"
msgstr "Deixa eu dar um soco na cara dele!"

#. Character:`kenji` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_cf7eb2cb"
msgid "Non, {{akira.n}} nous attend depuis bien trop longtemps, on risque d'avoir encore plus d'emmerdes."
msgstr "Não, o {{akira.n}} já está esperando a gente faz um tempão, corremos o risco de arrumar ainda mais encrenca."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_732f8a10"
msgid "J'ai plus le choix à présent."
msgstr "Agora eu não tenho mais escolha."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_845c8f58"
msgid "Je dois attendre la bonne occasion."
msgstr "Tenho que esperar a oportunidade certa."

#. Character:`nobu` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_257c6d4d"
msgid "Fait chier !"
msgstr "Que saco!"

#. Character:`takeo`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_e8a8eed1"
msgid "Dépêchons-nous de le rejoindre au dojo."
msgstr "Vamos logo encontrar ele no dojo."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_bdec40fa"
msgid "Bon... Ce type me laissera dans la merde quoi qu'il arrive."
msgstr "Bom... Esse cara vai me deixar na merda aconteça o que acontecer."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_5420d6bd"
msgid "Mais j'ai l'impression qu'il ne me dit pas tout."
msgstr "Mas tenho a impressão de que ele não está me contando tudo."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_601436bf"
msgid "Tiens, tiens, qui voilà..."
msgstr "Olha só, quem está por aqui..."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_11aa6672"
msgid "Qu'est-ce que tu veux encore ?"
msgstr "O que você quer dessa vez?"

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_12e58909"
msgid "Tu ne pourras pas éternellement te cacher derrière ce gros porc."
msgstr "Você não vai conseguir se esconder atrás daquele gordo escroto para sempre."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_9ce74ffa"
msgid "Il arrivera bien à un moment où tu te retrouveras seul."
msgstr "Uma hora ou outra você vai acabar ficando sozinho."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_d31cc6ee"
msgid "Et ce jour-là... Tu vas prendre cher."
msgstr "E nesse dia... você vai se ferrar feio."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_8a4c9e66"
msgid "Et puis... Je n'oublie pas qui-tu-sais."
msgstr "E além do mais... eu não esqueci da sua mãezinha."

#. Character:`akira`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_7dab334d"
msgid "Je la baiserai. Tu peux me croire !"
msgstr "Eu vou comer ela. Pode escrever!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_a3c55d3d"
msgid "Ah, je rêverai de lui éclater la gueule une bonne fois pour toutes."
msgstr "Ah, eu daria tudo para quebrar a cara dele de uma vez por todas."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_0307b665"
msgid "Je suis certain qu'il prépare un sale coup."
msgstr "Tenho certeza de que ele está armando alguma sujeira."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "coffeebar_exterior_9210d93f"
msgid "Je dois avertir {{yasuka.n}} de faire attention a {{akira.n}}."
msgstr "Preciso avisar a {{yasuka.n}} para tomar muito cuidado com o {{akira.n}}."

#. Character:`saito` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "IL_ME_SEMBLE_QUE_C_EST_ICI_7F0131"
msgid "Il me semble que c'est ici."
msgstr "Se não me engano, é aqui."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "DE_TOUTE_FA_ON_C_EST_LA_SEULE_06661A"
msgid "De toute façon, c'est la seule boutique de ce style du quartier, impossible de se tromper."
msgstr "De qualquer forma, é a única loja desse estilo no bairro, impossível errar."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "JE_NE_CROIS_PAS_TRE_D_J_VENU_I_617290"
msgid "Je ne crois pas être déjà venu ici auparavant."
msgstr "Acho que nunca estive aqui antes."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "HEY_ARR_TE_DE_TRA_NER_DEVANT_M_F6A760"
msgid "Hey ! Arrête de traîner devant ma boutique et tire-toi !"
msgstr "Ei! Para de vadiar na frente da minha loja e rala daqui!"

#. Character:`narrator` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "WOAH_C_EST_QUI_LUI_68F4B2"
msgid "Woah ! C'est qui lui ?!"
msgstr "Eita! Quem é esse cara?!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "UNE_MINUTE_BOSS_4D2C06"
msgid "Une minute... Boss ?"
msgstr "Espera aí... Boss?"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "C_EST_LUI_SON_PATRON_BB84CE"
msgid "C'est lui son patron ?"
msgstr "Esse é o chefe dela?"

#. Character:`narrator` | Attributes:`guilty`
#: game/story/coffeebar_exterior.dialogue
msgctxt "BON_SANG_JE_COMPRENDS_MIEUX_PO_3E8476"
msgid "Bon sang, je comprends mieux pourquoi {{yasuka.n}} semblait si réticente à l'idée de retourner travailler."
msgstr "Caramba, agora eu entendo melhor por que a {{yasuka.n}} parecia tão relutante com a ideia de voltar a trabalhar."

#. Character:`narrator` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "NON_NE_JUGEONS_PAS_TROP_VITE_M_3EE05D"
msgid "Non... Ne jugeons pas trop vite, {{macumba.n}} était aussi effrayant aux premiers abords mais il avait un cœur d'or."
msgstr "Não... Não vamos julgar tão rápido, o {{macumba.n}} também era assustador de início, mas tinha um coração de ouro."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "LAISSONS_LUI_SA_CHANCE_763479"
msgid "Laissons-lui sa chance."
msgstr "Vamos dar uma chance a ele."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "HEY_LE_DEMEUR_8189AF"
msgid "Hey, le demeuré !"
msgstr "Ei, seu retardado!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "TIRE_TOI_DE_L_OU_J_APPELLE_LA_50D806"
msgid "Tire-toi de là ou j'appelle la police ? T'es bouché ou quoi ?"
msgstr "Cai fora daqui ou quer que eu chame a polícia? Tá surdo ou o quê?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "ICI_C_EST_POUR_MES_CLIENTS_UNI_FC578F"
msgid "Ici c'est pour mes clients uniquement."
msgstr "Aqui é só para os meus clientes."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "MAIS_JE_SUIS_JUSTEMENT_UN_CLIE_791222"
msgid "Mais je suis justement un client !!"
msgstr "Mas eu sou justamente um cliente!!"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_exterior.dialogue
msgctxt "W_MOUAIS_T_AS_LA_T_TE_DE_QUEL_10FDFC"
msgid "...[w] Mouais, t'as la tête de quelqu'un de fauché."
msgstr "...[w] É, você tem bem a cara de quem tá zerado."

#. Character:`narrator` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "MAIS_QUEL_PUTAIN_DE_B_TARD_FCA6EE"
msgid "Mais quel putain de bâtard !"
msgstr "Mas que baita filho da puta!"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "BON_JE_SUIS_VENU_POUR_ELLE_OUB_1997AA"
msgid "Bon, je suis venu pour elle, oublions ce gros connard."
msgstr "Bom, eu vim por ela, deixa esse babaca de lado."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "BONJOUR_MONSIEUR_CCCA48"
msgid "Bonjour Monsieur."
msgstr "Bom dia, senhor."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_exterior.dialogue
msgctxt "EH_BIEN_CE_N_EST_PAS_TROP_T_T_7C3A3A"
msgid "Eh bien ce n'est pas trop tôt, allez donc me préparer un café."
msgstr "Ora, até que enfim, vá logo me preparar um café."

#. Character:`yasuka`
#: game/story/coffeebar_exterior.dialogue
msgctxt "JE_VOUS_APPORTE_A_TOUT_DE_SUIT_046DBF"
msgid "Je vous apporte ça tout de suite."
msgstr "Vou trazer para o senhor num instante."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "W_UN_INSTANT_0D87FF"
msgid "...[w] Un instant !"
msgstr "...[w] Um momento!"

#. Character:`yasuka`
#: game/story/coffeebar_exterior.dialogue
msgctxt "OUI_D2DD58"
msgid "Oui ?"
msgstr "Sim?"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "TOUT_VA_BIEN_FDFFA0"
msgid "Tout va bien ?"
msgstr "Está tudo bem?"

#. Character:`yasuka`
#: game/story/coffeebar_exterior.dialogue
msgctxt "OUI_JE_JE_VAIS_BIEN_MERCI_DE_686D45"
msgid "... Oui, je... je vais bien, merci de vous inquiéter pour moi."
msgstr "... Sim, eu... eu estou bem, obrigada por se preocupar comigo."

#. Character:`yasuka`
#: game/story/coffeebar_exterior.dialogue
msgctxt "ENCORE_TOUTES_MES_EXCUSES_POUR_40B744"
msgid "Encore toutes mes excuses pour mon retard."
msgstr "Mais uma vez peço desculpas pelo meu atraso."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "VOUS_N_TES_PAS_EN_RETARD_YASUK_998915"
msgid "Vous n'êtes pas en retard {{yasuka.n}}, vous êtes toujours en avance."
msgstr "Você não está atrasada, {{yasuka.n}}, você está sempre adiantada."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "SERVEZ_VOUS_UNE_TASSE_DE_TH_OU_1F4B6D"
msgid "Servez-vous une tasse de thé ou un café, cela vous fera du bien."
msgstr "Sirva-se de uma xícara de chá ou um café, vai te fazer bem."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "OH_JE_MERCI_BEAUCOUP_MONSIEUR_B677F8"
msgid "Oh... je... Merci beaucoup Monsieur."
msgstr "Oh... eu... Muito obrigada, senhor."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "ELLE_N_EST_VRAIMENT_PAS_COMME_224B21"
msgid "Elle n'est vraiment pas comme d'habitude."
msgstr "Ela realmente não está como de costume."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "ELLE_QUI_D_HABITUDE_EST_TOUJOU_5E5159"
msgid "Elle qui d'habitude est toujours si souriante..."
msgstr "Ela, que costuma estar sempre tão sorridente..."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "IL_Y_A_PEUT_TRE_QUELQUE_CHOSE_6ACFCF"
msgid "Il y a peut-être quelque chose à en tirer."
msgstr "Talvez dê para tirar algum proveito disso."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "YASUKA_N_JE_SAIS_QUE_PARFOIS_8FE735"
msgid "{{yasuka.n}} je sais que parfois je me montre assez dur avec vous mais j'ai beaucoup apprécié le fait que vous vous soyez confiée à moi."
msgstr "{{yasuka.n}}, eu sei que às vezes sou meio duro com você, mas gostei muito do fato de você ter desabafado comigo."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "OH_JE_JE_SUIS_D_SOL_E_C_EST_QU_C504D2"
msgid "Oh je... Je suis désolée... C'est que vous paraissiez si intimidant auparavant que je n'osais pas..."
msgstr "Oh, eu... Me desculpe... É que o senhor parecia tão intimidador antes que eu não ousava..."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "J_AI_CONSCIENCE_QUE_JE_NE_SUIS_829781"
msgid "J'ai conscience que je ne suis pas parfait, je tâcherai de corriger certains de mes travers à l'avenir."
msgstr "Eu tenho consciência de que não sou perfeito, vou tentar corrigir alguns dos meus defeitos no futuro."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "JE_VOUS_SOUHAITE_UNE_BONNE_SOI_FBB684"
msgid "Je vous souhaite une bonne soirée."
msgstr "Te desejo uma boa noite."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "VOUS_AUSSI_MONSIEUR_BONSOIR_E_F80079"
msgid "À vous aussi Monsieur, bonsoir et à demain !"
msgstr "Para o senhor também, boa noite e até amanhã!"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "BIEN_VOYONS_O_CETTE_NOUVELLE_A_B712D2"
msgid "Bien... Voyons où cette nouvelle approche pourra nous mener, je le sens bien cette fois-ci."
msgstr "Bom... Vamos ver onde essa nova abordagem vai dar, estou com um bom pressentimento desta vez."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "BONJOUR_JE_CONSTATE_QUE_VOUS_A_9BBB50"
msgid "Bonjour... Je constate que vous avez retrouvé le sourire, cela vous va beaucoup mieux."
msgstr "Bom dia... Vejo que recuperou o sorriso, combina muito mais com você."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "OUI_MERCI_UNE_GROSSE_PARTIE_DE_021EEA"
msgid "Oui, merci. Une grosse partie de mon fardeau à été allégée."
msgstr "Sim, obrigada. Grande parte do meu fardo foi aliviada."

#. Character:`yasuka`
#: game/story/coffeebar_exterior.dialogue
msgctxt "JE_ME_SENT_BIEN_MOINS_OPPRESS_0C168F"
msgid "Je me sens bien moins oppressée."
msgstr "Me sinto bem menos sufocada."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "VOUS_M_EN_VOYEZ_RAVIS_DANS_CE_35A41A"
msgid "Vous m'en voyez ravi dans ce cas."
msgstr "Fico muito contente em saber disso."

#. Character:`yasuka`
#: game/story/coffeebar_exterior.dialogue
msgctxt "JE_VAIS_DE_CE_PAS_COMMENCER_MO_7A635F"
msgid "Je vais de ce pas commencer mon service !"
msgstr "Vou começar o meu expediente agora mesmo!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "NE_TE_PR_CIPITE_PAS_NETORU_N_P_D7AD2F"
msgid "Ne te précipite pas {{netoru.n}}... Petit à petit... Gagne sa confiance..."
msgstr "Não tenha pressa, {{netoru.n}}... Um passo de cada vez... Ganhe a confiança dela..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "ATTENDS_8A0D96"
msgid "Attends !"
msgstr "Espera!"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "SAITO_N_MON_CH_RI_QU_EST_CE_Q_203F24"
msgid "{{saito.n}} ? Mon chéri, qu'est-ce que tu fais là ? Il y a un problème ?"
msgstr "{{saito.n}}? Querido, o que está fazendo aqui? Aconteceu algum problema?"

#. Character:`saito` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "J_AVAIS_BESOIN_DE_TE_PARLER_AV_774F45"
msgid "J'avais besoin de te parler avant que tu n'ailles travailler."
msgstr "Eu precisava falar com você antes de você ir trabalhar."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "OH_PARDON_JE_SUIS_PARTIE_EN_AV_5D812E"
msgid "Oh pardon, je suis partie en avance ce matin sans même te dire au revoir."
msgstr "Ah, desculpe, saí adiantada hoje de manhã sem nem me despedir de você."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "QU_EST_CE_QUE_TU_VOULAIS_ME_DI_4AA97C"
msgid "Qu'est-ce que tu voulais me dire ?"
msgstr "O que queria me dizer?"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "JE_VOULAIS_SIMPLEMENT_TE_DIRE_B264BE"
msgid "Je voulais simplement... te dire de faire attention à toi."
msgstr "Eu só queria... te falar para tomar cuidado."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "IL_N_Y_A_PAS_SI_LONGTEMPS_TU_D_81E82D"
msgid "Il n'y a pas si longtemps tu détestais ton travail et ton patron."
msgstr "Não faz muito tempo que você detestava o seu trabalho e o seu patrão."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "C_EST_VRAI_349545"
msgid "C'est vrai..."
msgstr "É verdade..."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "SON_ATTITUDE_ENVERS_TOI_SEMBLE_5A5B0C"
msgid "Son attitude envers toi semble avoir changé du jour au lendemain et..."
msgstr "A atitude dele com você parece ter mudado da noite para o dia e..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "O_VEUX_TU_EN_VENIR_EXACTEMENT_2CE5C7"
msgid "Où veux-tu en venir exactement ?"
msgstr "Aonde exatamente você quer chegar?"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "JE_JE_PENSE_QU_IL_A_QUELQUE_CH_FF18B0"
msgid "Je... je pense qu'il a quelque chose derrière la tête..."
msgstr "Eu... eu acho que ele está tramando alguma coisa..."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "COMMENT_A_JE_NE_COMPRENDS_PAS_87457C"
msgid "Comment ça ? Je ne comprends pas."
msgstr "Como assim? Não estou entendendo."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "W_TU_ES_UNE_FEMME_MAGNIFIQUE_D43A17"
msgid "...[w] Tu es une femme magnifique et je pense que ses intentions ne sont pas aussi nobles qu'il le prétend."
msgstr "...[w] Você é uma mulher maravilhosa e acho que as intenções dele não são tão nobres quanto ele diz."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_exterior.dialogue
msgctxt "OH_MON_CH_RI_C_EST_VRAI_TU_ME_140579"
msgid "Oh mon chéri... C'est vrai ? Tu me trouves magnifique ?"
msgstr "Ah, querido... É sério? Você me acha maravilhosa?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/coffeebar_exterior.dialogue
msgctxt "EUH_OUI_MAIS_C_EST_SURTOUT_QUE_0E9150"
msgid "Euh.. Oui... Mais c'est surtout que..."
msgstr "Er.. Sim... Mas é que, na verdade..."

#. Character:`yasuka`
#: game/story/coffeebar_exterior.dialogue
msgctxt "MERCI_DE_VEILLER_SUR_MOI_2C15FF"
msgid "Merci de veiller sur moi !"
msgstr "Obrigada por cuidar de mim!"

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "IL_Y_A_UN_PROBL_ME_A537FB"
msgid "Il y a un problème ?"
msgstr "Algum problema aqui?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "PAS_DU_TOUT_MON_CHER_SAITO_N_M_DBB3ED"
msgid "Pas du tout, mon cher {{saito.n}} m'accompagnait au travail."
msgstr "Nenhum, o meu garoto só estava me acompanhando até o trabalho."

#. Character:`yasuka`
#: game/story/coffeebar_exterior.dialogue
msgctxt "PASSE_UNE_BONNE_JOURN_E_MON_CH_FD3F31"
msgid "Passe une bonne journée mon chéri."
msgstr "Tenha um bom dia, querido."

#. Character:`saito` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "TOI_AUSSI_9E1902"
msgid "Toi aussi..."
msgstr "Você também..."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "JE_PEUX_SAVOIR_POURQUOI_TU_RES_11F997"
msgid "Je peux savoir pourquoi tu restes encore planté là ?"
msgstr "Posso saber por que você ainda está plantado aí?"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "J_AI_LE_DROIT_JE_SUIS_INQUIET_AC09CF"
msgid "J'ai le droit, je suis inquiet donc je veille sur elle."
msgstr "Eu tenho o direito, estou preocupado, então estou de olho nela."

#. Character:`netoru` | Attributes:`bad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "TU_N_AS_PAS_TE_PR_OCCUPER_DE_A_656EE6"
msgid "Tu n'as pas à te préoccuper de ça, je vais prendre soin d'elle à présent."
msgstr "Você não tem que se meter nisso, eu vou cuidar dela de agora em diante."

#. Character:`saito` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "MAIS_4EEE0F"
msgid "Mais !"
msgstr "Mas!"

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/coffeebar_exterior.dialogue
msgctxt "NE_VA_PAS_LUI_METTRE_DES_ID_ES_4F916F"
msgid "Ne va pas lui mettre des idées saugrenues dans la tête ou lui faire croire qu'avec un peu de bonne volonté tout finira par s'arranger."
msgstr "Não vá encher a cabeça dela de caraminholas ou fazê-la acreditar que com um pouco de boa vontade tudo vai se resolver."

#. Character:`netoru`
#: game/story/coffeebar_exterior.dialogue
msgctxt "NOUS_NE_VIVONS_PAS_DANS_UN_MON_C8F26E"
msgid "Nous ne vivons pas dans un monde de bisounours !"
msgstr "Nós não vivemos num conto de fadas!"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/coffeebar_exterior.dialogue
msgctxt "DE_PLUS_JE_PENSE_QU_ELLE_A_D_J_119E49"
msgid "De plus, je pense qu'elle a déjà bien assez à penser à comment rembourser sa dette et avoir quelqu'un comme toi qui lui traîne constamment autour ne va pas l'aider."
msgstr "Além do mais, acho que ela já tem muito em que pensar sobre como pagar a dívida dela, e ter alguém como você toda hora por perto não vai ajudar em nada."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/coffeebar_exterior.dialogue
msgctxt "TON_GE_J_TAIS_D_J_IND_PENDANT_9AA367"
msgid "À ton âge, j'étais déjà indépendant et j'avais mon propre appart ! Pendant combien de temps vas-tu encore être un poids pour elle ?"
msgstr "Na sua idade, eu já era independente e tinha o meu próprio apartamento! Por quanto tempo você ainda vai ser um peso para ela?"

#. Character:`saito` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "AUSSI_LONGTEMPS_QUE_N_CESSAIRE_07C0FB"
msgid "Aussi longtemps que nécessaire pour la protéger des gens qui pourraient avoir des intentions mal placées."
msgstr "Pelo tempo que for necessário para protegê-la de pessoas que possam ter segundas intenções."

#. Character:`netoru` | Attributes:`angry`
#: game/story/coffeebar_exterior.dialogue
msgctxt "C_EST_CE_QU_ON_VERRA_A43AE3"
msgid "C'est ce qu'on verra..."
msgstr "É o que vamos ver..."

#. Character:`narrator` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "ELLE_N_A_PAS_L_AIR_D_TRE_L_ET_8E86D6"
msgid "Elle n'a pas l'air d'être là, et je ne l'ai pas croisée sur le chemin du retour."
msgstr "Ela não parece estar aqui, e eu não cruzei com ela no caminho de volta."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "PEUT_TRE_QUE_JE_L_AI_VRAIMENT_4D60D0"
msgid "Peut être que je l'ai vraiment ratée ?"
msgstr "Será que eu realmente me desencontrei dela?"

#. Character:`narrator` | Attributes:`upset`
#: game/story/coffeebar_exterior.dialogue
msgctxt "BON_JE_FAIS_QUOI_PR_SENT_C82DCB"
msgid "Bon je fais quoi à présent ?"
msgstr "Bom, o que eu faço agora?"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "JE_DEVRAIS_PEUT_TRE_PASSER_UN_DB7539"
msgid "Je devrais peut être passer un peu de temps avec {{asami.n}} ?"
msgstr "Talvez eu devesse passar um tempo com a {{asami.n}}?"

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "CONTINUER_CHERCHER_7BBAAA"
msgid "Continuer à chercher."
msgstr "Continuar procurando."

#. Character:`narrator`
#: game/story/coffeebar_exterior.dialogue
msgctxt "PASSER_DU_TEMPS_AVEC_ASAMI_N_6E3BC0"
msgid "Passer du temps avec {{asami.n}}"
msgstr "Passar um tempo com a {{asami.n}}."

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/coffeebar_exterior.dialogue
msgctxt "OHLALA_MON_DIEU_QU_EST_CE_QUE_B889AB"
msgid "Ohlala ! Mon dieu qu'est-ce que j'ai fait ?!"
msgstr "Nossa! Meu Deus, o que foi que eu fiz?!"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "VOUS_AVEZ_SIMPLEMENT_PRIS_LA_B_754A95"
msgid "Vous avez simplement pris la bonne décision."
msgstr "Você simplesmente tomou a decisão certa."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/coffeebar_exterior.dialogue
msgctxt "PEUT_TRE_MAIS_PR_SENT_JE_N_AI_A3B336"
msgid "Peut-être... mais à présent je n'ai plus de travail... Et je suis certaine qu'il fera tout ce qu'il peut pour ternir ma réputation afin que je ne sois plus embauchée nulle part."
msgstr "Talvez... mas agora estou sem trabalho... E tenho certeza de que ele vai fazer de tudo para queimar o meu filme para eu não ser contratada em lugar nenhum."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/coffeebar_exterior.dialogue
msgctxt "J_AI_PEUT_TRE_UNE_SOLUTION_VOU_BEE4D7"
msgid "J'ai peut-être une solution à vous proposer..."
msgstr "Eu talvez tenha uma solução para te propor..."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/coffeebar_exterior.dialogue
msgctxt "TOI_VRAIMENT_453E1C"
msgid "Toi ? Vraiment ?"
msgstr "Você tem? Sério?"

#. Character:`sakuya`
#: game/story/coffeebar_exterior.dialogue
msgctxt "BIEN_S_R_NE_POSEZ_PAS_DE_QUEST_0C3F66"
msgid "Bien sûr. Ne posez pas de questions et suivez-moi."
msgstr "Claro. Não faça perguntas e me siga."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/coffeebar_exterior.dialogue
msgctxt "DE_TOUTE_FA_ON_JE_N_AI_PLUS_GR_66333C"
msgid "De toute façon, je n'ai plus grand-chose à perdre !"
msgstr "De qualquer forma, eu não tenho mais muito a perder!"

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "INSTALLONS_QUELQUES_AFFICHES_I_2C6F6D"
msgid "Installons quelques affiches ici."
msgstr "Vamos colar alguns cartazes por aqui."

#. Character:`saito`
#: game/story/coffeebar_exterior.dialogue
msgctxt "BON_A_DEVRAIT_SUFFIRE_POUR_ICI_DEBD5B"
msgid "Bon, ça devrait suffire pour ici, allons voir du côté du konbini."
msgstr "Bom, isso deve bastar por aqui, vamos ver lá perto da loja de conveniência."

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_038c169c"
msgid "Nous y sommes !"
msgstr "Chegamos!"

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_a506492f"
msgid "Alors ? Plutôt charmant comme endroit, non ?"
msgstr "E então? Um lugar bem bonito, não acha?"

#. Character:`saito` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_469fb1c1"
msgid "Je... Oui, je ne connaissais pas du tout cet endroit."
msgstr "Eu... Sim, eu não fazia a menor ideia de que este lugar existia."

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_99876f18"
msgid "Il s'agit d'un hôtel traditionnel, géré par ma famille du côté maternel depuis des centaines d'années."
msgstr "É um hotel tradicional, administrado pela família da minha mãe há centenas de anos."

#. Character:`saito`
#: game/story/onsen_exterior.dialogue
msgctxt "UNE_SECONDE_C_EST_PAS_ICI_QUE_A502D5"
msgid "Une seconde, c'est pas ici que {{yasuka.n}} a trouvé du travail ?"
msgstr "Espera aí, não foi aqui que a {{yasuka.n}} conseguiu emprego?"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "C_EST_EXACT_C_EST_MOI_QUI_LUI_D70C3E"
msgid "C'est exact, c'est moi qui lui ai donné. Tu t'inquiétais tellement pour elle que ça me brisait le cœur de te voir comme ça..."
msgstr "Isso mesmo, fui eu que dei a vaga para ela. Você estava tão preocupado com ela que partia o meu coração te ver daquele jeito..."

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "ET_PUIS_QUI_SAIT_CE_QUI_AURAIT_CB39BD"
msgid "Et puis qui sait ce qui aurait pu lui arriver si elle était restée avec ce gros porc ?"
msgstr "E quem sabe o que poderia ter acontecido com ela se continuasse com aquele porco gordo?"

#. Character:`saito` | Attributes:`sad`
#: game/story/onsen_exterior.dialogue
msgctxt "MERCI_C28E73"
msgid "Merci..."
msgstr "Obrigado..."

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "DE_RIEN_MON_AMOUR_TU_SAIS_QUE_9D0049"
msgid "De rien mon amour, tu sais que je ferais tout pour toi..."
msgstr "De nada, meu amor. Você sabe que eu faria qualquer coisa por você..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/onsen_exterior.dialogue
msgctxt "A_VOUS_APPARTIENT_DEPUIS_AUSS_07CA8F"
msgid "Ça vous appartient depuis aussi longtemps ?"
msgstr "Isso pertence a vocês há tanto tempo assim?"

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_e639cd57"
msgid "Oui ![w] Ce qui fait le charme de cet endroit, c'est surtout sa source chaude exclusive..."
msgstr "Sim![w] O que traz todo a beleza para cá é principalmente a nossa fonte termal exclusiva..."

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_12735cd9"
msgid "Mais, ce n'est que l'un des nombreux atouts de cet établissement."
msgstr "Mas esse é só um dos muitos pontos fortes deste lugar."

#. Character:`saito`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_f798c96a"
msgid "Mais... Ça doit coûter une fortune ?"
msgstr "Mas... Isso deve custar uma fortuna, não?"

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_e9ae96b9"
msgid "C'est un établissement de luxe... Les clients sont peu nombreux, mais ils en ont pour leur argent."
msgstr "É um estabelecimento de luxo... Os clientes são poucos, mas vale cada centavo."

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_5ca9a838"
msgid "Ne t'en fais pas, rien ne sera trop beau ou trop cher pour toi."
msgstr "Não se preocupe, nada vai ser bom demais ou caro demais para você."

#. Character:`saito` | Attributes:`neutral`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_b4e69ca9"
msgid "..."
msgstr "..."

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_f0f48930"
msgid "Allez, ne restons pas là !"
msgstr "Vamos, não vamos ficar parados aqui!"

#. Character:`narrator`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_5ec7adc5"
msgid "Fait chier, si elle était odieuse, au moins, ce serait plus facile de la détester."
msgstr "Que merda. Se ela fosse insuportável, pelo menos seria mais fácil odiá-la."

#. Character:`narrator`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_b1eddcce"
msgid "De toute façon, je n'ai plus trop le choix maintenant."
msgstr "De qualquer forma, eu não tenho muita escolha agora."

#. Character:`narrator`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_9ca58259"
msgid "Autant entrer maintenant que je suis là..."
msgstr "Melhor entrar de uma vez, já que estou aqui..."

#. Character:`narrator`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_a3432d40"
msgid "Ce sera ma première fois dans un onsen."
msgstr "Vai ser a minha primeira vez em uma casa de banho."

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_36b0598e"
msgid "[font_size=14]Mon chéri, tu me rejoins ?[/font_size]"
msgstr "[font_size=14]Querido, vem se juntar a mim?[/font_size]"

#. Character:`saito` | Attributes:`surprised`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_e01970b4"
msgid "Je... j'arrive !"
msgstr "Eu... já estou indo!"

#. Character:`notice`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_10fa3611"
msgid "{{sakuya.n}} a restreint votre liberté, vous n'êtes désormais plus libre de vous déplacer comme vous le souhaitez."
msgstr "A {{sakuya.n}} restringiu a sua liberdade. Agora você não pode mais se mover para onde quiser."

#. Character:`narrator`
#: game/story/onsen_exterior.dialogue
msgctxt "onsen_exterior_265879a3"
msgid "Je ne peux pas partir maintenant, {{sakuya.n}} pourrait s'en prendre à {{asami.n}} ou {{yasuka.n}}."
msgstr "Eu não posso ir embora agora, a {{sakuya.n}} poderia se vingar na {{asami.n}} ou na {{yasuka.n}}."

#. Character:`saito` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "t61eb8a0595"
msgid "Nous y voilà !"
msgstr "E cá estamos!"

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/onsen_exterior.dialogue
msgctxt "td0cb35c9b7"
msgid "Oh mon dieu !"
msgstr "Meu Deus!"

#. Character:`sayuri`
#: game/story/onsen_exterior.dialogue
msgctxt "tdcd07457b8"
msgid "Est ce que tu sais combien de fois j'ai rêvée de venir ici ?"
msgstr "Você faz ideia de quantas vezes eu sonhei em vir aqui?"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/onsen_exterior.dialogue
msgctxt "t4c38962c69"
msgid "Cet endroit est juste incroyable !"
msgstr "Este lugar é simplesmente incrível!"

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/onsen_exterior.dialogue
msgctxt "t412e042e65"
msgid "Rassure moi, tu connais la particularité de cet endroit ?"
msgstr "Me diz uma coisa, você conhece a particularidade deste lugar?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/onsen_exterior.dialogue
msgctxt "tfafd214628"
msgid "La particularité ?"
msgstr "A particularidade?"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/onsen_exterior.dialogue
msgctxt "tc3c28958ec"
msgid "Je le savais... Tu n'étais pas au courant !"
msgstr "Eu sabia... Você não fazia a menor ideia!"

#. Character:`saito` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "td1ab8bc015"
msgid "Je t'en prie, éclaire moi."
msgstr "Por favor, me ilumine."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "ta9c07643b5"
msgid "Ce lieu existe depuis plusieurs centaine d'années et plus que la beauté de l'endroit c'est la seule règle de l'établissement qui a fait sa renommée."
msgstr "Este lugar existe há centenas de anos e, mais do que a beleza dele, foi a regra única do estabelecimento que fez a sua fama."

#. Character:`saito` | Attributes:`neutral`
#: game/story/onsen_exterior.dialogue
msgctxt "ta8bd1e9543"
msgid "La seule règle ?"
msgstr "A regra única?"

#. Character:`sayuri`
#: game/story/onsen_exterior.dialogue
msgctxt "te12a61a9a9"
msgid "C'est eux qui choisissent leurs clients."
msgstr "São eles que escolhem os próprios clientes."

#. Character:`saito` | Attributes:`surprised`
#: game/story/onsen_exterior.dialogue
msgctxt "t15a75ea0cb"
msgid "Je ne savais pas qu'une telle règle était possible !"
msgstr "Eu não sabia que uma regra dessas era possível!"

#. Character:`saito`
#: game/story/onsen_exterior.dialogue
msgctxt "ta175b28d06"
msgid "C'est plutôt incroyable !"
msgstr "Isso é bem impressionante!"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "t90b5422e3d"
msgid "En effet !"
msgstr "Com certeza!"

#. Character:`sayuri`
#: game/story/onsen_exterior.dialogue
msgctxt "t8dbbf63d49"
msgid "Et malgré elle, l'endroit est toujours là après tant d'années..."
msgstr "E apesar disso, o lugar continua firme e forte depois de tantos anos..."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/onsen_exterior.dialogue
msgctxt "t15dfd7a578"
msgid "Bref oublions... Tu ne pouvais pas savoir, allons ailleurs."
msgstr "Enfim, deixa para lá... Você não tinha como saber, vamos para outro lugar."

#. Character:`saito` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "t755ae7ddd3"
msgid "Mais non voyons qu'est ce que tu racontes ?"
msgstr "Mas claro que não, o que você está dizendo?"

#. Character:`saito`
#: game/story/onsen_exterior.dialogue
msgctxt "t881f30547b"
msgid "Allons y on nous attend !"
msgstr "Vamos entrar, estão nos esperando!"

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/onsen_exterior.dialogue
msgctxt "t765ac56881"
msgid "Quoi ?! Mais... Comment tu... ?"
msgstr "O quê?! Mas... Como você...?"

#. Character:`saito` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "t4ab8230900"
msgid "C'est bon, désolé pour l'attente."
msgstr "Pronto, desculpe pela demora."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "t589ff67982"
msgid "Pas de problème, prends le temps qu'il faudra."
msgstr "Sem problemas, leve o tempo que precisar."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "tbb4a72f061"
msgid "En espérant que vous avez passé un agréable moment dans notre établissement !"
msgstr "Espero que tenham passado um momento agradável no nosso estabelecimento!"

#. Character:`sayuri`
#: game/story/onsen_exterior.dialogue
msgctxt "t9631ede783"
msgid "Oui c'était absolument merveilleux !"
msgstr "Sim, foi absolutamente maravilhoso!"

#. Character:`sayuri` | Attributes:`blush`
#: game/story/onsen_exterior.dialogue
msgctxt "t5a95776e51"
msgid "N'est-ce pas {{saito.n}} ?"
msgstr "Não foi, {{saito.n}}?"

#. Character:`saito`
#: game/story/onsen_exterior.dialogue
msgctxt "t254114eb2f"
msgid "Oui, tout était parfait !"
msgstr "Sim, estava tudo perfeito!"

#. Character:`saito`
#: game/story/onsen_exterior.dialogue
msgctxt "t4938e89bb6"
msgid "Merci encore pour tout {{sakuya.n}}."
msgstr "Obrigado mais uma vez por tudo, {{sakuya.n}}."

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "tf767ccecad"
msgid "Je t'en prie, ça m'a fait plaisir !"
msgstr "De nada, foi um prazer!"

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/onsen_exterior.dialogue
msgctxt "t76b428068f"
msgid "N'oublie pas !"
msgstr "Não vá se esquecer!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/onsen_exterior.dialogue
msgctxt "t1bfc6ac1cb"
msgid "Je n'oublierai pas !"
msgstr "Não vou esquecer!"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "t0130999514"
msgid "Dans ce cas, je vous souhaite une très bonne fin de soirée."
msgstr "Sendo assim, desejo a vocês uma ótima continuação de noite."

#. Character:`sakuya`
#: game/story/onsen_exterior.dialogue
msgctxt "t3d89969590"
msgid "Au plaisir de vous revoir."
msgstr "Espero revê-los em breve."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/onsen_exterior.dialogue
msgctxt "tca2a11dbcf"
msgid "Un problème ? Qu'est-ce que tu ne dois pas oublier ?"
msgstr "Algum problema? O que você não pode esquecer?"

#. Character:`saito` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "tde82f308ee"
msgid "Rien de grave, disons que pour avoir privatisé le onsen rien que pour nous, j'aurai un petit service à rendre en échange."
msgstr "Nada demais, digamos que por terem reservado a casa de banho só para a gente, eu vou ter que quebrar um galhinho para ela em troca."

#. Character:`sayuri`
#: game/story/onsen_exterior.dialogue
msgctxt "tf5cdc9405b"
msgid "Oh! Rien de compliqué j'espère ?"
msgstr "Ah! Nada muito complicado, espero?"

#. Character:`saito`
#: game/story/onsen_exterior.dialogue
msgctxt "td23f0f55c0"
msgid "Rien qui ne soit hors de ma portée, ne t'en fais pas.."
msgstr "Nada que eu não consiga resolver, não se preocupe."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/onsen_exterior.dialogue
msgctxt "td2b43cb8db"
msgid "Très bien, mais si tu as besoin d'aide, n'hésite pas !"
msgstr "Muito bem, mas se precisar de ajuda, é só falar!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/onsen_exterior.dialogue
msgctxt "tf2b2edf135"
msgid "Allez, je te raccompagne."
msgstr "Vamos, eu te levo para casa."

#. Character:`kimochi`
#: game/story/park.dialogue
msgctxt "t01fea45291"
msgid "Je la vois ! Elle est à l'[color=yellow]arrêt de bus[/color] ! Allons-y."
msgstr "Eu tô vendo ela! Ela está no [color=yellow]ponto de ônibus[/color]! Vamos nessa."

#. Character:`nobu`
#: game/story/park.dialogue
msgctxt "tbdb8706ab2"
msgid "Putain j'en peux plus..."
msgstr "Puta que pariu, eu não aguento mais..."

#. Character:`kenji` | Attributes:`angry`
#: game/story/park.dialogue
msgctxt "te32d52fca2"
msgid "Ferme ta gueule !"
msgstr "Cala a porra da boca!"

#. Character:`takeo` | Attributes:`angry`
#: game/story/park.dialogue
msgctxt "t68eac6f78e"
msgid "Bordel si je retrouve ce petit batard."
msgstr "Caralho, se eu encontrar aquele merdinha..."

#. Character:`nobu`
#: game/story/park.dialogue
msgctxt "t687cda3c94"
msgid "Quoi ?! Mais quel rapport ça a avec lui ?"
msgstr "O quê?! Mas o que isso tem a ver com ele?"

#. Character:`kenji`
#: game/story/park.dialogue
msgctxt "te6372d0b38"
msgid "T'es vraiment trop con ma parole, tu penses que c'est à cause de quoi d'après toi qu'on a passé la nuit dans les chiottes ?"
msgstr "Você é burro pra caralho, não é? Por que você acha que a gente passou a noite inteira trancado no banheiro?"

#. Character:`kenji` | Attributes:`disgusted`
#: game/story/park.dialogue
msgctxt "t2394f26950"
msgid "Il a du mettre un truc dans sa bouffe."
msgstr "Ele deve ter jogado alguma coisa na comida."

#. Character:`nobu`
#: game/story/park.dialogue
msgctxt "tc5fa373113"
msgid "Mais... Ca n'a pas de sens ! Pourquoi il s'infligerait ça ?"
msgstr "Mas... não faz sentido! Por que ele faria isso com a própria comida?"

#. Character:`takeo` | Attributes:`disgusted`
#: game/story/park.dialogue
msgctxt "t536e83eb81"
msgid "Parce que ce petit con savait qu'on s'en prendrait a lui..."
msgstr "Porque aquele merdinha sabia que a gente ia pegar a comida dele..."

#. Character:`nobu`
#: game/story/park.dialogue
msgctxt "t198a81323d"
msgid "...merde t'as raison."
msgstr "...merda, você tem razão."

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "t283a99e8e0"
msgid "Je crois que le plan de {{kimochi.n}} a un peu trop bien fonctionné."
msgstr "Acho que o plano do {{kimochi.n}} funcionou bem até demais."

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "t9b79666808"
msgid "Mais pour qu'ils y passent la nuit... qu'elle dose il a bien pu mettre la dedans ?"
msgstr "Mas para eles passarem a noite no banheiro... que dose ele colocou na comida?"

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "t7f0057eca0"
msgid "Pour en avoir mis autant, ça devait forcement se sentir."
msgstr "Com tanto laxante assim, o cheiro devia estar na cara."

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "t8f2727f93d"
msgid "Du coup je ne sais pas qui le plus fou dans l'histoire."
msgstr "No fim das contas, não sei quem é o mais louco nessa história."

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "t13964821b6"
msgid "{{kimochi.n}} qui vide un flacon de laxatif et ou les trois idiots qui ont tout mangé sans se rendre compte de rien ?"
msgstr "O {{kimochi.n}} que esvaziou um frasco de laxante ou os três idiotas que comeram tudo sem perceber nada?"

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "t18ddf7fb6e"
msgid "Oula ! Ennuie a l'horizon."
msgstr "Opa! Problema à vista."

#. Character:`macumba` | Attributes:`happy`
#: game/story/park.dialogue
msgctxt "td5473573ce"
msgid "Un problème les mecs ?"
msgstr "Algum problema, rapazes?"

#. Character:`macumba`
#: game/story/park.dialogue
msgctxt "t635b3ea210"
msgid "Vous n'avez pas l'air en forme."
msgstr "Vocês não parecem muito bem."

#. Character:`nobu` | Attributes:`angry`
#: game/story/park.dialogue
msgctxt "t6b7a8d4765"
msgid "Fous nous la paix, on vient de passer la nuit a se vider a cause d'un connard qui nous a fait bouffer un laxatif."
msgstr "Deixa a gente em paz, a gente passou a noite se cagando todo por causa de um babaca que botou laxante na nossa comida."

#. Character:`takeo` | Attributes:`angry`
#: game/story/park.dialogue
msgctxt "t86284f7bce"
msgid "Mais putain ta gueule {{nobu.n}} pourquoi tu racontes ça au premier venu ?!"
msgstr "Mas que porra, cala a boca, {{nobu.n}}! Por que você tá contando isso pro primeiro que aparece?!"

#. Character:`macumba` | Attributes:`neutral`
#: game/story/park.dialogue
msgctxt "t17bcbbb8a1"
msgid "Dans ce cas il faut boire, votre corps est surement déshydrater."
msgstr "Nesse caso, vocês precisam beber água, o corpo de vocês deve estar desidratado."

#. Character:`kenji` | Attributes:`angry`
#: game/story/park.dialogue
msgctxt "t0789d1cbf6"
msgid "Va te faire foutre, j'ai l'impression d'entendre ma mère ! Et puis c'est quoi ça d'abord ?!"
msgstr "Vai se foder, parece que eu tô ouvindo a minha mãe! E o que é isso aí, afinal?!"

#. Character:`macumba`
#: game/story/park.dialogue
msgctxt "tfafe51731f"
msgid "Ca ?! C'est ce qui me maintient en vie chaque jour mon frère, la musique !"
msgstr "Isso?! É o que me mantém vivo todo dia, meu irmão: a música!"

#. Character:`nobu` | Attributes:`bad`
#: game/story/park.dialogue
msgctxt "t4c4101346c"
msgid "Ah ouai ? Je peux écouter un peu ?"
msgstr "Ah, é? Deixa eu ouvir um pouco?"

#. Character:`macumba`
#: game/story/park.dialogue
msgctxt "t5a1d135363"
msgid "Pas de problème, je vais m'étirer un peu plus loin, rend le moi quand tu auras fini mais fais y attention."
msgstr "Sem problema, vou me alongar ali adiante. Me devolve quando terminar, mas toma cuidado com ele."

#. Character:`nobu`
#: game/story/park.dialogue
msgctxt "t05186a7934"
msgid "Ouai ouai t'inquiète pas !"
msgstr "Relaxa, pode deixar!"

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "tf6f4b0109c"
msgid "CRACK"
msgstr "CRACK!"

#. Character:`nobu`
#: game/story/park.dialogue
msgctxt "tee02e1a5f0"
msgid "Oups !"
msgstr "Ih, foi mal!"

#. Character:`kenji` | Attributes:`bad`
#: game/story/park.dialogue
msgctxt "t94601341ef"
msgid "Mais quel maladroit franchement..."
msgstr "Mas é um desastrado mesmo, puta merda..."

#. Character:`takeo` | Attributes:`bad`
#: game/story/park.dialogue
msgctxt "te82e917de8"
msgid "Oui, si tu avais vraiment voulu le casser il fallait y aller comme ça !"
msgstr "É, se você quisesse quebrar de verdade, tinha que ser assim!"

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "tb460d61496"
msgid "[font_size=34]CRACKKK[/font_size]"
msgstr "[font_size=34]CRACKKK![/font_size]"

#. Character:`takeo`
#: game/story/park.dialogue
msgctxt "t6326ba34f3"
msgid "Ah je me sent mieux ! Allez on se casse !"
msgstr "Ah, agora eu me sinto melhor! Vamos embora!"

#. Character:`saito` | Attributes:`upset`
#: game/story/park.dialogue
msgctxt "t256f1e848e"
msgid "Mais quels enfoirés..."
msgstr "Mas que bando de arrombados..."

#. Character:`saito` | Attributes:`sad`
#: game/story/park.dialogue
msgctxt "tc3c21ae8e1"
msgid "Je ne sais pas comment ce type va réagir mais je suppose que ça ne va pas lui plaire."
msgstr "Não sei como aquele cara vai reagir, mas imagino que ele não vai gostar nada disso."

#. Character:`saito`
#: game/story/park.dialogue
msgctxt "t60723d5573"
msgid "Autant lui rendre."
msgstr "Melhor devolver pra ele."

#. Character:`notice`
#: game/story/park.dialogue
msgctxt "t5ee1615477"
msgid "Vous obtenez le baladeur détruit."
msgstr "Você obteve o MP3 destruído."

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "tde20706126"
msgid "Son propriétaire n'est pas très loin..."
msgstr "O dono dele não deve estar longe..."

#. Character:`macumba` | Attributes:`upset`
#: game/story/park.dialogue
msgctxt "talk_macumba_7e0d13c5"
msgid "Hey, petit frère, c'est dimanche aujourd'hui, le repos fait partie de l'entrainement."
msgstr "Ei, maninho, hoje é domingo. O descanso faz parte do treino."

#. Character:`saito` | Attributes:`happy`
#: game/story/park.dialogue
msgctxt "talk_macumba_ff385e1b"
msgid "Mince, j'avais oublié, désolé."
msgstr "Putz, eu tinha esquecido, malz aí."

#. Character:`macumba` | Attributes:`happy`
#: game/story/park.dialogue
msgctxt "talk_macumba_1ed97f9f"
msgid "Aucun problème, on se retrouve dès demain matin."
msgstr "Tranquilo, a gente se vê amanhã cedo."

#. Character:`macumba`
#: game/story/park.dialogue
msgctxt "menu_macumba_c3d2b7e1_1"
msgid "Hey petit frère !"
msgstr "E aí, maninho!"

#. Character:`macumba` | Attributes:`-happy`
#: game/story/park.dialogue
msgctxt "menu_macumba_662b5327"
msgid "Ça me fait plaisir que tu sois aussi motivé, mais il faut aussi se reposer."
msgstr "Fico feliz que você esteja motivado, mas também precisa descansar."

#. Character:`macumba` | Attributes:`happy`
#: game/story/park.dialogue
msgctxt "menu_macumba_d2c8ad9a"
msgid "On se voit demain pour l'entraînement !"
msgstr "Nos vemos amanhã para o treino!"

#. Character:`macumba` | Attributes:`happy`
#: game/story/park.dialogue
msgctxt "menu_macumba_32b94129"
msgid "On se voit lundi pour l'entraînement !"
msgstr "Nos vemos na segunda para o treino!"

#. Character:`macumba`
#: game/story/park.dialogue
msgctxt "tf25c93d613"
msgid "[next]"
msgstr "[next]"

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "talk_macumba_b173ff68"
msgid "Mieux vaut éviter les ennuis et ne pas se frotter à cette espèce de golgoth."
msgstr "Melhor evitar problemas e não mexer com esse monstro."

#. Character:`narrator`
#: game/story/park.dialogue
msgctxt "tcb8ce99cee"
msgid "..."
msgstr "..."

