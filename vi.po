msgctxt "event_noriko_doggy_cffb714a"
msgid "Ne me lâche pas maintenant."
msgstr "Ngày đó, ngày đó sẽ không xa vời~ Và chúng ta là người chiến thắng~ ! Đường đến những đỉnh vinh quang không còn xa~ Đường chúng ta đã chọn~ !!!"

#. Character:`narrator`
msgctxt "t11af1afee0"
msgid "Certain !"
msgstr "Chắc chứ !"

#. Character:`noriko` | Attributes:`bad`
msgctxt "event_noriko_doggy_8b3b1910"
msgid "C'est bien ce que je pensais..."
msgstr "Thế mới là anh chứ..."

#. Character:`narrator`
msgctxt "tc4494ebac3"
msgid "A la réflexion..."
msgstr "Nghĩ lại thì..."

#. Character:`narrator`
msgctxt "t2fd7eee741"
msgid "Non je ne jouerais pas tes jeux pervers !"
msgstr "Không, không được em à !"

#. Character:`noriko`
msgctxt "t2e1f3a349e"
msgid "Alors ?"
msgstr "Thế nào ?"

#. Character:`noriko`
msgctxt "t7ce41aa5f9"
msgid "Tu attend quoi exactement ?"
msgstr "Kìa, con còn chờ gì nữa ?"

#. Character:`noriko`
msgctxt "t8f3a2bf8dc"
msgid "Allez ! C'est déja assez humiliant de me montrer comme ça..."
msgstr "Mau lên nào ! Trần như nhộng thế này, em... ngại lắm..."

#. Character:`saito`
msgctxt "t3585a0b607"
msgid "Je... Je profitais de l'instant."
msgstr "Thì... anh... thì anh đang tận hưởng, hề hề."

#. Character:`saito`
msgctxt "t15a98d4c23"
msgid "Me voila !"
msgstr "Anh... tới đây !"

#. Character:`noriko`
msgctxt "t2aecc1f0b1"
msgid "hmmm..."
msgstr "hmmm..."

#. Character:`noriko`
msgctxt "t08a42d93e5"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "tf29a7685e8"
msgid "Tu... tu ne viens pas ?"
msgstr "ANH ! Anh ơi... Anh... Huhu, anh ơi !!!"

#. Character:`saito`
msgctxt "t97036bc1da"
msgid "Si si, me voila !"
msgstr "Ừ, ừ, có anh đây..."

#. Character:`noriko`
msgctxt "tfaf210ab97"
msgid "Oh ![next=5.3]"
msgstr "Oh ![next=5.3]"

#. Character:`noriko`
msgctxt "t22c831a225"
msgid "mmhh... Oui !"
msgstr "mmhh... Ahh !"

#. Character:`noriko`
msgctxt "t5fe3623301"
msgid "C'est... C'est bon !"
msgstr "Sướng... sướng quá đi !"

#. Character:`noriko`
msgctxt "tda8cdda7c9"
msgid "vas'y aller plus fort !"
msgstr "Nữa đi, mạnh nữa vào !"

#. Character:`noriko`
msgctxt "t0bfbfc30cf"
msgid "Oui !"
msgstr "Có luôn!"

#. Character:`noriko`
msgctxt "t381ed553ad"
msgid "Oui comme ça !"
msgstr "Đúng rồi, cứ như thế !"

#. Character:`noriko`
msgctxt "t470cb580b8"
msgid "C'est..."
msgstr "Thật..."

#. Character:`noriko`
msgctxt "tc08e0912d2"
msgid "Plus vite encore !"
msgstr "Nhanh nữa lên !"

#. Character:`noriko`
msgctxt "tcfbd37eca8"
msgid "Oh oui !"
msgstr "Ahhhhhh !"

#. Character:`noriko`
msgctxt "t1778dd17f9"
msgid "Oh mon dieu oui !"
msgstr "Trời đất ơi !"

#. Character:`saito`
msgctxt "t26a1088e2f"
msgid "Ca vient !"
msgstr "Ra đây !!!"

#. Character:`noriko`
msgctxt "t5b5c2b4d2c"
msgid "Ouiiii !"
msgstr "Ưmmmmm !"

#. Character:`noriko`
msgctxt "t0f833dbc13"
msgid "mmhhhhh Oui Oui Ouiiii ![next=8.8]"
msgstr "Mmhhhhh  Ahh, Hahh Phêêê quớớớ ![next=8.8]"

#. Character:`saito`
msgctxt "td1eb83fca6"
msgid "Oh bordel..."
msgstr "Fuahhh..."

#. Character:`saito`
msgctxt "t0597954e0c"
msgid "C'etait... completement dingue !"
msgstr "Đúng là... Điên thật đấy anh nhỉ !"

#. Character:`noriko`
msgctxt "t59d42555a1"
msgid "C'est tout chaud..."
msgstr "Nóng người ghê ta..."

#. Character:`noriko`
msgctxt "t649a7cf94e"
msgid "Je le sent en moi."
msgstr "Em có thể cảm nhận... nó... bên trong em."

#. Character:`saito`
msgctxt "t62dc6be753"
msgid "Ca craint pas que j'ai..."
msgstr "Có hơi... ấy không khi anh lỡ..."

#. Character:`noriko`
msgctxt "t471916c4c4"
msgid "C'est que maintenant que tu t'en préoccupe ?"
msgstr "Giờ anh mới lo chuyện đó sao ?"

#. Character:`saito`
msgctxt "tff6d1d2c33"
msgid "..."
msgstr "…"

#. Character:`noriko`
msgctxt "t9f07dd3022"
msgid "On s'en fiche, je prend la pillule !"
msgstr "Không sao đâu anh, em uống thuốc rồi !"

#. Character:`saito`
msgctxt "t5e20bbcacd"
msgid "Oh je vois !"
msgstr "Un đờ sờ tút ! (Understood !)"

#. Character:`noriko`
msgctxt "tccd59f0e25"
msgid "Essayons plutot autre chose."
msgstr "Mình cùng thử tư thế khác nhé."

#. Character:`saito`
msgctxt "tb3e5e86b0a"
msgid "Comme quoi ?"
msgstr "Như là ?"

#. Character:`noriko`
msgctxt "t0b8532af7d"
msgid "Tu vois très bien ce que je veux dire."
msgstr "Anh biết em đang muốn nói gì mà."

#. Character:`saito`
msgctxt "t5f15d98685"
msgid "Non je... OH ! Ah oui très bien."
msgstr "Anh không có... A ! Hiểu ngay."

#. Character:`noriko`
msgctxt "tdda4c30113"
msgid "Vas'y doucement par contre."
msgstr "Chậm thôi đã, nhé anh."

#. Character:`noriko`
msgctxt "tb2bd24a2b5"
msgid "J'ai jamais..."
msgstr "Em chưa từng..."

#. Character:`saito`
msgctxt "tb1ab1807d7"
msgid "Je serais doux c'est promis ![next=5.5]"
msgstr "Hứa sẽ nhẹ nhàng mà ![next=5.5]"

#. Character:`noriko`
msgctxt "t0a445b7db2"
msgid "Ah !"
msgstr "Ah !"

#. Character:`saito`
msgctxt "t452796e79f"
msgid "C'est bon comme ça ?"
msgstr "Cảm thấy thế nào ?"

#. Character:`noriko`
msgctxt "ta0e9c36601"
msgid "Ah ! Ah ! C'est..."
msgstr "Ah ! AH ! Thật..."

#. Character:`saito`
msgctxt "tb4c059dda7"
msgid "C'ets vraiment sérré, je continue ?"
msgstr "Chặt vô cung luôn ấy, anh nhấp nhé !"

#. Character:`noriko`
msgctxt "t12d136e36b"
msgid "Oui, oui t'arrete surtout pas !"
msgstr "Dạ, đừng có dừng anh ơi !"

#. Character:`noriko`
msgctxt "t4654acd504"
msgid "Accelère !"
msgstr "Nhanh nữa vào !"

#. Character:`noriko`
msgctxt "t3305a32242"
msgid "Oh !"
msgstr "Hửm !"

#. Character:`noriko`
msgctxt "t2d24630c26"
msgid "Oh oui !"
msgstr "Sướng điên người !"

#. Character:`noriko`
msgctxt "tfa1db27c2c"
msgid "Je sent que ça vient !"
msgstr "Sắp... tới rồi !"

#. Character:`noriko`
msgctxt "t275b1dc483"
msgid "C'est different... C'est..."
msgstr "Khác biệt.. quá đi..."

#. Character:`noriko`
msgctxt "t703da2bc13"
msgid "Mmhhhhh Oui![next=8.8]"
msgstr "Mmhhhhh tê têêê~ ! [next=8.8]"

#. Character:`noriko`
msgctxt "t74352234c7"
msgid "hannn... hannnn...."
msgstr "hannn... hannnn..."

#. Character:`saito`
msgctxt "t220289895a"
msgid "C'était... Incroyable !"
msgstr "Phê... không tả nổi !"

#. Character:`noriko`
msgctxt "t2d449fce58"
msgid "...Tu... tu étais pas trop mal !"
msgstr "... Anh... Cũng ra trò phết đấy !"

#. Character:`noriko`
msgctxt "tede1d2c265"
msgid "Quoi ?"
msgstr "Oắt ?"

#. Character:`saito`
msgctxt "t332e19bb62"
msgid "Attend ! Si tu bouge comme ça je vais encore...[next=5.3]"
msgstr "Cô ới ! Nếu cô cứ bú như thế thì con...[next=5.3]"

#. Character:`noriko`
msgctxt "tdbb88da2db"
msgid "Comment ça se fait qu'il t'en restait autant ?"
msgstr "Sao anh vẫn còn nhiều quá vậy ?"

#. Character:`saito`
msgctxt "t7d72400545"
msgid "Je ne sais pas... La situation était excitante et puis..."
msgstr "Anh chẳng biết nữa... Sướng quá nên hòn bi năng suất hơn chăng..."

#. Character:`saito`
msgctxt "t3d1a186b13"
msgid "Je pense que je pourrais continuer encore longtemps a vrai dire."
msgstr "Đùa chứ chắc là anh còn thêm được dăm ba phát nữa đấy."

#. Character:`noriko`
msgctxt "event_noriko_doggy_1e409be2"
msgid "Stop... Je ... J'en peut plus !"
msgstr "Thôi... Em... RM chịu không nổi mất !"

#. Character:`noriko`
msgctxt "event_noriko_doggy_7df45f8f"
msgid "Ma parole tu es infatigable !"
msgstr "Hahh, anh sung thật đấy nhỉ !"

#. Character:`saito`
msgctxt "event_noriko_doggy_497e82a2"
msgid "Désolé..."
msgstr "Xin lỗi mà..."

#. Character:`noriko`
msgctxt "event_noriko_doggy_a598094c"
msgid "Maman va bientôt rentrer et demain nous devons nous occuper du dernier de ces trois abrutis."
msgstr "Mẹ sẽ sớm về bây giờ thôi, và ngày mai ta còn phải làm gỏi thằng âm binh cuối cùng nữa."

#. Character:`saito`
msgctxt "event_noriko_doggy_3e85771d"
msgid "Oui..."
msgstr "Chà…"

#. Character:`yasuka`
msgctxt "event_noriko_doggy_bb7a660f"
msgid "[font_size=14]Mes chéris ! Je suis rentrée ![/font_size]"
msgstr "[font_size=14]Các tình êu ơi ! Mẹ về rồi này ![/font_size]"

#. Character:`noriko`
msgctxt "event_noriko_doggy_7f221708"
msgid "Zut ! Occupe toi d'elle pendant que je rentre dans ma chambre !"
msgstr "Đuỵt ! Mau, đánh lạc hướng mẹ để em rút êm về phòng !"

#. Character:`saito` | Attributes:`guilty`
msgctxt "event_noriko_doggy_0d39eedd"
msgid "Mais je suis complètement nue !"
msgstr "Nhưng anh đang tồng ngồng, thế bất nào...!"

#. Character:`noriko`
msgctxt "event_noriko_doggy_a8c01f2f"
msgid "Improvise !"
msgstr "Dùng cái đầu đi !"

#. Character:`saito`
msgctxt "event_noriko_doggy_e9bd6bd0"
msgid "Facile a dire..."
msgstr "Nói thì dễ đấy..."

#. Character:`saito`
msgctxt "event_noriko_doggy_f7afcd1d"
msgid "Allez {{saito.n}} tu peux le faire, tu as deja connu des situations plus critiques que ça !"
msgstr "Mau, anh {{saito.n}} ơi, anh làm được mà. Đời từng dành tặng anh mấy tình huống chó má hơn thế, anh vẫn sống sờ sờ đấy thôi !"

#. Character:`yasuka`
msgctxt "yasuka_love_sexe_repeat_452f8d5c"
msgid "Cela faisait un certain temps que nous ne nous étions pas retrouvés seuls rien que toi et moi..."
msgstr "Cũng lâu rồi mẹ với con mới có thời gian bên nhau, một mình..."

#. Character:`yasuka`
msgctxt "yasuka_love_sexe_repeat_60fa72e3"
msgid "Tu m'as manqué tu sais..."
msgstr "Mẹ nhớ con lắm đấy..."

#. Character:`yasuka`
msgctxt "yasuka_love_sexe_repeat_47687564"
msgid "\"Ca\" m'a manquée."
msgstr "Ý mẹ là \"ấy ấy\", ý mà."

#. Character:`saito`
msgctxt "yasuka_love_sexe_repeat_3eadf778"
msgid "Tu m'as manquée aussi mais je suis un peu f-"
msgstr "Con cũng nhớ mẹ lắm, nhưng mẹ ơi, hôm nay con hơi oải-"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "yasuka_love_sexe_repeat_dd93b3f4"
msgid "Ne t'inquiète pas... Nous ne sommes pas obligés de faire des folies."
msgstr "Đừng lo á con.... hôm nay mình không cần phải xốc vác quá đâu con à"

#. Character:`yasuka`
msgctxt "yasuka_love_sexe_repeat_245458f4"
msgid "Nous pouvons aussi faire ça tendrement."
msgstr "Từ tốn nhẹ nhàng cũng được hết ó."

#. Character:`saito`
msgctxt "yasuka_love_sexe_repeat_9156b917"
msgid "Je..."
msgstr "Tôi..."

#. Character:`yasuka`
msgctxt "yasuka_love_sexe_repeat_fbd34660"
msgid "Allez viens !"
msgstr "Nào~ !"

#. Character:`saito`
msgctxt "yasuka_love_sexe_repeat_aaa9f4fd"
msgid "d'accord..."
msgstr "dạ vâng..."

#. Character:`narrator`
msgctxt "yasuka_love_sexe_repeat_b0f8d7e3"
msgid "Et bien {{noriko.n}}, j'espère que tu as pu réussir a sortir de la chambre sinon..."
msgstr "{{noriko.n}} ơi, lạy trời lạy Phật là em đã ra khỏi phòng này rồi, chứ không thì..."

#. Character:`narrator`
msgctxt "yasuka_love_sexe_repeat_90dc4bec"
msgid "Tu risques de passer un moment bien malaisant..."
msgstr "Đêm nay ngủ dưới gầm giường, cô chủ - tài xế, tỏ bày yêu thương..."

#. Character:`yasuka`
msgctxt "t78db667372"
msgid "Tu semblais étrange, quelque chose ne va pas ?"
msgstr "Con không khỏe hôm nay à ? Thần sắc con có vẻ không ổn lắm."

#. Character:`saito`
msgctxt "t214c929c88"
msgid "Non, non, tout va bien."
msgstr "À dạ, không, bình thường mà mẹ."

#. Character:`yasuka`
msgctxt "te204b19f32"
msgid "Je le sais quand tu me caches des choses..."
msgstr "Mẹ hiểu con lắm đó nha..."

#. Character:`yasuka`
msgctxt "tc79df12ff2"
msgid "Regarde-moi bien dans les yeux et laisse-moi t'aider à oublier tes problèmes."
msgstr "Hãy cứ nhìn thẳng vào mắt mẹ, và giải phóng nơi mẹ, mọi nỗi bức bỗi tích tụ trong lòng con."

#. Character:`saito`
msgctxt "tc6faa8eda8"
msgid "Oui... Pardon, je ne peux décidément rien te cacher."
msgstr "Dạ... Con xin lỗi, mẹ đúng là hiểu con nhất."

#. Character:`yasuka`
msgctxt "t3134935fa8"
msgid "Allez viens là !"
msgstr "Tới đi con yêu !"

#. Character:`yasuka`
msgctxt "te7c15a9046"
msgid "Hmm voilà comme ça !"
msgstr "Ahhh... đúng rồi con yêu... cứ như vậy !"

#. Character:`yasuka`
msgctxt "t9c8b2fb57f"
msgid "Juste toi et moi."
msgstr "Chỉ có mẹ và con ở đây thôi."

#. Character:`noriko`
msgctxt "tbc38954e8f"
msgid "..."
msgstr "..."

#. Character:`yasuka`
msgctxt "tcd45d29baa"
msgid "Continue mon chéri !"
msgstr "Nữa đi, con yêu, nữa đi !"

#. Character:`yasuka`
msgctxt "t7f720676ac"
msgid "Ce soir tu m'appartiens."
msgstr "Đêm nay...ahh... con là... mmm... cậu bé của mẹ~"

#. Character:`yasuka`
msgctxt "t691130f681"
msgid "et je suis aussi tout à toi."
msgstr "Và mẹ... hahh... là... người con yêu nhất~ !"

#. Character:`yasuka`
msgctxt "t9a06ecb448"
msgid "Oh mon dieu, Oui !"
msgstr "Ôi chao... mãnh liệu... hahh... quá đi !"

#. Character:`yasuka`
msgctxt "t0219c71d3e"
msgid "Je vais jouir !"
msgstr "<ẹ sắp... me sắp... tới rồi... ahhh... !"

#. Character:`yasuka`
msgctxt "tf28683a90d"
msgid "Jouis avec moi."
msgstr "Hãy cùng... thằng hoa... hmmm... với mẹ nhé !"

#. Character:`yasuka`
msgctxt "taf6c5a0274"
msgid "Ahh... Ouiii!"
msgstr "Ahhhhh !!! Con yêu !!!"

#. Character:`saito`
msgctxt "yasuka_love_sexe_repeat_51660c14"
msgid "Elle a fini par s'endormir..."
msgstr "Vậy là mẹ đã ngủ rồi..."

#. Character:`saito`
msgctxt "yasuka_love_sexe_repeat_228305a3"
msgid "Bon sang quelle soirée."
msgstr "Một đêm điên thật đấy."

#. Character:`noriko` | Attributes:`angry`
msgctxt "yasuka_love_sexe_repeat_d6a6c8c6"
msgid "[font_size=14]Bordel pourquoi il a fallu que tu fasses ça avec ma mere juste sous mon nez !![/font_size]"
msgstr "[font_size=14]Trung tình ngập úng não anh rồi hay sao mà anh dám đẻ ngửa mẹ em ra ngay trước mắt em thế hả ?! [/font_size]"

#. Character:`saito`
msgctxt "yasuka_love_sexe_repeat_2c33ae4a"
msgid "[font_size=14]Désolé... Je n'ai pas pu lui dire non, je pensais que tu avais réussi a sortir.[/font_size]"
msgstr "[font_size=14]Xin lỗi em... Mẹ cũng muốn lắm rồi mà. Với cả anh tưởng em đã rời phòng... [/font_size]"

#. Character:`noriko` | Attributes:`shame`
msgctxt "yasuka_love_sexe_repeat_8e197ac3"
msgid "[font_size=14]Et comment j'aurais pu faire ? Vous étiez tous les deux dans le salon ![/font_size]"
msgstr "[font_size=14]Anh nghĩ em lủi được chắc, cả ông lẫn bà cắm chốt như pikachu ở phòng khách còn bảo ai ?![/font_size]"

#. Character:`noriko`
msgctxt "yasuka_love_sexe_repeat_bf56975f"
msgid "[font_size=14]Et puis comment ça se fait que tu aies pu enchaîner avec elle après tout ce qu'on a fait toi et moi ?[/font_size]"
msgstr "[font_size=14]Còn nữa này, anh và em đã làm tới mức đó rồi mà anh vẫn quyết chí ăn mẹ em hay sao ?[/font_size]"

#. Character:`saito` | Attributes:`sad`
msgctxt "yasuka_love_sexe_repeat_bb829b7c"
msgid "[font_size=14]C'est peut être pas le meilleur moment pour discuter de ça...[/font_size]"
msgstr "[font_size=14]Có lẽ đây không phải địa điểm thích hợp để bàn về chuyện này em à...[/font_size]"

#. Character:`noriko`
msgctxt "yasuka_love_sexe_repeat_fa9e5d57"
msgid "[font_size=14]...[/font_size]"
msgstr "[font_size=14]...[/font_size]"

#. Character:`saito` | Attributes:`sad`
msgctxt "t262844bbf6"
msgid "et bien... Ca a l'air assez grave."
msgstr "Nghe chừng... Cũng nghiêm trọng ra phết."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "t827064d1fa"
msgid "En effet."
msgstr "Hẳn vậy."

#. Character:`saito`
msgctxt "t45f43b7d2a"
msgid "Tu as une idée pour lui faire retrouver le sourire ?"
msgstr "Mẹ có hảo kế gì để giúp cô ấy cười lại không ?"

#. Character:`yasuka` | Attributes:`moved`
msgctxt "t3c19c8622e"
msgid "Tout ça m'a fait repenser à nous."
msgstr "Cừ nghĩ tới cổ thì lại nghĩ về đôi ta."

#. Character:`saito` | Attributes:`surprised`
msgctxt "t710909f630"
msgid "A nous ? Comment ça ?"
msgstr "Mẹ con mình á ? Vì sao ạ ?"

#. Character:`yasuka`
msgctxt "tf23b23d2fe"
msgid "Tu n'as pas idée à quel point j'étais heureuse d'être enfin considérée comme une femme après tout ce temps."
msgstr "Con không biết ta đã hạnh phúc tới nhường nào, khi sau biết bao lâu, được sống lại cái tuổi thiếu nữ biết yêu."

#. Character:`yasuka`
msgctxt "tbcfca6d888"
msgid "Redécouvrir le plaisir d'aimer et d'être aimé en retour."
msgstr "Được yêu người rồi được người yêu lại nữa."

#. Character:`yasuka`
msgctxt "td2e615574d"
msgid "Tu m'as comblée de bonheur quand tu t'es occupé de moi, tout ça m'a donné une idée."
msgstr "Ở bên con làm thần trí ta cảm thấy nhẹ nhõm, và từ đó thì ta nảy ra ý tưởng nè."

#. Character:`yasuka`
msgctxt "TU_N_AS_PAS_ID_E_QUEL_POINT_J_13A6F3"
msgid "Tu n'as pas idée à quel point j'étais heureuse d'être enfin soutenue après tout ce temps à lutter seule."
msgstr ""

#. Character:`yasuka`
msgctxt "AVOIR_UNE_PAULE_SUR_LAQUELLE_S_58C7B8"
msgid "Avoir une épaule sur laquelle s'appuyer."
msgstr ""

#. Character:`yasuka`
msgctxt "TOUT_A_M_A_COMBL_E_DE_BONHEUR_A059C6"
msgid "Tout ça m'a comblée de bonheur et ça me donne une idée..."
msgstr ""

#. Character:`saito` | Attributes:`guilty`
msgctxt "t841c1f176c"
msgid "Je ne suis pas sûr de savoir où tu veux en venir."
msgstr "Con... vẫn chưa hiểu lắm ạ."

#. Character:`yasuka` | Attributes:`happy`
msgctxt "t8e1e247912"
msgid "J'aimerais que {{sayuri.n}} puisse connaitre ce même bonheur."
msgstr "Ước gì {{sayuri.n}} cũng được hưởng cái niềm hạnh phúc ấy."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "t6cc7eb957c"
msgid "Sinon j'ai peur qu'elle fasse des bêtises qu'elle pourrait regretter."
msgstr "Không thì, lỡ đâu xảy ra chuyện không hay..."

#. Character:`saito` | Attributes:`happy`
msgctxt "t2e069a817d"
msgid "Et bien présenté de cette façon c'est difficile de refuser."
msgstr "Dạ... Mẹ đã nói thế thì... có muốn nói không cũng khó ạ."

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "t842201da64"
msgid "Quel est le problème ? Tu ne l'apprécies pas ?"
msgstr "Sao lại thế ? Con không thích cô ấy à ?"

#. Character:`saito`
msgctxt "t4879fc7ac8"
msgid "Non, non, rien a voir."
msgstr "À không không... ý con là... (TL edit: Con thích leo núi, mà trông cô ghồ ghề hơn cả Dãy Trường Sơn ! )"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t3cae13c655"
msgid "C'est une femme gentille et très attachante mais... Tu ne vas pas être... Jalouse si je passe plus de temps avec elle qu'avec toi ?"
msgstr "Mẹ sẽ không cảm thấy cô đơn khi con dành nhiều thời gian hơn cho cô ấy, chứ ?"

#. Character:`yasuka` | Attributes:`moved`
msgctxt "t870aa99030"
msgid "Mon chéri, c'est adorable que tu penses à moi avant tout mais ne t'en fais pas, il ne s'agit que de quelques jours le temps que sa fille ne revienne."
msgstr "Con yêu à, đặt ta lên hàng đầu thì ta quý lắm,nhưng cũng chỉ có mấy ngày cho tới khi con bé ấy về thôi mừ."

#. Character:`saito`
msgctxt "t634d5683c6"
msgid "Autre problème que je vois.... {{sayuri.n}} acceptera t'elle de passer du temps avec un homme qui à l'âge de sa fille."
msgstr "Còn một điều này nữa... Không biết liệu cô {{sayuri.n}} có chịu đi với một cậu trai đáng tuổi con mình không."

#. Character:`yasuka` | Attributes:`happy`
msgctxt "t670df50b98"
msgid "Ne t'inquiète pas, je sais de source sûre qu'elle n'est pas insensible à tes charmes."
msgstr "Không sao đâu, con yêu à. Phụ nữ chẳng ai kháng cự được sức hút của con đâu."

#. Character:`saito` | Attributes:`surprised`
msgctxt "tfb2f7a06d7"
msgid "Une seconde, ça veut dire quoi ça...?"
msgstr "Dạ, vậy có nghĩa là ...?"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "t1fac59ba5f"
msgid "Allez viens avec moi !"
msgstr "Đi với ta nào..."

#. Character:`saito`
msgctxt "home_player_wifi_a627f3ab"
msgid "Ah merde, {{noriko.n}} bloque le chemin, je dois faire au plus vite et fouiller [color=yellow]sa chambre[/color]."
msgstr "Bà mẹ, mình cần phải nhanh chân lục soát [color=yellow]phòng của[/color] {{noriko.n}}."

#. Character:`saito`
msgctxt "corridor_lock_b9ec7245"
msgid "Ah mince, la salle de bain !"
msgstr "À, chết tiệt, phải tắm!"

#. Character:`saito`
msgctxt "corridor_lock_112a3331"
msgid "Un peu plus et je serais parti travailler sans avoir pris ma douche."
msgstr "Tí nữa là vác cái thân hôi rình đi làm rồi."

#. Character:`saito`
msgctxt "corridor_lock_c9bf00f5"
msgid "Je dois demander à {{noriko.n}}."
msgstr "Mình cần phải hỏi {{noriko.n}}."

#. Character:`saito`
msgctxt "corridor_lock_17830108"
msgid "Je ne veux pas inquiéter {{yasuka.n}}."
msgstr "Mình không muốn {{yasuka.n}} phải lo lắng."

#. Character:`yasuka`
msgctxt "talk_yasuka_5d1e865c"
msgid "Tu voulais me dire quelque chose ?"
msgstr "Có điều gì mà con muốn nói với ta không ?"

#. Character:`narrator`
msgctxt "t786a368cb1"
msgid "Discuter"
msgstr "Nói chuyện"

#. Character:`narrator`
msgctxt "t85a0d68f24"
msgid "Baladeur MP3"
msgstr "Walkman"

#. Character:`narrator`
msgctxt "t6ce0e2618b"
msgid "Baladeur MP3"
msgstr "Walkman"

#. Character:`narrator`
msgctxt "t4170e3a7aa"
msgid "Prendre un bain."
msgstr "Tắm táp."

#. Character:`narrator`
msgctxt "ta3f1ded669"
msgid "Sexe"
msgstr "Làm tình."

#. Character:`saito`
msgctxt "tcb65e2b33f"
msgid "Qu'est-ce que tu fais ?"
msgstr "Đang làm gì đó em ?"

#. Character:`noriko`
msgctxt "t8cbe2758f3"
msgid "Je t'attendais !"
msgstr "Em đang chờ anh đó !"

#. Character:`saito`
msgctxt "t213bc6254b"
msgid "Tu veux dire que tu voulais qu'on..."
msgstr "Ý em là, em muốn tụi mình..."

#. Character:`saito`
msgctxt "t7dcfd17a5e"
msgid "Ah ! Doucement ! Je savais pas que tu étais si pressée..."
msgstr "Ấy ! Gượm nào ! Anh không nghĩ là em lại hứng tới..."

#. Character:`noriko`
msgctxt "tc30644acd0"
msgid "Mmhhh ferme-là !"
msgstr "Ahhh, ngốc !"

#. Character:`saito`
msgctxt "t812f02fd06"
msgid "Mais {{yasuka.n}} pourrait nous surprendre..."
msgstr "Nhưng {{yasuka.n}} có thể nghe thấy tụi mình..."

#. Character:`noriko`
msgctxt "tf90eca5426"
msgid "Alors fais moins de bruit !"
msgstr "Vậy thì tem tém cái mồm lại !"

#. Character:`noriko`
msgctxt "t6d9ad3331f"
msgid "Finalement tu sembles bien motivé."
msgstr "Trông anh cũng hào hứng ra phết ha."

#. Character:`saito`
msgctxt "t676db2df8d"
msgid "Tu veux que j'arrête ?"
msgstr "Hay là thôi, người nhé ?"

#. Character:`noriko`
msgctxt "t39ccd05bbb"
msgid "NON !"
msgstr "KHÔNG !"

#. Character:`saito`
msgctxt "t636dac2e62"
msgid "Shhht !"
msgstr "Shhh !"

#. Character:`noriko`
msgctxt "t473ad6a9c6"
msgid "[font_size=14]Je veux dire non ![/font_size]"
msgstr "[font_size=14]Ý em là không ![/font_size]"

#. Character:`noriko`
msgctxt "t536e6380a9"
msgid "[font_size=14]Plus fort ![/font_size]"
msgstr "[font_size=14]Mạnh nữa lên ![/font_size]"

#. Character:`noriko`
msgctxt "t0ae29e84c6"
msgid "Mhhhh oui !"
msgstr "Mhhhh ahhh !"

#. Character:`noriko`
msgctxt "tbf11166cbb"
msgid "[font_size=14]Je tiens plus debout...[/font_size]"
msgstr "[font_size=14]Em không chịu nổi nữa rồi...[/font_size]"

#. Character:`saito`
msgctxt "tf5f953dbdb"
msgid "[font_size=14]Alors laisse-toi faire.[/font_size]"
msgstr "[font_size=14]AVậy thì cứ thả lỏng thôi.[/font_size]"

#. Character:`noriko`
msgctxt "tbbf445a06b"
msgid "[font_size=14]Hey ! Qu'est-ce que tu fais ?![/font_size]"
msgstr "[font_size=14]Này ! Anh tính làm gì vậy ?![/font_size]"

#. Character:`saito`
msgctxt "t6a32302f0d"
msgid "[font_size=14]Il me semblait pourtant que tu appréçiais.[/font_size]"
msgstr "[font_size=14]Anh nghĩ rằng em thích nó.[/font_size]"

#. Character:`noriko`
msgctxt "t733d02bdbd"
msgid "[font_size=14]Tu aurais pu me prévenir ![/font_size]"
msgstr "[font_size=14]Nhưng anh phải hỏi em trước chứ ![/font_size]"

#. Character:`saito`
msgctxt "talk_yasuka_4fce3151"
msgid "Ça te dirait de prendre un bain ensemble ?"
msgstr "Chúng ta tắm cùng nhau đi ?"

#. Character:`yasuka`
msgctxt "talk_yasuka_9885985c"
msgid "Petit coquin..."
msgstr "Naughty boy..."

#. Character:`saito`
msgctxt "talk_yasuka_56c4a2e4"
msgid "Je prend ça pour un oui !"
msgstr "Con sẽ coi đó là có vậy !"

#. Character:`yasuka`
msgctxt "talk_yasuka_7f38982e"
msgid "Ahhhhh, quel bonheur."
msgstr "Ahhhhh, tuyệt quá đi."

#. Character:`yasuka`
msgctxt "talk_yasuka_e787a87b"
msgid "Après une bonne journée de travail, rien de tel qu'un bon bain chaud."
msgstr "Chẳng gì tuyệt vời hơn một bồn tắm nóng sau một ngày làm việc."

#. Character:`yasuka`
msgctxt "talk_yasuka_5d3850be"
msgid "En bonne compagnie..."
msgstr "Trong một vòng tay ấm áp..."

#. Character:`saito`
msgctxt "talk_yasuka_b3ea5326"
msgid "Ce n'est pas moi qui dirai le contraire."
msgstr "Con đồng tình cả hai tay chân."

#. Character:`yasuka`
msgctxt "talk_yasuka_994d89f7"
msgid "Je suis heureuse de voir qu'à présent, c'est toi qui demandes à te baigner avec moi."
msgstr "Ta mừng rằng con là người hỏi tắm cùng với ta."

#. Character:`saito`
msgctxt "talk_yasuka_4931fc30"
msgid "Honnêtement..."
msgstr "Thật sự thì..."

#. Character:`saito`
msgctxt "talk_yasuka_b528a23b"
msgid "Je devais être fou. Je resterais bien collé à toi si je le pouvais."
msgstr "Chắc con điên mất thôi, bởi vì con muốn bám lấy mẹ cả đời."

#. Character:`yasuka`
msgctxt "talk_yasuka_4aaa7430"
msgid "Idiot... Mais ça ne me déplairait pas pour autant."
msgstr "Tiểu ma đầu ngốc... Nhưng... ta cũng không phiền lắm chuyện ấy."

#. Character:`saito`
msgctxt "talk_yasuka_770e3932"
msgid "Les gens pourraient être choqués par contre."
msgstr "Mọi người sẽ rất là bất ngờ đấy ạ."

#. Character:`yasuka`
msgctxt "talk_yasuka_a75b2630"
msgid "Cela ne m'importe plus..."
msgstr "Ta không quan tâm nữa..."

#. Character:`yasuka`
msgctxt "talk_yasuka_bc6655b7"
msgid "J'ai attendu des années avant de pouvoir être aussi heureuse."
msgstr "Ta đã đợi hàng thập kỷ để có được những giây phút bình yên như này."

#. Character:`yasuka`
msgctxt "talk_yasuka_86c1ac24"
msgid "Même si personne ne l'accepte."
msgstr "Kể cả khi xã hội này không chấp nhận."

#. Character:`yasuka`
msgctxt "talk_yasuka_9caff683"
msgid "Je veux rester avec toi..."
msgstr "Ta vẫn muốn được ở bên con..."

#. Character:`saito`
msgctxt "talk_yasuka_a0261f49"
msgid "Oh !"
msgstr "Ahh !"

#. Character:`yasuka`
msgctxt "talk_yasuka_03a24dd3"
msgid "Je sens quelque chose de dur soudainement dans mon dos..."
msgstr "Có cái gì đó, vừa... thọt vào cửa dưới của ta..."

#. Character:`yasuka`
msgctxt "talk_yasuka_1e59f4d3"
msgid "Et je crois avoir une idée de ce que c'est."
msgstr "Và ta biết ấy là gì đó nghen."

#. Character:`saito`
msgctxt "talk_yasuka_a7c69adf"
msgid "...On va dans la chambre ?"
msgstr "... Chúng ta có nên tiếp tục trong phòng ngủ không ạ ?"

#. Character:`yasuka`
msgctxt "t675af5c640"
msgid "[next]"
msgstr "[next]"

#. Character:`narrator`
msgctxt "tf9f9a0503e"
msgid "Continuer dans la chambre de {{yasuka.n}}"
msgstr "Tiếp tục ở trong phòng ngủ của {{yasuka.n}}."

#. Character:`narrator`
msgctxt "t65927365f7"
msgid "Arrêter là pour aujourd'hui."
msgstr "Hôm nay dừng lại ở đây thôi."

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "talk_yasuka_da14fd4f"
msgid "Je me demandais quand tu allais enfin me le demander."
msgstr "Tại sao không nhỉ ?"

#. Character:`yasuka`
msgctxt "talk_yasuka_23739cd8"
msgid "Maintenant que je prends enfin du plaisir, tu n'as pas intérêt à te défiler !"
msgstr "Con này, ta sẽ không chấp nhận con lủi đi khi ta đang thư giãn đâu nhé !"

#. Character:`saito`
msgctxt "talk_yasuka_d8aa13e0"
msgid "Ce serait mal me connaître !"
msgstr "Nếu mẹ nghĩ con sẽ làm vậy, thì mẹ vẫn chưa hiểu hết về con rồi !"

#. Character:`noriko`
msgctxt "te0df105c29"
msgid "Tu viens ?"
msgstr "Cùng đi hôn ?"

#. Character:`narrator`
msgctxt "t3c4fb61ee5"
msgid "Discuter"
msgstr "Tham vấn"

#. Character:`narrator`
msgctxt "t33a780d3b9"
msgid "Sexe"
msgstr "Seggs"

#. Character:`narrator`
msgctxt "tac447fde05"
msgid "Partir"
msgstr "Rời đi"

#. Character:`yasuka`
msgctxt "home_player_livingroom_14d1dd88"
msgid "Eh bien, vous en faites du bruit, que s'est-il passé ?"
msgstr "Chà, đêm qua phòng con động dữ lắm nha. Mơ đẹp hở ?"

#. Character:`saito`
msgctxt "home_player_livingroom_c1b81041"
msgid "Disons que j'ai passé une très bonne nuit."
msgstr "Tóm gọn lại là con đã có một đêm rất tuyệt vời."

#. Character:`yasuka` | Attributes:`-happy`
msgctxt "home_player_livingroom_d164d18b"
msgid "...En effet... Ton regard est différent ce matin..."
msgstr "Sáng dậy trông con đã xông xáo hẳn lên ha..."

#. Character:`saito`
msgctxt "home_player_livingroom_f8ab96b4"
msgid "Ah ?"
msgstr "Dạ ?"

#. Character:`yasuka`
msgctxt "home_player_livingroom_eb97d1ff"
msgid "Tu me racontes ?"
msgstr "Kể ta nghe cái con mơ được hôn ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_player_livingroom_f7646059"
msgid "Euh... J'ai peur que tout ne soit qu'un rêve, alors pour l'instant, je préfère ne rien te dire..."
msgstr "Dạ,... Con thiết nghĩ là chưa nên kể ngay bây giờ ạ..."

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "home_player_livingroom_cf9964e7"
msgid "Oooh... Mais je suis curieuse moi !"
msgstr "Ỏỏỏ, nhưng ta mún bít cơ~ !"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_livingroom_125f8002"
msgid "{{yasuka.n}} ! Je te promets de tout te raconter, mais... pas maintenant."
msgstr "{{yasuka.n}}! Con hứa con sẽ kể cô nghe cái... giấc mơ này, sớm thui ạ."

#. Character:`yasuka` | Attributes:`happy`
msgctxt "home_player_livingroom_04b76371"
msgid "C'était un rêve pervers ?! C'est ça ? Bon, si tu as encore taché tes draps, n'oublie pas d'aller toi-même les laver !"
msgstr "Là một giấc mơ hư hỏng lắm đúng không nè~ ?! Nếu con lỡ làm bẩn ga giường, hãy nhớ mang ga đem giặt nhé !"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_player_livingroom_ab119cf8"
msgid "Quoi ?! Non, ce n'est pas... Rien à voir avec ce genre de rêve !"
msgstr "Dạ ?! Không, không phải đâu ạ..."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_livingroom_46b1901a"
msgid "En fait, c'était bien mieux !"
msgstr "Còn diệu huyền hơn gấp vạn lần !"

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "home_player_livingroom_2c3616ea"
msgid "Mieux ?! Eh bien, je souhaiterais avoir cette chance..."
msgstr "Gấp vạn lần cơ à ?! Chà, ước gì ta cũng có những giấc mơ như vầy..."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "home_player_livingroom_d6cdaca2"
msgid "En ce moment, les miens sont déprimants."
msgstr "Dạo gần đây ta chỉ toàn chiêm bao ra những điều đáng buồn."

#. Character:`saito`
msgctxt "home_player_livingroom_0fed46bb"
msgid "Tu sais que si quelque chose te tracasse, tu peux toujours m'en parler !"
msgstr "Cô biết đấy, nếu có điều gì đang khiến cô phải bận tâm, cô luôn có thể tâm sự cùng con !"

#. Character:`yasuka`
msgctxt "OH_JE_TE_D_COUVRE_UN_NOUVEAU_C_6E5622"
msgid "Oh, je te découvre un nouveau caractère, j'aime beaucoup ce nouveau {{saito.n}}, mais il s'agit de mes problèmes et je ne veux pas te préoccuper avec ça !"
msgstr ""

#. Character:`saito`
msgctxt "home_player_livingroom_0b2a5dae"
msgid "{{yasuka.n}}, avec tout ce que tu as fait pour moi, je veux pouvoir t'aider ! Dis-moi ce qu'il se passe !"
msgstr "{{yasuka.n}}, cô đã cưu mang con suốt bao năm qua, bởi vậy con muốn được giúp cô ! Cô, hãy kể con nghe, nhé !"

#. Character:`yasuka`
msgctxt "home_player_livingroom_1dfe9efb"
msgid "Nous sommes encore dans le rouge, et nous ne sommes encore qu'au début du mois..."
msgstr "Rằm chưa qua, mà lương đã cạn..."

#. Character:`yasuka`
msgctxt "home_player_livingroom_c24e641c"
msgid "Mon travail actuel ne suffit plus pour rembourser les dettes que nous avons."
msgstr "Cứ ba cọc ba đồng thế này biết lấy gì mà trả nợ đây..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_player_livingroom_53b3469f"
msgid "Un instant, de quelles dettes parles-tu exactement ?"
msgstr "Dạ ?! Thưa, cô đang nói tới khoản nợ nào vậy ?"

#. Character:`yasuka`
msgctxt "home_player_livingroom_da6b987f"
msgid "Je ne sais pas si c'est judicieux de..."
msgstr "Ta không biết là liệu ta có nên..."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_livingroom_c111572e"
msgid "{{yasuka.n}}, pour pouvoir aider, j'ai besoin de savoir ce qu'il se passe même si c'est difficile !"
msgstr "{{yasuka.n}}, con phải biết cụ thể vấn đề là gì thì mới giúp được chứ !"

#. Character:`yasuka`
msgctxt "home_player_livingroom_efcc80f4"
msgid "D'accord, d'accord, je vais tout te dire..."
msgstr "Hmm... Thôi được, thôi được..."

#. Character:`yasuka`
msgctxt "home_player_livingroom_1d34a746"
msgid "J'ai épuisé toutes mes économies en essayant de rembourser les dettes de ton père avant qu'il ne disparaisse avec cette..."
msgstr "Ta cố công dành dụm, chắt bóp, nhặt nhạnh từng đồng từng hào để hoàn trả được phần nào hay phần ấy số nợ của cha con...Rồi người ấy bỏ ta mà theo cái con..."

#. Character:`yasuka`
msgctxt "home_player_livingroom_24c46895"
msgid "Bref !"
msgstr "Mà thôi !"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_player_livingroom_42f155da"
msgid "Les dettes de mon père ? Quoi ?! Mais il t'a laissé ses dettes ?"
msgstr "Nợ ? Của cha con sao ?! Ông ta, bỏ cô lại với đống nợ của ổng ?!"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_player_livingroom_0d896760"
msgid "{{yasuka.n}}... Je promets de tout faire pour t'aider à tout rembourser !"
msgstr "{{yasuka.n}}... Con hứa sẽ tìm mọi cách để giúp cô trả lại toàn bộ số nợ ấy !"

#. Character:`yasuka` | Attributes:`depressed`
msgctxt "home_player_livingroom_ca23b5c3"
msgid "C'est gentil mon chéri, mais ton argent de poche, même économisé sur plusieurs années, ne suffirait pas..."
msgstr "Thật ngoan lắm, nhưng dù con có tiết kiệm tiền tiêu vặt cả đời đi chăng nữa, cũng sẽ chẳng đủ đâu..."

#. Character:`saito`
msgctxt "home_player_livingroom_a0f720dc"
msgid "{{yasuka.n}}... Dis-moi juste... De combien a-t-on besoin pour sortir des ennuis ?"
msgstr "{{yasuka.n}}... Cô chỉ cần tiết lộ một con số thôi. Gia đình ta đang nợ bao nhiêu ?"

#. Character:`yasuka`
msgctxt "home_player_livingroom_ae713cd0_1"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_player_livingroom_f7f9b095"
msgid "Allez, dis-moi !"
msgstr "Thôi nào, cô cứ nói cho con biết đi !"

#. Character:`yasuka`
msgctxt "home_player_livingroom_8dc5c85a"
msgid "[speed=0.2]80 000 000 ¥..."
msgstr "[speed=0.2]80 000 000 ¥... (TL edit: Vừa giá một cái nhà 'ngoại ô' Tokyo, như kiểu các quận Adachi, Nakano, Shinjuku, cỡ 80-00m2 hay một con Lamborghini Urus, hay một con Ferrari Pista, cả ba mới cóng.)"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_player_livingroom_76ba1dec"
msgid "Quoi ?![w] Mais...[w] Comment ?"
msgstr "Hả ?![w] Nhưng....[w] Sao lại ?!"

#. Character:`yasuka` | Attributes:`upset`
msgctxt "home_player_livingroom_3faca6c4"
msgid "..."
msgstr "..."

#. Character:`yasuka`
msgctxt "home_player_livingroom_9342aa64"
msgid "Avant de s'enfuir avec cette p... nouvelle femme, ton père avait des problèmes d'argent."
msgstr "Trước khi bỏ đi biệt tích với con đi-... người vợ mới, cha con có... một số vấn đề về tiền nong."

#. Character:`yasuka`
msgctxt "home_player_livingroom_0a4f1966"
msgid "Il a pas mal emprunté à des gens... peu recommandables."
msgstr "Ông ấy đã vay mượn rất nhiều từ nhũng... người không đáng tin cậy."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "home_player_livingroom_a13d5b48"
msgid "Quand il est parti sans laisser la moindre trace, ces personnes sont remontées jusqu'à moi et m'ont bien fait comprendre qu'il était désormais de ma responsabilité de rembourser sa dette..."
msgstr "Khi mà ông ấy lẩn đi mất, họ tìm tới ta và 'nhấn mạnh' rằng trách nhiệm trả nợ giờ thuộc về ta..."

#. Character:`saito`
msgctxt "home_player_livingroom_f7863e92"
msgid "Toi ?! Mais pourquoi ?"
msgstr "Thuộc về cô ?! Nhưng tại sao lại thế ?"

#. Character:`yasuka` | Attributes:`moved`
msgctxt "home_player_livingroom_7aa24a09"
msgid "...Comme tu n'avais pas d'autre famille et que ton père était un ami de longue date, je t'ai recueilli chez moi..."
msgstr "...Cha con là người thân duy nhất mà con có. Khi ông ấy biến mất, vì cha con là một người bạn thân lâu năm của ta, ta đã nhận con vào gia đình mình..."

#. Character:`yasuka`
msgctxt "home_player_livingroom_41476939"
msgid "Et te prendre en charge signifie également prendre en charge les dettes de ton père."
msgstr "Và cưu mang con cũng đồng nghĩa với việc giải quyết khoản nợ của cha con."

#. Character:`narrator`
msgctxt "home_player_livingroom_349c74e9"
msgid "Putain, mais comment ça se fait que j'ai jamais entendu parler de ça ?!!"
msgstr "Thế. Loằn. Nào. Mà mình không biết đến mấy chuyện này nhỉ ?"

#. Character:`narrator`
msgctxt "home_player_livingroom_ccde9871"
msgid "Je comprends mieux pourquoi {{noriko.n}} me traite de parasite, c'est parce que j'en suis un bordel."
msgstr "Thảo nào {{noriko.n}} gọi mình là một con đỉa ăn bám. Mình... thật sự... là một con đỉa."

#. Character:`narrator`
msgctxt "home_player_livingroom_73486ec0"
msgid "Putain ! C'est ma faute...!"
msgstr "Mả cha tiên nhân sư bố cụ tổ ! Tất cả là lỗi của mình !"

#. Character:`yasuka` | Attributes:`upset`
msgctxt "home_player_livingroom_84029342"
msgid "Jeune homme, je le vois dans tes yeux, ne pense pas un seul instant que tu es responsable de tout ça !"
msgstr "Con ơi, ta có thể thấy lửa lòng cháy ngùn ngụt trong trái tim con; dù chỉ trong một khắc ta cũng cấm con nghĩ rằng tất cả lỗi là ở con !"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_player_livingroom_8f8d46ef"
msgid "Mais si je..."
msgstr "Nhưng nếu con..."

#. Character:`yasuka` | Attributes:`-upset`
msgctxt "home_player_livingroom_56b07a1b"
msgid "Ce qui est fait est fait, et je ne regrette pas un seul instant de t'avoir recueillie, d'accord ?"
msgstr "Chuyện đã rồi, và dù có nghìn kiếp, con lại đến với ta trong tình cảnh ấy, ta vẫn sẽ bồng con vào lòng, con hiểu chứ ?"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_livingroom_3b216443"
msgid "Merci {{yasuka.n}}..."
msgstr "Đội ơn cô rất nhiều, {{yasuka.n}}..."

#. Character:`saito`
msgctxt "home_player_livingroom_e2439cd5"
msgid "Je te jure de faire tout mon possible pour nous sortir de cette situation !"
msgstr "Con xin hứa sẽ cố gáng hết sức có thể để giúp nhà ta thoát khỏi nghịch cảnh này !"

#. Character:`yasuka` | Attributes:`moved`
msgctxt "home_player_livingroom_214c2f8d"
msgid "Rhoo... Arrête. Ne me fais pas pleurer dès le matin !"
msgstr "Aww... Mới sáng ngày ra đừng làm ta cảm động đến phát khóc chứ !"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "home_player_livingroom_a547d896"
msgid "On va s'en sortir, fais-moi confiance !"
msgstr "Chúng ta sẽ vượt qua, cứ tin ở ta !"

#. Character:`yasuka`
msgctxt "home_player_livingroom_62e76816"
msgid "Il me reste une dernière possibilité pour rembourser nos dettes... avant qu'on ne nous saisisse la maison..."
msgstr "Ta vẫn còn một phương cách cuối để có thể trả nợ... trước khi ngôi nhà bị tịch thu..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_player_livingroom_d1fffea7"
msgid "Ah ?"
msgstr "Dạ ?"

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "home_player_livingroom_a137410f"
msgid "Même si l'idée me répugne, c'est la meilleure opportunité que j'ai trouvée."
msgstr "Mặc dù nó khiến ta cảm thấy... vô cùng khó chịu, đó là một công việc vô cùng tốt..."

#. Character:`yasuka`
msgctxt "home_player_livingroom_fb28152f"
msgid "C'est une proposition d'offre d'emploi pour un job d'hôtesse...[w] cela devrait être à ma portée même si ce n'est pas ce qu'il y a de mieux."
msgstr "Một lời đề nghị làm tiếp rượu tại hộp đêm...[w] Lương trả cao lắm..."

#. Character:`yasuka` | Attributes:`-pouting`
msgctxt "home_player_livingroom_889a55a4"
msgid "L'avantage, c'est que plus tu es populaire, plus tu gagnes d'argent..."
msgstr "Khách càng biết danh, càng hay lui tới, tiền típ cứ thế càng nhiều...."

#. Character:`yasuka`
msgctxt "home_player_livingroom_0d3ff208"
msgid "Et je suis prête à tout pour sauver notre famille !"
msgstr "Và ta sẽ làm mọi điều vì gia đình !"

#. Character:`yasuka`
msgctxt "home_player_livingroom_5555b7fc"
msgid "Qu'en penses-tu ?"
msgstr "Con nghĩ sao ?"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "home_player_livingroom_c7581d29"
msgid "Merci ! Je sais que ce n'est pas une décision facile..."
msgstr "Cảm ơn con! Ta biết đây không phải là một lựa chọn dễ dàng..."

#. Character:`yasuka`
msgctxt "home_player_livingroom_1f995287"
msgid "J'ai juste à me dire qu'il s'agit d'un travail comme un autre et puis..."
msgstr "Đây cũng chỉ là một công việc như bao công việc khác thôi mà, và...."

#. Character:`yasuka`
msgctxt "home_player_livingroom_069f6a7b"
msgid "Nos dettes seront vite remboursées !"
msgstr "Chắc chắn khoản nợ của gia đình mình sẽ biến mất chỉ sau vài ngày !"

#. Character:`yasuka`
msgctxt "home_player_livingroom_02d76ce6"
msgid "Je serais vite très populaire crois-moi. Et d'ici quelques semaines, on vivra dans un château..."
msgstr "Và con cứ chờ vài tuần xem, gia đình chúng ta sẽ dọn tới biệt phủ nhà lầu ngay !"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_livingroom_b8dd6761"
msgid "Tu as l'air sûre de toi en tout cas."
msgstr "Cô lạc quan thật đấy."

#. Character:`yasuka`
msgctxt "home_player_livingroom_f718c954"
msgid "Je commence ce soir !"
msgstr "Tối nay ta sẽ bắt đầu !"

#. Character:`saito`
msgctxt "home_player_livingroom_87e25920"
msgid "Très bien, je te souhaite bon courage alors."
msgstr "Chúc cô may mắn."

#. Character:`narrator`
msgctxt "t4e2134e9d8"
msgid "[hint=ROUTE CORRUPTION]C'est probablement une bonne idée en effet !"
msgstr "[hint=CORRUPTION ROUTE] Con nghĩ đấy là một ý tưởng hay đó ạ !"

#. Character:`yasuka` | Attributes:`sad`
msgctxt "home_player_livingroom_bba9737d"
msgid "...Ça ne m'enchante pas non plus, mais ce sera vite remboursé de cette façon..."
msgstr "Ta cũng không hề muốn, nhưng đó là cách nhanh nhất giúp ta thoát khỏi tấn nợ khổng lồ..."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_player_livingroom_0a110496"
msgid "Oui, mais... je veux dire que, si ça s'apprend, ça pourrait engendrer un véritable scandale à la fac..."
msgstr "Vâng, nhưng mà... Ý con là, nếu chuyện này mà bị lọt ra, sẽ sinh ra hàng tấn lời qua tiếng lại..."

#. Character:`saito`
msgctxt "home_player_livingroom_89b2649b"
msgid "La vie de {{noriko.n}} pourrait aussi être impactée."
msgstr "Sẽ gây ảnh hưởng rất tiêu cực tới cuộc sống của {{noriko.n}}."

#. Character:`saito`
msgctxt "home_player_livingroom_9c8bb34f"
msgid "Tu sais comment les nouvelles vont vite..."
msgstr "Những lời quỷ quyệt đi xa và nhanh lắm, cô à..."

#. Character:`saito`
msgctxt "home_player_livingroom_7f417f1d"
msgid "Si on apprend que la mère d'une élève travaille dans un bar à hôtesse..."
msgstr "Nếu như trường học biết được rằng phụ huynh của một học sinh là một hostess hộp đêm..."

#. Character:`saito`
msgctxt "home_player_livingroom_4c6b9926"
msgid "Je suis sûr qu'un professeur de l'école ou encore le proviseur ne se gênerait pas pour aller vérifier ça par lui-même..."
msgstr "Con chắc chắn rằng một giáo viên, hay một hiệu trưởng nào đó, sẽ không có vấn đề gì tới tận nơi để kiểm chứng..."

#. Character:`saito`
msgctxt "home_player_livingroom_9ef6ad7f"
msgid "Dès que les gens ont un moyen de pression sur toi, il sera facile de te faire chanter."
msgstr "Khi mà họ đã nắm thóp được cô, lợi dụng cô sẽ trở nên vô cùng dễ dàng."

#. Character:`yasuka`
msgctxt "home_player_livingroom_59e5bc5b"
msgid "Je le sais bien, mais... comment faire pour l'argent dans ce cas... ?"
msgstr "Ta biết chứ, thế nhưng... còn chuyện tiền nong thì biết làm sao ?"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_livingroom_3c1b6285"
msgid "Écoute... Je pense que ça prendra un peu plus de temps, mais j'ai quelques pistes pour un travail prometteur..."
msgstr "... Tuy có thể sẽ mất một khoảng thời gian nữa, con có tìm thấy một số việc làm khả quan."

#. Character:`saito`
msgctxt "home_player_livingroom_07c71e87"
msgid "Tu as passé toutes ces années à t'occuper de moi, laisse-moi te rendre la pareille..."
msgstr "Cô đã săn sóc và bảo vệ con suốt bấy nhiêu năm vừa rồi, hãy để con trả ơn cô."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "home_player_livingroom_21525109"
msgid "Tu es vraiment un ange ! Merci..."
msgstr "Ta đang nhận nuôi một thiên thần ! Ta quý con nhiều lắm..."

#. Character:`saito`
msgctxt "home_player_livingroom_3a632de7"
msgid "Je te l'ai dit, je ferai tout pour nous sortir de cette mauvaise passe. Fais-moi confiance."
msgstr "Con đã bảo rồi, con sẽ cố gắng hết sức để giải thoát nhà ta khỏi gông xích. Cô cứ tin ở con."

#. Character:`narrator`
msgctxt "t3c1d75debd"
msgid "[hint=ROUTE AMOUR]Je ne pense pas que ce soit une bonne idée."
msgstr "[hint=LOVE ROUTE] Con không tán thành cái ý kiến này đâu ạ."

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "home_player_livingroom_7b38df2e"
msgid "Un métier sexuel ?"
msgstr "Cung cấp dịch vụ tình dục ư ?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_player_livingroom_d98c38a6"
msgid "...c'est pas ça ?"
msgstr "...Không phải công việc đấy là như thế hay sao ?"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "home_player_livingroom_c41104d2"
msgid "Je te l'ai déjà dit, les hentais te montent trop au cerveau..."
msgstr "Ta đã bảo con rồi, đừng xem nhiều phim đen quá..."

#. Character:`yasuka`
msgctxt "home_player_livingroom_e19221af"
msgid "Que des fantasmes... Tss... J'ai élevé un vrai pervers."
msgstr "Nhi... Hmph... Ta không nuôi nấng một đứa dâm dê nha."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_livingroom_14437795"
msgid "Ahemmm..."
msgstr "Ahemmm..."

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "home_player_livingroom_b620894e"
msgid "Je tiens simplement compagnie à des hommes d'affaires et je les incite juste à consommer tout en les écoutant parler..."
msgstr "Ta chỉ cần phải bầu bạn với các quý ông và khuyến khích họ uống rượu trong các cuộc trò chuyện."

#. Character:`yasuka`
msgctxt "home_player_livingroom_f8ea880a"
msgid "Il se passe quoi dans la tête des jeunes ?"
msgstr "Tâm trí con đang lạc đi đâu vậy không biết ?"

#. Character:`saito`
msgctxt "home_player_livingroom_d775bea4"
msgid "D'accord, d'accord, j'ai compris, je me tais !"
msgstr "Được rồi, được rồi mà cô, con biết con sai mà !"

#. Character:`narrator`
msgctxt "HINT_ROUTE_AMITI_EUH_C_EST_PA_15EE07"
msgid "[hint=ROUTE AMITIÉ]Euh... c'est pas un genre de métier sexuel ?"
msgstr ""

#. Character:`saito`
msgctxt "home_player_livingroom_eabc0b08"
msgid "Bonsoir {{yasuka.n}} !"
msgstr "Cô {{yasuka.n}}, con chào cô !"

#. Character:`yasuka`
msgctxt "home_player_livingroom_995c921e"
msgid "Bonsoir, mon chéri, comment s'est passée ta journée... ?"
msgstr "Mừng về nhà, con yêu; ngày hôm nay của con tốt chứ ?"

#. Character:`saito`
msgctxt "home_player_livingroom_065572e7"
msgid "J'ai connu mieux... je crois[w] et toi comment s'est passé ta première journée d'hôtesse ?"
msgstr "Có thể tốt hơn, con nghĩ vậy...[w] Ngày đầu tiên của cô làm...tiếp viên, ra sao rồi ạ ?"

#. Character:`saito`
msgctxt "home_player_livingroom_d05134db"
msgid "{{yasuka.n}} ?"
msgstr "{{yasuka.n}}?"

#. Character:`yasuka`
msgctxt "home_player_livingroom_892f73c3"
msgid "Oh, excuse-moi, j'avais la tête ailleurs..."
msgstr "A, ta xin lỗi, tâm trí ta đang hơi bay bổng chút..."

#. Character:`yasuka`
msgctxt "home_player_livingroom_9b442420"
msgid "La journée était... plus difficile que je ne l'avais prévue..."
msgstr "Chỉ là ngày hôm nay có hơi... khó khăn..."

#. Character:`yasuka`
msgctxt "home_player_livingroom_987b7c7c"
msgid "Je suis épuisée, je vais aller me coucher tout de suite !"
msgstr "Ta mệt lắm lắm, có lẽ giờ ta nên đi ngủ cho lại sức..."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_player_livingroom_662473f5"
msgid "{{yasuka.n}}, cette idée n'était peut-être pas aussi bonne que prévu."
msgstr "{{yasuka.n}}, có vẻ như đây không phải là một ý tưởng hay..."

#. Character:`yasuka`
msgctxt "t0725bf77ae"
msgid "[next]"
msgstr "[next]"

#. Character:`yasuka`
msgctxt "home_player_livingroom_06e8b429"
msgid "Je le sais bien, mais je ne vais pas abandonner à la première difficulté..."
msgstr "Ta biết chứ, nhưng ta không thể chùn bước ngay khi mới gặp một chút khó khăn được."

#. Character:`yasuka` | Attributes:`upset`
msgctxt "home_player_livingroom_bba90700"
msgid "Je ne pensais juste pas que les hommes pouvaient avoir les mains aussi baladeuses."
msgstr "Ta chỉ không ngờ rằng đàn ông lại có những bàn tay... hay lang thang tới vậy."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_player_livingroom_45599642"
msgid "Quelle bande de sales..."
msgstr "Thật đúng là một lũ..."

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "home_player_livingroom_bff6b6f2"
msgid "Mais ça ira !"
msgstr "Nhưng, mọi chuyện vẫn ổn mà !"

#. Character:`yasuka`
msgctxt "home_player_livingroom_24af95cf"
msgid "J'ai un objectif en tête, je dois rester concentrer dessus..."
msgstr "Ta có một mục tiêu, và ta phải quyết tâm hướng tới nó."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_player_livingroom_3e7ad73c"
msgid "Mais... Il n'y a pas moyen de le signaler à ton patron ?"
msgstr "Nhưng mà... Cô không thể báo cáo chuyện này tới quản lý của cô được ạ ?"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "home_player_livingroom_e5ac9240"
msgid "...Tu es encore jeune, tu ne connais encore pas très bien le monde du travail."
msgstr "...Con yêu còn trẻ, con vẫn chưa biết chốn làm việc nó như thế nào đâu."

#. Character:`saito`
msgctxt "home_player_livingroom_03775ec8"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "home_player_livingroom_78e893a6"
msgid "Tu es sûre de toi ?"
msgstr "Cô chắc là cô ổn chứ ?"

#. Character:`yasuka`
msgctxt "home_player_livingroom_6c4a2977"
msgid "Oui !"
msgstr "Chắc chứ !"

#. Character:`yasuka` | Attributes:`moved`
msgctxt "home_player_livingroom_1a40cf41"
msgid "Merci de t'inquiéter pour moi mon chéri, et puis si jamais j'en ai marre, je peux arrêter, n'est-ce pas ?"
msgstr "Cảm ơn vì đã lo lắng cho ta, con yêu, ta hứa sẽ dừng mọi chuyện lại nếu như nó có vượt quá sức chịu đựng của ta."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_livingroom_d0dec7c0"
msgid "...En effet !"
msgstr "...Dạ vâng."

#. Character:`yasuka` | Attributes:`happy`
msgctxt "home_player_livingroom_e87cd746"
msgid "Alors ne t'inquiète plus pour moi, je suis une grande fille à présent, va donc te coucher, il est déjà très tard."
msgstr "Ta có thể tự chăm sóc bản thân ! Chẳng phải một mình ta đã nuôi cả hai con suốt bấy lâu qua đấy thây ? GIờ đã muộn rồi, hãy đi ngủ thôi."

#. Character:`saito`
msgctxt "home_player_livingroom_01b802fe"
msgid "D'accord. Bonne nuit {{yasuka.n}}."
msgstr "Dạ vâng ạ. Chúc ngủ ngon, {{yasuka.n}}."

#. Character:`narrator`
msgctxt "tbc542980bb"
msgid "[hint=ROUTE CORRUPTION]Tu n'as pas à t'infliger ça, tu sais..."
msgstr "[hint=CORRUPTION ROUTE]Cô không cần phải làm vậy đâu, cô biết mà..."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "home_player_livingroom_ae44d7a9"
msgid "Tu... tu as peut-être raison."
msgstr "Con... Có thể con nói đúng."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "home_player_livingroom_fd8be120"
msgid "...merci pour ton soutient mon chéri."
msgstr "...Cảm ơn vì đã ủng hộ ta, con yêu."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "home_player_livingroom_fa12e14b"
msgid "Je suis désolée de ne pas être aussi forte..."
msgstr "Ta xin lỗi vì ta không rắn rỏi như ta đã tưởng..."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_livingroom_e740f9e9"
msgid "Ne t'en fais pas, tu as déjà fait tellement pour moi."
msgstr "Đừng lo, thưa cô, cô đã chịu nhiều đắng cay vì con rồi."

#. Character:`saito`
msgctxt "home_player_livingroom_50665a20"
msgid "Je ferais tout pour te rendre la pareille..."
msgstr "Con sẽ tìm ra cách để trả lại cái ân huệ ấy, con hứa."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "home_player_livingroom_1c7dfcb7"
msgid "Ooh... Tu trouves quand même le temps de t'inquiéter pour moi malgré la journée que tu as passé."
msgstr "Con vẫn cứ lo lắng cho ta, dầu con đã có một ngày khó nhằn tới vậy..."

#. Character:`saito`
msgctxt "home_player_livingroom_a98bc439"
msgid "Je veille sur toi..."
msgstr "Con quan tâm tới cô..."

#. Character:`saito`
msgctxt "home_player_livingroom_5a26d0b9"
msgid "Va dormir, je pense que tu l'as méritée..."
msgstr "Hãy đi ngủ thôi cô. Để ngày mai ta còn chiến đấu tiếp."

#. Character:`yasuka`
msgctxt "te09597d652"
msgid "Je pense que je ne pourrai pas dormir seule ce soir, je peux dormir avec toi ?"
msgstr "Chắc là tối nay ta không ngủ được một mình đâu. Ta ngủ cùng với con nhé ?"

#. Character:`yasuka`
msgctxt "tc9b99debc4"
msgid "Je me dépêche de me changer et je te rejoins."
msgstr "Để ta đi thay đồ nhanh thôi."

#. Character:`narrator`
msgctxt "tfc4bf76365"
msgid "[hint=ROUTE LOVE]Il est encore temps de changer d'avis."
