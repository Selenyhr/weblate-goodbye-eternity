msgstr ""

#. Character:`sayuri`
msgctxt "TU_ES_VRAIMENT_UN_VILAIN_GAR_O_BF6373"
msgid "Tu es vraiment un vilain garçon..."
msgstr ""

#. Character:`saito`
msgctxt "JE_NE_SUIS_PAS_DEVENU_VILAIN_T_237100"
msgid "Je ne suis pas devenu vilain tout seul !"
msgstr ""

#. Character:`sayuri`
msgctxt "C_EST_VRAI_1DB725"
msgid "C'est vrai..."
msgstr ""

#. Character:`sayuri`
msgctxt "QUE_VA_T_IL_SE_PASSER_MAINTENA_C52355"
msgid "Que va-t-il se passer maintenant ?"
msgstr ""

#. Character:`saito`
msgctxt "ALLONS_D_J_NOUS_METTRE_AU_CHAU_F4A65A"
msgid "Allons déjà nous mettre au chaud."
msgstr ""

#. Character:`narrator`
msgctxt "JE_NE_REGRETTE_RIEN_5366B3"
msgid "Je ne regrette rien !"
msgstr ""

#. Character:`takeo`
msgctxt "ALORS_L_TU_NE_POUVAIS_PAS_PLUS_F73300"
msgid "Alors là, tu ne pouvais pas plus mal tomber !"
msgstr ""

#. Character:`takeo` | Attributes:`bad`
msgctxt "JE_SUIS_DE_BONNE_HUMEUR_ALORS_68AAB4"
msgid "Je suis de bonne humeur, alors juste retourne d'où tu viens et fiche-moi la paix."
msgstr ""

#. Character:`saito`
msgctxt "JE_NE_PARTIRAI_PAS_AVANT_QUE_T_BE01B6"
msgid "Je ne partirai pas avant que tu ne me répondes."
msgstr ""

#. Character:`saito`
msgctxt "JE_VEUX_SAVOIR_O_JE_PEUX_TROUV_58271D"
msgid "Je veux savoir où je peux trouver {{akira.n}}."
msgstr ""

#. Character:`takeo` | Attributes:`mocking`
msgctxt "MEC_JE_SAIS_PAS_CE_QUE_TU_LUI_2B1A55"
msgid "Mec... Je sais pas ce que tu lui veux, mais tu ferais pas mieux de retrouver ta copine ? Je l'ai vue un peu plus loin, là-bas !"
msgstr ""

#. Character:`saito` | Attributes:`surprised`
msgctxt "QUOI_T_ES_S_RIEUX_6AE5FC"
msgid "Quoi ?! T'es sérieux ?"
msgstr ""

#. Character:`takeo` | Attributes:`bad`
msgctxt "BIEN_S_R_ELLE_FAIT_LE_TROTTOIR_987F9D"
msgid "Bien sûr, elle fait le trottoir !"
msgstr ""

#. Character:`takeo`
msgctxt "HEY_L_CHE_MOI_CE_COSTUME_A_CO_97EE29"
msgid "Hey ! Lâche-moi, ce costume a coûté une blinde !"
msgstr ""

#. Character:`takeo`
msgctxt "ET_J_AI_MA_COPINE_QUI_M_ATTEND_7CFA5A"
msgid "Et j'ai ma copine qui m'attend au love hôtel !!"
msgstr ""

#. Character:`saito`
msgctxt "J_EN_AI_ASSEZ_DE_VOUS_DONC_JE_2B2A93"
msgid "J'en ai assez de vous... Donc je vais cogner jusqu'à ce que tu sois plus disposé à m'aider !"
msgstr ""

#. Character:`takeo`
msgctxt "MAIS_T_ES_UN_FOU_JAMAIS_DE_LA_5B5CD0"
msgid "Mais t'es un fou... Jamais de la vie j-"
msgstr ""

#. Character:`takeo`
msgctxt "HEY_NON_ARR_TE_CBCFFD"
msgid "Hey ! Non... Arrête !"
msgstr ""

#. Character:`saito`
msgctxt "O_EST_IL_A4391D"
msgid "OÙ EST-IL ?"
msgstr ""

#. Character:`takeo`
msgctxt "J_EN_SAIS_RIEN_ET_M_ME_SI_JE_L_73900C"
msgid "J'en... sais rien... et même si je le savais... je ne te dirais rien !"
msgstr ""

#. Character:`takeo`
msgctxt "AKIRA_N_NE_PARDONNE_PAS_AUX_B_8CA9A3"
msgid "{{akira.n}} ne pardonne pas aux balances... Et lui serait capable du pire."
msgstr ""

#. Character:`takeo`
msgctxt "JE_NE_SAIS_RIEN_MAINTENANT_LAI_B5E44D"
msgid "Je ne sais rien... Maintenant laisse-moi, c'est une soirée que j'attends depuis longtemps."
msgstr ""

#. Character:`saito`
msgctxt "NON_TU_PEUX_TE_FOUTRE_DE_MOI_S_A2EF00"
msgid "Non... Tu peux te foutre de moi si tu veux... Mais pour avoir insinué qu'{{asami.n}} faisait le trottoir... Tu vas prendre cher !"
msgstr ""

#. Character:`takeo`
msgctxt "NON_C_EST_BON_PARDON_JE_LE_PEN_08ED38"
msgid "Non c'est bon, pardon... Je le pensais pas, je..."
msgstr ""

#. Character:`takeo`
msgctxt "A_E_NON_PUT_9EFF48"
msgid "Aïe ! Non ! Put-"
msgstr ""

#. Character:`takeo`
msgctxt "PUTAIN_IL_FALLAIT_QUE_TU_ME_TR_E0E1F1"
msgid "Putain ! Il fallait que tu me traînes ici."
msgstr ""

#. Character:`takeo`
msgctxt "JE_N_AI_PAS_DE_BONS_SOUVENIRS_C24FAE"
msgid "Je n’ai pas de bons souvenirs..."
msgstr ""

#. Character:`takeo`
msgctxt "J_AI_D_J_QUELQUE_CHOSE_DE_PR_V_2BACFF"
msgid "J’ai déjà quelque chose de prévu qui m’attend, j’aurais été ravi de t’aider, mais est-ce que ça ne peut pas attendre demain ?"
msgstr ""

#. Character:`akira` | Attributes:`neutral`
msgctxt "TU_VAS_NULLE_PART_PAS_TANT_QUE_B4CBC2"
msgid "Tu vas nulle part ! Pas tant que je te l’aurai permis."
msgstr ""

#. Character:`takeo`
msgctxt "MAIS_D03957"
msgid "Mais..."
msgstr ""

#. Character:`akira`
msgctxt "TOUT_D_PEND_DE_TOI_TON_P_RE_ES_130DDD"
msgid "Tout dépend de toi. Ton père est bien flic, non ?"
msgstr ""

#. Character:`takeo`
msgctxt "OUAIS_ET_ALORS_9051BB"
msgid "Ouais, et alors ?"
msgstr ""

#. Character:`akira`
msgctxt "J_AI_BESOIN_D_UN_FLINGUE_D_MER_CEAD95"
msgid "J’ai besoin d’un flingue. Démerde-toi pour m’en rapporter un !"
msgstr ""

#. Character:`takeo` | Attributes:`angry`
msgctxt "WOAH_WOAH_T_ES_CINGL_2909A1"
msgid "Woah, woah ! T’es cinglé ?!!"
msgstr ""

#. Character:`takeo`
msgctxt "Y_A_AUCUN_MOYEN_QUE_JE_FASSE_A_780CFE"
msgid "Y’a aucun moyen que je fasse ça !"
msgstr ""

#. Character:`takeo`
msgctxt "MON_P_RE_ME_TUERAIT_DE_SES_PRO_24C0BD"
msgid "Mon père me tuerait de ses propres mains."
msgstr ""

#. Character:`akira` | Attributes:`arrogant`
msgctxt "C_EST_TON_PROBL_ME_PAS_LE_MIEN_ADBD40"
msgid "C’est ton problème, pas le mien. À toi de ne pas te faire prendre."
msgstr ""

#. Character:`akira`
msgctxt "MAINTENANT_JE_VAIS_ALLER_M_OCC_776843"
msgid "Maintenant, je vais aller m’occuper de ta chère copine. Si tu te dépêches, tu seras peut-être là à temps avant qu’il ne se passe quelque chose."
msgstr ""

#. Character:`takeo` | Attributes:`neutral`
msgctxt "TU_VAS_PAS_FAIRE_A_PUTAIN_TOUT_AC061C"
msgid "Tu vas pas faire ça, putain ?! Toutes les fois où on t’a rendu service !"
msgstr ""

#. Character:`takeo`
msgctxt "C_EST_COMME_A_QUE_TU_NOUS_REME_C857B9"
msgid "C’est comme ça que tu nous remercies ?"
msgstr ""

#. Character:`akira` | Attributes:`angry`
msgctxt "QUEL_PUTAIN_DE_MOMENT_T_AS_CR_FE7A77"
msgid "À quel putain de moment t’as cru qu’on était potes ?"
msgstr ""

#. Character:`akira`
msgctxt "ALLEZ_QU_EST_CE_QUE_TU_FAIS_EN_C7AA8C"
msgid "Allez qu'est-ce que tu fais encore là ?"
msgstr ""

#. Character:`takeo`
msgctxt "BORDELLLLL_C97DFF"
msgid "Bordelllll !"
msgstr ""

#. Character:`narrator`
msgctxt "home_minato_exterior_a0a69bba"
msgid "Bon de toute façon, j'avais des trucs à voir avec lui..."
msgstr "Đằng nào thì, mình vẫn có chuyện cần giải quyết với cậu ta..."

#. Character:`narrator`
msgctxt "home_minato_exterior_9b2f0643"
msgid "Je n'aurais qu'a glissé le nom d'{{asami.n}} subtilement dans la conversation."
msgstr "Mình chỉ cần nhắc đến {{asami.n}} một cách thật nhẹ nhàng trong cuộc trò chuyện."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_minato_exterior_2f5b2b16"
msgid "Hey {{minato.n}}, comment ça va depuis l'autre jour, tu as un peu de temps pour discuter avec ton meilleur pote ?"
msgstr "Này {{minato.n}}. Dạo này thế nào rồi ? Có thời gian trò chuyện một lát với thằng bạn già của mày không ?"

#. Character:`minato`
msgctxt "home_minato_exterior_a4d41ed0"
msgid "...Non, pas vraiment, je suis occupé, à plus !"
msgstr "Không hẳn đâu. Bận rồi. Gặp lại sau nhé !"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_minato_exterior_de8cd53e"
msgid "Hey, hey, tu peux pas m'envoyer chier comme ça sans même me dire bonjour ou au revoir."
msgstr "Này này, mày đéo chào hay tạm biệt tao mà cứ thế bảo tao phắn đi thế."

#. Character:`saito` | Attributes:`-sad`
msgctxt "home_minato_exterior_d543969f"
msgid "Dis-moi ce qu'il se passe, est-ce que je peux t'aider ?"
msgstr "Có chuyện gì xảy ra à ? Biết đâu tao có thể giúp mày ?"

#. Character:`minato`
msgctxt "home_minato_exterior_b6b3a68d"
msgid "...{{chiaki.n}} est encore sortie se balader dehors sans prévenir."
msgstr "{{chiaki.n}} lại đi ra ngoài mà không bảo tao."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_minato_exterior_40deb78f"
msgid "Attends, c'est ça qui t'inquiète ?"
msgstr "Ơ kìa, đấy là điều mà mày lo lắng ư ?"

#. Character:`minato` | Attributes:`angry`
msgctxt "home_minato_exterior_a6dea4a8"
msgid "Va te faire foutre !"
msgstr "Mẹ mày chứ!"

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_minato_17ffc067"
msgid "Non, mais ne le prends pas comme ça, de quoi tu t'inquiètes ? Elle est majeure, bordel ! Fous-lui la paix !"
msgstr "Ấy khoan, đừng dỗi chứ. Mày thì lo gì ? Con bé lớn rồi mà mậy ? Cho nó tự do một tí !"

#. Character:`saito`
msgctxt "talk_minato_0831937a"
msgid "Elle a quel âge ? 18 ? 19 ans ? Elle saura se débrouiller seule."
msgstr "Năm nay con bé, gì, 18 19 tuổi rồi ? Bằng này tuổi thì tự chăm sóc bản thân được mà."

#. Character:`minato`
msgctxt "home_minato_exterior_13d1dd1f"
msgid "Hors de question !"
msgstr "Nhất quyết đéo được !"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_minato_exterior_1437e48a"
msgid "Tu vas l'étouffer à force de vouloir la surprotéger, laisse la vivre un peu sa vie, faire des erreurs, apprendre quoi..."
msgstr "Bao bọc con bé quá mức sẽ khiến con bé cảm thấy khó chịu đấy. Để con bé ra trải đời, học đời,..."

#. Character:`minato`
msgctxt "home_minato_exterior_c0affdff"
msgid "Putain {{saito.n}}, mais mêle-toi de ton cul sérieux !"
msgstr "Cái con mẹ mày chứ, {{saito.n}}, lo chuyện nhà mày đi !"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_minato_exterior_6f8a083a"
msgid "...Je t'ai jamais vu aussi énervé, il y a forcément autre chose, crache le morceau."
msgstr "Tao chưa bao giờ thấy mày tức giận tới vậy. Chắc chắn phải có cái gì đó nữa. Mày phải nói tao nghe thì tao mới giúp được chứ."

#. Character:`minato` | Attributes:`upset`
msgctxt "home_minato_exterior_b002b62d"
msgid "...Il y a un putain de cinglé qui traine autour de chez moi depuis quelque temps."
msgstr "Có một thằng biến thái hay lảng vảng quanh khu này."

#. Character:`minato`
msgctxt "talk_minato_fd10e87e"
msgid "Et je pense sérieusement qu'il en a après elle."
msgstr "Và tao chắc chắn rằng thằng chó đấy đang ngắm tới con bé,"

#. Character:`saito`
msgctxt "home_minato_exterior_7d25dd9d"
msgid "Putain, mais pourquoi tu n'as pas commencé par là ?"
msgstr "Cái đuỵt con mẹ, sao mày không bảo sớm ?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_minato_exterior_81ffea48"
msgid "Je vais t'aider à la retrouver, ça marche ?"
msgstr "Tao sẽ giúp mày tìm con bé, được chứ ?"

#. Character:`minato`
msgctxt "home_minato_exterior_c06a7e80"
msgid "Merci, ramène-la vite à la maison dès que tu l'auras retrouvé."
msgstr "Cảm ơn mày, nhớ mang con bé về càng sớm càng tốt nhé."

#. Character:`saito`
msgctxt "home_minato_exterior_b8bd7c37"
msgid "...Euh, tu ne viens pas ?"
msgstr "... Ơ, mày không đi cùng à ?"

#. Character:`minato`
msgctxt "home_minato_exterior_9986aafe"
msgid "Je ne peux pas justement, j'ai un rendez-vous que je ne peux pas rater."
msgstr "Không nổi con ơi. Tao có một cuộc họp quan trọng phải dự."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_minato_exterior_7684adcc"
msgid "C'est bon, j'ai compris, compte sur moi !"
msgstr "Okay, được rồi. Cứ tin ở tao !"

#. Character:`narrator`
msgctxt "home_minato_exterior_d273b9d5"
msgid "Bon, par où commencer ?"
msgstr "Hừm, bắt đầu từ đâu đây ?"

#. Character:`narrator`
msgctxt "home_minato_exterior_1dfa93aa"
msgid "Je peux voir le [color=yellow]dojo[/color], le [color=yellow]restaurant[/color], peut-être [color=yellow]devant chez moi[/color] ou encore le [color=yellow]parc[/color]."
msgstr "Mình có thể check mấy chỗ [color=yellow]Võ Đường[/color], [color=yellow]Quán Udon[/color], có thể là [color=yellow]ở ngay trước nhà mình[/color], hoặc là ở [color=yellow]Công Viên[/color]."

#. Character:`asami`
msgctxt "home_minato_exterior_202613fb"
msgid "...et voilà! Tu sais tout!"
msgstr "...Thế vậy đó ! Ông biết hết rồi !"

#. Character:`asami`
msgctxt "home_minato_exterior_fdc01946"
msgid "J'avais ça au fond de moi depuis tellement longtemps que ça me fait du bien d'enfin pouvoir te le dire."
msgstr "Bây lâu nay tui cứ giữ khư khư trong lòng, nói ra ông biết thấy nhẹ nhõm hơn biết bao."

#. Character:`asami`
msgctxt "home_minato_exterior_85a21146"
msgid "Si j'avais pas eu un petit coup de pression inattendu je pense que j'aurais fini par abandonner cette idée."
msgstr "Nếu mấy bữa nay tui không thấy căng thẳng thế này, chắc tui cũng hông nói ông bít đâu."

#. Character:`asami`
msgctxt "home_minato_exterior_f0f43b9e"
msgid "Tu n'es pas obligé de répondre tout de suite tu sais..."
msgstr "Ông đâu cần trả lời ngay, ông biết đấy..."

#. Character:`minato`
msgctxt "home_minato_exterior_c668875f"
msgid "Écoute... Je sais vraiment pas ce qui t'es passée par la tête mais je n'ai pas du tout envie de faire évoluer quoi que se soit..."
msgstr "Nghe này... Thực tôi không có biết bà đang nghĩ gì đâu, nhưng nếu được thì, sau chuyện này, tụ muốn tụi mình cứ...như vậy thôi à..."

#. Character:`minato`
msgctxt "home_minato_exterior_c9a58cb1"
msgid "C'est vrai qu'on se connaît depuis des années mais..."
msgstr "Đúng là hai đứa tụi mình biết nhau bao năm rồi, nhưng..."

#. Character:`minato`
msgctxt "home_minato_exterior_fcee4033"
msgid "Juste... Arrête ça, ça en deviant malaisant."
msgstr "Tém... lại thôi. Ngại bỏ mẹ đi được ấy."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_minato_exterior_32f89339"
msgid "Donc si je comprend bien tu n'as jamais ressentie quoi que se soit pour moi ?"
msgstr "Thế giờ nếu tui hiểu đúng thì, ông chưa bao giờ nhìn tui theo kiểu đó đúng không ?"

#. Character:`minato`
msgctxt "home_minato_exterior_7eb188b4"
msgid "Non pas vraiment... Tu es plus comme une sorte de petit chiot un peu foufou qui traîne dans mes jambes."
msgstr "Không hẳn... Bà cứ như con Chihuahua thích cuốn lấy chân tôi ấy."

#. Character:`minato`
msgctxt "home_minato_exterior_cafabc95"
msgid "Maintenant que tu as eu réponse je vais te laisser, j'ai énormément de travail."
msgstr "Thế giờ rõ ràng với nhau rồi thì, tôi đi đây. Nhà tôi còn bao việc."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_minato_exterior_6a1adb7c"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "home_minato_exterior_3c24abd1"
msgid "...Est-ce que ça va?"
msgstr "...Bà chị ổn không vậy?"

#. Character:`asami`
msgctxt "home_minato_exterior_e9c3cc51"
msgid "Tu es venue pour te moquer de moi?"
msgstr "Chẹp... Mầy tới... để cười vào mặt chị hử ?"

#. Character:`saito`
msgctxt "home_minato_exterior_0197a407"
msgid "Tu as eu le courage de te déclarer a quelqu'un que tu aimais depuis des années..."
msgstr "Bà chị đã can đảm tới mức dám bộc bạch với người mình thương suốt bao năm..."

#. Character:`saito`
msgctxt "home_minato_exterior_19f83f3c"
msgid "Je ne suis pas certain d'avoir autant de caractère que toi."
msgstr "Em không chắc là mình mạnh mẽ như bà chị đâu."

#. Character:`saito`
msgctxt "home_minato_exterior_13099fdd"
msgid "{{minato.n}} a agis comme un putain d'enfoiré, ce type ne mérite pas l'amour que tu lui porte!"
msgstr "{{minato.n}} cư xử như thằng daubuoi ý. Lão ta không xứng với tình cảm của bà chị đâu !"

#. Character:`asami`
msgctxt "home_minato_exterior_e73956bf"
msgid "Ca me fait si mal au coeur..."
msgstr "...Tim tôi đau quá man..."

#. Character:`saito`
msgctxt "home_minato_exterior_49de1721"
msgid "Est-ce que tu veux que je te raccompagne chez toi?"
msgstr "Có cần em... tôi hộ tống cô về không ?"

#. Character:`asami`
msgctxt "home_minato_exterior_7016d135"
msgid "Non merci..."
msgstr "Thôi dẹp..."

#. Character:`saito`
msgctxt "home_minato_exterior_03775ec8"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_minato_exterior_dd5d7da8"
msgid "Viens chez moi!"
msgstr "Tới nhà tôi đi !"

#. Character:`asami` | Attributes:`surprised`
msgctxt "home_minato_exterior_b414ef4b"
msgid "Quoi?!"
msgstr "Đờ phắc ?!"

#. Character:`saito`
msgctxt "home_minato_exterior_b22f509e"
msgid "Oui, demain je viens te chercher, et je te changer les idées."
msgstr "Ừ, mai cô tới nhà tôi đi, rồi tôi giúp cô thông thoáng đầu óc cho."

#. Character:`saito`
msgctxt "home_minato_exterior_9d9964e5"
msgid "{{minato.n}} est... Non après la façon dont il vient de et répondre... était mon meilleur ami."
msgstr "{{minato.n}}, nó là... Không, sau những lời nó nói ban nãy thì... nó ĐÃ TỪNG là bạn thân nhất của tôi."

#. Character:`saito`
msgctxt "home_minato_exterior_9b3255fc"
msgid "Je vais tout faire pour te faire oublier ce connard!"
msgstr "Tôi sẽ gắng hết mình để giúp cô quên đi lão ta !"

#. Character:`asami` | Attributes:`sad`
msgctxt "home_minato_exterior_9bdaa5fe"
msgid "Tu ferais ça pour moi ? Alors que tu ne me connais pas ?"
msgstr "Thật luôn đó ? Cậu sẵn sàng làm vậy, dù cho có chẳng biết tôi là ai ?"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_minato_exterior_7f07a5d9"
msgid "C'est pas un piège hein?!"
msgstr "Không phải 'trap', đúng không ?!"

#. Character:`saito`
msgctxt "home_minato_exterior_0335350c"
msgid "Je suppose qu'il n'y a qu'une seule façon pour toi de le découvrir."
msgstr "Chắc là sẽ chỉ có một cách để biết rồi"

#. Character:`asami`
msgctxt "home_minato_exterior_3acb57b7"
msgid "Idiot!"
msgstr "Ngốc !"

#. Character:`asami` | Attributes:`neutral`
msgctxt "t53398d412d"
msgid "[font_size=14]Je t'attendrais alors...[/font_size]"
msgstr "[font_size=14] Mình đợi nhau vậy...[/font_size]"

#. Character:`narrator`
msgctxt "home_minato_exterior_b60f01b2"
msgid "C'est quand même étrange, aussi longtemps que je me souvienne, je n'ai jamais vu la petite amie de {{minato.n}}."
msgstr "Nhưng mà lạ thật đấy. Theo như mình nhớ thì mình chưa bao giờ gặp mặt cô bồ của {{minato.n}}."

#. Character:`narrator`
msgctxt "home_minato_exterior_b48c1615"
msgid "Comme si..."
msgstr "Cứ như kiểu..."

#. Character:`narrator`
msgctxt "home_minato_exterior_ba596239"
msgid "Non, faut que j'arrête de trop réfléchir, ça remonte tout de même à plus de 30 ans pour moi. J'ai très bien pu oublier tout ça."
msgstr "Mà, chắc mình nghĩ quá rồi. Ở tiền kiếp, đã 30 năm trôi qua, sẽ không lạ khi mình đã quên sạch mọi chuyện."

#. Character:`natsume`
msgctxt "home_minato_exterior_da457302"
msgid "T'es qui et tu fais quoi à poireauter devant cette maison ?"
msgstr "Anh nghĩ anh là ai mà lại lảng vảng quanh đây?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_minato_exterior_ddfc0396"
msgid "Quoi ?"
msgstr "Sao?"

#. Character:`natsume` | Attributes:`neutral`
msgctxt "home_minato_exterior_64882998"
msgid "C'est pas chez toi ici, tire-toi !"
msgstr "Đây không phải nơi dành cho anh, hãy đi đi!"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_minato_exterior_b534e7e5"
msgid "Oui, je sais... Je suis venu voir {{minato.n}}."
msgstr "Phải, tôi biết... Tôi đến để tâm giao với {{minato.n}}."

#. Character:`natsume` | Attributes:`surprised`
msgctxt "home_minato_exterior_e3af0569"
msgid "Toi ?!"
msgstr "Anh sao?!"

#. Character:`natsume` | Attributes:`neutral`
msgctxt "home_minato_exterior_09203e10"
msgid "Pourquoi ? Qu'est-ce que tu lui veux ?"
msgstr "Vì sao? Anh muốn gì từ anh ấy?"

#. Character:`saito` | Attributes:`-happy`
msgctxt "home_minato_exterior_92d7e23f"
msgid "Euh... Pas grand-chose, c'est juste mon meilleur pote, je voulais simplement prendre des nouvelles et discuter un peu."
msgstr "Ờm... chẳng gì to tát lắm. Cậu ta là bạn chí cốt của tôi, tôi chỉ ghé qua thăm hỏi chút thôi."

#. Character:`natsume` | Attributes:`happy`
msgctxt "home_minato_exterior_bb6da547"
msgid "Arrête de mentir, il ne m'a jamais parlé de toi."
msgstr "Chắc chắn anh đang chém gió, tôi chưa nghe anh ấy nhắc đến anh dù chỉ một lần."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_minato_exterior_3db69bff"
msgid "Meh... Je ne sais pas comment je dois le prendre."
msgstr "Chẹp... tôi không biết nên đón nhận tin này thế nào nữa."

#. Character:`natsume` | Attributes:`angry`
msgctxt "home_minato_exterior_602d825a"
msgid "Bon, tire-toi maintenant ou tu vas avoir des problèmes."
msgstr "Nhưng mà, hãy đi đi, nếu không cậu sẽ thực sự lâm vào rắc rối đấy!"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_minato_exterior_3875095d"
msgid "Je bougerais pas d'ici avant d'avoir vu {{minato.n}}."
msgstr "Rắc rối sẽ không cản bước tôi tới gặp {{minato.n}}."

#. Character:`natsume` | Attributes:`neutral`
msgctxt "home_minato_exterior_d6b1edae"
msgid "Comme tu voudras..."
msgstr "Nếu anh muốn..."

#. Character:`saito`
msgctxt "home_minato_exterior_f21998d7"
msgid "Putain, c'est quoi ce bordel ?"
msgstr "Cái éo, chuyện này là sao?"

#. Character:`minato` | Attributes:`angry`
msgctxt "home_minato_exterior_aa2f0218"
msgid "Bon, c'est qui le connard qui cherche les emmerdes ?"
msgstr "Tên quỷ thần nào đi kiếm chuyện ở đây vậy?"

#. Character:`natsume`
msgctxt "home_minato_exterior_4728c19e"
msgid "C'est ce guignol qui prétend être ton meilleur ami."
msgstr "Là tên hề này đây đang muốn làm bạn chí cốt của anh."

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_minato_exterior_b4e69ca9"
msgid "..."
msgstr "..."

#. Character:`minato` | Attributes:`happy`
msgctxt "home_minato_exterior_b9d064c5"
msgid "Putain, mais non, c'est juste {{saito.n}}."
msgstr "À, đậu má, không đấy là {{saito.n}}."

#. Character:`natsume` | Attributes:`surprised`
msgctxt "home_minato_exterior_265bc4ec"
msgid "Tu le connais ?"
msgstr "Anh biết cậu ta ư?"

#. Character:`minato`
msgctxt "home_minato_exterior_7eead7c4"
msgid "Oui, oui, t'en fais pas."
msgstr "Ồ có chứ, đừng lo cho anh."

#. Character:`minato`
msgctxt "home_minato_exterior_34e4b1f6"
msgid "Tu peux nous laisser."
msgstr "Em có thể đi được rồi."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_minato_exterior_ec482c49"
msgid "Bah mon vieux, ça devient compliqué de te voir."
msgstr "Dạo này thật khó để gặp được mày, thằng bạn già."

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_minato_exterior_60ea880f"
msgid "Ouais, je sais... On est un peu à cran en ce moment."
msgstr "Ừa, tao biết... Nhà tao giờ đang hơi căng."

#. Character:`minato`
msgctxt "home_minato_exterior_7ff9ae99"
msgid "Bon, tu voulais quoi ?"
msgstr "Thế mầy đến đây làm chi?"

#. Character:`saito`
msgctxt "home_minato_exterior_54977133"
msgid "Pas grand-chose à vrai dire, savoir comment allait {{chiaki.n}}."
msgstr "Cũng chẳng có gì cả, thế dạo này {{chiaki.n}} thế nào rồi?"

#. Character:`saito`
msgctxt "home_minato_exterior_c616a4dc"
msgid "...et j'avoue être curieux, je pensais que tu m'aurais parlé de ta petite amie."
msgstr "...và bố mày hơi bị ấn tượng đấy, tao nghĩ là mày nên giới thiệu bố với con bồ của mày nhỉ."

#. Character:`minato`
msgctxt "home_minato_exterior_3fdc0b52"
msgid "{{chiaki.n}} va très bien et non, tu peux toujours courir pour sortir avec elle."
msgstr "{{chiaki.n}} thì vẫn khỏe, và chắc mày vừa chạm trán con bồ của tao."

#. Character:`saito`
msgctxt "home_minato_exterior_799829ff"
msgid "Hey, c'est pas ce q-"
msgstr "Ê đấy không phả-"

#. Character:`minato`
msgctxt "home_minato_exterior_92f584b1"
msgid "Quant à ma petite amie, tu viens de la voir."
msgstr "Còn về con bồ của tao, thì chắc mày vừa gặp."

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_minato_exterior_4e43ff82"
msgid "Tu veux dire que la blonde agressive, c'était elle ?"
msgstr "Mày muốn nói con sư tử Hà Đông ấy là bồ mày hử?"

#. Character:`minato` | Attributes:`happy`
msgctxt "home_minato_exterior_c771fb81"
msgid "Eh bien, c'est un peu réducteur de l'appeler la blonde agressive, mais oui."
msgstr "Má mày, coi chừng con \"sư tử Hà Đông\" đấy nhai đầu mày! Nhưng mà ừ."

#. Character:`minato`
msgctxt "home_minato_exterior_abc88435"
msgid "{{natsume.n}} !"
msgstr "{{natsume.n}}!"

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_minato_exterior_a3afe47d"
msgid "Je te présente {{saito.n}} qui est mon meilleur... ami."
msgstr "Anh giởi thiệu với em, {{saito.n}}, thằng... đồng chí cội gạo uống rượu ăn thề với anh."

#. Character:`minato`
msgctxt "home_minato_exterior_0253ce00"
msgid "On se connait depuis des années."
msgstr "Bọn anh quậy với nhau từ thời chim chưa mọc lông."

#. Character:`natsume` | Attributes:`happy`
msgctxt "home_minato_exterior_5286b1b2"
msgid "Ah oui, maintenant ça me revient, t'es la victime de la fac. {{saito.n}} le déchet."
msgstr "Àhhh tôi nhớ nè, ông là cái bao cát đấm bốc nổi nhất nhì cái đại học. {{saito.n}} đáy xã hội!"

#. Character:`minato` | Attributes:`happy`
msgctxt "home_minato_exterior_79c712c7"
msgid "Tu es une célébrité mon vieux."
msgstr "Mày nổi như gì, thằng chóa à."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_minato_exterior_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_minato_exterior_94010626"
msgid "Ravi... de faire ta connaissance."
msgstr "Rất vui...được gặp cô."

#. Character:`natsume` | Attributes:`neutral`
msgctxt "home_minato_exterior_32617b04"
msgid "Mouais, c'est ça..."
msgstr "Yeah, tôi cũng vậy..."

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_minato_exterior_a6936db3"
msgid "Bref, sans vouloir te laisser tomber, j'ai des choses importantes à faire donc je vais y aller."
msgstr "Mà, xin lỗi vì trả treo mầy, nhưng giờ tao có mấy công chuyện quan trọng phải làm rồi. Tao đi đây."

#. Character:`saito`
msgctxt "home_minato_exterior_ca113542"
msgid "Ouais, ouais, pas de soucis, à plus."
msgstr "Không sao, không sao. Chào nhá."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_minato_exterior_120257c7"
msgid "Putain, mais quelle salope. Je ne le crois pas..."
msgstr "Mẹ con điếm đấy, mình không thể tin được..."

#. Character:`saito`
msgctxt "home_minato_exterior_a014fc7b"
msgid "Et c'est enfoiré de {{minato.n}} qui ne dit rien..."
msgstr "Và tên cờ hó {{minato.n}} chẳng hé răng chuyện gì cả..."

#. Character:`saito`
msgctxt "home_minato_exterior_04b4660d"
msgid "Je ferais mieux de retrouver {{asami.n}} au parc."
msgstr "Mình nghĩ mình nên đi gặp {{asami.n}} ở Công Viên."

#. Character:`kimochi`
msgctxt "home_minato_exterior_770d2d36"
msgid "Mmh, je me demande si je peux lui faire signe..."
msgstr "Mhh, không biết mình có thể gọi hắn ta qua hỏi không..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "t2c6479f131"
msgid "Hey mais tu es le gars au laxatif !"
msgstr "Kìa, cái thằng thuốc ỉa chảy ?!"

#. Character:`saito`
msgctxt "t1de247ba37"
msgid "C'était toi qui en avait après {{chiaki.n}} ?"
msgstr "Mày là cái thằng bám đuôi {{chiaki.n}} ?"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_minato_exterior_2c15bfad"
msgid "Zut !"
msgstr "Cái đệt!"

#. Character:`kimochi`
msgctxt "home_minato_exterior_eb293e06"
msgid "Non, non, tu te trompes, je ne suis p-"
msgstr "Không không, anh nhầm rồi, tôi không phả-"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_minato_exterior_f61fd189"
msgid "Merde, {{minato.n}} avait raison, y'a bien un mec louche qui traine autour de sa maison."
msgstr "Cố tổ tiên sư, thằng {{minato.n}} sủa đúng thật, có một cái xác mang tâm hồn của điếm lượn lờ quanh đây."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_minato_exterior_f9f9132c"
msgid "Hey ! Je ne suis pas louche !"
msgstr "Này, trông tôi đáng nghi đến vậy sao!"

#. Character:`saito`
msgctxt "home_minato_exterior_e4e9bea0"
msgid "Sérieusement, mec ?"
msgstr "Anh sủa gì vậy?"

#. Character:`saito`
msgctxt "home_minato_exterior_56d6e0a1"
msgid "Tu fais quoi à attendre devant une maison qui n'est pas la tienne ?"
msgstr "Vậy giờ trả lời tôi, tại sao anh lại lảng vảng quanh một ngôi nhà không phải của mình?"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_minato_exterior_0babd186"
msgid "Je... Je suis fan de belles architectures contemporaines."
msgstr "Tôi...tôi là một fan của nghệ thuật kiến trúc đương đại."

#. Character:`saito`
msgctxt "home_minato_exterior_4d2eb4ae"
msgid "On est dans un lotissement, toutes les maisons se ressemblent."
msgstr "Trong khu phố này, nhà đéo nào cũng giống nhau cả."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_minato_exterior_96373a65"
msgid "Bon okay, tu m'as coincé, j'ai un vice caché, j'adore me masturber sur des murs en brique."
msgstr "Hầy, đành phải vậy thôi. Tôi thích...thủ dâm cạnh những bức tường gạch."

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_minato_exterior_6d04f7e8"
msgid "Quoi ?!"
msgstr "Mả cha tiên nhân?"

#. Character:`kimochi`
msgctxt "home_minato_exterior_aabb6a04"
msgid "Oui, c'est honteux, je sais, maintenant, tu ne voudrais pas me laisser le temps que je termine ?"
msgstr "Phải, tôi biết điều này thật đáng xấu hổ, nhưng giờ liệu anh có thể đi để tôi...xử xong không?"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_minato_exterior_58e28d3e"
msgid "Mais... C'est mort !"
msgstr "Ngáo cần vừa thôi, thằng dâm tặc !"

#. Character:`saito`
msgctxt "home_minato_exterior_66a9699c"
msgid "Bouge de là où j'appelle la police."
msgstr "Cút ngay đi trước khi tôi báo cảnh sát."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_minato_exterior_a21baec5"
msgid "...Merde, il arrive."
msgstr "...Bỏ mẹ, hắn ta đến rồi."

#. Character:`minato`
msgctxt "home_minato_exterior_f7d898cb"
msgid "TOI !"
msgstr "MÀY!"

#. Character:`minato`
msgctxt "home_minato_exterior_7c2fb48a"
msgid "Espèce de -"
msgstr "Thằng chó chết nhà mà-"

#. Character:`minato`
msgctxt "home_minato_exterior_7037d60f"
msgid "PUTAIN ! {{saito.n}} aide-moi à attraper ce putain de pervers !"
msgstr "CHÓ CHẾT! {{saito.n}}, giúp tao tóm cổ thằng dâm loạn đấy!"

#. Character:`saito`
msgctxt "home_minato_exterior_d1904bf8"
msgid "Je m'en charge, je l'ai vu se diriger vers le konbini."
msgstr "Hiểu ngay, tao thấy hắn chạy về phía chỗ Konbini."

#. Character:`saito`
msgctxt "talk_minato_e350e075"
msgid "J'espère au moins que cette fois-ci, il sera de meilleure humeur..."
msgstr "Hy vọng là cậu ta sẽ trở nên bớt nóng tính hơn..."

#. Character:`minato`
msgctxt "talk_minato_caaeead7"
msgid "[font_size=14]Mais bordel, qui c'est qui casse les couilles dès le matin ?![/font_size]"
msgstr "[font_size=14]Cái địt con mẹ nó chứ! Thằng chó điên nào đến phá mình lúc mới sáng bảnh mắt ra vậy?![/font_size]"

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_minato_6bb286cf"
msgid "Ça ne sera visiblement pas le cas..."
msgstr "Có vẻ như không phải vậy rồi..."

#. Character:`minato`
msgctxt "talk_minato_0121a9c0"
msgid "Bordel, c'est encore toi."
msgstr "Bà mẹ, là mày à."

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_minato_ba7cda5c"
msgid "Hey, comment ça va ?[w] Tu as pu retrouver le pervers ?"
msgstr "Kìa, nóng tính thế, mày ra sao rồi?[w] Đã bắt được thằng dâm tặc chưa?"

#. Character:`minato`
msgctxt "talk_minato_485bce58"
msgid "...Non, il a étrangement disparu."
msgstr "...Không, thằng chó đấy lại lủi đâu mất tăm."

#. Character:`minato` | Attributes:`suspicious`
msgctxt "talk_minato_d084da3d"
msgid "Comme s'il avait été aidé..."
msgstr "Cứ như kiểu có ai đó đang giúp nó..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_minato_8d1d0aab"
msgid "Hmm, étrange en effet."
msgstr "Đéo hiểu."

#. Character:`minato` | Attributes:`upset`
msgctxt "talk_minato_67af04a8"
msgid "...Bon, qu'est-ce que tu me veux ?"
msgstr "...Mày muốn gì từ tao nhể ?"

#. Character:`saito`
msgctxt "talk_minato_b9e2c8b3"
msgid "À vrai dire, j'ai un paquet de questions à te poser et je ne sais pas par où commencer."
msgstr "Nói thật thì tao có hơi nhiều câu hỏi cho mày, và tao không biết nên bắt đầu từ đâu."

#. Character:`minato`
msgctxt "talk_minato_828fd6c7"
msgid "Abrege, je suis assez occupé en ce moment et ça risque de durer."
msgstr "Nhanh mẹ mày lên, tao đây rất bận và chắc vẫn sẽ bận trong vài ngày nữa."

#. Character:`saito`
msgctxt "talk_minato_3d5d31ad"
msgid "Ça tombe bien."
msgstr "Vậy thì kịp lúc thật."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_minato_7fde83be"
msgid "Laisse-moi garder {{chiaki.n}} pour aujourd'hui."
msgstr "Để bố mày trông {{chiaki.n}} hôm nay cho."

#. Character:`saito`
msgctxt "talk_minato_b3bfa346"
msgid "Tu sembles occupé en ce moment et moi, j'ai beaucoup de temps libre."
msgstr "Trông mày có vẻ bận lắm, còn tao thì khá dư dả thời gain."

#. Character:`narrator`
msgctxt "talk_minato_05035d16"
msgid "Il n'a aucune raison de refuser."
msgstr "Thằng chóa này éo thể nào từ chối vì nó hợp lý quá đi mà."

#. Character:`minato` | Attributes:`suspicious`
msgctxt "talk_minato_1da33c16"
msgid "Non. Je préfère qu'elle reste avec moi."
msgstr "Không được, tao cần con bé ở cùng tao."

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_minato_8f3ab287"
msgid "M-"
msgstr "Nhưn-"

#. Character:`minato`
msgctxt "talk_minato_0a1030c8"
msgid "Point final."
msgstr "Ngậm cái mồm lại đã."

#. Character:`minato` | Attributes:`upset`
msgctxt "talk_minato_68667502"
msgid "N'insiste pas {{saito.n}}, je n'ai aucune envie de me justifier, j'ai décidé que c'était ainsi, rentre bien toi ça dans le crâne."
msgstr "Đừng phàn nàn, {{saito.n}}, tao không muốn giải thích. Tao đã đưa ra quyết định của mình, hy vọng mày cho nó lọt tai."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_minato_bfc9c763"
msgid "...Tu as changé, tu te comportes comme un sombre connard."
msgstr "...Mày thay đổi nhiều quá. Mày suốt ngày cứ hành xử như một thằng đểu cáng vậy."

#. Character:`saito`
msgctxt "talk_minato_594468d0"
msgid "Pourquoi tu m'as raconté des conneries ?"
msgstr "Tại sao mày xàm lòn với tao?"

#. Character:`saito`
msgctxt "talk_minato_17eb73b2"
msgid "Tu n'as jamais été voir les trois thugs pour leur dire d'arrêter de me casser les couilles."
msgstr "Mày chưa bao giờ bảo lũ côn đồ ngưng hành hung tao."

#. Character:`minato`
msgctxt "talk_minato_83ffb293"
msgid "..."
msgstr "..."

#. Character:`saito`
msgctxt "talk_minato_8ca9df88"
msgid "Sans oublier le fait que tu me traites de déchet."
msgstr "Chưa kể đến chuyện mày gọi tao là thằng rác rưởi nữa."

#. Character:`saito`
msgctxt "talk_minato_bfb002a3"
msgid "C'est quoi ton problème, on n'est pas censé être meilleurs potes ?"
msgstr "Dạo này mày bị gì vậy? Chẳng phải tao với mày là bạn chí cốt sao?"

#. Character:`minato`
msgctxt "talk_minato_20f2e72f"
msgid "Bon, tu me saoules."
msgstr "Hầy, mày đang làm phiền tao đấy."

#. Character:`minato`
msgctxt "talk_minato_ef0737f7"
msgid "Tu vas arrêter de chouiner ?"
msgstr "Ngừng ăn vạ nữa được không?"

#. Character:`saito`
msgctxt "talk_minato_18ef17b8"
msgid "...Pourquoi, pourquoi prétendre être pote ?"
msgstr "...Tại sao, tại sao, lại lừa dối tao?"

#. Character:`saito`
msgctxt "talk_minato_183e545e"
msgid "Être sadique ça t'excite, c'est ça ?"
msgstr "Thấy tao bị khổ dâm đến chết, mày thích vậy sao?"

#. Character:`minato` | Attributes:`neutral`
msgctxt "talk_minato_95d40870"
msgid "Tu veux savoir pourquoi ?"
msgstr "Mày muốn biết tại sao không?"

#. Character:`minato` | Attributes:`happy`
msgctxt "talk_minato_9ece827a"
msgid "Parce que je m'ennuyais..."
msgstr "Bởi vì tao chán đóaaa..."

#. Character:`saito`
msgctxt "talk_minato_e5c10cf2"
msgid "Tu te fous de ma g-"
msgstr "Mày lại chơi ta-"

#. Character:`minato`
msgctxt "talk_minato_7661a984"
msgid "Je me faisais chier alors, j'ai pris la fragile petite merde que tu étais sous mon aile, pour lui donner l'envie de ne pas se suicider trop vite."
msgstr "Tao chán chết đi được, và tao gợi ra cái ý tưởng rủ lòng thương cho cục cứt thối tha như mày đang cúp đuôi sau lưng tao để ngày mốt ngày hai mày không nhảy cầu chết mẹ."

#. Character:`minato` | Attributes:`angry`
msgctxt "talk_minato_0a9d5fd3"
msgid "Mais ça ne m'amuse plus, tu m'agaces, tu poses des questions sans cesse."
msgstr "Nhưng giờ mày đéo vui nữa. Mày lúc nào cũng làm phiền tao, và hỏi quá nhiều câu hỏi."

#. Character:`minato`
msgctxt "talk_minato_858692f3"
msgid "J'ai qu'une envie, c'est de te briser la mâchoire."
msgstr "Điều duy nhất tao muốn bây giờ đó là bẻ cái mõm lắm điều của mày."

#. Character:`narrator`
msgctxt "talk_minato_6c83ee0d"
msgid "Le pervers avait raison depuis le début."
msgstr "Thằng dâm chó nó nói đúng ngay từ đầu."

#. Character:`narrator`
msgctxt "talk_minato_7bd56bbe"
msgid "{{minato.n}} n'est qu'un putain de psychopathe."
msgstr "{{minato.n}} là một thằng tâm thần loạn óc."

#. Character:`narrator`
msgctxt "talk_minato_41e1bd9e"
msgid "Je dois trouver un moyen de tirer {{chiaki.n}} de là."
msgstr "Mình phải tìm gỡ được {{chiaki.n}} ra khỏi thằng này."

#. Character:`minato`
msgctxt "talk_minato_31ff4a77"
msgid "Ne t'approche plus d'ici ni de moi ni de ma petite sœur."
msgstr "Đừng bao giờ quay lại đây nữa, đến gần tao hay em gái tao."

#. Character:`saito`
msgctxt "talk_minato_12557f90"
msgid "Sinon quoi ?"
msgstr "Nếu không thì ?"

#. Character:`minato` | Attributes:`neutral`
msgctxt "talk_minato_39238b81"
msgid "Crois-moi, tu n'as pas envie de savoir, mais ça inclut toi et tous tes proches."
msgstr "Tin tao đi khi tao nói mày không nên biết, nhưng cái chuyện tàn ác ấy bao gồm cả mày và người thân của mày."

#. Character:`minato` | Attributes:`upset`
msgctxt "talk_minato_128ef5ee"
msgid "Maintenant qu'on a mis les choses au clair, tire-toi."
msgstr "Mọi chuyện giờ đã rõ ràng rồi, giờ cút đi."

#. Character:`narrator`
msgctxt "talk_minato_1fbdf0eb"
msgid "Je suis tellement déçu..."
msgstr "Cực đại thất vọng..."

#. Character:`narrator`
msgctxt "talk_minato_246752c5"
msgid "Toutes ces années à faire semblant."
msgstr "Suốt bao nhiêu năm lừa dối mình."

#. Character:`narrator`
msgctxt "talk_minato_07cd3b8d"
msgid "Merde, j'ai tellement la haine."
msgstr "Cái con chó ấy, làm mình sôi máu quá."

#. Character:`narrator`
msgctxt "talk_minato_94edb098"
msgid "Je dois sérieusement réfléchir à un plan."
msgstr "Mình thật sự cần phải vắt óc ra một kế hoạch."

#. Character:`saito`
msgctxt "talk_minato_1b9ff85a"
msgid "Bon, inutile de rester ici plus longtemps."
msgstr "Đằng nào thì, ở lại đây cũng chẳng để làm gì nữa."

#. Character:`saito`
msgctxt "talk_minato_7965cec6"
msgid "{{asami.n}} et {{natsume.n}} doivent m'attendre au parc."
msgstr "{{asami.n}} và {{natsume.n}} hẳn đang chờ mình ở công viên."

#. Character:`saito`
msgctxt "talk_minato_1db42ff9"
msgid "Je suis certain qu'il sera content de me voir."
msgstr "Mình chắc chắn cái thằng lẩm cẩm ấy sẽ vui lên khi thấy mình."

#. Character:`minato`
msgctxt "talk_minato_bcb86e50"
msgid "[font_size=14]Putain, qu'est-ce qu'il fout là ?![/font_size]"
msgstr "[font_size=14]Bà nội, thằng chó nào phá nhà tao đấy!?[/font_size]"

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_minato_b02f4aa7"
msgid "Hey ! Comment tu vas ? J'espère que je ne te dérange pas ?"
msgstr "Này, mày ra sao rồi ông bạn già? Tao không làm phiền mày chứ?"

#. Character:`minato`
msgctxt "talk_minato_74c8ce88"
msgid "En fait, si, j'attends du monde, si tu pouvais t'en aller rapidement, ça m'arrangerait."
msgstr "Thực ra là có, tao đang chờ khách và tao xin lỗi nhưng tao không thể tiếp mày được."

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_minato_4006a372"
msgid "Quoi, t'est sérieux ?"
msgstr "Ơ vãi lòn?"

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_minato_4a60a253"
msgid "C'est ta petite amie, t'as honte qu'elle te voit avec moi, c'est ça ?"
msgstr "À, tao biết rồi, là con ghệ của mày! Mày mà thấy tao ở với con ghệ của mày thì chắc mày chỉ muốn cắm đầu xuống đất thôi nhể?"

#. Character:`minato` | Attributes:`angry`
msgctxt "talk_minato_dc476080"
msgid "Putain {{saito.n}}, ferme ta gueule et casse-toi !"
msgstr "Bà mẹ thằng chó {{saito.n}}, ngậm cái mõm lại rồi biến mẹ mày đi!"

#. Character:`narrator`
msgctxt "talk_minato_3ea58927"
msgid "Merde, c'est quoi son problème ?"
msgstr "Hầy, nó bị làm sao vậy?"

#. Character:`narrator`
msgctxt "talk_minato_f3f3a065"
msgid "Je ne le reconnais plus du tout."
msgstr "Mình chẳng hề nhận ra nó luôn."

#. Character:`minato`
msgctxt "talk_minato_4b55a6c4"
msgid "Allez dégage, reste pas là !"
msgstr "Thôi nào, mày làm phước phắn nhờ cho tao cái!"

#. Character:`saito`
msgctxt "talk_minato_03775ec8"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_minato_88fb0df9"
msgid "Peut-être qu'{{asami.n}} en saura davantage sur le comportement étrange de {{minato.n}}."
msgstr "Có lẽ {{asami.n}} sẽ biết hơn về cái tính cách hơi thất thường của cái thằng {{minato.n}} bị ẩm i xê này."

#. Character:`saito`
msgctxt "talk_minato_cadc960c"
msgid "Bien que je n'aie pas trop envie de lui parler de son ancien crush..."
msgstr "Mặc dù mình không muốn lắm phải đề cập đến crush cũ của cô ấy..."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_minato_a74c0302"
msgid "Merde, pourquoi faut-il que je me prenne la tête avec ça ?"
msgstr "Bà cha mả tổ, việc gì mình phải nghĩ nhiều nhỉ?"

#. Character:`saito`
msgctxt "te94cb08504"
msgid "On dirait que personne n'est là. Je devrais revenir durant la journée."
msgstr "Có vẻ như không có ai ở nhà. Chắc mình nên tới vào buổi sáng thì hơn."

#. Character:`saito`
msgctxt "t16c3bbc574"
msgid "Il est trop tard. Je devrais revenir durant la journée."
msgstr "Muộn quá rồi. Chắc để sáng hôm sau vậy."

#. Character:`kimochi`
msgctxt "home_minato_exterior_4623554b"
msgid "...Avec un peu de chance, je p-"
msgstr "...Với một chút may mắn mình có thể..."

#. Character:`saito`
msgctxt "home_minato_exterior_8a51fa08"
msgid "Hey, je peux savoir ce que tu fais là ?"
msgstr "Anh, anh đang làm gì ở đây?"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_minato_exterior_73906ac7"
msgid "Woah !"
msgstr "Này!"

#. Character:`kimochi`
msgctxt "home_minato_exterior_22cce722"
msgid "Ça va pas la tête de s'approcher d'un mec par-derrière de cette façon ?!"
msgstr "Anh bị làm sao vậy, hù người ta từ đằng sau như thế?"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_minato_exterior_d5d02932"
msgid "Je ne sais pas ce que tu faisais, mais je connais la personne qui habite là et tu n'as rien à faire ici !"
msgstr "Tôi không biết anh định làm gì, nhưng tôi quen biết người chủ ngôi nhà này, và anh không có công chuyện gì ở đây!"

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_minato_exterior_91f8527a"
msgid "Bon, je peux tout expliquer, mais peut-on juste en discuter ailleurs s'il te plait ?"
msgstr "Tôi có thể giải thích cho anh mọi thứ! Nhưng liệu chúng ta có thể đến một chỗ nào đó kín đáo hơn?"

#. Character:`saito`
msgctxt "home_minato_exterior_22a7770d"
msgid "...Okay, suis-moi."
msgstr "...Đi theo tôi."

#. Character:`natsume`
msgctxt "home_minato_exterior_26ed3276"
msgid "... Il ne devrait plus tarder."
msgstr "... Anh ta sẽ đến sớm thôi."

#. Character:`minato`
msgctxt "home_minato_exterior_3ce2f812"
msgid "Fais-le patienter juste assez p-"
msgstr "Chỉ cần để anh ta đợi tới kh-"

#. Character:`saito`
msgctxt "home_minato_exterior_b55ce602"
msgid "Hey {{minato.n}} tu tombes bien, j'avais un truc à te d-"
msgstr "Này, {{minato.n}}, thật mừng vì đã gặp được mày. Chỉ là tao có vài chuyện muố-"

#. Character:`minato` | Attributes:`upset`
msgctxt "home_minato_exterior_762fff47"
msgid "Putain {{saito.n}} dégage d'ici c'est pas le moment !"
msgstr "Biến mẹ mày đi chứ, {{saito.n}}, nhà đang bao việc !"

#. Character:`saito`
msgctxt "home_minato_exterior_eb593743"
msgid "Quoi ?! Mais je..."
msgstr "Cái ?! Thế nhưng mà…"

#. Character:`natsume`
msgctxt "home_minato_exterior_263c92eb"
msgid "C'est qui lui ?"
msgstr "Ai vậy hở anh ?"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_minato_exterior_d8126631"
msgid "Son meilleur ami... enfin je le pensais."
msgstr "Bạn thân nhất của ảnh... kiểu kiểu vậy."

#. Character:`natsume`
msgctxt "home_minato_exterior_3638be4c"
msgid "Ton meilleur ami ?"
msgstr "Bạn thân nhất của anh á ?"

#. Character:`minato`
msgctxt "home_minato_exterior_dd4c87b5"
msgid "Bordel... T'es encore coincé avec ça ?"
msgstr "Mẹ, vãi cả loằn... Sao mày dai như đỉa vậy ?"

#. Character:`minato`
msgctxt "home_minato_exterior_b1834627"
msgid "Si je t'accordais un peu d'attention c'était seulement par curiosité."
msgstr "Tao mới vỗ vai, nắm chân nắm tay mày có tí mà mày đã tưởng bở rồi."

#. Character:`minato`
msgctxt "home_minato_exterior_0e810062"
msgid "Tu me fais surtout pitié."
msgstr "Tội nghiệp, thật đấy."

#. Character:`saito`
msgctxt "home_minato_exterior_c7d990e9"
msgid "C'est donc ça le vrai {{minato.n}} ? Tu parles d'une déception."
msgstr "Rốt cục thì đây là {{minato.n}} thật nhỉ ? Thất vọng làm sao."

#. Character:`saito`
msgctxt "home_minato_exterior_fd8150bc"
msgid "Finalement je suis content que tu aies remballé {{asami.n}}."
msgstr "Mà kể ra, tao mừng vì mày đã từ chối {{asami.n}}."

#. Character:`saito`
msgctxt "home_minato_exterior_bf002834"
msgid "La laisser avec un type comme toi aurait été une erreur monumentale !"
msgstr "Gắn cô ấy với loại như mày khác gì hoa lài cắm bãi phân trâu !"

#. Character:`natsume`
msgctxt "home_minato_exterior_4c256007"
msgid "{{minato.n}}... On n'a plus de temps à p-"
msgstr "{{minato.n}} ơi... Sắp muộn rồi, ta ph-"

#. Character:`minato`
msgctxt "home_minato_exterior_5aed4fa8"
msgid "Je sais, laisse-moi finir avec ce déchet et j'arrive !"
msgstr "Anh biết, nhưng để anh xử lý thằng chó đẻ này đã !"

#. Character:`minato`
msgctxt "home_minato_exterior_1b504790"
msgid "Je vais être clair avec toi et je te conseille de bien m'écouter."
msgstr "Tao sẽ chỉ nói một lần thôi, và tao khuyến nghị mày nghe cho kĩ này."

#. Character:`minato`
msgctxt "home_minato_exterior_64c3e72d"
msgid "Ne viens plus me faire chier, ou chouiner comme tu le fais d'habitude."
msgstr "Đừng có bao giờ tới đây làm phiền, làm nũng hay ăn vạ nữa."

#. Character:`minato`
msgctxt "home_minato_exterior_c1a12759"
msgid "Ton existence même m'insupporte, tu comprends ça ?"
msgstr "Tao không ngửi nổi khi phải thở chung bầu không khí với một nùi rác, mày rõ chưa hả ?"

#. Character:`saito`
msgctxt "home_minato_exterior_48326db9"
msgid "... Va te faire foutre !"
msgstr "... Con mẹ mày chứ !"

#. Character:`minato`
msgctxt "home_minato_exterior_58464752"
msgid "Donc comme ça {{asami.n}} t'a tapé dans l'œil hein ?!"
msgstr "Vậy tức là, con {{asami.n}} có ý với thằng này nhỉ ?"

#. Character:`minato`
msgctxt "home_minato_exterior_36f3b871"
msgid "Intéressant..."
msgstr "Rất thú vị..."

#. Character:`takeo`
msgctxt "home_minato_exterior_a8cdfa3e"
msgid "Mec, t'es un fou de venir penser que tu peux te réfugier ici."
msgstr "Chỉ có một thằng điên mới đi chui vào đây."

#. Character:`kenji`
msgctxt "home_minato_exterior_5d8812f7"
msgid "Ce type est suicidaire."
msgstr "Thằng này thích chết rồi."

#. Character:`nobu`
msgctxt "home_minato_exterior_aa8bd64e"
msgid "CHOPEZ-LE AU LIEU DE RIEN BRANLER BANDE DE CONS !"
msgstr "ĐI TÓM CỔ NÓ ĐI, LŨ LƯỜI BIẾNG!"

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_minato_exterior_0178f77f"
msgid "Nous y voilà..."
msgstr "Tới rồi đây..."

#. Character:`kimochi`
msgctxt "home_minato_exterior_f5f1dde7"
msgid "Allez {{chiaki.n}}, regarde par la fenêtre, s'il te plaît !"
msgstr "Thôi nào {{chiaki.n}}! Hãy nhìn lên cửa sổ đi, làm ơn !"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_minato_exterior_dbcd191e"
msgid "Dépêche-toi, si je me fais choper ici, je suis m-"
msgstr "Nhanh lên em ơi ! Nếu như bị bắt ở đây, anh chết mấ-"

#. Character:`minato` | Attributes:`angry`
msgctxt "home_minato_exterior_23e8c791"
msgid "T'es mort !"
msgstr "Mày chết rồi đấy !"

#. Character:`minato`
msgctxt "home_minato_exterior_fec0785e"
msgid "Depuis le temps que j'attends de te tomber dessus !"
msgstr "Tao đã muốn tóm cổ mày từ lâu lắm rồi !"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_minato_exterior_21286aff"
msgid "Mais tu ne seras pas assez rapide cette fois-ci non plus !"
msgstr "Nhưng sao mà mày chạy nhanh hơn tao được !"

#. Character:`minato` | Attributes:`upset`
msgctxt "home_minato_exterior_01e5369e"
msgid "Pas cette fois !"
msgstr "Sẽ không còn có chuyện đấy nữa !"

#. Character:`minato`
msgctxt "home_minato_exterior_6e06068c"
msgid "Emmenez-moi ce bâtard-là où vous savez..."
msgstr "Đưa thằng quần què này tới chỗ-mà-bọn-bay-biết-là-chỗ-nào-đấy cho tao..."

#. Character:`minato`
msgctxt "home_minato_exterior_f979fc24"
msgid "Et ne le quittez pas du regard jusqu'à ce que j'arrive."
msgstr "Và đừng rời mắt khỏi nó cho tới khi tao quay lại."

#. Character:`minato`
msgctxt "home_minato_exterior_d11a25d4"
msgid "J'ai envie de lui faire regretter de m'avoir pris la tête aussi longtemps."
msgstr "Tao muốn cho nó hối hận vì đã làm phiền tao suốt thời gian qua."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_minato_exterior_a0b14ea5"
msgid "On peut peut-être s'arranger..."
msgstr "Biết đâu chúng ta có thể thương lượng..."

#. Character:`kimochi`
msgctxt "home_minato_exterior_4a0fbcf7"
msgid "Je suis sûr qu'on pourrait trouver un arrangement et..."
msgstr "Đổi chác lấy cái gì đó, và..."

#. Character:`takeo`
msgctxt "home_minato_exterior_c2dc5b31"
msgid "Ferme ta gueule !"
msgstr "Câm con mẹ cái mõm mày vào !"

#. Character:`minato`
msgctxt "home_minato_exterior_6c01f79e"
msgid "Allez, emmenez-le et soyez discrets."
msgstr "Đi đi, cầm lấy nó, và đi sao cho bí mật."

#. Character:`minato`
msgctxt "home_minato_exterior_392a6084"
msgid "... et donc tu me dis qu'elle t'a forcé à prendre les trois doses et regarder un portrait en photo ?!!"
msgstr "...Thế giờ anh bảo tôi là con bé đấy bắt anh uống ba liều rồi buộc anh nhìn vào ảnh của ai đó hở ?!"

#. Character:`akira`
msgctxt "home_minato_exterior_9a528151"
msgid "Oui, c'est ça."
msgstr "Ừm, đúng rồi."

#. Character:`minato` | Attributes:`happy`
msgctxt "home_minato_exterior_52d56edf"
msgid "Hahahaha ! Magnifique, je n'aurais jamais pensé que ça pouvait fonctionner avec une photo !"
msgstr "Hahahaha! Hảo vãi chưởng. Tôi không ngờ là nó cũng hoạt động được bằng một bức ảnh !"

#. Character:`minato` | Attributes:`suspicious`
msgctxt "home_minato_exterior_9f786751"
msgid "Il était présent dans la pièce à ce moment, ce qui explique pourquoi l'effet a fonctionné."
msgstr "Đằng nào thì thằng lồn đấy cũng chung phòng với tôi, chắc đó là lý do tại sao nó hoạt động."

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_minato_exterior_b642634f"
msgid "Ça me donne plein d'idées pour la suite des évènements..."
msgstr "Tôi nghĩ ra được nhiều ý tưởng hay ho đấy..."

#. Character:`akira`
msgctxt "home_minato_exterior_6d0e29e2"
msgid "Bon... Je suis content que ça te plaise, mais je ne veux pas rester comme ça..."
msgstr "Rồi... Mừng là anh bạn thích điều đó, nhưng thực sự tôi không muốn bị như này..."

#. Character:`akira`
msgctxt "home_minato_exterior_3d890161"
msgid "J'ai qu'une envie, c'est... c'est de le..."
msgstr "Tôi chỉ muốn... chỉ muốn..."

#. Character:`minato` | Attributes:`happy`
msgctxt "home_minato_exterior_1cefb50f"
msgid "Cherches pas, tu l'as dans la peau. Plus tu résistes, plus l'envie sera forte."
msgstr "Đừng cố. Càng cố chống cự thì sẽ càng ham muốn."

#. Character:`minato`
msgctxt "home_minato_exterior_bd7ef313"
msgid "En plus, tu n'as pas de chance, j'ai récemment découvert que plus la personne est détestée par celle qui absorbe la drogue, plus l'effet est puissant."
msgstr "Với cả, anh khó sống rồi. Tôi vừa mới tìm hiểu và biết được rằng đối tượng càng bị ghét bao nhiêu thì tác dụng của thuốc càng mạnh bấy nhiêu."

#. Character:`minato`
msgctxt "home_minato_exterior_9f820db4"
msgid "À contrario, plus la personne qui prend la drogue à déjà des sentiments, plus l'effet est presque anecdotique."
msgstr "Tương tự vậy thì, cảm xúc dành cho đối tượng càng mạnh mẽ, thì ảnh hưởng của thuốc càng lớn."

#. Character:`minato`
msgctxt "home_minato_exterior_9d64ee2b"
msgid "Hahaha ! Rappelle-moi, à quel point tu le haïssais ?"
msgstr "Hahaha! Lại nhớ anh thù nó tới mức nào chứ ?"

#. Character:`akira`
msgctxt "home_minato_exterior_a6aa04ea"
msgid "..."
msgstr "..."

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_minato_exterior_5223a845"
msgid "Allez, tire pas la gueule, je veux bien te donner le remède !"
msgstr "Thôi nào, đừng cáu bẳn tới vậy. Tôi có cách giải đây !"

#. Character:`akira` | Attributes:`angry`
msgctxt "home_minato_exterior_57215073"
msgid "Y'a un remède ?! Pourquoi tu l'as pas dit avant !"
msgstr "Có cách giải sao ? Sao anh không nói sớm ?!"

#. Character:`minato`
msgctxt "home_minato_exterior_78d692fc"
msgid "Pas dans le sens où tu l'entends, mais ça fonctionnera."
msgstr "Ừ thì, không giống như cách anh nghĩ lắm, nhưng mà dùng được."

#. Character:`akira` | Attributes:`neutral`
msgctxt "home_minato_exterior_129164e9"
msgid "Dis-moi ce que c'est... Je suis prêt à faire n'importe quoi."
msgstr "Nói đi... Gì tôi cũng làm."

#. Character:`minato` | Attributes:`happy`
msgctxt "home_minato_exterior_2f70a5ad"
msgid "C'est tout ce que je voulais savoir."
msgstr "Đó là tất cả những gì tôi muốn nghe."

#. Character:`akira`
msgctxt "home_minato_exterior_8944804e"
msgid "Alors ?"
msgstr "Thế ?"

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_minato_exterior_50a0fabf"
msgid "La mort..."
msgstr "Chết..."

#. Character:`akira` | Attributes:`angry`
msgctxt "home_minato_exterior_8dd03b95"
msgid "Quoi ?! Tu veux dire que je dois mourir pour être guéri, tu crois que c'est ce que j'ai envie d'entendre ?!"
msgstr "Đờ phắc ?! Ý anh là phải chết mới chữa được sao ?! Thế thì chữa làm con cặc gì nữa ?!"

#. Character:`minato`
msgctxt "home_minato_exterior_0c41db89"
msgid "Non... Pas ta mort. La sienne."
msgstr "Không... không phải anh chết. Thằng kia chết."

#. Character:`minato`
msgctxt "home_minato_exterior_4adcdafc"
msgid "Tue {{saito.n}} de tes propres mains et regarde-le mourir."
msgstr "Giết {{saito.n}} bằng chính bàn tay của anh và nhìn nó giãy chết."

#. Character:`minato`
msgctxt "home_minato_exterior_a1f7781f"
msgid "L'effet s'estompera alors très vite pour finalement disparaître."
msgstr "Hiệu ứng của thuốc sẽ yếu dần đi, sau đó biến mất."

#. Character:`minato`
msgctxt "home_minato_exterior_fe7c80a3"
msgid "Les tests ont été assez concluants à ce niveau-là."
msgstr "Thử nghiệm lâm sàng khá đảm bảo phương pháp này."

#. Character:`akira` | Attributes:`arrogant`
msgctxt "home_minato_exterior_2856ffa0"
msgid "Donc, pour me sortir de cette situation... Je dois tuer {{saito.n}} ?"
msgstr "Vậy để thoát khỏi tình cảnh này... Tôi chỉ cần giết {{saito.n}}?"

#. Character:`minato`
msgctxt "home_minato_exterior_f73a5fe5"
msgid "Exactement !"
msgstr "Chuẩn luôn !"

#. Character:`akira`
msgctxt "home_minato_exterior_228fdae6"
msgid "Hahaha, c'est le meilleur remède qui soit !"
msgstr "Hahaha, đó là cách chữa tốt nhất trần gian !"

#. Character:`natsume`
msgctxt "home_minato_exterior_ee0b819e"
msgid "Tu vas le laisser faire ?"
msgstr "Anh cứ để anh ấy làm vậy sao ?"

#. Character:`minato` | Attributes:`happy`
msgctxt "home_minato_exterior_83bb2b00"
msgid "Pourquoi je m'interposerai ?"
msgstr "Can thiệp làm gì ?"

#. Character:`natsume`
msgctxt "home_minato_exterior_0892097e"
msgid "...[w] Non, comme ça."
msgstr "..[w] Không có gì cả. Tò mò thôi."

#. Character:`minato` | Attributes:`upset`
msgctxt "home_minato_exterior_a84e0af6"
msgid "Allez, on a du boulot !"
msgstr "Thôi nào, chúng ta có việc phải làm !"

#. Character:`natsume` | Attributes:`shame`
msgctxt "home_minato_exterior_a9b819b1"
msgid "...[w] Putain {{saito.n}}, tu fais chier. Tu vas encore m'attirer des ennuis !"
msgstr "...[w] Cái con mẹ, {{saito.n}}, anh đang làm tôi bực mình đấy, Anh sẽ lại khiến ta ăn cám nữa thôi !"

