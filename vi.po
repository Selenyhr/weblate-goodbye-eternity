#. Character:`saito`
msgctxt "park_6877ef6e"
msgid "C'est ça ton coin tranquille ?"
msgstr "lựa chọn đúng hở ?"

#. Character:`noriko`
msgctxt "park_2cc53ccc"
msgid "Non idiot ! Il faut s'enfoncer un peu plus loin..."
msgstr "Không, ngố ạ ! Xa thêm chút nữa..."

#. Character:`saito`
msgctxt "park_24d5b7f3"
msgid "Plus loin ?"
msgstr "Xa hơn nữa á ?"

#. Character:`noriko` | Attributes:`cute`
msgctxt "park_cda60b0d"
msgid "Tu passes ton temps à courir autour tous les matins et tu ne t'en es jamais aperçu ?"
msgstr "Anh suốt ngày chạy tới đứt hơi quanh đây mà anh vẫn chưa nhận ra sao ?"

#. Character:`noriko`
msgctxt "park_f568c2ef"
msgid "Tu me fais de la peine !"
msgstr "Đáng thương quá anh à !"

#. Character:`noriko`
msgctxt "park_238d9a67"
msgid "Allez viens !"
msgstr "Nhanh lên anh ơi !"

#. Character:`macumba` | Attributes:`sad`
msgctxt "ta83d00658f"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`happy`
msgctxt "t91222cb41e"
msgid "Et bien alors ?"
msgstr "Có chuyện gì hở anh ?"

#. Character:`macumba`
msgctxt "t008a71299f"
msgid "Oh c'est toi petit frère ?"
msgstr "A, là người anh em đấy à ?"

#. Character:`saito`
msgctxt "tbccaa550e5"
msgid "Tu n'as pas l'air dans ton assiette, tout va bien ?"
msgstr "Anh trông không được khỏe lắm nhỉ ?"

#. Character:`macumba`
msgctxt "t7319812b8c"
msgid "Je ne sais pas comment l'expliquer mais..."
msgstr "Người anh em không biết đâu chứ ..."

#. Character:`macumba`
msgctxt "t8fbfdb1872"
msgid "J'ai un mauvais pressentiment."
msgstr "Có linh cảm chẳng lành rồi đây."

#. Character:`saito` | Attributes:`surprised`
msgctxt "t391fe3af20"
msgid "Vraiment ?"
msgstr "Thật ạ ?2"

#. Character:`narrator` | Attributes:`upset`
msgctxt "tefb8b21273"
msgid "C'est vrai que c'est à peu près à ce moment qu'{{asami.n}} avait disparue."
msgstr "Hình như là cũng vào tầm khoảng thời gian này thì {{asami.n}} đột ngột mất tích."

#. Character:`narrator`
msgctxt "tddbcc9a569"
msgid "Et {{macumba.n}} avait fait le parfait bouc emissaire."
msgstr "Và thế là mọi tội ác bị đổ dồn lên {{macumba.n}}."

#. Character:`narrator`
msgctxt "t6255630f10"
msgid "La police lui était tombée dessus sans qu'il puisse se défendre."
msgstr "Anh ấy bị cảnh sát áp giải nhanh đến độ chẳng có cơ hội để lên tiếng."

#. Character:`narrator`
msgctxt "tae6351dfc2"
msgid "Et on n'a plus jamais entendu parler de lui après..."
msgstr "Poof một phát như biến thành bọt biển, tan ra trong sóng cập bờ..."

#. Character:`narrator`
msgctxt "t5bdcd34e02"
msgid "Je ne sais même pas ce qu'il est advenu de lui apères ça."
msgstr "Đến nỗi chẳng ai còn biết tin tức gì về ảnh kể từ đó."

#. Character:`narrator`
msgctxt "t7a6063d899"
msgid "J'ose esperer avoir fait assez de vague autour de moi pour modifier le cour des évenements."
msgstr "Hi vọng là anh ấy giao du đủ với mình để tránh mọi tai bay vạ gió."

#. Character:`macumba` | Attributes:`happy`
msgctxt "t99cedfe48c"
msgid "C'est bon, c'est passé !"
msgstr "A, không sao, linh cảm hết rồi !"

#. Character:`macumba` | Attributes:`neutral`
msgctxt "t55b9ff4efc"
msgid "Tout ça ne doit pas nous empêcher de transpirer."
msgstr "Đừng để một ngày mưa ngăn ta ra ruộng đi cày."

#. Character:`saito` | Attributes:`happy`
msgctxt "t3180268ed4"
msgid "Ah, ça c'est le {{macumba.n}} que je connais !"
msgstr "Vậy mới là {{macumba.n}} của tôi chứ !"

#. Character:`macumba` | Attributes:`neutral`
msgctxt "t28df2f8ec1"
msgid "Petit frère je te laisse je dois aller me préparer pour aller travailler."
msgstr "Người anh em, tôi phải về chuẩn bị đi làm đây."

#. Character:`saito` | Attributes:`happy`
msgctxt "tf47cacede9"
msgid "Je comprends, bon courage je vais rentrer prendre une douche."
msgstr "Được rồi, cảm ơn anh vì ngày hôm nay. Tôi cũng phải về đi tắm phát."

#. Character:`narrator`
msgctxt "t6158ae4d79"
msgid "Tiens c'est curieux, je ne vois pas {{macumba.n}}..."
msgstr "Lạ thật đấy nhỉ, không thấy {{macumba.n}} đâu..."

#. Character:`narrator`
msgctxt "t9a0ddd4da6"
msgid "Ce n'est définitivement pas normal."
msgstr "Chắc chắn có chuyện không ổn xảy ra rồi."

#. Character:`narrator`
msgctxt "tc2a287f991"
msgid "Peut être qu'il est déjà reparti... C'est possible."
msgstr "Mà cũng có thể anh ấy chạy xong rồi nên về trước... Có thể."

#. Character:`narrator`
msgctxt "t3206e0338b"
msgid "Bref, autant s'y mettre tout de suite !"
msgstr "Mà thôi, bắt đầu luôn nào !"

#. Character:`saito` | Attributes:`happy`
msgctxt "ted3c9ab5b8"
msgid "Je suis affamé à présent !"
msgstr "Đói quá đi !"

#. Character:`saito`
msgctxt "ta9df9733f9"
msgid "Je passerais bien au konbini, ça me donnera l'occasion d'aller voir si {{sayuri.n}} a pu faire ce qu'elle voulait."
msgstr "Tạt qua Konbini để hỏi thăm cô {{sayuri.n}} phát."

