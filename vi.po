msgid "ASAMI"
msgstr "ASAMI"

msgid "Vous pouvez dès à présent poursuivre l’histoire d’{{asami.n}}."
msgstr "Giờ bạn có thể tiếp tục arc câu chuyện của {{asami.n}}."

msgid "Vous avez fait le choix de vous lier [color=yellow]d'amitié[/color]."
msgstr "Bạn mong muốn [color=yellow]làm bạn[color=yellow] với cô ấy."

msgid "Vous avez fait le choix de la [color=yellow]corrompre[/color]."
msgstr "Bạn mong muốn khiến cô ấy trở nên [color=yellow]hư hỏng[/color]."

msgid "Vous avez fait le choix de [color=yellow]rester amis[/color]."
msgstr "Tình bạn, hay tình yêu ? [color=yellow]Tất nhiên là tình bạn rồi[/color]."

msgid "J'ai compris"
msgstr "Đã hiểu"

msgid "SAKUYA"
msgstr "SAKUYA"

msgid "Vous pouvez dès à présent poursuivre l’histoire de {{sakuya.n}}."
msgstr "Bây giờ bạn có thể tiếp tục mạch truyện của {{sakuya.n}}."

msgid "Vous avez fait des choix tout au long de votre aventure, peu importe qu'ils soient bons ou mauvais. {{sakuya.n}} vous les fera assumer."
msgstr "Bạn đã thực hiện các lựa chọn xuyên suốt cuộc hành trình của mình, dù có dẫn tới các kết quả tốt hoặc xấu, {{sakuya.n}} cũng sẽ bắt bạn phải chịu trách nhiệm cho chúng."

msgid "YASUKA"
msgstr "YASUKA"

msgid "Vous pouvez dès à présent poursuivre l’histoire de {{yasuka.n}}."
msgstr "Giờ bạn có thể tiếp tục arc câu chuyện của {{yasuka.n}}."

msgid "Vous avez fait le choix de l'[color=yellow]aimer et de la soutenir[/color]."
msgstr "Bạn mong muốn [color=yellow]yêu thương và ủng hộ cô ấy.[/color]"

msgid "Vous avez fait le choix de la laisser [color=yellow]travailler au bar à hôtesse[/color]."
msgstr "Bạn để cô ấy [color=yellow]làm việc ở hộp đêm.[/color]"

msgid "Vous avez fait le choix de vous [color=yellow]concentrer sur la dette de votre père[/color]."
msgstr ""

msgid "Certaines scènes de ce jeu peuvent contenir du contenu sexuellement explicite et pourrait choquer un jeune public. Tous les personnages de ce jeu sont majeurs."
msgstr "Một số cảnh trong game chứa nội dung không phù hợp với người dưới 18 tuổi. Mọi nhân vật xuất hiện trong game đều trên 18 tuổi."

msgid "Pendant votre aventure, vos choix impacteront votre entourage, si vous rejetez plusieurs fois un personnage attendez vous a ce qu’il aille voir ailleurs. Tout ceci dans le but de garder une certaine cohérence avec le monde réel."
msgstr "Trong khi chơi, những lựa chọn bạn đưa ra sẽ gây ảnh hưởng đến những nhân vật xung quanh bạn. Nếu bạn từ chối một nhân vật quá nhiều lần, họ sẽ bắt đầu tìm kiếm cho mình những đối tượng mới. Điều này nhằm mục đích phản ánh yêu tố hiện thực đời sống vào game."

msgid "Vos actions auront des conséquences..."
msgstr "Mọi lựa chọn của bạn đều sẽ để lại hậu quả..."

msgid "[fill]Certaines [url=data]données anonymes[/url] peuvent être récoltées pour améliorer l'expérience de jeu.[/fill]"
msgstr "[fill]Một số [url=data]thông tin ẩn[/url] sẽ được thu thập để cải thiện trải nghiệm của người chơi.[/fill]"

msgid ""
"Les données recueillies incluent :\n"
"- numéro de version actuelle\n"
"- préférences du joueur (mode \"patate\")\n"
"- informations de plateforme (Windows, Android, etc.)\n"
"- informations de build (animations, censure, mode web, etc.)"
msgstr ""
"Dữ liệu được thu thập bao gồm:\n"
"- Phiên bản hiện tại của trò chơi\n"
"- Chế độ hoạt động (chế độ \"cùi bắp\")\n"
"- Hệ điều hành thiết bị (Windows, Android,...)\n"
"- Dữ liệu trò chơi (Hoạt ảnh, censor, web mode,...)"

msgid "Ces données seront recueillies après acceptation de ces termes, et ne contiennent pas d'identifiant direct ni informations externes au jeu."
msgstr "Dữ liệu sẽ được thu thập sau khi bạn chấp nhận những điều khoản trên, và không chứa bất cứ thông tin cá nhân nào hay bất cứ dữ liệu nào không liên quan tới tựa game mà có thể được thu thập."

msgid "[url=disclaimer]Retour[/url]"
msgstr "[url=disclaimer]Quay lại[/url]"

msgid "Je gère !"
msgstr "Tôi có thể chịu được !"

msgid "Sortez-moi d'ici !"
msgstr "Đưa tôi ra khỏi đây !"

