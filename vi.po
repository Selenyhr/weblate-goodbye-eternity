msgctxt "restaurant_exterior_d649b9d0"
msgid "Moi aussi, j'aimerais faire des choses coquines avec toi."
msgstr "Tớ cũng muốn là một số chuyện...hư hỏng với cậu."

#. Character:`sakuya`
msgctxt "restaurant_exterior_c3e1f0b5"
msgid "Mais je suis très exclusive {{saito.n}}."
msgstr "Nhưng tớ thì có tính độc chiếm rất cao, {{saito.n}} à."

