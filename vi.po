msgstr ""

#. Character:`saito`
msgctxt "C_EST_S_RIEUX_ET_A_NE_PRENDRA_B7C9EA"
msgid "C'est sérieux et ça ne prendra pas longtemps."
msgstr ""

#. Character:`nobu` | Attributes:`neutral`
msgctxt "OUAIS_OUAIS_SI_TU_LE_DIS_MAIS_9C46EE"
msgid "Ouais, ouais, si tu le dis, mais ça m'intéresse pas..."
msgstr ""

#. Character:`nobu`
msgctxt "MON_TEMPS_EST_PR_CIEUX_ET_JE_N_695D0C"
msgid "Mon temps est précieux et je n'ai vraiment pas envie de te parler, donc... juste... va te faire foutre !"
msgstr ""

#. Character:`nobu` | Attributes:`angry`
msgctxt "FAIT_CHIER_J_AI_PLUS_D_ARGENT_ABEF8E"
msgid "Fait chier, j'ai plus d'argent !!"
msgstr ""

#. Character:`nobu`
msgctxt "T_ES_ENCORE_L_TOI_PASSE_MOI_DE_5CDBFC"
msgid "T'es encore là, toi ? Passe-moi de l'argent !"
msgstr ""

#. Character:`saito`
msgctxt "PAS_AVANT_QUE_TU_R_PONDES_MES_439FDF"
msgid "Pas avant que tu répondes à mes questions !"
msgstr ""

#. Character:`nobu` | Attributes:`disgusted`
msgctxt "ARGLL_PUTAIN_T_ES_CHIANT_ON_CR_A693FC"
msgid "Argll, putain, t'es chiant ! On croirait entendre ma sœur !"
msgstr ""

#. Character:`nobu`
msgctxt "JE_PR_F_RE_ME_TIRER_D_ICI_PLUT_9FA765"
msgid "Je préfère me tirer d'ici plutôt que d'entendre un énième sermon."
msgstr ""

#. Character:`saito` | Attributes:`surprised`
msgctxt "HEY_ON_N_A_PAS_FINI_2D9F7B"
msgid "Hey ! On n'a pas fini !"
msgstr ""

#. Character:`narrator`
msgctxt "JE_DOIS_RESTER_DISCRET_LE_TEMP_BCE8BF"
msgid "Je dois rester discret le temps de trouver une solution."
msgstr ""

#. Character:`asami`
msgctxt "home_asami_exterior_8f47e2c4"
msgid "Alors ? Qu'est-ce que tu penses de la nouvelle {{asami.n}} ?"
msgstr "Thế nào? Ông nghĩ giề về một {{asami.n}} mới này?"

#. Character:`saito`
msgctxt "home_asami_exterior_e385705d"
msgid "...Je suis sans voix, tu es...[w] magnifique."
msgstr "...Thật...[w] choáng ngợp."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_exterior_428fb2c9"
msgid "Et terriblement sexy."
msgstr "Và cực đỗi sexy."

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_38d0d530"
msgid "C'est vrai ? Tu le penses vraiment ?"
msgstr "Thật đấy luôn?"

#. Character:`saito`
msgctxt "home_asami_exterior_867c1f4b"
msgid "Oh que oui !"
msgstr "Tuyệt cú mèo !"

#. Character:`saito`
msgctxt "home_asami_exterior_33d4a4cc"
msgid "Ça n'a pas été trop dur de changer totalement d'apparence en si peu de temps ?"
msgstr "Không thể ngờ rằng ngoại hình có thể được thay đổi một cách chớp nhoáng như vậy?"

#. Character:`saito`
msgctxt "home_asami_exterior_58a039fc"
msgid "Tu as même fait disparaitre les marques de bronzage..."
msgstr "Ngay cả mấy đường cháy nắng cũng hết luôn..."

#. Character:`saito`
msgctxt "home_asami_exterior_8d3b5078"
msgid "Comment tu as fait ça ?"
msgstr "Bà làm cách nào vậy?"

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_exterior_6bf891ed"
msgid "Ah ça ? Eh bien, hmmm..."
msgstr "Ấy hả? Ờmmm..."

#. Character:`asami`
msgctxt "home_asami_exterior_6eac5e54"
msgid "On a un jardin à l'abri des regards indiscrets."
msgstr "Nhà tui có khoảng vườn riêng."

#. Character:`saito`
msgctxt "home_asami_exterior_c6489ca1"
msgid "Oh, je vois."
msgstr "Hiểu hiểu."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_1204ae8b"
msgid "Allons au parc {{saito.n}} ! {{natsume.n}} doit nous attendre, elle n'a pas vu le résultat final de la transformation."
msgstr "Cùng đi tới công viên nào {{saito.n}}!, {{natsume.n}} hẳn đang chờ ta, tui sẽ cho cổ thấy quả lột xác hóa thiên nga của tui."

#. Character:`narrator`
msgctxt "home_asami_exterior_898513a1"
msgid "Mince, elle doit pas être au courant que je me suis brouillé avec elle..."
msgstr "Mụ nội, bả có lẽ không biết mình có vấn đề với con mẹ đấy."

#. Character:`narrator`
msgctxt "home_asami_exterior_708fb377"
msgid "Et {{minato.n}} étant un dangereux psychopathe, je ne sais pas si c'est une bonne idée de le rendre jaloux."
msgstr "Và với việc {{minato.n}} còn là một tên loạn thần nguy hiểm, mình nghĩ khiến cậu ta ghen tuông éo phải ý hay."

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_asami_exterior_000166b3"
msgid "Hey, attends-moi !"
msgstr "Này, chờ tôi với!"

#. Character:`asami`
msgctxt "home_asami_exterior_22f01a40"
msgid "Merci de m'avoir raccompagnée."
msgstr "Cảm ơn vì đã hộ tống tui về tới nhà."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_exterior_c426a6e5"
msgid "De rien, ça me permet de voir discrètement où tu habites."
msgstr "Một cơ hội tuyệt vời để tôi tìm ra nơi ở của bà."

#. Character:`asami`
msgctxt "home_asami_exterior_c172ef11"
msgid "Pourquoi, tu comptais faire une petite visite nocturne ?"
msgstr "Sao? Ông muốn thâm nhập cư gia vào đêm đen hửm?"

#. Character:`asami`
msgctxt "home_asami_exterior_eb16f3ab"
msgid "Je dois laisser ma fenêtre ouverte pour toi ?"
msgstr "Tui có nên để cửa sổ mở cho ông không?"

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_96217192"
msgid "Ne te trompe pas de chambre, tu tomberais peut-être sur celle de mon père."
msgstr "Cẩn thận đừng có chui nhầm sang phòng ba tôi nhá."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_asami_exterior_b76966f8"
msgid "Sans façon, merci !"
msgstr "Chắc tôi nghỉ khỏe. Cảm ơn!"

#. Character:`asami`
msgctxt "home_asami_exterior_ef6fc0e4"
msgid "Viens me chercher demain après-midi, tu auras juste à sonner !"
msgstr "Chiều đến kiếm tui nghe, chỉ cần rung chuông cửa trước là được!"

#. Character:`saito`
msgctxt "home_asami_exterior_63c50b9a"
msgid "Oui, mais si je n'ai pas envie ?"
msgstr "Ờ, nhưng nếu tôi không đi thì?"

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_exterior_ca2aa287"
msgid "Quoi, mais je croyais qu-"
msgstr "Hả, nhưng sao lại khôn-"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_exterior_e65a354b"
msgid "Je te fais marcher, il faut bien que je me venge un peu !"
msgstr "Chơi bà chút thôi, ai biểu bà trêu tôi hôm trước!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_99fe595b"
msgid "Idiot !"
msgstr "Ông xấu tính vãi!"

#. Character:`saito`
msgctxt "home_asami_exterior_1a0a20c1"
msgid "Aucun humour ces jeunes de nos jours !"
msgstr "Giới trẻ thời này đúng là éo có gu hài hước!"

#. Character:`narrator`
msgctxt "home_asami_exterior_50e1a840"
msgid "Vu que je suis là, pourquoi ne pas passer voir mon meilleur pote ?"
msgstr "Mà đã tới đây rồi, sao không đi thăm thằng đồng chí chí cốt của mình nhể?"

#. Character:`narrator`
msgctxt "home_asami_exterior_8e7b7994"
msgid "Ce sera l'occasion de prendre des nouvelles de {{chiaki.n}}."
msgstr "Cũng tiện để ghé qua chào hỏi {{chiaki.n}} nữa."

#. Character:`saito`
msgctxt "home_asami_exterior_92d4f638"
msgid "Ici ça ira ?"
msgstr "Đủ xa chưa?"

#. Character:`kimochi`
msgctxt "home_asami_exterior_0307bdf9"
msgid "Oui."
msgstr "Đủ rồi."

#. Character:`saito`
msgctxt "home_asami_exterior_d47a1d8e"
msgid "Donc, explique-toi ! Tu faisais quoi devant chez {{minato.n}} ?"
msgstr "Giờ trả lời, anh lảng vảng quanh nhà {{minato.n}} để?"

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "home_asami_exterior_350502d0"
msgid "...Je ne sais pas si je peux t'en parler."
msgstr "... Tôi không chắc tôi có thể tin anh."

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_asami_exterior_52fd02c2"
msgid "Je t'assure que j'ai l'esprit ouvert, je peux tout entendre."
msgstr "Tôi đảm bảo với anh, tôi sẽ không động thủ, mà sẽ lắng nghe một cách thấu đáo."

#. Character:`saito`
msgctxt "home_asami_exterior_2034e60b"
msgid "J'espère juste qu'il y a une bonne raison, sinon je devrais probablement le signaler."
msgstr "Tôi chỉ hy vọng rằng anh có một lý do chính đáng, nếu không thì chúng ta phải lên đồn giải quyết rồi."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_asami_exterior_0465da08"
msgid "Je vois..."
msgstr "Được rồi..."

#. Character:`kimochi`
msgctxt "home_asami_exterior_109e6ea2"
msgid "Je le soupçonne de maltraiter sa petite sœur depuis un certain temps."
msgstr "Tôi nghi ngờ rằng cậu ta đang ngược đãi em gái mình, một thời gian rồi."

#. Character:`kimochi`
msgctxt "home_asami_exterior_f914131b"
msgid "J'essaye de rassembler des preuves, mais pour le m-"
msgstr "Tôi đang cố thu thập bằng chứng, nhưn-"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_asami_exterior_5f7646b6"
msgid "Une minute, une minute...[w] Je sais bien qu'il peut parfois être colérique et qu'il peut s'emporter un peu."
msgstr "Khoan cái đã...[w] Tôi biết đôi khi cậu ta có thể hơi nóng nảy, và đôi lúc vì thế nên cậu ta trở nên mất bình tĩnh..."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_asami_exterior_bd9d3d7c"
msgid "Mais de la maltraitance..."
msgstr "Nhưng ngược đãi con bé thì..."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_asami_exterior_37deb9d3"
msgid "{{minato.n}} est un putain de psychopathe, et plus on le laissera seul avec sa petite sœur, plus elle en souffrira."
msgstr "{{minato.n}} đúng chất là một tên loạn thần, và tình trạng con bé sẽ trở nên ngày càng tồi tệ hơn, nếu con bé tiếp tục ở với hắn ta."

#. Character:`narrator`
msgctxt "home_asami_exterior_4a5bb023"
msgid "Merde... Même si j'avais des doutes sur lui, je ne m'attendais pas à un truc aussi sombre."
msgstr "Đụ bà già tổ tông... Dù mình có thấy cậu ta hơi nghi nghi, không ngờ lại có thể có chuyện này."

#. Character:`narrator`
msgctxt "home_asami_exterior_77b9e598"
msgid "Je suis censé faire quoi après avoir entendu un truc pareil ?"
msgstr "Mình cần phải làm gì sau khi nghe cái của này đây?"

#. Character:`kimochi`
msgctxt "home_asami_exterior_3b45e5b6"
msgid "Hey, tu m'écoutes ?"
msgstr "Ê, anh có nghe không vậy?"

#. Character:`saito`
msgctxt "home_asami_exterior_08108474"
msgid "Oui oui, j'ai juste du mal à y croire..."
msgstr "Xin lỗi, xin lỗi, chỉ là...thật khó để tin điều này..."

#. Character:`asami`
msgctxt "home_asami_exterior_889fa555"
msgid "Du mal à croire quoi ?"
msgstr "Khó tin gì cơ?"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_asami_exterior_74d95b5e"
msgid "Femme silence, ceci est une conversation entre deux mâles alpha !"
msgstr "Biến ngay, đồ đàn bà! Đây là một cuộc tọa đàm của các đấng nam nhân!"

#. Character:`asami` | Attributes:`angry`
msgctxt "home_asami_exterior_739a953a"
msgid "Comment ça \"Femme\" ?! {{saito.n}} retiens-moi ou je lui arrache les couilles !"
msgstr "Mày nói éo gì bà cơ? {{saito.n}}, ngăn tôi lại trước khi tôi bóp dái thằng cha này!"

#. Character:`asami`
msgctxt "home_asami_exterior_51989db8"
msgid "C'est qui ce nain de jardin qui se prend pour un gros macho ?"
msgstr "Thằng đầu khấc lùn tịt này nghĩ nó là ai mà dám lấc cấc?"

#. Character:`saito`
msgctxt "home_asami_exterior_70883af6"
msgid "Je n'en sais rien, il ne s'est même pas encore présenté..."
msgstr "Tôi cũng chả biết, ổng chưa giới thiệu..."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_asami_exterior_f2b9b5e9"
msgid "Pardon, j'en oublierai presque les bonnes manières."
msgstr "Thất lễ, thật thất lễ rồi."

#. Character:`kimochi`
msgctxt "home_asami_exterior_697791ce"
msgid "Mon nom est [color=#55efc4]{{kimochi.get_character_name()}} Warui[/color]."
msgstr "Tên tôi là [color=#55efc4]{{kimochi.get_character_name()}} Warui[/color]."

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_asami_exterior_3ea7f0e7"
msgid "Mais..."
msgstr "Cái éo..."

#. Character:`asami` | Attributes:`surprised`
msgctxt "home_asami_exterior_7124c56b"
msgid "Attends, t'es sérieux, c'est vraiment ton nom ?"
msgstr "Đấy mà là tên á?!"

#. Character:`kimochi`
msgctxt "home_asami_exterior_e4e2454d"
msgid "Mon nom est {{kimochi.n}}."
msgstr "Tên tôi là {{kimochi.n}}."

#. Character:`asami`
msgctxt "home_asami_exterior_05cdee33"
msgid "C'est d'un banal..."
msgstr "Tên nhàm bỏ bà..."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_asami_exterior_4a43b41d"
msgid "...Femme, reste à ta place !"
msgstr "Con đàn bà, biết tôn ti trật tự đi!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_fb341b80"
msgid "J'vais le tuer !"
msgstr "Bà giết mày!"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_asami_exterior_0b920d96"
msgid "{{saito.n}} ! Rejoins-moi à cette adresse cette nuit, je t'en dirais davantage."
msgstr "{{saito.n}}! Gặp tôi ở địa chỉ này ngày mai, tôi sẽ cho ông biết nhiều thông tin hơn."

#. Character:`asami`
msgctxt "home_asami_exterior_044664ca"
msgid "Et en plus, il m'ignore !"
msgstr "Thằng đầu khấc ấy còn bơ tui!"

#. Character:`asami`
msgctxt "home_asami_exterior_2d7ea149"
msgid "Dis quelque chose toi !"
msgstr "Yo, muốn nói điều gì không?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_asami_exterior_58a56376"
msgid "Euh... Je me suis entrainé cette nuit, je vais t'éclater à Soulcalibur ?"
msgstr "Ờm...Hôm qua tôi dành cả đêm cày Light Soul, tôi sẽ thông nát ass bà hôm nay?"

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_exterior_08151c69"
msgid "Ah ![w] C'est ce qu'on va voir !"
msgstr "Á à![w] Để xem thế nào!"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_b15eb359"
msgid "C'est idiot m'a énervé comme jamais ! Non mais pour qui il se prend ?"
msgstr "Thằng lấc cấc đấy làm tui sôi hết cả máu! Nó nghĩ nó là ai chứ?"

#. Character:`asami`
msgctxt "home_asami_exterior_93dc6f92"
msgid "J'ai besoin de me défouler !"
msgstr "Tui cần phải đi giải khuây tí thôi!"

#. Character:`asami`
msgctxt "home_asami_exterior_8ba1be86"
msgid "Prépare-toi pour la raclée de ta vie !"
msgstr "Chuẩn bị đi, vì tui sẽ cuốn ông về với cát bụi!\""

#. Character:`asami`
msgctxt "asami_choice_ec6bf037"
msgid "Enfin ! Je me demandais si tu ne m'avais pas oubliée ?"
msgstr "Cuối cùng thì, tui tự hỏi rằng liệu ông đã quên tui chưa?"

#. Character:`saito` | Attributes:`happy`
msgctxt "asami_choice_fa29bded"
msgid "Bien sûr que non, comment je pourrais t'oublier ?"
msgstr "Tất nhiên là không rồi, làm sao tôi có thể quên bà được?"

#. Character:`asami` | Attributes:`pouting`
msgctxt "asami_choice_a933fe77"
msgid "Tu as plutôt intérêt, sinon..."
msgstr "Cấm chỉ đấy nhá, bằng không..."

#. Character:`saito`
msgctxt "asami_choice_c7bb976b"
msgid "Sinon ?"
msgstr "Bằng không..."

#. Character:`asami` | Attributes:`happy`
msgctxt "asami_choice_eb317c6b"
msgid "Je connais 36 façons d'émasculer un homme."
msgstr "Tui biết 7749 cách để thiến một đứa con trai đó nha."

#. Character:`saito`
msgctxt "asami_choice_5131b57c"
msgid "T'as trouvé ça dans l'émasculation pour les nuls ?"
msgstr "Bà tìm thấy mấy điều đấy trong: \"Đại cương về cách thiến chim\" hửm?"

#. Character:`asami` | Attributes:`pouting`
msgctxt "asami_choice_fdd1d7f8"
msgid "Peut-être bien..."
msgstr "Chẳng đúng cũng chẳng sai..."

#. Character:`asami`
msgctxt "asami_choice_5dc42223"
msgid "Allez, viens, dépêchons-nous d'aller dans ta chambre."
msgstr "Đi thôi, cùng tới phòng ông nào."

#. Character:`saito` | Attributes:`surprised`
msgctxt "asami_choice_e6ec6fce"
msgid "Hey, attends, je n'ai pas fini de..."
msgstr "Này, tôi vẫn chưa nói xo-"

#. Character:`saito` | Attributes:`happy`
msgctxt "asami_choice_afc78d6e"
msgid "Elle est déjà loin."
msgstr "Bé tí vậy mà phi nhanh phết."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_exterior_e301e1b6"
msgid "{{saito.n}}... Tu ne regrettes pas d'être avec moi ?"
msgstr "{{saito.n}}... Ông có hối hận khi ở bên tui không?"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_exterior_c0ac1660"
msgid "C'est plutôt ironique comme question, c'est moi qui aurais dû te la poser."
msgstr "Ngược đời vậy. Đáng ra tôi mới là người cần hỏi câu đó."

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_asami_exterior_8cf1dff9"
msgid "C'est {{minato.n}} la personne que tu désirais."
msgstr "Trước đó, bà say {{minato.n}} như điếu đổ."

#. Character:`asami`
msgctxt "home_asami_exterior_12d837a9"
msgid "...Je l'idéalisais, il ne m'a accordé aucune attention depuis toutes ces années."
msgstr "...Tui hâm mộ hắn, trong khi hắn chẳng thèm đoái hoài gì tới tui."

#. Character:`asami`
msgctxt "home_asami_exterior_9e4d81b7"
msgid "Il est parfois arrogant, il traine avec des gens louches."
msgstr "Có đôi lúc hắn hơi kiêu ngạo, và hắn hay đi lai giai với lắm tên ngáo đá."

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_exterior_1af9f297"
msgid "Mais tu sais... Tu n'as pas à t'inquiéter. J'ai définitivement tiré un trait sur lui."
msgstr "Nhưng ông biết gì không... Ông không cần phải lo, tui xong chuyện với hắn rồi."

#. Character:`asami`
msgctxt "home_asami_exterior_188ab69a"
msgid "Les quelques jours qu'on a passés ensemble ont été les plus fun que j'ai jamais eus avec un autre garçon."
msgstr "Những ngày qua là những ngày hạnh fuck nhất mà tui từng có với một tên đực rựa."

#. Character:`asami`
msgctxt "home_asami_exterior_b4a409e2"
msgid "Donc j'en ai marre de rester passive à attendre."
msgstr "Tui chán phải mòn mỏi đợi chờ rồi."

#. Character:`asami`
msgctxt "home_asami_exterior_83a2917c"
msgid "C'est avec toi que je veux être !"
msgstr "Ông là người mà tui muốn ở bên!"

#. Character:`saito`
msgctxt "home_asami_exterior_ea2bfd09"
msgid "Et mon avis là-dedans ?"
msgstr "Bà chưa hỏi ý kiến tôi sao?"

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_exterior_e2901fe2"
msgid "...tu ne veux pas ?"
msgstr "...Ông...không muốn ư?"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_exterior_34b7cdc5"
msgid "Bien sûr que je le veux."
msgstr "Điên mới không muốn."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_fde246d1"
msgid "Héhé."
msgstr "Ehehe."

#. Character:`asami`
msgctxt "home_asami_exterior_0dc6a756"
msgid "Demain soir, je te prépare une surprise."
msgstr "Tối mai, tui có một bất ngờ dành cho ông."

#. Character:`saito`
msgctxt "home_asami_exterior_80ff29e5"
msgid "Ah ? Je peux en savoir plus ?"
msgstr "Ố? Gợi ý đê?"

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_exterior_76ed9a99"
msgid "Bien sûr que non, sinon ça ne sera plus une surprise."
msgstr "Không đời nào, biết trước thì còn gì vui."

#. Character:`asami`
msgctxt "home_asami_exterior_61d808b3"
msgid "Mais je suis certaine que ça te plaira."
msgstr "Nhưng tui chắc chán là ông sẽ thích nó."

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_asami_exterior_7a2ca58d"
msgid "Il y a juste quelque chose qui me chagrine..."
msgstr "Chỉ là có một số điều đang làm phiền tôi..."

#. Character:`asami`
msgctxt "home_asami_exterior_90d9a485"
msgid "Dis-moi."
msgstr "Kể tui đi."

#. Character:`saito`
msgctxt "home_asami_exterior_7a80af65"
msgid "Ce que tu as dit à {{minato.n}}. À ce moment-là, tu ne m'avais pas encore embrassé."
msgstr "Những gì bà nói với {{minato.n}}, vào lúc đấy, bà vẫn chưa hôn tôi."

#. Character:`asami`
msgctxt "home_asami_exterior_52a5e926"
msgid "C'est vrai."
msgstr "Đúng thật."

#. Character:`saito`
msgctxt "home_asami_exterior_e5eefec3"
msgid "Donc tout était prémédité, tu étais déjà décidé à être avec moi sans savoir que je dirais oui."
msgstr "Ấy vậy là hữu duyên, bà tỏ tình tôi mà không biết tôi sẽ nói có."

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_2a0fede5"
msgid "Tu n'aimes pas les filles un peu audacieuses ?"
msgstr "Ông không thích con gái chủ động à?"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_exterior_ac81ccec"
msgid "En vrai, j'aime beaucoup."
msgstr "Rất thích là đằng khác."

#. Character:`saito`
msgctxt "home_asami_exterior_88635a4c"
msgid "Si on doit se marier un jour, c'est toi qui poses le genou au sol alors."
msgstr "Vậy thì, nếu ta có cầu hôn nhau, bà sẽ phải là người quỳ xuống."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_ec8c86c9"
msgid "Si tu mets une robe blanche peut-être."
msgstr "Ông mà mặc được váy trắng thì tôi mới quỳ."

#. Character:`asami`
msgctxt "home_asami_exterior_005035d3"
msgid "Allez, bonne nuit ma princesse !"
msgstr "Ok, ngủ ngon nha, ông công chúa!"

#. Character:`saito`
msgctxt "home_asami_exterior_5c9fbdd3"
msgid "Elle est vraiment trop grave !"
msgstr "Bả đúng thật rất điên!"

#. Character:`asami`
msgctxt "home_asami_exterior_b486e775"
msgid "Je suis prête !"
msgstr "Ok rồi !"

#. Character:`saito`
msgctxt "home_asami_exterior_85f01cdd"
msgid "Tu m'attendais depuis longtemps ?"
msgstr "Ây, cô chờ có lâu không ?"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_b99d8de6"
msgid "Tu ne m'as pas donné d'heure précise alors..."
msgstr "Anh không có hẹn tôi giờ, thế nên là tôi có hơi..."

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_asami_exterior_83e4e034"
msgid "Désolé !"
msgstr "Xin lỗi !"

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_6bdfc43b"
msgid "C'est pas grave, maintenant que tu es là, allons-y !"
msgstr "Hoi hông hao. Anh đã cất công tới đây rồi, ta đi thôi !"

#. Character:`asami`
msgctxt "home_asami_exterior_40251db1"
msgid "... Merci {{saito.n}}."
msgstr "... Cảm ơn anh nhiều, {{saito.n}}."

#. Character:`asami`
msgctxt "home_asami_exterior_0d1ca0e3"
msgid "Ta famille est vraiment extra !"
msgstr "Gia đình ông hảo thật đấy !"

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_asami_exterior_a7762a18"
msgid "Elle est pas parfaite, mais oui y'a de bons côtés."
msgstr "Ừ thì... cũng phải ngủ giường mới biết bên trong có rận."

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_f06d4b83"
msgid "Je t'en prie... Tu as déjà vu une famille parfaite toi ?"
msgstr "Phì... Bảo ông nghe, giường nào mà chẳng có rận ?"

#. Character:`asami`
msgctxt "home_asami_exterior_bc7b1eb1"
msgid "Ça serait bien trop louche !"
msgstr "Kiểu đấy chỉ có trong phim thoi !"

#. Character:`asami`
msgctxt "home_asami_exterior_64055739"
msgid "Qui sait quels sombres secrets on y découvrirait ?"
msgstr "Không phải rận thì chắc là rắn cạp nong hay hổ báo cáo chồn, đúng không ?"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_exterior_ebbf6348"
msgid "Et ta famille à toi elle a quoi d'étrange ?"
msgstr "Thế còn nhà bà thì sao ?"

#. Character:`asami`
msgctxt "home_asami_exterior_49823c33"
msgid "Ma mère déteste par dessus tout qu'on l'appelle madame, ça la rend folle."
msgstr "Má tui phải gọi là siêu điên tiết nếu như ai đó gọi má là 'cô' (Trans note: Ở Nhật, gọi phần tên, không gọi phần họ, không dùng kính ngữ, biểu thị ở đây là 'cô' hay 'bác' thể hiện sự thân mật. Sayuri muốn được nhận từ các bạn thanh thiếu niên sự thân mật như giữa bạn bè với nhau, ngầm ý chỉ là cô ấy cũng trẻ khỏe đẹp như họ (trẻ khỏe đẹp thậc), vậy nên mới yêu cầu chỉ gọi cô ấy bằng tên. Trong các câu thoại sau này, tôi đã có thể dịch là 'chị', nhưng thiết nghĩ giữ nguyên tinh thần bản dịch là hơn.)"

#. Character:`asami`
msgctxt "home_asami_exterior_db9067a3"
msgid "Je crois que vieillir ne lui réussit pas."
msgstr "Mà cũng đúng, tuổi thanh xuân chẳng bao giờ rời má đi cả."

#. Character:`asami`
msgctxt "home_asami_exterior_083fb47c"
msgid "Quant à mon père... Je n'ai même pas envie d'en parler."
msgstr "Mà còn ba thì... Tui còn chán chả mún nói cơ."

#. Character:`asami`
msgctxt "home_asami_exterior_6ba40909"
msgid "Toujours en voyage d'affaire, il préfère son travail à sa famille."
msgstr "Ổng suốt ngày cứ đi công tác hoài, chẳng đoái hoài vợ con gì cả."

#. Character:`saito`
msgctxt "home_asami_exterior_4fee10f3"
msgid "Bienvenue au club des pères à chier dans ce cas !"
msgstr "Chào mừng tới hội 'Có Bố Đi Mua Sữa !'"

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_50e30f23"
msgid "Oh chouette, on est combien ?"
msgstr "Hểểể~? Hội có bao thành viên dzợ ?"

#. Character:`saito`
msgctxt "home_asami_exterior_44561938"
msgid "Mhhh toi et moi ça fait deux, mais si on compte {{noriko.n}} ça doit faire trois."
msgstr "Xem coi nào, chắc cỡ hai, tính thêm cả {{noriko.n}} nữa thì là ba đứa cô hồn."

#. Character:`asami`
msgctxt "home_asami_exterior_dadb39bd"
msgid "Haha !"
msgstr "Haha !"

#. Character:`asami`
msgctxt "home_asami_exterior_c7a846f8"
msgid "Merci encore pour tout {{saito.n}}."
msgstr "Cảm ơn vì tất cả nhé, {{saito.n}}."

#. Character:`saito`
msgctxt "home_asami_exterior_f12eac4e"
msgid "Pas de problème, passe une bonne nuit {{asami.n}} !"
msgstr "Không hề gì, một đêm ngon giấc nhé, {{asami.n}} !"

#. Character:`asami`
msgctxt "home_asami_exterior_1a5983b9"
msgid "On pourra se revoir ?"
msgstr "Bao giờ tụi mình lại hẹn nhau được ?"

#. Character:`saito`
msgctxt "home_asami_exterior_d5512fe6"
msgid "Quand tu voudras !"
msgstr "Cứ tạt qua bao giờ cũng okie !"

#. Character:`narrator`
msgctxt "home_asami_exterior_5433dae9"
msgid "Finalement elle était pas si mal cette journée."
msgstr "Ngày hôm nay rốt cục cũng không tệ lắm."

#. Character:`narrator`
msgctxt "home_asami_exterior_20a473c8"
msgid "Faudra que je pense à toucher un mot à {{minato.n}} d'ailleurs."
msgstr "Chắc mình phải tới ghé thăm {{minato.n}} một chuyến."

#. Character:`narrator`
msgctxt "home_asami_exterior_675ec5c0"
msgid "S'il s'était pas comporté comme un connard avec elle, je n'aurais probablement jamais pu faire sa connaissance."
msgstr "Không nhờ thằng cờ hó nớ thì mình đã không có duyên với cô nàng."

#. Character:`narrator`
msgctxt "home_asami_exterior_0013aaa5"
msgid "Bon... Il est temps de rentrer à présent."
msgstr "Chà chà... Đến giờ về thôi."

#. Character:`saito`
msgctxt "home_asami_exterior_a9e8e433"
msgid "... et voilà !"
msgstr "... và đến nhà rồi !!"

#. Character:`asami`
msgctxt "home_asami_exterior_36a22839"
msgid "J'ai encore passé une super journée !"
msgstr "Lại thêm một ngày tuyệt vời nữa !"

#. Character:`asami`
msgctxt "home_asami_exterior_7c215c6a"
msgid "Si j'avais su... Je serais venue te parler beaucoup plus tôt."
msgstr "Biết vậy... Biết thế tui đã làm quen ông sớm hơn."

#. Character:`saito`
msgctxt "home_asami_exterior_e3b41045"
msgid "C'est comme ça, on ne peut pas y faire grand chose."
msgstr "Định mệnh đã se duyên thế nào thì biết thế ấy thoi."

#. Character:`asami`
msgctxt "home_asami_exterior_b9d92e1a"
msgid "C'est sûr, ce n'est pas comme si on pouvait revenir en arrière."
msgstr "Đúng mà, biết sao được. Có vặn đồng hề quay về quá khứ được đâu."

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_asami_exterior_af2db745"
msgid "... En effet."
msgstr "...Hẳn vậy."

#. Character:`asami`
msgctxt "home_asami_exterior_3efa2c66"
msgid "Mais si j'en avais l'occasion je sais ce que je ferais en priorité."
msgstr "Mà nếu như được thì, tui biết chắc chắn tui sẽ làm gì lun nè."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_exterior_854ad54b"
msgid "Tu achèterais du bitcoin ?"
msgstr "Tính mua bitcoin chứ gi ?"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_2f5d45ce"
msgid "Non idiot ! Quoique...."
msgstr "Không, ngố ạ ! Mà..."

#. Character:`saito`
msgctxt "home_asami_exterior_a9eec075"
msgid "Allez, tarde pas trop, passe une bonne nuit {{asami.n}}."
msgstr "Nào nào, muộn rồi đấy nàng ơi, một đêm tốt lành nhé, {{asami.n}}."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_aa716569"
msgid "Bonne nuit {{saito.n}}."
msgstr "Một đêm tốt lành nhé, {{saito.n}}"

#. Character:`narrator`
msgctxt "home_asami_exterior_71a4920c"
msgid "C'est vraiment une chouette fille..."
msgstr "Một chú họa mi tràn đầy năng lượng..."

#. Character:`narrator`
msgctxt "home_asami_exterior_2bf3e4fb"
msgid "Pourquoi cet abruti de {{minato.n}} l'a rejetée comme ça."
msgstr "Tại sao thằng chóa {{minato.n}} đá bà ấy tàn nhẫn tới vậy."

#. Character:`narrator`
msgctxt "home_asami_exterior_25d8f8b9"
msgid "Surtout si c'est une amie d'enfance..."
msgstr "Nhất là khi còn là bạn thuở nhỏ với nhau nữa chứ..."

#. Character:`narrator`
msgctxt "home_asami_exterior_b789ca5b"
msgid "Faut que je lui touche un mot."
msgstr "Thật sự phải có đôi lời với nó thôi."

#. Character:`minato`
msgctxt "home_asami_exterior_992ddb08"
msgid "Nous y voilà !"
msgstr "Tới nơi rồi !"

#. Character:`asami`
msgctxt "home_asami_exterior_2dce5cff"
msgid "Merci de m'avoir raccompagnée !"
msgstr "Cảm ơn vì đã hộ tống tui về nhé !"

#. Character:`minato`
msgctxt "home_asami_exterior_4ba88853"
msgid "Aucun problème, c'est vrai que ça remonte à loin la dernière fois où on a eu une véritable conversation ensemble."
msgstr "Không hề gì, kể ra cũng lâu rồi tụi mình mới đi tán ngẫu thế này ha."

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_asami_exterior_650631bb"
msgid "Ça m'avait manqué tu sais..."
msgstr "Tôi cũng nhớ mấy buổi này lắm chứ..."

#. Character:`asami` | Attributes:`surprised`
msgctxt "home_asami_exterior_7e8492a8"
msgid "Vraiment ?"
msgstr "Thật chứ ?"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_73787e2c"
msgid "Dans ce cas pourquoi m'avoir traitée comme ça la dernière fois."
msgstr "Thế sao hôm bửa ông lại đã nặng lời tới vậy."

#. Character:`minato` | Attributes:`upset`
msgctxt "home_asami_exterior_d0a1a190"
msgid "Si je te le dis... Tu vas te moquer de moi."
msgstr "Tôi mà nói thì... Chắc bà cười tôi thối mũi mất."

#. Character:`asami`
msgctxt "home_asami_exterior_c3d29360"
msgid "Et comment ! C'est tout ce que tu mérites après ce que tu m'as dit."
msgstr "Đáng đời lắm ! Lần sau nhẹ lời với con gái hơn coi."

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_asami_exterior_ec302c2b"
msgid "Touché !"
msgstr "Thôi được !"

#. Character:`minato` | Attributes:`upset`
msgctxt "home_asami_exterior_e0655406"
msgid "J'ai... j'ai paniqué, j'étais tellement pas prêt que mon cœur s'est emballé et j'ai dit absolument n'importe quoi."
msgstr "Tôi kiểu... Tôi bị hoảng ý. Tôi chưa bao giờ nghĩ tới chuyện ấy, và rồi ú ớ ra toàn mấy điều không đâu."

#. Character:`minato`
msgctxt "home_asami_exterior_bfe78f41"
msgid "Je ne suis vraiment pas fier de ce que j'ai dit ce jour-là. J'ai été odieux et je ne mérite pas d'être pardonné."
msgstr "Thật ngẫm lại thì tôi chẳng lấy làm tự hào vì những gì tôi đã nói. Sau vụ đấy, tôi không nghĩ tôi xứng đáng được thứ tha."

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_exterior_8e3b713f"
msgid "Tu sais que tu m'as vraiment fait mal !"
msgstr "Ông làm tui tổn thương lắm đấy, ông biết không !"

#. Character:`asami`
msgctxt "home_asami_exterior_aff029d3"
msgid "Heureusement que {{saito.n}} était là sinon je ne sais pas ce que j'aurais pu faire..."
msgstr "May là hôm đấy có {{saito.n}}, không thì chẳng biết tôi đã ra làm sao nữa."

#. Character:`minato`
msgctxt "home_asami_exterior_de44bf3c"
msgid "Je sais... Je suis désolé. J'ai été nul."
msgstr "Tôi biết... TÔi sai rồi. Tôi đã làm một điều vô cùng tồi tệ."

#. Character:`asami` | Attributes:`bored`
msgctxt "home_asami_exterior_7cf59ba0"
msgid "Ravie de voir qu'on est du même avis."
msgstr "Thôi thì mừng vì hai ta đã hiểu nhau rồi."

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_asami_exterior_eaf35a99"
msgid "Tu sais... Le moment est peut-être mal choisi mais..."
msgstr "Bà biêt không... Hẳn là thực sự không đúng lúc tí nào, nhưng mà nè..."

#. Character:`minato`
msgctxt "home_asami_exterior_e48703c9"
msgid "Après avoir de nouveau discuté avec toi je me suis senti de nouveau... complet."
msgstr "Sau khi kết nối lại với bà, tôi thấy kiểu... đong đầy... ý..."

#. Character:`asami`
msgctxt "home_asami_exterior_f88e904f"
msgid "... et ?.."
msgstr "... và, ừm..."

#. Character:`minato` | Attributes:`upset`
msgctxt "home_asami_exterior_e7862748"
msgid "Ce que j'essaie de dire c'est que... te voir avec l'autre d-[w] avec {{saito.n}} m'a fait réaliser ce que je risquais de perdre."
msgstr "Ý tôi ấy là... sau khi nhìn bà thân thiết với..[w] với {{saito.n}}, thì tôi đã nhận ra, tôi đã bỏ lỡ những điều gì."

#. Character:`asami` | Attributes:`surprised,blush`
msgctxt "home_asami_exterior_f6742351"
msgid "Oh !"
msgstr "Huh ?!"

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_asami_exterior_88c6fc82"
msgid "Si tu es toujours d'accord... J'aimerais moi aussi faire évoluer notre relation."
msgstr "Thì, bà à... Tôi cũng muốn phát triển mối quan hệ tụi mình thêm ấy"

#. Character:`minato`
msgctxt "home_asami_exterior_f888024d"
msgid "Qu'est-ce que tu en penses ?"
msgstr "Bà... nghĩ thế nào ?"

#. Character:`asami` | Attributes:`upset,blush`
msgctxt "home_asami_exterior_e4950d7a"
msgid "... Je... j'ai attendu que tu me dises ces mots depuis si longtemps."
msgstr "... Tui... Tui chờ mấy lời này hàng năm rồi đấy ông."

#. Character:`asami`
msgctxt "home_asami_exterior_54a1bc8f"
msgid "Je pensais que ça n'arriverait jamais."
msgstr "Tôi cứ nghĩ khoảnh khắc này sẽ chẳng bao giờ tới."

#. Character:`asami`
msgctxt "home_asami_exterior_7dc4d884"
msgid "Tu me l'aurais dit il y a une semaine je t'aurais répondu oui immédiatement."
msgstr "Ông mà nói tôi nghe câu vừa rồi chỉ một tuần trước thôi, là tôi đã gật đầu lia lịa rồi đấy."

#. Character:`minato`
msgctxt "home_asami_exterior_f279a6c5"
msgid "Mais ?"
msgstr "Nhưng ?"

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_3c2790b6"
msgid "Aujourd'hui les choses ont changé et j'ai rencontré quelqu'un qui m'apporte mieux qu'un amour à sens unique."
msgstr "Tình thế thay đổi rồi, và một ai đó khác đã dành tặng tui một điều còn tuyệt vời hơn cả tình đơn phương."

#. Character:`minato` | Attributes:`suspicious`
msgctxt "home_asami_exterior_e9d04398"
msgid "Tu abandonnerais plus de 10 ans d'amitié et de souvenirs en commun pour 3 jours passés en compagnie d'une personne dont tu ne connais au final pas grand chose ?"
msgstr "Bà chọn vui cùng một người lạ mặt mà bà mới gặp hơn ba ngày, hơn đứa bạn thân thiết, chí cốt đã ở bên bà suốt hơn mười năm sao ?"

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_exterior_0b7d8a15"
msgid "Je..."
msgstr "Tôi..."

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_asami_exterior_a4c13f6d"
msgid "Ne t'en fais pas, je ne te demanderais pas une réponse immédiate."
msgstr "Không sao, bà không cân phải trả lời ngay đâu."

#. Character:`minato`
msgctxt "home_asami_exterior_cc8a9257"
msgid "Prends la nuit pour y réfléchir et donne-moi ta réponse demain, d'accord ?"
msgstr "Bà cứ nghỉ cho khỏe tối nay đi, và sang ngày mai thì hãy cho tôi một câu trả lời nhé ?"

#. Character:`asami`
msgctxt "home_asami_exterior_e3a01ea9"
msgid "... D'accord, merci."
msgstr "... Cảm ơn, ông."

#. Character:`minato`
msgctxt "home_asami_exterior_8390c95a"
msgid "Oh ! Et {{asami.n}}..."
msgstr "A ! Và bà {{asami.n}} này..."

#. Character:`asami` | Attributes:`sad,blush`
msgctxt "home_asami_exterior_aa7243d5"
msgid "Quoi ?"
msgstr "Hửm ?"

#. Character:`minato` | Attributes:`happy`
msgctxt "home_asami_exterior_75973bdf"
msgid "Tu m'avais manqué."
msgstr "Tui, nhớ bà lắm đó."

#. Character:`asami` | Attributes:`neutral,blush`
msgctxt "home_asami_exterior_ea5c17b7"
msgid "... Toi aussi."
msgstr "... Tui cũng vậy."

#. Character:`saito`
msgctxt "home_asami_exterior_64bf0e45"
msgid "Je ne sais pas ce que tu as l'intention de faire mais si jamais tu lui fais du mal..."
msgstr "Thật sự tao không biết mày đang giờ ngón đòn ma mãnh gì, nhưng nếu mày mà làm gì bà ấy thì..."

#. Character:`saito`
msgctxt "home_asami_exterior_8b570b39"
msgid "Je te jure que..."
msgstr "Tao thề, tao sẽ..."

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_asami_exterior_a9d5e298"
msgid "Que quoi ? Qu'est-ce qu'une victime comme toi va bien pouvoir me faire ?"
msgstr "Sẽ làm gì hả ? Thứ hèn nhát yêu đuối như mày thì làm được cái chó gì tao nào ?"

#. Character:`minato`
msgctxt "home_asami_exterior_2555d23d"
msgid "Rien ! C'est bien ce que je pensais, tu as toujours été pathétique et tu le resteras."
msgstr "Không thể, và không gì hết ! Mày đã, đang và sẽ mãi luôn vô vọng, vô dụng, và vô duyên."

#. Character:`minato` | Attributes:`happy`
msgctxt "home_asami_exterior_6af563f5"
msgid "Tu te branleras tout seul dans ta chambre pendant que moi..."
msgstr "Đi mà sục cặc trong phòng ấy, trong lúc ấy thì tao..."

#. Character:`minato` | Attributes:`neutral`
msgctxt "home_asami_exterior_ad35ff4f"
msgid "... je ne serais pas seul, si tu vois ce que je veux dire !"
msgstr "... sẽ không cô đơn đâu, không như mày ! Khà khà !"

#. Character:`minato` | Attributes:`upset`
msgctxt "home_asami_exterior_2822d8fb"
msgid "Bref ! Tire-toi maintenant, il me semble t'avoir déjà dit de ne plus venir me faire chier."
msgstr "Rồi, xong, chuyện vui. Giờ cút về cái chòi ẩm thấp của mày coi. Tao nhớ rằng đã cảnh cáo mày không xỉa xói vào đời tư tao rồi mà nhỉ ?"

#. Character:`saito`
msgctxt "home_asami_exterior_9d553b1e"
msgid "Peu importe ce que tu penses, si tu lui fais du mal, ou si tu joues avec ses sentiments tu auras affaire à moi !"
msgstr "Không quan trọng mày toan tính gì, nếu như mà mày làm hại, hay chơi đùa với cảm xúc của bà ấy, thì chuẩn bị tinh thần đi !"

#. Character:`minato`
msgctxt "home_asami_exterior_5e4de788"
msgid "À bientôt alors..."
msgstr "Châu chấu mà dám đá xe à..."

#. Character:`narrator`
msgctxt "home_asami_exterior_b214599f"
msgid "Putain d'enfoiré !"
msgstr "Thứ yêu mà, quỷ quyệt, xảo trá !"

#. Character:`narrator`
msgctxt "t9088251adb"
msgid "Bien qu'on se soit un peu rapprochés, je ne peux pas forcer {{asami.n}} à m'écouter."
msgstr "Dù có thân thiết hơn thật đấy, nhưng mình không thể buộc {{asami.n}} nghe mình được."

#. Character:`narrator`
msgctxt "home_asami_exterior_d0ab2f04"
msgid "Elle me prendrait pour un mec ultra possessif..."
msgstr "Bả sẽ nghĩ là mình bị cái tính chiếm hữu..."

#. Character:`narrator`
msgctxt "home_asami_exterior_40a8f93c"
msgid "Sans compter le fait qu'elle est censée disparaître pendant les vacances..."
msgstr "Còn chưa kể là ở tiền kiếp, bà ấy biến mất vào đâu đó trong kì lễ hội..."

#. Character:`narrator`
msgctxt "home_asami_exterior_bcc084e9"
msgid "Tout ça est un véritable casse-tête."
msgstr "Thật là muốn làm người ta bể óc quá đi."

#. Character:`narrator`
msgctxt "home_asami_exterior_4b1951d2"
msgid "Il faudra que j'en discute avec elle demain, même si elle finit par me détester je dois au moins essayer."
msgstr "Ngày mai nhất quyết phải đi hai mặt một lời với bà ấy mới được. Kể cả bà ấy có ghét mình cũng phải chịu thôi."

#. Character:`narrator`
msgctxt "tbd1a786d92"
msgid "Il est peut etre temps d'aller voir {{kimochi.n}}, il avait vu juste, {{minato.n}} est une belle ordure."
msgstr "Chắc là mình nên tới đánh bạn với {{kimochi.n}}. Nó nói đúng, {{minato.n}} là một tên cặn bã."

#. Character:`asami`
msgctxt "home_asami_exterior_4ad32068"
msgid "Merci de m'avoir raccompagnée !"
msgstr "Cảm ơn vì đã hộ tống tui về nghen !"

#. Character:`saito`
msgctxt "home_asami_exterior_1faaf8db"
msgid "Aucun problème."
msgstr "Không hề chi."

#. Character:`asami`
msgctxt "home_asami_exterior_fb1e524f"
msgid "Des choses de prévues pour demain ?"
msgstr "Mai ông đã tính làm gì chưa ?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_asami_exterior_35b68e6b"
msgid "C'est possible... On a quelques problèmes d'argent depuis un bout de temps."
msgstr "Có thể là... Gia đình nhà tôi đang gặp một số vấn đề tài chính."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_asami_exterior_634d5be1"
msgid "Et je n'ai pas l'intention de laisser {{yasuka.n}} s'occuper de ça toute seule."
msgstr "Và tôi sẽ không bỏ mặc cô {{yasuka.n}} phải chịu đựng một mình đâu."

#. Character:`asami`
msgctxt "home_asami_exterior_4f32f8c5"
msgid "Bon garçon !"
msgstr "Ngoan lắm !"

#. Character:`asami`
msgctxt "home_asami_exterior_4ec9622a"
msgid "Si tu as besoin d'aide fais-moi signe."
msgstr "Có việc chi khó cứ bảo tui nhé."

#. Character:`asami`
msgctxt "home_asami_exterior_fe7ab3b5"
msgid "À bientôt !"
msgstr "Tạm biệt nghen !"

#. Character:`nobu`
msgctxt "home_asami_exterior_477ebad3"
msgid "TA COPINE POURRA PAS TE PLANQUER NON PLUS !"
msgstr "CON BỒ CỦA MÀY KHÔNG THỂ CHE CHỞ CHO MÀY NỮA!"

#. Character:`asami`
msgctxt "A_QUOI_TU_PENSES_3FD71A"
msgid "À quoi tu penses ?"
msgstr ""

#. Character:`saito` | Attributes:`happy`
msgctxt "J_ESSAIE_SURTOUT_DE_D_IMAGINER_00C1D5"
msgid "J'essaie surtout d'imaginer à quel point tu lui ressembleras dans une dizaine d'années..."
msgstr ""

#. Character:`asami`
msgctxt "home_asami_exterior_b4ea0edb"
msgid "Et donc ?"
msgstr "Thế nào ?"

#. Character:`saito`
msgctxt "home_asami_exterior_c832ec8e"
msgid "Encore plus sexy qu'avant !"
msgstr "Sexy hơn trước nhiều !"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_a2a09166"
msgid "Pfff, idiot !"
msgstr "Pfff, ngố ạ !"

#. Character:`asami`
msgctxt "home_asami_exterior_25a1c25e"
msgid "Mais attention à toi ! Ne fais pas de charmes à ma mère !"
msgstr "Nhưng mà coi chừng đấy ! Cấm có mà quyến rũ mẹ tui !"

#. Character:`asami`
msgctxt "ET_FAIS_ATTENTION_ELLE_AUSSI_E_ED6B35"
msgid "Et fais attention à elle aussi, elle est restée seule bien trop longtemps."
msgstr ""

#. Character:`saito`
msgctxt "home_asami_exterior_70aa4137"
msgid "Tu crois que j'ai mes chances avec elle ?"
msgstr "Bà có nghĩ tôi có cửa với mẹ bà không ?"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_afd6c516"
msgid "Pfff, n'importe quoi ! J'ai pas envie de t'appeler beau-papa."
msgstr "Thôôôôi, xin người ! Tui không có mún gọi ông là 'dượng' đâu."

#. Character:`asami`
msgctxt "home_asami_exterior_4c5d35be"
msgid "Donc interdiction de faire du charme à ma mère !"
msgstr "Thế nên đừng có mà dùng mấy lời ngon ngọt dụ dỗ mẹ tui đấy !"

#. Character:`saito`
msgctxt "home_asami_exterior_bf86a093"
msgid "Et ton père ?"
msgstr "Thế còn ba của bà thì sao ?"

#. Character:`asami`
msgctxt "home_asami_exterior_8f1e5f73"
msgid "... Toujours en déplacement pour son travail."
msgstr "... Lúc nào cũng đi làm từ sáng sớm tới tối muộn."

#. Character:`asami`
msgctxt "home_asami_exterior_2724033d"
msgid "C'est à se demander s'il vit encore avec nous."
msgstr "Thật sự đấy, đôi khi không biết là ông ta có sống cùng nhà không nữa."

#. Character:`asami`
msgctxt "home_asami_exterior_a24e37ec"
msgid "Mais on s'en fiche de lui !"
msgstr "Nhưng đó không phải vấn đề !"

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_da2d2563"
msgid "Allez, fais pas ton timide et rentre !"
msgstr "Đừng ngại mà hãy vào đi !"

#. Character:`narrator`
msgctxt "home_asami_exterior_d65bfef1"
msgid "Bon... Supposons que {{sakuya.n}} soit assez folle pour mettre ses menaces à exécutions."
msgstr "Hừm, giả dụ rằng, {{sakuya.n}} thật sự loạn thần tới mức thực hiện lời đe dọa của cổ."

#. Character:`narrator`
msgctxt "A_FAIT_BIEN_TROP_LONGTEMPS_QU_27A2CF"
msgid "Ça fait bien trop longtemps qu’on me marche sur les pieds."
msgstr ""

#. Character:`narrator`
msgctxt "J_AI_PASS_TOUTE_MA_PR_C_DENTE_0D06D4"
msgid "J’ai passé toute ma précédente vie à subir ça."
msgstr ""

#. Character:`narrator`
msgctxt "HORS_DE_QUESTION_QUE_QUELQU_UN_13B56E"
msgid "Hors de question que quelqu’un me dicte à nouveau ce que je dois faire !"
msgstr ""

#. Character:`narrator`
msgctxt "SAKUYA_N_M_A_BEAUCOUP_AID_MAI_D8EA9D"
msgid "{{sakuya.n}} m’a beaucoup aidé, mais elle doit comprendre que j’aimerais mener ma vie comme je l’entends !"
msgstr ""

#. Character:`narrator`
msgctxt "DANS_TOUS_LES_CAS_JE_DEVRAIS_E_9E5387"
msgid "Dans tous les cas, je devrais en discuter avec {{kimochi.n}}."
msgstr ""

#. Character:`narrator`
msgctxt "IL_AURA_PEUT_TRE_UN_BON_CONSEI_63FE39"
msgid "Il aura peut-être un bon conseil pour moi."
msgstr ""

#. Character:`narrator`
msgctxt "NON_JE_REFUSE_DE_ME_FAIRE_INT_B6C328"
msgid "Non, je refuse de me faire intimider à nouveau !"
msgstr ""

#. Character:`narrator`
msgctxt "home_asami_exterior_6f56b7b5"
msgid "Ça me laisse très peu de marge de manœuvre."
msgstr "Khi đó thi mình chẳng khác gì cá nằm trên thớt."

#. Character:`narrator`
msgctxt "home_asami_exterior_c178439c"
msgid "Si je continue comme ça... Nul doute qu'elle s'en prendra à {{asami.n}} ou à {{yasuka.n}}."
msgstr "Nếu như cứ tiếp tục thế này... Rồi cô ta cũng sẽ ngắm tới {{asami.n}} hay là {{yasuka.n}}."

#. Character:`narrator`
msgctxt "home_asami_exterior_83fdd2be"
msgid "Dans mon ancienne vie, je n'avais jamais eu de contact avec elle..."
msgstr "Ở tiền kiếp, mình chưa bao giờ tiếp xúc với cô ấy..."

#. Character:`narrator`
msgctxt "home_asami_exterior_0502f17d"
msgid "À moins que... Maintenant ça me revient, pendant des années, je recevais des lettres flippantes."
msgstr "À nhưng mà khoan... Mình nhớ ra rồi. Hàng năm trời, mình hay nhận được mấy bức thư kì dị."

#. Character:`narrator`
msgctxt "home_asami_exterior_d9cf2131"
msgid "J'ai toujours pensé qu'on se foutait encore de moi."
msgstr "Hồi đ ócứ nghĩ rằng lũ khốn trong thị trấn lại đi lăng mạ mình nữa."

#. Character:`narrator`
msgctxt "home_asami_exterior_d9dbf047"
msgid "Merde à tous les coups, c'était elle !"
msgstr "Bà tổ sư bố, chắc chắn là cô ấy rồi !"

#. Character:`narrator`
msgctxt "home_asami_exterior_fb5a6958"
msgid "Maintenant, c'est certain, je dois agir."
msgstr "Giờ thì mình cần phải có cách đối phó."

#. Character:`narrator`
msgctxt "home_asami_exterior_e6915bde"
msgid "Mais je vais avoir besoin d'un second cerveau pour m'aider à me sortir de cette situation."
msgstr "Nhưng minh cần một cái đầu nữa có thể giúp mình thoát khỏi nghịch cảnh này."

#. Character:`narrator`
msgctxt "home_asami_exterior_ac1f83c2"
msgid "Il me faut des putains de contre-mesures appropriées !"
msgstr "Cần phải có các biện pháp đối kháng !"

#. Character:`narrator`
msgctxt "JE_DEVRAIS_PRENDRE_A_AU_S_RIE_48367E"
msgid "Je devrais prendre ça au sérieux"
msgstr ""

#. Character:`sakuya` | Attributes:`happy`
msgctxt "home_asami_exterior_06ccd550"
msgid "Je vais t'attendre, je ne serai pas très loin."
msgstr "Tớ sẽ đợi cậu. Tớ không ở xa đâu nghe."

#. Character:`saito`
msgctxt "home_asami_exterior_5a026e5f"
msgid "Je suppose que ça ne pouvait pas attendre demain ?"
msgstr "Tớ nghĩ rằng chắc nó không thể lùi lại ngày mai được nhỉ ?"

#. Character:`sakuya`
msgctxt "home_asami_exterior_15fdf806"
msgid "Pourquoi remettre au lendemain ce qu'on peut faire aujourd'hui ?"
msgstr "Sao phải lùi lại ngày mai khi ta có thể làm nó hôm nay ?"

#. Character:`saito`
msgctxt "home_asami_exterior_ddcf453b"
msgid "Évidemment..."
msgstr "Tất nhiên rồi..."

#. Character:`sakuya`
msgctxt "home_asami_exterior_a53b2246"
msgid "Fais vite mon chéri, j'ai hâte de pouvoir enfin passer du temps officiellement avec toi !"
msgstr "Nhanh lên nào, anh yêu ! Em rất hạnh phúc khi cuối cùng cũng có thể dành thời gian ở bên anh !"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_asami_exterior_b2dd3029"
msgid "Oh bon sang... Pardonne-moi {{asami.n}}."
msgstr "Thôi xong đời rồi... Hãy tha thứ cho tôi, {{asami.n}}."

#. Character:`saito`
msgctxt "home_asami_exterior_c4c1e48a"
msgid "C'est fait... Tu es satisfaite ?"
msgstr "Xong rồi... Cậu đã thỏa mãn chưa ?"

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "home_asami_exterior_2fde7283"
msgid "Ne fais pas cette mine... Tout ce qui est arrivé est entièrement de ta faute."
msgstr "Đừng làm bộ mặt như vậy chứ... Tất cả những điều vừa xảy ra đều là lỗi của cậu cả."

#. Character:`sakuya`
msgctxt "home_asami_exterior_c201d262"
msgid "C'est ce qu'il se passe quand on joue sur plusieurs tableaux."
msgstr "Đây là cái nghiệp cậu phải nhận lấy khi đi lang chạ với nhiều người."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "home_asami_exterior_d8156043"
msgid "Tu les oublieras vite avec moi, j'en suis certaine."
msgstr "Nhưng đừng lo, tớ tới đây để cứu rỗi cậu và sớm thôi, cậu sẽ chẳng còn nhớ ai ngoài tớ nữa."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_asami_exterior_3a5a21e3"
msgid "J'en doute..."
msgstr "Sus..."

#. Character:`sakuya`
msgctxt "home_asami_exterior_dd938175"
msgid "J'ai préparé une petite surprise pour te remonter le moral."
msgstr "Tớ đã chuẩn bị một bất ngờ nho nhỏ cho cậu để cậu vui lên."

#. Character:`sakuya` | Attributes:`angry`
msgctxt "home_asami_exterior_56d0e60f"
msgid "... et si tu n'y mets pas un peu de bonne volonté, je retournerai voir tes ex personnellement."
msgstr "... và nếu như cậu không có đón nhận nó, tớ sẽ tới nói chuyện thẳng thắn với mấy cô bồ của cậu đó nha."

#. Character:`saito`
msgctxt "home_asami_exterior_8e2286ac"
msgid "J'ai compris, j'ai compris..."
msgstr "Tớ hiểu, tớ hiểu..."

#. Character:`saito`
msgctxt "home_asami_exterior_40e9ff90"
msgid "J'ai hâte de voir ce que tu m'as préparé !"
msgstr "Nào cùng xem xem cậu đã chuẩn bị gì cho tớ nào !"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "home_asami_exterior_44b7e0d8"
msgid "Oohhh, tu vas voir, tu vas adorer !"
msgstr "Fufufu, chuẩn bị đi nhé. Cậu sẽ thích nó lắm !"

#. Character:`saito`
msgctxt "home_asami_exterior_c10e5f8b"
msgid "{{kimochi.n}}, je compte sur toi, ne me laisse surtout pas tomber !"
msgstr "{{kimochi.n}}, bố đang trông cậy vào mầy đấy, đừng làm bố thất vọng nha !"

#. Character:`kimochi`
msgctxt "home_asami_exterior_2ac904f2"
msgid "Tiens, vu l'heure qu'il est, {{saito.n}} doit être foutu..."
msgstr "Nhìn vào thờ gian thì... Chắc là {{saito.n}} toang rồi..."

#. Character:`kimochi`
msgctxt "home_asami_exterior_d45fa43b"
msgid "Sa lettre attendra demain..."
msgstr "Mà keme, để ngày mai hẵng giao thư..."

#. Character:`kimochi`
msgctxt "home_asami_exterior_f28e774d"
msgid "Ça lui apprendra à vouloir se faire un harem !"
msgstr "Lập harem rồi bỏ bê anh em sẽ bị như thế đấy !"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "home_asami_exterior_9d33e59e"
msgid "Tu aimes les onsen ?"
msgstr "Cậu có thích onsen không ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_asami_exterior_7113cf57"
msgid "Euh... Oui."
msgstr "Ờm... Có ?"

#. Character:`sakuya`
msgctxt "home_asami_exterior_2cfb4106"
msgid "Alors dépêchons-nous."
msgstr "Vậy thì mau nhanh lên."

#. Character:`asami`
msgctxt "home_asami_exterior_260b098b"
msgid "[font_size=14]Maman, c'est moi ! Nous sommes rentrées ![/font_size]"
msgstr "[font_size=14]Mẹ ơi, là con đây! Tụi con về rồi !![/font_size]"

#. Character:`noriko`
msgctxt "home_asami_exterior_c83e7812"
msgid "[font_size=14]Bonjour Madame ![/font_size]"
msgstr "[font_size=14]Thưa quý cô, con xin phép quý cô con vào nhà ![/font_size]"

#. Character:`sayuri`
msgctxt "home_asami_exterior_d9de0938"
msgid "[font_size=14]Oh, tu es mignonne à croquer toi ! Ne m'appelle pas madame, appelle-moi {{sayuri.n}}.[/font_size]"
msgstr "[font_size=14]Ôi, con đáng yêu quá đi ! Hãy gọi là cô, hoặc {{sayuri.n}}, nhé ![/font_size]"

#. Character:`asami`
msgctxt "home_asami_exterior_215a0456"
msgid "[font_size=14]M'man ! Arrête, tu dis toujours ça...[/font_size]"
msgstr "[font_size=14]Mẹ à, mẹ nên bảo người ta gọi là cô chứ...[/font_size]"

#. Character:`asami`
msgctxt "home_asami_exterior_32173058"
msgid "Bon, tu es prête ?!"
msgstr "Thế, đã chuẩn bị chưa ?!"

#. Character:`noriko` | Attributes:`bad`
msgctxt "home_asami_exterior_b2953740"
msgid "Oui ! Je ferai un scandale en bas et pendant qu'elle sera occupée avec moi, tu pourras librement entrer dans sa chambre."
msgstr "Rồi ! Em sẽ quẩy ở dưới nhà, giữ chân cô ta, xong rồi chị lẻn lên phòng cổ."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_40424a32"
msgid "Parfait, n'oublie pas de crier bien fort si jamais il y a le moindre problème !"
msgstr "Chuẩn rồi đó ! Nhớ là nếu có nhờ vả hay vấn đề gì thì hét thật to để ghim con nhỏ đó lại nhá !"

#. Character:`noriko`
msgctxt "home_asami_exterior_2b1eea0b"
msgid "Je suis sûre que je peux la gérer, avec la poitrine qu'elle se tape, je suis certaine qu'elle ne doit pas courir bien vite !"
msgstr "Con bà vú bò khủng bố như thế thì chắc chán không thể chạy nhanh được !"

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_exterior_e6b56b52"
msgid "Espérons-le..."
msgstr "Hy vọng vậy..."

#. Character:`unknown`
msgctxt "home_asami_exterior_433d3733"
msgid "Désolé de faire irruption dans la conversation comme ça, mais je dois te parler seul à seul."
msgstr "Xin lỗi vì đã cắt ngang cuộc trò chuyện, nhưng tôi cần nói chuyện riêng với cô."

#. Character:`asami`
msgctxt "home_asami_exterior_6c256093"
msgid "Fais vite, je suis pressée !"
msgstr "Nhanh lên ! Tôi đang gấp !"

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_exterior_7d03b7d0"
msgid "{{saito.n}} a des ennuis."
msgstr "{{saito.n}} đang gặp nguy hiểm."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_asami_exterior_cc1a5b4b"
msgid "C'est justement à cause de ça que je suis venu te voir."
msgstr "Đó chính là lý do tại sao tôi tới đây để tìm cô."

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_exterior_28dfffbe"
msgid "T'es qui et tu veux quoi ?"
msgstr "Anh là ai, và anh muốn gì ?"

#. Character:`kimochi`
msgctxt "home_asami_exterior_bb0bdfb9"
msgid "Si je suis là, c'est à cause de ce qui s'est passé avec {{saito.n}}..."
msgstr "Tôi ở đây, vì đã có chuyện gì đó xảy ra với {{saito.n}}..."

#. Character:`asami`
msgctxt "home_asami_exterior_7558dac8"
msgid "C'est-à-dire ?"
msgstr "Và chuyện gì đó là ?"

#. Character:`asami`
msgctxt "home_asami_exterior_84bf3656"
msgid "{{noriko.n}}, tu peux m'attendre un peu plus loin ?"
msgstr "{{noriko.n}}, em đợi chị một lát nữa có được không ?"

#. Character:`noriko`
msgctxt "home_asami_exterior_19069491"
msgid "Okay..."
msgstr "Vâng..."

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_exterior_3172f87d"
msgid "Pourquoi tant de mystère ?"
msgstr "Tại sao nhiều ẩn ý vậy ?"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_asami_exterior_06786325"
msgid "{{saito.n}} savait que tout ça allait se produire."
msgstr "{{saito.n}} biết rằng chuyện này rồi cũng sẽ xảy ra."

#. Character:`kimochi`
msgctxt "home_asami_exterior_eee35e16"
msgid "Tout ça est arrivé à cause de lui d'une certaine manière."
msgstr "Bằng cách kỳ diệu nào đó, tất cả đều là lỗi của ổng."

#. Character:`asami` | Attributes:`angry`
msgctxt "home_asami_exterior_f6691209"
msgid "Je ne vais pas te laisser dire du mal de lui dans son dos sans rien dire..."
msgstr "Tôi sẽ không để anh nói xấu sau lưng ông ấy đâu..."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_asami_exterior_18f5337b"
msgid "Tu comprendras bien assez vite."
msgstr "Rồi cô sẽ hiểu thôi."

#. Character:`kimochi`
msgctxt "home_asami_exterior_3e7d8ad8"
msgid "À l'origine, il avait écrit une lettre qui t'était destinée et qui expliquait pourquoi il avait dû te quitter ce soir-là."
msgstr "Ban đầu thì ông ấy viết một bức thư giải thích tại sao ổng phải bỏ cô mà đi đêm ấy."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_exterior_8790ecc5"
msgid "Tu veux dire qu'il avait vraiment l'intention de me quitter ?"
msgstr "Anh nói nghĩa là ông ấy thực sự có ý định bỏ tôi sao ?"

#. Character:`asami` | Attributes:`sad`
msgctxt "tb599877384"
msgid "Tu veux dire qu'il avait vraiment l'intention de me mettre fin à notre amitié ?"
msgstr "Ý anh là cậu ấy hết muốn làm bạn với tôi ư ?"

#. Character:`kimochi`
msgctxt "tdeed58f0ad"
msgid "Pour te protéger, il a dû se séparer de toi."
msgstr "Để bảo vệ cô, cậu ta phải tránh xa cô."

#. Character:`kimochi`
msgctxt "home_asami_exterior_98206731"
msgid "Il y a une fille qui observe {{saito.n}} de loin depuis visiblement très longtemps."
msgstr "Có một cô gái đã bám sát và theo dõi {{saito.n}}, hẳn nhiên từ rất lâu rồi."

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_c9981f9a"
msgid "La fille en kimono !"
msgstr "Con mẹ bận đồ kimono !"

#. Character:`kimochi`
msgctxt "home_asami_exterior_9f3cc437"
msgid "Elle s'appelle {{sakuya.n}}... Elle est totalement déséquilibrée et n'hésiterait pas à tuer pour lui."
msgstr "Cô ấy tên là {{sakuya.n}}... Cô ta là một tên tâm thần, sẵn sàng giết hại vì người cô ta yêu."

#. Character:`kimochi`
msgctxt "home_asami_exterior_2b2f898b"
msgid "Mais surtout, elle n'hésitera pas un seul instant à se débarrasser de toutes celles qui sont sur son chemin."
msgstr "Đặc biệt là, cổ sẽ không do dự xóa xổ tất cả những kẻ ngáng đường."

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_exterior_fe4fd63b"
msgid "Comment ça toutes celles qui sont sur son chemin ?"
msgstr "\"Những\" Ý anh nghĩa là sao ?"

#. Character:`asami`
msgctxt "home_asami_exterior_651cf186"
msgid "Je ne suis pas la seule... ?"
msgstr "Tôi không phải... người duy nhất ư... ?"

#. Character:`asami` | Attributes:`angry`
msgctxt "t2fefbfaf45"
msgid "... Je veux savoir qui est l'autre !"
msgstr "... Tôi cần được biết nguyên do là vì ai !"

#. Character:`asami`
msgctxt "t6f6a1b215c"
msgid "{{saito.n}} a plusieurs...?"
msgstr "{{saito.n}} chắc là có vài đối phương hay... ?"

#. Character:`kimochi` | Attributes:`sad`
msgctxt "tda83a2fbf3"
msgid "C'est...[w] C'est quelque chose que tu dois apprendre de sa bouche, pas de la mienne !"
msgstr "Cái đấy thì...[w]Chắc cô phải tự tìm hiểu thôi !"

#. Character:`asami` | Attributes:`upset`
msgctxt "home_asami_exterior_87c30b61"
msgid "..."
msgstr "..."

#. Character:`kimochi`
msgctxt "home_asami_exterior_67dd7679"
msgid "Si jamais tu décidais de laisser tomber à cause de ça, personne ne t'en voudra."
msgstr "Giờ cô đã biết điều này, nếu như cô buông tay, sẽ chẳng ai trách cô cả."

#. Character:`kimochi`
msgctxt "home_asami_exterior_16740f60"
msgid "J'irai le récupérer avec un bon ami à moi."
msgstr "Dù gì tôi cũng sẽ cứu anh ta ra nhờ sự giúp sức của một người bạn thân thiết."

#. Character:`asami`
msgctxt "home_asami_exterior_ad8de66e"
msgid "Non...[w] Je vais le tirer de là moi-même et il me devra des explications !"
msgstr "Không...[w] Tôi sẽ tự mình cứu ông ấy, bởi ông ấy nợ tôi một lời giải thích !"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_asami_exterior_777d13b8"
msgid "[font_size=14]Putain {{saito.n}}, t'as vraiment trop de chance enfoirééééé ![/font_size]"
msgstr "[font_size=14]Lồn mẹ mày chứ, {{saito.n}}! Mày còn khốn nạn và bá đạo hơn mấy thằng tóc che mặt trong hentai nữa ![/font_size]"

#. Character:`asami`
msgctxt "home_asami_exterior_9804d68b"
msgid "Vous allez venir avec nous, toi et ton pote !"
msgstr "Anh, hãy đi cùng chúng tôi, cả anh và người bạn của anh nữa !"

#. Character:`asami`
msgctxt "home_asami_exterior_b164e915"
msgid "Si elle est si dangereuse que ça, alors on aura besoin d'aide !"
msgstr "Nếu như đối thủ nguy hiểm tới vậy, thì chúng ta sẽ cần thêm trợ giúp !"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_asami_exterior_88931928"
msgid "Hey, je tiens à ma vie moi !"
msgstr "Này, tôi vẫn còn trẻ ! Tôi chưa muốn chết !"

#. Character:`asami`
msgctxt "home_asami_exterior_1d594c78"
msgid "{{noriko.n}} ! On y va, il y a toujours quelqu'un qui nous doit des explications !"
msgstr "{{noriko.n}}! Đi thôi ! Có người đang trông ngóng chúng ta !"

#. Character:`noriko`
msgctxt "home_asami_exterior_900264ec"
msgid "Enfin ! J'étais en train de prendre racine !"
msgstr "Cuối cùng thì ! Chờ bà chị lâu quá, em cắm rễ ở đây rồi !"

#. Character:`asami`
msgctxt "home_asami_exterior_0aefa1f0"
msgid "Allez, retrouvez-nous au restaurant d'udon et ne traînez pas !"
msgstr "Nào ! Hãy gặp nhau ở Quán Udon, và đừng đến muộn đấy nhé !"

#. Character:`macumba`
msgctxt "home_asami_exterior_98135ec9"
msgid "Un problème petit frère ?"
msgstr "Có chuyện gì không ổn sao, người anh em ?"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_asami_exterior_148e3132"
msgid "... Non.[w] Allons tirer {{saito.n}} de là."
msgstr "...Ồ không.[w] Hãy cùng đi giải cứu {{saito.n}} nào."

#. Character:`macumba` | Attributes:`happy`
msgctxt "home_asami_exterior_a958d45e"
msgid "On y va en petite foulée ?"
msgstr "Chúng ta chạy bước nhỏ chứ ?"

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_asami_exterior_9e005ef5"
msgid "Oh bon sang..."
msgstr "Ôi cứt đái rồi..."

#. Character:`asami`
msgctxt "home_asami_exterior_acd5717a"
msgid "... Bon j'espérais te garder pour moi toute la nuit."
msgstr "TUi không tính giữ ông cả đêm ở đây."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_7aaa971a"
msgid "Mais je ne regrette rien !"
msgstr "Nhưng tui vui lắm !"

#. Character:`saito`
msgctxt "home_asami_exterior_1883d550"
msgid "Dès que cette histoire avec {{noriko.n}} sera réglée, on essaiera de trouver du temps rien que pour toi et moi."
msgstr "Sau khi vấn đề với {{noriko.n}} được giải quyết, tôi sẽ cố gắng tạo thời gian chỉ cho đôi ta."

#. Character:`saito`
msgctxt "home_asami_exterior_1ac6a598"
msgid "Je pourrais t'emmener aux sources chaudes... {{sakuya.n}} a dit qu'on pouvait les utiliser gratuitement."
msgstr "Để tôi đưa bà tới suối nước nóng... {{sakuya.n}} bảo rằng tụi ta sử dụng nó lúc nào cũng được."

#. Character:`asami`
msgctxt "home_asami_exterior_2d9aa857"
msgid "C'est vrai ?[w] Oh j'ai hâte d'y être alors."
msgstr "Thật ư ? [w] Vậy tui háo hức lắm đó."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_asami_exterior_dff7733f"
msgid "Fais attention à toi quand même..."
msgstr "Nhưng nhớ chăm sóc bản thân đấy nhé..."

#. Character:`asami`
msgctxt "home_asami_exterior_7bccc965"
msgid "Te savoir pris pour cible m'inquiète quand même beaucoup."
msgstr "Các cuộc chiến cứ xoay quanh ông hoài làm tui lo lắm lun á."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_asami_exterior_03517765"
msgid "Je te promets de faire attention, et grâce à {{macumba.n}} personne ne pourra me rattraper !"
msgstr "Hứa với bà đấy. Vả lại, có cả {{macumba.n}} mà, chẳng ai rờ được gáy tôi đâu !"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_asami_exterior_86a8dc9c"
msgid "Ça ne me rassure pas idiot !"
msgstr "Vẫn chẳng hết lo gì sất !"

#. Character:`asami`
msgctxt "home_asami_exterior_4633e8a7"
msgid "[font_size=14]{{saito.n}} tu sais bien que tu peux entrer et faire comme chez toi ![/font_size]"
msgstr "[font_size=14]{{saito.n}}, cứ vào đi, ông không cần phải gõ chuông cửa đâu mà ![/font_size]"

#. Character:`netoru`
msgctxt "home_asami_exterior_d80893ae"
msgid "Dans ce cas, permettez-moi de m'imposer."
msgstr "Vậy thì, xin phép gia chủ nhé, hàhà."

#. Character:`asami`
msgctxt "home_asami_exterior_c1ce4042"
msgid "Hey ! Vous êtes qui vous ? Sortez d'ici tout de suite !"
msgstr "Này ! Ông là ai ? Ra khỏi nhà tôi ngay !"

#. Character:`netoru`
msgctxt "home_asami_exterior_914208de"
msgid "J'ai bien peur qu'il soit trop tard pour ça..."
msgstr "Quá muộn rồi, bé con à..."

#. Character:`netoru`
msgctxt "home_asami_exterior_61b62624"
msgid "Mais ne t'en fais pas, tu vas apprendre à me connaître."
msgstr "Chúng ta rồi sẽ thân nhau thôi mà."

#. Character:`netoru`
msgctxt "home_asami_exterior_81ef271b"
msgid "Et tu finiras par apprécier..."
msgstr "Rồi mày sẽ phải thích tao thôi..."

#. Character:`asami`
msgctxt "home_asami_exterior_4a6b0d0d"
msgid "Vous délirez ! Je... Nonnn ! Arrêtez !"
msgstr "Biến... Cái ông này... Không !!! Bỏ tôi ra !!!"

#. Character:`asami`
msgctxt "home_asami_exterior_cc85cb2b"
msgid "...C'était sympa... On devrait vraiment se faire ça plus souvent !"
msgstr "... Vui thật đấy... Tụi mình nên đi chơi nhiều hơn !"

#. Character:`saito`
msgctxt "home_asami_exterior_546cd231"
msgid "Quand tu voudras !"
msgstr "Cứ tạt qua bao giờ cũng okie !"

#. Character:`saito`
msgctxt "home_asami_exterior_31fbb2aa"
msgid "Bon faut que je te laisse, {{noriko.n}} m'attend !"
msgstr "Chà, tôi cần phải đi rồi, {{noriko.n}} đang chờ tôi !"

#. Character:`asami` | Attributes:`neutral`
msgctxt "home_asami_exterior_82a55b09"
msgid "Ah oui ! Cette histoire de gâteau..."
msgstr "À đúng rồi ! Câu chuyện về cái bánh..."

#. Character:`asami`
msgctxt "home_asami_exterior_d50ef64a"
msgid "J'avoue que je suis curieuse, tu me diras si c'est une réussite ou pas."
msgstr "Tui rất chi là tò mò đó nha, thế nên nhớ kể tôi nghe sau khi xong chuyện nhé."

#. Character:`saito`
msgctxt "home_asami_exterior_7404c1bf"
msgid "Ça va être une surprise totale, c'est la première fois qu'elle va faire quelque chose comme ça."
msgstr "Chắc tại con bé chưa nấu ăn bao giờ đây."

#. Character:`asami` | Attributes:`happy`
msgctxt "home_asami_exterior_5daaa213"
msgid "Haha.. j'espère que tu as l'estomac bien accroché."
msgstr "Haha... Liệu mà tiết kiệm cái bụng đi ông ạ."

#. Character:`saito`
msgctxt "home_asami_exterior_105d2bbc"
msgid "Je l'espère aussi."
msgstr "Phải chứ."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "t178f0224ee"
msgid "Oh c'est toi {{saito.n}} !"
msgstr "A, là con đấy à, {{saito.n}} !"

#. Character:`saito` | Attributes:`happy`
msgctxt "t3d5b610b53"
msgid "J'avais promis à {{asami.n}} de venir la voir dès que tous mes problèmes avec {{noriko.n}} étaient réglés donc... me voilà."
msgstr "Con có hứa là sẽ tới thăm {{asami.n}} sau khi giải quyết xong xuôi mọi chuyện với {{noriko.n}}, thế nên là... hôm nay con tới thăm nhà ạ."

#. Character:`saito` | Attributes:`guilty`
msgctxt "tfc9590deec"
msgid "Peut-être que je n'aurais pas dû venir aussi tôt ?"
msgstr "Chắc là con cũng tới có hơi sớm quá đúng không ạ ?"

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t8113ed8a5c"
msgid "Non tu ne me dérange pas mais..."
msgstr "Ừm thì, cũng không có gì đâu, nhưng mà..."

#. Character:`sayuri`
msgctxt "tc1c7c75c41"
msgid "Ma fille est partie hier soir passer quelques jours en compagnie de son père."
msgstr "Bé con nhà cô cùng với Ba nó đi chơi xả hơi dài ngày mất rùi."

#. Character:`sayuri`
msgctxt "t6a208ce2a8"
msgid "Sans m'en avertir."
msgstr "Cũng chẳng báo gì cho cô luôn."

#. Character:`saito` | Attributes:`surprised`
msgctxt "td4c91a9314"
msgid "Oh je vois, je ne savais pas non plus."
msgstr "À... vậy ạ. Cậu ấy cũng chẳng báo gì con cả."

#. Character:`sayuri` | Attributes:`sad`
msgctxt "t3831819e03"
msgid "Je suis désolée, je pensais qu'elle t'aurait averti également."
msgstr "Cô xin lỗi, cô cứ nghĩ là hai đứa biết trước với nhau rồi."

#. Character:`saito` | Attributes:`happy`
msgctxt "t3215090795"
msgid "Elle a du partir précipitamment..."
msgstr "Cậu ấy bỏ đi đột ngột vậy..."

#. Character:`sayuri`
msgctxt "t219a7effa9"
msgid "Je sens que la maison va être bien vide pendant ces quelques jours."
msgstr "Ngôi nhà sẽ hơi thiếu hơi người trong vài tuần đây. (Tl edit: Để con vào massage cho hai ta \"nóng\", làm một đứa gia đình thêm đầm ấm hơn <33333)"

#. Character:`saito`
msgctxt "t6987dc3ecd"
msgid "Je peux vous tenir compagnie un peu si..."
msgstr "Nếu cô có cần người hàn huyên đàm tiếu thì con có thể..."

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t409b682eba"
msgid "{{saito.n}} arrête de me vouvoyer et ne t'en fais pas, je dois aller travailler."
msgstr "{{saito.n}} ! Không cần phải lễ lạt bề trên bề dưới thế cho mệt.Thôi, đừng lo, tí nữa cô đi làm ngay ấy mà."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "ta0a428954b"
msgid "Le konbini ne va pas se gérer tout seul."
msgstr "Không có cô làm thu ngân thì lấy ai mua đồ nữa."

#. Character:`saito`
msgctxt "t3c04d4143c"
msgid "C'est vrai... Dans ce cas, à bientôt {{sayuri.n}}."
msgstr "Dạ vâng... Đã vậy thì, gặp lại cô {{sayuri.n}}. sau ạ. (TL edit: Cô có bảo con mua đồ hết hạn + lấy giá gấp đôi cũng mua ⸜(｡˃ ᵕ ˂)⸝♡  ahhh moment )"

#. Character:`saito` | Attributes:`surprised`
msgctxt "ta6b983bbcb"
msgid "Wow..."
msgstr "Wow..."

#. Character:`sayuri` | Attributes:`sad,blush`
msgctxt "tde58bad895"
msgid "C'est quoi cette tête, ma robe ne te plait pas ?"
msgstr "Sao dzợ, váy của cô xấu lắm đúng không ?"

#. Character:`saito`
msgctxt "t7d5ba18895"
msgid "Non bien au contraire, tu es..."
msgstr "Dạ không không, con thấy nó rất chi là... (TL edit: dunhenhang, dutanbao, dutoingat, hoitruockhiban, bantumlum)"

#. Character:`saito` | Attributes:`happy`
msgctxt "t828db245df"
msgid "Magnifique !"
msgstr "Đẹp tuyệt trần ạ ! (TL edit : Thôi thôi thôi bạn đừng có mồm điêu đi, lại sắp nạp cung tới nơi rồi !)"

#. Character:`sayuri` | Attributes:`moved,blush`
msgctxt "t26ba1fa559"
msgid "....[w]Oh merci, je ne m'attendais pas à un tel compliment."
msgstr "....[w] Cảm ơn con nhé... Lâu lắm rồi mới có ai đó khen cô như vậy."

#. Character:`sayuri`
msgctxt "ALORS_QUI_EST_LA_PLUS_JOLIE_LA_832140"
msgid "Alors... Qui est la plus jolie ? La mère ou la fille ?"
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
msgctxt "HAHAHA_C_EST_VRAI_EXCUSE_MOI_0DDAA0"
msgid "Hahaha... c'est vrai, excuse-moi !"
msgstr ""

#. Character:`sayuri`
msgctxt "JE_NE_DEVRAIS_PAS_DEMANDER_CE_04882A"
msgid "Je ne devrais pas demander ce genre de choses."
msgstr ""

#. Character:`sayuri`
msgctxt "ELLE_ME_FERAIT_LA_T_TE_JUSQU_L_83916C"
msgid "Elle me ferait la tête jusqu'à la fin de ma vie si je lui piquais son petit ami."
msgstr ""

#. Character:`saito` | Attributes:`guilty`
msgctxt "QUI_A_DIT_QUE_JE_ME_LAISSERAIS_63304B"
msgid "Qui a dit que je me laisserais faire ?"
msgstr ""

#. Character:`sayuri`
msgctxt "W_JE_SUIS_HEUREUSE_DE_VOIR_QU_DE4AB8"
msgid "...[w] Je suis heureuse de voir que tu es une personne fiable, {{saito.n}}."
msgstr ""

#. Character:`narrator`
msgctxt "TU_VEUX_QU_ELLE_M_TRANGLE_EN_93577A"
msgid "Tu veux qu'elle m'étrangle en fait ?"
msgstr ""

#. Character:`sayuri`
msgctxt "OH_VRAIMENT_E8C9A6"
