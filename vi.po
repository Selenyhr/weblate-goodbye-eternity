msgctxt "bar_exterior_b7f074a1"
msgid "Elle appartenait à papa, elle est à moi maintenant !"
msgstr "Của ba thì cũng là của con !"

#. Character:`unknown`
msgctxt "bar_exterior_4478a5f4"
msgid "C'est ma moto petit idiot... Je l'ai prêtée à ton père, c'est tout !"
msgstr "Xe của tao nhé, thằng óc chó... Tao chỉ cho ba mày mượn thôi !"

#. Character:`kenji`
msgctxt "bar_exterior_beda678d"
msgid "...[font_size=14]M'en fous... j'aurai le dernier mot, c'est moi qui roulerai avec.[/font_size]"
msgstr "...[font_size=14]Sủa cái lồn... Tao thích thì tao lái tao đi.[/font_size]"

#. Character:`unknown`
msgctxt "bar_exterior_4187af0f"
