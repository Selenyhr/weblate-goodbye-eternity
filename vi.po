msgstr ""

#. Character:`sayuri`
msgctxt "ET_QUE_DIRAIT_ASAMI_N_SI_ELLE_DB1CC7"
msgid "Et que dirait {{asami.n}} si elle savait que son petit ami n'est pas insensible au charme de la mère ?"
msgstr ""

#. Character:`saito` | Attributes:`guilty`
msgctxt "EST_ELLE_VRAIMENT_OBLIG_E_DE_L_4E030A"
msgid "Est-elle vraiment obligée de le savoir... ?"
msgstr ""

#. Character:`sayuri`
msgctxt "DONC_A_RESTERAIT_ENTRE_NOUS_B17609"
msgid "Donc ça resterait entre nous ?"
msgstr ""

#. Character:`sayuri`
msgctxt "NOTRE_VILAIN_PETIT_SECRET_99A221"
msgid "Notre vilain petit secret ?"
msgstr ""

#. Character:`saito`
msgctxt "_2D9E76"
msgid "..."
msgstr ""

#. Character:`sayuri`
msgctxt "HAHAHA_J_AIME_VOIR_TA_T_TE_D_C_4DA069"
msgid "Hahaha ! J'aime voir ta tête décomposée, mais..."
msgstr ""

#. Character:`narrator`
msgctxt "EH_BIEN_IL_FAUT_SAVOIR_TRE_HO_F1DD41"
msgid "Eh bien... il faut savoir être honnête, et j'avoue que..."
msgstr ""

#. Character:`sayuri`
msgctxt "t72601da5ff"
msgid "Peut être que j'en ai trop fait ?"
msgstr "Có... hợp với cô thật không ? Có... hơi quá không ?"

#. Character:`sayuri` | Attributes:`sad,blush`
msgctxt "tcaae445d4e"
msgid "Je devrais peut être mettre quelque chose de plus simple après tout..."
msgstr "Đúng ra cô nên ăn mặc đơn giản hơn nhỉ... (TL edit Bikini hai dây cho nóng ! Mà thôi, không mặc luôn đi 0_0 )"

#. Character:`saito` | Attributes:`surprised`
msgctxt "t8e7bad3ac0"
msgid "NON !"
msgstr "KHÔNG !"

#. Character:`saito` | Attributes:`guilty`
msgctxt "te921b6730e"
msgid "Je veux dire... non, tu es parfaite... je veux dire, c'est parfait comme ça."
msgstr "Dạ không... Ý con là... Con muốn nói là... Rất hợp ạ."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "t56126c5a15"
msgid "Merci !"
msgstr "Cảm ơn !"

#. Character:`sayuri`
msgctxt "t3c2faac069"
msgid "J'avais achetée cette robe il y a quelques années pour un rendez vous avec mon mari mais...."
msgstr "Cô sắm bộ này mấy năm trước để mặc đi nghỉ mát với chồng cô, nhưng mà..."

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t5acaa6898c"
msgid "Il a annulé et je n'ai plus jamais eu l'occasion de la porter."
msgstr "Ông ta hủy chuyến, thế là nó nằm mốc meo trong tủ đến giờ."

#. Character:`saito`
msgctxt "t4e8d321518"
msgid "Et bien... Il ne sait pas ce qu'il a raté !"
msgstr "Chà chà... Vậy thì chú ấy không gặp may rồi !"

#. Character:`sayuri`
msgctxt "tc8f9192396"
msgid "Je suis sur que tu exagères..."
msgstr "Con cứ làm quá lên..."

#. Character:`sayuri` | Attributes:`depressed`
msgctxt "td3a81e1bb1"
msgid "Je suis certainement un peu boudinée et..."
msgstr "Eo cô không thon, dáng cô không đẹp, và rồi..."

#. Character:`saito` | Attributes:`upset`
msgctxt "t38eddd9a1d"
msgid "{{sayuri.n}} fais moi confiance cette robe te va à merveille !"
msgstr "{{sayuri.n}}, cô cứ tin con ! Trong bộ váy đó, cô đẹp nhất trần đời !"

#. Character:`sayuri` | Attributes:`moved`
msgctxt "t2ff8067ce4"
msgid "Tu promet ?"
msgstr "Thật... chứ ?"

#. Character:`saito` | Attributes:`happy`
msgctxt "t1080d04cbf"
msgid "Je le promet !"
msgstr "Nói điêu Thiên Lôi đánh chết con luôn !"

#. Character:`sayuri` | Attributes:`happy`
msgctxt "ta1e20becb7"
msgid "D'accord, je la garde alors !"
msgstr "Ấy ! Kìa ! Cứ đùa... Okê, vậy cô mặc bộ này đi chơi !"

#. Character:`sayuri`
msgctxt "t213503dd93"
msgid "Ou vas t'on ?"
msgstr "Cô con mình đi đâu hôm nay ?"

#. Character:`saito`
msgctxt "t59f4cca4b8"
msgid "C'est une surprise !"
msgstr "Bí mật ạ !"

#. Character:`sayuri`
msgctxt "teedbb50128"
msgid "Tu peux bien me donner un petit indice quand même ?"
msgstr "Úi ! Háo hức ghê ! Gợi ý tí ti thui ?"

#. Character:`sayuri` | Attributes:`pouting,blush`
msgctxt "tafe3c22454"
msgid "{{saito.n}} je... Je ne te savais pas si... audacieux..."
msgstr "{{saito.n}}... cô không biết là... con bạo tới vậy..."

#. Character:`sayuri`
msgctxt "t4704a9ed33"
msgid "Je ne sais pas si... c'est une bonne idée de..."
msgstr "Cô không biết là... liệu ... có nên..."

#. Character:`saito` | Attributes:`guilty`
msgctxt "t73b6fc7507"
msgid "Je ne sais pas ce que tu es en train d'imaginer mais je crois que tu fais fausse route."
msgstr "Con cũng không biết là con vừa làm gì nữa."

#. Character:`narrator`
msgctxt "t7eb3637df6"
msgid "On va quelque part ou on va pouvoir enlever nos vetements."
msgstr "Mình ra chỗ nào cởi quần áo cho bớt nóng đi cô."

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t1a5bcdf3e5"
msgid "Très bien, très bien, j'attendrais !"
msgstr "Okê, chờ thì chờ !"

#. Character:`narrator`
msgctxt "tad24e3ccbf"
msgid "Tu verras bien"
msgstr "Rồi cô sẽ biết ạ."

#. Character:`sayuri` | Attributes:`moved`
msgctxt "tf62c795a41"
msgid "Merci infiniment pour cette journée {{saito.n}}."
msgstr "Cô không biết phải cảm ơn con bao nhiêu vì ngày hôm nay nữa, {{saito.n}} ạ."

#. Character:`sayuri`
msgctxt "t08489ca00d"
msgid "Ça doit être la première fois de ma vie que je vis ce genre d'expérience."
msgstr "Chắc phải cả đời rồi cô mới có được một ngày hôm nay đấy nha."

#. Character:`saito` | Attributes:`surprised`
msgctxt "t4be68660ff"
msgid "Vraiment ? Pourtant ce n'était pas grand chose je t'assure, ça m'a fait plaisir."
msgstr "Thật hả cô ? Cũng chẳng có gì đâu cô, chỉ cần cô vui là tốt rồi."

#. Character:`sayuri`
msgctxt "t573da60dc9"
msgid "...[w]Ne sous-estime pas l'importance des efforts que tu as faits."
msgstr "...[w] Đừng đánh giá thấp những gì con đã làm vì cô."

#. Character:`sayuri`
msgctxt "t989c808682"
msgid "Je suis vraiment heureuse pour la première fois depuis longtemps."
msgstr "Lâu lắm rồi, cô mới cười nhiều như ngày hôm nay."

#. Character:`sayuri` | Attributes:`sad,blush`
msgctxt "t252ed4ec7d"
msgid "Je crois que je vais pleurer..."
msgstr "Cô cười nhiều đến nỗi... gớt nước mắt luôn nè..."

#. Character:`saito` | Attributes:`guilty`
msgctxt "t5fd9aacab1"
msgid "Quoi ?! Non !"
msgstr "Ấy cô ?! Con..."

#. Character:`saito` | Attributes:`sad`
msgctxt "t59a5887a58"
msgid "Ne pleure pas, j'ai vraiment passé une bonne journée moi aussi et..."
msgstr "Cô đừng khóc mà, có hề gì phía con đâu cô, con..."

#. Character:`sayuri` | Attributes:`moved,blush`
msgctxt "t85e9155b43"
msgid "Je pleure parce que je suis heureuse."
msgstr "Đấy là những giọt nước mắt hạnh phúc, con ạ."

#. Character:`sayuri`
msgctxt "tac8b1235fc"
msgid "{{yasuka.n}} ne mentait pas quand elle m'a dit que tu prendrais vraiment soin de moi."
msgstr "{{yasuka.n}} không đùa khi nói rằng ở với con làm tâm hồn cô thanh thản."

#. Character:`saito` | Attributes:`happy`
msgctxt "t4e40fc0d1c"
msgid "Je vois... Toute cette histoire de demande... Tout ça était prémédité."
msgstr "À~ Con hiều rồi... Vậy là hai mẹ đã bàn tính với nhau trước."

#. Character:`sayuri` | Attributes:`sad`
msgctxt "t45935cf2c6"
msgid "Je suis désolée... Mais c'était si bien aujourd'hui... Ça m'a donné l'impression d'être un vrai couple..."
msgstr "Cô xin lũi~... Nhưng mà hôm nay hai ta hợp nhau tới nỗi... Cảm giác con với cô như một cặp đôi vậy..."

#. Character:`saito`
msgctxt "t61c8e1de17"
msgid "Je vois... [w]Tu veux que je t'emmène ailleurs demain ?"
msgstr "Dạ hiểu... [w]Ngày mai cô có muốn đi tiếp với con không ạ ?"

#. Character:`sayuri`
msgctxt "t017cd38661"
msgid "Je... Je ne veux pas abuser de ta gentillesse."
msgstr "Cô... Cô không có muốn con phải khổ vì cô..."

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t74fdc3042d"
msgid "Mais..."
msgstr "Nhưng..."

#. Character:`saito`
msgctxt "t79af52f363"
msgid "Mais tu en as très envie..."
msgstr "Nhưng mà... nếu cô thực sự muốn thì..."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "t3e44ba72da"
msgid "Oui !!! [w] J'adorerais passer à nouveau une journée avec toi."
msgstr "Có chứ !!!! [w] Được đi chơi với con là số dzách."

#. Character:`sayuri`
msgctxt "t01796a9cf9"
msgid "Peu importe où nous irons !"
msgstr "Dù ta đi đâu cũng vui hết !"

#. Character:`saito`
msgctxt "t10e5d48bf0"
msgid "Eh bien je crois qu'on n'a plus qu'à se retrouver demain, même heure, même endroit !"
msgstr "Vậy thì, con mong được gặp lại cô ngày mai. Cùng giờ, cùng chỗ ạ !"

#. Character:`sayuri` | Attributes:`moved,blush`
msgctxt "t0377d548d3"
msgid "Tu es un véritable amour, j'ai déjà hâte d'y être !"
msgstr "Con đáng yêu quá đi ! Ừ, mai gặp lại nhé !"

#. Character:`sayuri`
msgctxt "tb4d7cbe996"
msgid "Passe une bonne nuit {{saito.n}} !"
msgstr "Chúc con ngủ ngon nhé, {{saito.n}} !"

#. Character:`saito`
msgctxt "t5ed06488b7"
msgid "Toi aussi {{sayuri.n}}."
msgstr "Chúc cô {{sayuri.n}} ngủ ngon nữa ạ."

#. Character:`saito` | Attributes:`happy`
msgctxt "te6a7d650ce"
msgid "Prête à passer un super moment ?"
msgstr "Cô đã chuẩn bị cho một ngày tuyệt vời nữa chưa ạ ?"

#. Character:`sayuri` | Attributes:`happy`
msgctxt "t579ba394a6"
msgid "Oh que oui !"
msgstr "Hẳn rồi chứ !"

#. Character:`sayuri`
msgctxt "EST_CE_QUE_JE_VAIS_ENCORE_FINI_5C4EEB"
msgid "Est-ce que je vais encore finir toute nue ?"
msgstr ""

#. Character:`sayuri`
msgctxt "OH_TU_SAVAIS_QUE_R_PONDRE_UNE_56D269"
msgid "Oh... Tu savais que répondre à une question par une autre question en disait beaucoup sur la personne ?"
msgstr ""

#. Character:`sayuri`
msgctxt "TU_AIMERAIS_EN_SAVOIR_PLUS_REP_9538E2"
msgid "Tu aimerais en savoir plus..? Reprendre le contrôle de la conversation ?"
msgstr ""

#. Character:`sayuri`
msgctxt "AIMERAIS_TU_QUE_JE_ME_D_SHABIL_2DF525"
msgid "Aimerais-tu que je me déshabille devant toi là maintenant tout de suite ?"
msgstr ""

#. Character:`sayuri`
msgctxt "HAHAHA_TU_ES_ADORABLE_ALLEZ_DI_2BCF1E"
msgid "Hahaha ! Tu es adorable... Allez, dis-moi !"
msgstr ""

#. Character:`narrator`
msgctxt "TU_AIMERAIS_QUE_JE_TE_DISE_OU_D312E0"
msgid "Tu aimerais que je te dise oui ?"
msgstr ""

#. Character:`sayuri`
msgctxt "OH_POURQUOI_66264B"
msgid "Oh..! Pourquoi ?"
msgstr ""

#. Character:`narrator`
msgctxt "TU_FINIRAIS_S_REMENT_EN_PRISO_7C5036"
msgid "Tu finirais sûrement en prison !"
msgstr ""

#. Character:`sayuri`
msgctxt "tcad1560e71"
msgid "Où comptes-tu m'emmener cette fois-ci ?"
msgstr "Hôm nay con tính dẫn cô đi đâu đây ?"

#. Character:`saito`
msgctxt "tc78d0e8540"
msgid "Et bien...[w]Que dirais-tu d'aller te promener en ville et faire un peu de shopping ?"
msgstr "Dạ... [w]Liệu cô có muốn một buổi đi dạo, với shopping quanh thành phố không ạ ?"

#. Character:`sayuri` | Attributes:`moved,blush`
msgctxt "t4bc41917c2"
msgid "J'adorerais ça !"
msgstr "Uiii~ Mình mau đi thui con !"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t46572f6db7"
msgid "C'est vrai, tu ne dis pas ça seulement pour me faire plaisir ?"
msgstr "Được luôn ạ ? Nhưng mà nó không có hoành tá tràng như ngày hôm qua ?"

#. Character:`sayuri`
msgctxt "t665670f7b8"
msgid "Pas du tout ! Ça fait une éternité que je ne me suis pas baladée en ville."
msgstr "Cần gì hoành tráng ! Mấy năm nay cô chưa đi shopping rồi."

#. Character:`saito` | Attributes:`happy`
msgctxt "t53274eb8b9"
msgid "Alors c'est parti !"
msgstr "Vậy thì, mình mau đi thôi !"

#. Character:`sayuri` | Attributes:`happy`
msgctxt "t589527c336"
msgid "Merci encore pour cette journée !"
msgstr "Cảm ơn con. Ngày hôm nay vẫn thật tuyệt vời !"

#. Character:`sayuri`
msgctxt "tf9251c74ef"
msgid "Tu veux entrer un moment pour boire quelque chose ?"
msgstr "Con có muốn vào trong làm tách trà không ?"

#. Character:`saito` | Attributes:`happy`
msgctxt "t89b4a8af8a"
msgid "Non ça ira, il est tard et je crois qu'elles vont finir par s'inquiéter."
msgstr "Dạ thôi ạ. Con phải về nhà thôi không là mọi người lại nhớ con mất."

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t423e5b034b"
msgid "Dommage..."
msgstr "Bùn quá đi à..."

#. Character:`saito`
msgctxt "t08a98c6078"
msgid "Tu as eu des nouvelles d'{{asami.n}} dernièrement ?"
msgstr "Cô đã có tin gì từ {{asami.n}} chưa ạ ?"

#. Character:`sayuri` | Attributes:`sad`
msgctxt "t7c9f5a509e"
msgid "Non, aucune, mais j'ai arrêtée de m'angoisser pour ça."
msgstr "Chưa có, nhưng mà kể ra cô cũng không lo lắm."

#. Character:`sayuri` | Attributes:`moved`
msgctxt "tfad0597300"
msgid "Je me suis tellement amusée ces deux derniers jours que j'ai l'impression de retrouver ma jeunesse."
msgstr "Mấy ngày hôm nay, cô như tìm thấy lại thanh xuân thời thiếu nữ  vậy."

#. Character:`sayuri` | Attributes:`sad`
msgctxt "t603d7c446c"
msgid "Encore toutes mes excuses pour aujourd'hui..."
msgstr "Nhưng mà cho cô xin lỗi nhé..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "tac8eed65d4"
msgid "T'excuser ? Mais pourquoi ?"
msgstr "Dạ ? Tại sao phải xin lỗi ạ ?"

#. Character:`sayuri` | Attributes:`moved`
msgctxt "t7825e18a48"
msgid "Tu avais prévu tout un programme et, au final, je nous ai fait rester à la salle d'arcade toute la journée."
msgstr "Con có cả một chương trình đề ra hôm nay, vậy mà cô lại ham chơi quá."

#. Character:`saito` | Attributes:`happy`
msgctxt "t1311d51d74"
msgid "À la base, nos rendez-vous étaient pour que tu puisses t'amuser et..."
msgstr "Về cơ bản thì, mấy chuyến đi chơi là để cho cô vui và..."

#. Character:`sayuri` | Attributes:`moved`
msgctxt "t3fb6c5fda2"
msgid "Pas seulement..."
msgstr "Không chỉ có vậy..."

#. Character:`sayuri`
msgctxt "td70b41b44b"
msgid "C'était aussi pour avoir un semblant de rendez-vous amoureux..."
msgstr "Còn làm nền tảng cho một cuộc hẹn hò thực sự nữa..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "t023d16b441"
msgid "Oh..! Je vois..."
msgstr "Dạ ! Ý con là..."

#. Character:`sayuri`
msgctxt "t47835dbc20"
msgid "Nos deux premiers rendez-vous étaient formidables mais..."
msgstr "Hai bữa đi chơi trước của ta đều hoàn hảo, nhưng mà..."

#. Character:`saito` | Attributes:`guilty`
msgctxt "tf15e5d13dc"
msgid "Mais... ?"
msgstr "Thế nhưng... ?"

#. Character:`sayuri`
msgctxt "td19dcc69ed"
msgid "Je ne veux pas que ça s'arrête maintenant !"
msgstr "Cô không muốn chúng dừng lại nữa !"

#. Character:`sayuri`
msgctxt "JE_VEUX_UN_VRAI_RENDEZ_VOUS_AM_09759F"
msgid "Je veux un vrai rendez-vous amoureux !"
msgstr ""

#. Character:`sayuri` | Attributes:`moved`
msgctxt "OUI_JE_VEUX_RESSENTIR_CES_MOTI_61DDC8"
msgid "Oui... Je veux... ressentir ces émotions de nouveau."
msgstr ""

#. Character:`sayuri`
msgctxt "SE_SENTIR_D_SIR_E_LA_DOUCEUR_D_E19984"
msgid "Se sentir désirée... la douceur d'une caresse..."
msgstr ""

#. Character:`sayuri`
msgctxt "UN_BAISER_FUGACE_LE_C_UR_QUI_P_18704D"
msgid "Un baiser fugace... le cœur qui palpite en croisant son regard."
msgstr ""

#. Character:`sayuri`
msgctxt "SENTIR_LA_CHALEUR_DE_L_AUTRE_C_BA8DF8"
msgid "Sentir la chaleur de l'autre contre sa peau..."
msgstr ""

#. Character:`sayuri` | Attributes:`sad`
msgctxt "JE_TE_METS_MAL_L_AISE_95F202"
msgid "Je te mets mal à l'aise ?"
msgstr ""

#. Character:`saito`
msgctxt "NON_AU_CONTRAIRE_TU_ES_HONN_TE_2908C5"
msgid "Non au contraire, tu es honnête sur tes sentiments, d'une certaine manière c'est rassurant."
msgstr ""

#. Character:`sayuri` | Attributes:`moved`
msgctxt "MERCI_SAITO_N_7720D7"
msgid "Merci {{saito.n}} !"
msgstr ""

#. Character:`narrator`
msgctxt "ET_TOUT_CE_QUE_A_IMPLIQUE_F87BE7"
msgid "Et tout ce que ça implique...?"
msgstr ""

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "W_OUI_IDIOT_7B3F97"
msgid "...[w] Oui, idiot !"
msgstr ""

#. Character:`sayuri`
msgctxt "MAIS_AU_MOINS_DONNE_MOI_UNE_BE_8A89AE"
msgid "Mais au moins donne-moi une belle illusion !"
msgstr ""

#. Character:`saito` | Attributes:`happy`
msgctxt "JE_PENSE_QUE_JE_PEUX_FAIRE_A_BA1553"
msgid "Je pense que je peux faire ça."
msgstr ""

#. Character:`saito`
msgctxt "DANS_CE_CAS_O_AIMERAIS_TU_FAIR_6C4D8A"
msgid "Dans ce cas, où aimerais-tu faire ce rendez-vous amoureux ?"
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
msgctxt "LE_PARC_D_ATTRACTIONS_65C1EE"
msgid "Le parc d’attractions !"
msgstr ""

#. Character:`narrator`
msgctxt "RASSURE_MOI_ON_FAIT_TOUJOURS_57A2EE"
msgid "Rassure-moi, on fait toujours semblant ?"
msgstr ""

#. Character:`saito`
msgctxt "t8b076d9a3a"
msgid "Je vois...Et bien dans ce cas, ce sera avec plaisir !"
msgstr "Dạ hiểu... Nếu vậy thì, con rất hân hạnh được đi cùng ạ !"

#. Character:`narrator`
msgctxt "tb044acaac2"
msgid "Si on se tient a ça, tout devrait bien se passer."
msgstr "Miễn là mọi sự chỉ xoay quanh mấy cái \"nhẹ đô\" đấy."

#. Character:`sayuri`
msgctxt "tc5a1a80adf"
msgid "Alors à demain... [w]Mon chéri..."
msgstr "Thế vậy là ngày mai nhé... [w]Anh yêu~"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t16b3c63cb1"
msgid "Je... Oui... à demain."
msgstr "Con... Dạ... Vâng... Ngày mai ạ."

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "te6e8f0c208"
msgid "J'avais peur que tu ne changes d'avis !"
msgstr "Cô cứ sợ con chạy mất dép !"

#. Character:`saito` | Attributes:`happy`
msgctxt "t93bd4814b1"
msgid "Bien sûr que non, une promesse est une promesse !"
msgstr "Chắc chắn không ạ, nhất ngôn cửu đỉnh !"

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "td41383e232"
msgid "Donc on est d'accord ?"
msgstr "Thế vậy nghĩa là mình làm thật ha ?"

#. Character:`saito`
msgctxt "t4078587e6e"
msgid "À quel propos ?"
msgstr "Thật... cái gì ạ ?"

#. Character:`sayuri`
msgctxt "tc288f75324"
msgid "Tu vas m'obliger à le dire..."
msgstr "Đôi lúc con cứ ngố tàu cách chi á..."

#. Character:`sayuri` | Attributes:`moved`
msgctxt "t19ea104623"
msgid "Nous sommes un couple pour aujourd'hui !"
msgstr "Hai đứa tụi mình là một cặp hôm nay, mồ !"

#. Character:`saito` | Attributes:`guilty`
msgctxt "td06f80ad92"
msgid "C'est à cause du parc c'est ça ?"
msgstr "Là vì vụ đi Hội Hè, đúng không ạ ?"

#. Character:`sayuri`
msgctxt "t1b680c3413"
msgid "Oui mais... pas seulement."
msgstr "Thì đúng.... nhưng mờ."

#. Character:`sayuri`
