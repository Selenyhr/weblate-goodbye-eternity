msgctxt "konbini_exterior_007f7612"
msgid "[font_size=14]{{saito.n}} dépêche toi, on t'attend ![/font_size]"
msgstr "[font_size=14]{{saito.n}} ơi, nhanh lên, không tui bỏ ông lại đóa ![/font_size]"

