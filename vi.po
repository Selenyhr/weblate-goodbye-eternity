msgstr "Con đang co giật thật dữ dội trong mẹ, con yêu."

#. Character:`yasuka`
msgctxt "sleeping_with_yasuka_2_d26dca79"
msgid "Plus vite mon chéri, plus vite !"
msgstr "Hahnn, nữa, nhanh nữa, nữa!"

#. Character:`yasuka`
msgctxt "sleeping_with_yasuka_2_0be12655"
msgid "Je... Ça vient !"
msgstr "Con... Con... ra... đây!"

#. Character:`yasuka`
msgctxt "sleeping_with_yasuka_2_78a5207a"
