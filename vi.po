msgctxt "ATTENDS_UNE_MINUTE_B95A79"
msgid "Attends une minute..."
msgstr ""

#. Character:`saito`
msgctxt "ON_TE_L_A_DONN_ET_TU_VOULAIS_Q_94F215"
