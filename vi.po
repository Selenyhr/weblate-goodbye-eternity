msgctxt "bar_exterior_66bcf576"
msgid "C'était... Laisse tomber, elle ne fait que ce qu'elle veux."
msgstr "Đấy là... Mà thôi kệ đi, bả lẵng khách tự do tự tại thích làm gì tùy ý ấy mà."

#. Character:`saito`
msgctxt "bar_exterior_a7d03fb7"
