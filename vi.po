msgstr "Tôi vừa đang nghĩ tới ông."

#. Character:`asami`
msgctxt "menu_asami_room_waiting_f261baf5"
msgid "Tu as envie de quelque chose ?"
msgstr "Ông có cần gì không ?"

#. Character:`narrator`
