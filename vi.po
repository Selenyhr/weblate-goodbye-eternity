msgid "La mère de votre [color=yellow]petite amie[/color] semble déprimée suite à l'absence de sa fille. Peut-être pourriez-vous la réconforter ?"
msgstr "[color=yellow]Mẹ vợ tương lai của bạn [/color] có vẻ buồn rầu vì cô con gái bỏ đi chơi mấy hôm. Hãy \"dộng\" viên cho cô ấy vui lên nhé ?"

msgid "La mère de votre [color=yellow]meilleure amie[/color] semble déprimée suite à l'absence de sa fille. Peut-être pourriez-vous la réconforter ?"
msgstr "[color=yellow]Mẹ của FWB của bạn [/color] có vẻ buồn rầu vì cô con gái bỏ đi chơi mấy hôm. Hãy \"dộng\" viên cho cô ấy vui lên nhé ?"

msgid "Remontons-lui le moral"
msgstr "\"Dộng\" tới bến luôn !"

