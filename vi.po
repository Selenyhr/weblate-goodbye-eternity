msgctxt "ET_VOIL_UNE_BONNE_CHOSE_DE_FAI_AA5CCC"
msgid "Et voilà une bonne chose de faite !"
msgstr ""

#. Character:`sakuya`
msgctxt "IL_NE_RESTE_PLUS_QU_A_SE_D_BAR_2DF165"
msgid "Il ne reste plus qu'à se débarrasser du cadavre maintenant."
msgstr ""

#. Character:`sakuya`
msgctxt "onsen_room_25fa840b"
msgid "Voilà la chambre... Toute aussi charmante."
msgstr "Phòng ngủ đây rồi... ấm cúng làm sao."

#. Character:`sakuya`
msgctxt "onsen_room_fbda6f08"
msgid "Ça n'a pas changé depuis que je suis venue ici la dernière fois."
msgstr "Nó vẫn giữ nguyên như lần trước mình tới đây..."

#. Character:`sakuya`
msgctxt "onsen_room_1780852e"
msgid "Les futons sont vraiment confortables !"
msgstr "Các tấm futon bồng bềnh và êm ái lắm đó !"

#. Character:`saito` | Attributes:`happy`
msgctxt "onsen_room_bbd551e1"
msgid "Je suppose... Je n'ai jamais dormi sur un futon."
msgstr "Tớ... chưa từng ngủ trên futon thì phải."

#. Character:`sakuya`
msgctxt "onsen_room_ed881c09"
msgid "Il y a une première fois à tout."
msgstr "Sẽ có rất là nhiều trải nghiệm \"đầu tiên\" đó."

#. Character:`sakuya` | Attributes:`blush,pouting`
msgctxt "onsen_room_f3cbd05f"
msgid "En parlant de première fois..."
msgstr "Nói đến đầu tiên thì..."

#. Character:`sakuya`
msgctxt "onsen_room_dd0910a9"
msgid "Je me suis réservée pour toi rien que pour ce moment."
msgstr "Tớ đã hết mình thủ tiết, chỉ để chờ giây phút này."

#. Character:`sakuya`
msgctxt "onsen_room_f6995570"
msgid "Je suis toujours... vierge."
msgstr "Tớ vẫn... còn trinh nguyên."

#. Character:`saito` | Attributes:`surprised`
msgctxt "onsen_room_4dd2126b"
msgid "Une seconde... tu veux dire que tu n'as jamais... ?"
msgstr "Chốt tồ mát tề... Ý cậu là cậu chưa từng... ?"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "onsen_room_921d7ebc"
msgid "Jamais ! Tu devais être le premier et le seul."
msgstr "Chưa bao giờ ! Cậu là lần đầu và là người duy nhất."

#. Character:`sakuya`
msgctxt "onsen_room_50b9525a"
msgid "Ce soir... Nous n'allons faire plus qu'un !"
msgstr "Tôi nay... Chúng ta sẽ hòa làm một !"

#. Character:`sakuya`
msgctxt "onsen_room_e44c4b1b"
msgid "Tu veux bien... ?"
msgstr "Cậu có muốn không... ?"

#. Character:`sakuya`
msgctxt "onsen_room_75436ec5"
msgid "Mhhh mhhh..."
msgstr "Mhhh mhhh..."

#. Character:`sakuya`
msgctxt "onsen_room_863fc2dd"
msgid "Je vais m'occuper de toi comme jamais !"
msgstr "Tớ sẽ săn sóc cậu hơn cả mẹ cậu nữa kia !"

#. Character:`sakuya`
msgctxt "onsen_room_2d3345c4"
msgid "Laisse-toi faire, je m'occupe de tout !"
msgstr "Cứ để tớ lo, cậu chỉ cần tận hưởng thôi !"

#. Character:`sakuya`
msgctxt "onsen_room_2627aa08"
msgid "Oh mon Dieu, c'est incroyable !"
msgstr "Hyahh ! Tuyệ- Tuyệt quá đi !"

#. Character:`sakuya`
msgctxt "onsen_room_87eaba7d"
msgid "C'est... complètement dingue !"
msgstr "Thật.. thật... Đầu tớ trở nên trống rỗng mất !"

#. Character:`sakuya`
msgctxt "onsen_room_2b8012bb"
msgid "Je sens quelque chose qui vient !!!"
msgstr "Tớ có thể cảm thấy... cái gì đó... đang tới !!!"

#. Character:`sakuya`
msgctxt "onsen_room_d55f0ce5"
msgid "Je n'ai pas fini ! J'attends ça depuis trop longtemps !"
msgstr "Chưa thể xong được ! Tớ đã chờ đợi điều này quá lâu rồi !"

#. Character:`sakuya`
msgctxt "onsen_room_bb27a3cd"
msgid "Cette nuit, on ne dort pas mon chéri !"
msgstr "Đêm nay chúng ta không ngủ anh yêu à !"

#. Character:`sakuya`
msgctxt "onsen_room_08762be1"
msgid "Oh mon Dieu, ça vient encore !"
msgstr "Hahh Hahh Hahh, nó lại... tới nữa này !"

#. Character:`narrator`
msgctxt "td82d317e93"
msgid "..."
msgstr "..."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "onsen_room_3996b61f"
msgid "Je vois... Tu peux refuser, je comprends, tout ça est encore nouveau pour toi."
msgstr "Tớ hiểu mà... Tất cả đều quá nhanh và quá mới với cậu."

#. Character:`sakuya`
msgctxt "onsen_room_1d6e9edb"
msgid "Je suis prête à aller à ton rythme mais..."
msgstr "Tớ sẵn sàng chờ đợi cậu thôi, nhưng mà..."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "onsen_room_23ca9ec5"
msgid "Ne me fais pas languir trop longtemps."
msgstr "Đừng cho tới leo cây đấy, nhé."

#. Character:`sakuya`
msgctxt "onsen_room_476f2d19"
msgid "Je risquerais de ne plus pouvoir me retenir."
msgstr "Không là tớ tới tự tung tự tác đó nghe."

#. Character:`narrator`
msgctxt "td86e268c52"
msgid "Non... Je n'ai pas envie."
msgstr "Thôi... tớ không có muốn."

#. Character:`narrator`
msgctxt "onsen_room_623583be"
msgid "Merde, quelle nuit... J'ai pas su lui dire non."
msgstr "Trời, thật là một đêm dài... Mình chẳng thể khước từ cô ấy."

#. Character:`narrator`
msgctxt "onsen_room_3997d439"
msgid "Et, en plus, j'ai vraiment pris mon pied."
msgstr "Và, mình còn cảm thấy rất vui."

#. Character:`narrator`
msgctxt "onsen_room_ae9b2e4f"
msgid "Elle était vraiment déchaînée..."
msgstr "Cô ấy đúng là quái vật thật..."

#. Character:`narrator`
msgctxt "onsen_room_5df78724"
msgid "J'ai pas réussi à dormir de la nuit..."
msgstr "Chẳng thể ngủ suốt đêm..."

#. Character:`narrator`
msgctxt "onsen_room_28281e8d"
msgid "Pourquoi fallait-il qu'elle dorme nue contre moi toute la nuit ?"
msgstr "Tại sao cô ấy phải cởi trần RỒI MỚI đi ngủ cạnh mình nhỉ !"

#. Character:`narrator`
msgctxt "onsen_room_dd5711ac"
msgid "À ce train-là je vais exploser."
msgstr "Mình tới điên lên mất thôi."

#. Character:`narrator`
msgctxt "onsen_room_370e970d"
msgid "Elle dort encore."
msgstr "Vẫn đang ngủ cơ à..."

#. Character:`narrator`
msgctxt "onsen_room_68f8b3f4"
msgid "Avec un peu de chance, je pourrais peut-être faire l'aller-retour chez {{kimochi.n}}."
msgstr "Nếu như mình may mắn thì mình có thể qua lại chỗ của {{kimochi.n}}."

#. Character:`narrator`
msgctxt "onsen_room_e231eb72"
msgid "J'espère pour moi qu'il a bien transmis les deux lettres..."
msgstr "Hy vọng là cậu ta chuyển cả hai bức thư..."

#. Character:`sakuya`
msgctxt "onsen_room_e32a8887"
msgid "[font_size=14]Mhhh...[/font_size]"
msgstr "[font_size=14]Mmmh...[/font_size]"

#. Character:`sakuya`
msgctxt "onsen_room_8eedac1a"
msgid "Déjà debout mon amour ?"
msgstr "Anh yêu đã dậy rồi sao ?"

#. Character:`sakuya`
msgctxt "onsen_room_153ae428"
msgid "J'ai passé une nuit merveilleuse, et toi ?"
msgstr "Tớ có một đêm thật tuyệt vời. Còn cậu thì sao?"

#. Character:`saito` | Attributes:`happy`
msgctxt "onsen_room_77e49a4e"
msgid "J'ai eu un peu de mal à trouver le sommeil..."
msgstr "Tớ có hơi khó ngủ chút..."

#. Character:`sakuya`
msgctxt "onsen_room_82ec330c"
msgid "Je connais quelqu'un qui devait être trop excité pour s'endormir !"
msgstr "Ai đó hứng quá nên khó ngủ ha !"

#. Character:`sakuya`
msgctxt "onsen_room_e5434625"
msgid "Tu aurais dû me le dire, je me serais occupée de \"ça\" pour toi, tu sais."
msgstr "Cậu chỉ cần nói với tớ thôi mà. Tớ đã bảo là tớ sẽ săn sóc cậu, không phải sao ?"

#. Character:`saito`
msgctxt "onsen_room_85bbd14e"
msgid "Oui mais... tu dormais si bien, je ne voulais pas te déranger."
msgstr "Ơmmm.... nhưng mà... cậu ngủ ngon quá, và tớ không muốn làm phiền cậu."

#. Character:`sakuya`
msgctxt "onsen_room_d4b4a228"
msgid "Oh, tu es adorable."
msgstr "Ỏ~ cậu đáng yêu quá à !"

#. Character:`saito`
msgctxt "onsen_room_3de49aab"
msgid "D'ailleurs... j'ai besoin d'aller en ville aujourd'hui, ça ne te dérange pas que je m'absente... quelques heures ?"
msgstr "Tiện thể thì... ờmmm... tớ cần tới thị trấn hôm nay. Cậu có phiền không khi tớ đi... chỉ vài giờ thôi ?"

#. Character:`sakuya` | Attributes:`-blush,pouting`
msgctxt "onsen_room_07429779"
msgid "Si tu dois aller en ville, je t'accompagne !"
msgstr "Nếu như cậu cần đi tới thị trấn, để tớ đi cùng cậu !"

#. Character:`sakuya`
msgctxt "onsen_room_e0895d68"
msgid "Maintenant, on ne se quitte plus !"
msgstr "Chúng ta sẽ không bao giờ rời xa nhau nữa !"

#. Character:`sakuya`
msgctxt "onsen_room_39830e51"
msgid "Tu voulais y faire quoi ?"
msgstr "Cậu định làm gì trong thị trấn thế ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "onsen_room_14a0f7d3"
msgid "... Je... rien de particulier, mais c'est pas grave, ça pourra attendre, ce n'est pas urgent."
msgstr "Tớ... Cũng chẳng có gì. Không sao đâu. Nó cũng không gấp lắm."

#. Character:`narrator`
msgctxt "onsen_room_d8b44ce4"
msgid "Je dois absolument laisser {{kimochi.n}} en dehors du radar de {{sakuya.n}}."
msgstr "Trong bất cứ trường hợp nào cũng không thể để {{sakuya.n}} chạm mặt với {{kimochi.n}}."

#. Character:`narrator`
msgctxt "onsen_room_12f0793c"
msgid "Elle n'a pas l'air de le connaître, et c'est une très bonne chose."
msgstr "Có vẻ như cô ấy không biết cậu ta, và đó là một điều đáng mừng."

#. Character:`narrator`
msgctxt "onsen_room_be4437f5"
msgid "Je dois serrer les dents et continuer à faire semblant..."
msgstr "Mình sẽ phải nghiến răng và chịu đựng thôi..."

#. Character:`narrator`
msgctxt "onsen_room_c9dee60b"
msgid "J'espère juste que je n'aurai pas à faire ça trop longtemps."
msgstr "Mình chỉ hy vọng rằng mình sẽ không phải làm điều này cả đời."

#. Character:`saito`
msgctxt "BORDEL_QU_EST_CE_QUE_JE_FAIS_L_AA0F75"
msgid "Bordel ! Qu'est-ce que je fais là ?!!"
msgstr ""

#. Character:`saito`
msgctxt "C_EST_QUOI_TOUT_CE_SANG_4A342F"
msgid "C'est quoi tout ce sang !!!"
msgstr ""

#. Character:`sakuya`
msgctxt "DOUCEMENT_MON_AMOUR_NE_T_NERVE_A9B698"
msgid "Doucement, mon amour, ne t'énerve pas, tout va bien à présent, tu es en sécurité."
msgstr ""

#. Character:`saito` | Attributes:`angry`
msgctxt "JE_NE_ME_CALMERAI_QUE_LORSQUE_DCD1BF"
msgid "Je ne me calmerai que lorsque tu me diras ce que tu as fait de {{yasuka.n}} et {{asami.n}}."
msgstr ""

#. Character:`sakuya` | Attributes:`neutral`
msgctxt "MALHEUREUSEMENT_JE_NE_CROIS_PA_F31F59"
msgid "Malheureusement, je ne crois pas que tu sois en mesure d'exiger quoi que ce soit à ce sujet."
msgstr ""

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "SI_TU_M_AVAIS_COUT_E_LES_CHOSE_CC7729"
msgid "Si tu m'avais écoutée, les choses auraient pu se passer différemment, mais tu en as décidé autrement."
msgstr ""

#. Character:`saito`
msgctxt "JE_SUIS_LIBRE_DE_FAIRE_CE_QU_I_4CE42F"
msgid "Je suis libre de faire ce qu'il me plaît, tu n'as pas à m'imposer quoi que ce soit !"
msgstr ""

#. Character:`saito`
msgctxt "ENCORE_MOINS_T_EN_PRENDRE_ELLE_A8A014"
msgid "Encore moins à t'en prendre à elles !"
msgstr ""

#. Character:`sakuya` | Attributes:`happy`
msgctxt "PEUT_TRE_MAIS_PAS_AVEC_MOI_78EAF7"
msgid "Peut-être mais... pas avec moi !"
msgstr ""

#. Character:`sakuya` | Attributes:`angry`
msgctxt "JE_REFUSE_CAT_GORIQUEMENT_QUE_918DB2"
msgid "Je refuse catégoriquement que tu entretiennes une relation avec une autre femme que moi."
msgstr ""

#. Character:`saito` | Attributes:`surprised`
msgctxt "TU_ES_COMPL_TEMENT_FOLLE_A0DAD3"
msgid "Tu es complètement folle !"
msgstr ""

#. Character:`sakuya` | Attributes:`happy`
msgctxt "OUI_JE_SUIS_FOLLE_DE_TOI_ET_GA_6566F5"
msgid "Oui, je suis folle de toi ! Et également prête à tuer si nécessaire..."
msgstr ""

#. Character:`saito`
msgctxt "TU_TU_N_AS_TOUT_DE_M_ME_PAS_B487DD"
msgid "Tu... Tu n'as tout de même pas..."
msgstr ""

#. Character:`sakuya`
msgctxt "OH_MON_AMOUR_NE_PRENDS_PAS_PEU_863075"
msgid "Oh... Mon amour, ne prends pas peur."
msgstr ""

#. Character:`sakuya`
msgctxt "JE_SAIS_TRE_UNE_FEMME_RAISONNA_12BF75"
msgid "Je sais être une femme raisonnable."
msgstr ""

#. Character:`sakuya`
msgctxt "ELLES_ONT_JUSTE_T_UN_PEU_W_GRA_5A4D06"
msgid "Elles ont juste été un peu...[w] égratignées.[w] Mais elles sont bien vivantes !"
msgstr ""

#. Character:`saito` | Attributes:`angry`
msgctxt "TU_TE_FOUS_DE_MOI_TU_ES_RECOUV_918E78"
msgid "Tu te fous de moi ?! Tu es recouverte de sang !"
msgstr ""

#. Character:`sakuya`
msgctxt "JE_PEUX_TE_PROMETTRE_QU_ELLES_4FC3E8"
msgid "Je peux te promettre qu'elles sont vivantes."
msgstr ""

#. Character:`saito` | Attributes:`upset`
msgctxt "W_QU_EST_CE_QUE_TU_ATTENDS_DE_B327C4"
msgid "...[w] Qu'est-ce que tu attends de moi ?"
msgstr ""

#. Character:`sakuya`
msgctxt "AH_J_ATTENDAIS_CE_MOMENT_AVEC_A07144"
msgid "Ah ! J'attendais ce moment avec impatience."
msgstr ""

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "TOUT_CE_QUI_M_IMPORTE_C_EST_TO_6945C7"
msgid "Tout ce qui m'importe, c'est toi, et toi seul."
msgstr ""

#. Character:`sakuya`
msgctxt "PARTIR_DU_MOMENT_O_TU_NE_TE_C_91CA96"
msgid "À partir du moment où tu ne te consacres qu'à moi, je suis prête à pardonner tout le reste."
msgstr ""

#. Character:`saito`
msgctxt "LIB_RE_LES_ET_JE_FERAI_TOUT_CE_CCC812"
msgid "Libère-les et je ferai tout ce que tu voudras !"
msgstr ""

#. Character:`sakuya` | Attributes:`sad`
msgctxt "MON_CH_RI_J_AIMERAIS_BEAUCOUP_A65C62"
msgid "Mon chéri, j'aimerais beaucoup, mais ça ne fonctionne pas comme ça..."
msgstr ""

#. Character:`sakuya`
msgctxt "ELLES_SONT_ACTUELLEMENT_ENFERM_402D3C"
msgid "Elles sont actuellement enfermées dans un endroit dont moi seule ai la connaissance."
msgstr ""

#. Character:`sakuya`
msgctxt "ET_S_IL_M_ARRIVE_QUOI_QUE_CE_S_68E915"
msgid "Et s'il m'arrive quoi que ce soit, personne ne les retrouvera jamais."
msgstr ""

#. Character:`saito` | Attributes:`angry`
msgctxt "A_SUFFIT_DIS_MOI_CE_QUE_TU_VE_855EFF"
msgid "Ça suffit ! Dis-moi ce que tu veux ! Arrête de me torturer !"
msgstr ""

#. Character:`saito`
msgctxt "QUE_DOIS_JE_FAIRE_POUR_QUE_TU_23B800"
msgid "Que dois-je faire pour que tu les libères ?"
msgstr ""

#. Character:`sakuya` | Attributes:`happy`
msgctxt "RIEN_DE_D_SAGR_ABLE_EN_FAIT_C_CFC65F"
msgid "Rien de désagréable, en fait, c'est tout le contraire."
msgstr ""

#. Character:`sakuya`
msgctxt "TU_TE_COMPORTERAS_COMME_LE_PET_37112A"
msgid "Tu te comporteras comme le petit ami parfait avec moi, tu seras doux, gentil, attentionné, aimant, et tu feras tout ton possible pour me faire tomber enceinte chaque jour."
msgstr ""

#. Character:`saito` | Attributes:`surprised`
msgctxt "W_C_EST_UNE_BLAGUE_C32397"
msgid "...[w] C'est une blague ?"
msgstr ""

#. Character:`sakuya`
msgctxt "PAS_DU_TOUT_SI_TU_N_OB_IS_PAS_008E22"
msgid "Pas du tout ! Si tu n'obéis pas ou si tu n'y mets pas de bonne volonté, elles resteront à jamais enfermées."
msgstr ""

#. Character:`sakuya`
msgctxt "ET_SI_TU_TENTES_QUOI_QUE_CE_SO_C8042F"
msgid "Et si tu tentes quoi que ce soit... j'en supprime une ! Sans savoir laquelle bien sur."
msgstr ""

#. Character:`saito` | Attributes:`angry`
msgctxt "CE_QUE_JE_RESSENS_POUR_TOI_NE_10EAA5"
msgid "... Ce que je ressens pour toi ne pourra jamais être l'amour sincère que tu cherches."
msgstr ""

#. Character:`saito`
msgctxt "TOUT_CE_QUE_TU_OBTIENDRAS_DE_M_30F7EE"
msgid "Tout ce que tu obtiendras de moi ne sera rien d'autre que de la haine."
msgstr ""

#. Character:`sakuya` | Attributes:`happy`
msgctxt "MON_AMOUR_A_ME_REND_HEUREUSE_Q_8FBEBF"
msgid "Mon amour... Ça me rend heureuse que tu dises ça, car la haine... est la preuve qu'il y a bien un lien entre nous."
msgstr ""

#. Character:`sakuya`
msgctxt "ET_PUIS_RAPPELLE_TOI_SI_TU_NE_2D653A"
msgid "Et puis rappelle-toi, si tu ne fais pas d'effort, je peux très bien commencer à les débiter petit morceau par petit morceau..."
msgstr ""

#. Character:`sakuya`
msgctxt "PAR_CONTRE_SI_TU_FAIS_TOUT_POU_BEA365"
msgid "Par contre, si tu fais tout pour me rendre heureuse, je te traiterai comme un roi."
msgstr ""

#. Character:`saito` | Attributes:`sad`
msgctxt "LE_ROI_D_UNE_PRISON_DOR_E_3B4C5F"
msgid "... le roi d'une prison dorée."
msgstr ""

#. Character:`sakuya`
msgctxt "QUELLE_EST_TA_D_CISION_961EE7"
msgid "Quelle est ta décision ?"
msgstr ""

#. Character:`saito`
msgctxt "COMME_SI_J_AVAIS_LE_CHOIX_734549"
msgid "Comme si j'avais le choix..."
msgstr ""

#. Character:`saito` | Attributes:`upset`
msgctxt "J_OB_IRAI_LA_SEULE_CONDITION_Q_9B0D62"
msgid "J'obéirai à la seule condition que tu ne leur fasse plus de mal !"
msgstr ""

#. Character:`sakuya`
msgctxt "ET_MAINTENANT_IL_EST_TEMPS_DE_D541FC"
msgid "Et maintenant... Il est temps de se mettre au travail mon amour."
msgstr ""

#. Character:`saito` | Attributes:`sad`
msgctxt "_3E6F5A"
msgid "..."
msgstr ""

#. Character:`sakuya`
msgctxt "onsen_interior_696fe43f"
msgid "Te voilà enfin !"
msgstr "Cậu đây rồi !"

#. Character:`saito`
msgctxt "onsen_interior_03775ec8"
msgid "..."
msgstr "..."

#. Character:`sakuya`
msgctxt "onsen_interior_c75ebd03"
msgid "Je nous ai réservé le bain et nous passerons la nuit ici."
msgstr "Tớ đã đặt chỗ suối nước nóng cho hai ta, và chúng ta sẽ dành đêm nay bên nhau."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "onsen_interior_7f85decb"
msgid "Les vestiaires sont malheureusement séparés, je ne pourrais pas t'accompagner."
msgstr "Đáng tiếc là, phòng thay đồ là riêng biệt, nên tớ không thể ở cùng cậu."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "onsen_interior_8001fdc9"
msgid "Mais, les bains sont mixtes, nous nous retrouverons de l'autre côté."
msgstr "Nhưng suối nước nóng là chung hai giới, vậy tớ sẽ chờ cậu ở phía bên kia."

#. Character:`sakuya`
msgctxt "onsen_interior_875af352"
msgid "À tout de suite !"
msgstr "Sớm gặp lại cậu nhé !"

#. Character:`sakuya`
msgctxt "onsen_interior_23b5f04a"
msgid "[font_size=14]Et ne me fait pas attendre mon chéri...[/font_size]"
msgstr "[font_size=14]Và đừng để em chờ lâu quá nhé, anh yêu...[/font_size]"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "J_AVAIS_TOUJOURS_VOULU_VENIR_I_12F193"
msgid "J'avais toujours voulu venir ici mais je n'en avais jamais eu l'occasion."
msgstr ""

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "JE_CROYAIS_QU_ILS_N_ACCEPTAIEN_699833"
msgid "Je croyais qu'ils n'acceptaient que certains clients ?"
msgstr ""

#. Character:`sakuya` | Attributes:`happy`
msgctxt "C_EST_BIEN_LE_CAS_9A9DB4"
msgid "C'est bien le cas !"
msgstr ""

#. Character:`sakuya`
msgctxt "CET_ENDROIT_APPARTIENT_MA_M_RE_A5D884"
msgid "Cet endroit appartient à ma mère et je dois le gérer pendant son absence."
msgstr ""

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "VRAIMENT_C_EST_INCROYABLE_AD635A"
msgid "Vraiment ?! C'est incroyable !"
msgstr ""

#. Character:`sakuya`
msgctxt "QUOI_QU_IL_EN_SOIT_CET_ENDROIT_7EF3FC"
msgid "Quoi qu'il en soit, cet endroit me prend énormément de temps à gérer et je n'ai pas assez de temps pour m'en occuper."
msgstr ""

#. Character:`yasuka`
msgctxt "TU_VEUX_DIRE_QUE_08AE61"
msgid "Tu veux dire que..."
msgstr ""

#. Character:`sakuya`
msgctxt "OUI_J_AIMERAIS_VOUS_EMBAUCHER_AFEA8B"
msgid "Oui ! J'aimerais vous embaucher pour travailler dans cet établissement."
msgstr ""

#. Character:`yasuka`
msgctxt "CE_CE_N_EST_PAS_UNE_PLAISANTER_45B9F8"
msgid "Ce... ce n'est pas une plaisanterie ?"
msgstr ""

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "ABSOLUMENT_PAS_POURQUOI_VOUS_A_3599DA"
msgid "Absolument pas. Pourquoi vous aurais-je amenée ici dans ce cas ?"
msgstr ""

#. Character:`sakuya` | Attributes:`happy`
msgctxt "TOUT_CE_QUE_VOUS_DEVEZ_SAVOIR_7E3B1C"
msgid "Tout ce que vous devez savoir et faire se trouve dans le cahier sous le comptoir, et la seule contrainte véritable que vous aurez sera de porter une tenue traditionnelle... Est-ce que cela vous convient ?"
msgstr ""

#. Character:`yasuka`
msgctxt "ABSOLUMENT_86B034"
msgid "Absolument !!"
msgstr ""

#. Character:`sakuya` | Attributes:`neutral`
msgctxt "IL_Y_A_AUSSI_AUTRE_CHOSE_NE_DI_087212"
msgid "Il y a aussi autre chose... Ne dites pas à {{saito.n}} que je vous ai donné ce travail... J'aimerais que ça reste confidentiel. Je lui en parlerai le moment venu."
msgstr ""

#. Character:`yasuka` | Attributes:`happy`
msgctxt "TR_S_BIEN_CE_N_EST_ABSOLUMENT_86FEB0"
msgid "Très bien, ce n'est absolument pas un problème. Quand puis-je commencer ?"
msgstr ""

#. Character:`yasuka`
msgctxt "OH_JE_NE_M_ATTENDAIS_PAS_CE_QU_91C73C"
msgid "Oh, je ne m'attendais pas à ce que tu viennes me voir jusqu'ici !"
msgstr ""

#. Character:`yasuka` | Attributes:`happy`
msgctxt "EST_CE_QUE_TOUT_VA_BIEN_5A6848"
msgid "Est-ce que tout va bien ?"
msgstr ""

#. Character:`sayuri` | Attributes:`surprised`
msgctxt "tde13454f3d"
msgid "Mais... mais... mais... Comment... tu..."
msgstr "Nhưng... nhưng... nhưng... Sao có thể..."

#. Character:`saito` | Attributes:`happy`
msgctxt "ted3ed7f371"
msgid "Un problème ?"
msgstr "Có vấn đề gì không cô ?"

#. Character:`sayuri` | Attributes:`neutral`
msgctxt "t9f8d207998"
msgid "Tu es qui exactement ?"
msgstr "Con... Là... Ai... Vậy ?"

#. Character:`sayuri`
msgctxt "t2a415fe48f"
msgid "Un riche héritier ? Le fils d'un boss d'un clan de Yakuza ?"
msgstr "Phải là quý tử độc nhất ! Dòng dõi Thiên Hoàng Minh Trị ? Hay con cháu trùm gia tộc Yakuza ?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "ta180c3289e"
msgid "Quoi ?  Non pas du tout !"
msgstr "Dạ ? Đâu có đâu !"

#. Character:`saito` | Attributes:`happy`
msgctxt "t79585c238f"
msgid "Quoi que..."
msgstr "Kể ra cũng không sai..."

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "taf39fc8576"
msgid "Oui ! Dis moi tout !"
msgstr "Đi ! Kể cô nghe đi mờ !"

#. Character:`saito`
msgctxt "t129de98aef"
msgid "Non, il parait que c'est bien de cultiver un peu de mystère."
msgstr "À dạ không, bổn thiếu gia thích ẩn mình cho đời bớt bộn bề."

#. Character:`sayuri`
msgctxt "tb8e5de2d2c"
msgid "Je vois... Monsieur veux montrer qu'il a de la ressource."
msgstr "Ái chà... ra dáng sâm panh thế phiệt đấy nhỉ ?!"

#. Character:`sayuri` | Attributes:`happy`
msgctxt "tb0ad96b69e"
msgid "Très bien, je suis honnêtement impressionnée !"
msgstr "Được, con rất xứng làm con rể nhà cô !"

#. Character:`saito`
msgctxt "t418a4dac25"
msgid "Allez, l'hôtesse va se demander pourquoi nous restons là dans l'entrée a discuter."
msgstr "Mau vào thôi cô, kẻo lễ tân chờ."

#. Character:`sayuri`
msgctxt "tbf49b95b1e"
msgid "Oui pardon !"
msgstr "Ukiii !"

#. Character:`sakuya` | Attributes:`happy`
msgctxt "ta6d11213a9"
msgid "Bienvenue, je m'appelle {{sakuya.n}} et je suis ravie de vous accueillir aujourd'hui."
msgstr "Kính chào hai vị khách quý, em tên  {{sakuya.n}} và hôm nay em sẽ là hầu cận thân tín của hai vị."

#. Character:`sayuri` | Attributes:`surprised`
msgctxt "te4180735da"
msgid "Et mais je te reconnais, tu es la jeune fille qui était venue chez moi et qui avait complimentée mon intérieur."
msgstr "A, cô biết con nè. Có phải con là cái bạn rất xinh đã tới thăm thú nhà cô phải không nhỉ ?"

#. Character:`sakuya`
msgctxt "t73798440f9"
msgid "En effet. [w] Est-ce votre première visite chez nous ?"
msgstr "Thưa vâng đúng ạ. [w] Đây là lần đầu cô tới đây đúng không ạ ?"

#. Character:`sayuri` | Attributes:`happy`
msgctxt "t7858d151c1"
msgid "Euh... Oui, c'est la première fois."
msgstr "Ờm... Ừm đúng,, đây là lần đầu (tới đây) của cô."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "td4413b702a"
msgid "Excellent ! Vous allez adorer l'expérience. Nous avons plusieurs bains, chacun avec une vue magnifique sur les montagnes. Je suppose que vous avez une réservation ?"
msgstr "Rất vui mừng được đón tiếp! Con đảm bảo cô sẽ có những giây phút viên mãn và thư thái nhất trong quãng thời gian nán lại nơi đây. Chúng con có vài suối khoáng nóng lộ thiên, hướng trông ra đại ngàn núi non trùng điệp, với rừng đào, rừng mận tô điểm, cùng cảnh tranh lấp ló ánh sương bạc,  chấm phá bằng nét dịu nhẹ của nắng mai. Hẳn là cô và anh đã đặt phòng rồi  đúng không ạ ?"

#. Character:`saito`
msgctxt "te14effbaf7"
msgid "Bien sur..."
msgstr "Hẳn rồi..."

#. Character:`sakuya`
msgctxt "t2be560ffe3"
msgid "Très bien, laissez moi vérifier... Oui, nous vous avons attribué le bain privé avec vue panoramique, c'est un excellent choix !"
msgstr "Dạ vâng, hai vị chờ em một lát... À dạ, thưa, quý khách đã để mắt tới một suối khoáng kín đáo, có tầm nhìn bao quát và thoáng đạt nhất địa điểm chúng em. Lựa chọn đầy tinh tế, thưa quý khách !"

#. Character:`sayuri` | Attributes:`pouting,blush`
msgctxt "t3f6e6dfc3a"
msgid "[font_size=14]Wow, un bain privé... Tu ne fais pas les choses à moitié, tu avais prévu de me séduire c'est ça ?[/font_size]"
msgstr "[font_size=14]Chà chà...  Thuê riêng suối khoáng cơ à. Hàng ngũ các thiếu gia đều chịu chơi phết nhỉ ? Con tính tấn phong cô làm phu nhân hay gì ?[/font_size]"

#. Character:`sakuya`
msgctxt "t520db085bd"
msgid "Nos bains privés sont parfaits pour ceux qui recherchent tranquillité et intimité. Vous pourrez profiter du calme tout en admirant la nature environnante. Je vais vous montrer le chemin."
msgstr "Suối khoáng kín của chúng em là lựa chọn hoàn hảo cho các cặp đôi chú trọng sự thanh tịnh và ưu tiên mối liên kết thiêng liêng  với thiên nhiên sông nước, tránh xa mọi bộn bề, xô bồ của thế giới hiện đại. Để em dẫn hai vị đi."

#. Character:`sayuri` | Attributes:`happy`
msgctxt "t64c8ded3b9"
msgid "Je suis au paradis !"
msgstr "Ôi chao, thiên đường đây sao ?!"

#. Character:`saito` | Attributes:`happy`
msgctxt "taa4d38e28b"
msgid "On se retrouve tout a l'heure."
msgstr "Cô cứ tới trước đi ạ."

#. Character:`saito`
msgctxt "t94e4e260d0"
msgid "..."
msgstr "..."

#. Character:`sakuya` | Attributes:`happy`
msgctxt "t9a577aabab"
msgid "Tu te souviens de ta promesse ?"
msgstr "Cậu yêu có nhớ lời hứa không đó ?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t7cdf61fa79"
msgid "Oui, je t'inviterais une journée complète pour un long rendez vous amoureux."
msgstr "Có, tớ sẽ dẫn cậu đi hẹn hò nguyên một ngày một buổi sau chuyến đi này."

#. Character:`sakuya` | Attributes:`happy,blush`
msgctxt "t31937da5c5"
msgid "Parfait !"
msgstr "Tuyệt !"

#. Character:`saito` | Attributes:`happy`
msgctxt "t20a4b1a622"
msgid "Merci encore de nous laisser le droit d'utiliser l'onsen."
msgstr "Cảm ơn vì đã giữ cho tụi tớ một phòng nhé."

#. Character:`sakuya` | Attributes:`pouting`
msgctxt "t61f545aba4"
msgid "Tu sais bien que je ferais n'importe quoi pour toi ! Néanmoins... ne fais pas n'importe quoi sous mes yeux non plus, je vous surveille !"
msgstr "Cậu biết là tớ sẵn sàng đi tới cùng trời cuối đất vì cậu mà ! Nhưng mà ấy... đừng có nghịch ngợm quá nhé ! Fufufu, tai mắt tớ ở khắp mọi nơi đó nha !"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t1be4f73f3e"
msgid "Il ne se passera rien ne t'inquiète pas !"
msgstr "Đừng lo, tớ hứa sẽ không có gì đâu mà !"

#. Character:`saito`
msgctxt "home_kimochi_interior_0fb4811d"
msgid "Il est tard, je ferais mieux de rentrer chez moi."
msgstr "Cũng muộn rồi. Nên về nhà thôi."

#. Character:`saito`
msgctxt "home_kimochi_interior_41e34ae2"
msgid "Il n'a pas l'air d'être là pour le moment."
msgstr "Có vẻ như thằng cha ấy không ở đây vào lúc này."

#. Character:`saito`
msgctxt "home_kimochi_interior_ef7b4f61"
msgid "Je me demande bien ce qu'il fait de ses journées..."
msgstr "Chả biết nó làm gì cả ngày..."

#. Character:`kimochi`
msgctxt "kimochi_password_e3ad1068"
msgid "Faut vraiment que tu corriges cette mauvaise manie de débarquer à l'improviste."
msgstr "Anh thật sự cần phải sửa cái bản tính xông vào nhà người ta như FBI tìm dấm âu đấy."

#. Character:`saito`
msgctxt "kimochi_password_d69315f6"
msgid "Je sais, je sais. Je ne sais pas pourquoi je fais ça."
msgstr "Tôi biết, tôi biết, tôi cũng không chắc tại sao tôi lại hay làm vậy."

#. Character:`kimochi`
msgctxt "kimochi_password_493e021f"
msgid "Tu voulais quelque chose ?"
msgstr "Anh có cần gì không?"

#. Character:`saito`
msgctxt "kimochi_password_1862861d"
msgid "Non, je passais seulement dire bonjour !"
msgstr "À không, tôi chỉ ghé qua để gửi một lời hỏi thăm!"

#. Character:`saito`
msgctxt "talk_kimochi_e951c0b4"
msgid "Hey, le stalker, tu es là ?"
msgstr "Này tên rình rập, anh có đó không ?"

#. Character:`saito`
msgctxt "talk_kimochi_890939a7"
msgid "Allez, je sais que tu es là, j'entends des bruits dans ton appartement."
msgstr "Không cần phải giả đò, tôi nghe thấy tiếng động trong phòng đó."

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_kimochi_68b2673b"
msgid "Ouvre-moi ou je dis à {{minato.n}} où tu habites !"
msgstr "Mở cửa mau trước khi tôi báo nơi anh sống cho {{minato.n}} !"

#. Character:`kimochi`
msgctxt "talk_kimochi_2868bdf3"
msgid "[font_size=14]Tu ne ferais pas ça quand même ?[/font_size]"
msgstr "[font_size=14]Anh sẽ không làm thế đâu, phải không ?[/font_size]"

#. Character:`saito`
msgctxt "talk_kimochi_4d82a4e6"
msgid "Ça dépend si tu ouvres la porte ou pas."
msgstr "Đó còn tùy thuộc vào việc anh có mở cánh cửa này không."

#. Character:`kimochi`
msgctxt "talk_kimochi_e8dc186b"
msgid "[font_size=14]C'est bon, tu as gagné, je sors.[/font_size]"
msgstr "[font_size=14]Được rồi, anh thắng. Tôi ra ngay đây.[/font_size]"

#. Character:`saito`
msgctxt "talk_kimochi_0ebca8a2"
msgid "Sinon, tu as un nom ? J'aimerais pouvoir t'appeler autrement que \"le stalker\" ou \"le pervers\"."
msgstr "Anh có một cái tên không? Tôi thiết nghĩ chẳng nên gọi anh là \"kẻ rình rập\" hay \"tên dâm tặc\"."

#. Character:`kimochi`
msgctxt "talk_kimochi_03927374"
msgid "{{kimochi.n}}."
msgstr "{{kimochi.n}}."

#. Character:`kimochi`
msgctxt "talk_kimochi_7cc65d9c"
msgid "{{kimochi.n}} Warui."
msgstr "{{kimochi.n}} Warui."

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_kimochi_3ea7f0e7"
msgid "Mais..."
msgstr "Nhưng..."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "talk_kimochi_b1a2f02d"
msgid "Oui, je sais, mes parents qui ne me désiraient pas ont eu l'idée de me donner ce nom."
msgstr "Phải, tôi biết. hai ông bà già nhà tôi không muốn tôi ra đời, nên họ đặt cho tôi cái tên ấy."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "talk_kimochi_4951233c"
msgid "Bref, on s'en bat les couilles, tu as trouvé une solution à notre problème ?"
msgstr "Mà thôi, ai quan tâm chứ. Anh đã nghĩ ra cao kiến gì cho vấn đề của chúng ta chưa?"

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_kimochi_141ef3dd"
msgid "Dis-moi plutôt de quoi tu soupçonnes {{minato.n}} ?"
msgstr "Sao anh không kể cho tôi nghe tại sao anh lại nghi ngờ {{minato.n}} nhỉ?"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "talk_kimochi_c401bf33"
msgid "Ça veut dire que tu me crois ?"
msgstr "Vậy có nghĩa là anh tin tôi ư?"

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_kimochi_6d132d89"
msgid "Oui... J'ai eu un aperçu de son vrai visage et ce que j'ai vu ne m'a pas plus."
msgstr "Phải... Tôi có nhìn thấy được chút mặt tối của cậu ta, và thực sự tôi không thích những gì tôi đã nhìn thấy."

#. Character:`kimochi`
msgctxt "talk_kimochi_c9e3694d"
msgid "Dis-moi tout !"
msgstr "Kể tôi hết đi!"

#. Character:`saito`
msgctxt "talk_kimochi_7274a40f"
msgid "Il m'a juste avoué avoir fait semblant de se faire passer pour mon meilleur ami pour être aux premières loges lorsque je me faisais harceler."
msgstr "Cậu ta vừa nói toẹt chỉ giả vờ trở thành bạn thân của tôi, để cậu ta thưởng thức mỗi khi tôi bị hành hung hay rơi vào đánh lộn."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "talk_kimochi_e0fea42f"
msgid "Et après, on dit que c'est moi le pervers..."
msgstr "Và mọi người gọi tôi là thằng dâm tặc..."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_kimochi_8d6e304d"
msgid "J'ai eu l'impression de parler à un véritable psychopathe."
msgstr "Tôi có linh cảm rằng cậu ta thực sự là một tên tâm thần."

#. Character:`saito`
msgctxt "talk_kimochi_4b4ac996"
msgid "J'en ai eu des frissons."
msgstr "Điều đó khiến tôi lạnh cả sống lưng."

#. Character:`kimochi` | Attributes:`think`
msgctxt "talk_kimochi_7c41b277"
msgid "C'est une réaction normale."
msgstr "Tôi nghĩ đó là một phản ứng bình thưởng."

#. Character:`kimochi`
msgctxt "talk_kimochi_66c07b2a"
msgid "Notre cerveau, qui est une merveille d'ingénierie biologique, nous avertit d'un danger imminent ou de quelque chose qui pourrait menacer notre vie."
msgstr "Bộ não của chúng ta, là một phép màu diệu kỳ của sự sống, tiên liệu cho chúng ta nhũng mối nguy hiểm cận kề có thể đe dọa mạng sống."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "talk_kimochi_74a27bb6"
msgid "J'ai ce sentiment-là depuis que j'ai croisé son regard la première fois, c'était il y a quelques années."
msgstr "Tôi đã có cái linh cảm ấy kể từ cái ngày đầu tiên tôi gặp hắn, từ vài năm trước."

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_kimochi_e027a8b4"
msgid "Que crois-tu qu'il fasse subir à sa petite sœur ?"
msgstr "Anh nghĩ cậu ta đã làm gì với em gái mình?"

#. Character:`kimochi` | Attributes:`sad`
msgctxt "talk_kimochi_14d773c1"
msgid "...Es-tu sûr de vouloir l'entendre ?"
msgstr "...Và cậu thật sự muốn nghe câu trả lời của tôi chứ?"

#. Character:`saito`
msgctxt "talk_kimochi_d50c87f5"
msgid "Je dois savoir."
msgstr "... Tôi muốn được biết."

#. Character:`kimochi`
msgctxt "talk_kimochi_c9df85d4"
msgid "Je ne sais pas grand-chose, car je n'ai jamais pu m'approcher assez."
msgstr "Tôi thực sự không biết nhiều, bởi tôi không thể tiếp cận đủ gần để thu thập thông tin."

#. Character:`kimochi`
msgctxt "talk_kimochi_00977ff0"
msgid "Mais tous les weekends, le sous-sol de leur maison est allumé et il y a une grosse berline garée juste à côté."
msgstr "Nhưng vào mỗi cuối tuần, ánh đèn của tầng hầm nơi đó luôn sáng, và một chiếc sedan luôn tới và đỗ ngay ở trước của."

#. Character:`kimochi`
msgctxt "talk_kimochi_bbb32214"
msgid "J'ai fait des recherches afin de savoir à qui appartient la plaque et il s'avère qu'il s'agit de la voiture d'un clan de yakuza local."
msgstr "Tôi có đào bới chút nhằm tìm ra chủ nhân của chiếc xe đó. Nó thuộc về một băng đảng Yakuza địa phương."

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_kimochi_b1d1f111"
msgid "Putain, c'est quoi le nom du clan ?"
msgstr "Cái địt, tên băng đảng đó là gì vậy?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "talk_kimochi_1607a7f3"
msgid "Lune sanglante."
msgstr "Hội Huyết Nguyệt."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_kimochi_ed9864f8"
msgid "Merde."
msgstr "Địt."

#. Character:`narrator`
msgctxt "talk_kimochi_a5418e10"
msgid "Je ne pensais pas entendre ce nom aussi vite."
msgstr "Mình không nghĩ rằng mình phải nghe cái tên ấy sớm đến vậy!"

#. Character:`narrator`
msgctxt "talk_kimochi_28248520"
msgid "Si {{minato.n}} est en lien avec ce clan, alors {{chiaki.n}} et {{natsume.n}} sont en danger de mort."
msgstr "Nếu như {{minato.n}} có liên kết với băng ấy, tính mạng của {{chiaki.n}} và {{natsume.n}} đang bị đe dọa!"

#. Character:`narrator`
msgctxt "talk_kimochi_0321e5fc"
msgid "On n'a jamais su comment tout avait commencé, mais à la base Lune sanglante était un clan mineur."
msgstr "Chẳng ai biết tự lúc nào, nhưng Hội Huyết Nguyệt ngày xưa trông chỉ như một băng hội tiểu tốt."

#. Character:`narrator`
msgctxt "talk_kimochi_c9c453ac"
msgid "Mais des années plus tard, quand la vérité a éclaté, il s'est avéré qu'ils avaient gangréné absolument toutes les institutions de l'État, ils étaient intouchables."
msgstr "Mại dâm cùng khai thác nội tạng, buôn bán ma túy và nô lệ,...Và ấy mới chỉ là nhũng gì được cánh nhà báo đào xới hết mức."

#. Character:`narrator`
msgctxt "talk_kimochi_6a82d9ed"
msgid "Prostitution, trafic d'organe, esclavage, drogue et ce n'était que le haut de l'iceberg."
msgstr "Công an cùng cảnh sát hoàn toàn bó tay trước làn sóng tệ nạn. Họ cũng bị điều khiển bởi Huyết Nguyệt."

#. Character:`narrator`
msgctxt "talk_kimochi_a409ae00"
msgid "La police ne faisait rien, elle était de toute façon contrôlée par le clan."
msgstr "Cảnh sát, công an bất lực hoàn toàn. Đều trở thành tay chân của tổ chức ấy."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_kimochi_5f2d6609"
msgid "{{kimochi.n}}, c'est la merde !"
msgstr "{{kimochi.n}}, điều này thật sự nguy hiểm đến nhường nào!"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "talk_kimochi_818da754"
msgid "Je sais que parler de yakuza ça impressionne, mais il s'agit d'un petit clan mineur."
msgstr "Tôi biết những câu chuyện về Yazuka có thể hơi u tối, nhưng đây chỉ là một băng đảng nhỏ."

#. Character:`kimochi`
msgctxt "talk_kimochi_f70b7761"
msgid "Pas de quoi fouetter un chat. Tu sais de nos jours à part faire des bubble tea, les yakusas ne font plus grand-chose."
msgstr "Yakuza bây giờ chẳng làm gì mấy ngoài bán trà sữa cả, cậu biết đấy."

#. Character:`saito`
msgctxt "talk_kimochi_05b2aed3"
msgid "Fais-moi confiance là-dessus, ceux-là sont extrêmement dangereux."
msgstr "Hãy tin tôi như tôi tin cậu, thế lực này vô cùng nguy hiểm."

#. Character:`saito`
msgctxt "talk_kimochi_0348b611"
msgid "À tout hasard, as-tu déjà contacté la police ou les services sociaux ?"
msgstr "Có bằng chút cơ may nào, cậu được tiếp cận bởi công an, hay tổ chức xã hội không?"

#. Character:`kimochi`
msgctxt "talk_kimochi_999ccea8"
msgid "Oui..."
msgstr "Được…"

#. Character:`saito`
msgctxt "talk_kimochi_4280a9bf"
msgid "Laisse-moi deviner, ils ont voulu te mettre en garde à vue pour en savoir plus sur toi ?"
msgstr "Để tôi đoán, họ muốn đặt anh dưới sự bảo vệ của họ, nhằm \"tìm hiểu thêm về anh\", đúng không?"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "talk_kimochi_1e6a3fe5"
msgid "CO- Comment tu as su ?"
msgstr "SAO LẠ- Sao anh biết ?"

#. Character:`narrator`
msgctxt "talk_kimochi_7a694400"
msgid "Merde, ils sont déjà bien implantés dans la ville."
msgstr "Khốn nạn, vậy là chúng đã có tổ chức mạng lưới bài bản trong thị trấn."

#. Character:`saito` | Attributes:`sad`
msgctxt "talk_kimochi_b01c1755"
msgid "Il va falloir être prudent à présent... Dis-toi que nos vies sont menacées."
msgstr "Chúng ta cần phải thực sự cẩn thận, bây giờ đây...tính mạng của chúng ta đang gặp nguy hiểm."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "talk_kimochi_2e942a4e"
msgid "Quoi ? À ce point ? Tu as l'air d'en savoir plus que moi."
msgstr "Thật...Thật sao? Tôi nghĩ hẳn anh biết nhiều điều hơn tôi?"

#. Character:`saito`
msgctxt "talk_kimochi_97ba2862"
msgid "Je te garantis que je te dirai tout le moment venu, mais là, si on veut pouvoir sortir {{chiaki.n}} et {{natsume.n}} de ce merdier, il va nous falloir plus qu'un simple plan."
msgstr "Tôi hứa rằng tôi sẽ cho anh biết mọi chuyện vào thời khắc thích hợp, nhưng hiện giờ nếu muốn giải cứu {{chiaki.n}} và {{natsume.n}} khỏi nguy hiểm, chúng ta cần một kế hoạch tỉ mỉ hơn."

#. Character:`kimochi`
msgctxt "talk_kimochi_67ef1164"
msgid "{{natsume.n}} ? C'est qui ça ?"
msgstr "{{natsume.n}}? Ai vậy?"

#. Character:`saito`
msgctxt "talk_kimochi_fd1bfa4d"
msgid "La petite amie de {{minato.n}}."
msgstr "Bạn gái của {{minato.n}}."

#. Character:`kimochi` | Attributes:`think`
msgctxt "talk_kimochi_3111da4d"
msgid "Mais elle est de quel côté ? Elle est au courant de ce qui se passe ?"
msgstr "Anh nghĩ cô ấy đang ở phe nào? Liệu cô ấy có biết về những chuyện đang diễn ra không?"

#. Character:`saito`
msgctxt "talk_kimochi_7e3e0efb"
msgid "Je n'en sais rien, c'est ce que je vais essayer de découvrir."
msgstr "Tôi không biết, nhưng tôi sẽ cố gắng tìm hiểu."

#. Character:`kimochi`
msgctxt "talk_kimochi_26f65224"
msgid "On ne peut pas aller voir la police tous les deux ?"
msgstr "Nếu như chúng ta cùng đi tới đồn thì sao?"

#. Character:`saito`
msgctxt "talk_kimochi_766c6017"
msgid "La police n'interviendra pas, il y a des membres du clan dans la police."
msgstr "Công an sẽ không giúp chúng ta, có rất nhiều những con chim lợn trà trộn vào trong hàng ngũ của lực lượng hành pháp."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "talk_kimochi_6e750445"
msgid "Mais... Comment on va faire ?"
msgstr "Vậy...Chúng ta cần làm gì bây giờ?"

#. Character:`saito`
msgctxt "talk_kimochi_b44ca111"
msgid "Il va falloir se préparer comme jamais."
msgstr "Chúng ta cần phải chuẩn bị."

#. Character:`saito`
msgctxt "talk_kimochi_541a6a73"
msgid "Trouver des renforts prêts à mettre leur vie en jeu."
msgstr "Kết nối với những chiến hữu đồng lòng cùng ta vào sinh ra tử."

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_kimochi_722c8999"
msgid "Est-ce que tu es prêt pour ça ?"
msgstr "Anh...Ông..liệu đã sẵn sàng cho chuyện này chứ?"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "talk_kimochi_58596d72"
msgid "Si je tourne le dos à une petite fille en détresse, je ne serais plus digne d'être considéré comme un homme."
msgstr "Nếu như tôi làm ngơ một cô gái đang tuyệt vọng, tôi thật không xứng làm một thằng đàn ông !"

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_kimochi_16f5df63"
msgid "Bien parlé."
msgstr "Khảng khái đấy."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "talk_kimochi_f845be84"
msgid "Je vais continuer de chercher des informations de mon côté, je te tiens informé dès que j'en apprendrai plus."
msgstr "Tôi sẽ tiếp tục tìm kiếm thông tin, và ngay khi tôi biết thêm điều gì, tôi sẽ gọi cho anh."

#. Character:`saito` | Attributes:`neutral`
msgctxt "talk_kimochi_c9353cf6"
msgid "Ça marche !"
msgstr "Được thật này !"

#. Character:`narrator`
msgctxt "talk_kimochi_1f961e4c"
msgid "Bon, j'ai un allié de plus et un nouvel ennemi colossal qui vient d'apparaitre."
msgstr "Có vẻ như mình đã có cho mình một người bạn mới, và một kẻ thù không đội trời chung."

#. Character:`narrator`
msgctxt "talk_kimochi_b5cdc75f"
msgid "Et le fait de savoir que {{minato.n}} est lié à Lune sanglante..."
msgstr "Và biết được rằng {{minato.n}} có liên quan đến Huyết Nguyệt."

#. Character:`narrator`
msgctxt "talk_kimochi_14bde82e"
msgid "Est bien plus flippant que tout ce que j'aurais pu imaginer."
msgstr "...là cái điều hãi hùng nhất từ trước đến nay mà mình từng biết."

#. Character:`kimochi`
msgctxt "te6fccb3b09"
msgid "[next]"
msgstr "[next]"

#. Character:`kimochi`
msgctxt "kimochi_password_1ab316a6"
msgid "[font_size=14]Bien que je sois d'accord avec cette citation hautement philosophique.[/font_size]"
msgstr "[font_size=14]Mặc dù tôi đồng ý hoàn toàn với triết lý đó của ngài...[/font_size]"

#. Character:`kimochi`
msgctxt "kimochi_password_26b65d60"
msgid "[font_size=14]Ce n'est pas le bon mot de passe.[/font_size]"
msgstr "[font_size=14]Nhưng đó không phải mật khẩu đúng.[/font_size]"

#. Character:`narrator`
msgctxt "t8c6225f4d6"
msgid "Tout cul tendu mérite son dû?"
msgstr "Mông cong thì cần phải tét."

#. Character:`kimochi`
msgctxt "kimochi_password_2480574f"
msgid "[font_size=14]Je vois... Je suppose que monsieur à certaines références.[/font_size]"
msgstr "[font_size=14]Tôi hiểu... Tôi thấy rằng ngài đây có một số những.. chân lý đáng chú ý.[/font_size]"

#. Character:`kimochi`
msgctxt "kimochi_password_74d73eaf"
msgid "[font_size=14]Personnellement, je préfère les poitrines.[/font_size]"
msgstr "[font_size=14]Bản thân tôi thích đôi trái đào trước trái tim của người phụ nữ.[/font_size]"

#. Character:`kimochi`
msgctxt "kimochi_password_9c60f99d"
msgid "[font_size=14]Mais ce n'est toujours pas le bon mot de passe.[/font_size]"
msgstr "[font_size=14]Nhưng đó vẫn chưa phải là mật khẩu đúng.[/font_size]"

#. Character:`narrator`
msgctxt "t82d667e66e"
msgid "Une personne qui aime les culs ne peut jamais être mauvaise !"
msgstr "Vòng III đệ nhất !"

#. Character:`kimochi`
msgctxt "kimochi_password_556679e5"
msgid "[font_size=14]...[/font_size]"
msgstr "[font_size=14]...[/font_size]"

#. Character:`kimochi`
msgctxt "kimochi_password_ffffa994"
msgid "[font_size=14]C'est... C'est le bon mot de passe en effet.[/font_size]"
msgstr "[font_size=14]Đó...thật sự là một khẩu đúng.[/font_size]"

#. Character:`saito`
msgctxt "kimochi_password_d72815bc"
msgid "Non mais je rêve."
msgstr "Tôi không tin."

#. Character:`narrator`
msgctxt "t4fd2fb93bd"
msgid "Tu ne m'en as jamais donné idiot !"
msgstr "Anh có đưa tôi đâu, thằng đần !"

#. Character:`saito`
msgctxt "talk_kimochi_3deb77ed"
msgid "Hey {{kimochi.n}}, c'est moi !"
msgstr "Này {{kimochi.n}} là tôi đây !"

#. Character:`kimochi`
msgctxt "talk_kimochi_dfcf2f02"
msgid "[font_size=14]Qui ça \"moi\" ? \"Moi\" c'est trop vague. Je ne connais pas de \"moi\".[/font_size]"
msgstr "[font_size=14] \"Tôi\" nào ? \"Tôi\" là một từ quá đỗi mập mờ. Tôi chẳng biết ai mang tên \"tôi\" cả.[/font_size]"

#. Character:`saito` | Attributes:`upset`
msgctxt "talk_kimochi_5993c50d"
msgid "Bordel, c'est toi qui m'as dit de passer te voir à cette adresse précisément."
msgstr "Bà mẹ, ông chỉ là người đã hẹn gặp tôi tại địa chỉ này."

#. Character:`kimochi`
msgctxt "talk_kimochi_c1360f2c"
msgid "[font_size=14]Tu aurais très bien pu récupérer le papier sur le cadavre de {{saito.n}}.[/font_size]"
msgstr "[font_size=14]Cũng có thể anh đã chộp được tờ giấy từ xác của {{saito.n}}.[/font_size]"

#. Character:`kimochi`
msgctxt "talk_kimochi_e06824e1"
msgid "[font_size=14]C'est quoi le mot de passe ?[/font_size]"
msgstr "[font_size=14]Mật khẩu là gì?[/font_size]"

#. Character:`saito` | Attributes:`surprised`
msgctxt "talk_kimochi_41d8451f"
msgid "Le mot de..."
msgstr "Mật khẩu..."

#. Character:`kimochi`
msgctxt "talk_kimochi_49e02535"
msgid "[font_size=14]Parfaitement ! Je veux le mot de passe ![/font_size]"
msgstr "[font_size=14]Phải! Đưa tôi mật khẩu![/font_size]"

#. Character:`kimochi`
msgctxt "kimochi_password_917325bd"
msgid "Désolé pour tout ça, mais je dois être prudent."
msgstr "Xin lỗi, nhưng tôi phải cẩn thận."

#. Character:`saito`
msgctxt "kimochi_password_517a63e1"
msgid "À ce point ?"
msgstr "Đến mức này sao?"

#. Character:`saito`
msgctxt "kimochi_password_88d5d579"
msgid "Bon, admettons, qu'est-ce qui justifie tout ce que tu as fait jusqu'à présent ?"
msgstr "Mà phải khẳng định rằng, có cái gì giúp giải thích những hành động mà ông đã làm không ?"

#. Character:`saito`
msgctxt "kimochi_password_42dc8613"
msgid "Parce que mine de rien, à force de trainer devant chez {{minato.n}} dans l'espoir de kidnapper sa sœur."
msgstr "Thật sự mà nói thì. vật vờ quanh nhà của {{minato.n}}, tìm cách bắt cóc em gái cậu ta..."

#. Character:`saito`
msgctxt "kimochi_password_56ddb3cf"
msgid "Je te classe dans la catégorie des prédateurs sexuels."
msgstr "Tôi vẫn sẽ liệt ông vào danh sách tội phạm tình dục."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "kimochi_password_06d596b0"
msgid "...Je sais que d'un point de vue extérieur ça y ressemble."
msgstr "Tôi biết là khi nhìn bề ngoài thì mọi chuyện cảm giác đúng thật sự như vậy."

#. Character:`saito`
msgctxt "kimochi_password_bd6835d6"
msgid "Je t'écoute."
msgstr "Tôi đang nghe đây."

#. Character:`kimochi` | Attributes:`think`
msgctxt "kimochi_password_bfa263e0"
msgid "Tu n'as jamais senti un sentiment de malaise quand tu te retrouves avec {{minato.n}} ?"
msgstr "Liệu anh chưa bao giờ có một cảm giác bất an khi ở cạnh {{minato.n}} ư?"

#. Character:`kimochi`
msgctxt "kimochi_password_b1eaf5fa"
msgid "Tu es vraiment quelqu'un de trop insouciant."
msgstr "Anh bạn đang quá ngây ngô đấy."

#. Character:`narrator`
msgctxt "t24c4d0938f"
msgid "Y'a un effet, un truc qui me gêne."
msgstr "Chắc chắn là có điều gì đó đang làm mình cảm thấy băn khoăn"

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_15df7ecf"
msgid "Qu'est-ce qu'il a son regard ?"
msgstr "Cái liếc của anh ta làm sao cơ?"

#. Character:`kimochi`
msgctxt "kimochi_password_8aefff85"
msgid "Il me donne l'impression de n'être qu'une fourmi qu'il pourrait écraser à tout moment."
msgstr "Nó cho tôi một cảm giác sợ hãi đến cùng cực, cảm tưởng như tôi chẳng khác gì một con kiến nhỏ bé. Cảm tưởng như hắn ta có thể dẫm chết tôi."

#. Character:`kimochi`
msgctxt "kimochi_password_1101fa49"
msgid "Je pense qu'il s'agit d'un véritable psychopathe !"
msgstr "Tôi nghĩ hắn ta chắc chắn là một tên tâm thần !"

#. Character:`saito`
msgctxt "kimochi_password_43aa03b3"
msgid "...et tu penses qu'il ferait du mal à sa petite sœur ?"
msgstr "...Và anh nghĩ rằng anh ta đang tấn công em gái mình sao?"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "kimochi_password_7d4e6b4f"
msgid "Je ne le pense pas, j'en suis certain."
msgstr "Tôi không chỉ NGHĨ vậy. Tôi CHẮC CHẮN là vậy."

#. Character:`kimochi`
msgctxt "kimochi_password_35421bf7"
msgid "Mais il y a autre chose encore."
msgstr "Nhưng mà còn một điều nữa."

#. Character:`kimochi` | Attributes:`think`
msgctxt "kimochi_password_d59b6642"
msgid "J'ai remarqué que tous les weekends, le sous-sol de leur maison est allumé et il y a toujours une grosse berline garée à côté."
msgstr "Tôi nhớ rằng vào mỗi cuối tuần, đèn của tầng hầm nơi đó luôn sáng, và một chiếc sedan lớn luôn đậu ngay tại cửa."

#. Character:`kimochi`
msgctxt "kimochi_password_288ea2da"
msgid "...Une berline noire de luxe, j'ai regardé à qui appartenait la plaque et elle appartient à un clan de yakuza."
msgstr "...Một chiếc sedan rất sang trọng. Tôi đào bới và thấy nó được sử dụng bởi một băng đảng Yakuza địa phương."

#. Character:`saito`
msgctxt "kimochi_password_39303706"
msgid "Merde ! C'est quoi le nom du clan ?"
msgstr "Cái địt?! Tên của băng đảng đó là gì?"

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_91f448f7"
msgid "Merde, merde..."
msgstr "Chó chết chó chết..."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "kimochi_password_d624da84"
msgid "Tu les connais ?"
msgstr "Anh biết chúng ư?"

#. Character:`saito`
msgctxt "kimochi_password_a43205ed"
msgid "C'est la pire chose qui pouvait arriver !"
msgstr "Cảnh sát cơ động cũng phải hãi chúng nó !"

#. Character:`narrator`
msgctxt "kimochi_password_b143667e"
msgid "Merde, pourquoi eux... Pourquoi si vite ?"
msgstr "Tại sao lại là chúng...Tại sao lại sớm đến vậy ?"

#. Character:`narrator`
msgctxt "kimochi_password_1c6bf987"
msgid "Si {{minato.n}} est en lien avec ce clan, alors {{chiaki.n}} est en danger de mort."
msgstr "Nếu như {{minato.n}} có liên quan tới Hội Huyết Nguyệt, tính mạng của {{chiaki.n}} chắc chắn đang bị đe dọa."

#. Character:`narrator`
msgctxt "kimochi_password_0321e5fc"
msgid "On n'a jamais su comment tout avait commencé, mais à la base Lune sanglante était un clan mineur."
msgstr "Chẳng ai biết tự lúc nào, nhưng Hội Huyết Nguyệt ngày xưa trông chỉ như một băng hội tiểu tốt."

#. Character:`narrator`
msgctxt "kimochi_password_c9c453ac"
msgid "Mais des années plus tard, quand la vérité a éclaté, il s'est avéré qu'ils avaient gangréné absolument toutes les institutions de l'État, ils étaient intouchables."
msgstr "Cho đến khi sự thật được hé lộ, Huyết Nguyệt đã làm lũng đoạn tất cả các công chức và quan lại. Không ai có thể rờ đến chúng."

#. Character:`narrator`
msgctxt "kimochi_password_6a82d9ed"
msgid "Prostitution, trafic d'organe, esclavage, drogue et ce n'était que le haut de l'iceberg."
msgstr "Mại dâm cũng khai thác nội tạng, buôn bán ma túy và nô lệ,...Và ấy mới chỉ là nhũng gì được cánh nhà báo đào xới hết mức."

#. Character:`narrator`
msgctxt "kimochi_password_a409ae00"
msgid "La police ne faisait rien, elle était de toute façon contrôlée par le clan."
msgstr "Công an cùng cảnh sát hoàn toàn bó tay trước làn sóng tệ nạn. Họ cũng bị điều khiển bởi Huyết Nguyệt."

#. Character:`kimochi` | Attributes:`think`
msgctxt "kimochi_password_ae7d5b47"
msgid "Tu as l'air d'en savoir plus que moi sur eux."
msgstr "Xem chừng anh có vẻ biết nhiều và rõ hơn tôi về chúng."

#. Character:`saito`
msgctxt "kimochi_password_72d57756"
msgid "Je ne peux pas te dire comment je le sais, mais crois-moi."
msgstr "Tôi không thể cho ông biết ngay lúc này, nhưng tin tôi đi."

#. Character:`saito`
msgctxt "kimochi_password_40c43c04"
msgid "Nos vies et celles de notre entourage sont menacées."
msgstr "Tính mạng của chúng ta và của cả những người thân yêu đang bị đe dọa."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "kimochi_password_390e2428"
msgid "Que faisons-nous, on ne peut pas laisser {{chiaki.n}} entre les mains de ce fou furieux ?!"
msgstr "Chúng ta cần phải làm gì, không thể để mặc {{chiaki.n}} trong tay một tên tâm thần như vậy!"

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_c2a81921"
msgid "Rien, il est trop dangereux d'agir pour le moment."
msgstr "Không thể làm gì, quá là nguy hiểm để hành động vào lúc này."

#. Character:`saito`
msgctxt "kimochi_password_a566c1b6"
msgid "Il va falloir se préparer sérieusement."
msgstr "Chúng ta cần phải chuẩn bị kỹ càng hơn."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "kimochi_password_7a40db81"
msgid "Je ne pourrais plus jamais me regarder dans un miroir si je tourne le dos à une fille qui a besoin d'aide."
msgstr "Nếu như tôi làm ngơ một cô gái đang tuyệt vọng, tôi thật không xứng làm một thằng đàn ông !"

#. Character:`kimochi`
msgctxt "kimochi_password_36909d87"
msgid "Je vais continuer de rassembler des informations."
msgstr "Tôi sẽ tiếp tục tìm kiếm thông tin."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "kimochi_password_ae0a973e"
msgid "Si j'en apprends plus, je te fais signe."
msgstr "Ngay khi tôi biết được điều gì, tôi sẽ báo cho anh."

#. Character:`saito` | Attributes:`neutral`
msgctxt "kimochi_password_8137ad26"
msgid "Ça me va !"
msgstr "Được!"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_76ef0c7b"
msgid "Désolé {{saito.n}}, mais je suis hétéro."
msgstr "Xin lỗi, anh {{saito.n}}, nhưng tôi thẳng."

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_0e00fbe5"
msgid "Quel enfoiré !"
msgstr "Thằng chóa này!"

#. Character:`narrator`
msgctxt "kimochi_password_3a1f7172"
msgid "Bon, si je récapitule, {{minato.n}}, {{noriko.n}}, {{akira.n}}, les thugs, un clan yakuza..."
msgstr "Giờ để tổng hợp lại, ta có {{minato.n}}, {{noriko.n}}, {{akira.n}}, đám côn đồ, rồi lại còn Yakuza..."

#. Character:`narrator`
msgctxt "kimochi_password_6db61bc0"
msgid "Comme si je n'avais déjà pas assez de problèmes..."
msgstr "Cứ như kiểu mình chưa có đủ vấn đề để lo ấy..."

#. Character:`narrator`
msgctxt "kimochi_password_499ca319"
msgid "C'est bien plus flippant que tout ce que j'aurais pu imaginer."
msgstr "Hãi hùng hơn cả những gì mình có thể tưởng tượng."

#. Character:`saito`
msgctxt "kimochi_password_15c96f7b"
msgid "Je ferais mieux de rentrer chez moi..."
msgstr "Mình nghĩ mình nên về nhà..."

#. Character:`saito`
msgctxt "t7b6936b408"
msgid "Il est trop tard, je vais revenir demain."
msgstr "Cũng muộn rồi. Mình sẽ tới vào ngày mai vậy."

#. Character:`saito`
msgctxt "kimochi_password_63161f74"
msgid "{{kimochi.n}}, tu es là ?"
msgstr "{{kimochi.n}} ông có đó không?"

#. Character:`saito`
msgctxt "kimochi_password_ed6a25cb"
msgid "Faut que je te parle rapidement !"
msgstr "Tôi cần nói chuyện với ông ngay lập tức!"

#. Character:`macumba`
msgctxt "kimochi_password_d2da0498"
msgid "Salut, petit frère !"
msgstr "Chào người anh em!"

#. Character:`saito`
msgctxt "kimochi_password_24eb82ee"
msgid "{{macumba.n}} ?! Mais qu'est-ce que..."
msgstr "{{macumba.n}} ?! Chuyện đéo gì thế này..."

#. Character:`kimochi`
msgctxt "kimochi_password_89406d34"
msgid "Je lui ai proposé de venir chez moi."
msgstr "Tôi đã đề nghị anh ta tới đây."

#. Character:`macumba`
msgctxt "kimochi_password_6c4fc5c0"
msgid "Petit bonhomme m'a donné beaucoup de musique."
msgstr "Người bạn này đã cho tôi biết rất nhiều bài nhạc hay."

#. Character:`macumba`
msgctxt "kimochi_password_c836657d"
msgid "Surtout quelque chose que je ne connaissais pas."
msgstr "Đặc biệt là những bài tôi không biết."

#. Character:`macumba` | Attributes:`neutral`
msgctxt "kimochi_password_110e3723"
msgid "C'est écrit... \"10 Hours of soft loli moaning\"."
msgstr "Tựa đề là...\"10 tiếng Đồng Hồ Loli ân ái dịu ngọt !\""

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_afae8830"
msgid "...mec, tu es sérieux ?"
msgstr "...Ông à, thật không vậy ?"

#. Character:`kimochi`
msgctxt "kimochi_password_2dccb817"
msgid "Laisse-le découvrir la vie."
msgstr "Để anh ta trải đời."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "kimochi_password_3d9bdea2"
msgid "Bon, quel est le problème, tu as l'air agité."
msgstr "Được rồi, có chuyện gì sao? Trông anh có vẻ căng thẳng."

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_810735aa"
msgid "Je sais d'une source extérieure que {{minato.n}} ne vas pas tarder a passé a l'action."
msgstr "Một nguồn thông tin cho tôi hay rằng {{minato.n}} sẽ sớm thực hiện bước đi kế tiếp."

#. Character:`saito`
msgctxt "kimochi_password_c6f74541"
msgid "Et on est loin de pouvoir se défendre."
msgstr "Và sự chuẩn bị của chúng ta còn kém xa để có thể bảo vệ bản thân."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "kimochi_password_40da0c2b"
msgid "J'y ai pensé justement... Si on est seul, il nous faut des armes, de quoi filmer discrètement pour avoir des preuves."
msgstr "Tôi đã suy nghĩ về chuyện đó...Nếu như chúng ta độc hành, cần phải có vũ khí. Một thứ gì đó giúp âm thầm ghi âm lại mọi chuyện nhằm thu thập bằng chúng."

#. Character:`kimochi`
msgctxt "kimochi_password_e4eeb69c"
msgid "Il nous faut une force d'attaque implacable."
msgstr "Chúng ta cần một sát chiêu hùng mạnh."

#. Character:`macumba` | Attributes:`happy`
msgctxt "kimochi_password_b26eb365"
msgid "Je me charge de ça, bonhomme."
msgstr "Để điều đó cho tôi."

#. Character:`saito`
msgctxt "kimochi_password_c014e3d9"
msgid "Je ne sais pas où trouver ce genre de matos par contre."
msgstr "Nhưng tôi không biết có thể tìm thấy thứ đó ở đâu."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "kimochi_password_2caf034b"
msgid "Je m'en occupe, tu as juste à préparer une grosse somme d'argent pour qu'on puisse acheter tout ce dont on aura besoin."
msgstr "Tôi sẽ lo chuyện đó. Anh chỉ cần chuẩn bị một số tiền đủ lớn để chúng ta có thể mua tất cả những gì cần thiết."

#. Character:`saito`
msgctxt "kimochi_password_0601a365"
msgid "... Enfoiré, c'est moi qui vais trimer du coup ?"
msgstr "...Vậy, tôi là người phải đi gánh team hả ?"

#. Character:`kimochi`
msgctxt "kimochi_password_6000c616"
msgid "Souviens-toi, la force c'est {{macumba.n}}, la sagesse c'est moi, et toi tu es le courage."
msgstr "Hãy ghi nhớ, sức mạnh là {{macumba.n}}, trí tuệ là tôi, và dũng khí là anh."

#. Character:`saito` | Attributes:`neutral`
msgctxt "kimochi_password_a141c85e"
msgid "...De combien d'argent on parle ?"
msgstr "...Chúng ta cần bao nhiêu?"

#. Character:`kimochi`
msgctxt "kimochi_password_6f8d3c32"
msgid "Pour être bien, je dirais au minimum 50000¥."
msgstr "Để chắc chắn, tôi nghĩ không thể ít hơn 50000¥."

#. Character:`macumba`
msgctxt "kimochi_password_1479ea30"
msgid "Bonne chance, petit frère !"
msgstr "Chúc may mắn người anh em!"

#. Character:`kimochi`
msgctxt "kimochi_password_1f07e4d2"
msgid "Reviens me voir dès que tu auras amassé la somme !"
msgstr "Hãy tìm tới tôi ngay sau khi anh có đủ tiền !"

#. Character:`saito` | Attributes:`neutral`
msgctxt "kimochi_password_51b33d14"
msgid "Okay."
msgstr "Okay."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "t629098cca4"
msgid "{{saito.n}} ! Je savais que tu finirais par venir me trouver."
msgstr "{{saito.n}}! Tui biết rồi ông cũng tới mà."

#. Character:`saito` | Attributes:`guilty`
msgctxt "t453c7fbf63"
msgid "Tu vis vraiment dans un dépotoir..."
msgstr "Vãi, ông sống trong đống rác đấy hả..."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "tfa297bc835"
msgid "Et tu commences déjà à être désagréable."
msgstr "Bây chưa tới làm khách được 5 giây mà tau đã muốn tống cổ đi rồi."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "tf9bc4fe816"
msgid "Qu'est-ce qui t'amène ici ? Même si j'ai bien une idée..."
msgstr "Cơn gió nào đưa ông tới đây ? Chắc là đầu mới nảy số được gì hở..."

#. Character:`saito` | Attributes:`upset`
msgctxt "tb40b4f8834"
msgid "{{minato.n}}..."
msgstr "{{minato.n}}..."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "t07c87f8d9b"
msgid "Ah nous y voilà !"
msgstr "Tới"

#. Character:`saito`
msgctxt "t36df5e3d1e"
msgid "Cet enfoiré... Cachait bien son jeu."
msgstr "Tên khốn ấy... lươn như trạch."

#. Character:`saito`
msgctxt "tf967c5bb93"
msgid "Il n'a jamais été un ami et ne m'a jamais considéré comme tel."
msgstr "Tôi chưa bao giờ là bạn của hắn, và hắn cũng chưa bao giờ con tôi là bạn."

#. Character:`saito`
msgctxt "t0e0dae361c"
msgid "La raison du pourquoi me dépasse."
msgstr "Hai chữ \"tại sao\" thì đáng tiếc, vẫn lẩn khuất tôi."

#. Character:`saito`
msgctxt "t30f34f6471"
msgid "Mais à ses yeux je ne suis qu'un être pathétique..."
msgstr "Nhưng chắc chắn rằng, tên đó không coi tôi hơn một con con sâu kiến..."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "t6e945acdb5"
msgid "Un psychopathe !"
msgstr "Một tên loạn thần !"

#. Character:`saito`
msgctxt "t6bf25cc1d6"
msgid "Le problème c'est qu'il est en train de se faire passer pour quelqu'un de bien auprès d'une personne que j'apprécie."
msgstr "Cái vấn đề là, hắn ta muốn làm thân với một người mà tôi thích."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "t91048033d3"
msgid "Tu comprends maintenant ce que je ressens pour {{chiaki.n}}."
msgstr "Giờ ông hiểu những gì tôi cảm nhận về {{chiaki.n}} rồi đấy."

#. Character:`saito` | Attributes:`sad`
msgctxt "t3d01495b8d"
msgid "Ça reste sa sœur quand même... Il pourrait s'en prendre à sa propre famille ?"
msgstr "Nhưng... dù sao thì... con bé vẫn là máu mủ của hắn... Chắc gì hắn đã động ta động chân ?"

#. Character:`kimochi`
msgctxt "tdf80e641aa"
msgid "Mon pauvre... Je pense même que tout ça va bien plus loin !"
msgstr "Cậu bé của tôi ơi... Hắn còn phải hơn thế !"

#. Character:`kimochi`
msgctxt "tbf5d030015"
msgid "Tu savais que tous les weekends, le sous-sol de leur maison est allumé et qu'il y a toujours une grosse berline garée ?"
msgstr "Ông có biết là, tầng hầm của nhà hắn luôn sáng đèn mỗi cuối tuần, và sẽ có một cái sedan tới đỗ mỗi đêm không ?"

#. Character:`kimochi`
msgctxt "tf0124bb9dd"
msgid "J'ai trouvé à qui appartenait la voiture avec le numéro de la plaque."
msgstr "Tôi tìm ra được chủ nhân của chiếc xe đó qua biển số."

#. Character:`saito`
msgctxt "t778afa3816"
msgid "...[w]Ne me dis pas qu'il s'agit de..."
msgstr "...[w] Đừng bảo tôi là..."

#. Character:`kimochi` | Attributes:`think`
msgctxt "t7097e8dca4"
msgid "Lune sanglante"
msgstr "Huyết Nguyệt Gia Tộc"

#. Character:`saito`
msgctxt "tc35cb1bad1"
msgid "Putain, non !"
msgstr "Không ! KHÔNG THỂ NÀO !"

#. Character:`narrator`
msgctxt "t19c826ad96"
msgid "Je ne pensais pas entendre ce nom aussi vite."
msgstr "Tại sao thứ yêu ma quỷ thần ấy lại xuất hiện sớm đến vậy ?"

#. Character:`narrator`
msgctxt "t7a425d8654"
msgid "Si {{minato.n}} est en lien avec ce clan, alors ce n'est pas seulement sa soeur ou {{asami.n}} qui sont en danger mais tout le monde !"
msgstr "Nếu như {{minato.n}} có liên hệ với với bang tộc ấy, thì mỗi chúng ta, {{asami.n}}, em gái của hắn và cả tất cả mọi người đang gặp hiểm nguy !"

#. Character:`narrator`
msgctxt "t4817c3b93e"
msgid "On n'a jamais su comment tout avait commencé, mais à la base Lune sanglante était un clan mineur."
msgstr "Tại sao thứ yêu ma quỷ thần ấy lại xuất hiện sớm đến vậy ?"

#. Character:`narrator`
msgctxt "tc545091af5"
msgid "Mais des années plus tard, quand la vérité a éclaté, il s'est avéré qu'ils avaient gangréné absolument toutes les institutions de l'État, ils étaient intouchables."
msgstr "Ỉm đi vài năm sau, khi cánh nhà báo bới móc được sự thật, mọi cơ quan công quyền đã nằm dưới mũi giày chúng."

#. Character:`narrator`
msgctxt "te26f829a3f"
msgid "Prostitution, trafic d'organe, esclavage, drogue et ce n'était que le haut de l'iceberg."
msgstr "Mại dâm, buôn bán nội tạng. ma túy, rồi đấu giá nô lệ... Mà đấy mới là cái còn bới móc được ấy chứ !"

#. Character:`narrator`
msgctxt "t81275322f7"
msgid "La police ne faisait rien, elle était de toute façon contrôlée par le clan."
msgstr "Tên công an nào không nhận lương từ chúng thì cũng là khách hàng,"

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "tea63b3b132"
msgid "A en juger par ta réaction tu les connais ?"
msgstr "Theo như phản ứng của ông, hẳn ông biết rõ chúng nó ?"

#. Character:`saito` | Attributes:`upset`
msgctxt "tc1ea035df2"
msgid "Oui...[w]Et c'est une très mauvaise nouvelle."
msgstr "Biết rất rõ... [w] Chỉ toàn tin xấu thôi."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "taa778ee6e9"
msgid "Pourtant c'est un petit clan... A part vendre des bubbles tea..."
msgstr "Nhưng mà chúng nó chỉ là một băng côn đồ... chuyên đi bán trà sữa..."

#. Character:`saito`
msgctxt "tb9a5c7a1b9"
msgid "Ne les sous-estime pas !"
msgstr "Mày chưa  biết hết đâu con !"

#. Character:`saito`
msgctxt "t8fdd144739"
msgid "Il va falloir faire attention à partir de maintenant."
msgstr "Từ nay, từng đường đi nước bước của chúng ta đều phải tính toán kĩ càng."

#. Character:`saito`
msgctxt "teea81815c6"
msgid "La police n'interviendra pas, tu peux me croire !"
msgstr "Hở miệng với công an là chúng ta \"biến mất\" ngay !"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "tb7a396e997"
msgid "Je refuse de laisser tomber une fille en détresse, je ne serais plus digne d'être considéré comme un homme."
msgstr "Nếu tôi bỏ mặc một người con gái trong nanh vuốt quỷ thần, thì tôi không xứng mặt thằng đàn ông."

#. Character:`saito` | Attributes:`happy`
msgctxt "t28c0c85c68"
msgid "Bien dit !"
msgstr "Hay lắm !"

#. Character:`kimochi`
msgctxt "ta1a52c9a8a"
msgid "Je vais continuer à fouiller de mon côté et voir si je trouve quelque chose d'intéressant."
msgstr "Tôi sẽ tiếp tục bới móc xem có thông tin gì mới không."

#. Character:`saito`
msgctxt "t071ac4e14f"
msgid "Merci."
msgstr "Thanh sờ kiu."

#. Character:`saito`
msgctxt "kimochi_password_ea2d86fb"
msgid "Salut !"
msgstr "Chào !"

#. Character:`kimochi`
msgctxt "kimochi_password_a2de39ce"
msgid "Woah mec ! Putain, frappe à la porte avant de débarquer chez les gens comme ça !"
msgstr "Này anh! Hãy gõ cửa trước khi xông vào nhà người khác như vậy !"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "kimochi_password_904f5f6d"
msgid "T'as vraiment envie de me surprendre train de me branler ?"
msgstr "Anh thật sự muốn xem tôi thẩm du hả ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_7ffe9de7"
msgid "Euh... Désolé"
msgstr "Ờm...Xin lỗi."

#. Character:`kimochi`
msgctxt "kimochi_password_5d109b42"
msgid "Que se passe-t-il ?"
msgstr "Có chuyện gì vậy ?"

#. Character:`saito`
msgctxt "kimochi_password_85ffee2f"
msgid "Je suis confronté à un problème, j'ai besoin de quelqu'un pour faire une diversion."
msgstr "Tôi có một vấn đề, và tôi cần một ai đó có thể giúp tôi đánh lạc hướng."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "t5c5bdad902"
msgid "...[w] Oh ça sent les emmerdes à pleins nez ça !"
msgstr "...[w] Chưa gì đã ngửi thấy mùi chướng khí !"

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "kimochi_password_e428e16e"
msgid "...[w] Mouais, tu veux encore m'attirer des ennuis."
msgstr "...[w] Anh lại kéo tôi vào rắc rối rồi đây."

#. Character:`saito`
msgctxt "kimochi_password_2781d76a"
msgid "Eh bien... Pas nécessairement."
msgstr "Cũng...không hẳn."

#. Character:`saito`
msgctxt "kimochi_password_4afe65fb"
msgid "J'ai seulement besoin que tu détournes l'attention du patron du Coffee Boutique quelques minutes le temps d'entrer dans sa boutique."
msgstr "Tôi chỉ cần ông thu hút sự chú ý của tên chủ quán café trong khoảng vài phút để tôi vào bên trong cửa hàng của lão."

#. Character:`kimochi`
msgctxt "kimochi_password_ba6244ad"
msgid "De quoi ? Tu veux parler de {{netoru.n}} ?"
msgstr "Hửm? Anh đang nói về {{netoru.n}} đấy à?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "kimochi_password_164e4f2a"
msgid "Tu le connais ? C'est ton père ?"
msgstr "Anh biết lão sao? Ông già nhà anh à?"

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "kimochi_password_2395c428"
msgid "Woah doucement ! Je ne me suis jamais senti aussi insulté."
msgstr "Kìa! Bảo ông ta là đống cứt còn dễ nghe hơn đấy !"

#. Character:`kimochi`
msgctxt "kimochi_password_d3c07091"
msgid "Ce gros porc n'est pas mon père."
msgstr "Con lợn thối ấy không phải là cha tôi."

#. Character:`kimochi` | Attributes:`think`
msgctxt "kimochi_password_e80ee5ce"
msgid "Disons que c'est un client régulier..."
msgstr "Có thể nói ông ta là một khách hàng của tôi..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "kimochi_password_ba7fd39f"
msgid "Un cli... bordel, mais tu trafiques quoi avec lui ?"
msgstr "Khách hàng...mụ nội ông buôn lậu gì với lão ta vậy?"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_698caa7a"
msgid "Tu as vraiment envie de savoir ?"
msgstr "Anh có muốn biết không?"

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_eba678cd"
msgid "...[w] Non pas vraiment, je ne veux pas savoir ce que vous faites."
msgstr "...[w] Không hẳn, tôi không hứng thú lắm việc tìm hiểu xem anh dây dưa với cái gì."

#. Character:`saito`
msgctxt "kimochi_password_bafdbff6"
msgid "Tu peux l'occuper quelques minutes pour moi ?"
msgstr "Mà, liệu ông có thể ngáng đường lão ta trong vài phút được không ?"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "kimochi_password_82e37215"
msgid "Aucun problème, mais j'y gagne quoi ?"
msgstr "Không hề chi, nhưng có chút gì báo đáp không ?"

#. Character:`saito` | Attributes:`happy`
msgctxt "kimochi_password_01fb5b40"
msgid "Euh... le plaisir de rendre service à un ami ?"
msgstr "Ờm...niềm vui vì đã giúp đỡ được một người bạn ?"

#. Character:`kimochi` | Attributes:`doubt`
#, fuzzy
msgctxt "kimochi_password_436a27fe"
msgid "...[w] Daccord, ça ira pour cette fois."
msgstr "...[w] Thôi được, chỉ lần này thôi đấy."

#. Character:`saito` | Attributes:`happy`
msgctxt "kimochi_password_555dfcda"
msgid "Merci, je te revaudrai ça un jour."
msgstr "Cảm ơn, tôi sẽ cố gắng để báo đáp anh."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "kimochi_password_4632b8b0"
msgid "J'y compte bien."
msgstr "Tôi mong chờ đấy."

#. Character:`saito`
msgctxt "kimochi_password_ea2d86fb_1"
msgid "Salut !"
msgstr "Này !"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "t2da5b5c946"
msgid "Wow ! On entre pas chez les gens comme ça !"
msgstr "Đụyt con bà già nhà ông chứ ! Gõ cửa hộ bố cái coi !"

#. Character:`kimochi`
msgctxt "kimochi_password_e085aaeb"
msgid "J'ai failli faire une crise cardiaque !"
msgstr "Anh tí thì làm tôi đau tim đấy !"

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_2dd82977"
msgid "Désolé."
msgstr "Xin lỗi."

#. Character:`kimochi` | Attributes:`-frustrated`
msgctxt "kimochi_password_0d33ed8b"
msgid "Bref, qu'est-ce que je peux faire pour toi ?"
msgstr "Ờm, thì, tôi có thể giúp gì cho anh ?"

#. Character:`saito`
msgctxt "kimochi_password_9d9053f5"
msgid "J'ai des ennuis avec {{akira.n}} en ce moment."
msgstr "Tôi có một số vấn đề với {{akira.n}} gần đây."

#. Character:`saito`
msgctxt "kimochi_password_cf4a4267"
msgid "Et les trois autres abrutis..."
msgstr "Với cả ba thằng khốn kiếp du côn nữa..."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_f1ee2cc2"
msgid "Ravis de voir que je ne suis pas le seul à en prendre plein la tête."
msgstr "Mừng khi thấy ai đó cũng phải chịu đựng lũ khốn ấy như tôi."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "kimochi_password_fd17ba42"
msgid "Je crois que j'ai passé l'intégralité de ma scolarité à leur donner mon repas du midi."
msgstr "Cả thời đại học tôi dành ra chỉ để nấu bữa trưa cho chúng nó."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_5df7f4e5"
msgid "Ils ont arrêté le jour où ils m'ont volé des boulettes de riz au laxatif."
msgstr "Chúng nó chỉ dừng cái hôm chúng thó được vắt cơm chứa thuốc nhuận tràng của tôi."

#. Character:`kimochi`
msgctxt "kimochi_password_47ce3eb2"
msgid "J'ai morflé ce jour-là mais... Pas autant qu'eux."
msgstr "Táo bón đau lắm ông ạ... nhưng đéo bằng cái lũ ấy."

#. Character:`saito`
msgctxt "kimochi_password_0dbc7881"
msgid "J'aurais donné cher pour assister à ça."
msgstr "Có trả vàng tôi cũng muốn xem cảnh lũ khốn đấy bị tào tháo đuổi."

#. Character:`kimochi`
msgctxt "kimochi_password_bb5f357d"
msgid "Tu peux, j'ai tout filmé, je me repasse le film quand je déprime un peu, ça me redonne le sourire instantanément."
msgstr "Free đấy. Tôi quay lại hết mà. Cứ khi nào buồn tôi lại lôi ra xem. Lần nào cũng tức cười không chịu nổi."

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_42f498df"
msgid "Et pour {{akira.n}} ?"
msgstr "Thế còn {{akira.n}} thì sao ?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "kimochi_password_02afe272"
msgid "J'essaye de ne jamais trop m'approcher de lui."
msgstr "Tôi thì luôn tránh giáp mặt hắn ta rồi."

#. Character:`kimochi`
msgctxt "kimochi_password_2b69d0d0"
msgid "Ce mec est complètement timbré, un jour, il a dragué une fille qui était déjà en couple avec le caïd du lycée."
msgstr "Thằng đấy ngáo bỏ mẹ. Có một ngày hắn ta đi tán một cô gái, hoa có chậu là một thằng đầu gấu cấp 3."

#. Character:`kimochi`
msgctxt "kimochi_password_963d1a41"
msgid "Quand son mec s'est pointé, il a simplement baissé les yeux et n'a plus jamais ouvert sa bouche."
msgstr "Khi mà hai thằng đực rựa giáp mặt nhau, thằng bạn trai chỉ biết cúi đầu như chó."

#. Character:`kimochi`
msgctxt "kimochi_password_5f9c4185"
msgid "Une autre fois, un gars l'a interrompue pendant qu'il était en train de draguer."
msgstr "Lần khác, có một đứa kiếm chuyện thằng của nợ khi nó đang đi tán gái."

#. Character:`kimochi`
msgctxt "kimochi_password_f202295c"
msgid "Il a du passé sa journée à ramasser ses dents par terre, résultat, il va manger de la soupe le restant de sa vie."
msgstr "Kết quả thằng kiếm chuyện mất toàn bộ hàm răng, và phải ăn súp cả cuộc đời nó."

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "kimochi_password_ab0a0cec"
msgid "Toi...[w] T'as la tête d'un chien qui vient de faire caca sur la moquette du salon et qui sait qui va se faire engueuler."
msgstr "Ông...[w] Trông vẻ mặt ông như một con chó vừa ỉa ra thảm và biết rằng mình sắp bị chửi tứ lung tung hoàng."

#. Character:`kimochi`
msgctxt "kimochi_password_d48cf6ec"
msgid "Qu'est-ce que t'as foutu {{saito.n}} ?"
msgstr "Ông đã làm cái đéo gì vậy, {{saito.n}}?"

#. Character:`saito`
msgctxt "kimochi_password_befced88"
msgid "Mhhh, il se pourrait que je l'aie empêché d'avoir une fille qu'il essayait d'avoir depuis longtemps..."
msgstr "Ờmm, Tôi... ngăn cản hắn ta tán một cô gái mà hắn rất muốn có."

#. Character:`kimochi`
msgctxt "kimochi_password_91ffc9bc"
msgid "Okay, ravi de t'avoir connu."
msgstr "Rất vui vì được biết ông, nhưng có vẻ như cuộc đời ông dừng lại ở đây rồi."

#. Character:`saito`
msgctxt "kimochi_password_23134bbb"
msgid "Sérieusement..."
msgstr "Thật luôn à..."

#. Character:`kimochi`
msgctxt "kimochi_password_bf45d6a7"
msgid "Bien sûr que je suis sérieux ! Aucun espoir, t'es mort, mais tu ne le sais pas encore."
msgstr "Tất nhiên là thật rồi ! Ông chết chắc rồi, chỉ là không biết bao giờ chết thôi."

#. Character:`saito`
msgctxt "kimochi_password_df2734f5"
msgid "Tu dois bien avoir une idée ?"
msgstr "Chắc là ông có một vài ý tưởng, đúng không ?"

#. Character:`saito`
msgctxt "kimochi_password_aa9a0ee2"
msgid "Pour le moment, le gros lard qui tient le Coffee Boutique a le dessus sur eux, il a fait un enregistrement quand ils me sont tombés dessus, mais je ne sais pas si ça va durer."
msgstr "Thằng lợn già ở quán cafe nẫng tay trên của chúng nó. Khi chúng nó tóm được tôi, thằng già ấy ghi âm được và từ đó đến giờ thì bọn đấy chưa dám làm gì."

#. Character:`kimochi`
msgctxt "kimochi_password_c55d7390"
msgid "{{netoru.n}} ? Curieux, c'est pas son genre pourtant de se mêler de ce genre de trucs."
msgstr "{{netoru.n}} á ? Lạ nhể, thường thì lão ta không thích mó tay vào mấy chuyện này."

#. Character:`kimochi`
msgctxt "kimochi_password_fedd064f"
msgid "Qu'est-ce qu'il a fait exactement ?"
msgstr "Lão ta làm ghi âm gì thế ?"

#. Character:`saito`
msgctxt "kimochi_password_4c846dac"
msgid "Il a un enregistrement d'{{akira.n}} où il menace de me tuer et de bruler sa boutique."
msgstr "Ổng làm một bản ghi âm vào cái lúc {{akira.n}} dọa sẽ giết tôi và đốt quán ổng."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_7fc91945"
msgid "Ah, ça ne m'étonne pas ! Ce mec est un véritable génie, il a un caractère de merde, mais pour faire du chantage, c'est juste le roi."
msgstr "À, thế thì hiểu rồi. Thằng già ấy thông mình vô cùng. Tâm tính lão thì như cứt chứ về khoản tống tiến, pressing, áp bức thì lão có thừa."

#. Character:`kimochi`
msgctxt "kimochi_password_6dfc1569"
msgid "Il le tient par les couilles !"
msgstr "Có vẻ như là lão thích bóp dái thằng mỏ đỏ kia !"

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_b2962765"
msgid "Oui, et moi aussi par la même occasion."
msgstr "Ừ, và cả tôi nữa."

#. Character:`saito`
msgctxt "kimochi_password_7ea80678"
msgid "Il n'y a que cet enregistrement qui m'évite de me faire tuer."
msgstr "Cải bản ghi âm là lá chắn duy nhất giúp tôi tránh bị giết."

#. Character:`saito`
msgctxt "kimochi_password_e3ae658f"
msgid "Et rien ne dit qu'il m'aidera sans demander quelque chose en retour."
msgstr "Và linh cảm bảo tôi rằng, thằng cha đấy không tốt đẹp đến mức cho không ai cái gì."

#. Character:`kimochi`
msgctxt "kimochi_password_f338a87d"
msgid "Tu vois ? Un génie ? Il peut faire chanter à la fois la victime et l'agresseur."
msgstr "Thấy chưa ? Lão ta là một thiên tài ! Có thể điều khiển cả nạn nhân và kẻ gây hấn như một con rối."

#. Character:`saito`
msgctxt "kimochi_password_9ebad2ce"
msgid "Tu m'aides pas là."
msgstr "Ông đéo giúp gì cả, ông biết đấy."

#. Character:`kimochi` | Attributes:`think`
msgctxt "kimochi_password_2d40b635"
msgid "Désolé mais... la seule solution serait que tu trouves un moyen de pression encore plus fort encore."
msgstr "Xin lỗi, nhưng mà... Cửa sống duy nhất của ông đó là tìm ra một cái gì đó có thể gây áp lực ngược lại được lão ta."

#. Character:`kimochi`
msgctxt "kimochi_password_8327dd1f"
msgid "Quelque chose de si compromettant qu'il se chierait dessus littéralement rien que d'y penser."
msgstr "Cái gì phải quyền năng tới nỗi chỉ cần vừa nghe thấy là lão sợ đái ra quần ngay."

#. Character:`kimochi`
msgctxt "kimochi_password_b1e40689"
msgid "Mais si ça se trouve, il sera sympa et t'en fera une copie pour que tu puisses te défendre aussi."
msgstr "Nhưng mà biết đâu lão ta lại giở lòng thương hại và đưa anh một bản copy để anh tự vệ thì sao ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_6bf81159"
msgid "Mouais, j'en doute, mais je peux toujours demander."
msgstr "Sus, nhưng mà chắc không hỏi sao biết."

#. Character:`saito`
msgctxt "kimochi_password_d35f6e5b"
msgid "Merci pour tes conseils {{kimochi.n}} !"
msgstr "Cảm ơn vì lời khuyên, {{kimochi.n}}!"

#. Character:`kimochi` | Attributes:`sad`
msgctxt "kimochi_password_8eede8e5"
msgid "Ahlala... Quelle naïveté quand même."
msgstr "Ahhh... Anh ngây ngô quá."

#. Character:`kimochi`
msgctxt "kimochi_password_47b254dd"
msgid "Y'a aucune chance qu'il te donne l'enregistrement..."
msgstr "Có cái cục cứt lão ta bao dung tới vậy..."

#. Character:`kimochi`
msgctxt "kimochi_password_2be73acf"
msgid "{{saito.n}}..."
msgstr "{{saito.n}}..."

#. Character:`kimochi`
msgctxt "kimochi_password_47e9b972"
msgid "Un jour, il faudra que t'essaies de frapper à la porte avant d'entrer."
msgstr "Một ngày mai, mong anh bị thằng chó nào cước vỡ đầu vì cái tội không gõ cửa đê."

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_96412cd4"
msgid "Pardon, c'est une mauvaise habitude difficile à perdre."
msgstr "Xin lỗi. Thói xấu khó bỏ. Thật."

#. Character:`kimochi`
msgctxt "kimochi_password_78ade444"
msgid "Un jour, tu vas débarquer pendant ma branlette quotidienne, tu n'auras que tes yeux pour pleurer..."
msgstr "Một ngày mai, anh sẽ xông vào đúng lúc tôi đang thẩm, và khi đó anh sẽ chỉ có bản thân với những cơn ác một triền miên."

#. Character:`kimochi`
msgctxt "kimochi_password_f495d4e2"
msgid "Bref ...[w] Qu'est-ce que je peux faire pour toi ?"
msgstr "Dù sao thì...[w] Tôi giúp gì được cho ông ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_10ffc083"
msgid "J'ai des ennuis avec les thugs, de gros ennuis."
msgstr "Tôi đang gặp rắc rối với đám côn đồ. Rắc rối lớn luôn."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "kimochi_password_37ecfb37"
msgid "Bienvenue au club."
msgstr "Chào mừng vào hội bọn yếu hèn."

#. Character:`saito`
msgctxt "kimochi_password_9b0423ac"
msgid "Depuis que j'en ai frappé un j-"
msgstr "Tại vì tôi nộ long cước một trong số chúng nó, nên là-"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_88513f0d"
msgid "T'en as frappé un ?!!"
msgstr "Ông oánh một tên ư ?!"

#. Character:`kimochi`
msgctxt "kimochi_password_73323aec"
msgid "Je veux savoir, quel effet ça t'a fait ?"
msgstr "Cảm giác thế nào ? Có yomost không ?"

#. Character:`kimochi`
msgctxt "kimochi_password_0c5ee6fc"
msgid "Est-ce qu'il a eu mal ?"
msgstr "Bây giờ nó ra sao rồi ?"

#. Character:`kimochi`
msgctxt "kimochi_password_ccedf48e"
msgid "Tu lui as cassé quelque chose au moins ?"
msgstr "Có đánh gãy được cái gì của nó không ?"

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_742b56f0"
msgid "Il a été sonné sur le coup, mais à présent..."
msgstr "Bất tỉnh nhân sự, nhưng giờ thì..."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "kimochi_password_0ecfda81"
msgid "Ils ne te lâchent plus."
msgstr "Chúng nó đang sôi máu, đúng không ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_e2e61c58"
msgid "Tu as compris."
msgstr "Hiểu vấn đề rồi đấy."

#. Character:`saito`
msgctxt "kimochi_password_ed0dacc9"
msgid "Tu as quelque chose qui pourrait m'aider, un conseil, n'importe quoi ?"
msgstr "Ông có cái gì có thể giúp tôi, có lời khuyên hay gì không ?"

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "kimochi_password_0f3ca960"
msgid "T'es marrant, mais si jamais j'avais un moyen de pression, je l'aurais utilisé depuis bien longtemps."
msgstr "Anh bạn à, nếu như có cách nào để áp chế chúng nó thì tôi đã dùng từ xưa lắc xưa lơ rồi."

#. Character:`kimochi`
msgctxt "kimochi_password_15b9d1b4"
msgid "Tout ce que j'ai contre eux c'est qu'ils semblent prendre leurs ordres de quelqu'un."
msgstr "Tôi chỉ để ý được có một điều đó là bọn chúng nó hay nhận lệnh từ một kẻ khác."

#. Character:`saito` | Attributes:`neutral`
msgctxt "kimochi_password_dc3d8d90"
msgid "{{akira.n}} ?"
msgstr "{{akira.n}}?"

#. Character:`kimochi`
msgctxt "kimochi_password_636a1b17"
msgid "Non... Il a seulement le dessus sur eux, car il sait vraiment se battre."
msgstr "Không... Nó chỉ tác oai tác quái được vì nó có võ thôi."

#. Character:`saito` | Attributes:`angry`
msgctxt "kimochi_password_3888c97b"
msgid "Je sais... C'est enfoiré me bloque l'accès au dojo, impossible de m'y inscrire."
msgstr "Thằng chó đấy luôn cản tôi mỗi khi tôi cố gắng vào Võ Đường."

#. Character:`kimochi` | Attributes:`think`
msgctxt "kimochi_password_05c5336d"
msgid "{{akira.n}} est peut-être un connard, mais il n'est pas idiot."
msgstr "{{akira.n}} tuy có thể là một thằng khốn, nhưng hắn ta không đần."

#. Character:`kimochi`
msgctxt "kimochi_password_fe51649b"
msgid "Et c'est quelqu'un de fier. Jamais il ne se mettrait sous les ordres d'une autre personne."
msgstr "Vả lại, hắn còn rất kiêu nữa. Đời nào hắn chịu ở dưới trướng người khác."

#. Character:`saito` | Attributes:`surprised`
msgctxt "kimochi_password_fe826546"
msgid "Tu penses à qui dans ce cas ? {{minato.n}} ?"
msgstr "Thế ông nghĩ kẻ ra lệnh là ai? {{minato.n}}?"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "kimochi_password_07d810a8"
msgid "Précisément."
msgstr "Chắc chắn luôn."

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_9c3fb953"
msgid "Plus j'en apprends et plus la situation se complique."
msgstr "Càng tìm hiểu với hắn, mọi sự càng trở nên rắc rối hơn."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "kimochi_password_306d0b5d"
msgid "Je suis désolé de ne pas pouvoir t'aider davantage."
msgstr "Tôi xin lỗi vì tôi không thể giúp được gì nhiều."

#. Character:`saito`
msgctxt "kimochi_password_a1eb495a"
msgid "Ne t'en fais pas, je suis certain de trouver une solution à un moment ou un autre."
msgstr "Đừng lo, chắc rồi tôi cũng sẽ tìm ra giải pháp sớm hay muộn thôi."

#. Character:`saito` | Attributes:`happy`
msgctxt "kimochi_password_b3a74af9"
msgid "Je vais aller travailler au restaurant, ça me changera les idées."
msgstr "Tôi đi làm ở Quán Udon đây. Không khí ở đấy sẽ giúp thư giãn đầu óc tôi chút."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_717e71dd"
msgid "Le restaurant de Udon ? J'y suis allé l'autre jour, leurs toilettes sont si propres qu'on aurait pu y manger dedans."
msgstr "Quán Udon đó hả ? Tôi vừa đến đó hôm bữa. Toilets sạch tới nỗi có thể dùng làm tô ăn luôn."

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_c2cffe85"
msgid "..."
msgstr "..."

#. Character:`kimochi`
msgctxt "kimochi_password_9cdc33db"
msgid "{{saito.n}}... Ne fais pas cette tête, c'est une expression, personne n'est assez fou pour manger des toilettes."
msgstr "{{saito.n}}... Có chuyện gì với cái bản mặt đó vậy ? Chỉ là chém gió thôi mà, đéo ai điên tới độ ăn Udon dùng bô toilet cả."

#. Character:`kimochi`
msgctxt "kimochi_password_bee10adb"
msgid "T'imagines un peu le gars désespéré prêt à tout ?"
msgstr "Thử tưởng tượng ông anh phải tuyệt vọng tới mức nào mới làm như thế ?"

#. Character:`kimochi`
msgctxt "kimochi_password_6f2a7590"
msgid "Haha !"
msgstr "Haha !"

#. Character:`kimochi`
msgctxt "kimochi_password_24e8a49b"
msgid "{{saito.n}}... Que me vaut l'honneur de ta visite ?"
msgstr "{{saito.n}}... Cớ sao mà tôi hân hạnh nhận được một cuộc ghé thăm đây ?"

#. Character:`saito`
msgctxt "kimochi_password_516a04be"
msgid "Rien... Je passais dans le coin comme ça, je voulais voir comment tu allais."
msgstr "À có éo gì đâu... Chỉ tạt qua xem xem ông bạn làm ăn thế nào thôi."

#. Character:`kimochi`
msgctxt "kimochi_password_dbc76850"
msgid "Tututu, toi et moi savons que ta visite n'est pas un hasard."
msgstr "Ssssh. Tường ở đây dày lắm, nên cứ nói thoải mái."

#. Character:`kimochi`
msgctxt "kimochi_password_b2c72101"
msgid "J'ai le nez pour deviner ces choses-là."
msgstr "Tôi đánh hơi được sự giả dối đấy."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "kimochi_password_d95d3f72"
msgid "Dis-moi plutôt ce qui t'amène."
msgstr "Nói đi, điều gì đã đưa ông tới đây."

#. Character:`saito`
msgctxt "kimochi_password_85eec27b"
msgid "...D'accord."
msgstr "...Được rồi."

#. Character:`saito`
msgctxt "kimochi_password_1c7fe166"
msgid "Est-ce que dernièrement, tu aurais vu quelque chose de... suspect ou d'intriguant ces derniers jours ?"
msgstr "Ông có thấy cái gì mờ ám hay là thú vị dạo gần đây không ?"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "kimochi_password_42570a08"
msgid "Mhhh, il va falloir que tu précises le fond de ta pensée."
msgstr "Mmmm, ông cần phải nói rõ hơn suy nghĩ của ông đấy."

#. Character:`kimochi`
msgctxt "kimochi_password_5b7eb67b"
msgid "Tu n'as pas idée de tout ce qui peut se passer dans cette ville."
msgstr "Ông không thể mường tượng được những gì đang diễn ra trong cái thị trấn này đâu."

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_4889e3e6"
msgid "Des choses en liant avec les thugs, {{akira.n}}, {{minato.n}} ou encore {{netoru.n}}."
msgstr "Bất cứ điều gì liên quan tới ba tên du côn, {{akira.n}}, {{minato.n}}, hay thậm chí là cả {{netoru.n}}."

#. Character:`saito`
msgctxt "kimochi_password_c328f61a"
msgid "Je sais que {{akira.n}} m'en veut personnellement, il a décidé de me nuire d'une manière ou d'un autre."
msgstr "Tôi biết là {{akira.n}} rất căm thù tôi, và sống chết nó cũng phải tìm cách thọc dao vào bụng tôi."

#. Character:`saito`
msgctxt "kimochi_password_06912f2f"
msgid "Les thugs aussi, mais je crois qu'ils se sont faits..."
msgstr "Ba thằng kia thì chắc cũng thế, nhưng mầ hình như tôi nghĩ chúng nó bị..."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_1380d348"
msgid "Détruire !"
msgstr "Tiêu diệt !"

#. Character:`kimochi`
msgctxt "kimochi_password_f70c8bc2"
msgid "Les thugs se sont fait littéralement détruire, j'ai assisté à ça bien à l'abri comme d'habitude, mais ils ont été pourchassés dans toute la ville."
msgstr "Ba thằng đấy bị tiêu diệt. Bay màu. Hôm bữa tôi thấy chúng nó bị đuổi ngang dọc khắp cái thị trấn này."

#. Character:`saito` | Attributes:`happy`
msgctxt "kimochi_password_407ae980"
msgid "Tu sais par qui ?"
msgstr "Ông có biết đó là ai không ?"

#. Character:`saito`
msgctxt "kimochi_password_8f97e5d2"
msgid "Faudra que je le remercie."
msgstr "Tôi phải tới dập đầu cảm ơn người đó."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "kimochi_password_becb90e6"
msgid "Non, il était plutôt grand, mais portait un sweat à capuche avec un masque."
msgstr "Chả biết, người đó khá cao, mặc một cái hoodie và đeo mặt nạ."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_dda9d26e"
msgid "C'était magnifique à voir."
msgstr "Một khung cảnh đẹp tựa tranh vẽ."

#. Character:`kimochi`
msgctxt "kimochi_password_869b5ef7"
msgid "Comme si le karma lui-même s'était manifesté pour leur chier sur la gueule !"
msgstr "Cứ như kiểu nghiệp tụ nhiều quá hóa dạng người đi thông ass chúng nó vậy !"

#. Character:`saito`
msgctxt "kimochi_password_450a2a8f"
msgid "Et {{akira.n}} ?"
msgstr "Thế còn {{akira.n}} thì sao ?"

#. Character:`saito`
msgctxt "kimochi_password_2a8c9679"
msgid "Du nouveau sur lui ?"
msgstr "Có tin tức gì mới không ?"

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "kimochi_password_ebac0c10"
msgid "L'autre jour, je l'ai vu se rendre chez {{minato.n}}."
msgstr "Tôi thấy hắn ta qua nhà {{minato.n}} hôm bữa."

#. Character:`saito` | Attributes:`surprised`
msgctxt "kimochi_password_50c4a026"
msgid "QUOI ?! Ils se connaissent ?"
msgstr "CÁI CỜ LỜ GÌ ?! Chúng nó quen nhau à ?"

#. Character:`kimochi` | Attributes:`sad`
msgctxt "kimochi_password_7f8e4375"
msgid "Je ne vois pas ce qui t'étonne sincèrement."
msgstr "Thật sự thì tôi không hiểu sao ông lại ngạc nhiên tới mức đấy."

#. Character:`kimochi`
msgctxt "kimochi_password_8816bcc3"
msgid "Il est resté environ une heure chez lui et après, il est parti le sourire aux lèvres."
msgstr "Hắn ở lại đó khoảng một tiếng, rồi vừa đi vừa nở một nụ cười."

#. Character:`saito` | Attributes:`upset`
msgctxt "kimochi_password_d2f4cb23"
msgid "Et ?"
msgstr "Và ?"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "kimochi_password_31121140"
msgid "C'est tout !"
msgstr "Hết rồi !"

#. Character:`kimochi`
msgctxt "kimochi_password_6efc2021"
msgid "Je n'ai pas d'autres informations."
msgstr "Tôi không còn thông tin nào nữa."

#. Character:`saito`
msgctxt "kimochi_password_4e7fec6c"
msgid "Donc, si je résume tout ça..."
msgstr "Vậy giờ tổng hợp lại..."

#. Character:`saito`
msgctxt "kimochi_password_affa43e6"
msgid "Les thugs sont hors d'état de nuire par un individu qui préfère rester anonyme."
msgstr "Đám côn đồ bị cho bốc hơi bởi một người muốn giấu danh tính."

#. Character:`saito`
msgctxt "kimochi_password_9b320ce0"
msgid "{{akira.n}} et {{minato.n}} se sont vu et il semble qu'{{akira.n}} ait obtenu quelque chose de cet entretien."
msgstr "{{akira.n}} và {{minato.n}} gặp nhau, và có vẻ như {{akira.n}} kiếm chác được gì đó hay ho."

#. Character:`saito` | Attributes:`surprised`
msgctxt "kimochi_password_046c780b"
msgid "Oh, j'oubliais... et {{netoru.n}} ?"
msgstr "À, tí thì quên... Còn {{netoru.n}} thì sao ?"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_97c98d3c"
msgid "Haha... Lui, il est en train de dépenser toutes ses économies au Tenshi club."
msgstr "Hề hề, lão ta đang đốt hết khoản tiết kiệm của lão trong Câu lạc bộ đêm."

#. Character:`kimochi`
msgctxt "kimochi_password_fc4882d5"
msgid "Je ne sais pas combien de temps, il va pouvoir tenir, mais ça ne pourra plus durer longtemps."
msgstr "Chả biết bao giờ thì cháy túi, nhưng chắc sớm thôi."

#. Character:`saito` | Attributes:`happy`
msgctxt "kimochi_password_f488460d"
msgid "Tant pis pour lui."
msgstr "Thương đéo gì lão."

#. Character:`saito`
msgctxt "kimochi_password_c07ea1bb"
msgid "Merci beaucoup pour toutes ces infos."
msgstr "Cảm ơn anh rất nhiều về những thông tin này."

#. Character:`saito`
msgctxt "kimochi_password_f25b49db"
msgid "Je repasserai un de ces jours et..."
msgstr "Vài hôm tới tôi sẽ quay lại, và..."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "kimochi_password_6d2dcf4c"
msgid "Une minute ingrat ! Tu croyais tout de même pas que ces informations étaient gratuites ?"
msgstr "Chốt tồ mát tề ! Ông nghĩ là tôi hào phóng đến độ cho không ai cái gì đấy hả ?"

#. Character:`saito` | Attributes:`surprised`
msgctxt "kimochi_password_89efc79b"
msgid "Euh... Et notre amitié ?"
msgstr "Ờm... Thế còn tình bạn của chúng ta thì sao ?"

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "kimochi_password_677f3fab"
msgid "Non, non, non, par amitié, je t'ai dit tout ce que je savais, mais à présent, tu dois me rendre un service."
msgstr "No, no, no. Vì tôi quý ông nên tôi mới nôn hết thông tin ra cho ông, nhưng giờ ông phải giúp tôi một việc."

#. Character:`saito` | Attributes:`sad`
msgctxt "kimochi_password_d4486940"
msgid "...Okay, que veux-tu que je fasse ?"
msgstr "... Được thôi. Ông cần tôi giúp gì nào ?"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_1b6b2e48"
msgid "Apporte cette clef USB à {{macumba.n}} ce soir à son travail !"
msgstr "Hãy đưa chiếc USB Flash này cho {{macumba.n}} tối nay, trong ca trực của anh ấy !"

#. Character:`saito` | Attributes:`neutral`
msgctxt "kimochi_password_94b37301"
msgid "Je veux bien, mais ça peut pas attendre demain matin ? Il fait son sport au parc tous les jours."
msgstr "Được, nhưng mà đợi sáng mai được không. Anh ta hay chạy bộ ở công viên lúc đó."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "kimochi_password_c3e4d4a7"
msgid "Non, tu le connais, la musique est quelque chose de sacré et ça ne doit pas attendre."
msgstr "Không được, ông với anh ta là bạn mà. Âm nhạc là thứ vô cùng thiêng liêng, nên giao hàng không thể chậm trễ."

#. Character:`saito` | Attributes:`happy`
msgctxt "kimochi_password_55afb91f"
msgid "D'accord, d'accord !"
msgstr "Okay, okay !"

#. Character:`saito` | Attributes:`-happy`
msgctxt "kimochi_password_ecf6d582"
msgid "Au fait... Il y a quoi comme musique sur cette clef USB ?"
msgstr "Mà hỏi chút... Trong chiếc USB này chứa gì vậy ?"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "kimochi_password_7aa4c010"
msgid "Rien de particulier, ne te fais juste pas attraper par la police avec ça en ta possession, c'est tout."
msgstr "Không có gì đặc biết lắm đâu. Miễn sao là ông không bị lũ cớm bắt khi mang nó trong người là được."

#. Character:`saito` | Attributes:`surprised`
msgctxt "kimochi_password_9e273496"
msgid "QUOI !? Mais pourquoi ?"
msgstr "QUẦN QUÈ GÌ VẬY ?! Nhưng sao lại ?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "kimochi_password_e12af49d"
msgid "Shhhht, pas de questions, contente-toi de lui donner, c'est tout !"
msgstr "Ssssh ! Không hỏi hiếc gì hết. Việc của ông là đưa nó cho anh ta, thế thôi !"

#. Character:`kimochi`
msgctxt "kimochi_password_f912de53"
msgid "Mais évite les flics quand même."
msgstr "Nhưng mà tránh xa lũ cớm hết sức có thể."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "kimochi_password_13e5783b"
msgid "Allez hop ! Ne traine pas !"
msgstr "Đi đi ! Ở đây làm gì nữa !"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "SAITO_N_A_FAISAIT_LONGTEMPS_T_9CA7A6"
msgid "{{saito.n}} ! Ça faisait longtemps, tu t'es souvenu que j'existais ?"
msgstr ""

#. Character:`saito` | Attributes:`neutral`
msgctxt "D_SOL_JE_SUIS_TR_S_OCCUP_EN_CE_06D0CB"
msgid "Désolé je suis très occupé en ce moment, j'ai une dette énorme à rembourser et c'est un peu la raison de ma visite."
msgstr ""

#. Character:`kimochi` | Attributes:`think`
msgctxt "AH_TU_ES_VENU_POUR_PARLER_D_AR_305ADE"
msgid "Ah tu es venu pour parler d'argent ça tombe bien, j'ai moi aussi perdu ma source d'argent régulière dernièrement."
msgstr ""

#. Character:`saito`
msgctxt "VRAI_DIRE_J_ESP_RAIS_QUE_TU_A_9011B4"
msgid "À vrai dire... J'espérais que tu aurais des suggestions ou des... plans pour gagner plus d'argent... légalement bien sûr !"
msgstr ""

#. Character:`kimochi` | Attributes:`sad`
msgctxt "TU_PENSES_BIEN_QUE_S_IL_EXISTA_39EB2D"
msgid "Tu penses bien que s'il existait ce genre de plan je le saurais. Mais malheureusement non."
msgstr ""

#. Character:`saito` | Attributes:`sad`
msgctxt "MINCE_TU_FAISAIS_QUOI_AVANT_483193"
msgid "Mince... Tu faisais quoi avant ?"
msgstr ""

#. Character:`kimochi` | Attributes:`happy`
msgctxt "MOI_J_AVAIS_UN_PETIT_BUSINESS_240797"
msgid "Moi j'avais un petit business tout à fait honnête, je vendais du hentai à la demande, selon les préférences du client bien sûr."
msgstr ""

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "FIGURE_TOI_QUE_MON_PLUS_GROS_C_A99BF5"
msgid "Figure-toi que mon plus gros client, le gars à qui appartient le coffee shop du coin de la rue, m'a laissé tomber du jour au lendemain, c'était un gros fan de contenu milf et maintenant plus rien... Comment je vais faire pour payer mon loyer moi maintenant ?"
msgstr ""

#. Character:`saito` | Attributes:`upset`
msgctxt "TU_PARLES_BIEN_D_UN_GROS_BEDON_D9D9AE"
msgid "Tu parles bien d'un gros bedonnant, avec des lunettes et un polo vert kaki avec une étiquette \"boss\" ?"
msgstr ""

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "EXACTEMENT_JE_NE_SAVAIS_PAS_QU_8B95C5"
msgid "Exactement ! Je ne savais pas que tu le connaissais."
msgstr ""

#. Character:`saito`
msgctxt "CONNA_TRE_C_EST_UN_BIEN_GRAND_D36D1B"
msgid "Connaître c'est un bien grand mot, c'est le patron de {{yasuka.n}}, la personne qui m'a recueilli il y a des années quand mon père m'a abandonné."
msgstr ""

#. Character:`kimochi` | Attributes:`think`
msgctxt "OH_EH_BIEN_R_JOUIS_TOI_CAR_AU_86D67A"
msgid "Oh eh bien réjouis-toi car au train où vont les choses tu auras bientôt un beau-père."
msgstr ""

#. Character:`saito` | Attributes:`surprised`
msgctxt "QUOI_POURQUOI_TU_DIS_A_6C0F08"
msgid "Quoi ?! Pourquoi tu dis ça ?"
msgstr ""

#. Character:`kimochi`
msgctxt "J_AI_VOULU_ALLER_LE_VOIR_QUAND_2DB901"
msgid "J'ai voulu aller le voir quand il m'a lâché mais ce que j'ai vu c'est un homme qui passait son temps à tourner autour de son employée."
msgstr ""

#. Character:`saito` | Attributes:`happy`
msgctxt "ELLE_NE_L_ACCEPTERA_JAMAIS_DE_9087AE"
msgid "Elle ne l'acceptera jamais de toute façon."
msgstr ""

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "JE_NE_SERAIS_PAS_AUSSI_CAT_GOR_BAE749"
msgid "Je ne serais pas aussi catégorique que toi, ce type est un sacré baratineur tu sais..."
msgstr ""

#. Character:`kimochi`
msgctxt "IL_EST_PARTICULI_REMENT_DOU_PO_872CB5"
msgid "Il est particulièrement doué pour faire culpabiliser et manipuler les gens."
msgstr ""

#. Character:`saito` | Attributes:`neutral`
msgctxt "COMMENT_TU_SAIS_TOUT_A_B6C6F8"
msgid "Comment tu sais tout ça ?"
msgstr ""

#. Character:`kimochi` | Attributes:`happy`
msgctxt "IL_TIENT_UN_BLOG_SUR_INTERNET_38F31B"
msgid "Il tient un blog sur internet, il explique tout, il me l'a donné il y a quelque temps en me disant que ça pourrait m'aider à conclure... un jour."
msgstr ""

#. Character:`saito`
msgctxt "JE_JE_CROIS_QUE_JE_VAIS_DEVOIR_C63EC8"
msgid "Je... je crois que je vais devoir en parler à {{yasuka.n}} ce soir."
msgstr ""

#. Character:`kimochi` | Attributes:`happy`
msgctxt "BON_COURAGE_ET_TIENS_MOI_AU_CO_CAA6B4"
msgid "Bon courage et tiens-moi au courant !"
msgstr ""

#. Character:`kimochi`
msgctxt "home_kimochi_interior_007006fc"
msgid "Alors, quel bon vent t'amène dans mon humble demeure ?"
msgstr "Vậy cơn gió lành nào đưa ông tới cư gia của tôi đây ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_f4cca716"
msgid "Faut vraiment que tu fasses un peu de ménage... Ça commence à sentir même à l'extérieur."
msgstr "Dọn nhà một chút đi ông tướng... Hôi từ ngoài hôi vào."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_kimochi_interior_9528c987"
msgid "Et, tu deviens désagréable..."
msgstr "Chưa gì ông đã cảm thấy khó chịu rồi..."

#. Character:`saito`
msgctxt "home_kimochi_interior_04bea150"
msgid "Je dis ça pour toi... Imagine un jour, tu réussis par, je ne sais quel miracle à inviter {{chiaki.n}} chez toi."
msgstr "Bố đang khuyên mầy đấy... Tưởng tượng một ngày kia phép màu kì diệu nào đó đưa {{chiaki.n}} tới nhà ông."

#. Character:`saito`
msgctxt "home_kimochi_interior_0b9b4299"
msgid "Tu la laisserais entrer dans cette... pièce ?"
msgstr "Liệu ông sẽ để con bé vào trong cái... này hả ?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_17f570c0"
msgid "... Tu marques un point."
msgstr "... Có lý đấy."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "home_kimochi_interior_05b853a8"
msgid "Mais... je suppose que tu n'es pas là pour parler ménage avec moi ?"
msgstr "Nhưng mà, chắc ông tới đây không chỉ để giáo huấn việc nhà cho tôi nhỉ ?"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_e60fd24e"
msgid "C'est quoi le but de ta visite derrière ce prétexte bidon de vouloir mon bien ?"
msgstr "Cái lý do lồn cặc chó má gì đưa ông tới đây, không phải cái tựa ngoài về lo lắng cho sức khỏe tôi ?"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_603a5670"
msgid "...[w] Je suis pris dans une situation de merde, et j'ai besoin d'un second cerveau."
msgstr "...[w] Tôi đang bị vướng vào một tình cảnh khốn kiếp, và hai cái đầu thì tốt hơn một."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_517ed7fc"
msgid "Oh... Encore ?"
msgstr "Ờ... Nữa à ?"

#. Character:`saito`
msgctxt "home_kimochi_interior_f044b30a"
msgid "Hey !"
msgstr "Ơ kìa !"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_713a80f6"
msgid "Bah quoi... Depuis le peu de temps qu'on se connaît, tu es sans arrêt dans des galères pas possibles."
msgstr "Cái éo gì ? Từ lúc quen ông tới giờ, tôi thấy cứ như kiểu ông đi gây sự với cả thiên hạ ấy."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_30a30028"
msgid "J'y peux rien... Je reprends ma vie en main et ça ne plaît pas à tout le monde."
msgstr "Thì biết làm sao được... Tôi đang cố chèo lái cuộc sống của tôi, nhưng biển đời say \"Đéo\"."

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_abf07eb9"
msgid "Bon, vas-y je t'écoute..."
msgstr "Rồi rồi. Đang nghe đây..."

#. Character:`saito`
msgctxt "home_kimochi_interior_262ae9f8"
msgid "Il y a cette fille..."
msgstr "Thì có một cô gái này..."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_5ab17ab8"
msgid "{{yasuka.n}} ? Celle chez qui tu vis ?"
msgstr "{{yasuka.n}}? Cái cô mà ông sống cùng hả ?"

#. Character:`saito`
msgctxt "home_kimochi_interior_fa9410fb"
msgid "Mhh, non. Celle avec qui j-"
msgstr "Ờm không. Cái đứa mà-"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_8784b75b"
msgid "{{asami.n}} ?"
msgstr "{{asami.n}}?"

#. Character:`saito` | Attributes:`angry`
msgctxt "home_kimochi_interior_1bf01d57"
msgid "Non, bon sang, laisse-moi finir !"
msgstr "Đéo ! Để bố nói xong cái đã !"

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_interior_eb874472"
msgid "Mec, plus je t'écoute, et plus j'ai envie de t'étrangler. Tu te rends compte qu'il y a trop de femmes autour de toi ?"
msgstr "Cái lồn cặc thằng khốn kiếp. Biết không, càng nói chuyện tôi càng muốn vặn cổ ông. Ông có cảm thấy là ông đi gái gú HƠI nhiều quá không vậy ?!!"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_75d67872"
msgid "Tu veux pas en laisser un peu pour les autres ?"
msgstr "Sữa hộp cả thùng rồi còn anh em phải húp nước cống hả ?!!"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_df4af184"
msgid "Écoute-moi, jusqu'au bout et juge-moi après !"
msgstr "Ít nhất thì để bố nói xong trước khi phán xét bố cái !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_adaa2d53"
msgid "Okay..."
msgstr "Rồồồồi..."

#. Character:`saito`
msgctxt "home_kimochi_interior_aff8e874"
msgid "La fille avec qui je travaille au restaurant, {{sakuya.n}}."
msgstr "Đó là cô gái làm cùng tôi ở Quán Udon, {{sakuya.n}}."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_kimochi_interior_62870714"
msgid "Oh oui, je vois, la grande aux formes généreuses."
msgstr "À, ừ, hiểu rồi. Con cao cao và rất \"cong\"."

#. Character:`saito`
msgctxt "home_kimochi_interior_5c6250a9"
msgid "Et, totalement cinglée... Elle est complètement accro à moi pour je ne sais quelle raison, et..."
msgstr "Con đấy điên vãi... Không hiểu sao con bả đấy nó lại cuồng lên vì tôi, ông ạ..."

#. Character:`saito`
msgctxt "home_kimochi_interior_32dd0745"
msgid "Elle s'en prend à tous ceux qui pourraient me menacer ou qui s'approchent de moi."
msgstr "Cổ tấn công bất cứ ai đe dọa tôi, hay thậm chí chỉ là ở gần tôi."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_interior_ae979175"
msgid "Dis-moi que c'est une blague... ?!"
msgstr "Đây là joke đúng không... ?!"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_04f366c4"
msgid "Euh, non... c'est bien la vérité."
msgstr "Ờm, không... Thật đấy."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_79dec081"
msgid "Tu veux dire que la fille du restaurant est une Yandere ?"
msgstr "Ý ông bảo là cô con gái ở Quán Udon là một yandere á ?"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_a231e87f"
msgid "ET QU'EN PLUS ELLE EST À FOND SUR TOI ?!!"
msgstr "VÀ CÁI ĐỊT CON MẸ MÀY, NÓ BỊ CUỒNG MẦY CƠ Á ???!!!"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_b17d7657"
msgid "MAIS BORDEL, T'AS TROP DE CHANCE !!!"
msgstr "SÚC SINH VÃI CHẤY !!! MẦY CÓ CÁI ĐÉO GÌ ĐÂU MÀ SAO MẦY SÁT GÁI QUÁ VẬY !! ĐÉO CƯA CŨNG ĐỔ LÀ SAO !!!"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_db30caa6"
msgid "C'est l'achievement ultime du weeb !"
msgstr "ĐÂY LÀ GIẤC MƠ TỐI CMN THƯỢNG CỦA BẤT CỨ THẰNG WEABOO NÀO !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_a0da6b59"
msgid "La Yandere, c'est le top du top, la femme qui sera prête à tout pour toi, elle pourra même tuer pour toi pour les meilleures d'entre elles !"
msgstr "Yandere như tạo vật của Chúa ban cho nhân loại, để xử lý mấy đứa chơi bời như bay ! Hiện thân của Thần Chiến Tranh Ares và Thần Tình Yêu Aphrodite, người sẵn sàng sát, tự sát và cùng tự sát, vì người mình yêu !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_03e88772"
msgid "La petite amie parfaite !"
msgstr "Người bạn gái hoàn hảo ! Người vợ tuyệt không tì vết !"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_caad7c0c"
msgid "Elle menace mes proches."
msgstr "...Cô ấy đang đe dọa gia đình và người thân của tôi, ông biết đấy."

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_58103ca1"
msgid "Par proches, tu veux dire, les filles avec qui tu traînes ?"
msgstr "Người thân và gia đình ? Ý ông là cái dàn harem của ông đó hả ?"

#. Character:`saito`
msgctxt "home_kimochi_interior_3e85771d"
msgid "Oui..."
msgstr "Được đấy…"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_37a78df9"
msgid "Simple !"
msgstr "Thế thì dễ rồi !"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_kimochi_interior_8b5e8646"
msgid "Vraiment ?"
msgstr "Thật sao ?!"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_e9136b41"
msgid "Un jeu d'enfant."
msgstr "Dễ hơn trở bàn tay."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_kimochi_interior_8ae80e40"
msgid "J'écoute..."
msgstr "Kính cẩn nghiêng mình. Xin được chỉ giáo !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_a97fbea1"
msgid "Tu dois rompre avec toutes les femmes avec qui tu es un peu trop proche."
msgstr "Chia tay tất cả những đứa, người, con, cô, bà phụ nữ có chút tí gì rây tơ rễ má với ông."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_4af4f6b5"
msgid "Tu dois couper le contact avec toutes les femmes avec qui tu es un peu trop proche."
msgstr "Ông phải đá mọi đứa con gái mà có bám dính lấy ông hơi quá."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_64b27be6"
msgid "Te marier avec cette fille prête à tout pour ton bonheur."
msgstr "Lấy cô gái sẵn sàng vì ông mà xe cát Biển Đông này-"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_cdbbc4be"
msgid "Content d'avoir résolu ton problème[w], DEHORS !"
msgstr "Xong ! Rất vui vì đã giúp được ông.[w] BỐ GIỜ SÔI MÁU QUÁ, CÚT RA NGOÀI !"

#. Character:`saito`
msgctxt "home_kimochi_interior_15d5db41"
msgid "Tu veux bien m'aider ?"
msgstr "Liệu ông sẽ giúp tôi chứ ?"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_kimochi_interior_a69e2f2c"
msgid "... Je t'aiderai, mais faut que tu arrêtes de toutes les attraper !"
msgstr "... Tôi sẽ giúp ông, nhưng ông phải ngưng cái trò dân chài cá bằng lưới lại !"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_kimochi_interior_a59b2b94"
msgid "Je vais essayer !"
msgstr "Tôi sẽ cố !"

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_664a25c5"
msgid "Bon... Maintenant ça va pas te plaire."
msgstr "Rồi... Giờ, trước tiên, phải khẳng định là ông sẽ không hề thích điều này."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_26867542"
msgid "Mais, pour te sortir de cette situation, si tu tiens à {{asami.n}}, et je ne sais pas trop ce que tu fais avec {{yasuka.n}} d'ailleurs, mais passons sinon je vais encore m'énerver..."
msgstr "Nhưng mà để cứu ông thoát khỏi tình cảnh này... Nếu như ông thật sự chung thủy với {{asami.n}}... tôi thì đéo biết ông định làm gì với {{yasuka.n}} cả nhưng thôi bỏ mẹ đi không tôi lại... hừmmmphhh... sôi máu mất..."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_3c280fdb"
msgid "Tu vas devoir rompre..."
msgstr "Ông sẽ phải chia tay hai người bọn họ..."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_f44f648b"
msgid "Tu vas devoir mettre fin à cette amitié."
msgstr "Kết thúc cái tình bạn này."

#. Character:`saito` | Attributes:`angry`
msgctxt "home_kimochi_interior_637ce628"
msgid "..."
msgstr "..."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_be5d021d"
msgid "Temporairement !"
msgstr "Tam thời !"

#. Character:`saito` | Attributes:`upset`
msgctxt "NON_JE_REFUSE_DE_FAIRE_A_24C863"
msgid "Non ! Je refuse de faire ça !"
msgstr ""

#. Character:`saito`
msgctxt "J_AI_BESOIN_D_UNE_SOLUTION_POU_607529"
msgid "J’ai besoin d’une solution pour la rejeter sans qu’elle s’en prenne à moi ou à mes proches."
msgstr ""

#. Character:`kimochi`
msgctxt "BON_SANG_T_ES_BORN_MA_PAROLE_O_9C9792"
msgid "Bon sang, t’es borné, ma parole... On ne négocie pas avec ce genre de personne."
msgstr ""

#. Character:`kimochi`
msgctxt "COUTE_MOI_BIEN_SI_TU_CONTINUE_D29671"
msgid "Écoute-moi bien, si tu continues sur cette voie-là, tu vas le regretter toute ta vie."
msgstr ""

#. Character:`saito` | Attributes:`sad`
msgctxt "TU_EXAG_RES_4D4C41"
msgid "Tu exagères..."
msgstr ""

#. Character:`kimochi`
msgctxt "SAITO_N_S_IL_TE_PLA_T_JE_NE_D_E4D710"
msgid "{{saito.n}}, s’il te plaît, je ne dis pas ça pour t’embêter, mais la seule solution, à mon sens..."
msgstr ""

#. Character:`kimochi`
msgctxt "C_EST_DE_METTRE_FIN_TES_RELAT_C9A5DC"
msgid "... c’est de mettre fin à tes relations avec {{asami.n}} et {{yasuka.n}}."
msgstr ""

#. Character:`kimochi`
msgctxt "RANDOM_BADCHOICE_POUR_LEUR_S_62EBCD"
msgid "Pour leur sécurité !"
msgstr ""

#. Character:`kimochi` | Attributes:`sad`
msgctxt "PUTAIN_FAIS_PAS_LE_CON_5CDBF5"
msgid "Putain, fais pas le con !"
msgstr ""

#. Character:`saito` | Attributes:`upset`
msgctxt "JE_REGRETTE_MAIS_JE_REFUSE_QU_B13770"
msgid "Je regrette... Mais je refuse qu’on me dise ce que je dois faire parce que ça ne plaît pas à certains."
msgstr ""

#. Character:`saito`
msgctxt "JE_ME_REPRENDS_EN_MAIN_DEPUIS_9508FF"
msgid "Je me reprends en main depuis un certain temps, et ce n’est pas pour flancher à la première difficulté venue."
msgstr ""

#. Character:`kimochi`
msgctxt "EN_TH_ORIE_JE_DIRAIS_QUE_TU_AS_EBBD52"
msgid "En théorie, je dirais que tu as raison… Mais cette fille qui te menace se moque de tes bonnes intentions."
msgstr ""

#. Character:`saito` | Attributes:`happy`
msgctxt "DANS_CE_CAS_C_EST_MOI_DE_LUI_F_100BE3"
msgid "Dans ce cas, c’est à moi de lui faire comprendre."
msgstr ""

#. Character:`saito`
msgctxt "SI_ELLE_M_AIME_AUTANT_QU_ELLE_28CE4B"
msgid "Si elle m’aime autant qu’elle le prétend, elle devra accepter ma décision."
msgstr ""

#. Character:`kimochi`
msgctxt "TU_VIENS_JUSTE_DE_LEVER_UN_DE_A980DD"
msgid "... Tu viens juste de lever un death flag."
msgstr ""

#. Character:`saito` | Attributes:`happy`
msgctxt "AIE_CONFIANCE_149582"
msgid "Aie confiance !"
msgstr ""

#. Character:`kimochi`
msgctxt "IL_EST_FOUTU_1B500E"
msgid "Il est foutu..."
msgstr ""

#. Character:`narrator`
msgctxt "REFUSER_CAT_GORIQUEMENT_A5B9B8"
msgid "Refuser catégoriquement."
msgstr ""

#. Character:`narrator`
msgctxt "ACCEPTER_CONTREC_UR_CAA20D"
msgid "Accepter à contrecœur."
msgstr ""

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_4292221a"
msgid "C'est l'idée qui me semblait la plus plausible, mais..."
msgstr "Đó là một ý tưởng hay, thế nhưng, làm thế nào..."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_62ad24ae"
msgid "Rompre... Je ne sais même pas si je suis capable de leur faire ça..."
msgstr "Chia tay... Tôi còn chẳng biết liệu tôi có đủ lòng dạ... làm vậy được không..."

#. Character:`saito`
msgctxt "home_kimochi_interior_09e6caa8"
msgid "Et, j'ose même pas imaginer leurs réactions."
msgstr "Và tôi thì không dám tưởng tượng phản ứng của họ rồi."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_interior_fb9c7184"
msgid "Personne n'a dit que ce serait facile."
msgstr "Chẳng ai biểu rằng nó dễ cả."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_ede506f4"
msgid "Si réellement, elles sont menacées, tu ne dois pas hésiter."
msgstr "Nếu như mối nguy hiểm là thật, ông không được phép do dự."

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_ce00e208"
msgid "Écris aussi une lettre !"
msgstr "Và hãy viết một lá thư !"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_kimochi_interior_f0977c0e"
msgid "Une lettre ? T'es sûr de toi ?"
msgstr "Một lá thư ? Sao lại thư thiếc gì ở đây ?"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_dcff6fc5"
msgid "Oui ![w] Explique-leur la véritable raison de pourquoi tu as dû agir comme ça."
msgstr "Thư chứ ![w] Cái thư này là để cho họ tường tận ngọn ngành câu chuyện."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_a1658608"
msgid "C'est psychologique ! Avec une lettre, sur un ton désespéré, elles seront obligées de te pardonner !"
msgstr "Viết một bức thư đi kèm với tông giọng và văn phong thể hiện sự tuyệt vọng, tức tối, hối hận, và lũ con gái sẽ tha tội cho ông hết !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_be4ad848"
msgid "J'irai leur transmettre personnellement."
msgstr "Tôi sẽ chuyển thư giùm ông."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_7cf39973"
msgid "Et, pendant ce temps-là, je serais avec {{sakuya.n}} ?!"
msgstr "Và trong lúc đấy thì, tôi sẽ ở với {{sakuya.n}}?!"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_3632b27b"
msgid "Elle va vouloir te monopoliser, te garder rien que pour elle !"
msgstr "Cô ta sẽ chỉ muốn giữ ông cho riêng cổ !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_c27544fc"
msgid "Tu ne seras certainement plus libre de tes mouvements au début."
msgstr "Chắc chắn vào khoảng thời gian đầu là ông như cá chết lên bờ rồi này."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_d5a1b56b"
msgid "Comporte-toi comme si tout était normal, ne la considère jamais comme folle, tu dois gagner sa confiance, dès que tu verras une opportunité, il faudra la saisir !"
msgstr "Cứ giả vờ tâm tịnh giữa dòng đời vạn biến, coi như là cô ấy không điên. Phải chiếm được lòng tin của cô ấy, sau đó sẽ hành động !"

#. Character:`saito`
msgctxt "home_kimochi_interior_16e1e4b1"
msgid "Tu dis ça... Mais, en t'écoutant, j'ai l'impression que je ne reverrai pas la lumière du jour avant longtemps."
msgstr "Ông nói vậy chứ... Nghe ông nói thì, chắc tôi sẽ bay màu suốt mấy năm mất."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_interior_e4ef0027"
msgid "Ne plaisante jamais avec une Yandere, les sentiments qu'elle éprouve pour toi sont comme un tsunami."
msgstr "Đừng có đùa với yandere. Tình cảm của bả dành cho ông, lớn lao như sóng thần, cuồng nhiệt như bão tố."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_02c4910e"
msgid "Montre-toi fort et ne pleure pas, compris {{saito.n}} ?"
msgstr "Là đàn ông thì phải mạnh mẽ, và đừng có than vãn. RÕ CHƯA, THẰNG CHÓ {{saito.n}}?"

#. Character:`saito`
msgctxt "home_kimochi_interior_3f509e7a"
msgid "Okay... Maintenant, je suis terrifié."
msgstr "Dạ rồi... giờ con sợ tè cả ra quần."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_82253f0a"
msgid "Bien ! Parce que tu devrais l'être."
msgstr "Tốt ! Nên như thế."

#. Character:`centered`
msgctxt "home_kimochi_interior_08a0d45e"
msgid "{{saito.n}} rédigea les deux lettres sous les conseils de {{kimochi.n}}."
msgstr "{{saito.n}} nắn nót hai bức thư dưới sự chỉ giáo của \"thầy đồ {{kimochi.n}}\"."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_f648abee"
msgid "Je pense que c'est bon ! Surtout ne me fais pas faux-bond, il faut absolument que tu donnes ça à {{yasuka.n}} et {{asami.n}} !"
msgstr "Vậy chắc là rất ổn rồi ! Xin đừng làm tôi thất vọng. Ông phải chắc chắn là sẽ chuyển chúng tới {{yasuka.n}} và {{asami.n}} đấy nhé !"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "t96b7e2fdb8"
msgid "Pff, pour qui tu me prends ? S'il y a bien une personne à qui tu peux faire confiance ici, c'est moi !"
msgstr "Pff, mày nghĩ tao là ai ? Yên tâm, dù có chết tao cũng mang cái thơ được cho hai người đấy !"

#. Character:`saito`
msgctxt "home_kimochi_interior_58ef97aa"
msgid "Allez... Je vais y aller, souhaite-moi bonne chance !"
msgstr "Vậy thì... Tôi đi đây. Bảo trọng nhé bạn hiền !"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_kimochi_interior_2b47327e"
msgid "Merci pour tout, {{kimochi.n}}."
msgstr "Cảm ơn vì tất cả, {{kimochi.n}}."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_a40b2d93"
msgid "Bon courage, tu en auras besoin !"
msgstr "Chúc may mắn !"

#. Character:`saito` | Attributes:`neutral`
msgctxt "t9dd1e4c53f"
msgid "Oh ! Une dernière chose qui à son importance."
msgstr "À ! Một điều nữa quan trọng này."

#. Character:`saito`
msgctxt "tc1015f02e7"
msgid "Si jamais tu avis des problèmes."
msgstr "Nếu như ông có bất cứ rắc rối gì phát sinh."

#. Character:`saito` | Attributes:`happy`
msgctxt "t19c5ae680d"
msgid "J'ai une connaissance qui pourrait potentiellement te sortir de toute situation dangereuse."
msgstr "Tôi biết một người có thể helicopter ông khỏi những tình huống sinh tử đấy."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "t8c111f8bdd"
msgid "Vraiment ? Tu as ça dans tes amis ?"
msgstr "Thật sao ? Ông với người đó là bạn à ?"

#. Character:`saito`
msgctxt "t45f894b929"
msgid "{{macumba.n}}..."
msgstr "{{macumba.n}}..."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "te138e74969"
msgid "Pfff... On dirait une sorte d'incantation vaudoo."
msgstr "Pfff... Nghe như bùa chú hay phép niệm vậy."

#. Character:`saito` | Attributes:`happy`
msgctxt "taa6797e737"
msgid "Oui mais elle porte chance tu verras."
msgstr "ừ thì, tôi cứ quân sư thế cho ông cái đã."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_2a883952"
msgid "Bon... Il serait peut-être temps d'aller donner ça..."
msgstr "Chà.. Có lẽ tới lúc mình chuyển mấy bức thư này nhỉ..."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_7fc1e1c0"
msgid "Quoique, ça pourrait attendre demain..."
msgstr "Mà sao cũng được. Ngày mai chuyển cũng chẳng hại ại..."

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "home_kimochi_interior_b7d19a6f"
msgid "Non ! S'il l'apprend, je vais avoir des problèmes."
msgstr "Không ! Nếu như cái tên đấy phát hiện ra, mình ăn cứt là cái chắc."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_5332e375"
msgid "C'est juste un simple aller-retour !"
msgstr "Chỉ là đi đi về về một chuyến thôi mà !"

#. Character:`macumba`
msgctxt "home_kimochi_interior_9c25b228"
msgid "Petit frère, tu te sens mieux à présent ?"
msgstr "Người anh em, cậu đã thấy khá hơn chưa ?"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_524c16ee"
msgid "J'ai l'impression d'avoir été un chewing gum qui aurait été mâchouillé un peu trop longtemps."
msgstr "Tôi rã rời tay chân như viên sing-gum bị nhai lâu ngày."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_kimochi_interior_95f229ec"
msgid "Tout mon corps me fait mal..."
msgstr "Toàn thân tôi nhức buốt..."

#. Character:`macumba` | Attributes:`neutral`
msgctxt "home_kimochi_interior_f08a2ba1"
msgid "Avec quelques séances de sport, tu retrouveras rapidement toutes tes capacités."
msgstr "Thêm một vài buổi tập nữa là người anh em sẽ lấy lại được phong độ ngày nào."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_interior_d23784f1"
msgid "{{macumba.n}}... Sans vouloir te vexer, je n'ai pas trop la tête à faire des efforts physiques en ce moment."
msgstr "{{macumba.n}}... Không có ý gì đâu, nhưng, tôi thật sự không có tâm trạng để tập luyện vào lúc này."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_e1f7f6db"
msgid "Cet idiot de {{saito.n}} est en danger lui aussi, et la mission qu'il m'avait confié est un échec."
msgstr "Tên khốn {{saito.n}} đang gặp nguy hiểm. Và nhiệm vụ mà tên của nợ đó giao cho tôi đã thất bại."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_349a5020"
msgid "{{akira.n}}, cet enfoiré, s'il n'avait pas été là..."
msgstr "{{akira.n}}, thằng chết dẫm ấy. Ước chi nó đã không ở đấy..."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_9fa812d2"
msgid "Je suis certain qu'en ce moment, il doit bien se marrer..."
msgstr "Giờ chắc là nó đang hả hê lắm đấy nhỉ..."

#. Character:`macumba`
msgctxt "home_kimochi_interior_8b268ca7"
msgid "Il n'est jamais trop tard pour corriger ses erreurs."
msgstr "Sẽ không bao giờ là quá muộn để bắt đầu sửa sai."

#. Character:`macumba`
msgctxt "home_kimochi_interior_0a20e4ee"
msgid "Dis-moi ce que tu devais faire et je serais là pour t'épauler !"
msgstr "Hãy nói với tôi người anh em cần gì và tôi sẽ làm hết mức để có thể hỗ trợ !"

#. Character:`macumba` | Attributes:`upset`
msgctxt "home_kimochi_interior_b1a99678"
msgid "Je n'abandonnerai personne, ni toi, ni {{saito.n}}."
msgstr "I never gonna give you up. Never gonna give you down. Never gonna run around and dessert you: {{saito.n}}."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_d656c036"
msgid "Quel plaisir de te voir ici !"
msgstr "Thật là một \"vinh hạnh\" được đón tiếp ông !"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_3c0b9c50"
msgid "Je n'aurais jamais cru dire ça, mais quelque chose ne sent pas bon ici."
msgstr "Thật có khi tôi nhiễm tính ông hay sao ấy, chứ có gì đó khả nghi lắm."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_kimochi_interior_08e1664b"
msgid "Réalises-tu seulement le pétrin dans lequel tu m'as mis ?"
msgstr "Thật ông có biết tôi khổ vì ông tới mức nào không ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_eff60229"
msgid "Honnêtement... Je n'en ai aucune idée."
msgstr "Nói thật thì.... Tôi không biết."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_interior_3ef4e674"
msgid "J'étais en train de livrer ces foutues lettres quand ces brutes m'ont agressé."
msgstr "Liên lạc viên này đây bị mấy đứa chúng nó làm gỏi ngay lúc quan trọng."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_5ed797bf"
msgid "Ils m'ont emmené à cette gare abandonnée et m'ont battu sauvagement."
msgstr "Bắt sống, băm vằm, cán mỏng, buộc lạt, et voilà ! Ngon miệng."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_interior_c713680f"
msgid "Ton ancien meilleur ami, {{minato.n}}, voulait ma peau."
msgstr "Thằng bạn nối khố của ông, {{minato.n}}, có sở thích xiên chả và hạ thổ tôi."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_interior_52dc94de"
msgid "Si {{macumba.n}} n'était pas intervenu, je serais mort à l'heure qu'il est."
msgstr "Bữa nớ {{macumba.n}} mà không tới là tôi lên bàn thờ ăn chuối cả nải rồi đấy."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_e0ea21c4"
msgid "Je... Je suis désolé pour ce qui t'est arrivé. Ce {{minato.n}} va payer."
msgstr "Thật lòng... tạ tội vì những gì ông đã phải trải qua. Để tôi đi moi tim thằng {{minato.n}} ấy cúng ông nhé !"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_78b7b925"
msgid "Donc tu admets que j'ai subi un préjudice moral ?"
msgstr "Ờ rồi đó. Thấy tôi vì ông mà trầm cảm thấy mẹ chưa ?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_kimochi_interior_c0a39add"
msgid "Évidemment, mais...[w] Attends, tu veux quoi en échange ?"
msgstr "Hiểu mà... Nhưng... [w] Cái giá phải trả là gì đây ?"

#. Character:`kimochi` | Attributes:`-happy`
msgctxt "home_kimochi_interior_65be43ca"
msgid "Que tu me présentes à ta sœur !"
msgstr "Giới thiệu tôi với con em của ông đi !"

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_kimochi_interior_b4e69ca9"
msgid "..."
msgstr "..."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_759336cd"
msgid "Arrête de jouer les innocents !"
msgstr "Hộp không có sữa đúng không ? Chia anh em cái !"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_f14cac0a"
msgid "{{noriko.n}} n'est PAS ma sœur."
msgstr "{{noriko.n}} KHÔNG phải là em tôi."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_a305901c"
msgid "Vous vivez sous le même toit depuis des années, mais si tu veux jouer à ça, libre à toi."
msgstr "Sống với nhau từ thời mu còn trắng muốt mà lại... Ừ nhưng rồi ông thích thế thì ok."

#. Character:`saito`
msgctxt "home_kimochi_interior_26ee8ac1"
msgid "...[w] Je préfère qu'elle t'évite, franchement."
msgstr "...[w] Nói thật thì con bé tránh tiếp xúc với ông thì tốt hơn."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_kimochi_interior_6fca5325"
msgid "Elle est sûrement Tsundere. Elle finira par montrer son côté doux."
msgstr "Thế này đích thị là tsundere rồi. Mưa dầm thấm lâu mà thôi."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_4d827c60"
msgid "Arrête tes délires !"
msgstr "Bớt xàm loằn lại con !"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_interior_15f9bdab"
msgid "Je te jure que je suis sérieux !"
msgstr "Nghiêm túc, hứa luôn !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_147790a9"
msgid "C'est une vraie typologie des comportements, tu sais."
msgstr "Khoa học đã công nhận ấy là một trạng thái tâm sinh lý hẳn hoi đấy, biết chửa ?"

#. Character:`saito`
msgctxt "home_kimochi_interior_c50dac3b"
msgid "... C'est carrément glauque."
msgstr "...Ghê thấy bà."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_kimochi_interior_49b9b817"
msgid "Je peux essayer de te présenter {{noriko.n}}, mais c'est tout."
msgstr "Thông quan ải {{noriko.n}}, thì chắc tôi có thể, nhưng vào rồi phải tự thân vận động đấy."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_kimochi_interior_1935d7be"
msgid "Je ferais n'importe quoi pour elle."
msgstr "Nàng có bắt tôi nhảy lửa cũng được tuốt."

#. Character:`saito`
msgctxt "home_kimochi_interior_d3df0ba5"
msgid "Et {{chiaki.n}} ? Tu l'oublies comme ça ?"
msgstr "Thế còn {{chiaki.n}} thì sao ? Bộ ông quên ẻm rồi à ?"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_interior_0b4a26fe"
msgid "Jamais ! Elle occupe toujours mes pensées."
msgstr "Không đời nào ! Ẻm cắm rễ trong tâm trí tôi luôn."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_interior_8cd61774"
msgid "Mais elle m'ignore, tout le temps !"
msgstr "Nhưng ẻm cứ lờ lớ lơ tôi hoài !"

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_kimochi_interior_a243951a"
msgid "{{noriko.n}} par contre... Elle entre en confrontation... Elle pourrait me piétiner et..."
msgstr "{{noriko.n}}. Ẻm mạnh bạo... Ẻm có thể step on me và..."

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_kimochi_interior_d86902ef"
msgid "Okay je crois que j'en ai assez entendu... Je verrai ce que je peux faire."
msgstr "Ok ok, bạn hiền. Để tôi xem xem thế nào."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_f214d982"
msgid "T'es un frère !"
msgstr "Đúng là anh em chí cốt !"

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_6ea32d5a"
msgid "Bref... Pourquoi tu cherchais à me voir ?"
msgstr "Dẹp cơn nứng qua một bên... Thế giờ cơn gió nào đưa ông tới đây ?"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_d5e2bd56"
msgid "L'entrée du dojo était bloquée ce matin. Je pensais simplement passer le temps avant d'y retourner."
msgstr "Đường tới Võ Đường hôm nay của tôi cắm ba cái chông dính cứt. Thế là tôi lại chạy qua đây."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_065458c7"
msgid "Je ne veux pas te démoraliser mais... Tu peux faire une croix sur le dojo."
msgstr "Hết cứu luôn... Ông có thể quên cái Võ Đường đó đi được rồi đấy."

#. Character:`saito`
msgctxt "home_kimochi_interior_ad2e0581"
msgid "Je vais avoir besoin de plus d'explications que ça."
msgstr "Luận điểm cần thêm chút sức mạnh nha."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_interior_5e108ea7"
msgid "Depuis que le nouveau propriétaire a repris le dojo, ils ne prennent que des gros bras."
msgstr "Kể từ khi tên chủ mới tiếp quản cái Võ Đường, bọn họ chỉ toàn thu nạp mấy đứa rất gì và này nọ."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_9432d85a"
msgid "Ils sélectionnent tous leurs nouveaux élèves."
msgstr "Toàn bộ tân \"võ sĩ\" chúng nó lựa như lựa người mẫu ý."

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_kimochi_interior_9e4c2570"
msgid "Mais... Pourquoi ? Ça n'a pas de sens !"
msgstr "Sao... lại vậy ? Ai ai cũng phải được vào chứ !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_8ed4a491"
msgid "Ce n'est pas que ça n'a pas de sens, c'est qu'on ignore encore leur motivation."
msgstr "Không vô lý đâu, chỉ là hiện tại chúng ta chẳng biết trong nớ đang âm mưu gì."

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_29339261"
msgid "Il y a toujours une raison à tout."
msgstr "Mọi sự đều có nguyên do của nó."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_8fe5175e"
msgid "Demande-toi toujours, à qui profite le crime ?"
msgstr "Cứ thử nghĩ coi, tội phạm thì cần nhất cái gì ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_2bc7d297"
msgid "Mhhh..."
msgstr "Mhhh..."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_42199c1b"
msgid "Je dois quand même essayer, quoi qu'il en coûte ! La rentrée risque d'être une véritable galère sinon."
msgstr "Sao cũng được ! Có thân tàn ma dại tôi cũng phải lê bước vào được Võ Đường. Bằng không thì lên đại học thì tôi đội mả mất."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_847dc98f"
msgid "Va constater par toi-même... Ils seront là toute la journée."
msgstr "Cá với ông là bọn nó cắm rễ ở đấy nguyên ngày cho coi."

#. Character:`saito`
msgctxt "home_kimochi_interior_f8dbd7ac"
msgid "Je suis sûr qu'ils vont se lasser et seront partis."
msgstr "Cược ngược lại với ông luôn."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_b8811c82"
msgid "... Tu vis dans le déni mon pauvre {{saito.n}}."
msgstr "... Thật đáng thương quá đi, {{saito.n}} thơ ngây của tôi."

#. Character:`saito`
msgctxt "home_kimochi_interior_6e66d5de"
msgid "Mais... Il s'est passé quoi ici ?"
msgstr "Thế... Ở đây có gì vui à ?"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_7896b311"
msgid "Finalement j'ai écouté ton conseil."
msgstr "Cuối cùng thì tôi cũng nghe ông."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_f618b23f"
msgid "J'avais besoin de faire un peu de place au cas où..."
msgstr "Tui dẹp bớt chút đồ để cho gọn..."

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_kimochi_interior_6cd0a2a3"
msgid "Au cas où quoi ? Où tu ramènerais une fille chez toi ?"
msgstr "Gọn để làm chi ? Dắt gái về à ?"

#. Character:`asami`
msgctxt "home_kimochi_interior_ae5f920c"
msgid "Pas avec cette attitude si tu veux mon avis."
msgstr "Lão thì còn khướt đi, đấy là tôi nghĩ vậy."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_interior_1c71c229"
msgid "Je t'ai pas demandé ton avis toi !"
msgstr "Ai hỏi cô ?!"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_kimochi_interior_1b333e47"
msgid "Et toi dis quelque chose, dis-nous ce que tu as appris !"
msgstr "Kìa ông, tiết lộ những gì ông biết đi !"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_kimochi_interior_f247f77b"
msgid "Vas-y doucement... Il s'est disputé avec elle ce matin et il ne s'en est pas remis !"
msgstr "Từ tốn với ông ấy thôi lão... Ổng vừa choảng nhau to với em ấy, và ông ấy cần thời gian để vượt qua !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_d0c03460"
msgid "... Désolé {{saito.n}}. Je suis sûr que... que ça a dû être un moment désagréable."
msgstr "... {{saito.n}}., tôi chắc chắn rằng ông đã phải kinh qua một quãng thời gian kinh khủng."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_9b3489df"
msgid "On sait que tu fais de ton mieux pour arranger cette situation."
msgstr "Cả tôi và cổ đều biết ông đã rất cố gắng rồi."

#. Character:`asami`
msgctxt "home_kimochi_interior_75cfcb9f"
msgid "Oui {{noriko.n}} n'est pas facile à vivre..."
msgstr "Ừm, {{noriko.n}} thì đúng là có hơi khó ở thật..."

#. Character:`asami`
msgctxt "home_kimochi_interior_bde94418"
msgid "Mais je suis certaine que tu arriveras à faire en sorte qu'elle s'ouvre a toi."
msgstr "Nhưng tui tin rằng con bé sẽ mở lòng với ông thôi."

#. Character:`asami`
msgctxt "home_kimochi_interior_6674a628"
msgid "Tout ce dont elle a besoin c'est beaucoup d'amour."
msgstr "Chúng ta chỉ cần tặng cô bé thật nhiều yêu thương."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_cdac8034"
msgid "Je veux bien m'en occuper."
msgstr "Cứ để tôi lo việc đó cho."

#. Character:`asami`
msgctxt "home_kimochi_interior_220c77e4"
msgid "{{saito.n}} se débrouillera très bien sans toi."
msgstr "{{saito.n}} đếch cần ông chĩa mũi vào."

#. Character:`asami`
msgctxt "home_kimochi_interior_7ad70a93"
msgid "N'est-ce pas ?"
msgstr "... Đúng chứ ạ ?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_kimochi_interior_f67f064f"
msgid "Je... Oui ! Je ferai de mon mieux !"
msgstr "Ơm... Phải, tôi sẽ cố gắng hết mình !"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_fceece73"
msgid "C'est juste que certaines choses que j'ai apprises m'ont quelque peu..."
msgstr "Chỉ là... có một vài điều mà tôi đã tìm hiểu được, có hơi..."

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_85cb0521"
msgid "Des problèmes en vue ?"
msgstr "Có điềm đúng không ?"

#. Character:`saito`
msgctxt "home_kimochi_interior_a5a3d81d"
msgid "Oui...[w] J'ai vu {{noriko.n}} avec les thugs..."
msgstr "Có thật...[w] Tôi gặp {{noriko.n}} đi giao du với đám côn đồ..."

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_interior_ed821f9d"
msgid "... Oh ![w] Je vois, je vois, ça devait être difficile à voir, je comprends..."
msgstr "...Oh [w] Hiểu rồi, hiểu rồi. Một khung cảnh rất nặng nề, tôi hiểu chứ..."

#. Character:`asami` | Attributes:`upset`
msgctxt "home_kimochi_interior_b1fa10c9"
msgid "Arrête d'imaginer des choses, qu'est ce que t'a compris exactement ?"
msgstr "Về với Trái Đất coi ! Các ông thần giao cách cảm xong thì hiểu được gì vậy ?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_184ff453"
msgid "Qu'il... qu'il s'est fait NTR !"
msgstr "Ông ấy... Ông ấy bị NTR !"

#. Character:`asami` | Attributes:`pouting`
msgctxt "home_kimochi_interior_7cab5c0b"
msgid "Mais de quoi tu parles exactement ?"
msgstr "Tui không hiểu ? Ông nói gì vậy ?"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_c02fa708"
msgid "Je suis content que tu me poses la question. Alors le NTR c'est..."
msgstr "Mừng vì cô đã hỏi. Thế giờ này, NTR là..."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_e8d838cf"
msgid "Ça suffit... Ce que j'ai vu c'est {{noriko.n}} qui demandait à ces enfoirés de me casser la gueule."
msgstr "Thôi thôi... Túm lại thì, {{noriko.n}} đã nhờ đám côn đồ đấy tấn công tôi."

#. Character:`saito`
msgctxt "home_kimochi_interior_f4a11dea"
msgid "Et visiblement ce n'est pas la première fois et cela dure depuis longtemps..."
msgstr "Và có vẻ là, đây không phải lần đầu tiên, mà con bé đã giáp mặt tụi này từ rất lâu về trước rồi..."

#. Character:`saito`
msgctxt "home_kimochi_interior_fb43248e"
msgid "Elle a même été jusqu'à payer pour ça !"
msgstr "Con bé còn trả tiền cho từng củ hành tôi được bón cơ !!"

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "home_kimochi_interior_e6d267d3"
msgid "Donc tout ce temps où ces mecs te tombaient dessus c'était jamais véritablement le hasard ?"
msgstr "Vậy ý ông là, từ trước tới nay, mấy tên đó hành xác ông không chỉ là vì ngẫu nhiên thôi ?"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_747e5b17"
msgid "C'était prémédité ?"
msgstr "Mà thay vào đó, là những hành động có chủ đích ?"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_kimochi_interior_3f3d20d2"
msgid "Merde alors..."
msgstr "Bà nội thật đấy..."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_kimochi_interior_3da9457d"
msgid "Mon amour tu es sûr de toi ? Elle n'était pas sous l'influence d'une menace ou d'autre chose qui pourrait..."
msgstr "Ông yêu ơi, ông có chắc không ? Tui thiết nghĩ em ấy đâu có phải chịu hay bị ai áp lực đâu..."

#. Character:`saito`
msgctxt "home_kimochi_interior_e2b172cf"
msgid "J'aurais préféré mais non... {{noriko.n}} a des fréquentations dont j'ignorais l'existence."
msgstr "Tôi thì hy vọng vậy, nhưng không... hiện thời {{noriko.n}} giao du với nhiều thể loại mà tôi chưa từng tưởng tượng được."

#. Character:`asami`
msgctxt "home_kimochi_interior_108b4f5a"
msgid "Mais ça n'a pas de sens, pourquoi irait-elle jusqu'à payer pour t'infliger ça ?"
msgstr "Nhưng mà thật sự đấy. Tại sao , con bé sẵn sàng trả tiền để cử người tới tấn công ông vậy ?"

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_kimochi_interior_aa727a5c"
msgid "Même moi qui ai des goûts particuliers... Cette façon de faire est bien trop hardcore pour moi."
msgstr "Ngay cả đối với tôi thì... Phương cách cũng quá là hardcore rồi."

#. Character:`asami`
msgctxt "home_kimochi_interior_eaf0a070"
msgid "C'est à cause de ça que vous vous disputiez tout à l'heure ?"
msgstr "Có phải vì vấn đề đấy mà hai người nổ súng với nhau ihông ?"

#. Character:`asami`
msgctxt "home_kimochi_interior_a0a7bd11"
msgid "Comment a-t-elle réagi ?"
msgstr "Em ấy phản ứng thế nào ?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_kimochi_interior_6aa11208"
msgid "Elle... Elle a réussi a détourner mon attention en changeant de sujet."
msgstr "Con bé... Con bé khéo léo thay đổi chủ đề nhằm... điều hướng sự chú ý của tôi."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_kimochi_interior_42410ecd"
msgid "Oui... elles sont douées pour ça."
msgstr "Hiểu... Phụ nữ rất giỏi khoản đó mà."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_e8caf5be"
msgid "Je ne sais pas trop... Plus j'en découvre, moins j'ai envie d'en savoir."
msgstr "Càng cố gắng tìm hiểu, tôi càng ước chi tôi đã biết ít hơn."

#. Character:`saito`
msgctxt "home_kimochi_interior_88b284b4"
msgid "Et il y a cette réponse qu'elle doit donner à {{akira.n}} d'ici quelques jours."
msgstr "Và còn có một lần gặp mặt với {{akira.n}} trong vài ngày tới nữa kia."

#. Character:`saito`
msgctxt "home_kimochi_interior_5b8e8295"
msgid "On n'a aucune idée de quoi il s'agit"
msgstr "Tôi chẳng biết nên hiểu cái của đó thế nào."

#. Character:`asami` | Attributes:`upset`
msgctxt "home_kimochi_interior_0cd53d1e"
msgid "Donc si on résume... {{noriko.n}} a un lien avec {{akira.n}} et les thugs. Mais il ne s'agit probablement pas du même lien."
msgstr "Vậy thì tổng hợp lại... {{noriko.n}} có liên kết với {{akira.n}} và đám côn đồ. Nhưng có vẻ là con bé không có cùng mối liên kết với cả hai."

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_b8b46011"
msgid "De toute façon je vois mal {{akira.n}} se faire payer pour casser la gueule à quelqu'un, il est plutôt sur un alignement chaotique, il fait ce qui lui plaît."
msgstr "Theo tôi thì, {{akira.n}} sẽ chẳng bao giờ đi đâm thuê chém mướn đâu. Nó có tính cách nổi loạn hơn nhiều, thích làm gì thì làm."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_a1b893f6"
msgid "Mais du coup, les thugs sont venus pour te..."
msgstr "Thế rồi, còn đám côn đồ..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_kimochi_interior_284d9a01"
msgid "Oui, c'est {{nobu.n}} qui est venu me chercher devant chez moi. Mais c'est de loin le plus facile à gérer."
msgstr "Có {{nobu.n}} là đứa tới chốt trước cửa nhà tôi, nhưng nó lại là đứa dễ nhất để xử lý."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_kimochi_interior_4fdce7c1"
msgid "Bah mon vieux... T'es vraiment dans la merde cette fois-ci."
msgstr "Ông bạn già của tôi ơi... Lần này ông ăn cức thật rồi đấy."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_8225e90e"
msgid "Tu veux pas qu'on appelle {{macumba.n}} et qu'il nous débarrasse de ces connards une bonne fois pour toutes ?"
msgstr "Ông bạn có muốn bọn tôi triệu hồi chiến thần {{macumba.n}} ra đồ sát lũ chúng nó không ?"

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_kimochi_interior_9975ae09"
msgid "Non, on ne pourra pas toujours compter sur lui à chaque fois qu'on a des problèmes."
msgstr "Không được, không thể lúc nào khó khăn cũng nhờ tới anh ấy."

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_kimochi_interior_6ed716bf"
msgid "À quoi servent les amis dans ce cas ?"
msgstr "Thế bạn bè thì để làm gì vậy hả ?"

#. Character:`saito`
msgctxt "home_kimochi_interior_03775ec8"
msgid "..."
msgstr "..."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_kimochi_interior_edcf0e3b"
msgid "Mon amour, je sais que tu as envie de tout régler par toi-même et c'est cette part de toi qui fait que je te trouve irrésistible."
msgstr "Ông bạn yêu, tui biết là ông muốn tự lo mọi sự, và tui thật sự rất mê cái tính ấy của ông."

#. Character:`asami`
msgctxt "home_kimochi_interior_71e212d4"
msgid "Mais même si ça me fait mal de l'admettre {{kimochi.n}} a probablement raison."
msgstr "Nhưng mà nói đi cũng phải nói lại, {{kimochi.n}} nói đúng đấy."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_24b59e03"
msgid "AAAh ! Tu vois, écoute un peu la voix de la raison !"
msgstr "Đó, thấy chưa ?! Dùng cái đầu một chút đi coi !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_d2b985d8"
msgid "Et au pire, si tu veux pas faire appel à notre bro, tu peux lâcher sur eux ta yandere."
msgstr "Vả lại, ông còn có con yandere của ông làm át chủ bài kia mà."

#. Character:`asami` | Attributes:`upset`
msgctxt "home_kimochi_interior_ad2fc891"
msgid "Elle s'appelle {{sakuya.n}} !"
msgstr "Tên bạn ấy là {{sakuya.n}}!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_kimochi_interior_479d95e8"
msgid "Le résultat serait pire, elle serait capable de les tuer."
msgstr "Càng không, bà ấy có thể lia dao chết tươi tất cả chúng nó ."

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_ebccc2a6"
msgid "Pire ? Tu fais d'une pierre 5 coups, tu te débarrasses des trois thugs, d'{{akira.n}} et elle termine en prison."
msgstr "Sao lại không ? Một mũi tên trúng hai đích luôn. 3 thằng chó chết và {{akira.n}} của ông thì thăng thiên, còn cô ta thì vào nhà đá."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_56fe8b7f"
msgid "Un seul mouvement et tu obtiens ta tranquillité."
msgstr "Bước một bước là tới với tự do."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_938d41b4"
msgid "Bon je vais prendre l'air, je crois que j'ai assez entendu d'idées loufoques pour aujourd'hui."
msgstr "Thôi, tôi đi ra ngoài hóng gió chút đây. Ngày hôm nay tôi phải xử lý nhiều cái điên rồ quá rồi."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_7becdb27"
msgid "... bah quoi ?"
msgstr "... Sao nào ?"

#. Character:`asami` | Attributes:`upset`
msgctxt "home_kimochi_interior_16cc9b50"
msgid "Ce que tu peux être idiot parfois."
msgstr "Có đôi lúc lão đần tới nỗi tui chẳng hiểu nổi."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_5df5c407"
msgid "Au contraire, je lui propose deux alternatives : une qui est acceptable, l'autre qui ne l'est pas."
msgstr "Kẻ đần này đã hiến kế cho ông ta hai phương án, một cái nghe được còn môt cái không."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_af5efb8d"
msgid "Il se dira que la première est la plus viable et il arrêtera de se torturer l'esprit."
msgstr "Cá tiền là lão ta sẽ chọn phương án bớt hardcore hơn luôn, cho đỡ mệt đầu."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_8e069fd1"
msgid "Et tu pourras arrêter de t'inquiéter pour lui... {{macumba.n}} peut tout résoudre rien qu'avec son sourire et sa bonne humeur alors imagine quand il se sert de ses poings."
msgstr "Và cô cũng chẳng cần lo cho ông ta... Chỉ cần tấm lòng vàng và quả đấm thép là {{macumba.n}} có thể ủi hết mọi trở ngại lớn nhỏ đến đâu."

#. Character:`asami` | Attributes:`sad`
msgctxt "home_kimochi_interior_bfcd5592"
msgid "Mais ça ne résoudra pas le problème de {{saito.n}} et {{noriko.n}}..."
msgstr "Thế nhưng còn vấn đề giữa ông {{saito.n}} và em {{noriko.n}} nữa..."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_e6c7122c"
msgid "Chaque chose en son temps."
msgstr "Rồi cũng giải quyết được."

#. Character:`asami` | Attributes:`upset`
msgctxt "home_kimochi_interior_01258fd3"
msgid "... Je suis pas certaine d'apprécier ta façon de manipuler l'homme que j'aime."
msgstr "...Tui thật chẳng ưa chút nào cái cách lão đang thao túng người tui yêu."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_f46ad701"
msgid "Il me remerciera plus tard..."
msgstr "Khi nó tỉnh ra thì nó sẽ cảm tạ..."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_9d88b958"
msgid "Je ne suis pas l'ami qu'il voudrait... mais celui dont il a besoin."
msgstr "Có thể tôi không phải người bạn nó muốn... nhưng tôi là người thầy nó cần."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_d8f3aa65"
msgid "Putain {{saito.n}} pourquoi tu m'as pas dit que tu étais accompagné enfoiré!!"
msgstr "Ơ đuỵt thằng chó {{saito.n}} ! Sao mày không bảo tao có người đẹp giáng lâm ?!"

#. Character:`noriko` | Attributes:`bad`
msgctxt "home_kimochi_interior_c82f04c1"
msgid "Bah alors tête de bite, on a pas eu le temps de cacher ses vieux mouchoirs qui traînent ?"
msgstr "Kìa, tên đầu cắt moi, chưa kịp giấu đống giấy lộn của mày hở ?"

#. Character:`noriko`
msgctxt "home_kimochi_interior_3f4c2d4a"
msgid "C'est dingue à quel point tous les mecs peuvent s'enrhumer ces jours ci !"
msgstr "Chẳng hiểu sao dạo này thằng con trai nào cũng mắc cảm cúm suốt !"

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_kimochi_interior_859dc21e"
msgid "..."
msgstr "..."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_interior_c3f25454"
msgid "[font_size=14]Je vais te tuer {{saito.n}}.[/font_size]"
msgstr "[font_size=14]Mẹ mày, cẩn thận cái đuýt mày đấy, {{saito.n}}.[/font_size]"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_kimochi_interior_8e5a14c3"
msgid "Abrège... Tu ne vas rien tuer du tout."
msgstr "Phủi phui cái mồm đi.... Mày sẽ không giết ai hết."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_kimochi_interior_fd5f781d"
msgid "Ouch... Je te pardonne parce que tu es plutôt mignonne."
msgstr "Tiểu thư... Được tha thứ vì quá đáng yêu."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_interior_cc8c82cc"
msgid "Mais à toi je te pardonnerais pas !"
msgstr "Còn MÀY ý, thứ... chết dẫm nhà mày chứ !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_a32ddae5"
msgid "Tu réalises dans quel pétrin tu m'as mis ?"
msgstr "mày biết vì mày mà tao... khốn đốn thế nào không hả ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_1bacecad"
msgid "Honnêtement j'en ai pas la moindre idée."
msgstr "Ờ thì, nói thật tôi có biết đâu."

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_kimochi_interior_3b37c302"
msgid "C'est quoi cette histoire ?! Je veux savoir."
msgstr "Chuyện gì đấy ?! Mày phải kể tao nghe với."

#. Character:`saito`
msgctxt "home_kimochi_interior_536be9bd"
msgid "Rien... C'est juste un peu long à expliquer."
msgstr "Không... Biên niên sử dài tập ấy mà."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_7eef8921"
msgid "Oh mais t'en fais pas, je vais résumer pour toi."
msgstr "Vậy để thần tóm tắt lại cho tiểu thư nghe."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_d0d75dff"
msgid "Je faisais une course pour notre cher {{saito.n}} quand les thugs me sont tombés dessus et m'ont attaché dans la gare abandonnée."
msgstr "Thì chẳng là thần đây, đang đi chạy việc vặt cho dũng sĩ {{saito.n}} yêu quý, thì ba tên âm binh ngoài kia túm được thần rồi Hành Trình Kỳ Diệu, như Ông Bụt Bard, thần tới Ga Tàu Bỏ Hoang."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_304c4f68"
msgid "Son ancien meilleur ami {{minato.n}} voulait ma peau."
msgstr "Thằng bạn nối khố cũ của dũng sĩ, quỷ thần {{minato.n}}, muốn lột da thần."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_fab8b2b5"
msgid "Si {{macumba.n}} avait pas été là, je serais mort."
msgstr "Lỡ bữa đó, chiến thánh {{macumba.n}} không tới, là giờ mộ thần xanh cỏ rồi."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_df740dcb"
msgid "J'ai subi un prejudice moral par ta faute, j'exige un dédommagement."
msgstr "Mày nghe rồi đấy, tao chết lên sống lại vì mày đấy. Đền bù cho tao mau."

#. Character:`saito`
msgctxt "home_kimochi_interior_0b359f03"
msgid "...Je suis désolé qu-"
msgstr "... Tao xin lỗi mừ-"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_kimochi_interior_1b953518"
msgid "Non, il est pas désolé!"
msgstr "Không, không phải xin lỗi gì hết !"

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "home_kimochi_interior_69f683d3"
msgid "Quoi ?!"
msgstr "Hở ?!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_kimochi_interior_b8b42645"
msgid "Quoi ?!"
msgstr "Oát đờ ?!"

#. Character:`noriko`
msgctxt "home_kimochi_interior_7cb7b9f7"
msgid "Quel rapport ça a avec lui ?"
msgstr "Tao chưa hiểu là thằng chó này có liên quan gì ?"

#. Character:`noriko`
msgctxt "home_kimochi_interior_88525e2c"
msgid "J'ai toujours senti que ce type était ultra louche mais ça n'a rien a voir avec {{saito.n}}."
msgstr "Tao biết là thằng cha ấy rất khả nghi, nhưng tao chẳng thấy {{saito.n}} có liên quan gì."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_kimochi_interior_17134f76"
msgid "Une seconde je-"
msgstr "Gượm cái đã`"

#. Character:`noriko` | Attributes:`bad`
msgctxt "home_kimochi_interior_4b67f07e"
msgid "Tu t'es fait attrapé et kidnappé c'est bien ce que tu sous-entends ?"
msgstr "Thế giờ tức là mày bị tóm gọn và bị bắt cóc, đúng không ?"

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "home_kimochi_interior_98b1069b"
msgid "Exactement !"
msgstr "Đích xác !"

#. Character:`noriko`
msgctxt "home_kimochi_interior_0c8c44b4"
msgid "Donc tu étais où et qu'est ce que tu faisais à ce moment là ?"
msgstr "Thế giờ thì, mày đang ở đâu và mày đang làm gì lúc ấy ?"

#. Character:`kimochi` | Attributes:`sad`
msgctxt "home_kimochi_interior_54eb9e22"
msgid "...[w] Mais... ça n'a pas de... Il est... Je veux dire."
msgstr "...[w] Nhưng.... Không phải... Thằng đấy nó... Ờm..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_kimochi_interior_911c94f3"
msgid "Tu faisais quoi à ce moment là ?"
msgstr "Lúc đấy mày đang làm gì ?"

#. Character:`kimochi`
msgctxt "t98e4cd7b3a"
msgid "Rien de particulier, je me baladais dans le quartier quand..."
msgstr "Cũng chẳng có mấy, tao chỉ đang đi dạo linh tinh thì..."

#. Character:`noriko`
msgctxt "tc83a8ed316"
msgid "Traduction, tu étais a un endroit ou tu ne devais pas être !"
msgstr "Tóm cái váy lại, mày ở một chỗ mà đúng ra mày không nên tới !"

#. Character:`saito`
msgctxt "t8b0606b105"
msgid "Oh le con ! Tu étais devant chez {{minato.n}} c'est ça ?!"
msgstr "Mẹ thằng điên ! Mày tới chỗ {{minato.n}} đúng không ?!"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "t939abaafa7"
msgid "Purée mais comment vous faites pour..."
msgstr "Con mẹ, sao mày lại...."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_531ceaae"
msgid "Me dis pas que tu traînais encore devant chez lui pour observer {{chiaki.n}} ?!"
msgstr "Đừng bảo tao là mày cứ canh me ngoài nhà thằng nớ để gặp được {{chiaki.n}} nhá ?"

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "home_kimochi_interior_a7c13626"
msgid "Ça se pourrait bien..."
msgstr "Có thể, là như vậy..."

#. Character:`saito`
msgctxt "home_kimochi_interior_4f99a787"
msgid "Putain c'est pas vrai..."
msgstr "Đúng thật là chẳng sai nhỉ..."

#. Character:`noriko`
msgctxt "home_kimochi_interior_e0462994"
msgid "Donc si je résume, tu savais que tu risquais gros, mais tu y es quand même allé, tu t'es fais avoir et a présent tu en rejette la faute sur {{saito.n}} ? J'ai bien résumé."
msgstr "Thế giờ tóm tắt lại này, mày biết là nơi ấy nguy hiểm, và mày vẫn đến, bị giã thành giả cầy bảy món, và giờ tính đổ trách nhiệm lên đầu {{saito.n}}, đsung không nào ?"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_582ae38d"
msgid "Oui..."
msgstr "Ừm…"

#. Character:`noriko`
msgctxt "home_kimochi_interior_3fa35239"
msgid "Je n'ai rien d'autre a ajouter."
msgstr "Vậy là chuẩn không cần chỉnh."

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "home_kimochi_interior_c3763038"
msgid "Tu es bel et bien quelqu'un avec qui il faut pas traîner..."
msgstr "Đúng thật mày là cái thể loại mà tao không nên dây dưa vào..."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_kimochi_interior_5a6719b2"
msgid "Ah si cruelle.... Aucune pitié."
msgstr "Hạ thần... cúi xin lòng từ bi."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_72fff64e"
msgid "{{saito.n}} tu ne connais pas ta chance, je donnerais cher pour qu'elle s'occupe de mon cas chaque jour."
msgstr "{{saito.n}}, mày có phúc mà chẳng biết hưởng. Tao sẵn sàng trả hàng tỷ để tiểu thư đây chăm sóc tao mỗi ngày."

#. Character:`noriko` | Attributes:`afraid`
msgctxt "home_kimochi_interior_5b7a41d0"
msgid "Quoi ?!"
msgstr "Cờ lờ gờ tê ?!"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_802d5232"
msgid "Laisse tomber, il a un grain."
msgstr "Thôi bỏ đi, thằng đấy ngáo mịa rồi."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_906ec46a"
msgid "Je ne peux pas vous laisser partir en ne t'ayant montré que mes mauvais cotés."
msgstr "Khà khà, mày với tiểu thư chắc chắn chẳng tới để bôi tro trát trấu vào mặt tao rồi này."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_c42758ce"
msgid "Je ferai tout pour que tu puisse m'apprécier {{noriko.n}} !"
msgstr "Hạ thần xin cống hiesn hết sức mình để {{noriko.n}} Người có cảm tình với hạ thần !"

#. Character:`noriko`
msgctxt "home_kimochi_interior_ed8b7384"
msgid "Même pas en rêve taré."
msgstr "Có cái cục cức ấy."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_59ca85da"
msgid "Héhé... Bref dis-moi pourquoi tu étais venu à la base et je ferai en sorte d'être le plus coopératif possible."
msgstr "Hehe... Dù sao thì, bây nói tại sao bây tới đây đi, và bố sẽ hết mình giúp sức."

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_kimochi_interior_47d97882"
msgid "Bon... À la base je suis venu pour avoir des infos sur le dojo. Si tu connaissais une autre façon d'y entrer ?"
msgstr "Ờm... Đơn giản thì, bọn tôi tới tìm thông tin về Võ Đường. Ngoài cổng chính ra, còn lối vào khác không ?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_ef6e4b3c"
msgid "Abandonne !"
msgstr "Có đéo !"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_kimochi_interior_d8bd51f0"
msgid "Tête de bite, tu imagines bien que c'est pas une réponse qu'on peut accepter."
msgstr "Thằng đầu khấc, đấy không phải câu trả lời tao muốn."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_f9ba7b73"
msgid "Ahlala très bien, je vais te dire tout ce que je sais."
msgstr "Hàhà, thôi được, vậy để tôi kể ông nghe những gì tôi biết."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_9cb6af48"
msgid "Depuis quelques mois le propriétaire du dojo a changé, il n'embauche que des brutes."
msgstr "Vài tháng trở lại đây, vị trí Đường chủ Võ Đường có sự thay đổi, và anh ta hiện thời chỉ thu nạp toàn những gã cơ bắp."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_cbe4f294"
msgid "Comme s'il essayait de former une sorte de clan..."
msgstr "Cảm tưởng như anh ta đang tính lập một băng nhóm ấy..."

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_cf44c3b1"
msgid "Pourquoi ? Ca n'a pas de sens, le but d'un dojo n'est il pas d'enseigner a des élèves en échange d'un peu d'argent ?"
msgstr "Tại sao lại vậy ? Võ Đường chỉ là nơi học viên tới luyện tập, có trả phí cho mỗi buổi tập mà ?"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_d1d25d41"
msgid "La vraie question ici c'est leur motivation."
msgstr "Câu hỏi đúng ở đây là hai chữ 'tại sao?'"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_8903c1b9"
msgid "Il y a une raison derrière cette façon de procéder c'est juste que pour le moment elle nous échappe."
msgstr "Ắt hẳn phải có một động cơ lớn hơn đằng sau. CHỉ là chúng ta hiện thời chưa biết động cơ đó là gì."

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_0ad92692"
msgid "Pfff ça n'arrange pas mes affaires ça."
msgstr "Mọe, có cũng như không."

#. Character:`noriko`
msgctxt "home_kimochi_interior_9889bd27"
msgid "Tu n'as qu'à réessayer, peut être que ces abrutis se lasseront a un moment ou un autre ?"
msgstr "Mày đã thử va chạm với chúng nó đâu. Cứ thử quay lại xem sao ?"

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_ba210492"
msgid "Permets-moi d'en douter."
msgstr "Sú lắm tiểu thư ạ."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_kimochi_interior_b5ac9ad7"
msgid "Non, je suis de l'avis de {{noriko.n}}, ces trois idiots ne sont pas fiables, je suis sur qu'ils seront deja partis."
msgstr "Không, tao đồng tình với {{noriko.n}}. Ba thằng âm binh ấy đứng chốt rồi cũng đến phát ngán, thế là sẽ vào được."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_a7870308"
msgid "Vous vivez dans le déni..."
msgstr "Rồi, cứ thử đi..."

#. Character:`noriko`
msgctxt "TIENS_A_SENT_MOINS_LE_SPERME_I_3844AC"
msgid "Tiens, ça sent moins le sperme ici."
msgstr ""

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "COMMENT_A_SE_FAIT_QUE_TU_CONNA_A4D095"
msgid "Comment ça se fait que tu connaisses cette odeur ?"
msgstr ""

#. Character:`noriko` | Attributes:`angry`
msgctxt "M_LE_TOI_DE_CE_QUI_TE_REGARDE_C37151"
msgid "Mêle-toi de ce qui te regarde ou je ferai en sorte que tu puisses plus jamais souiller quoi que ce soit."
msgstr ""

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_kimochi_interior_f11878e9"
msgid "On a besoin de toi tête de bite."
msgstr "Chụy đang cần mày, đầu khấc ơi."

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_af783f6e"
msgid "Pas de problème mais ça ne sera pas gratuit."
msgstr "Chỉ lệnh Nữ Hoàng, quân lệnh nhưu sơn. Hạ thần chí cúi xin chút bổng lộc gọi là thôi ạ. Hề hề."

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "home_kimochi_interior_bc4f1034"
msgid "Il a toujours été comme ça ?"
msgstr "Bộ nó lúc nào cũng zư lày hả ?"

#. Character:`saito` | Attributes:`sad`
msgctxt "home_kimochi_interior_d60c8a54"
msgid "Malheureusement oui..."
msgstr "Đáng tiếc thay là ừ..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_kimochi_interior_787c16de"
msgid "Et si je ne t'écrasais pas les couilles ? Ce serait plutôt bien comme récompense ?"
msgstr "Thế nếu tao bóp vỡ dái mày thì sao nhỉ ? Phần thưởng đáng suy ngẫm, đúng không ?"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_24dddc18"
msgid "Contre-proposition ! Je vous aide et tu pourras me piétiner comme tu veux."
msgstr "Nữ Hoàng ơi ! Hạ thần giúp người xong, Người muốn dẫm đạp thần bao nhiêu cũng được."

#. Character:`noriko` | Attributes:`afraid`
msgctxt "home_kimochi_interior_854b2e8f"
msgid "...Quoi ?! Mais quel genre de malade m-"
msgstr "... Đờ phắc ?! Mày bệnh tới mức nào vậ-"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_199e8af5"
msgid "Bordel {{kimochi.n}}, j'essaye à chaque fois de me convaincre que tu reste quelqu'un d'intelligent et plutôt pragmatique."
msgstr "{{kimochi.n}} ơi, tao đã cố nói đỡ cho mày, rằng thì mà là mày là một kẻ trên thông thiên văn, dưới tường địa lý, rằng thì mà là mày như đấng quân sư tài danh, phất một cờ lệnh chết vạn binh tốt."

#. Character:`saito`
msgctxt "home_kimochi_interior_da399f43"
msgid "Mais tu me sors toujours des trucs complètement dingues."
msgstr "Nhưng mà sao dạo này mày toàn chơi đồ thế này."

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "home_kimochi_interior_085c5740"
msgid "N'essaye pas de me culpabiliser, je suis quelqu'un de sincère avec mes sentiments !"
msgstr "Là đấng anh hào, nhất ngôn cửu đỉnh ! Tao sống thật, ghét sự giả dối !"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_kimochi_interior_7673200c"
msgid "...Très bien le dégénéré, si tu veux que je te latte les couilles, je le ferais, mais d'abord, je veux des réponses."
msgstr "... THôi được rồi thằng súc sinh, nếu mày muốn tao dẫm nát bi mày. ừ tao sẽ làm, nhưng cái tao cần là một câu trả lời trước đã."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_6132cd57"
msgid "Bien, très bien, on a un accord. Que voulez vous savoir ?"
msgstr "Dạ, dạ được chứ ạ. Người muốn hỏi gì ạ ?"

#. Character:`saito`
msgctxt "home_kimochi_interior_f0409511"
msgid "On veut savoir où habite {{nobu.n}}."
msgstr "Chụy muốn biết thằng oẳng {{nobu.n}} sống ở đâu."

#. Character:`kimochi` | Attributes:`think`
msgctxt "home_kimochi_interior_cc584a21"
msgid "{{nobu.n}}... mhhhh"
msgstr "{{nobu.n}}à... mhhhh"

#. Character:`kimochi` | Attributes:`happy`
msgctxt "home_kimochi_interior_4428946a"
msgid "Aucune idée !"
msgstr "Hạ thần không biết ạ !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_9f353707"
msgid "Mais on doit pouvoir le découvrir assez facilement."
msgstr "Nhưng mà tìm ra chắc cũng dễ."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_80a5a4d7"
msgid "Suivez le, juste le temps d'une journée sans vous faire repérer, il finira bien par rentrer chez lui à un moment ou un autre."
msgstr "Mày với Người cứ bám đuôi nó trong độ một ngày, thằng đấy không ngủ lang bao giờ đâu, sớm hay muộn nó cũng về nhà ấy mà."

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_kimochi_interior_708de2e8"
msgid "Tu ne viens pas avec nous !"
msgstr "Mày không đi cùng tụi tao sao !"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_731973d3"
msgid "Désolé mais j'évite de suivre les hommes."
msgstr "Xin lỗi nghen, nhưng tôi không có bám đuôi đàn ông."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_47f13870"
msgid "J'ai des principes."
msgstr "Đấng anh hào cũng phải có nguyên tắc chứ."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_edb9d689"
msgid "Mais j'essaierais de rassembler des infos sur les deux autres."
msgstr "Nhưng cứ để tôi thu thập thêm tin tức từ hai đứa kia cho."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_3d3fd553"
msgid "Je suppose que {{nobu.n}} ne sera pas le dernier."
msgstr "Chắc không chỉ muốn ỉa vào mặt mỗi thằng {{nobu.n}} nhỉ ?"

#. Character:`noriko` | Attributes:`bad`
msgctxt "home_kimochi_interior_a5b365af"
msgid "En effet, on va tous leur casser les dents !"
msgstr "Chuẩn rồi, tụi chụy đang trên arc Chọi vỡ bi chúng nó !"

#. Character:`saito` | Attributes:`guilty`
msgctxt "home_kimochi_interior_859dc21e_1"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`happy`
msgctxt "home_kimochi_interior_8f023ab8"
msgid "Allez je suis motivée comme jamais, allons voir ces abrutis."
msgstr "Nào, chụy nhiệt tình lắm ròi, đi triển nhanh cho nóng thôi."

#. Character:`noriko`
msgctxt "home_kimochi_interior_001d4697"
msgid "Je suis certaine qu'ils sont en train de glander au dojo."
msgstr "Chắc chúng nó vẫn đang ngồi trĩ mẹ đuýt ở Võ Đường."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_kimochi_interior_c2649385"
msgid "Tu ne sais pas la chance que tu as..."
msgstr "Thật sự mày không biết mày may mắn tới mức nào đâu, con chóa ạ..."

#. Character:`kimochi` | Attributes:`angry`
msgctxt "home_kimochi_interior_9cd1f422"
msgid "Je tuerais pour être a ta place !"
msgstr "Có mất một cánh tay để đổi chỗ cho mày, tao cũng chịu !"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_kimochi_interior_0d94fd5b"
msgid "...Si t'aimes tant que ça te faire éclater les couilles, demande a {{macumba.n}}, tu peux être sûr que le travail sera bien fait."
msgstr "... Giả như mày thích bị bóp dái đến thế, cứ ới {{macumba.n}} một tiếng ý, anh ấy sẽ giải quyết được việc nhanh gọn lẹ thôi."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_f822b00a"
msgid "...mais c'est intéressant seulement si c'est {{noriko.n}} qui le fait débile !"
msgstr "... nhưng mà phải {{noriko.n}} làm thì mới nứng. thằng đầu cặc ạ !"

#. Character:`noriko`
msgctxt "home_kimochi_interior_6d82bc7a"
msgid "[font_size=14]C'est toi le débile ![/font_size]"
msgstr "[font_size=14]Chỉ có mày đầu cặc ở đây thôi ![/font_size]"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_2221be14"
msgid "Ma parole {{saito.n}} tu es devenu un vrai tueur !"
msgstr "Hởi người anh em sấm sét {{saito.n}}, dạo này anh nổi như cồn !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_7f91387b"
msgid "{{nobu.n}} je me faisais pas vraiment de soucis mais {{kenji.n}}..."
msgstr "{{nobu.n}} thì tôi đã không lo mấy, nhưng mà cả {{kenji.n}} nữa thì đúng là..."

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "home_kimochi_interior_f6aa5192"
msgid "Ils ne valent rien !"
msgstr "Mấy hạng nước cống nước rãnh chúng nó, chấp làm gì !"

#. Character:`saito`
msgctxt "home_kimochi_interior_416a863f"
msgid "En un contre un peut être..."
msgstr "Biết đâu là vì khi đánh tay đôi..."

#. Character:`noriko`
msgctxt "home_kimochi_interior_cc1d9d3f"
msgid "Ceux qui attaquent à plusieurs ne sont que des lâches qui devraient rester puceaux toute leur vie !"
msgstr "Cái loại phải đi bầy đàn mới ra hồn, rặt một lũ hèn kém trẩu tre óc chó !"

#. Character:`noriko`
msgctxt "home_kimochi_interior_653427c7"
msgid "A aucun moment ils ne devraient se reproduire."
msgstr "Chọn lọc tự nhiên sẽ ban cho tụi nó, những cái dái teo."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_kimochi_interior_150073ae"
msgid "Ah {{noriko.n}} tes paroles sont une douce caresse à mes oreilles."
msgstr "Ôi, {{noriko.n}}Người, thanh âm của Người như rót mật vào tai hạ thần vậy."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_kimochi_interior_0f733f73"
msgid "On a pas terminé !"
msgstr "Về Trái Đất ngay, tao với mày đã xong chuyện đâu !"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_5421f94e"
msgid "Il vous manque le dernier, mais j'ai bien travaillé."
msgstr "Chỉ còn tên cuối nữa thôi, và hạ thần đã làm việc rất năng suất."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_48edc635"
msgid "Voici son adresse, toutefois vous serez probablement surpris..."
msgstr "Đây, địa chỉ của nhà nó đấy, nhưng chắc có lẽ ông sẽ bất ngờ."

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_kimochi_interior_bcbe1e50"
msgid "Ah ? Et c'est quoi ?"
msgstr "Ah ? Tại sao vậy ?"

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_kimochi_interior_745b0719"
msgid "Bon sang, crache le morceau tête de bite !"
msgstr "Con mẹ, thằng đầu cắt moi, bí ẩn bí iếc cái loằn !"

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "home_kimochi_interior_3834d0fd"
msgid "Je préfère vous laisser la surprise pour une fois, préparez-vous à être surpris."
msgstr "Tôi thiết nghĩ là chỉ nên giới thiệu tới đó thôi, chuẩn bị đi nhé."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_kimochi_interior_b54f5590"
msgid "Merci pour tout"
msgstr "Cảm ơn ông vì tất cả."

#. Character:`kimochi` | Attributes:`horny`
msgctxt "home_kimochi_interior_f366c269"
msgid "Oh mais de rien, mais ce n'est pas pour tes beaux yeux que je fais ça {{saito.n}}..."
msgstr "Ồ, chẳng hề gì đâu, nhưng tôi đâu có làm vì ông, hở {{saito.n}}... ?"

#. Character:`kimochi`
msgctxt "home_kimochi_interior_53c644bd"
msgid "N'est-ce pas ma reine..."
msgstr "Hạ thần chỉ nhất nhất một lòng trung quân với Người thôi ạ, hề hề..."

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "home_kimochi_interior_9987f86c"
msgid "Huggh, répugnant..."
msgstr "Kinh vãi loằn..."

#. Character:`kimochi`
msgctxt "home_kimochi_interior_a89ab3be"
msgid "N'oublie pas ma récompense."
msgstr "Xin người đừng quên phần thưởng cho hạ thần nhé."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_kimochi_interior_f9a1030b"
msgid "Ouais ouais c'est ça..."
msgstr "Rồi rồi, con mẹ mày..."

#. Character:`kimochi` | Attributes:`happy`
msgctxt "ta621a65dea"
msgid "Mais ça alors ! Voila {{saito.n}} le tueur !"
msgstr "Ơn giời, chiến thần {{saito.n}} đây rồi !"

#. Character:`saito` | Attributes:`surprised`
msgctxt "t73c2d8f02c"
msgid "Quoi ?! C'est quoi ces conneries encore ?"
msgstr "Con mọe, bây chọc tao có việc gì ?"

#. Character:`kimochi` | Attributes:`frustrated`
msgctxt "te8ec2a0e87"
msgid "Tu as une mémoire à court terme ou quoi ?"
msgstr "Bộ bây supersaiyan xong mất não hay gì ?"

#. Character:`kimochi`
msgctxt "t67c570d81e"
msgid "{{nobu.n}}, {{kenji.n}}, {{takeo.n}} et même {{akira.n}} !"
msgstr "{{nobu.n}}, {{kenji.n}}, {{takeo.n}} rồi cả {{akira.n}} nữa !"

#. Character:`kimochi` | Attributes:`horny`
msgctxt "tac87c1ffd2"
msgid "Franchement pourquoi on perd notre temps, viens on va mettre un coup de boule à {{minato.n}} et c'est fini !"
msgstr "Mẹ, tụi mình còn ở đây làm gì nữa ? Mày supersaiyan thêm phát nữa rồi tiễn nguyên thằng {{minato.n}} đi chầu ông bà ông vải đi !"

#. Character:`saito` | Attributes:`upset`
msgctxt "t243495a85d"
msgid "Pour les thugs je veux bien mais {{akira.n}} c'est différent, je n'ai pas eu à me battre contre lui, disons qu'il est hors jeu mais il n'en reste pas moins dangereux."
msgstr "Với dăm ba thằng kia thì chẳng nói làm gì, nhưng {{akira.n}} thì lại là chuyện khác. Tôi với nó vẫn chưa động thủ với nhau, nó chưa biết điều mà lui đâu."

#. Character:`kimochi` | Attributes:`think`
msgctxt "ta687658e23"
msgid "Oula je ne vais pas te contredire, j'ai pas envie que tu me me casse la figure à moi aussi."
msgstr "Ông nói cũng đúng, kể ra tôi cũng chẳng muốn cái mạng tra này phải phơi xác ngoài nội mạc."

#. Character:`saito` | Attributes:`sad`
msgctxt "t8b36664bd4"
msgid "Tu me fatigues déjà..."
msgstr "...Tao chán mày vãi nồi..."

#. Character:`kimochi` | Attributes:`neutral`
msgctxt "t2908bbd8c3"
msgid "Mes excuses boss !"
msgstr "Hề hề hề, sếp cho em xí xóa !"

#. Character:`saito` | Attributes:`upset`
msgctxt "tde4c528b14"
msgid "Est-ce qu'on peut enfin se concentrer sur {{chiaki.n}} ?"
msgstr "Thế giờ đã tập trung được vào vấn đề của {{chiaki.n}}  chưa ?"

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "t9d3c43d946"
msgid "Oh bon sang oui c'est vrai j'allais oublier !"
msgstr "Ừ đúng rồi, bỏ mẹ, lâu nay quên béng mất !"

#. Character:`saito` | Attributes:`happy`
msgctxt "t27d92b40ba"
msgid "Ah ! Ravi que t-"
msgstr "Ok, thế giờ th-"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "t1d5916cc44"
msgid "Ferme là et suis moi !"
msgstr "Ngậm mẹ mồm bây vào và theo tao !"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t98bef4c467"
msgid "Mais..."
msgstr "Nhưng..."

#. Character:`kimochi`
msgctxt "t0a64cae53a"
msgid "C'est une question de vie ou de mort !"
msgstr "Đây là vấn đề sống còn đấy !"

#. Character:`kimochi` | Attributes:`angry`
msgctxt "BON_QUE_CE_SOIT_BIEN_CLAIR_0190BC"
msgid "Bon, que ce soit bien clair !"
msgstr ""

#. Character:`kimochi`
msgctxt "JE_NE_ME_PROSTITUE_PAS_FD95BF"
msgid "Je ne me prostitue pas !"
msgstr ""

#. Character:`kimochi`
msgctxt "J_AI_UN_PETIT_BUSINESS_O_JE_LO_D95659"
msgid "J'ai un petit business où je loue d'anciens jeux vidéo et ça me rapporte pas mal d'argent."
msgstr ""

#. Character:`kimochi`
msgctxt "ET_MON_PLUS_GROS_CLIENT_DU_MOM_297909"
msgid "Et mon plus gros client du moment, c'est {{netoru.n}}."
msgstr ""

#. Character:`saito` | Attributes:`angry`
msgctxt "CETTE_ESP_CE_D_ORDURE_01C5E8"
msgid "Cette espèce d'ordure ?!"
msgstr ""

#. Character:`saito` | Attributes:`upset`
msgctxt "COMMENT_TU_PEUX_FAIRE_DES_AFFA_765E7A"
msgid "Comment tu peux faire des affaires avec ce type ?"
msgstr ""

#. Character:`kimochi` | Attributes:`doubt`
msgctxt "EH_BIEN_JE_DOIS_TOUJOURS_PAYER_2E74D7"
msgid "Eh bien... je dois toujours payer mon loyer et de quoi me nourrir pour commencer."
msgstr ""

#. Character:`kimochi`
msgctxt "ET_DE_DEUX_IL_A_TOUT_PERDU_SA_7D3146"
msgid "Et de deux... il a tout perdu : sa maison, sa réputation, absolument tout."
msgstr ""

#. Character:`saito`
msgctxt "C_TAIT_PEUT_TRE_M_RIT_FFC0F7"
msgid "C'était peut-être mérité !"
msgstr ""

#. Character:`kimochi` | Attributes:`sad`
msgctxt "C_EST_LE_DERNIER_PASSE_TEMPS_Q_FD5C9D"
msgid "C'est le dernier passe-temps qu'il lui reste... Je suppose qu'il veut sûrement retrouver la nostalgie d'une époque où tout allait encore bien ?"
msgstr ""

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "ON_POURRAIT_ARR_TER_DE_PARLER_44C7DD"
msgid "On pourrait arrêter de parler de ce type ? Ça me donne la nausée."
msgstr ""

#. Character:`noriko`
msgctxt "IL_Y_A_BIEN_PLUS_IMPORTANT_POU_C6AF9F"
msgid "Il y a bien plus important pour le moment."
msgstr ""

#. Character:`kimochi`
msgctxt "POURQUOI_QU_EST_CE_QUI_SE_PASS_99CF81"
msgid "Pourquoi ? Qu'est-ce qui se passe exactement ?"
msgstr ""

#. Character:`saito` | Attributes:`sad`
msgctxt "W_ASAMI_N_A_T_ENLEV_E_8DA41A"
msgid "...[w] {{asami.n}} a été enlevée..."
msgstr ""

#. Character:`kimochi` | Attributes:`angry`
msgctxt "QUOI_COMMENT_A_DONNE_MOI_PLUS_B3F104"
msgid "Quoi ? Comment ça ? Donne-moi plus d'explications, bordel !!"
msgstr ""

#. Character:`centered`
msgctxt "SAITO_N_PREND_UN_CERTAIN_TEMP_BE82C4"
msgid "{{saito.n}} prend un certain temps à expliquer la situation."
msgstr ""

#. Character:`kimochi` | Attributes:`think`
msgctxt "ET_CE_X3_QU_EST_CE_QUE_C_EST_E_4633BE"
msgid "Et ce X3, qu'est-ce que c'est exactement ?"
msgstr ""

#. Character:`saito` | Attributes:`upset`
msgctxt "C_EST_C_EST_UNE_DROGUE_DE_SYNT_5D5422"
msgid "C'est... c'est une drogue de synthèse. Si tu prends 3 doses, la troisième te fera tomber complètement accro à la première personne que tu verras."
msgstr ""

#. Character:`kimochi` | Attributes:`disgusted`
msgctxt "C_EST_UNE_BLAGUE_J_ESP_RE_FCD050"
msgid "C'est une blague, j'espère ?"
msgstr ""

#. Character:`saito`
msgctxt "NON_JE_NE_PLAISANTERAIS_PAS_SU_67F42B"
msgid "Non, je ne plaisanterais pas sur quelque chose d'aussi important."
msgstr ""

#. Character:`saito`
msgctxt "QUAND_J_AI_T_BLOQU_QUELQUES_JO_5370CB"
msgid "Quand j'ai été bloqué quelques jours avec {{sakuya.n}}, {{akira.n}} a fait irruption dans sa chambre, il avait de cette drogue sur lui."
msgstr ""

#. Character:`saito`
msgctxt "ELLE_L_A_MA_TRIS_ET_LUI_A_FAIT_C6234D"
msgid "Elle l'a maîtrisé et lui a fait avaler ça. Il y avait des photos de moi partout sur les murs de sa chambre. Quand {{akira.n}} a eu sa troisième dose, il a totalement changé, au point qu'il ne peut même plus s'approcher de moi sans avoir envie de me..."
msgstr ""

#. Character:`kimochi`
msgctxt "C_EST_DU_D_LIRE_14564C"
msgid "C'est du délire !"
msgstr ""

#. Character:`kimochi`
msgctxt "IL_Y_A_D_AUTRES_PERSONNES_QUI_4A33A2"
msgid "Il y a d'autres personnes qui ont reçu ce truc ?"
msgstr ""

#. Character:`noriko` | Attributes:`afraid`
msgctxt "MAMAN_SON_COMPORTEMENT_A_CHANG_980FCF"
msgid "Maman ! Son comportement a changé dernièrement !"
msgstr ""

#. Character:`saito` | Attributes:`sad`
msgctxt "OUI_ELLE_EN_A_EU_C_EST_NETORU_7424E0"
msgid "... Oui, elle en a eu, c'est {{netoru.n}} justement qui voulait lui faire avaler."
msgstr ""

#. Character:`noriko`
msgctxt "MAIS_A_N_A_PAS_MARCH_7B2087"
msgid "Mais ça n'a pas marché ?"
msgstr ""

#. Character:`saito`
msgctxt "JE_SUIS_ARRIV_JUSTE_TEMPS_J_AI_A0D5CA"
msgid "Je suis arrivé juste à temps... J'ai envoyé mon poing dans la figure de cette ordure et c'est moi que {{yasuka.n}} a vu pour la troisième dose."
msgstr ""

#. Character:`noriko` | Attributes:`shame`
msgctxt "A_EXPLIQUE_TELLEMENT_DE_CHOSE_4ABDCF"
msgid "Ça explique tellement de choses à présent !"
msgstr ""

#. Character:`noriko`
msgctxt "POURTANT_ELLE_NE_SEMBLE_PAS_SI_89E714"
msgid "Pourtant... elle ne semble pas si accro que ça..."
msgstr ""

#. Character:`saito`
msgctxt "VISIBLEMENT_LES_EFFETS_DU_X3_S_A32EE1"
msgid "Visiblement, les effets du X3 sont très amoindris si la personne qui prend la drogue apprécie déjà la personne."
msgstr ""

#. Character:`kimochi` | Attributes:`sad`
msgctxt "JE_COMPRENDS_MAINTENANT_POURQU_9184FF"
msgid "Je comprends maintenant pourquoi tu détestes autant {{netoru.n}}..."
msgstr ""

#. Character:`noriko` | Attributes:`disgusted`
msgctxt "A_ME_DONNE_ENVIE_DE_VOMIR_F040A3"
msgid "Ça me donne envie de vomir..."
msgstr ""

#. Character:`noriko`
msgctxt "ET_ASAMI_N_A_PRIS_LA_PREMI_RE_1EEE9C"
msgid "Et {{asami.n}} a pris la première dose, c'est ça ?"
msgstr ""

#. Character:`saito` | Attributes:`upset`
msgctxt "OUI_LA_PERSONNE_QUI_A_FAIT_A_S_E2F4EB"
msgid "Oui, la personne qui a fait ça s'amuse volontairement à jouer avec nos nerfs."
msgstr ""

#. Character:`kimochi` | Attributes:`angry`
msgctxt "MERDE_SAITO_N_TU_AURAIS_D_M_EN_B7E366"
msgid "Merde, {{saito.n}} ! Tu aurais dû m'en parler bien plus tôt !"
msgstr ""

#. Character:`noriko` | Attributes:`neutral`
msgctxt "FERME_LA_T_TE_DE_BITE_8EF11C"
msgid "Ferme-la, tête de bite."
msgstr ""

#. Character:`saito` | Attributes:`neutral`
msgctxt "JE_N_EN_AI_PAS_PARL_CAR_J_AI_L_0A33D7"
msgid "Je n'en ai pas parlé car j'ai l'impression que tout ça est tellement gros qu'on va se retrouver dépassés, et plus de gens seront au courant, plus ça les mettra en danger..."
msgstr ""

#. Character:`kimochi`
msgctxt "TU_PENSES_QU_IL_EST_DERRI_RE_T_10C0C3"
msgid "Tu penses qu'il est derrière tout ça ?"
msgstr ""

#. Character:`saito`
msgctxt "J_AI_DES_DOUTES_MAIS_AUCUNE_CE_962F5B"
msgid "J'ai des doutes, mais aucune certitude..."
msgstr ""

