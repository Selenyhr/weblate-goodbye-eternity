msgctxt "tbfaacd79d3"
msgid "[next]"
msgstr "[next]"

#. Character:`narrator`
msgctxt "t422ec85cbf"
msgid "Passer du temps avec {{yasuka.n}}"
msgstr "Dành thời gian với {{yasuka.n}}."

#. Character:`narrator`
msgctxt "te6d0a9b68b"
msgid "Passer du temps avec {{sayuri.n}}"
msgstr "Dành thời gian với {{sayuri.n}}."

#. Character:`narrator`
msgctxt "td6b8a34be2"
msgid "Retour"
msgstr "Quay về"

#. Character:`yasuka` | Attributes:`moved`
msgctxt "love_hotel_sexe_with_yasuka_aba9bb9b"
msgid "Eh bien, j'ai failli attendre !"
msgstr "Sao con lại bắt ta chờ vậy !"

#. Character:`saito`
msgctxt "love_hotel_sexe_with_yasuka_8397d729"
msgid "Je suis désolé, j'essayais d'être discret en quittant la maison."
msgstr "Con xin lỗi, chỉ là con vừa cố gắng ra khỏi nhà một cách thật yên tĩnh."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_223cbddc"
msgid "Nous n'avons plus beaucoup de temps devant nous !"
msgstr "Không còn nhiều thời gian đâu !"

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_dc8293d8"
msgid "J'ai envie de toi tout de suite !"
msgstr "Ta muốn con, ngay bây giờ !"

#. Character:`saito` | Attributes:`surprised`
msgctxt "love_hotel_sexe_with_yasuka_9dec949e"
msgid "À vos ordres !"
msgstr "Tuân lệnh mẫu thân !"

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_6ac33929"
msgid "J'ai cru que tu ne viendrais jamais !"
msgstr "Con làm ta chờ mãi !"

#. Character:`saito`
msgctxt "love_hotel_sexe_with_yasuka_fe658caf"
msgid "Je n'aurais raté ça pour rien au monde."
msgstr "Có chết con cũng không để muộn."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_54fda827"
msgid "Je n'en pouvais plus, j'étais bien trop excitée."
msgstr "Ta... nứng lắm rồi. Ướt nhẹp... đây này."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_3992bb78"
msgid "Te sentir en moi... comme ça..."
msgstr "Cảm nhận con... trong ta... như thế này..."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_283c7dca"
msgid "Mmmh..."
msgstr "Mmmh..."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_312b2ad4"
msgid "Oh oui..."
msgstr "Ahhh..."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_00beb0e5"
msgid "Je te sens... plus fort encore."
msgstr "Mjanh nữa lên đi, con yêu..."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_42b624f8"
msgid "Ne me ménage pas, tu peux y aller à fond."
msgstr "Địt mẹ! Mạnh vào ! Tới bến đi !"

#. Character:`saito`
msgctxt "love_hotel_sexe_with_yasuka_04309e2a"
msgid "Comme tu voudras, j'accélère !"
msgstr "Con sẽ địt mẹ chết luôn !"

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_c495f740"
msgid "Voilà ! Comme ça !"
msgstr "Ah ! Ah ! Sướng quá !"

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_9f4bf154"
msgid "Ohlala..."
msgstr "Ưm, ưm, ứm..."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_93fc313d"
msgid "J'envie ta jeunesse."
msgstr "Ước gì ta... trẻ... như con."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_b64ae561"
msgid "Tu es infatigable !"
msgstr "Con sung quá đó !"

#. Character:`saito`
msgctxt "love_hotel_sexe_with_yasuka_c1ff5a48"
msgid "Honnêtement, je trouve que tu ne te débrouilles pas si mal non plus."
msgstr "Là mẹ dâm đãng quá nên khỏe ra đấy ạ !"

#. Character:`saito`
msgctxt "love_hotel_sexe_with_yasuka_ec2e6a46"
msgid "D'ailleurs, si tu me permets..."
msgstr "Mà, nếu như mẹ muốn..."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_df86e29b"
msgid "Tu peux faire ce que tu veux de moi, mon chéri !"
msgstr "Dùng mẹ như ...cái sextoy của con đi... con yêu !"

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_338c6fdc"
msgid "Mmmh, mmmmh, mmmh..."
msgstr "Mmmh, mmmmh, mmmh..."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_fa538d77"
msgid "Ouii, mmmh..."
msgstr "Ahh, mmmh..."

#. Character:`saito`
msgctxt "love_hotel_sexe_with_yasuka_2f058750"
msgid "Je... jouis !"
msgstr "Con ra... đây !"

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_ec13d087"
msgid "Mmh, mmmh !"
msgstr "Mmh, mmmh!"

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_0b852814"
msgid "Hihi ! Cette petite séance m'a redonnée la forme."
msgstr "Hehe ! Làm nhiều có khi giảm được cân ấy nhỉ."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_d2fc6189"
msgid "Je serais bien restée avec toi jusqu'au petit matin, mais je dois hélas retourner travailler encore un peu."
msgstr "Ước chi ta có thể nằm với con tới sáng, nhưng đã tới giờ ta phải đi làm rồi."

#. Character:`saito`
msgctxt "love_hotel_sexe_with_yasuka_8e2de8f6"
msgid "Je sais... Je promets de travailler dur de mon côté afin que nous puissions rembourser ces dettes le plus vite possible."
msgstr "Con... con cũng sẽ cố gắng nữa, để có thể trả hết đống nợ sớm nhất có thể."

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_b6d1438d"
msgid "J'ai enfin l'impression de voir le bout du tunnel."
msgstr "Một ánh sáng nơi cuối đường hầm, là con đó, con yêu à !"

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_b9477a66"
msgid "Je pourrais enfin envisager ma vie après tout ça... avec toi !"
msgstr "Một cuộc đời... bên cạnh... anh yêu !"

#. Character:`yasuka`
msgctxt "love_hotel_sexe_with_yasuka_c1407ffc"
msgid "Mince, je suis en retard, je dois me dépêcher, passe une bonne nuit mon chéri !"
msgstr "Chết chửa, muộn quá rồi. Ta phải đi làm thôi ! Ngủ ngon nhé, con yêu !"

#. Character:`saito`
msgctxt "love_hotel_reception_81a899bd"
msgid "Merde, il n'y a personne ici !"
msgstr "Đệt, không có ai trực ngoài này à?!"

#. Character:`saito`
msgctxt "love_hotel_reception_53d3f8df"
msgid "Je ne pense pas qu'on m'aurait renseigné non plus."
msgstr "Mà, mình nghĩ chắc cũng chẳng có ai thèm giúp mình đâu."

#. Character:`saito`
msgctxt "love_hotel_reception_86b2907f"
msgid "Je n'ai pas le choix, je vais devoir fouiller chaque chambre une par une."
msgstr "Chẳng còn cách nào khác ngoài đi gõ cửa từng phòng một."

#. Character:`saito` | Attributes:`sad`
msgctxt "love_hotel_reception_31308ef8"
msgid "Je vais m'attirer pas mal de problèmes en faisant ça, mais..."
msgstr "Rước họa vào thân lắm đây, nhưng mà..."

#. Character:`saito`
msgctxt "love_hotel_reception_619ad84b"
msgid "Je suis prêt à faire n'importe quoi pour elle."
msgstr "Mình sẽ đi tới cùng trởi cuối đất vì cô ấy."

#. Character:`narrator`
msgctxt "love_hotel_reception_0d2b00d8"
msgid "Tiens bon {{yasuka.n}} !"
msgstr "Hãy chờ con, {{yasuka.n}}!"

#. Character:`narrator`
msgctxt "love_hotel_reception_3d168bff"
msgid "Je préférerais mourir une seconde fois plutôt que de te laisser à la merci de cet immonde bâtard !"
msgstr "Thà rằng con chết lần nữa còn hơn để cô cùng với cái cục cứt tởm lợm này!"

#. Character:`centered`
msgctxt "love_hotel_reception_7b7abd0b"
msgid "Pendant ce temps-là, dans une des nombreuses chambres du Love Hotel..."
msgstr "Cùng lúc đó, tại một phòng nào đó trong số rất nhiều phòng của Tình Phủ..."

#. Character:`netoru`
msgctxt "love_hotel_reception_06edcb46"
msgid "Aaah ma chère, ma très chère {{yasuka.n}}."
msgstr "Khà khà khà..{{yasuka.n}} yêu dấu."

#. Character:`netoru`
msgctxt "love_hotel_reception_729757db"
msgid "Si tu savais depuis combien de temps, j'attends ce moment."
msgstr "Nào em có biết anh đã chờ cái khoảnh khắc này lâu đến mức nào."

#. Character:`netoru`
msgctxt "love_hotel_reception_d2f596cc"
msgid "Depuis le premier jour où je t'ai vu entrer dans cette boutique..."
msgstr "Kể từ cái ngày lần đầu tiên em bước vào quán..."

#. Character:`netoru`
msgctxt "love_hotel_reception_cbc92a4b"
msgid "Je me suis juré que tu serais à moi !"
msgstr "Anh đã thề với toàn bộ danh dự của mình rằng anh sẽ biến em thành của anh!"

#. Character:`netoru`
msgctxt "love_hotel_reception_9ed773f0"
msgid "Peu importe le temps, quelle que soit la manière."
msgstr "Không quan trọng bằng cách nào hay mất bao lâu."

#. Character:`netoru`
msgctxt "love_hotel_reception_3dab8188"
msgid "Tu devais être à moi !"
msgstr "Em buộc phải thuộc về anh!"

#. Character:`netoru`
msgctxt "love_hotel_reception_dd95111d"
msgid "Je pensais qu'au fil du temps, à travailler ensemble à la boutique, une connexion entre nous se serait créer mais..."
msgstr "Anh đã nghĩ là qua thời gian, lửa gần rơm lâu ngày cũng bén, một mối thân tình sẽ hình thành giữa hai ta, nhưng..."

#. Character:`netoru`
msgctxt "love_hotel_reception_44be87ed"
msgid "Tu n'avais pour moi que ce regard teinté de dégout."
msgstr "Em luôn nhìn anh bằng ánh mắt kinh tởm."

#. Character:`netoru`
msgctxt "love_hotel_reception_360c89b5"
msgid "Le même regard qu'avait ma mère quand elle me regardait !"
msgstr "Y hệt cái ánh nhìn mà mẹ anh có mỗi lúc bà nhìn anh!"

#. Character:`netoru`
msgctxt "love_hotel_reception_cc3e2083"
msgid "...[w] Mais je ne peux pas t'en vouloir."
msgstr "...[w] Nhưng cũng chẳng thể trách em được."

#. Character:`netoru`
msgctxt "love_hotel_reception_1a4f4a0c"
msgid "La nature ne m'a pas vraiment gâté..."
msgstr "Tự nhiên không ưu ái anh cho lắm..."

#. Character:`netoru`
msgctxt "love_hotel_reception_3fdc81e3"
msgid "J'ai une hygiène de vie déplorable."
msgstr "Anh có một lối sống tởm lợm."

#. Character:`netoru`
msgctxt "love_hotel_reception_7d02704a"
msgid "Et une personnalité à chier !"
msgstr "Và một cái tâm hồn chó má!"

#. Character:`netoru`
msgctxt "love_hotel_reception_35d84df0"
msgid "Mais il y a une chose dont je suis fier, c'est bien ma ténacité."
msgstr "Nhưng có một thứ mà anh rất tự hào, đó chính là bản tính ngoan cố."

#. Character:`netoru`
msgctxt "love_hotel_reception_181f89f3"
msgid "Quand je veux quelque chose, je sais faire preuve de patience."
msgstr "Khi anh đã muốn thứ gì, thì nhẫn nại chờ thời là điều mà anh luôn có."

#. Character:`netoru`
msgctxt "love_hotel_reception_0c129904"
msgid "Et je frappe toujours au moment où mes proies sont les plus vulnérables !"
msgstr "Tấn công hợp thời khi con mồi đang dễ bị tổn thương nhất!"

#. Character:`netoru`
msgctxt "love_hotel_reception_68167609"
msgid "Je me suis fait une sacrée réputation, tu sais..."
msgstr "Có thể nói là, anh có một tiền sử hoành tráng, em biết đấy..."

#. Character:`netoru`
msgctxt "love_hotel_reception_690c90c2"
msgid "Je suis devenu un véritable maitre dans l'art de faire chanter les gens."
msgstr "Tống tiền người khác đối với anh đã trở thành một nghệ thuật."

#. Character:`netoru`
msgctxt "love_hotel_reception_73f8f0c0"
msgid "Si tu savais le nombre de personnes dont j'ai réussi à ruiner la vie."
msgstr "Ước chi em biết số mảnh đời vì anh mà hóa tang thương."

#. Character:`netoru`
msgctxt "love_hotel_reception_e95df966"
msgid "Ils vivaient tous leur meilleure vie avant quelqu'un comme moi ne leur mettent leur nez dans leur propre merde !"
msgstr "Tất cả bọn họ đều đang ở đỉnh cao cuộc đời trước khi anh tới và chõ cái mũi cứt thối vào đời sống hàng ngày của họ!"

#. Character:`netoru`
msgctxt "love_hotel_reception_89735177"
msgid "Tu sais ce qui est plus hideux encore que mon visage ?"
msgstr "Nhưng em biết cái gì còn ghớm ghiếc hơn cả cái bản mặt anh không?"

#. Character:`netoru`
msgctxt "love_hotel_reception_ec6d5e7e"
msgid "...[w] L'être humain !"
msgstr "...[w] Loài người!"

#. Character:`netoru`
msgctxt "love_hotel_reception_528a9e6d"
msgid "Il n'existe pas de créature plus vile sur terre."
msgstr "Loài vật đáng khinh nhất trên cái Trái Đất này."

#. Character:`netoru`
msgctxt "love_hotel_reception_8b1099a2"
msgid "Même les virus obéissent à certaines règles."
msgstr "Ngay cả virus còn có chuẩn mực của riêng chúng."

#. Character:`netoru`
msgctxt "love_hotel_reception_43c07338"
msgid "C'est fou quand on y pense quand même..."
msgstr "Nếu em nghĩ kĩ về chuyện đấy, thật điên rồ làm sao..."

#. Character:`netoru`
msgctxt "love_hotel_reception_1c070ce1"
msgid "On peut s'entretuer, tromper les autres, détruire notre environnement."
msgstr "Chúng ta có thể tàn sát, lừa lọc lẫn nhau, phá hủy môi trường sống..."

#. Character:`netoru`
msgctxt "love_hotel_reception_14b82b76"
msgid "Ou bien même se suicider !"
msgstr "Thậm chí là tự sát !"

#. Character:`netoru`
msgctxt "love_hotel_reception_34332a77"
msgid "Mais qui peut faire ça dans tout le règne animal ?!"
msgstr "Làm gì có loài nào có khả năng làm vậy nữa trong giới động vật?!"

#. Character:`netoru`
msgctxt "love_hotel_reception_26849dd7"
msgid "PERSONNE !"
msgstr "KHÔNG CÓ!"

#. Character:`netoru`
msgctxt "love_hotel_reception_19b72c27"
msgid "Il y a une certaine beauté dans tout ça."
msgstr "Thế nhưng, ẩn chứa trong cái tởm lợm ấy, một nét đẹp tiềm tàng."

#. Character:`netoru`
msgctxt "love_hotel_reception_0f39c63a"
msgid "Nous pouvons faire tout ce que nous voulons !"
msgstr "Loài người chúng ta có thể làm mọi điều chúng ta muốn!"

#. Character:`netoru`
msgctxt "love_hotel_reception_d6e9a544"
msgid "Et c'est exactement ce que je compte faire avec toi !"
msgstr "Và đó chính là những gì anh sắp sửa làm với em đây!"

#. Character:`netoru`
msgctxt "love_hotel_reception_236f1500"
msgid "Je dois dire que cette drogue miraculeuse m'a bien arrangée !"
msgstr "Phải nói thật rằng, loại thuốc ấy đã giúp đỡ mình rất nhiều!"

#. Character:`netoru`
msgctxt "love_hotel_reception_675963c8"
msgid "C'est presque comme si elle avait été créée pour moi."
msgstr "Cảm tưởng như nó được tạo ra cho riêng mình vậy."

#. Character:`yasuka`
msgctxt "love_hotel_reception_39b7f5e5"
msgid "Mmmh..."
msgstr "Ưưư..."

#. Character:`netoru`
msgctxt "love_hotel_reception_630175a1"
msgid "Oh oh !"
msgstr "Tới rồi! Tới rồi!"

#. Character:`netoru`
msgctxt "love_hotel_reception_30f9c143"
msgid "Nous allons pouvoir passer aux choses sérieuses !"
msgstr "Nào ta cùng vào chuyện thôi!"

#. Character:`netoru`
msgctxt "love_hotel_reception_af95b83b"
msgid "Réveille-toi doucement ma chère..."
msgstr "Tỉnh dậy đi nào, em yêu dấu..."

#. Character:`netoru`
msgctxt "love_hotel_reception_82a72916"
msgid "Si tout fonctionne comme prévu, tu n'auras plus qu'une envie, c'est de te faire engrosser encore et encore !"
msgstr "Nếu như mọi chuyện diễn ra theo đúng như dự định, em sẽ chỉ muốn được mang thai hết lần này tới lần khác thôi!"

#. Character:`netoru`
msgctxt "love_hotel_reception_9a556686"
msgid "Et je ne compte pas m'arrêter là, ta fille subira le même sort, j'ai gardé quelques pilules magiques au cas où !"
msgstr "Và anh cũng không định dừng lại ở chỉ mỗi em. Con gái em cũng sẽ chịu chung số phận ấy. Anh có giữ một vài viên thuốc kì diệu cho ngày ấy đây!"

#. Character:`netoru`
msgctxt "love_hotel_reception_130fe655"
msgid "Et quant à ton putain de gamin qui vit chez toi, ça dégage !"
msgstr "Còn cái thằng con giời đang sống ở nhà em, nó sẽ phải cút đi!"

#. Character:`netoru`
msgctxt "love_hotel_reception_aa4fb6dd"
msgid "Et le plus excitant dans tout ça, c'est que c'est toi qui le jetteras de la maison !"
msgstr "Và cái điều tuyệt vời nhất sẽ là thấy chính em là người tống nó ra khỏi nhà!"

#. Character:`netoru`
msgctxt "love_hotel_reception_f7d7e10e"
msgid "Mais pas avant que vous ne soyez enceintes, toi et ta fille !"
msgstr "Nhưng mà, phải khiến cho cả em và con gái em, mang thai trước đã!"

#. Character:`netoru`
msgctxt "love_hotel_reception_0026503c"
msgid "Je préfère maximiser l'effet dramatique."
msgstr "Khà, anh rất thích làm cường đại yếu tố hồi hộp."

#. Character:`yasuka`
msgctxt "love_hotel_reception_c88979b0"
msgid "Mmmmh..."
msgstr "Mmmmh..."

#. Character:`netoru`
msgctxt "love_hotel_reception_608f6725"
msgid "Voilà ! C'est ça ! Réveille-toi doucement !"
msgstr "Đúng rồi! Đúng rồi! tỉnh dậy đi, từ từ thôi !"

#. Character:`netoru`
msgctxt "love_hotel_reception_8b301334"
msgid "Regarde qui est là pour toi."
msgstr "Nhìn xem ai đang ở đây với em này."

#. Character:`netoru`
msgctxt "love_hotel_reception_d5dd62a0"
msgid "C'est ça, ouvre les yeux !"
msgstr "Nào, hãy mở mắt ra đi!"

#. Character:`netoru`
msgctxt "love_hotel_reception_8043d0b0"
msgid "Et devient ma chose !"
msgstr "Và trở thành một cái sextoy đúng nghĩa, muahahaha!"

#. Character:`yasuka`
msgctxt "love_hotel_reception_0ab160dd"
msgid "Où suis-je..?"
msgstr "Tôi đang ở đâu đây...?"

#. Character:`netoru`
msgctxt "love_hotel_reception_4938aa36"
msgid "Tu es..."
msgstr "Em, đang ở..."

#. Character:`saito`
msgctxt "love_hotel_reception_ebe43823"
msgid "ESPÈCE DE PUTAIN D'ORDURE !"
msgstr "THẰNG CHÓ CHẾT KHỐN NẠN!"

#. Character:`netoru`
msgctxt "love_hotel_reception_c2e702bb"
msgid "Qu-"
msgstr "Cái-"

#. Character:`saito`
msgctxt "love_hotel_reception_66cc442c"
msgid "NE POSE PLUS JAMAIS LA MAIN OU LE REGARD SUR ELLE !"
msgstr "TAO CẤM MÀY DÙNG CON MẮT HAY BÀN TAY BẨN THỈU CỦA MÀY MỘT LẦN NỮA!"

#. Character:`saito`
msgctxt "love_hotel_reception_4abdc955"
msgid "SINON T'ES UN HOMME MORT !"
msgstr "NẾU MÀY CÒN MUỐN GIỮ CÁI MẠNG CỨT NHÀ MÀY!"

#. Character:`saito`
msgctxt "love_hotel_reception_5f3515fd"
msgid "{{yasuka.n}} est-ce que ça va ?"
msgstr "{{yasuka.n}}, cô có ổn không?"

#. Character:`yasuka`
msgctxt "love_hotel_reception_a8559f90"
msgid "Oui !"
msgstr "Có!"

#. Character:`saito`
msgctxt "love_hotel_reception_5f9291d7"
msgid "Tout va bien à présent, cette ordure a voulu abuser de toi, mais j'ai réussi à arriver à temps !"
msgstr "Ổn rồi cô ạ. Thằng khốn này đang muốn lợi dụng cô, nhưng con ở đây với cô rồi!"

#. Character:`yasuka`
msgctxt "love_hotel_reception_a48a2f8f"
msgid "Ouiii !"
msgstr "Cóooò!"

#. Character:`netoru`
msgctxt "love_hotel_reception_f28a3d27"
msgid "Ugggh... Vous me le paierez !"
msgstr "Hự... Mày sẽ phải trả giá!"

#. Character:`netoru`
msgctxt "love_hotel_reception_426705ac"
msgid "Je vous garantis que vous n'avez pas fini d'entendre parler de moi !"
msgstr "Tao thề rằng, mày vẫn chưa nếm mùi cồn bài tẩy của tao đâu!"

#. Character:`saito`
msgctxt "love_hotel_reception_c7e31045"
msgid "Ne vous approchez plus jamais d'elle ou c'est vous qui le regretterez !"
msgstr "Cứ thử đến gần cô ấy một lần nữa xem, rồi biết ai mới phải nếm mùi ai!"

#. Character:`netoru`
msgctxt "love_hotel_reception_c963b252"
msgid "C'est ce qu'on verra gamin !"
msgstr "Ồ, thằng nhãi à, rồi chúng ta sẽ sớm biết cả thôi!"

#. Character:`saito` | Attributes:`sad`
msgctxt "love_hotel_reception_5315ae5a"
msgid "C'est enfin terminé, je ne te quitte plus maintenant !"
msgstr "Tất cả kết thúc rồi, con sẽ không để cô rời xa con một lần nữa!"

#. Character:`saito`
msgctxt "love_hotel_reception_67283c1a"
msgid "Tu veux qu'on rentre à la maison ?"
msgstr "Cô có muốn về nhà không?"

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "love_hotel_reception_d9310299"
msgid "Non..."
msgstr "Khônggg..."

#. Character:`yasuka`
msgctxt "love_hotel_reception_57099805"
msgid "Montre-moi combien tu m'aimes."
msgstr "Cho mẹ thấy con yêu mẹ nhiều đến mức nào điii."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "love_hotel_reception_0cd9441c"
msgid "Prends-moi sur ce lit tout de suite !"
msgstr "Đè mẹ ra...Địt mẹ ngày trên chiếc giường này, ngày tại đây!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "love_hotel_reception_28be656a"
msgid "{{yasuka.n}}, tu as été droguée !"
msgstr "{{yasuka.n}}, cô đang bị chuốc thuốc!"

#. Character:`saito`
msgctxt "love_hotel_reception_54d1b13a"
msgid "Ce que tu ressens actuellement n'est que le résultat de cette drogue."
msgstr "Những cảm xúc mà cô đang cảm thấy lúc này chỉ là tác dụng của thuốc mà thôi."

#. Character:`yasuka`
msgctxt "love_hotel_reception_087ff8b7"
msgid "Mon chéri, j'ai entendu, mais ce que je ressens au fond de moi..."
msgstr "Con yêu, mẹ biết chứ, nhưng sâu thẳm trong trái tim mẹ..."

#. Character:`yasuka`
msgctxt "love_hotel_reception_b4c36164"
msgid "Je t'aimais depuis déjà bien longtemps, mais par peur du regard des autres, par peur de la réaction de {{noriko.n}}..."
msgstr "Mẹ đã yêu con, từ rất lâu rồi, nhưng mẹ sợ mọi người nói ra nói vào, mẹ sợ {{noriko.n}} sẽ căm tức..."

#. Character:`yasuka`
msgctxt "love_hotel_reception_d58a41bd"
msgid "J'ai toujours enfoui ce que je ressentais au plus profond de mon cœur."
msgstr "Mẹ luôn chôn giấu những điều mẹ hằng mong ước vào sâu thẳm trong tim."

#. Character:`yasuka`
msgctxt "love_hotel_reception_07a90e61"
msgid "{{saito.n}}... Tu es un devenu un homme, bon, généreux, prêt à tout pour me défendre."
msgstr "{{saito.n}}... Con đã lớn khôn, là một chàng trai nghĩa khí, hào hiệp, và đã sẵn sàng đi tới cùng trời cuối đất để cứu mẹ."

#. Character:`yasuka`
msgctxt "love_hotel_reception_14d496ff"
msgid "Cette chose n'a fait que débloquer ce que je ressentais déjà, je n'ai jamais eu les idées aussi claires depuis longtemps."
msgstr "Cái mớ thuốc này chỉ thúc đẩy mẹ thổ lộ những điều mẹ cất giấu bấy lâu nay. Mẹ chưa bao giờ cảm thấy tỉnh táo và sảng khoái hơn bây giờ."

#. Character:`yasuka`
msgctxt "love_hotel_reception_dc7f1bc7"
msgid "Je te veux et c'est tout ce qui m'importe."
msgstr "Tất cả những gì mẹ cần biết đấy là, mẹ muốn con, ngay lúc này."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "love_hotel_reception_43bcb898"
msgid "Tu ne veux pas de moi ?"
msgstr "Con không ham muốn mẹ saooo?"

#. Character:`narrator`
msgctxt "love_hotel_reception_a1a5481a"
msgid "Bordel {{yasuka.n}}, que veut que je réponde face à une telle question ?!"
msgstr "{{yasuka.n}} ơi, cô muốn con phải trả lời như thế nào chứ?!"

#. Character:`saito`
msgctxt "love_hotel_reception_af71d4c8"
msgid "Bien sûr que je veux de toi."
msgstr "Tất nhiên là con muốn cô rồi."

#. Character:`saito`
msgctxt "love_hotel_reception_d30d24c4"
msgid "Je pense que c'est trop tard pour revenir en arrière..."
msgstr "Có vẻ như đã quá muộn để quay đầu rồi nhể..."

#. Character:`saito`
msgctxt "love_hotel_reception_e12e539e"
msgid "Si c'est {{saito.n}} que tu veux... Il est tout à toi à présent !"
msgstr "Nếu như mày muốn thì, {{saito.n}}... Cô ấy là của mày cả đấy!"

#. Character:`saito` | Attributes:`surprised`
msgctxt "love_hotel_reception_f6df30b3"
msgid "Oh, tu ne perds pas de temps !"
msgstr "Có vẻ như cô rất mong chờ chuyện này nhỉ!"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "love_hotel_reception_767dad0e"
msgid "Tu n'avais pas compris quand j'ai dit \"tout de suite\" ?"
msgstr "Con không hỉu khi mẹ nói là \"ngay bây giờ\" saooo?"

#. Character:`centered`
msgctxt "love_hotel_reception_469ad42a"
msgid "{{yasuka.n}} ne perdit pas une seconde et sauta sur {{saito.n}} à peine venait-il de se déshabiller."
msgstr "Lập tức, {{yasuka.n}} lao tới và vồ vập lấy {{saito.n}} ngay sau khi cậu cởi xong cái quần."

#. Character:`yasuka`
msgctxt "love_hotel_reception_d7633528"
msgid "Mmmmh, oui, c'est ça !"
msgstr "Mmmh, ah, tuyệt quá à !"

#. Character:`yasuka`
msgctxt "love_hotel_reception_7db6ef59"
msgid "C'est ça qu'il me fallait."
msgstr "Thật đúng thứ mẹ cần!"

#. Character:`saito`
msgctxt "love_hotel_reception_2ab8b4cd"
msgid "Hier soir n'était pas suffisant ?"
msgstr "Đêm trước chưa đủ hay sao?"

#. Character:`yasuka`
msgctxt "love_hotel_reception_009af4b7"
msgid "Mmmhh non..."
msgstr "Mmmh, ôi..."

#. Character:`yasuka`
msgctxt "love_hotel_reception_170fc1ae"
msgid "Je voulais rester en toi, je ne voulais pas partir travailler."
msgstr "Mẹ không muốn đi làm đâu. Mẹ muốn con ở bên trong mẹ."

#. Character:`yasuka`
msgctxt "love_hotel_reception_ee9228f5"
msgid "Je ne pensais qu'à toi !"
msgstr "Trong đầu mẹ chỉ mỗi tơ tưởng về con thuiii !"

#. Character:`yasuka`
msgctxt "love_hotel_reception_e416a83a"
msgid "Changeons de position, je veux te sentir davantage au fond de moi !"
msgstr "Đổi tư nhế, nhé ? Mẹ muốn... sâu hơn nữa... bên trong !"

#. Character:`yasuka`
msgctxt "love_hotel_reception_6a4272c0"
msgid "Oh oui, oui, oui !"
msgstr "Hhh, ah, ah, ah !"

#. Character:`yasuka`
msgctxt "love_hotel_reception_17f03b3a"
msgid "C'est parfait !"
msgstr "Sướng quá !"

#. Character:`yasuka`
msgctxt "love_hotel_reception_ffa8294d"
msgid "Plus fort !"
msgstr "Mạnh nữa !"

#. Character:`yasuka`
msgctxt "love_hotel_reception_8d5fbbcb"
msgid "Encore plus fort !"
msgstr "Thúc mạnh vào !"

#. Character:`yasuka`
msgctxt "love_hotel_reception_c42b7ec7"
msgid "ENCORE !"
msgstr "MẠNH NỮA VÀOOO !"

#. Character:`yasuka`
msgctxt "love_hotel_reception_431eb3d7"
msgid "Oh mon Dieu..."
msgstr "Ôi... trời... ơi..."

#. Character:`yasuka`
msgctxt "love_hotel_reception_d333251e"
msgid "Tu es infatigable !"
msgstr "Con... khỏe thật đó !"

#. Character:`saito`
msgctxt "love_hotel_reception_30579c8b"
msgid "Oui... Mais laisse-moi juste..."
msgstr "Dạ... Nhưng... hãy để... con..."

#. Character:`saito`
msgctxt "love_hotel_reception_8e4560a8"
msgid "Reprendre...[w] mon souffle"
msgstr "Thở...[w] Thở chút... đã..."

#. Character:`yasuka`
msgctxt "love_hotel_reception_38db84cc"
msgid "Han... Han... Je comprends."
msgstr "Hah... Hah... Mẹ... cũng muốn..."

#. Character:`yasuka`
msgctxt "love_hotel_reception_d56581a4"
msgid "Mais... J'ai une irrésistible envie..."
msgstr "Nhưng mà... nứng lắm... muốn thử..."

#. Character:`saito`
msgctxt "love_hotel_reception_88c39d86"
msgid "...Dis toujours"
msgstr "... Là... gì vậy... mẹ ?"

#. Character:`yasuka`
msgctxt "love_hotel_reception_cf875faa"
msgid "Sers-toi de ma bouche comme si c'était..."
msgstr "Dùng miệng của mẹ..."

#. Character:`saito`
msgctxt "love_hotel_reception_b14bf260"
msgid "..."
msgstr "..."

#. Character:`yasuka`
msgctxt "love_hotel_reception_59bb8bd9"
msgid "Mmhm, mmhh, mhhhh, ouiii ! Mmhh !"
msgstr "Mmhm, mmmh, ứm, ứm, schlurp, mmmh!"

#. Character:`yasuka`
msgctxt "love_hotel_reception_ffa8294d_1"
msgid "Plus fort !"
msgstr "Puah... Mạnh nữa vào !"

#. Character:`yasuka`
msgctxt "love_hotel_reception_56ba779d"
msgid "Donne-moi tout, je veux tout avaler !"
msgstr "Mẹ muốn nuốt cả đống tinh béo ngậy của con !"

#. Character:`centered`
msgctxt "love_hotel_reception_1f06ff4c"
msgid "Ils continuèrent tous les deux jusqu'au petit matin."
msgstr "Bọn họ phệt nhau cho tới sáng."

#. Character:`centered`
msgctxt "love_hotel_reception_344009ee"
msgid "Pendant ce temps-là..."
msgstr "Trong lúc đấy thì..."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "love_hotel_room_aba9bb9b"
msgid "Eh bien, j'ai failli attendre !"
msgstr "Con khiến ta chờ lâu quá đó !"

#. Character:`saito`
msgctxt "love_hotel_room_c11ec3a7"
msgid "Je suis désolé, j'essayais d'être discret en quittant la maison."
msgstr "Con xin lỗi, chỉ là con vừa cố gắng ra khỏi nhà một cách thật yên tĩnh."

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "love_hotel_room_13157873"
msgid "Nous n'avons plus beaucoup de temps devant nous !"
msgstr "Chùng ta không còn nhiều thời gian đâu !"

#. Character:`yasuka`
msgctxt "love_hotel_room_dc8293d8"
msgid "J'ai envie de toi tout de suite !"
msgstr "Ta muốn con, ngay bây giờ !"

#. Character:`saito` | Attributes:`surprised`
msgctxt "love_hotel_room_9dec949e"
msgid "À vos ordres !"
msgstr "Như mẹ muốn !"

#. Character:`yasuka`
msgctxt "love_hotel_room_6ac33929"
msgid "J'ai cru que tu ne viendrais jamais !"
msgstr "Ta tưởng con không đến !"

#. Character:`saito`
msgctxt "love_hotel_room_fe658caf"
msgid "Je n'aurais raté ça pour rien au monde."
msgstr "Có chết con cũng không bỏ lỡ."

#. Character:`yasuka`
msgctxt "love_hotel_room_54fda827"
msgid "Je n'en pouvais plus, j'étais bien trop excitée."
msgstr "Ta không thể chịu được nữa. Ta... nứng lắm rồi."

#. Character:`yasuka`
msgctxt "love_hotel_room_3992bb78"
msgid "Te sentir en moi... comme ça..."
msgstr "Con... ở sâu bên trong ta..."

#. Character:`yasuka`
msgctxt "love_hotel_room_283c7dca"
msgid "Mmmh..."
msgstr "Mmmh..."

#. Character:`yasuka`
msgctxt "love_hotel_room_312b2ad4"
msgid "Oh oui..."
msgstr "Ahhh..."

#. Character:`yasuka`
msgctxt "love_hotel_room_00beb0e5"
msgid "Je te sens... plus fort encore."
msgstr "Sướng quá... Nữa, nữa đi..."

#. Character:`yasuka`
msgctxt "love_hotel_room_42b624f8"
msgid "Ne me ménage pas, tu peux y aller à fond."
msgstr "Địt mẹ! Mạnh vào ! Tới bến đi !"

#. Character:`saito`
msgctxt "love_hotel_room_04309e2a"
msgid "Comme tu voudras, j'accélère !"
msgstr "Như... mẹ muốn, địt mẹ tới chết luôn !"

#. Character:`yasuka`
msgctxt "love_hotel_room_c495f740"
msgid "Voilà ! Comme ça !"
msgstr "Ahh ! Gyah ! Hah !"

#. Character:`yasuka`
msgctxt "love_hotel_room_9f4bf154"
msgid "Ohlala..."
msgstr "Ưm, ưm, ứm..."

#. Character:`yasuka`
msgctxt "love_hotel_room_93fc313d"
msgid "J'envie ta jeunesse."
msgstr "Trẻ... khỏe quá... à."

#. Character:`yasuka`
msgctxt "love_hotel_room_b64ae561"
msgid "Tu es infatigable !"
msgstr "Dộng mạnh nữa lên !"

#. Character:`saito`
msgctxt "love_hotel_room_c1ff5a48"
msgid "Honnêtement, je trouve que tu ne te débrouilles pas si mal non plus."
msgstr "Mẹ dâm quá đấy, để con trai mẹ đè mẹ ra như thế, này !"

#. Character:`saito`
msgctxt "love_hotel_room_ec2e6a46"
msgid "D'ailleurs si tu me permets..."
msgstr "Mà, nếu như mẹ muốn..."

#. Character:`yasuka`
msgctxt "love_hotel_room_df86e29b"
msgid "Tu peux faire ce que tu veux de moi mon chéri !"
msgstr "Con yêu, đỊt mẹ... thế nào cũng được !"

#. Character:`yasuka`
msgctxt "love_hotel_room_338c6fdc"
msgid "Mmmh, mmmmh, mmmh..."
msgstr "Mmmh, mmmmh, mmmh..."

#. Character:`yasuka`
msgctxt "love_hotel_room_fa538d77"
msgid "Ouii, mmmh..."
msgstr "Ưá... mmmh..."

#. Character:`saito`
msgctxt "love_hotel_room_2f058750"
msgid "Je... jouis !"
msgstr "Con... ra đâyyy !"

#. Character:`yasuka`
msgctxt "love_hotel_room_ec13d087"
msgid "Mmh, mmmh !"
msgstr "Ahhh, ấm... quá !"

#. Character:`yasuka`
msgctxt "love_hotel_room_0b852814"
msgid "Hihi ! Cette petite séance m'a redonnée la forme."
msgstr "Hehe ! Làm nhiều có khi giảm được cân ấy nhỉ."

#. Character:`yasuka`
msgctxt "love_hotel_room_d2fc6189"
msgid "Je serais bien restée avec toi jusqu'au petit matin, mais je dois hélas retourner travailler encore un peu."
msgstr "Ước chi ta có thể nằm với con tới sáng, nhưng đã tới giờ ta phải đi làm rồi."

#. Character:`saito`
msgctxt "love_hotel_room_8e2de8f6"
msgid "Je sais... Je promets de travailleur dur de mon côté afin que nous puissions rembourser ces dettes le plus vite possible."
msgstr "Con... con cũng sẽ cố gắng nữa, để có thể trả hết đống nợ sớm nhất có thể."

#. Character:`yasuka`
msgctxt "love_hotel_room_b6d1438d"
msgid "J'ai enfin l'impression de voir le bout du tunnel."
msgstr "Một ánh sáng nơi cuối đường hầm, là con đó, con yêu à !"

#. Character:`yasuka` | Attributes:`moved`
msgctxt "love_hotel_room_f5ad11f1"
msgid "Je pourrais enfin envisager ma vie après tout ça... avec toi !"
msgstr "Một cuộc đời... bên cạnh... anh !"

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "love_hotel_room_3a39595b"
msgid "Mince, je suis en retard, je dois me dépêcher, passe une bonne nuit mon chéri !"
msgstr "Chết chửa, muộn quá rồi. Ta phải đi làm thôi ! Ngủ ngon nhé, con yêu !"

#. Character:`sayuri`
msgctxt "t4fa8767a10"
msgid "Qu'est-ce que tu fabriques ?"
msgstr "Cô đang làm gì vậy ạ ?"

#. Character:`sayuri`
msgctxt "t721a12b9ca"
msgid "Enlève-moi tous ces vêtements et en vitesse !"
msgstr "Cởi quần áo chứ làm gì nữa ! Nhanh nào !!"

#. Character:`saito` | Attributes:`guilty`
msgctxt "tea8c878fbb"
msgid "Oh euh... très bien !"
msgstr "Ầu... Okii~ !"

#. Character:`sayuri`
msgctxt "t2e798b9801"
msgid "Pousse-moi sur le lit et prends moi comme la dernière fois !"
msgstr "Ấn cô xuống nệm như hồi trước đi !"

#. Character:`saito`
msgctxt "t341f1904ac"
msgid "Tu n'avais même pas besoin de demander."
msgstr "Chẳng cần phải hỏi luôn."

#. TRANSLATORS: Idle Character:`sayuri`
msgctxt "tb68de8c035"
msgid "Aller !"
msgstr "Nhanh nào !"

#. Character:`saito`
msgctxt "t15793825b8"
msgid "Tu es bien trop exigeante."
msgstr "Đúng là một cậu bé tinh nghịch."

#. Character:`sayuri`
msgctxt "t61b6d2a7e6"
msgid "S'il te plaît !!!"
msgstr "Xin cô đó !!!"

#. TRANSLATORS: Vaginal slow (transition auto: 1.15s) Character:`sayuri`
msgctxt "t0452dc68ff"
msgid "Merci..."
msgstr "Cảm ơn..."

#. Character:`saito`
msgctxt "t6d3c6a0ea7"
msgid "J'aime bien quand tu es plus docile."
msgstr "Ta thích những cậu bé ngoan ngoãn hơn."

#. TRANSLATORS: Vaginal medium Character:`sayuri`
msgctxt "tc9dda231f6"
msgid "N'en profite pas trop..."
msgstr "Đừng có vồ vập quá nha..."

#. Character:`sayuri`
msgctxt "t9bc481e323"
msgid "Je pourrais refuser de..."
msgstr "Kẻo cô bỏ về đấy..."

#. Character:`saito`
msgctxt "t060178e3b3"
msgid "Refuser... ?"
msgstr "Bỏ về ạ...?"

#. TRANSLATORS: Vaginal fast Character:`saito`
msgctxt "t5015be7cf0"
msgid "Tu voudrais refuser ça ?"
msgstr "Liệu cô có muốn về không ?"

#. Character:`sayuri`
msgctxt "t5bcfe4757c"
msgid "..."
msgstr "..."

#. Character:`sayuri`
msgctxt "t46118fe640"
msgid "Non pardon..."
msgstr "Có lẽ không..."

#. Character:`sayuri`
msgctxt "t8992dbb548"
msgid "J'ai l'impression d'avoir retrouvé ma jeunesse..."
msgstr "Cô cảm giác như được sống lại tuổi thanh xuân thiếu nữ..."

#. Character:`sayuri`
msgctxt "t719c9e51e9"
msgid "Et d'être complètement à ta merci."
msgstr "Hoàn toàn trong nanh vuốt của chú sói này đây."

#. TRANSLATORS: Anal slow (transition auto: 2.167s) Character:`saito`
msgctxt "td8e104e2ef"
msgid "Et c'est le cas !"
msgstr "Vậy đó !"

#. Character:`sayuri`
msgctxt "t78bf8df98a"
msgid "Oh !"
msgstr "Oh !"

#. Character:`saito`
msgctxt "tbd612ee251"
msgid "Plus fort ?"
msgstr "Mạnh hơn nữa ạ ?"

#. Character:`sayuri`
msgctxt "t95cd12ef54"
msgid "Oui !"
msgstr "Vâng !2"

#. TRANSLATORS: Anal medium Character:`saito`
msgctxt "t9243503098"
msgid "Être à ma merci est si désagréable que ça ?"
msgstr "Nắm dưới thoải mái đến vậy ạ ?"

#. Character:`sayuri`
msgctxt "t79e498ee09"
msgid "... Au contraire."
msgstr "...Nói thật"

#. Character:`sayuri`
msgctxt "t0a58612f9f"
msgid "J'ai peur de devenir accro."
msgstr "Cô sợ là cô sẽ nghiện điều này mất."

#. TRANSLATORS: Anal fast Character:`saito`
msgctxt "t132de3fe23"
msgid "Dans ce cas, je ne vois pas en quoi c'est un problème."
msgstr "Nếu vậy thì phải biến cô thành con nghiện thôi."

#. Character:`saito`
msgctxt "t21522d2fa7"
msgid "Je compte bien ne pas m'arreter !"
msgstr "Nhận lấy này !"

#. Character:`sayuri`
msgctxt "t4053b4107d"
msgid "... J'espère bien."
msgstr "...Cô hy vọng."

#. Character:`noriko`
msgctxt "home_player_hallway_5e3d8ecb"
msgid "Arrête-toi là !"
msgstr "Đứng lại đấy !"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_player_hallway_5babb8df"
msgid "... ?!"
msgstr "...?!"

#. Character:`noriko`
msgctxt "home_player_hallway_3d7e3814"
msgid "Tu crois que j'ai pas entendu ?"
msgstr "Mày nghĩ là tao câm mù điếc, hả?"

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_hallway_17a4af5f"
msgid "Pour qui tu te prends ?!"
msgstr "Mày nghĩ mày là cái thá gì ?!"

#. Character:`noriko`
msgctxt "home_player_hallway_874c4d08"
msgid "Ça ne te suffit plus d'accaparer toute l'attention ?"
msgstr "Cuỗm hết mọi sự chú ý đối với mày chưa đủ hay sao ?"

#. Character:`noriko`
msgctxt "home_player_hallway_339ae4d9"
msgid "Donc maintenant, si j'ai bien compris, monsieur est l'homme de la maison et prend les décisions importantes pour nous ?"
msgstr "Thế bây giờ mày là thế ấy hở ? Mày giờ là vương là tướng cái nhà này rồi chứ gì ? Giờ mày rảnh háng thích đi quản lối sống nhà này phải không ?"

#. Character:`noriko`
msgctxt "home_player_hallway_3d0030d7"
msgid "Mêle-toi de tes affaires... Va donc te faire racketter comme d'habitude..."
msgstr "Sao mày không ngậm cái mõm chó của mày lại đi ?"

#. Character:`noriko`
msgctxt "home_player_hallway_a9dd75a0"
msgid "Va faire ce que tu sais faire le mieux, te planquer !"
msgstr "Đi mà quay về trốn chui trốn nhũi trong cái hang lổm ngổm giòi bọ của mày đi !"

#. Character:`noriko`
msgctxt "home_player_hallway_1765b269"
msgid "C'est à cause de ta putain de famille de déchets, et de tous vos problèmes à la con qu'on se retrouve dans la merde."
msgstr "Tất cả là tại cái gia đình lồn cặc của mày mà giờ nhà tao ngập ngụa trong cứt."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_player_hallway_27f95ee9"
msgid "Tu veux l'empêcher de bosser ?"
msgstr "Mày muốn cấm mẹ làm việc nữa ớ hở ?"

#. Character:`noriko`
msgctxt "home_player_hallway_03fda596"
msgid "Depuis quand tu te soucies de ma réputation ?"
msgstr "Và mày bắt đầu thích chõ mũi vào đời sống của tao từ bao giờ vậy ?"

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_hallway_ce48cc3e"
msgid "DE QUOI TU TE MÊLES SÉRIEUX ?!"
msgstr "TỪ NÃY TỚI GIỜ MÀY XÀM LỒN CÁI CON CẶC GÌ THẾ ?!"

#. Character:`noriko`
msgctxt "home_player_hallway_fb89f97c"
msgid "Tu penses pouvoir gagner plus qu'une hôtesse ?"
msgstr "Mày nghĩ mày kiếm được tiền gồng gánh cái nhà này hả ?"

#. Character:`noriko` | Attributes:`-angry`
msgctxt "home_player_hallway_ec49d13b"
msgid "Qu'est-ce que tu vas faire ? Vendre ton cul sur le toit de la fac ?"
msgstr "Bảo mẹ ở nhà thế mày định làm con cặc gì ? Bán trinh đuýt mày trong WC đại học hả?"

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_hallway_f616cfdf"
msgid "Toujours là à rester silencieux..."
msgstr "Lúc nào cũng câm như hến..."

#. Character:`noriko`
msgctxt "home_player_hallway_a5a378c8"
msgid "Toujours là à jouer ta putain de victime !"
msgstr "Người ta đánh thì co rúm lại !"

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_player_hallway_d58f5e99"
msgid "Donc maintenant, c'est à toi qu'elle demande des conseils sur sa vie professionnelle ?"
msgstr "Giờ mày lại thích đi tư vấn nghề nghiệp cho mẹ cơ á ?"

#. Character:`noriko`
msgctxt "home_player_hallway_14340d42"
msgid "C'est vrai que tu es un véritable modèle..."
msgstr "Mày nghĩ có ai muốn noi theo một cái hình tượng cứt đái như mày không ?"

#. Character:`noriko`
msgctxt "home_player_hallway_353b22b6"
msgid "T'es juste le plus bel hypocrite que j'ai jamais vu !"
msgstr "Không thể nào giả tạo hơn !"

#. Character:`noriko`
msgctxt "home_player_hallway_1d4e5c49"
msgid "Un putain de modèle d'étron vivant !"
msgstr "Một bãi bầy nhầy toàn cứt với đái, mày đấy !"

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_hallway_10371401"
msgid "Tu comptes la laisser bosser toute seule pour rattraper les conneries de votre famille ?"
msgstr "Mày định để mình mẹ gồng gánh cả nhà này trong khi mày ngồi trĩ đuýt ra đấy à, hả ?"

#. Character:`noriko`
msgctxt "home_player_hallway_94a74ee2"
msgid "T'as intérêt à te trouver un job, n'importe quoi !"
msgstr "Cút ra ngoài mà kiếm một công việc đi !"

#. Character:`noriko`
msgctxt "home_player_hallway_ec36bf7b"
msgid "Tu peux même vendre ton cul, j'men fout de..."
msgstr "Bán trình đuýt của mày cũng được, tao đéo quan tâm !"

#. Character:`yasuka`
msgctxt "home_player_hallway_bf20c6b7"
msgid "Alors mes chéris, vous parlez de quoi depuis tout à l'heure ?"
msgstr "Mẹ nghe thấy các con to tiếng, có chuyện gì vậy các con yêu ?"

#. Character:`noriko`
msgctxt "home_player_hallway_7d6db047"
msgid "De rien d'important, maman. Je disais juste à Oni-chan de passer une bonne journée !"
msgstr "Không có gì đâu Mẹ, con chỉ đang chúc anh có một ngày tốt lành thôi !"

#. Character:`yasuka`
msgctxt "home_player_hallway_844496ae"
msgid "Ooh... Tu es toujours aussi adorable ma chérie."
msgstr "Aww, thật đáng yêu và ngọt ngào làm sao."

#. Character:`yasuka` | Attributes:`-happy`
msgctxt "home_player_hallway_8344e235"
msgid "Sur ce, je vous laisse, j'ai tout plein de choses à faire."
msgstr "Ở nhà nhớ bảo ban nhau nhé, mẹ đi làm đây. Có cả một ngày bận rộn trước mắt."

#. Character:`noriko`
msgctxt "home_player_hallway_5db98e75"
msgid "Bonne journée, maman, je sors aussi !"
msgstr "Mẹ đi mạnh khỏe !"

#. Character:`yasuka`
msgctxt "home_player_hallway_5a0d5d39"
msgid "À plus tard vous deux, ne rentrez pas trop tard !"
msgstr "Hai con ở nhà ngoan nhé, đừng ra ngoài lâu quá đấy !"

#. Character:`noriko` | Attributes:`happy`
msgctxt "home_player_hallway_5957a5dc"
msgid "Promit maman !"
msgstr "Vâng thưa mẹ !"

#. Character:`noriko` | Attributes:`-happy`
msgctxt "home_player_hallway_1e9fb289"
msgid "Tu sais quoi ?"
msgstr "Mày biết gì không ?"

#. Character:`noriko`
msgctxt "home_player_hallway_321c0475"
msgid "Si veux vraiment aider, tire-toi et ne reviens jamais ici !"
msgstr "Biến ra gầm cầu mà ở. THế là phước phận nhất cho cái nhà này rồi đấy !"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_player_hallway_c2cffe85"
msgid "..."
msgstr "..."

#. Character:`noriko`
msgctxt "home_player_hallway_e2efdd07"
msgid "Je ferai de ta vie un enfer !"
msgstr "Tao sẽ khiến mày sống không bằng chết !"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_player_hallway_a4fc7493"
msgid "Personnellement, je trouve qu'actuellement, tu te débrouilles déjà très bien."
msgstr "Tao đã cảm thấy điều ấy từ lâu rồi."

#. Character:`noriko`
msgctxt "home_player_hallway_f677f3ea"
msgid "Fais le malin... Mais crois-moi, tu n'as encore rien vu..."
msgstr "Cứ nói thế đi, nhưng mà mày chưa thấy hết khả năng của tao đâu..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_hallway_428726db"
msgid "Dégage de là !"
msgstr "Cút cho khuất mắt tao !"

#. Character:`narrator`
msgctxt "t054f10dd07"
msgid "Dans tes rêves {{noriko.n}} !"
msgstr "Mơ đi, {{noriko.n}} !"

#. Character:`noriko`
msgctxt "home_player_hallway_25d48ba9"
msgid "QUOI ?!"
msgstr "CÁI CON CẶC GÌ CƠ ?!"

#. Character:`saito`
msgctxt "home_player_hallway_511fa463"
msgid "Et toi, tu fais quoi ? Tu vas rester là à attendre sans rien faire ?"
msgstr "Tao mà là vấn đề á ? Mẹ mày thì đâm đầu vào làm việc tới kiệt sức, còn mày thì ngồi rạng háng ra đấy mà chửi đổng."

#. Character:`noriko`
msgctxt "home_player_hallway_1b4e3b84"
msgid "DE QUOI TU TE M-"
msgstr "MÀY DÁM-"

#. Character:`saito`
msgctxt "home_player_hallway_aa2eb4a0"
msgid "On est tous dans la merde, toi, moi, {{yasuka.n}}..."
msgstr "Tất cả chúng ta đều chung một thuyền, Tao, mày và cô {{yasuka.n}}..."

#. Character:`saito`
msgctxt "home_player_hallway_6b3c93cb"
msgid "Donc au lieu de me casser les couilles avec quelque chose dont je ne suis pas responsable."
msgstr "Thế nên thay vì suốt ngày đi bóp dái tao..."

#. Character:`saito`
msgctxt "home_player_hallway_368d4dc1"
msgid "Pourquoi tu n'irais pas toi le vendre ton cul ?"
msgstr "Sao mày không tự đi bán trinh đi ? Cái lồn mày có khối đứa húp đấy !"

#. Character:`noriko`
msgctxt "home_player_hallway_29cd7803"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_hallway_999598bf"
msgid "VA TE FAIRE FOUTRE !"
msgstr "ĐI CHẾT CON ĐĨ MẸ MÀY ĐI ! CÁI CỤC CỨT PHẾ VẬT, CẶC LỒN GIANG MAI SÙI MÀO GÀ !!!"

#. Character:`narrator`
msgctxt "home_player_hallway_c3972cd8"
msgid "Je dois absolument garder mon calme avec elle, sinon ça va vraiment dégénérer."
msgstr "Mình cần phải thật chill với con bé, không là tiêu diêu miền cực lạc ngay."

#. Character:`narrator`
msgctxt "t43dc392295"
msgid "Va te faire foutre {{noriko.n}} !"
msgstr "Đụ con đĩ mẹ mày {{noriko.n}} !"

#. Character:`asami` | Attributes:`happy`
msgctxt "home_player_hallway_49c1fc56"
msgid "Merci encore pour tout !"
msgstr "Cảm ơn cô vì bữa cơm ấm cúng hôm nay ạ !"

#. Character:`yasuka`
msgctxt "home_player_hallway_f6bd99d9"
msgid "De rien, tu es la bienvenue ici."
msgstr "Không có chi ! Cứ hôm nào rảnh thì ghé qua chơi nhé."

#. Character:`yasuka`
msgctxt "home_player_hallway_6e3afc0f"
msgid "Tu nous as permis de passer un moment agréable ensemble."
msgstr "Bữa cơm hôm nay có cháu mà ngon hơn hẳn."

#. Character:`asami`
msgctxt "home_player_hallway_632d16c5"
msgid "Je reviendrai alors !"
msgstr "Vậy cháu sẽ sớm quay lại ạ !"

#. Character:`noriko`
msgctxt "home_player_hallway_f43b8e32"
msgid "T'as plutôt intérêt!"
msgstr "Chị nhớ rùi đấy nhé !"

#. Character:`yasuka`
msgctxt "home_player_hallway_27c8a25e"
msgid "Raccompagne-la chez elle mon chéri."
msgstr "Dẫn bạn về nhà nhé con yêu."

#. Character:`saito`
msgctxt "home_player_hallway_ebdfe4d3"
msgid "Bien sûr."
msgstr "Chắc hắn rồi ạ."

#. Character:`asami`
msgctxt "home_player_hallway_1f2ac548"
msgid "Aller mon chéri !"
msgstr "Đi thui nào, con yêu !"

#. Character:`saito`
msgctxt "home_player_hallway_af382927"
msgid "Pff, tu rates jamais une occasion de l'ouvrir toi."
msgstr "Khì khì, bà cũng biết ăn nói đấy nhể."

#. Character:`noriko`
msgctxt "home_player_hallway_6a4409b1"
msgid "Tu étais pas avec {{asami.n}} aujourd'hui ?"
msgstr "Mày không ở với chị {{asami.n}} hôm nay à ?"

#. Character:`saito` | Attributes:`upset`
msgctxt "home_player_hallway_a02d977c"
msgid "Pourquoi ? Qu'est-ce que ça peut te faire ?"
msgstr "Làm sao ? Mắc mớ gì đến mày đâu mà mày phải xỉa xói ?"

#. Character:`noriko`
msgctxt "home_player_hallway_ee7bb51a"
msgid "Pour une fois que tu traînes avec quelqu'un d'intéressant... ça change !"
msgstr "Lần đầu tiên có một đứa chịu đi hú hí với bây... Động trời !"

#. Character:`noriko`
msgctxt "home_player_hallway_2db80a87"
msgid "Ou plutôt... qui te trouve intéressant."
msgstr "Ít nhất là... bà chị ấy có hứng thú với mày."

#. Character:`saito`
msgctxt "home_player_hallway_a55fcdf9"
msgid "...[w] Je vais me retenir d'être vulgaire."
msgstr "...[w] Tao sẽ cố gắng để không thô bỉ với mày từ nay về sau."

#. Character:`noriko`
msgctxt "home_player_hallway_1b0c2ca2"
msgid "... et donc ? Tu étais pas avec elle ?!"
msgstr "... thế sao rồi nào ? Không ở cùng với chị ấy à ?!"

#. Character:`saito` | Attributes:`angry`
msgctxt "home_player_hallway_930b6b5b"
msgid "Mais bon sang fous-moi la paix, elle est rentrée avec {{minato.n}} !"
msgstr "Mẹ, để tao yên đi mày ! Bả đi về với {{minato.n}} rồi !"

#. Character:`noriko`
msgctxt "home_player_hallway_8101edc7"
msgid "Quoi ?! Pourquoi tu l'as laissée avec ce type ?"
msgstr "Đéo gì ?! Sao mày để chị ấy đi với thằng nớ ?"

#. Character:`saito`
msgctxt "home_player_hallway_3d9a9120"
msgid "{{asami.n}} ne m'appartient pas, c'est pas à moi de lui dire avec qui elle doit traîner ou non !"
msgstr "{{asami.n}} không có thuộc về tao, tao không có quyền kiểm soát người cổ qua lại !"

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_hallway_5fe233be"
msgid "Putain plus je t'écoute, plus j'ai l'impression de parler avec un vieux con !"
msgstr "Con mẹ, càng ở với mày, tao càng thấy mày như thằng khọm già lắm điều vậy !"

#. Character:`noriko`
msgctxt "home_player_hallway_c2c8a549"
msgid "Ce type est un connard, et toi tu la laisses partir avec ?!"
msgstr "Hạng thối tha như thằng nớ, sao mày lại để cho chị ấy lấm bùn ?!"

#. Character:`noriko`
msgctxt "home_player_hallway_af6e3668"
msgid "Pfff... T'es vraiment une merde !"
msgstr "Hừ... Thứ ốm o hèn chúa !"

#. Character:`narrator`
msgctxt "home_player_hallway_817a7c6e"
msgid "... Putain mais {{noriko.n}} a raison, qu'est-ce que je branle ici ?!"
msgstr "... Mụ tổ tiên nhân, con {{noriko.n}} nói thế mà đúng. Mình đang làm gì thế này ?!"

#. Character:`narrator`
msgctxt "home_player_hallway_d359978b"
msgid "J'aurais jamais dû les laisser seuls."
msgstr "Đúng ra mình phải theo dõi đôi chúng nó mới phải."

#. Character:`narrator`
msgctxt "home_player_hallway_6095e3a3"
msgid "Non... Arrête ! Je dois lui faire confiance !"
msgstr "Không... Mình phải tin tưởng bà ấy !"

#. Character:`narrator`
msgctxt "home_player_hallway_f773de09"
msgid "J'irai la voir demain et tout sera rentré dans l'ordre."
msgstr "Ngày mai, mình sẽ đi gặp bà ấy, và mọi chuyện sẽ ổn thỏa cả."

#. Character:`narrator`
msgctxt "home_player_hallway_328d84f1"
msgid "J'espère..."
msgstr "Hy vọng vậy"

#. Character:`saito`
msgctxt "home_player_hallway_3a85526f"
msgid "Tu tombes bien, je voulais te parler !"
msgstr "Đúng lúc đấy, tôi có chuyện cần nói với cô !"

#. Character:`saito`
msgctxt "home_player_hallway_ae715815"
msgid "Est-ce que c'est toi qui fais la misère chaque soir à l'autre ordure ?"
msgstr "Có phải cô là người khiến cho lão già kia khốn khổ bữa qua không ?"

#. Character:`noriko`
msgctxt "home_player_hallway_fcacc509"
msgid "Tu veux parler du gros porc ?"
msgstr "Ý anh là con lợn già ấy hả ?"

#. Character:`saito`
msgctxt "home_player_hallway_a2d9697d"
msgid "Oui"
msgstr "Yes"

#. Character:`noriko` | Attributes:`shame`
msgctxt "home_player_hallway_561483c2"
msgid "Je gagne quoi si je te le dis ?"
msgstr "Nếu tiết lộ thì được gì ?"

#. Character:`saito`
msgctxt "home_player_hallway_d6fb6acb"
msgid "Rien"
msgstr "Không gì cả."

#. Character:`saito`
msgctxt "home_player_hallway_2233c458"
msgid "Déjà, je pensais pas que tu serais prête à aller aussi loin pour lui faire peur."
msgstr "Ban đầu thì, tôi không nghĩ là cô sẽ đi xa tới thế để đe doạ hắn ta."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_hallway_28e80257"
msgid "Mais, je dois avouer que, tu as été redoutable."
msgstr "Nhưng mà phải công nhận là cô đáng gờm thật."

#. Character:`saito`
msgctxt "home_player_hallway_5c02c8ea"
msgid "Il est terrifié et certain que quelqu'un en veut à sa vie."
msgstr "Thằng cha đấy sợ chối chết và tin là có kẻ nào đó đang đe đọa tới mạng sống hắn ta."

#. Character:`noriko` | Attributes:`bad`
msgctxt "home_player_hallway_da06a80a"
msgid "C'est tout ce qu'il mérite de toute façon."
msgstr "Lão nhận được những gì lão ấy xứng đáng."

#. Character:`saito`
msgctxt "home_player_hallway_03775ec8_1"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`neutral`
msgctxt "home_player_hallway_555735b4"
msgid "Quoi qu'il en soit, fais attention à toi, ce soir, il sera visiblement déterminé à se venger."
msgstr "Dù sao thì, nhớ cẩn thận đấy. Bởi tối nay là lão ấy tới báo thù đấy."

#. Character:`saito`
msgctxt "home_player_hallway_5809b173"
msgid "Donc, tu ferais mieux de rester tranquillement ici."
msgstr "Thế nên là trốn cho kĩ vào."

#. Character:`noriko` | Attributes:`neutral`
msgctxt "home_player_hallway_98348292"
msgid "Merci du conseil."
msgstr "Cảm ơn vì đã khuyên."

#. Character:`saito`
msgctxt "home_player_hallway_c89ce385"
msgid "Tout de même..."
msgstr "Nhưng mà..."

#. Character:`saito`
msgctxt "home_player_hallway_a7e5a52e"
msgid "Aller jusqu'à remplir sa boite aux lettres avec du sang..."
msgstr "Đổ đầy hộp thư với máu..."

#. Character:`saito` | Attributes:`surprised`
msgctxt "home_player_hallway_042585f2"
msgid "T'es vraiment dingue !"
msgstr "Mày đúng thật điên vãi !"

#. Character:`noriko` | Attributes:`angry`
msgctxt "home_player_hallway_18ff4231"
msgid "Quoi ?! Mais j'ai jamais fait un truc pareil moi !"
msgstr "Clgt?! Nhưng mình đã làm cái khỉ gì đâu !"

#. Character:`noriko`
msgctxt "home_player_hallway_a8bc1a3b"
msgid "Merde, pourquoi je lui ai pas dit que j'avais rien à voir avec ça ?!"
msgstr "Mả mẹ, sao mình không bảo anh ta là mình chả liên quan éo gì tới mấy cái nạn này nhỉ ?!"

#. Character:`noriko` | Attributes:`shame`
msgctxt "home_player_hallway_fdfcc871"
msgid "Idiote !"
msgstr "Ngốc xít !"

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "home_player_hallway_f476574a"
msgid "[font_size=14]Shhhhht, ne dis rien.[/font_size]"
msgstr "[font_size=14]Shhh. Đừng nói gì hết.[/font_size]"

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_hallway_84b757d2"
msgid "[font_size=14]Pourquoi tu parles en chuchotant ?[/font_size]"
msgstr "[font_size=14]Sao cô lại thì thầm?[/font_size]"

#. Character:`yasuka` | Attributes:`happy`
msgctxt "home_player_hallway_fb7f6539"
msgid "[font_size=14]Suis-moi sans faire de bruit jusqu'à la salle de bain.[/font_size]"
msgstr "[font_size=14]Lặng lẽ theo ta tới phòng tắm nhé.[/font_size]"

#. Character:`saito`
msgctxt "home_player_hallway_0cbbbb0c"
msgid "[font_size=14]Okay...[/font_size]"
msgstr "[font_size=14]Được thôi...[/font_size]"

#. Character:`yasuka`
msgctxt "home_player_hallway_521579e2"
msgid "[font_size=14]Je ne veux pas que {{noriko.n}} nous voit entrer tous les deux en même temps.[/font_size]"
msgstr "[font_size=14]{{noriko.n}} mà thấy ta vào phòng tắm cùng nhau thì chếttt.[/font_size]"

#. Character:`saito`
msgctxt "home_player_hallway_f7de69db"
msgid "[font_size=14]Compris ![/font_size]"
msgstr "[font_size=14]Con hiểu rồi![/font_size]"

#. Character:`narrator`
msgctxt "home_player_hallway_b6e3949f"
msgid "En même temps, je ne sais pas à quoi je m'attendais venant d'elle."
msgstr "Không biết là mình mong chờ gì từ con bé nữa."

#. Character:`narrator`
msgctxt "home_player_hallway_425f3945"
msgid "Je pensais sincèrement avoir amélioré ma relation."
msgstr "Hẳn rằng mối quan hệ giữa mình và nó đã tiến triển vượt bậc."

#. Character:`narrator`
msgctxt "home_player_hallway_1b9d58e8"
msgid "Il faut croire que je me faisais des films."
msgstr "Chắc là mình chỉ tự tin quá mức thôi."

#. Character:`narrator`
msgctxt "home_player_hallway_e207ea75"
msgid "Tant pis, je ferai sans elle."
msgstr "Thôi được rồi, sao cũng được, mình sẽ làm mà không có con bé."

#. Character:`narrator`
msgctxt "home_player_hallway_b173ed6f"
msgid "Il me semble qu'il y a une boutique de vêtement d'occasion à côté du Love Hotel."
msgstr "Theo mình nhớ thì có một cửa hàng second hand gần chỗ Tình Phủ."

#. Character:`narrator`
msgctxt "home_player_hallway_35cf9764"
msgid "J'y trouverai peut-être un costume sans trop me ruiner..."
msgstr "Hy vọng mình có thể tìm một bộ vét-tông mà không bị cháy túi..."

#. Character:`narrator`
msgctxt "home_player_hallway_c57a5173"
msgid "Bon sang, j'ai le cœur qui bat à 100 à l'heure..."
msgstr "Vãi cứt thật, tim mình đập muốn nhảy ra khỏi lồng ngực quá..."

#. Character:`narrator`
msgctxt "home_player_hallway_fbb99ae2"
msgid "J'ai tellement pas envie de faire ça."
msgstr "Mình thực sự đéo muốn chuyện này tí nào."

#. Character:`saito`
msgctxt "ASAMI_N_E63280"
msgid "{{asami.n}} ?!!"
msgstr ""

#. Character:`saito` | Attributes:`sad`
msgctxt "PUTAIN_NON_TOUT_MAIS_PAS_A_29060F"
msgid "Putain non, tout mais pas ça !"
msgstr ""

#. Character:`yasuka`
msgctxt "home_player_hallway_220bea08"
msgid "Oh vous rentrez a la maison, ça tombe bien !"
msgstr "A, các con về rồi, mừng quá đi !"

#. Character:`yasuka`
msgctxt "home_player_hallway_f738706a"
msgid "Je dois aller travailler !"
msgstr "Phải đi làm thôi !"

#. Character:`yasuka`
msgctxt "home_player_hallway_5f8aa2ac"
msgid "Il y a un problème à la boutique je dois y aller."
msgstr "Mẹ đi ra Quán Café có chút việc."

#. Character:`yasuka`
msgctxt "home_player_hallway_5b518db7"
msgid "Passez une bonne soirée tous les deux."
msgstr "Hai đứa ở nhà trông nhau tối nay nhé."

#. Character:`noriko`
msgctxt "home_player_hallway_5ae88530"
msgid "Pas de problème maman."
msgstr "Dạ, chúng con lo được ạ !"

#. Character:`yasuka`
msgctxt "home_player_hallway_42f00609"
msgid "Ca me fait plaisir de vous voir aussi complice tous les deux !"
msgstr "Hai con quây quần bên nhau làm mẹ mừng gớt nước mắt lun đó !"

#. Character:`yasuka`
msgctxt "home_player_hallway_f5ccfac7"
msgid "Merci pour tous les efforts que tu fais mon chéri."
msgstr "Cảm ơn con vì mọi nỗ lực con đã bỏ ra, con yêu à."

#. Character:`saito` | Attributes:`happy`
msgctxt "home_player_hallway_e7acca3c"
msgid "Je n'ai pas fait grand chose mais si tu es heureuse c'est le principal."
msgstr "Mẹ biết ơn vì con đã giúp nhà ta biết bao nhiêu, con yêu à."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "home_player_hallway_6ff1d1a5"
msgid "Je trouverai peut-être un moment de libre pour venir te remercier personnellement, qui sait."
msgstr "Thật con cũng chẳng làm gì sất đâu mẹ, nhung mẹ mừng thì con cũng vui."

#. Character:`saito`
msgctxt "home_player_hallway_f86a3991"
msgid "J'ai déjà hâte d'y être."
msgstr "Thật bồn chồn làm sao."

#. Character:`yasuka`
msgctxt "home_player_hallway_90cc1c90"
msgid "Bonne soirée !"
msgstr "Buổi tối tốt lành nhé !"

#. Character:`yasuka`
msgctxt "t195e155c08"
msgid "Mais depuis combien de temps exactement ?"
msgstr "Nhưng mà bao lâu rồi ?"

#. Character:`sayuri`
msgctxt "t5f2b017735"
msgid "COMBIEN ?!"
msgstr "BAO LÂU RỒI Á ?!"

#. Character:`sayuri`
msgctxt "t0884b7cf20"
msgid "Ça fait des années que cette ordure ne m'a emmenée nulle part !"
msgstr "Mấy năm rồi thằng khốn đấy chưa đưa tớ đi đâu hết !"

#. Character:`sayuri`
msgctxt "t7ddadf1bb8"
msgid "La dernière fois ça remonte à 5 ans et c'était parce qu'il avait besoin de moi pour signer des papiers administratifs."
msgstr "Lần cuối cùng là 5 năm trước, mà còn chẳng phải đi chơi cơ, nó chỉ cần tớ đi kí tá giấy tờ !"

#. Character:`sayuri`
msgctxt "t93bf4f8ce8"
msgid "Non ! j'en ai marre !"
msgstr "Không, tớ chán ngấy rồi !"

#. Character:`sayuri`
msgctxt "t214552f682"
msgid "CE TYPE N'EST QU'UN FOUTU BATARD !"
msgstr "THẰNG CHÓ NỚ LÀ CÁI HẠNG CẶN BÃ !"

#. Character:`yasuka` | Attributes:`upset`
msgctxt "tdb30643c11"
msgid "{{sayuri.n}} !"
msgstr "{{sayuri.n}} !"

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "tca45ceaf6f"
msgid "Désolée mais parfois il est important de nommer les choses correctement !"
msgstr "Xin lỗi, nhưng mà... đã quá nhiều rồi..."

#. Character:`sayuri`
msgctxt "te8bbaf61c5"
msgid "Et puis je te rappelle que toi aussi tu as le droit d'être en colère et énervée."
msgstr "Tớ hiểu ý cậu, nhưng cái sự bực tức là không thể tránh khỏi."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "t000b6e0689"
msgid "Je sais..."
msgstr "Tớ cũng hiểu...2"

#. Character:`sayuri`
msgctxt "tf03cbcb7f3"
msgid "Tu n'es pas en colère ? Tu n'as pas envie de..."
msgstr "Cậu không thấy tức sao ? Liệu cậu không muốn..."

#. Character:`yasuka`
msgctxt "t12c6bc7c69"
msgid "Longtemps j'ai eu ce genre de pensées."
msgstr "Suốt bao năm rồi, tớ cứ nung nâu mãi mấy câu chuyện tương tự như này."

#. Character:`yasuka`
msgctxt "teed7b10d4e"
msgid "Ca me rongeait de l'intérieur, je me rendais malheureuse toute seule."
msgstr "Nó gặm nhấm tâm hồn tớ, làm tớ khốn khổ không thôi."

#. Character:`sayuri` | Attributes:`neutral`
msgctxt "t9b0cba68e8"
msgid "Tu as pourtant l'air de quelqu'un en paix avec soi-même."
msgstr "Nhưng mà trông cậu giờ như đang thanh thản vậy."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "t36ed781f2b"
msgid "C'est grâce à {{saito.n}} ! Il m'a aidée à passer autre chose."
msgstr "Tất cả là nhờ {{saito.n}} mà tớ mới có thể bước tiếp."

#. Character:`yasuka`
msgctxt "t8082fc536a"
msgid "Si bien que maintenant je suis enfin heureuse."
msgstr "Sau biết bao nhiêu u buồn, đến giờ, cuối cùng tớ cũng cảm thấy hạnh phúc thực sự."

#. Character:`sayuri` | Attributes:`surprised`
msgctxt "t539ad57f2d"
msgid "...Alors là je suis curieuse, il faudra que tu me dises ce qu'il a fait car je crois que j'en aurais bien besoin aussi !"
msgstr "..Giờ tớ tò mò rồi nha. Kể tớ nghe coi ! Có khi tớ cũng phải mượn nó vài hôm mới được !"

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "tbff3d881f9"
msgid "Oh euh...[w]Le voilà justement !"
msgstr "Ah ! Ừm... Ờ... Kìa, con nó về rồi !"

#. Character:`saito` | Attributes:`sad`
msgctxt "t6c2c53ae11"
msgid "Vous étiez en train de vous disputer ?"
msgstr "Hai mẹ có gì bích bức với nhau ạ ?"

#. Character:`saito`
msgctxt "t2ea029028e"
msgid "J'entend {{sayuri.n}} crier depuis dehors..."
msgstr "Con vừa nghe cô {{sayuri.n}} lớn giọng từ ngoài..."

#. Character:`sayuri`
msgctxt "tc8f97a1ea0"
msgid "[font_size=14]Oh pardon, je suis désolée, je me suis un peu trop lâchée.[/font_size]"
msgstr "[font_size=14]A, xin lỗi, cô có hơi làm quá chút..[/font_size]"

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "t46b36fed39"
msgid "Nous ne nous disputions pas mon chéri."
msgstr "Bọn mẹ chỉ đang bàn chuyện người lớn thôi ấy mà."

#. Character:`yasuka` | Attributes:`sad`
msgctxt "tb14ebf58c3"
msgid "C'est juste..."
msgstr "Chỉ là..."

#. Character:`sayuri` | Attributes:`depressed`
msgctxt "t657f6f0f23"
msgid "C'est juste que j'ai épousée un connard insensible."
msgstr "Cô lỡ sa chân vào vòng tay một tên chó má lãnh đạm."

#. Character:`sayuri`
msgctxt "td637a09814"
msgid "J'ai voulu l'appeler hier soir, mais il m'a raccroché au nez."
msgstr "Cô đã cố gọi hắn hôm qua, nhưng thằng nớ dập máy ngay."

#. Character:`sayuri`
msgctxt "tb8183c5680"
msgid "Depuis le départ précipité d'{{asami.n}} je tourne en rond dans la maison toute seule et je ne sais plus quoi faire."
msgstr "Bởi vì {{asami.n}} rời đi đột ngột, mấy ngày gần đây cô cứ ra vào căn nhà, chẳng biết phải làm gì nữa."

#. Character:`saito` | Attributes:`neutral`
msgctxt "tf6e29e8957"
msgid "Avoir du temps libre rien qu'à toi ne te plaît pas ?"
msgstr "Chẳng phải cô luôn mơ ước có thời gian đi chữa lành sao ạ ?"

#. Character:`sayuri` | Attributes:`moved`
msgctxt "t5aa5059d7e"
msgid "J'en ai souvent rêvé, mais maintenant que j'en ai... Je ne sais plus quoi en faire."
msgstr "Ừ thì trước tới nay cô chỉ toàn biết ước, nhưng giờ có rồi thì cô lại ... chẳng biết làm gì để chữa lành cả."

#. Character:`sayuri`
msgctxt "tfd254ef12f"
msgid "C'est stupide n'est ce pas ?"
msgstr "Nghe ngớ ngẩn lắm phải không ?"

#. Character:`yasuka` | Attributes:`upset`
msgctxt "t66d06d538a"
msgid "Mais qu'est-ce que tu racontes, ça n'a rien de stupide, ça arrive à tout le monde !"
msgstr "Không, không ngớ ngẩn đâu. Ai chả từng bị vậy !"

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "t340f9aab75"
msgid "Tu n'as pas des amies comme moi que tu n'as pas vu depuis longtemps ?"
msgstr "Cậu không còn bạn bè nào lâu năm nào khác để liên lạc lại sao ?"

#. Character:`sayuri` | Attributes:`pouting`
msgctxt "t4e251af540"
msgid "Elles ont toutes leur vie de famille ou sont occupées."
msgstr "Chúng nó giờ yên bề gia thất, tối mắt tối mũi chồng con hết rồi."

#. Character:`sayuri`
msgctxt "t872e1234e6"
msgid "..."
msgstr "..."

#. Character:`sayuri` | Attributes:`upset`
msgctxt "tdabfed2c9a"
msgid "Et moi ?! J'ai pas le droit d'avoir une vie de famille ?"
msgstr "Còn tớ thì sao ?! Tớ không xứng một niềm hạnh phúc gia đình đầm ấm hay sao ?"

#. Character:`sayuri`
msgctxt "tbd86d8d776"
msgid "J'en ai marre de devoir attendre..."
msgstr "Tớ quá mệt mỏi vì phải chờ đợi rồi...."

#. Character:`yasuka`
msgctxt "te93a5fcdab"
msgid "Viens par là, mon chéri, il faut que je te parle."
msgstr "Con yêu, lại đây, mẹ thủ thỉ với con một tí."

#. Character:`saito` | Attributes:`guilty`
msgctxt "t573f6a445d"
msgid "Euh... D'accord."
msgstr "Ờm... Dạ... ?"

#. Character:`noriko`
msgctxt "tf3c2e16ca6"
msgid "Il n'est toujours pas rentré ?"
msgstr "Anh con vẫn chưa về ạ ?"

#. Character:`yasuka`
msgctxt "t0fc8b1cea5"
msgid "Ma chérie... Je t'ai dit qu'il rentrerait sûrement tard ce soir."
msgstr "Con yêu à... Mẹ bảo con là anh ấy sẽ về muộn rồi."

#. Character:`yasuka`
msgctxt "te9519d3171"
msgid "Tu sais bien qu'il passe la journée avec {{sayuri.n}} !"
msgstr "Mẹ biết mà,  anh ấy đang đi chơi với cô {{sayuri.n}} !"

#. Character:`noriko`
msgctxt "tf029063e7e"
msgid "La journée mais pas la nuit !"
msgstr "Chỉ ban ngày thôi, không phải đêm đâu mà sợ !"

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "t9af65d202a"
msgid "Tu te fais du souci pour rien, je t'assure !"
msgstr "Con cứ sợ không đâu, đừng có lo !"

#. Character:`noriko`
msgctxt "ta301e36e4e"
msgid "..."
msgstr "..."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "t821a32e6b5"
msgid "Est ce que ma petite chérie ne serait pas un peu jalouse ?"
msgstr "A, bé yêu của mẹ đang ghen chứ gì ?"

#. Character:`noriko` | Attributes:`angry`
msgctxt "tcab84ed4c9"
msgid "Pff c'est n'importe quoi !"
msgstr "Pfft,... l- làm gì có !"

#. Character:`noriko`
msgctxt "t637c50b140"
msgid "Il peut faire ce qu'il veut, ça ne me regarde pas après tout."
msgstr "Ảnh đi đâu, làm gì thì kệ ảnh."

#. Character:`noriko` | Attributes:`shame`
msgctxt "te07686c60b"
msgid "Mais je ne comprends pas pourquoi toi tu n'es pas plus inquiète !"
msgstr "Lạ lắm nha, mẹ không cảm thấy lo lắng hơn sao ?!"

#. Character:`noriko`
msgctxt "t78cbc3869e"
msgid "Tu comptes faire quoi si {{saito.n}} préfère la compagnie de {{sayuri.n}} à la tienne ?"
msgstr "Mẹ tính làm gì khi anh {{saito.n}} thích cô {{sayuri.n}} hơn mẹ ?"

#. Character:`yasuka` | Attributes:`sad`
msgctxt "t8bde632322"
msgid "..."
msgstr "..."

#. Character:`yasuka`
msgctxt "tbc101d0e12"
msgid "Te voilà de retour mon chéri !"
msgstr "Con về rồi, con yêu !"

#. Character:`saito` | Attributes:`surprised`
msgctxt "t5eb6d7945c"
msgid "Je ne pensais pas que tu m'attendrais."
msgstr "Con không nghĩ là mẹ sẽ chờ con."

#. Character:`saito` | Attributes:`guilty`
msgctxt "t87153c36bc"
msgid "Si j'avais su... Je serais rentré plus tôt."
msgstr "Con mà biết thì con đã về sớm hơn rồi."

#. Character:`yasuka` | Attributes:`happy`
msgctxt "te89cb1e11a"
msgid "Tout s'est bien passé ?"
msgstr "Hôm nay mọi sự đều tốt đẹp chứ ?"

#. Character:`saito` | Attributes:`happy`
msgctxt "t78563da16d"
msgid "A merveille !"
msgstr "Tuyệt lắm ạ !"

#. Character:`saito`
msgctxt "t82a945306e"
msgid "Elle m'a dit avoir passé la meilleure journée de sa vie."
msgstr "Cô ấy kể rằng hiếm khi cô ấy cười nhiều tới vậy."

#. Character:`saito`
msgctxt "tec267286f7"
msgid "Et qu'elle n'avait jamais été aussi heureuse depuis très longtemps."
msgstr "Còn bảo lâu lắm rồi cô ấy mới vui như ngày hôm nay."

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "t58169b92dc"
msgid "..."
msgstr "..."

#. Character:`yasuka` | Attributes:`happy`
msgctxt "tc079256fe7"
msgid "Où avez-vous été ?"
msgstr "Con với cô ấy đi những đâu hôm nay ?"

#. Character:`saito`
msgctxt "t533c4639bc"
msgid "{{sakuya.n}} m'a permis de réserver le onsen rien que pour nous alors..."
msgstr "{{sakuya.n}} cho con mượn khu Onsen một hôm..."

#. Character:`yasuka` | Attributes:`surprised`
msgctxt "t428e945cd5"
msgid "Vous avez été au onsen ?"
msgstr "Cả hai đi Onsen á ?"

#. Character:`saito` | Attributes:`guilty`
msgctxt "t4799e14a3c"
msgid "Euh... Oui."
msgstr "Dạ... Vâng."

#. Character:`yasuka`
msgctxt "t2d2d2f0a13"
msgid "Celui qui ne laisse entrer qu-"
msgstr "Có phải cái chỗ mà chỉ có-"

#. Character:`saito` | Attributes:`happy`
msgctxt "t46537a102a"
msgid "Que les clients qu'ils ont choisis oui..."
msgstr "Chỉ có quan biết với nhà chủ mới được vào, dạ..."

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "tc06f62f56a"
msgid "..."
msgstr "..."

#. Character:`yasuka` | Attributes:`neutral`
msgctxt "CE_QUI_EXPLIQUE_POURQUOI_ELLE_89A141"
msgid "Ce qui explique pourquoi elle m'avait donnée ma journée..."
msgstr ""

#. Character:`saito`
msgctxt "t20253aee93"
msgid "Elle était tellement heureuse qu'elle a pleuré en rentrant chez elle."
msgstr "Cô ấy hạnh phúc tới nỗi bật khóc trên đường về nhà."

#. Character:`saito`
msgctxt "t541a712070"
msgid "Du coup... Je n'ai pas pu m'empêcher de lui proposer une autre sortie demain."
msgstr "Thế nên là... Con lại mời cô ấy đi chơi tiếp ngày mai."

#. Character:`saito`
msgctxt "t2993189433"
msgid "Il m'a semblé qu'elle en avait vraiment besoin."
msgstr "Cô ấy chắc cũng cần mấy ngày ngơi nghỉ ấy lắm."

#. Character:`yasuka` | Attributes:`moved`
msgctxt "t7061aae951"
msgid "Mon chéri... Tu es vraiment adorable..."
msgstr "Con yêu à... con ga lăng quá đi..."

#. Character:`yasuka`
msgctxt "tbc3f93af7f"
msgid "Tu ferais mieux d'aller dormir, il est tard."
msgstr "Cũng đã muộn rồi, con yêu ngủ đi nhé."

#. Character:`saito`
msgctxt "t7555ae62c1"
msgid "Oui tu as raison."
msgstr "Dạ vâng, mẹ nói chí phải."

#. Character:`yasuka` | Attributes:`pouting`
msgctxt "t355be6e5ba"
msgid "..."
msgstr "..."

#. Character:`yasuka`
msgctxt "t34efee3fb8"
msgid "C'est pour une amie, c'est pour une amie, c'est pour une amie !!!"
msgstr "Cho một người bạn, cho MỘT người BẠN, chỉ cho một NGƯỜI BẠN THÔI !!!"

#. Character:`yasuka`
msgctxt "t6d3ac3e23d"
msgid "Pas de jalousie, ce n'est que pour quelques jours !"
msgstr "Grrhhh... Mình với con- Mình với con là cả đời kia mà. Có mấy ngày thì hề gì chứ !"

