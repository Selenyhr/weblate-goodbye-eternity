msgid "[color=yellow]De la puissance[/color]"
msgstr "[color=yellow]Tôi cần sức mạnh[/color]"

#. Character:`narrator`
msgctxt "te10003dae1"
msgid "Entrainement"
msgstr "Luyện tập"

#. Character:`narrator`
msgctxt "tbae3384d71"
msgid "[color=yellow]J'ai besoin de ton aide ![/color]"
msgstr "[color=yellow] Tôi cần trợ giúp của anh ![/color]"

#. Character:`narrator`
msgctxt "t243f06767c"
msgid "La vengeance des thugs"
msgstr "Sự trả thù của lũ du côn"

#. Character:`narrator`
msgctxt "t604896dcba"
msgid "[color=yellow]Diversion[/color]"
msgstr "[color=yellow]Đánh lạc hướng[/color]"

#. Character:`narrator`
msgctxt "t5ff035b562"
msgid "[color=yellow]Niveau supérieur[/color]"
msgstr "[color=yellow]Tăng cường độ tập luyện[/color]"

#. Character:`asami`
msgctxt "t9f8f29aa57"
msgid "[next]"
msgstr "[next]"

#. Character:`asami`
msgctxt "t8547b5eeb3"
msgid "Pourquoi tu ne viens pas t'asseoir à côté de moi ?"
msgstr "Tới đây mà ngồi này !"

#. Character:`asami`
msgctxt "tbe598a9525"
msgid "Ta journée se passe bien ?"
msgstr "Ngày hôm nay thế nào ?"

#. Character:`asami`
msgctxt "te7fff56ae1"
msgid "J'ai trop hâte d'être à ce soir !"
msgstr "Tối nay sẽ tuyệt lắm đấy !"

#. Character:`asami` | Attributes:`upset`
msgctxt "t371ed31641"
msgid "J'ai l'impression que {{natsume.n}} a des problèmes avec {{minato.n}}."
msgstr "Mình có ấn tượng rằng {{natsume.n}} có vấn đề gì đó với {{minato.n}}."

#. Character:`asami`
msgctxt "tdc81c12fc4"
msgid "Tu cours toujours avec la montagne de muscles ?"
msgstr "Ông vẫn đi tập gym với cái tảng thịt sống đấy à ?"

#. Character:`asami`
msgctxt "tebb4182cbe"
msgid "Si j'aime les Isekai ?...[w] Ça se pourrait."
msgstr "Isekai có phải sở thích không á ?...[w Chắc là... có."

#. Character:`asami`
msgctxt "t6534d79d16"
msgid "J'adore cette période, quand l'été arrive, la température remonte..."
msgstr "Tôi rất yêu thích thời gian này trong năm, khi mà hè đến và nhiệt độ tăng dần..."

#. Character:`asami` | Attributes:`blush`
msgctxt "t6b170edfcb"
msgid "... J'ai grave envie de toi, tu ne voudrais pas... tu sais..."
msgstr "... Tui muốn ông lắm luôn á... Ông không biết đâu..."

#. Character:`narrator`
msgctxt "t0523b390fc"
msgid "Discuter"
msgstr "Nói chuyện"

#. Character:`narrator`
msgctxt "t85a3e0c5ea"
msgid "Sexe"
msgstr "Làm tình."

#. Character:`narrator`
msgctxt "t05004d59ef"
msgid "Partir"
msgstr "Rời đi."

#. Character:`narrator`
msgctxt "talk_macumba_6259404c"
msgid "{{saito.n}} ne peut plus progresser davantage pour le moment."
msgstr "{{saito.n}} không cần thiết phải tiến bộ thêm tại thời điểm này."

#. Character:`narrator`
msgctxt "tf61fa27d7a"
msgid "{{saito.n}} effectue une session d'entraînement avec {{macumba.n}}."
msgstr "{{saito.n}} hoàn thành một buổi huấn luyện với {{macumba.n}}."

#. Character:`macumba` | Attributes:`happy`
msgctxt "talk_macumba_afbd2f0e"
msgid "Alors petit frère, prêt à transpirer ?"
msgstr "Thế nào, người anh em, chuẩn bị đổ mồ hôi chưa ?"

#. Character:`saito` | Attributes:`happy`
msgctxt "talk_macumba_39ce60ac"
msgid "Je ne pourrais jamais changer si je reste coincé dans ma chambre."
msgstr "Tôi không thể thay đổi bản thân nếu như tôi cứ chỉ ru rú trong nhà."

#. Character:`saito`
msgctxt "talk_macumba_ca69df81"
msgid "Je suis prêt pour ma séance de torture !"
msgstr "Tôi đã sản sàng cho cuộc tra tấn!"

#. Character:`macumba`
msgctxt "talk_macumba_3127977f"
msgid "Alors, Go !"
msgstr "Vậy bắt đầu thôi !"

#. Character:`centered`
msgctxt "talk_macumba_ce30b131"
msgid "Vous ne savez plus si vous êtes là pour préserver votre virginité anale ou pour augmenter votre endurance..."
msgstr "Bạn không biết rằng mình tới đây để mất trinh đuýt hay để rèn luyện thể lực nữa..."

#. Character:`macumba`
msgctxt "talk_macumba_ce55b5b7"
msgid "C'était pas mal du tout petit frère, tu progresses vite."
msgstr "Không tồi đâu, người anh em tiến bộ nhanh đấy."

#. Character:`macumba`
msgctxt "talk_macumba_4623c6f5"
msgid "N'oublie pas de bien rester hydraté et de t'étirer."
msgstr "Đừng quên việc giãn cơ và uống đủ nước."

#. Character:`macumba`
msgctxt "talk_macumba_69432704"
msgid "Demain, on augmentera encore la cadence."
msgstr "Ngày mai chúng ta sẽ tiếp tục tăng cường độ."

#. Character:`saito`
msgctxt "talk_macumba_b55286c6"
msgid "On n'était pas déjà au maximum ?"
msgstr "Không phải chúng ta đã đạt max rồi sao?"

#. Character:`macumba`
msgctxt "talk_macumba_96837f64"
msgid "Allez, à demain petit frère."
msgstr "Gặp lại người anh em lần sau nhé."

