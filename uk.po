msgctxt "sleep_menu_53c814c7"
msgid "Allez, j'ai du pain sur la planche !"
msgstr "Нумо, у мене є робота!"

#. Character:`narrator`
#: game/story/home_player_saito_room.dialogue
msgctxt "t93db1deefb"
msgid "Dormir seul"
msgstr "Спати на самоті"

#. Character:`narrator`
#: game/story/home_player_saito_room.dialogue
msgctxt "td200a73aae"
msgid "Dormir avec {{asami.n}}"
msgstr "Спати з {{asami.n}}"

#. Character:`narrator`
#: game/story/home_player_saito_room.dialogue
msgctxt "t60c70d70b6"
msgid "Dormir avec {{noriko.n}}"
msgstr "Спати з {{noriko.n}}"

#. Character:`saito`
#: game/story/home_player_saito_room.dialogue
msgctxt "t897902a32e"
msgid "[next]"
msgstr "[next]"

#. Character:`narrator`
#: game/story/home_player_saito_room.dialogue
msgctxt "t1d37f88914"
msgid "Juste un câlin."
msgstr "Просто обійми."

#. Character:`narrator`
#: game/story/home_player_saito_room.dialogue
msgctxt "t9a2264af51"
msgid "Sexe avec {{yasuka.n}}"
msgstr "Секс з {{yasuka.n}}."

