msgid "[hint=ROUTE AMOUR]Non, j'ai pas envie de servir de bouche-trou."
msgstr "[hint=LOVE ROUTE]아니, 나는 대타로 남고 싶지 않아."

#. Character:`saito`
#: game/story/home_player_exterior.dialogue
#, fuzzy
msgctxt "home_player_exterior_ede28b2f"
