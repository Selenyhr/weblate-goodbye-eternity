msgstr "Hmmm, mehr ... Mehr!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_eec52e93"
msgid "Mhhh, je te sens vibrer en moi."
msgstr "Ich kann dich in mir zucken spüren."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_d26dca79"
msgid "Plus vite mon chéri, plus vite !"
msgstr "Schneller, Süßer, schneller!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_0be12655"
msgid "Je... Ça vient !"
msgstr "Ich ... Ich komme!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_78a5207a"
msgid "Ne te retire pas !"
