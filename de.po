#: game/story/home_natsume_natsume_room.dialogue
msgctxt "NON_TU_NE_BOUGE_PAS_D7D9F6"
msgid "Non ! Tu ne bouges pas !"
msgstr "Nein! Beweg dich nicht!"

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_ME_LAISSE_FAIRE_D5E977"
msgid "Tu me laisses faire."
msgstr "Lass mich das machen."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_NE_COMPTE_M_ME_PLUS_LE_NOMB_4BE011"
msgid "Je ne compte même plus le nombre de fois où j'ai joui."
msgstr "Ich weiß nicht mehr, wie oft ich gekommen bin."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ET_TU_ES_TOUJOURS_AUSSI_DUR_FO_30C155"
msgid "Et tu es toujours aussi dur foutu bambou !"
msgstr "Und du bist immer noch hart wie eine Eiche, verdammt!"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_SUIS_JUSTE_ENDURANT_DA0197"
msgid "Je suis juste... endurant."
msgstr "Ich bin einfach ... widerstandsfähig."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "AH_A_POUR_TRE_ENDURANT_C6515B"
msgid "Ah ça pour être endurant..."
msgstr "Ah, das nenne ich mal Ausdauer ..."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "OH_PUTAIN_JE_VAIS_1152DA"
msgid "Oh putain... Je vais..."
msgstr "Oh fuck ... Ich ... Ich ..."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ENCORE_W_JOUIR_40499C"
msgid "Encore...[w] jouir !"
msgstr "Nochmal ... [w]Ich komme!"

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "HAN_C_EST_TROP_BON_C423AC"
msgid "Han c'est trop bon..."
msgstr "Haa, das ist viel zu gut ..."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "IL_EST_TEMPS_DE_M_NAGER_CE_COT_B4A004"
msgid "Il est temps de ménager ce coté..."
msgstr "Höchste Zeit, sich darum zu kümmern ..."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "QU_EST_CE_QUE_TU_VEUX_DIRE_PAR_59D7EA"
msgid "Qu'est-ce que tu veux dire par..."
msgstr "Was meinst du mit ..."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "OH_B18DB3"
msgid "Oh !"
msgstr "Oh!"

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_T_INTERDIS_DE_DIRE_QUI_QUE_AA756F"
msgid "Je t'interdis de dire à qui que ce soit que je prends mon pied comme ça avec toi !"
msgstr "Wag es nicht, irgendjemandem davon zu erzählen, wie ich mich mit dir vergnüge!"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ET_A_QUI_VOUDRAIS_TU_QUE_J_EN_9F6439"
msgid "Et à qui voudrais-tu que j'en parle ?"
msgstr "Und wem glaubst du könnte ich es verraten?"

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_M_EN_FICHE_N_EN_PARLE_JAMAI_907580"
msgid "Je m'en fiche ! N'en parle jamais !"
msgstr "Keine Ahnung! Mir egal! Sprich mit niemandem darüber."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "PUTAIN_DE_MERDE_JE_NE_SAVAIS_M_57A2EE"
msgid "Putain de merde, je ne savais même pas qu'on pouvait avoir un orgasme comme ça..."
msgstr "Um Gottes Willen, ich hatte keine Ahnung, dass man so einen Orgasmus haben kann ..."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "HANNN_FUCK_C_EST_770AC2"
msgid "Hannn... Fuck c'est..."
msgstr "Hmmm ... Fuck, das ist ..."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "PUTAIN_DE_BON_64948A"
msgid "Putain de bon !"
msgstr "Fucking gut!"

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "C_EST_BON_TU_AS_EU_TON_COMPTE_94BAA4"
msgid "C’est bon, tu as eu ton compte ?"
msgstr "Okay, hattest du genug für heute?"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "OUI_C_EST_BON_ENCORE_D_SOL_1CC43F"
msgid "Oui, c’est bon, encore désolé."
msgstr "Ja, ich denke, das reicht. Sorry nochmal."

#. Character:`natsume` | Attributes:`bad`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ALORS_C_TAIT_QUOI_TOUT_A_0DF1FA"
msgid "Alors c’était quoi tout ça ?"
msgstr "Also, wie kam es denn bitte dazu?"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_NE_SAIS_PAS_PEUT_TRE_QUE_TU_E8D4C2"
msgid "Je ne sais pas, peut-être que tu ne m’étais pas si indifférente que ça..."
msgstr "Keine Ahnung, vielleicht bist du mir am Ende ja doch nicht so unwichtig ..."

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "NE_ME_DIS_PAS_DES_CHOSES_COMME_38E4BC"
msgid "Ne me dis pas des choses comme ça..."
msgstr "Sag sowas nicht ..."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "POURQUOI_E38E4D"
msgid "Pourquoi ?"
msgstr "Warum?"

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_NE_LE_M_RITE_PAS_7F29B2"
msgid "Je ne le mérite pas..."
msgstr "Das habe ich nicht verdient ..."

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "PAS_APR_S_TOUT_CE_QUE_J_AI_PU_DD53AC"
msgid "Pas après tout ce que j’ai pu faire."
msgstr "Nicht nach allem, was ich getan habe."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "W_COUTE_J_IGNORE_SI_TU_M_AS_T_64F7A6"
msgid "...[w] Écoute, j’ignore si tu m’as tout raconté mais..."
msgstr "... [w]Hör mir zu, ich weiß nicht, ob du mir alles erzählt hast, aber ..."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_VOIS_BIEN_QUE_TU_ESSAYES_DE_21632A"
msgid "Je vois bien que tu essaies de faire de ton mieux et que ton cœur balance entre tes obligations et tes envies."
msgstr "Ich sehe, dass du dein Bestes gibst und zwischen deinen Verpflichtungen und deinen Wünschen hin- und hergerissen bist."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_NE_SAIS_PAS_CE_QUE_J_AURAIS_D0CA2B"
msgid "Je ne sais pas ce que j’aurais fait à ta place, peut-être la même chose."
msgstr "Ich weiß nicht, was ich an deiner Stelle getan hätte. Vielleicht dasselbe."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_AS_TENU_BON_TOUT_CE_TEMPS_E_B66D47"
msgid "Tu as tenu bon tout ce temps et c’est tout ce qui importe."
msgstr "Du hast die ganze Zeit durchgehalten, das ist alles, was zählt."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_SUIS_S_R_QU_ELLE_SERAIT_FI_50A43B"
msgid "Je suis sûr qu’elle serait fière de toi !"
msgstr "Ich bin mir sicher, sie wäre stolz auf dich!"

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "W_SERS_MOI_FORT_ET_NE_ME_L_CH_F66E6F"
msgid "...[w] Serres-moi fort et ne me lâche plus."
msgstr "Halt mich fest und lass mich nie wieder los."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "BIEN_S_R_7C59A4"
msgid "Bien sûr..."
msgstr "Natürlich ..."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_JE_VOULAIS_RESSENTIR_A_AU_M_7ABC30"
msgid "Je... Je voulais ressentir ça au moins une fois dans ma vie."
msgstr "Ich ... Ich wollte das hier zumindest einmal in meinem Leben spüren."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "CELA_SONNE_COMME_SI_TU_ALLAIS_FFA480"
msgid "Cela sonne comme si tu allais t’enfuir et ne plus jamais revenir..."
msgstr "Klingt so, als würdest du gleich abhauen und nie wiederkommen ..."

#. Character:`natsume` | Attributes:`cute`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "NON_JE_RESTERAIS_BIEN_COMME_A_54A773"
msgid "Non... Je resterais bien comme ça toute ma vie."
msgstr "Nein ... Ich könnte hier ewig so liegen."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "RASSURE_MOI_EST_CE_QU_ON_MANGE_4080A8"
msgid "Rassure-moi, est-ce qu’on mangerait autre chose que des nouilles instantanées ? Ce n’est pas très sain, tu sais..."
msgstr "Versprichst du mir, dass wir auch mal was Anderes als Instant-Nudeln essen? Dieses Zeug ist nicht gerade gesund, weißt du ..."

#. Character:`natsume` | Attributes:`pouting`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "IDIOT_TU_VOIS_PAS_QUE_TU_CASSE_6A950E"
msgid "Idiot ! Tu vois pas que tu casses l’ambiance ?!"
msgstr "Idiot! Du ruinierst die Stimmung, merkst du das nicht?!"

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_FERAIS_SURTOUT_MIEUX_DE_DOU_EC1639"
msgid "Je ferais surtout mieux de doubler les doses vu combien je dois dépenser d’énergie pour essayer de te suivre."
msgstr "Ich verdopple lieber die Portionen, wenn man bedenkt, wie viel Energie ich brauche, um mit dir mitzuhalten."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "IL_FAUT_CROIRE_QUE_TON_ENTRA_N_5FF8A3"
msgid "Il faut croire que ton entraînement n’était pas en vain..."
msgstr "Scheint so, als wäre dein ganzes Training nicht umsonst gewesen ..."

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "QU_EST_CE_QUE_TU_COMPTES_FAIRE_27783B"
msgid "Qu’est-ce que tu comptes faire quand tu te retrouveras face à lui ?"
msgstr "Was willst du machen, wenn du ihm gegenüberstehst?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_NE_SAIS_PAS_JE_NE_SAIS_PLUS_8BF9F3"
msgid "Je ne sais pas, je ne sais plus trop..."
msgstr "Ich weiß es nicht. Ich bin mir mittlerweile so unsicher ..."

#. Character:`natsume` | Attributes:`afraid`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_ES_EN_TRAIN_DE_PENSER_MA_SI_056385"
msgid "Tu es en train de penser à ma situation, avoue !?"
msgstr "Du versuchst, Rücksicht auf mich zu nehmen, oder?!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "OUI_W_SI_JE_FAIS_CE_QUI_DOIT_T_FD45AB"
msgid "Oui...[w] Si je fais ce qui doit être fait, alors ta mère..."
msgstr "Ja ... [w]Wenn ich tue, was ich für richtig halte, dann wird deine Mutter ..."

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "NE_T_OCCUPE_PAS_DE_MOI_FAIS_CE_F74882"
msgid "Ne t’occupe pas de moi, fais ce que tu dois faire, c’est tout ce qui importe !"
msgstr "Mach dir keine Sorgen um mich. Tu, was du tun musst, das ist alles, was zählt!"

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_VEUX_BIEN_FAIRE_A_299FDE"
msgid "Tu veux bien faire ça ?"
msgstr "Könntest du mir den Gefallen tun?"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "OUI_D37AF0"
msgid "Oui..."
msgstr "Ja ..."

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "CES_QUELQUES_JOURS_PASS_S_AVEC_8C5944"
msgid "Ces quelques jours passés avec toi ont été les plus joyeux de toute ma vie et j’ai peur d’y avoir pris goût."
msgstr "Diese letzten paar Tage waren die schönsten meines Lebens und ich habe Angst, dass ich zu sehr an dir hänge."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_NE_VEUX_PAS_TOUT_LAISSER_DE_CDE6DD"
msgid "Tu ne veux pas tout laisser derrière toi et rester avec moi ?"
msgstr "Willst du nicht all das hinter dir lassen und bei mir bleiben?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "J_8D4C54"
msgid "J-"
msgstr "Ich–"

#. Character:`natsume` | Attributes:`cute`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "SHHHT_C_EST_BON_JE_CONNAIS_D_J_807398"
msgid "Shhht... c’est bon, je connais déjà la réponse."
msgstr "Pschht ... Schon okay. Ich weiß, was du sagen willst."

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JUSTE_CONTINUE_DE_ME_CARESSER_1F0ED5"
msgid "Juste... Continue de me caresser les cheveux... s’il te plaît..."
msgstr "Bitte ... streich einfach weiter mit deinen Fingern durch mein Haar ..."

#. Character:`natsume`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "MERCI_D_AVOIR_T_L_AAF775"
msgid "Merci d'avoir été là..."
msgstr "Danke, dass du da bist ..."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "NATSUME_N_A84D8E"
msgid "{{natsume.n}} ?"
msgstr "{{natsume.n}}?"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "BON_VISIBLEMENT_ELLE_EST_D_J_P_A59A85"
msgid "Bon... visiblement, elle est déjà partie."
msgstr "Wow ... Sieht so aus, als wäre sie schon weg."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "DE_TOUTE_FA_ON_IL_EST_AUSSI_TE_537B0E"
msgid "De toute façon, il est aussi temps pour moi d’y retourner."
msgstr "Wie auch immer. Höchste Zeit, dass ich wieder zurückgehe."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_LA_VERRAI_CE_SOIR_POUR_LUI_32CB29"
msgid "Je la verrai ce soir pour lui dire que je vais passer à l’action !"
msgstr "Ich gehe heute Nacht zu ihr, um ihr zu sagen, dass ich meinen Schachzug machen werden!"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "NATSUME_N_JE_SUIS_RENTR_496B16"
msgid "{{natsume.n}}, je suis rentré !"
msgstr "{{natsume.n}}, ich bin wieder da!"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ENCORE_DES_NOUILLES_INSTANTAN_6D6E99"
msgid "Encore des nouilles instantanées ce soir ?"
msgstr "Heute Nacht wieder Instant-Nudeln?"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_SAIS_QUOI_JE_CROIS_QUE_JE_C_FDAB33"
msgid "Tu sais quoi... Je crois que je commence à m’y faire !"
msgstr "Weißt du was ... Ich glaube, ich gewöhne mich langsam daran!"

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "MALHEUREUSEMENT_ELLE_N_EST_PLU_9F3CA6"
msgid "Malheureusement, elle n’est plus disponible."
msgstr "Bedauerlicherweise ist sie nicht mehr hier."

#. Character:`minato` | Attributes:`suspicious`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_AS_CHANG_AD8958"
msgid "Tu as... changé..."
msgstr "Du ... hast dich verändert ..."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "QU_EST_CE_QUE_TU_AS_FAIT_D_ELL_C949E8"
msgid "Qu’est-ce que tu as fait d’elle ?"
msgstr "Was hast du ihr angetan?"

#. Character:`minato` | Attributes:`happy`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_T_ES_VRAIMENT_ENTRA_N_OU_TU_31092A"
msgid "Tu t’es vraiment entraîné ou tu as juste changé de coiffure ?"
msgstr "Hast du tatsächlich trainiert oder hast du einfach nur eine neue Frisur?"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "EN_FAIT_JE_M_EN_FOUS_A_TOMBE_B_A27938"
msgid "En fait, je m’en fous, ça tombe bien que tu sois là !"
msgstr "Eigentlich ist’s mir egal. Gut, dass du hier bist!"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ON_VA_POUVOIR_R_GLER_A_TOUT_DE_2A3AB4"
msgid "On va pouvoir régler ça tout de suite."
msgstr "Wir werden das hier und jetzt klären."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_NE_SERAIS_TOI_JE_NE_FERAIS_D8AAA5"
msgid "Je ne serais toi, je ne ferais pas cette erreur."
msgstr "Wenn ich du wäre, würde ich diesen Fehler lieber nicht machen."

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_CONNAIS_DEUX_FILLES_QUI_POU_BFDCCC"
msgid "Je connais deux filles qui pourraient en payer le prix fort."
msgstr "Mir fielen da zwei Mädchen ein, die im Zweifelsfall den ultimativen Preis dafür zahlen müssten."

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ESP_CE_DE_SOMBRE_MERDE_D9810F"
msgid "Espèce de sombre merde !"
msgstr "Du widerliches Arschloch!"

#. Character:`saito`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_CONNAIS_AUTRE_CHOSE_QUE_LES_96DD8D"
msgid "Tu connais autre chose que les subterfuges et le chantage ?"
msgstr "Gibt es in deinem Leben eigentlich irgendwas außer Erpressung und Manipulation?"

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "C_EST_LA_DIFF_RENCE_ENTRE_TOI_FD58A1"
msgid "C’est la différence entre toi et moi, je me concentre sur ce qui marche le mieux."
msgstr "Das ist der Unterschied zwischen uns beiden. ich konzentriere mich auf das, was am besten funktioniert."

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TOUTEFOIS_JE_DOIS_T_AVOUER_QUE_1D857C"
msgid "Toutefois, je dois t’avouer que tu m’as impressionné."
msgstr "Ich muss zugeben, du hast mich wirklich beeindruckt."

#. Character:`minato` | Attributes:`upset`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "R_USSIR_FAIRE_FONDRE_LE_C_UR_GL_D4D568"
msgid "Réussir à faire fondre le cœur glacé de {{natsume.n}}..."
msgstr "{{natsume.n}}s eiskaltes Herz zum Schmelzen zu bringen ..."

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "M_ME_MOI_JE_N_Y_TAIS_JAMAIS_PA_3CD910"
msgid "Même moi, je n’y étais jamais parvenu."
msgstr "Nicht mal ich habe das geschafft."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ESSAIE_DE_TE_COMPORTER_COMME_U_F78367"
msgid "Essaie de te comporter comme un être humain et peut-être que tu aurais eu plus de chance."
msgstr "Versuch, dich wie ein Mensch zu verhalten und vielleicht hast du mehr Glück."

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "W_JE_N_AI_PAS_TOUJOURS_T_COMM_8CA5EA"
msgid "...[w] Je n’ai pas toujours été comme ça, tu sais."
msgstr "... [w]Weißt du, ich war nicht immer so."

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "MAIS_CE_N_EST_PAS_LE_MOMENT_DE_39C2A1"
msgid "Mais ce n’est pas le moment de parler de ça, tu es à présent face à un dilemme."
msgstr "Aber das ist nicht der richtige Zeitpunkt, um darüber zu reden; du stehst jetzt vor einem Dilemma."

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_TE_RETROUVES_PR_SENT_AVEC_D_9CB1CB"
msgid "Tu te retrouves à présent avec deux filles à devoir sauver, comment tu comptes faire ?"
msgstr "Es gibt jetzt zwei Mädchen, die du retten musst. Wie willst du das machen?"

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "PAS_DE_R_PONSE_W_JE_SUPPOSE_QU_D16108"
msgid "Pas de réponse ?[w] Je suppose que tu n’avais pas envisagé cette possibilité."
msgstr "Keine Antwort? Ich schätze, auf sowas warst du nicht vorbereitet."

#. Character:`minato` | Attributes:`angry`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "TU_SAVAIS_QUE_CETTE_SALOPE_N_A_662791"
msgid "Tu savais que cette salope n’avait jamais donné de X3 à {{asami.n}} ?"
msgstr "Wusstest du, dass diese Hure {{asami.n}} nie das X3 gegeben hat?"

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ELLE_S_TAIT_ARRANG_E_POUR_FAIR_3BD705"
msgid "Elle s’était arrangée pour faire semblant. Maintenant, j’ai un client tout à fait mécontent de ne pas avoir son esclave sexuel à temps."
msgstr "Sie hat’s nur vorgetäuscht. Jetzt habe ich einen wirklich angepissten Kunden, weil sein Sexsklave nicht rechtzeitig aufgetaucht ist."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "QUEL_DOMMAGE_D9F9B7"
msgid "Quel dommage !"
msgstr "Wie schade!"

#. Character:`minato` | Attributes:`suspicious`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "C_EST_L_QUE_TU_TE_TROMPES_MAIN_853D47"
msgid "C’est là que tu te trompes. Maintenant, je vais devoir contacter des gens bien plus puissants et dangereux."
msgstr "Und da liegst du falsch. Jetzt muss ich mich an Leute wenden, die wesentlich mächtiger und gefährlicher sind, als der."

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "AUTANT_MON_ANCIEN_CLIENT_SE_SE_35ABC8"
msgid "Autant mon ancien client se serait amusé avec {{asami.n}} quelque temps et aurait vite été lassé, mais eux..."
msgstr "Mein alter Kunde hätte ein wenig Spaß mit {{asami.n}} gehabt und hätte sich schnell gelangweilt, aber diese Typen ..."

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "DISONS_QU_ILS_SONT_L_POUR_RENT_62DEED"
msgid "Disons qu’ils sont là pour rentabiliser jusqu’à la moëlle leur moindre investissement."
msgstr "Sagen wir mal, die schaffen es, jedes bisschen Profit aus einer Sache rauszuquetschen."

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ET_EN_PLUS_ILS_ONT_DROIT_UNE_P_1D1C39"
msgid "Et en plus, ils ont droit à une promo : deux filles pour le prix d’une !"
msgstr "Und darüber hinaus bekommen sie ein Sonderangebot: Zwei Mädchen zum Preis von einem!"

#. Character:`minato` | Attributes:`happy`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "SI_A_CE_N_EST_PAS_CE_QU_ON_APP_CDAA7C"
msgid "Si ça, ce n’est pas ce qu’on appelle un beau geste commercial, je ne sais pas ce que c’est !"
msgstr "Wenn das mal kein guter Deal ist, dann weiß ich auch nicht!"

#. Character:`saito` | Attributes:`angry`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "J_EN_AI_ASSEZ_ENTENDU_QU_EST_C_7F615F"
msgid "J’en ai assez entendu ! Qu’est-ce que tu veux ?"
msgstr "Ich hab’ genug gehört! Was zur Hölle willst du?"

#. Character:`minato` | Attributes:`neutral`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_RECONNAIS_TES_EFFORTS_JE_SU_DA40C2"
msgid "Je reconnais tes efforts, je suis admiratif. J’admire aussi ta capacité à influencer le cœur de ceux qui t’entourent."
msgstr "Ich sehe die Mühe, die du aufgewendet hast und bin wirklich beeindruckt. Ich bewundere deine Fähigkeit, die Herzen deiner Mitmenschen zu erobern."

#. Character:`minato`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_TE_PROPOSE_DE_TRAVAILLER_PO_B7BD2E"
msgid "Je te propose de travailler pour moi et en échange tu récupères {{natsume.n}} ! Je ferai même libérer sa mère."
msgstr "Ich mache dir ein Angebot: Arbeite für mich und du bekommst {{natsume.n}}! Ich befreie sogar ihre Mutter."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "W_ET_ASAMI_N_6DBDF0"
msgid "...[w] Et {{asami.n}} ?"
msgstr "... [w]Und was ist mit {{asami.n}}?"

#. Character:`minato` | Attributes:`suspicious`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "ELLE_EST_D_J_PERDUE_DE_TOUTE_F_AB8295"
msgid "Elle est déjà perdue de toute façon. Sa mère a probablement dû avoir les trois doses de X3 et doit bien s’amuser avec son nouveau coup de cœur."
msgstr "Die ist eh schon verloren. Ihre Mutter hat wahrscheinlich schon drei Dosen X3 intus und eine Menge Spaß mit ihrem neuen Freund."

#. Character:`minato` | Attributes:`happy`
#: game/story/home_natsume_natsume_room.dialogue
msgctxt "JE_PENSE_QUE_TU_LE_CONNAIS_59FB5B"
msgid "Je pense que tu le connais..."
msgstr "Ich glaube, du kennst ihn ..."

