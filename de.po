msgid "[next]"
msgstr "[next]"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t883c43b7cd"
msgid "Spooning"
msgstr "Löffelchenstellung"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t0423ea197e"
msgid "Missionary"
msgstr "Missionarsstellung"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t2f5560a78f"
msgid "Sexe avec {{yasuka.n}}"
msgstr "Sex mit {{yasuka.n}}"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tb09c6ff4b8"
msgid "La laisser dormir."
msgstr "Sie schlafen lassen"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_sleeping_5775cedd"
msgid "Il est tard, je ferais mieux de la laisser se reposer."
msgstr "Es ist spät, ich sollte sie lieber schlafen lassen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "ta0ddccc070"
msgid "Quelqu'un voulait un peu de tendresse ce soir ?"
msgstr "Möchte da jemand heute Nacht kuscheln?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t8b5696d616"
msgid "Pas seulement ce soir... J'en voudrais tous les jours."
msgstr "Nicht nur heute Nacht ... Sondern jeden Tag."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "te47f666780"
msgid "Et encore plus si cela vient de toi."
msgstr "Und ganz besonders, wenn du es bist, um den es geht."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t1936b5aafb"
msgid "Alors viens mon chéri."
msgstr "Dann komm her, Süßer."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t839da3351d"
msgid "Hmmm."
msgstr "Mmmm."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tb80883c431"
msgid "Je suis si heureuse !"
msgstr "Ich bin so glücklich!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t776f1b292d"
msgid "Oui c'est parfait."
msgstr "Ja, das ist perfekt!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tc2cef3a190"
msgid "Juste comme ça..."
msgstr "Genau so ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "te824b1b295"
msgid "Mon chéri, je sens que ça vient !"
msgstr "Süßer, ich spür’s kommen!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t257a32ac70"
msgid "Oh ouiii !"
msgstr "Oh jaaa!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "td5a137123a"
msgid "Mon dieu... Tu es toujours aussi incroyable."
msgstr "Meine Güte ... Du bist immer so unglaublich."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t8c416a4d99"
msgid "J'ai beau être restée allongée, je suis épuisée."
msgstr "Ich bin erschöpft, obwohl ich nur dalag."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tba3ef1f831"
msgid "La prochaine fois ce sera à mon tour de me laisser faire."
msgstr "Nächstes Mal bin ich die Person, um die sich gekümmert wird."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t2695116478"
msgid "Pourquoi pas..."
msgstr "Warum nicht ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t310ee9fa6e"
msgid "J'ai passé une merveilleuse nuit avec toi."
msgstr "Ich habe eine wundervolle Nacht mit dir verbracht."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tf257c0882b"
msgid "Passe une très bonne journée mon amour."
msgstr "Hab einen schönen Tag, mein Liebster."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_44ad9d1b"
msgid "Tu as passé une bonne journée mon chéri ?"
msgstr "Wie war dein Tag, Liebling?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_5b69bfb5"
msgid "Je ne te cache pas que je suis un peu épuisé."
msgstr "Ich bin etwas erschöpft, wenn ich ehrlich sein soll."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_e0f53a66"
msgid "Désolé si je souris, mais...[w] Bienvenue dans le monde du travail."
msgstr "Entschuldige, wenn ich grinse, aber ...[w] Willkommen im Berufsleben."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b14bf260"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_9957e2d0"
msgid "Allez, je voulais juste te taquiner !"
msgstr "Komm schon, ich wollte dich nur ein bisschen ärgern!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_108d9c55"
msgid "Allonge-toi à côté de la vieille femme que je suis."
msgstr "Leg dich neben die alte Frau, die ich bin."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_3b8993b4"
msgid "Vieille ?"
msgstr "Alt?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_1aedc676"
msgid "Arrête de dire des bêtises, tu es magnifique."
msgstr "Hör auf, so einen Schwachsinn zu sagen. Du bist wunderschön."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_bc73fee0"
msgid "Si je ne te connaissais pas, je te donnerais entre 25 et 28 ans."
msgstr "Wenn ich es nicht besser wüsste, würde ich sagen, dass du zwischen 25 und 28 bist."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b0bff4f1"
msgid "Oh... Je ne m'attendais pas à ça."
msgstr "Oh ... Das habe ich nicht erwartet."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_89088db8"
msgid "Tu es si gentil."
msgstr "Du bist so lieb."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_05b32477"
msgid "Ce n'est pas de la gentillesse, juste un fait."
msgstr "Das ist nicht süß sein. Das ist einfach Fakt."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_221874e5"
msgid "Merci..."
msgstr "Danke ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_7301a7a0"
msgid "Dis...[w] Tu veux bien me parler de toi ?"
msgstr "Sag mal ...[w] Würdest du mir mehr über dich selbst erzählen?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_4d62792e"
msgid "Comment ça ?"
msgstr "Was meinst du?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b5e61368"
msgid "Je veux savoir... Ce que tu fais, qui sont tes amis, à quoi tu penses..."
msgstr "Ich möchte wissen ... Was du so tust, wer deine Freunde sind, worüber du nachdenkst ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_deb52b8b"
msgid "Quelles sont les difficultés que tu rencontres au quotidien."
msgstr "Was für Schwierigkeiten dir im Alltag begegnen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a3b4ecab"
msgid "Est-ce que {{noriko.n}} est toujours aussi dure avec toi ?"
msgstr "Ist {{noriko.n}} immer so hart zu dir?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_6e89e86b"
msgid "Quoi, tu étais au courant ?"
msgstr "Was, du wusstest das?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a085624b"
msgid "{{saito.n}}... Je suis sa mère, je ne suis pas aveugle."
msgstr "{{saito.n}} ... Ich bin ihre Mutter. Ich bin nicht blind."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b0076dcb"
msgid "Elle se donne une image de fille gentille aux premiers abords, mais je sais que parfois, elle peut se montrer plutôt cruelle."
msgstr "Nach außen tritt sie wie ein liebes, nettes Mädchen auf, aber ich weiß, dass sie manchmal recht kaltblütig sein kann."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_582d7d51"
msgid "Je suis sincèrement désolé de ce qu'elle t'a fait subir..."
msgstr "Es tut mir wirklich leid für alles, was sie dir angetan hat ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_6579c4f9"
msgid "Bin merde alors..."
msgstr "Verdammt ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_3b776a61"
msgid "Si je m'attendais à ça."
msgstr "Das habe ich nicht erwartet."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_fc457694"
msgid "Elle savait tout."
msgstr "Sie wusste alles."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_642d9acc"
msgid "Si tu savais tout de ce qu'elle me faisait subir, pourquoi n'as-tu rien fait ?"
msgstr "Wenn du über alles, was sie getan hat, Bescheid wusstest, warum hast du nichts gemacht?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_fe37300d"
msgid "{{noriko.n}}... a toujours eu des rapports compliqués avec les hommes."
msgstr "{{noriko.n}} ... hatte schon immer ein ... kompliziertes Verhältnis zu Männern."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_e65d0dea"
msgid "Elle n'a jamais connu son père qui de toute façon ne l'a jamais voulu."
msgstr "Sie hat nie ihren Vater kennnengelernt und der wollte sie ohnehin nicht."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_770a3352"
msgid "Je crois qu'en grandissant, elle a développé une sorte d'aversion envers les garçons."
msgstr "Ich glaube, sie hat eine Abneigung gegenüber Jungen entwickelt, als sie aufwuchs."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2b43b7a4"
msgid "Je vois... Je commence à comprendre."
msgstr "Ah ja ... Ich glaube, ich versteh’s langsam."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_e72af3a2"
msgid "J'espérais qu'avec le temps, tu arrives à... l'apprivoiser."
msgstr "Ich habe gehofft, dass du sie im Laufe der Zeit ... bändigen könntest."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_d2fd49b2"
msgid "Lui faire comprendre que tous les hommes ne sont pas prêts à l'abandonner."
msgstr "Um sie dazu zu bringen, zu verstehen, dass sie nicht alle Männer so schnell im Stich lassen würden."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_061eb3a0"
msgid "Que certains peuvent être fiables."
msgstr "Dass man manchen vertrauen kann."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_4eedabe8"
msgid "...Dernièrement, les choses ont évolué."
msgstr "... In letzter Zeit haben sich die Dinge geändert."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_746fa107"
msgid "Vraiment ? Dis-moi tout !"
msgstr "Wirklich? Erzähl mir alles!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_dd4adafd"
msgid "J'arrive à communiquer avec elle, sans insultes, sans agressions."
msgstr "Ich habe es geschafft, mit ihr ohne Beleidigungen oder Aggression zu reden."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_8a29e03a"
msgid "L'autre jour, elle s'est même inquiétée pour moi."
msgstr "Einmal schien sie sogar besorgt um mich zu sein."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_72cf0c29"
msgid "Oooh, je suis si contente !"
msgstr "Oh, das freut mich so sehr!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_41a055d7"
msgid "Je ne sais pas ce que tu as fait, mais tes efforts semblent avoir payé."
msgstr "Ich weiß nicht, was du getan hast, aber deine Mühen scheinen sich gelohnt zu haben."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_24b785a0"
msgid "Je crois..."
msgstr "Ich glaube ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_e521ea80"
msgid "Je suis certaine que tu pourras l'aider à ouvrir son cœur."
msgstr "Ich glaube, dass du in der Lage sein wirst, ihr Herz zu öffnen."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2d17f020"
msgid "Tu crois ?"
msgstr "Wirklich?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_eb9101dc"
msgid "Crois-en l'intuition féminine."
msgstr "Vertrau meiner weiblichen Intuition."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_928cd497"
msgid "Je sais que tu en fais déjà beaucoup pour moi... Hmmm... Non, pour nous."
msgstr "Ich weiß, dass du schon viel für mich ... nein, für uns tust."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2950f4ca"
msgid "Mais aide {{noriko.n}}, j'aimerais la voir heureuse de nouveau."
msgstr "Aber könntest du {{noriko.n}} helfen? Ich würde sie gerne wieder fröhlich erleben."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_79a790cc"
msgid "Je compte sur toi."
msgstr "Ich zähle auf dich."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_e00e4ad1"
msgid "Tu es un peu son seul espoir."
msgstr "Du bist irgendwie ihre einzige Hoffnung."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_ce380db5"
msgid "Si je réussis, j'aurais droit à une récompense ?"
msgstr "Wenn ich erfolgreich bin, wird mir dann eine Belohnung zuteil?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a3ac8c51"
msgid "Si tu es réussi... Tu pourras me demander ce que tu veux."
msgstr "Wenn du erfolgreich bist ... Mache ich alles, was du willst."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a3cf3d5b"
msgid "Tout ce que je veux ?"
msgstr "Alles, was ich will?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_e134188a"
msgid "Bien sûr ! Il faut une récompense à la hauteur de la mission."
msgstr "Natürlich! Die Belohnung muss der Mission ja würdig sein."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_c3258ac4"
msgid "Mais... Quand tu dis tout ce que je veux... Tu veux dire... Tout ce que je veux ?"
msgstr "Aber ... Wenn du alles, was ich will sagst ... Meinst du wirklich ... Alles was ich will?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_16595d74"
msgid "Je croyais pourtant avoir été clair."
msgstr "Ich dachte, ich hätte mich deutlich genug ausgedrückt."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_00566add"
msgid "Je ne sais pas ce qui se trame de ton esprit à cet instant, mais tant que c'est dans mes cordes."
msgstr "Ich weiß nicht, woran du gerade denkst, aber solange ich es tun kann ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_22f8cc02"
msgid "Je le ferai."
msgstr "Tu ich es."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b14bf260_1"
msgid "..."
msgstr "..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_e4535e7b"
msgid "Oh mon Dieu..."
msgstr "Oh mein Gott ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a837157c"
msgid "Est-ce que je dois comprendre qu'il y a un sous-entendu ?"
msgstr "Verstehe ich richtig, was sie damit suggeriert?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_fb6ba617"
msgid "Que je pourrais demander vraiment tout ce que je veux ? Même..."
msgstr "Dass ich wirklich alles fordern kann, was ich will? Sogar ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t497ebbd8ef"
msgid "Je ferai de mon mieux."
msgstr "Ich tue mein Bestes."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_561ca10f"
msgid "Je vois..."
msgstr "Ich verstehe ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_57e6339c"
msgid "Je verrai ce que je peux faire."
msgstr "Ich werde sehen, was ich tun kann."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_f6e17b57"
msgid "Merci mon chéri !"
msgstr "Danke, Liebling!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t89b7055883"
msgid "Ça va être compliqué"
msgstr "Es wird schwierig werden."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_40b9fc80"
msgid "Oh, le temps passe si vite."
msgstr "Oh, die Zeit vergeht so schnell."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_3581d58b"
msgid "On devrait vraiment prendre le temps de discuter plus souvent."
msgstr "Wir sollten uns wirklich häufiger die Zeit nehmen, uns zu unterehalten."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_c143bf96"
msgid "Oui... On devrait faire ça plus souvent."
msgstr "Ja ... Wir sollten das häufiger tun."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_d066b4f5"
msgid "Alors, on remet ça demain !"
msgstr "Dann lass uns morgen weitermachen!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_946802da"
msgid "Repose-toi bien."
msgstr "Schlaf gut."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_4da8d3db"
msgid "Héhé, je t'ai attendu toute la journée."
msgstr "Hehe, ich habe den ganzen Tag auf dich gewartet."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_f8779a26"
msgid "Quoi ? Sur ce lit ?"
msgstr "Was? Im Bett?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_577a6383"
msgid "Toute la journée ?"
msgstr "Den ganze Tag?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_46bd08b8"
msgid "Quoi ? Je n'avais pas le droit ?"
msgstr "Was? Darf ich das etwa nicht?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b724e69e"
msgid "Mais si, tu peux faire absolument tout ce que tu veux !"
msgstr "Doch, natürlich darfst du das. Du kannst tun und lassen, was du willst!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_1c45c4a6"
msgid "Alors... On s'était arrêté où hier ?"
msgstr "Also ... Wo waren wir gestern stehengeblieben?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_23a7dba8"
msgid "Tu m'avais donné pour mission de rendre heureuse {{noriko.n}}."
msgstr "Du hast mir die Aufgabe gegeben, {{noriko.n}} wieder glücklich zu machen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_634ea843"
msgid "Aujourd'hui, je répondrai à une de tes questions."
msgstr "Heute werde ich eine deiner Fragen beantworten."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_5b64e6c6"
msgid "Alors, choisis bien !"
msgstr "Also wähle weise!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_44c00809"
msgid "Vraiment, tu n'esquiveras pas, tu répondras honnêtement ?"
msgstr "Wirklich? Du wirst nicht ausweichen, sondern ehrlich antworten?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_656f5f81"
msgid "Dis donc toi ! Je vais me vexer si tu penses que je n'ai pas été honnête avec toi."
msgstr "Schieß los! Ich fühle mich sonst noch gekränkt, wenn du glaubst, dass ich nicht ehrlich mit dir gewesen bin."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_fc4f6da3"
msgid "D'accord, d'accord... Voyons voir."
msgstr "In Ordnung ... Lass mich überlegen ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_5049b461"
msgid "Oh, je sais !"
msgstr "Ah, ich weiß!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_ebf19491"
msgid "Tu es une femme magnifique et..."
msgstr "Du bist eine schöne Frau und ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2b73c348"
msgid "Et... ?"
msgstr "Und ...?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_5b38d6c5"
msgid "Je ne comprends vraiment pas pourquoi tu n'as jamais retrouvé quelqu'un pour refaire ta vie."
msgstr "Ich verstehe wirklich nicht, warum du nie jemanden gefunden hast, um von vorne anzufangen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_c4ab69a3"
msgid "Oh, c'est..."
msgstr "Oh, das ist ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_d1d92072"
msgid "Tu le penses vraiment ?"
msgstr "Meinst du das wirklich?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_c4a6c691"
msgid "Jamais je ne pourrais te mentir."
msgstr "Ich würde dich nie anlügen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b154c698"
msgid "Tu es si gentil..."
msgstr "Du bist so süß ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_d6026bac"
msgid "Très bien, je vais te le dire, mais tu devras garder ça pour toi."
msgstr "Alles klar, ich sag’s dir, aber du musst es für dich behalten."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_f638c76b"
msgid "De toute façon, je ne vois pas à qui je pourrais en parler."
msgstr "Ich wüsste ohnehin nicht, mit wem ich sonst darüber reden würde."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_f51ebcc4"
msgid "N'en parle pas à {{noriko.n}} !"
msgstr "Erzähl es nicht {{noriko.n}}!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_0f954d6b"
msgid "Promis !"
msgstr "Versprochen!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_edcbdaf1"
msgid "Tu ne te moqueras pas non plus ?"
msgstr "Du wirst auch nicht lachen?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_adb66523"
msgid "Quoi ? Mais bien sûr que non !"
msgstr "Was? Natürlich nicht!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b8d7d070"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_eeeb8ff6"
msgid "Je n'en ai jamais parlé à personne, je garde ça en moi depuis des années."
msgstr "Ich rede darüber nie mit jemandem. Ich habe das jahrelang für mich behalten."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b22b8025"
msgid "Ça remonte au temps de ma première fois."
msgstr "Es geht darauf zurück, als ich mein erstes Mal hatte."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_585f49b9"
msgid "J'étais jeune et surtout bien trop naïve."
msgstr "Ich war jung und vor allem viel zu naiv."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_7f5106a8"
msgid "Une simple conquête."
msgstr "Nur eine Eroberung."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_9477f4ce"
msgid "C'est tout ce que j'étais pour lui."
msgstr "Mehr war ich nicht für ihn."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_8e35f35a"
msgid "Nous l'avons fait une fois et il ne m'avait pas dit qu'il n'utilisait pas de protection."
msgstr "Wir haben es einmal getrieben und er hat mir nicht erzählt, dass er nicht verhütet hat."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_ac57858a"
msgid "Le plus ironique dans l'histoire, c'est que ça n'a duré que quelques secondes..."
msgstr "Und die Ironie des Ganzen ist, dass er nur ein paar Sekunden durchgehalten hat ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_6a124402"
msgid "...il s'est senti tellement honteux qu'il est parti à toute vitesse en me laissant toute seule."
msgstr "... Er hat sich so geschämt, dass er einfach abgehauen ist und mich alleine im Stich ließ."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b043036b"
msgid "Il a vraiment fait ça ?"
msgstr "Das hat er wirklich getan?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b9492ba5"
msgid "Partir sans se retourner, t'abandonner là comme ça ?"
msgstr "Einfach weggerannt, ohne zurückzublicken, dich einfach so zurücklassen?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a0a20f6d"
msgid "Mais quel sale type !"
msgstr "Was für ein erbärmlicher Typ!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_5097b2e5"
msgid "Je suis ravie de voir la réaction que ça provoque en toi !"
msgstr "Es freut mich, dass du so darüber denkst!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a7a13acc"
msgid "Je crois que je t'ai bien élevée."
msgstr "Ich glaube, ich habe dich gut erzogen."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_0dd2314a"
msgid "Que s'est-il passé ensuite ?"
msgstr "Was ist danach passiert?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_40b028ff"
msgid "Plusieurs mois se sont écoulés avant que je ne m'en rende compte."
msgstr "Es sind ein paar Monate vergangen, bevor ich es bemerkt habe."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_9eea2820"
msgid "Et quand c'était enfin visible, il était trop tard."
msgstr "Und als man es endlich sah, war es zu spät."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_43d86677"
msgid "Je suis retourné le voir, mais..."
msgstr "Ich bin zurückgegangen, um ihn zu sehen, aber ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t9c9d9448bd"
msgid "Il n'a pas assumé..."
msgstr "Er dachte nicht, dass er ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_3e12a6f4"
msgid "Non, en effet..."
msgstr "Nein, tat er nicht ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a81798e6"
msgid "Il s'est moqué de moi."
msgstr "Er hat mich ausgelacht."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_20dea96b"
msgid "A répandu de sales rumeurs sur moi."
msgstr "Und üble Gerüchte über mich verbreitet."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_72a1f0cf"
msgid "Et n'a jamais voulu reconnaitre {{noriko.n}}."
msgstr "Und er wollte {{noriko.n}} nie als seine Tochter anerkennen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_bf2664c1"
msgid "Tout comme elle, je crois que j'ai un peu perdu foi dans la confiance que j'avais pour les hommes en général."
msgstr "Genauso wie sie, habe ich da wohl ein wenig den Glauben an Männer verloren."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_4d7de276"
msgid "J'ai la trentaine passée."
msgstr "Ich bin in meinen späten Dreißigern."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_45736be8"
msgid "Je n'ai jamais vraiment eu de vraies relations avec un homme."
msgstr "Und ich hatte nie eine richtige Beziehung mit einem Mann."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_7f8bc214"
msgid "J'ai fini par me dire que c'était peine perdue."
msgstr "Ich habe mir stets eingeredet, dass es Zeitverschwendung sei."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_1b8639a4"
msgid "{{yasuka.n}}... Je suis tellement désolée..."
msgstr "{{yasuka.n}} ... Das tut mir so leid ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_e5a2045b"
msgid "Ce n'est rien... Je m'y suis fait à force."
msgstr "Alles gut ... Ich habe mich daran gewöhnt."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2c68c293"
msgid "Non ! Je refuse d'imaginer ça."
msgstr "Nein! Ich weigere mich, das einfach so hinzunehmen!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_f821a857"
msgid "Il n'y a pas que {{noriko.n}} qui a le droit d'être heureuse."
msgstr "{{noriko.n}} ist nicht die einzige, die es verdient, glücklich zu sein."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_507761a5"
msgid "Toi aussi, tu y as droit."
msgstr "Du nämlich auch."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_7f1701b4"
msgid "Tu es adorable, mais...[w] qui voudrait d'une femme âgée comme moi, inexpérimentée, avec déjà des enfants ?"
msgstr "Du bist süß, aber ...[w] Wer würde eine alte Frau wie mich, die keine Erfahrung, dafür aber schon Kinder hat, wollen?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_315a478c"
msgid "Je n'ai pas de travail sérieux, je suis criblée de dettes."
msgstr "Ich habe keinen richtigen Beruf, stattdessen verschuldet ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_9fc4e1ee"
msgid "Et..."
msgstr "Und ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t4178cfcc4e"
msgid "Moi, je le voudrais."
msgstr "Ich würde sie wollen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_8a987e3d"
msgid "Hein ?!"
msgstr "Huh?!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_c4dcc652"
msgid "Tu n'as peut-être pas une bonne opinion de toi-même."
msgstr "Du magst von dir vielleicht keine gute Meinung haben."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_f5e7863d"
msgid "Mais moi... Je ferai tout."
msgstr "Aber ich ... ich würde alles tun."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_420cf6a7"
msgid "Je remuerais le ciel et la terre pour être avec toi..."
msgstr "Ich würde Himmel und Erde bewegen, nur um bei dir zu sein ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a6fc8bda"
msgid "Mais... mais... Je suis..."
msgstr "Aber ... aber ... Ich bin ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_f4900aaf"
msgid "Peu importe, c'est justement parce que je sais qui tu es que je suis prêt à tout ça pour toi."
msgstr "Das spielt keine Rolle. Genau weil ich weiß, wer du bist, möchte ich das für dich tun."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_9668016a"
msgid "Donc ne pense plus du mal de toi."
msgstr "Denk nicht weiter so schlecht von dir."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_43d259ec"
msgid "Tu as le droit au bonheur aussi."
msgstr "Auch du hast das Recht, glücklich zu sein."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b8d7d070_1"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_90153983"
msgid "Je vais te laisser, je crois."
msgstr "Ich denke, ich gönne dir jetzt etwas Ruhe."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_1cacd97c"
msgid "Tu as tellement ouvert ton cœur que j'ai machinalement fait la même chose."
msgstr "Du hast mir dein Herz so sehr geöffnet, dass ich dasselbe getan habe, ohne darüber nachzudenken."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_8cdee1f8"
msgid "Tu... Tu pensais vraiment ce que tu disais ?"
msgstr "Hast du ... Hast du das, was du gesagt hast, wirklich so gemeint?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_81107bda"
msgid "Pas une seule, fois, je ne t'ai menti."
msgstr "Ich habe dich noch nie belogen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b8d7d070_2"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_c413821f"
msgid "Peu importe ce qui se passe ou ce que tu peux penser."
msgstr "Ganz egal, was passiert oder was du vielleicht denken magst ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_63d4de8b"
msgid "Je continuerai de te soutenir quoi qu'il arrive."
msgstr "Ich werde dich weiterhin unterstützen, komme, was wolle!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_32b2f05a"
msgid "Je continuerai de soutenir cette famille quoi qu'il arrive."
msgstr "Ich werde diese Familie weiter unterstützen, ganz gleich, was passiert."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_7f0c3a21"
msgid "Bonne nuit, {{yasuka.n}}."
msgstr "Gute Nacht, {{yasuka.n}}."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_ad0f190c"
msgid "Je suis désolé pour {{noriko.n}}."
msgstr "Es tut mir leid wegen {{noriko.n}}."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_be3d4a87"
msgid "Elle a mal interprété ce qu'elle a vu hier soir et c'est retombé sur toi."
msgstr "Sie hat das, was sie letzte Nacht gesehen hat, falsch verstanden und dich dafür verantwortlich gemacht."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b9637cf6"
msgid "Elle m'a dit que je t'avais fait pleurer."
msgstr "Sie sagte, ich hätte dich zum Weinen gebracht."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_f44c4b13"
msgid "C'est moi qui suis désolé."
msgstr "Ich bin derjenige, der sich entschuldigen sollte."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_ecf55fa6"
msgid "J'ai peut-être trop parlé."
msgstr "Ich habe vielleicht zu viel gesagt."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_28687696"
msgid "Non, non, ce n'est pas ça."
msgstr "Nein, nein, das stimmt nicht."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_174cd0a0"
msgid "Hier, j'ai effectivement pleuré, mais ce n'était pas de tristesse."
msgstr "Ich habe gestern geweint, aber nicht, weil ich traurig war."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_ea55a3a6"
msgid "J'étais tout simplement heureuse."
msgstr "Ich war einfach nur glücklich."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_bde62a83"
msgid "Heureuse de voir la personne que tu es devenu."
msgstr "Glücklich, zu sehen, was aus dir geworden ist."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_08ce9b2c"
msgid "OH ! C'était donc ça !"
msgstr "OH! Das war’s also!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_8216ef71"
msgid "Tu penses toujours ce que tu m'as dit ?"
msgstr "Meinst du das, was du mir gesagt hast, immer noch so?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_11ea4cb1"
msgid "J'en ai fait l'expérience il y a quelque temps, mais..."
msgstr "Ich habe das vor eine Weile erlebt, aber ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_ff19b2c3"
msgid "Un homme ne revient jamais sur sa parole !"
msgstr "Ein Mann hält zu seinem Wort!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b8d7d070_3"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_9fe06e3e"
msgid "Tu es sûr que tu ne t'ennuierais pas avec quelqu'un comme moi ?"
msgstr "Bist du dir sicher, dass dich jemand wie ich nicht langweilen würde?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b1bd70a8"
msgid "Je veux dire... Je ne suis plus aussi jeune et intéressante que les filles de ton âge."
msgstr "Ich meine ... Ich bin nicht mehr so jung und interessant wie die Mädchen in deinem Alter."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_ffedd335"
msgid "Arrête de te rabaisser constamment."
msgstr "Hör auf, dich immer so zu erniedrigen."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_5f456ec1"
msgid "Je ne regretterai pas ce que j'ai dit."
msgstr "Ich bereue nicht, was ich gesagt habe."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_07085ee1"
msgid "Tu vas finir par me vexer si tu continues à vouloir me faire changer d'avis."
msgstr "Du wirst mich noch ärgern, wenn du weiter versuchst, meine Meinung zu ändern."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_dfd645c3"
msgid "Pardon, pardon, je ne voulais pas."
msgstr "Sorry, tut mir leid, das wollte ich nicht."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_7860a760"
msgid "On fait quoi maintenant ?"
msgstr "Also, was machen wir jetzt?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_f49d4ad8"
msgid "Je ne sais pas à toi de me dire..."
msgstr "Ich weiß nicht. Sag du es mir ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_8d09a51a"
msgid "Je... J'ai le cœur qui bat si vite, j'ai presque la tête qui tourne."
msgstr "Ich ... Mein Herz schlägt so schnell, dass ich gar nicht mehr klar denken kann."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a568b2a3"
msgid "Tu veux que j'aille te chercher un verre d'eau ?"
msgstr "Soll ich dir ein Glas Wasser holen?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a3b6483f"
msgid "Non, ce n'est pas de l'eau que je veux..."
msgstr "Nein, Wasser ist es nicht, was ich brauche ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_ea765d25"
msgid "Je veux...[w] juste..."
msgstr "Ich brauche nur ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_ba84a983"
msgid "Woah, woah, woah..."
msgstr "Woah, woah, woah ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a044b610"
msgid "Je suis vraiment en train de faire ce que je suis en train de faire ?"
msgstr "Mache ich das gerade wirklich?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_582602ee"
msgid "Je suis bien en train d'embrasser {{yasuka.n}} ?"
msgstr "Küsse ich gerade wirklich {{yasuka.n}}?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_31669b6b"
msgid "Ou plutôt, c'est elle qui m'embrasse..."
msgstr "Wobei eher sie diejenige ist, die mich küsst ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_503adf63"
msgid "Je... Je n'avais jamais emb-"
msgstr "Ich ... Ich habe noch nie jemanden gekü-"

#. Character:`centered`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_12586825"
msgid "{{yasuka.n}} et {{saito.n}} s'embrassèrent un long moment."
msgstr "{{yasuka.n}} küsste {{saito.n}} lange."

#. Character:`centered`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_0ae3a538"
msgid "C'est après plusieurs dizaines de minutes qu'elle se décida enfin à s'éloigner un peu."
msgstr "Erst nach vielen Minuten entschied sie sich, sich wieder etwas von ihm zu lösen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_76c10465"
msgid "Je suis désolée... Il faut croire que j'en avais terriblement envie."
msgstr "Entschuldige ... Ich wollte es einfach tun."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_61195119"
msgid "Ne t'excuse pas."
msgstr "Entschuldige dich nicht."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2345346c"
msgid "Tu n'étais pas la seule personne à en avoir envie."
msgstr "Du warst nicht die einzige, die das wollte."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2b779caf"
msgid "Que va dire {{noriko.n}} ?"
msgstr "Was würde {{noriko.n}} dazu sagen?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_3a924122"
msgid "J'ai déjà ma petite idée là-dessus, mais..."
msgstr "Ich kann es mir schon vorstellen, aber ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2524f9b4"
msgid "Elle veut aussi que tu sois heureuse donc je pense qu'elle l'acceptera."
msgstr "Sie will auch, dass du glücklich bist, also glaube ich, dass sie es akzeptieren würde."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_33af8eed"
msgid "Sinon... On n'est pas obligé de lui dire non plus tout de suite."
msgstr "Dennoch ... Wir sollten es ihr nicht sofort erzählen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_36ce393e"
msgid "Oui, tu as raison, ça peut attendre !"
msgstr "Ja, du hast Recht. Das kann warten!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2dfaa7fd"
msgid "Allez, sauve-toi avant qu'elle ne se doute de quelque chose !"
msgstr "Komm schon, geh, bevor sie irgendwas vermutet!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_4cf5b048"
msgid "Mais-"
msgstr "Aber-"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_880e4295"
msgid "Allez, ouste !"
msgstr "Komm schon!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_b8d7d070_4"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_34af1194"
msgid "Tu m'attendais ?"
msgstr "Hast du auf mich gewartet?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_d14927a5"
msgid "Oui."
msgstr "Ja."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_573786bd"
msgid "Tu as réussi à dormir cette nuit ?"
msgstr "Hast du letzte Nacht gut geschlafen?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_32233aa8"
msgid "Non, trop de choses qui se bousculaient dans ma tête."
msgstr "Nein, mir sind zu viele Dinge durch den Kopf gegangen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_4ae3f849"
msgid "Et surtout, beaucoup trop d'émotions."
msgstr "Und vor allem zu viele Emotionen."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_a8100078"
msgid "Tu veux en parler ?"
msgstr "Möchtest du darüber reden?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2f371d33"
msgid "Non, je veux juste..."
msgstr "Nein, ich will nur ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_535f178b"
msgid "Oh ! Pas de problème !"
msgstr "Oh! Kein Problem!"

#. Character:`centered`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_4c57d503"
msgid "{{yasuka.n}} et {{saito.n}} s'embrassèrent si longtemps qu'ils ne virent pas le temps passer."
msgstr "{{yasuka.n}} und {{saito.n}} küssten sich so lange, dass sie jegliches Zeitgefühl verloren."

#. Character:`centered`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_d90def55"
msgid "Au bout d'un long moment, {{yasuka.n}} repoussa tendrement {{saito.n}}."
msgstr "Nach einer langen Zeit stieß {{yasuka.n}} {{saito.n}} vorsichtig von sich."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_1a2d4fe8"
msgid "Quelque chose ne va pas ?"
msgstr "Stimmt etwas nicht?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_bfe6df0e"
msgid "Non, bien au contraire, tout va merveilleusement bien."
msgstr "Nein, ganz im Gegenteil. Alles läuft super."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_595174cb"
msgid "C'est juste que si tu restes plus longtemps..."
msgstr "Es ist nur, wenn du noch länger bleibst ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_95b96c46"
msgid "Oui ?"
msgstr "Ja?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_3e0f96db"
msgid "Je... Je vais te sauter dessus."
msgstr "Dann ... Dann werde ich auf dich drauf springen."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_aea38473"
msgid "...[w] Oh, je vois, en effet ça me parait très grave !"
msgstr "...[w] Oh, ich verstehe. Das klingt sehr ernst für mich!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_4a5bee05"
msgid "Je suis prêt à prendre le risque !"
msgstr "Damit kann ich leben!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_23f9e2f9"
msgid "Je... Je ne suis pas encore prête à franchir cette étape."
msgstr "Ich ... Ich bin noch nicht bereit für diesen Schritt."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_49715a8d"
msgid "Peux-tu me laisser un peu de temps pour mettre en ordre ce que je ressens ?"
msgstr "Kannst du mir etwas Zeit geben, um meine Gefühle zu sortieren?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_2c652546_1"
msgid "Je comprends..."
msgstr "Ich verstehe ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_e146018d"
msgid "Prend le temps qu'il te faudra, je n'ai pas l'intention de te quitter."
msgstr "Nimm dir alle Zeit der Welt. Ich hatte nicht vor, dich zu verlassen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_6b55cc5a"
msgid "Merci, d'être aussi compréhensif."
msgstr "Danke, dass du so verständnisvoll bist."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "talk_yasuka_f67258ad"
msgid "Bonne nuit, {{yasuka.n}} !"
msgstr "Gute Nacht, {{yasuka.n}}!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_71c529d8"
msgid "Tu as finalement pris ta décision ?"
msgstr "Hast du endlich eine Entscheidung getroffen?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_a0952f7e"
msgid "Oui, j'attendais d'avoir enfin l'esprit libre."
msgstr "Ja, ich habe darauf gewartet, dass ich endlich den Kopf freikriegen konnte."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_6504c431"
msgid "Et tout ça est arrivé grâce à toi."
msgstr "Und all das habe ich dir zu verdanken."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_33ae4f66"
msgid "Tu m'as rendu ma liberté."
msgstr "Du hast mir meine Freiheit zurückgegeben."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_ed65f2c7"
msgid "Et tellement plus encore."
msgstr "Und so viel mehr."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_024d5522"
msgid "Tu m'as rendue heureuse !"
msgstr "Du hast mich glücklich gemacht!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_07b6dccb"
msgid "Ne te sens pas obligée de faire ça pour moi parce que je t'ai aidé."
msgstr "Fühl dich bitte nicht dazu verpflichtet, das zu tun, nur weil ich dir geholen habe."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_c0180c2d"
msgid "Même sans..."
msgstr "Auch ohne das ..."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_096bf6d4"
msgid "Shhhhht ! Plus un mot, tu ne m'obliges à rien."
msgstr "Pscht! Sag nichts mehr. Du verpflichtest mich zu nichts."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_2840ef5a"
msgid "Justement, à partir d'aujourd'hui, je fais ce que je veux pour la première fois dans ma vie."
msgstr "Von nun an kann ich endlich tun, was ich wirklich will, das erste Mal in meinem Leben."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_e67bfc01"
msgid "Et qu'est-ce que tu veux ?"
msgstr "Und was willst du tun?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_6b12fcd4"
msgid "Je te veux en moi..."
msgstr "Ich will mit dir schlafen ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_32248e78"
msgid "Je veux enfin pouvoir ressentir cet amour que tu dis avoir pour moi."
msgstr "Ich will endlich die Liebe fühlen können, die du auch für mich fühlst."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_69c0919d"
msgid "Je ne suis plus la {{yasuka.n}} qui t'a élevée."
msgstr "Ich bin nicht mehr die {{yasuka.n}}, die dich aufgezogen hat."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_46383e76"
msgid "Je suis {{yasuka.n}}, la femme que tu as comblée et à qui tu vas faire l'amour."
msgstr "Ich bin {{yasuka.n}}, die Frau, die du mit Freude erfüllt hast und mit der du jetzt Liebe machen wirst."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_535ff888"
msgid "Voilà ce que je veux."
msgstr "Das ist es, was ich will."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_4a95a6b6"
msgid "Aucune pression !"
msgstr "Kein Druck!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_69f6d8d0"
msgid "Allez ! Rejoins-moi vite !"
msgstr "Komm schon! Komm her, schnell!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_1c0968a5"
msgid "Enfin.... Après toutes ces années."
msgstr "Endlich ... Nach all den Jahren."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_b2f511c3"
msgid "S'il te plait... Soit doux."
msgstr "Bitte ... Sei vorsichtig."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_4bab01ff"
msgid "J'ai un peu peur."
msgstr "Ich habe etwas Angst."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_9d7fb10a"
msgid "Tout va bien se passer, ne t'en fais pas."
msgstr "Alles wird gut, keine Sorge."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_05ccb53c"
msgid "Ça te va comme ça ?"
msgstr "Ist das okay?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_a2ece1df"
msgid "Mmhh, oui..."
msgstr "Hmm, ja ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_c4ab69a3"
msgid "Oh, c'est..."
msgstr "Oh, das ist ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_bb1597f2"
msgid "C'est parfait."
msgstr "Perfekt."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_ca068995"
msgid "Je vais accélérer un peu."
msgstr "Ich werde das Tempo ein wenig erhöhen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_a9dad176"
msgid "D'accord."
msgstr "Okay"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_52864ba2"
msgid "Oh, oh, oh..."
msgstr "Oh, oh, oh ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_45c3efc7"
msgid "Un souci ?"
msgstr "Stimmt was nicht?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_00ba2a58"
msgid "Non, ne t'arrêtes surtout pas !"
msgstr "Nein, bitte hör nicht auf!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_b6cbab73"
msgid "Oui, ouiii, comme ça !"
msgstr "Ja, jaaa, genau so!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_e39bd71e"
msgid "C'est trop bonnnn !"
msgstr "Das ist so gut!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_26e61273"
msgid "Plus vite !"
msgstr "Schneller!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_6e73e668"
msgid "Oh, ouii !"
msgstr "JA!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_6748d606"
msgid "Continues, continues !"
msgstr "Mach weiter, mach weiter!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_84cde651"
msgid "Oh, ça monte, ça monte !"
msgstr "Ich komme!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_5273ee49"
msgid "Je vais jouir."
msgstr "Oh, verdammt, hör nicht auf!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_65c4dcee"
msgid "S'il te plait embrasse-moi !"
msgstr "Bitte küss mich!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_fe7da786"
msgid "Ohhh, j'ai des frissons partout..."
msgstr "Oh mein Gott, ich bekomme überall Gänsehaut."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_63a3d3e3"
msgid "C'était tellement bon !"
msgstr "Das war so gut!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_56992702"
msgid "Laisse-moi reprendre un peu mon souffle."
msgstr "Oh Gott, lass mich etwas zu Atem kommen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_1096b23c"
msgid "Oh mon Dieu..."
msgstr "Oh mein Gott ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_376a7866"
msgid "Je t'en prie, appelle-moi juste {{saito.n}}."
msgstr "Bitte, nenn mich einfach {{saito.n}}."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_17b85ae6"
msgid "*Rires* Tu es bête."
msgstr "*Lacht* Du bist albern."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_257438e6"
msgid "Mais je suis si heureuse."
msgstr "Aber ich bin so glücklich."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_5cbbcc60"
msgid "Dire que j'ai attendu si longtemps pour quelque chose d'aussi fantastique."
msgstr "Wenn man daran bedenkt, dass ich so lange auf etwas so Phantastisches gewartet habe ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_2d5d9227"
msgid "Hey, je tiens à préciser que c'est fantastique parce que c'est avec moi !"
msgstr "Hey, ich möchte klarstellen, dass es so phantastisch ist, weil es mit mir war!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_a47b78f6"
msgid "Oui, pardon mon chéri !"
msgstr "Ja, natürlich, Liebling!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_4e7a255a"
msgid "Je pourrais y prendre goût, tu sais..."
msgstr "Ich könnte mich daran gewöhnen, weißt du ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_efb65060"
msgid "Tu risquerais de ne plus avoir un moment pour toi."
msgstr "Du riskierst, keinen Moment mehr für dich zu haben."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_8f9c55f3"
msgid "Je ne vois pas ça comme un problème en fait, mais plutôt comme une chance."
msgstr "Ich sehe das nicht als Problem. Eher als eine Chance."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_e97c5627"
msgid "Tant mieux !"
msgstr "Umso besser!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_59cd6e15"
msgid "Dis..."
msgstr "Hey ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_acb4819d"
msgid "J'ai envie d'essayer autre chose !"
msgstr "Ich möchte etwas anderes ausprobieren!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_5095498f"
msgid "Dis-moi !"
msgstr "Sag’s mir!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_fa8ce102"
msgid "Allonge-toi sur le dos !"
msgstr "Leg dich auf den Rücken!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_49838c21"
msgid "Okay..."
msgstr "Okay ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_6c7fe877"
msgid "J'ai toujours voulu essayer cette position..."
msgstr "Ich wollte das schon immer mal versucht haben ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_e258426c"
msgid "Mais je me suis jamais imaginée le faire avec..."
msgstr "Aber ich hätte nie gedacht, dass ich es mit dir tun würde ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_2e823751"
msgid "Moi ?"
msgstr "Mit mir?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_896a4cd9"
msgid "Non...[w] Avec un engin aussi...[w] massif !"
msgstr "Nein ...[w] Mit etwas so ...[w] Riesigem!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_d8fc2980"
msgid "On va y aller doucement ne t'inquiète pas !"
msgstr "Nun gut, entspann dich, keine Sorge!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_fda0ca4b"
msgid "Mmmhhhh..."
msgstr "Mmmhhhh ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_8e8ab8d9"
msgid "Je la sens tout au fond de moi."
msgstr "Ich kann ihn tief in mir spüren."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_22e825df"
msgid "Et c'est comment ?"
msgstr "Und wie ist es?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_8a0b5aa2"
msgid "C'est... tellement... agréable."
msgstr "Das ist einfach ... so ... gut."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_d3265ab0"
msgid "Je la sens palpiter."
msgstr "Ich kann spüren, wie er pulsiert."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_55b9c611"
msgid "Je... Je crois que je vais jouir !"
msgstr "Ich ... Ich glaube, ich komme!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_4f6d6757"
msgid "Déjà ?"
msgstr "Schon?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_4472e58e"
msgid "C'est... C'est ta faute, c'est trop... bon !"
msgstr "Es ist ... Es ist deine Schuld, dass es zu ... gut ist!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_05c3f8fd"
msgid "Hannnnn..."
msgstr "Hmmmmh ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_ae02476f"
msgid "Dis...[w] C'est normal que tu sois encore aussi dur ?"
msgstr "Also ...[w] Ist es normal, dass du immer noch so hart bist?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_ea17b549"
msgid "Et toi, c'est normal que tu sois encore aussi excitée ?"
msgstr "Und du, ist es normal, dass du immer noch so erregt bist?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_3ff3d86f"
msgid "Je... Je ne sais pas."
msgstr "Ich ... Ich weiß es nicht."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_a8b149e4"
msgid "Je veux juste continuer !"
msgstr "Ich will einfach nur weitermachen!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_90f34032"
msgid "Cette fois-ci, je vais essayer autre chose."
msgstr "Dieses Mal will ich etwas Anderes probieren."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_29505e89"
msgid "Même pas une seconde de répit !"
msgstr "Nicht eine Sekunde Pause!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_dcf1814a"
msgid "Mais soit !"
msgstr "Aber gut, mir gefällt das."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_1c9878f9"
msgid "Mon Dieu... Les sensations sont encore meilleures !"
msgstr "Mein Gott ... So fühle ich ihn noch besser!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_2dc8976c"
msgid "J'ai l'impression que je pourrais jouir à tout moment."
msgstr "Ich habe das Gefühl, dass ich jeden Moment kommen könnte."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_212d391f"
msgid "Alors essaye d'aller plus vite."
msgstr "Also versuch, dich schneller zu bewegen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_ccbbaba5"
msgid "C'est encore mieux."
msgstr "Das ist noch besser."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_901a98f0"
msgid "La... La sensation est trop forte !"
msgstr "Dieses ... dieses Gefühl ist zu stark!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_ebdcf69d"
msgid "Oh, c'est trop bon, c'est trop bon !"
msgstr "Oh, es fühl sich so gut an, so gut!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_ea7d11de"
msgid "Je... Je jouis, ça ne s'arrête plus !"
msgstr "Ich ... Ich komme, es hört gar nicht mehr auf!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_b0fa850d"
msgid "Moi aussi... Ça vient !"
msgstr "Ich auch ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_ccf62854"
msgid "Ne te retire pas, jouis en moi !"
msgstr "Zieh nicht raus, komm in mir!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_7928ef19"
msgid "[i]*respirations haletantes*[/i]"
msgstr "[i]*erschöpftes Atmen*[/i]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_913b3015"
msgid "Oh mon Dieu..."
msgstr "Oh Gott ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_6e67dd3d"
msgid "Tu as aimé ?"
msgstr "Hat es dir gefallen?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_3892724d"
msgid "La question ne se pose même pas."
msgstr "Das kannst du doch nicht wirklich noch fragen?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_bf9a8d67"
msgid "C'était incroyable !"
msgstr "Das war unglaublich!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "home_player_yasuka_room_4f2ac091"
msgid "D'ailleurs, ça m'a donné envie d'essayer encore énormément de choses ?"
