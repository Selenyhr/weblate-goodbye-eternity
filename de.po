msgid "[font_size=14]Mais ce n'est toujours pas le bon mot de passe.[/font_size]"
msgstr ""

#. Character:`narrator`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "UNE_PERSONNE_QUI_AIME_LES_CUL_473F5A"
msgid "Une personne qui aime les culs ne peut jamais être mauvaise !"
msgstr ""

#. Character:`kimochi`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "FONT_SIZE_14_C_EST_C_EST_LE_B_BF1D39"
msgid "[font_size=14]C'est... C'est le bon mot de passe en effet.[/font_size]"
msgstr ""

#. Character:`saito` | Attributes:`sad`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "NON_MAIS_JE_R_VE_65AD7A"
msgid "Non mais je rêve."
msgstr ""

#. Character:`narrator`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "TU_NE_M_EN_AS_JAMAIS_DONN_IDI_8C96AF"
msgid "Tu ne m'en as jamais donné idiot !"
msgstr ""

#. Character:`narrator` | Attributes:`upset`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "LE_RETOUR_LA_R_ALIT_EST_VIOLEN_AD81AD"
msgid "Le retour à la réalité est violent."
msgstr ""

#. Character:`narrator`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "COMMENT_AI_JE_PU_OUBLIER_UNE_T_575A64"
msgid "Comment ai-je pu oublier une telle chose ?"
msgstr ""

#. Character:`narrator`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "EST_CE_QUE_JE_PEUX_D_J_FAIRE_Q_B80500"
msgid "Est-ce que je peux déjà faire quelque chose à mon niveau ?"
msgstr ""

#. Character:`narrator` | Attributes:`sad`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "MERDE_J_EN_SAIS_RIEN_FA31DB"
msgid "Merde, j’en sais rien..."
msgstr ""

#. Character:`narrator`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "BON_SI_JE_R_CAPITULE_MINATO_N_D54009"
msgid "Bon, si je récapitule, {{minato.n}}, {{akira.n}}, les thugs, les dettes à rembourser, un foutu clan yakuza..."
msgstr ""

#. Character:`narrator`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "LA_LISTE_DE_PROBL_MES_NE_FAIT_29293A"
msgid "La liste de problèmes ne fait que s’allonger de plus en plus..."
msgstr ""

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_kimochi_exterior.dialogue
msgctxt "J_AI_BESOIN_DE_ME_CHANGER_LES_6A36EA"
msgid "J'ai besoin de me changer les idées."
msgstr ""

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "talk_sakuya_2a9c4b33"
msgid "Tu me rejoins, mon amour ?"
msgstr "Schließt du dich mir an, mein Lieber?"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "talk_sakuya_ec072b70"
msgid "Je peux m'occuper de toi ici, ou..."
msgstr "Ich kann mich hier um dich kümmern, oder ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "talk_sakuya_85d8f781"
msgid "Notre chambre nous attend."
msgstr "Unser Zimmer wartet auf uns."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "talk_sakuya_08879cab"
msgid "Allez, viens."
msgstr "Komm schon, worauf wartest du?"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "talk_sakuya_042b13c0"
msgid "Je vais bien m'occuper de toi."
msgstr "Ich werde mich gut um dich kümmern."

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "t1cb60feeb9"
msgid "Dans le bain"
msgstr "Im Bad"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "talk_sakuya_06174698"
msgid "Tu es impatient..."
msgstr "Du bist ungeduldig ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "talk_sakuya_c9fc0474"
msgid "Allons-y tout de suite dans ce cas."
msgstr "Dann lass uns gleich loslegen."

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "t5f0be7307b"
msgid "Dans la chambre"
msgstr "Im Zimmer"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "talk_sakuya_b13ff60e"
msgid "Déjà ?"
msgstr "Schon?"

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "tbe9602d797"
msgid "Partir"
msgstr "Verlassen"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_paizuri_6cdebf18"
msgid "Si tu reviens me voir..."
msgstr "Wenn du zu mir zurückkommst ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_paizuri_df253f51"
msgid "Je peux conclure que tu commences à m'aimer ?"
msgstr "Kann ich daraus schließen, dass du anfängst, mich zu lieben?"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_paizuri_a4fdb60e"
msgid "Ou c'est peut-être parce que ce sont ces deux-là que tu aimes ?"
msgstr "Oder liegt es vielleicht daran, dass du die beiden hier liebst?"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_paizuri_f0f167e7"
msgid "L'un et l'autre me conviennent, ils ne sont là que pour ton plaisir, mon amour."
msgstr "Ich bin mit beidem einverstanden. Sie sind nur für dein Vergnügen da, mein Liebster."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_paizuri_e0567e62"
msgid "Tu n'as pas à te retenir."
msgstr "Du musst dich nicht zurückhalten."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_paizuri_edd2069b"
msgid "Ça t'a plu, mon amour ?"
msgstr "Hat es dir gefallen, mein Liebster?"

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "tfaba8d3016"
msgid "Recommencer"
msgstr "Von Neuem beginnen"

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "t1d69e1b89d"
msgid "Poursuivre dans la chambre"
msgstr "Im Schlafzimmer weitermachen"

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "t1f79f56451"
msgid "Partir"
msgstr "Verlassen"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_room_sexe_079f9d64"
msgid "Han hann..."
msgstr "Ah aaah ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_room_sexe_b64deff0"
msgid "Je savais que tu reviendrais vers moi."
msgstr "Ich wusste, dass du zu mir zurückkommen würdest."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_room_sexe_1b65919e"
msgid "Je suis la seule qui puisse te donner satisfaction."
msgstr "Ich bin die einzige, die dich befriedigen kann."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_room_sexe_94511d3a"
msgid "Si tu le veux, nous pourrions le faire toute la nuit !"
msgstr "Wenn du willst, können wir es die ganze Nacht lang treiben!"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_room_sexe_8cce1697"
msgid "Ce soir, tu es à moi et à moi seule !"
msgstr "Heute Nacht gehörst du mir und nur mir allein!"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_room_sexe_1be853cf"
msgid "Alors mon amour, tu t'arrêtes là ? Ou es-tu prêt à transpirer toute la nuit avec moi ?"
msgstr "Also, mein Liebster, gibst du hier auf? Oder bist du bereit, die ganze Nacht mit mir zu schwitzen?"

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "t25df6b91b6"
msgid "Recommencer"
msgstr "Von Neuem beginnen"

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "t6994e975c6"
msgid "Partir"
msgstr "Verlassen"

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_433be3bf"
msgid "Woah..."
msgstr "Wow ..."

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_f9aeb7e9"
msgid "C'est vraiment magnifique !"
msgstr "Es ist wirklich schön!"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_6afdfd75"
msgid "Je savais bien que ça te plairait..."
msgstr "Ich wusste, dass es dir gefallen würde ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_ab8fff7e"
msgid "Je venais souvent ici avec ma mère."
msgstr "Früher bin ich oft mit meiner Mutter hierher gekommen."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_34d1b9cb"
msgid "Mais c'était avant qu'elle..."
msgstr "Aber das war, bevor sie ..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_952ee9a7"
msgid "Oh... Il lui est arrivé quelque chose ?"
msgstr "Oh ... Ist ihr etwas zugestoßen?"

#. Character:`sakuya` | Attributes:`sad`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_56ca0310"
msgid "Oui... Mais c'est encore trop tôt pour moi d'en parler."
msgstr "Ja ... Aber es ist noch zu früh, um darüber zu sprechen."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_91dc60b1"
msgid "Je te ferai savoir quand je serai prête."
msgstr "Ich werde dir Bescheid geben, wenn ich bereit dazu bin."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_998cf88a"
msgid "Tu me rejoins dans l'eau ?"
msgstr "Kommst du mit mir ins Wasser?"

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_c94b2470"
msgid "Hmm, il me semble qu'il soit arrivé quelque chose à sa mère..."
msgstr "Hmm, es scheint mir, dass etwas mit ihrer Mutter passiert ist ..."

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_965c0a3a"
msgid "Ce qui explique peut-être pourquoi je ne l'ai pas vue au restaurant."
msgstr "Das erklärt, warum ich sie nie im Restaurant gesehen habe."

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_2a0949c0"
msgid "C'est peut-être un sujet sensible que je pourrais exploiter ?"
msgstr "Vielleicht ist das ein sensibles Thema, das ich ausnutzen könnte?"

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_6f3ba445"
msgid "Mais à quoi je pense ?! Quel connard je ferais si m'abaissais à ça, surtout si sa mère est décédée..."
msgstr "Was denke ich mir bloß?! Was für ein Arschloch wäre ich, wenn ich mich dazu herablassen würde, vor allem, wenn ihre Mutter gestorben ist ..."

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_0f358720"
msgid "Mon chéri ?"
msgstr "Liebling?"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_f51e784f"
msgid "Quelque chose ne va pas ?"
msgstr "Stimmt etwas nicht?"

#. Character:`saito` | Attributes:`happy`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_eb65d949"
msgid "Euh... Non, je réfléchissais."
msgstr "Äh ... Nein, ich hab nur nachgedacht."

#. Character:`sakuya` | Attributes:`blush,pouting`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_f10cd24b"
msgid "Tu voulais me voir sans ma serviette, c'est ça ?"
msgstr "Du wolltest mich ohne Handtuch sehen, oder?"

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_8226b02f"
msgid "...[w] Oui, c'est exactement ça !"
msgstr "...[w] Ja, genau das war’s!"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_c2b81512"
msgid "Il suffisait de me demander !"
msgstr "Du hättest einfach nur fragen müssen!"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_c8e21d6a"
msgid "Voilà... C'est la première fois que je suis nue devant un garçon."
msgstr "Bitte schön ... Das ist das erste Mal, dass ich nackt vor einem Jungen stehe."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_2b27dd65"
msgid "Je voulais que ce soit toi."
msgstr "Ich wollte, dass du derjenige bist."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_a02f54b1"
msgid "Comment tu me trouves ?"
msgstr "Nun, was sagst du?"

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_739d1407"
msgid "Je.... je..."
msgstr "Ich ... ich ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "tce9b77019b"
msgid "[next]"
msgstr "[next]"

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_70c10122"
msgid "Menteur !"
msgstr "Lügner!"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_a0f043fe"
msgid "...Tu n'aimes pas ma poitrine maintenant, mais d'ici peu de temps, tu ne pourras plus t'en passer."
msgstr "... Du magst meine Brüste jetzt vielleicht nicht, aber bald wirst du nicht mehr ohne sie leben können."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_90ce91c8"
msgid "Allons nous baigner et tu verras à quel point une grosse poitrine peut être utile."
msgstr "Lass uns ins Bad gehen und du wirst sehen, welche Vorzüge große Brüste haben."

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "tbc116d71b2"
msgid "Je préfère les petites poitrines."
msgstr "Ich bevorzuge kleine Brüste."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_90e6b10e"
msgid "... Merci... Tu es adorable."
msgstr "... Danke, du bist süß."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_e93b4256"
msgid "J'avais peur que tu n'aimes pas ma poitrine énorme, mais..."
msgstr "Ich hatte Angst, dass dir meine riesige Brüste nicht gefallen würde, aber ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_4116c12a"
msgid "Je suis contente que ce ne soit pas le cas."
msgstr "Ich bin froh, dass das nicht der Fall ist."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_6bb7c222"
msgid "Je vais te remercier à ma façon."
msgstr "Ich werde dir auf meine Weise danken."

#. Character:`narrator`
#: game/story/onsen_bath.dialogue
msgctxt "tc095f78fe6"
msgid "Tu es... magnifique."
msgstr "Du bist ... perfekt."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_9785fd0f"
msgid "Je suis certaine que personne ne t'a encore fait ça !"
msgstr "Ich bin mir sicher, dass du das noch nie erleben durftest!"

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_702ed716"
msgid "...Non."
msgstr "... Nein."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_84b71607"
msgid "C'est la première fois que je fais ça..."
msgstr "Das ist das erste Mal, dass ich das mache ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_ddef315b"
msgid "Ça te plaît ?"
msgstr "Gefällt es dir?"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_e1f45a15"
msgid "J'ai regardé plein de vidéos pour apprendre ce genre de choses !"
msgstr "Ich habe mir viele Videos angesehen, um das hier zu lernen!"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_0e9b77e4"
msgid "Je me suis longtemps entraînée rien que pour toi."
msgstr "Ich habe all die Jahre nur für dich geübt!"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_da1372ef"
msgid "Tu ne dis rien..."
msgstr "Du bist so still ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_b2268139"
msgid "Tu m'en veux toujours, c'est ça ?"
msgstr "Du bist immer noch sauer auf mich, oder?"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_599787d2"
msgid "Si tu ne dis rien, ça veut dire que tu apprécies."
msgstr "Wenn du nichts sagst, muss das heißen, dass es dir gefällt."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_9f1c235e"
msgid "Je vais aller plus vite."
msgstr "Ich mach’s etwas schneller."

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_194fa267"
msgid "...Je... je..."
msgstr "Ich ... ich ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_21b8012b"
msgid "Je la sens vibrer !"
msgstr "Ich kann spüren, wie er vibriert!"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_3723c1b7"
msgid "Tu peux le faire sur ma poitrine, ne t'en fais pas."
msgstr "Keine Sorge, du kannst es ruhig auf meinen Brüsten entladen."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_b31c75e9"
msgid "Elle t'appartient !"
msgstr "Sie gehören dir!"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_16eeada0"
msgid "Voilà..."
msgstr "Okay ..."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_ed081e12"
msgid "Oh, il y en a tellement !"
msgstr "Oh, so viel!"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_6629f330"
msgid "Tu as aimé mon chéri ?"
msgstr "Hat es dir gefallen, mein Schatz?"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_142c3eb7"
msgid "Je suis prête à le faire autant que tu me le demanderas."
msgstr "Ich mach’s sooft, wie du willst."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_139ef64b"
msgid "Ton corps, au moins, réagit de manière honnête."
msgstr "Zumindest dein Körper reagiert ehrlich."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_542f0678"
msgid "Ce n'était qu'un amuse-bouche..."
msgstr "Das war allerdings nur ein Vorgeschmack auf das, was kommt."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_a51cfb35"
msgid "Le vrai plat de résistance va arriver."
msgstr "Das beste kommt noch."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_4a19f097"
msgid "La chambre doit être prête à présent !"
msgstr "Unser Zimmer sollte jetzt fertig sein!"

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_cbbe049d"
msgid "La chambre ?"
msgstr "Unser Zimmer?"

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_766e84cc"
msgid "Oui ![w] Tu ne te souviens pas ? J'ai dit qu'on allait passer la nuit ici."
msgstr "Ja![w] Hast du es vergessen? Ich sagte, wir würden die Nacht hier verbringen."

#. Character:`sakuya`
#: game/story/onsen_bath.dialogue
msgctxt "onsen_bath_4dcd7cbf"
msgid "Tu viens ?"
msgstr "Kommst du?"

#. Character:`sayuri`
#: game/story/onsen_bath.dialogue
msgctxt "t5f66cf09fa"
msgid "Je ne sais pas pourquoi ma fille n'a rien tentée avec toi mais peut-être que je devrais en profiter"
msgstr "Ich weiß nicht, warum meine Tochter bei dir noch nichts versucht hat, aber vielleicht sollte ich das ausnutzen."

#. Character:`sayuri`
#: game/story/onsen_bath.dialogue
msgctxt "t8b52cc41e4"
msgid "Si j'avais su... Je t'aurais mis le grappin dessus avant {{asami.n}}."
msgstr "Wenn ich das gewusst hätte ... Dann hätte ich mich vor {{asami.n}} an dich rangemacht."

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "tdf0905f9c1"
msgid "...Je ne sais pas trop comment réagir face a cette information."
msgstr "... Ich weiß nicht so recht, wie ich darauf reagieren soll."

#. Character:`sayuri`
#: game/story/onsen_bath.dialogue
msgctxt "t0416d1c688"
msgid "haha... Ne soit pas aussi timide voyons."
msgstr "Haha ... Sei nicht so schüchtern. Komm schon!"

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "tb4c582dd9c"
msgid "Au lieu d'essayer de me taquiner parle moi plutôt de toi."
msgstr "Anstatt zu versuchen, mich zu necken, erzähl mir lieber von dir."

#. Character:`sayuri`
#: game/story/onsen_bath.dialogue
msgctxt "t2abbad7b46"
msgid "Je ne sais pas s'il y a des choses intéressantes à dire sur moi."
msgstr "Ich weiß nicht, ob es irgendwas Spannendes über mich zu erzählen gibt."

#. Character:`centered`
#: game/story/onsen_bath.dialogue
msgctxt "tf17cbafb40"
msgid "{{saito.n}} et {{sayuri.n}} discutent de tout et de rien, passant un agréable moment tous les deux."
msgstr "{{saito.n}} und {{sayuri.n}} reden über alles Mögliche und genießen die Unterhaltung."

#. Character:`sayuri`
#: game/story/onsen_bath.dialogue
msgctxt "tca3eaf90b7"
msgid "Mais tout de même..."
msgstr "Aber dennoch ..."

#. Character:`sayuri`
#: game/story/onsen_bath.dialogue
msgctxt "t3a293a93df"
msgid "Maintenant que j'y pense, je trouve que tu as été un peu trop audacieux."
msgstr "Jetzt, wo ich so darüber nachdenke, glaube ich, dass du ein wenig zu dreist warst."

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "t73967b3c38"
msgid "Comment ça ?"
msgstr "Was meinst du?"

#. Character:`sayuri`
#: game/story/onsen_bath.dialogue
msgctxt "tcfa950dfa7"
msgid "Diabolique même !"
msgstr "Vielleicht sogar diabolisch!"

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "t39a93ffac4"
msgid "..."
msgstr "..."

#. Character:`sayuri`
#: game/story/onsen_bath.dialogue
msgctxt "tc2426a6f07"
msgid "Voyons... Emmener une femme à devoir se déshabiller complètement lors du premier rendez vous... Tu appelle ça comment toi ?"
msgstr "Lass mich mal sehen ... Eine Frau beim ersten Date zum Ausziehen zu bewegen ... Wie nennt man das?"

#. Character:`saito`
#: game/story/onsen_bath.dialogue
msgctxt "t4218b13c25"
msgid "...[w]Une opportunité ?"
msgstr "...[w] Eine Gelegenheit?"

#. Character:`sayuri`
#: game/story/onsen_bath.dialogue
msgctxt "tbb85b09953"
msgid "Petit coquin !"
msgstr "Versauter Junge!"

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_6a6bf17e"
msgid "Tu es sûr que tu vas bien ?"
msgstr "Bist du sicher, dass es dir gut geht?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_2583d1c1"
msgid "Mais oui, ne t'inquiète pas autant..."
msgstr "Ja. Mach dir nicht so viele Sorgen ..."

#. Character:`yasuka`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_f5c3c4c5"
msgid "Je ne suis pas une petite chose fragile."
msgstr "Ich bin nicht so zerbrechlich und zart besaitet."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_d3ca1196"
msgid "Je suis heureuse, comme si un poids avait été levé sur mes épaules."
msgstr "Ich bin glücklich, als wäre eine riesige Last von meinen Schultern genommen worden."

#. Character:`narrator`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_2f305da6"
msgid "Peut-être que l'effet de cette drogue était surestimé..."
msgstr "Vielleicht wurden die Wirkungen dieser Droge übertrieben ..."

#. Character:`narrator`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_963481e4"
msgid "Je ne sais pas trop quoi faire."
msgstr "Ich weiß nicht, was ich tun soll."

#. Character:`narrator`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_33d20ebc"
msgid "Je ne peux pas aller voir la police pour leur raconter tout ça, on risque de me prendre pour un fou."
msgstr "Ich kann nicht zur Polizei gehen und denen das alles erzählen, sonst halten sie mich für verrückt."

#. Character:`narrator`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_62e946f4"
msgid "Et au pire, je pourrais avoir des problèmes."
msgstr "Und im schlimmsten Fall könnte ich in Schwierigkeiten geraten."

#. Character:`narrator`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_8abbae80"
msgid "Le mieux que je puisse faire pour le moment est de continuer à veiller sur elle."
msgstr "Das Beste, was ich jetzt tun kann, ist, mich weiterhin um sie zu kümmern."

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_3536ee0b"
msgid "On rentre à la maison ?"
msgstr "Sollen wir dann nach Hause gehen?"

#. Character:`yasuka`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_6c4a2977"
msgid "Oui !"
msgstr "Ja!"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_6aa96ff1"
msgid "Mais ce soir, je dors avec toi."
msgstr "Aber heute Nacht schlafe ich bei dir."

#. Character:`yasuka`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_e9052fe2"
msgid "D'ailleurs à partir de maintenant, je dors tous les soirs avec toi !"
msgstr "Ich denke, ab jetzt werde ich jede Nacht bei dir schlafen!"

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "love_hotel_room_0c663a1d"
msgid "Euh, je... d'accord !"
msgstr "Ähm, ich ... okay!"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/love_hotel_room.dialogue
msgctxt "te94a29a8e7"
msgid "Je te veux là ! [w]Maintenant ! [w]Tout de suite !"
msgstr "Ich will dich hier! [w]Jetzt![w] Jetzt sofort!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/love_hotel_room.dialogue
msgctxt "tc604a699c8"
msgid "Euh..."
msgstr "Ähm ..."

#. Character:`sayuri` | Attributes:`pouting,blush`
#: game/story/love_hotel_room.dialogue
msgctxt "tf65d5ff4d0"
msgid "Tout de suite !"
msgstr "Jetzt sofort!"

#. Character:`saito` | Attributes:`happy`
#: game/story/love_hotel_room.dialogue
msgctxt "t3ffdaa6113"
msgid "Très bien !"
msgstr "In Ordnung!"

#. Character:`sayuri` | Attributes:`moved,blush`
#: game/story/love_hotel_room.dialogue
msgctxt "t39cb8ac5cf"
msgid "Tu m'a montré beaucoup de douceur et de tendresse..."
msgstr "Du hast mir eine Menge Zärtlichkeit gezeigt ..."

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "t88a810f8fb"
msgid "Et c'est une bonne chose...?"
msgstr "Und das ist etwas Gutes ...?"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/love_hotel_room.dialogue
msgctxt "t78c6696c22"
msgid "Bien sur !"
msgstr "Natürlich!"

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "ta373121ec6"
msgid "Mais je veux que tu me montre ton coté sauvage maintenant !"
msgstr "Aber jetzt will ich, dass du mir deine wilde Seite zeigst!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/love_hotel_room.dialogue
msgctxt "t70bdbe65c7"
msgid "Mon coté sauvage mhhhh....."
msgstr "Meine wilde Seite, hmm ..."

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t62cfd9930a"
msgid "Hey ! Brute !"
msgstr "Hey! Wie roh!"

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t19a354659f"
msgid "...[w]Continue..."
msgstr "...[w] Mach weiter so ..."

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "t5b1b6139a5"
msgid "J'espère pour toi que tu tiendras la distance !"
msgstr "Ich hoffe für dich, dass du bis zum Ende durchhalten wirst!"

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t9c5c38d4ff"
msgid "Il n'y a qu'une façon de le savoir."
msgstr "Es gibt nur einen Weg, das herauszufinden."

#. TRANSLATORS: Idle Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t255087607c"
msgid "Je n'ai pas arrétée d'y penser toute la journée !"
msgstr "Ich konnte den ganzen Tag an nichts Anderes denken!"

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "t126a5fa9ee"
msgid "Vraiment ?"
msgstr "Wirklich!"

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t961fe3b79d"
msgid "Allez arrete de me faire languir comme ça !"
msgstr "Komm schon, lass mich hier nicht so hängen!"

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "td42f6c8edf"
msgid "Très bien."
msgstr "Alles klar."

#. TRANSLATORS: Vaginal slow (transition auto: 1.15s) Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t5f9a6e9e6a"
msgid "Je suis enfin débarassée de toutes ses pensées parasites."
msgstr "Ich bin all seine parasitären Gedanken endlich los."

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "teb5781b937"
msgid "Je veux en profiter au maximum !"
msgstr "Ich will es bis aufs Letzte auskosten!"

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t9385471253"
msgid "Je veux aussi que tu en profites aussi avec moi."
msgstr "Ich will, dass du es mit mir gemeinsam genießt."

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t2e8227c5b8"
msgid "Oublie tout le reste, cette nuit, il n'y a que toi et moi."
msgstr "Vergiss alles andere, heute Nacht zähle nur du und ich."

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "tce36e81266"
msgid "Dans ce cas, rendons ça inoubliable."
msgstr "Dann lass es uns unvergesslich machen."

#. TRANSLATORS: Vaginal medium Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "ta611b6abed"
msgid "mhhh... J'aurais tellement voulue avoir 10 ans de moins..."
msgstr "Hmmm ... Ich wünschte, ich wäre zehn Jahre jünger ..."

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "t13599beb42"
msgid "Encore cette réflexion ?"
msgstr "Schon wieder dieser Gedanke?"

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t14e17e18b8"
msgid "Tu ne comprend pas..."
msgstr "Du verstehst einfach nicht ..."

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "td1e82e76ec"
msgid "Mais moi je te prefere tel que tu es maintenant."
msgstr "Aber ... Ich ziehe dich, so wie du jetzt bist, vor."

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "te5382483a3"
msgid "Tu ne vois pas a quel point je suis excité ?"
msgstr "Kannst du nicht sehen, wie hart ich bin?"

#. TRANSLATORS: Vaginal fast Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t7845fc1efe"
msgid "Si... Tu as raison... Je suis désolée..."
msgstr "Ja ... Du hast recht, es tut mir leid ... entschuldige, ich ..."

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "t404d40c710"
msgid "Oublie tes craintes, tu dois seulement apprécier l'instant."
msgstr "Vergiss deine Ängste und genieß einfach den Augenblick."

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t7240edcf1f"
msgid "C'était si étrange de ma part de vouloir te mettre le grappin dessus et de te garder rien que pour moi ?"
msgstr "War es so ungewöhnlich von mir, dass ich meine Arme um dich schlingen und dich nur für mich behalten wollte?"

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "t979d989043"
msgid "Non ce n'était pas étrange, juste audacieux."
msgstr "Nein, das war nicht ungewöhnlich, nur waghalsig."

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "tdef86131ce"
msgid "C'est tout moi ça !"
msgstr "Das ist mein zweiter Vorname!"

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "t4d2cbd331b"
msgid "Dans ce cas, si tu es audacieuse..."
msgstr "Wenn das so ist, da du so waghalsig bist ..."

#. TRANSLATORS: Anal slow (transition auto: 2.167s) Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t81954b3af2"
msgid "Oh! Je... je ne sais pas si..."
msgstr "Oh! Ich ... Ich weiß nicht, ob ..."

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t94fb7a9995"
msgid "Une seconde, ce n'est pas si douloureux que je le pensais..."
msgstr "Oh, warte ... Das ist nicht so schmerzhaft, wie ich angenommen hatte ..."

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t47e4c147e1"
msgid "C'est même... agréable en fait."
msgstr "Das ist sogar ... überraschend gut."

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "t16a4666944"
msgid "Parfait dans ce cas..."
msgstr "Perfekt, in dem Fall ..."

#. TRANSLATORS: Anal medium Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "tc0a27b8edf"
msgid "Alors ?"
msgstr "Also?"

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "tec445b87fb"
msgid "...[w]Ne te moque pas !"
msgstr "...[w] Lach mich nicht aus!"

#. Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "ta848e4a0e5"
msgid "Et donc ?"
msgstr "Na und?"

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "t4c0549aac5"
msgid "C'est encore plus excitant maintenant vas'y plus fort !"
msgstr "Jetzt ist es noch aufregender. Härter!"

#. TRANSLATORS: Anal fast Character:`saito`
#: game/story/love_hotel_room.dialogue
msgctxt "t95ca7e4b7c"
msgid "A vos ordres !"
msgstr "Wie du wünschst!"

#. Character:`sayuri`
#: game/story/love_hotel_room.dialogue
msgctxt "td050ce01d1"
msgid "Oh bon sang quel pied !"
msgstr "Oh mein Gott, was ist das für ein Gefühl?"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_c0cf9bbe"
msgid "Alors ?"
msgstr "Also?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_f1afd5ae"
msgid "J'ai du mal à comprendre pourquoi tu m'as amené ici..."
msgstr "Ich verstehe nicht, warum du mich hierher gebracht hast."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_a2ce38ea"
msgid "Pour mieux apprendre à te connaître..."
msgstr "Um dich besser kennenzulernen ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_7806b9a2"
msgid "Tu passes ton temps à courir partout comme si tu étais toujours pressé."
msgstr "Du verbringst deine Zeit damit, rumzurennen, als hättest du es immer eilig."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_58b4965d"
msgid "Ralentis le rythme et profite un peu des vacances."
msgstr "Entspann dich und genieß die Ferien ein bisschen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_192596e8"
msgid "J'aimerais bien mais je n'ai pas ce luxe."
msgstr "Ich wünschte, es wäre so einfach."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_41ab7a3d"
msgid "La rentrée est pour bientôt et si je ne suis pas \"prêt\" je vais encore vivre l'enfer."
msgstr "Es geht sehr bald zurück in die Schule und wenn ich nicht bereit bin, wird das für mich wieder die Hölle."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_2ff9e0c3"
msgid "Oh tu parles de..."
msgstr "Oh, du sprichst von ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_a2d9697d"
msgid "Oui."
msgstr "Ja."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_0b7d8a15"
msgid "Je..."
msgstr "Ich ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_2ec8ab6b"
msgid "Laisse tomber, je sais que tu n'y es pour rien."
msgstr "Keine Sorge, ich weiß, dass es nicht deine Schuld ist."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_21b886b7"
msgid "Je m'en veux quand même de ne pas pouvoir faire plus."
msgstr "Ich werfe mir immer noch vor, dass ich nicht mehr habe tun können."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_fb36312c"
msgid "Tu risquerais toi aussi de te mettre tout le monde à dos..."
msgstr "Du würdest aber auch riskieren, dich von allen anderen zu entfremden."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_b7dcd419"
msgid "Je vais reprendre ma vie en main, apprendre à ne plus me faire marcher sur les pieds car tout ça... ce n'est que le début des ennuis."
msgstr "Ich werde mein Leben zurück in die eigene Hand nehmen und lernen, wie ich mich behaupten kann, denn all das hier ... Ist gerade mal der Anfang meiner Probleme."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_1eef9e3c"
msgid "Comment ça le début ?"
msgstr "Was meinst du mit „der Anfang“?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_9799edeb"
msgid "Je parle de la vie après la fac..."
msgstr "Ich rede über das Leben nach der Schule ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_924ea9f3"
msgid "Les problèmes d'aujourd'hui ne sont rien à coté de ceux qui nous attendent."
msgstr "Meine gegenwärtigen Probleme sind ein Witz verglichen mit dem, was mich erwartet."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_79bd3a19"
msgid "C'est fou... Plus je t'écoute et plus j'ai l'impression de parler avec un vieux."
msgstr "Das ist übel ... Je länger ich dir zuhöre, desto eher habe ich das Gefühl, mich mit einem alten Greis zu unterhalten."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_f044b30a"
msgid "Hey !"
msgstr "Hey!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_41fa78cb"
msgid "Si la vie est aussi triste que tu sembles le penser, alors profitons à fond du temps qu'il nous reste."
msgstr "Wenn das Leben so traurig ist, wie du denkst, dann lass uns das beste aus der Zeit machen, die uns noch bleibt!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_3e10c4d0"
msgid "Passons nos après-midis à jouer à la console."
msgstr "Lass uns unsere Nachmittage damit verbringen, Videospiele zu spielen."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_2a02fb6e"
msgid "Allons manger des udons ensemble."
msgstr "Lass uns gemeinsam Udon essen."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_aad158e4"
msgid "Dormons à la belle étoile et discutons de tout et de rien jusqu'au lever du soleil."
msgstr "Lass uns unter den Sternen schlafen und über alles in unserem Leben reden, bis zum Morgengrauen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_8588df8b"
msgid "... Tu veux discuter ou dormir ? Décide-toi."
msgstr "... Willst du jetzt schlafen oder reden? Entscheid dich."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_39cbc2de"
msgid "Les deux {{saito.n}}, je veux faire tout ça et encore plus !"
msgstr "Beides, {{saito.n}}! Ich will beides machen und noch so viel mehr!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_fe08ea3e"
msgid "Dit comme ça... Ça donne envie."
msgstr "Wenn du es so formulierst, klingt es ... schön."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_9ee27b04"
msgid "Bien sûr ! Et je suis certaine qu'on pourrait encore faire un millier de choses !"
msgstr "Natürlich! Und ich bin mir sicher, wir könnten noch tausend andere Sachen machen!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_ace7bd46"
msgid "Mais..."
msgstr "Aber ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_6ca6b3aa"
msgid "Mais pas avant d'avoir repris ta vie en main c'est ça ?"
msgstr "Aber nicht, bevor du nicht die Kontrolle über dein Leben zurückerlangt hast, oder?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_ef2f8954"
msgid "Exactement !"
msgstr "Genau!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_b0878a1e"
msgid "Puisque c'est comme ça... Je vais t'aider !"
msgstr "Dann soll es so sein ... Ich werde dir helfen!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_ceba36e7"
msgid "M'aider ? Non, ne te mêle pas de ça, tu ne sais vraiment pas à quoi tu t'exposes."
msgstr "Mir helfen? Nein, bitte misch dich da nicht ein. Du weißt wirklich nicht, wo du da reingerätst."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_81dd777d"
msgid "Et puis s'il t'arrivait quelque chose à cause de moi..."
msgstr "Und wenn dir meinetwegen etwas zustieße ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_87c47280"
msgid "Je m'en moque... Tu as passé trop de temps à te battre tout seul."
msgstr "Ist mir egal ... Du hast schon viel zu viel Zeit damit verbracht, alleine zu kämpfen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_da58eadc"
msgid "... T'es toujours aussi optimiste ?"
msgstr "... Bist du immer so optimistisch?"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_7f6dc742"
msgid "Oui !"
msgstr "Ja!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_e0851f7f"
msgid "D'ailleurs c'est quoi la prochaine étape apres la course ? Apprendre à se défendre ?"
msgstr "Übrigens, was ist der nächste Schritt nach dem Joggen? Selbstverteidigung lernen?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_74160d93"
msgid "Oui d'ailleurs je..."
msgstr "Ja, was das betrifft, ich ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_a6e7311e"
msgid "Attaque de la motte de terre !"
msgstr "Erdattacke!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_68fad403"
msgid "Bloarf..."
msgstr "Igitt ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_822fb0a8"
msgid "Bordel, tu m'as envoyé de la terre dans la bouche !"
msgstr "Verdammt, du hast mir Erde in den Mund geworfen!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_dadb39bd"
msgid "Haha !"
msgstr "Haha!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_915f1f2b"
msgid "Franchement je ne comprends pas..."
msgstr "Ehrlich gesagt, ich verstehe nicht so ganz ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_b47a6f3b"
msgid "Quoi donc ?"
msgstr "Was?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_130797e8"
msgid "Pourquoi il t'a rejetée."
msgstr "Warum er dir einen Korb gegeben hat."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_27657eac"
msgid "T'es plutôt... Je veux dire..."
msgstr "Du bist irgendwie ... Ich meine ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_2b11d8d5"
msgid "Oui dis-moi {{saito.n}}, ça m'intéresse, je suis ?.."
msgstr "Ja, spuck’s aus, {{saito.n}}! Jetzt bin ich neugierig. Ich bin irgendwie was ...?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_e5720ab9"
msgid "...[w] Je vais rien dire car sinon tes chevilles vont gonfler !"
msgstr "...[w] Ich werde lieber die Klappe halten, sonst steigt dir das noch zu Kopf!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_1c69aad7"
msgid "Pfff !"
msgstr "Pfff!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_07fdf942"
msgid "J'ai juste du mal à comprendre c'est tout..."
msgstr "Ich verstehe nur einfach nicht ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_87a50816"
msgid "Oulah il est déjà aussi tard ?! Je vais devoir rentrer !"
msgstr "Wow, schon so spät?! Ich muss nach Hause!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_985af6c1"
msgid "Je te raccompagne ?"
msgstr "Soll ich dich begleiten?"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_11b6ef1b"
msgid "J'espère bien ! Qui sait ce qu'il pourrait arriver à une fille comme moi..."
msgstr "Ich hoffe doch! Wer weiß, was mit einem armen Mädchen wie mir passieren könnte ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_f347c217"
msgid "Aller raconte-moi tout !"
msgstr "Komm schon, erzähl mir alles!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_5ac3011f"
msgid "On était obligés de venir aussi loin pour discuter ?"
msgstr "Hätten wir wirklich bis hierhin laufen müssen, nur um zu reden?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_92eb59cd"
msgid "On aurait très bien pu rester dans la chambre ou au parc..."
msgstr "Wir hätten einfach zu Hause oder im Park bleiben können ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_f2f6c315"
msgid "C'est plus reposant ici je trouve..."
msgstr "Ich glaube, ich finde es hier entspannter ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_eb7c9c79"
msgid "Allez ! Dis-moi ce qu'il s'est passé !"
msgstr "Komm schon! Erzähl mir, was passiert ist!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_22c0c19f"
msgid "J'ai eu droit a s-"
msgstr "Ich habe ein Recht, es zu-"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_15188766"
msgid "Tiens mais qui voilà ?"
msgstr "Oh, wer ist denn da?"

#. Character:`minato`
#: game/story/canal.dialogue
msgctxt "canal_74ef2a24"
msgid "{{asami.n}}... Je suis venu pour te présenter mes excuses."
msgstr "{{asami.n}} ... Ich wollte mich entschuldigen."

#. Character:`minato`
#: game/story/canal.dialogue
msgctxt "canal_392ed8b1"
msgid "Je sais que je n'aurais jamais dû te parler comme ça et... je le regrette sincèrement."
msgstr "Ich weiß jetzt, dass ich mit dir nie so hätte umgehen dürfen und ich ... Ich bereue es wirklich."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_b525af17"
msgid "Bah voyons..."
msgstr "Was du nicht sagst ..."

#. Character:`minato`
#: game/story/canal.dialogue
msgctxt "canal_8958fe0d"
msgid "Est-ce que tu crois que je pourrais te parler en privé en souvenir de toutes ces années en commun ?"
msgstr "Denkst du, ich könnte mit dir unter vier Augen sprechen, um der alten Zeiten willen?"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_6a1adb7c"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_9d718a0f"
msgid "Éloigne-toi d'elle ! Je ne sais pas à quel jeu tu joues mais c'est hors de question, tu es juste un putain de sociopathe  !"
msgstr "Lass sie in Ruhe! Ich weiß nicht, was für ein falsches Spiel du spielst, aber das ist egal! Du bist nur ein verfickter Soziopath!"

#. Character:`minato`
#: game/story/canal.dialogue
msgctxt "canal_ea0e7493"
msgid "Je ne te demande que quelques minutes et ensuite tu décideras si tu ne veux plus m'adresser la parole."
msgstr "Ich frage nur nach ein paar Minuten und danach kannst du selbst entscheiden, ob du noch mit mir reden willst."

#. Character:`minato`
#: game/story/canal.dialogue
msgctxt "canal_01d005e7"
msgid "Je n'ai sincèrement besoin que de quelques minutes en tête-à-tête."
msgstr "Ich brauche ehrlich gesagt einfach nur ein paar Minuten alleine."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_3717acb7"
msgid "Ne t'inquiète pas, je sais ce que je fais."
msgstr "Keine Angst, ich weiß, was ich tue."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_71a32abc"
msgid "Je vais aller lui parler et mettre les choses au clair."
msgstr "Ich werde mit ihm reden und die Dinge ein für allemal klären."

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_62910739"
msgid "Mais c'est un-"
msgstr "Aber er ist ein-"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_a9a627b3"
msgid "Fais-moi confiance {{saito.n}}."
msgstr "Vertrau mir, {{saito.n}}."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_a90aa9c1"
msgid "J'en aurais pas pour longtemps !"
msgstr "Es wird nicht lange dauern"

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "td757d0d0c6"
msgid "Ne l'écoute pas, cette enflure ment comme il respire !"
msgstr "Hör nicht auf ihn! Er lügt, das tut er immer!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_a0f478d6"
msgid "J'accepte mais seulement quelques minutes."
msgstr "In Ordnung, aber nur für ein paar Minuten."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_65476965"
msgid "Ne crois pas que je te pardonnerais aussi facilement."
msgstr "Glaub ja nicht, dass ich dir so einfach vergebe."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_fa14eca9"
msgid "{{saito.n}}, je suis sincèrement désolée je vais devoir te laisser quelques minutes."
msgstr "{{saito.n}}, es tut mir wirklich leid, aber du wirst ein paar Minuten hier warten müssen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_afdb9074"
msgid "Ne t'en fais pas, je ne serai pas loin, ce type n'est vraiment pas ce qu'il prétend être."
msgstr "Keine Sorge, ich werde nicht weit weg sein. Der Typ ist wirklich nicht der, der er vorgibt, zu sein."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "t6ec60c8085"
msgid "[i]Ne rien dire.[/i]"
msgstr "[i]Nichts sagen.[/i]"

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_88a4b4bf"
msgid "Fuck !"
msgstr "Fuck!"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "canal_cd44c71f"
msgid "Eh bien je n'aurais jamais cru voir ça un jour..."
msgstr "Nun, ich hätte nie gedacht, dass ich das eines Tages mal sehen würde ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_d80028ec"
msgid "Encore toi ?! Qu'est ce que tu veux ?"
msgstr "Du schon wieder?! Was willst du?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "canal_79f098f9"
msgid "Qui sait..."
msgstr "Die Antwort, mein Freund, weiß ganz allein der Wind ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_fa2144b7"
msgid "C'est quoi son projet ?! Est-ce qu'il lui veut du mal ?"
msgstr "Was führt er im Schilde?! Will er ihr was antun?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "canal_01b290ee"
msgid "Aucune idée... Parce qu'il s'en voulait vraiment ? Pour te faire chier ? Parce qu'il a de plus sombres desseins en tête pour elle ?"
msgstr "Keine Ahnung ... Vielleicht bereut er es wirklich, oder er will dich nur provozieren, oder er hat andere Pläne für sie?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "canal_85c94ff0"
msgid "Qui peut savoir ?"
msgstr "Wer weiß?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_004b3cc8"
msgid "Je comprends pas pourquoi tu restes avec un type comme ça tout en sachant qu'il est foncièrement mauvais."
msgstr "Ich verstehe nicht, warum du dich mit einem Typen wie ihm abgibst, obwohl du weißt, wie hinterlistig er ist."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "canal_bde660f2"
msgid "Le cœur a ses raisons que la raison ignore..."
msgstr "Manchmal entscheidet das Herz ungeachtet des Verstandes."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_fef83b59"
msgid "Tout va bien ?"
msgstr "Ist alles in Ordnung?"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_b6d68dcb"
msgid "Oui ne t'en fais pas, je suis simplement venue te dire que ça allait prendre plus de temps que prévu."
msgstr "Ja, keine Sorge. Ich bin nur gekommen, um dir Bescheid zu sagen, dass es etwas länger dauern wird."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_5bb43214"
msgid "{{minato.n}} va me raccompagner chez moi directement."
msgstr "{{minato.n}} wird mich nach Hause bringen."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_46ac28a6"
msgid "Je dois lui laisser le bénéfice du doute, apres tout cela fait si longtemps que je le connais."
msgstr "Ich muss ihm im Zweifelsfall erstmal vertrauen. Schließlich kennen wir uns schon so lange."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_03775ec8_1"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_7f5fe859"
msgid "Sois prudente alors..."
msgstr "Dann sei vorsichtig ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_92a579f7"
msgid "C'est promis ! Je te tiendrai au courant !"
msgstr "Versprochen! Ich halte dich auf dem Laufenden!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_4f198bf2"
msgid "Et me voilà de nouveau seul à présent..."
msgstr "Und schon bin ich wieder alleine."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_e66ec51a"
msgid "Je suppose que je n'ai plus qu'à rentrer à la maison"
msgstr "Ich schätze, ich sollte dann auch heim gehen."

#. Character:`unknown`
#: game/story/canal.dialogue
msgctxt "canal_ed8ae233"
msgid "Hey toi !"
msgstr "Hey, du!"

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "te67d545f90"
msgid "Ah tiens, ça faisait longtemps !"
msgstr "Oh, es ist ein Weilchen her, dass ..."

#. Character:`saito` | Attributes:`guilty`
#: game/story/canal.dialogue
msgctxt "t025c464d5c"
msgid "...[w]Maintenant que j'y pense...Je ne suis pas sur de connaitre ton nom."
msgstr "...[w] Jetzt, wo ich so darüber nachdenke ... Ich bin mir nicht sicher, ob ich deinen Namen kenne."

#. Character:`kimochi`
#: game/story/canal.dialogue
msgctxt "tf8e3781546"
msgid "Tu peux m'appeler {{kimochi.n}}."
msgstr "Du kannst mich {{kimochi.n}} nennen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "ta01b77093f"
msgid "..."
msgstr "..."

#. Character:`kimochi` | Attributes:`doubt`
#: game/story/canal.dialogue
msgctxt "t7d3d32883c"
msgid "Tu devrais pas la laisser partir avec lui."
msgstr "Du solltest sie nicht mit ihm gehen lassen."

#. Character:`kimochi`
#: game/story/canal.dialogue
msgctxt "t4c5b062d8a"
msgid "Ce type n'est pas du tout ce qu'il prétend être."
msgstr "Dieser Typ ist nicht, wer er vorgibt zu sein."

#. Character:`saito` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "tade0a417ce"
msgid "Pourquoi ? Tu sais des choses que j'ignore ?"
msgstr "Warum? Weißt du etwas, das ich nicht weiß?"

#. Character:`kimochi`
#: game/story/canal.dialogue
msgctxt "t5bfe526eb4"
msgid "J'en ai déjà trop dit ! Mais tu peux me faire confiance la dessus !"
msgstr "Ich habe bereits zu viel gesagt! Aber bei der Sache kannst du mir vertrauen!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/canal.dialogue
msgctxt "tdc640f7fc2"
msgid "Je ne suis pas sur de pouvoir confiance à quelqu'un capable d'empoisonner ses repas avec du laxatif."
msgstr "Ich bin mir nicht sicher, ob ich jemandem vertrauen möchte, der gewillt ist, Essen mit Abführmitteln zu vergiften."

#. Character:`kimochi` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "t3a22101cd7"
msgid "A situation désespéré, mesure désespéré."
msgstr "Verzweifelte Zeiten erfordern verzweifelte Maßnahmen."

#. Character:`kimochi`
#: game/story/canal.dialogue
msgctxt "tad98d1c4be"
msgid "Passe chez moi à l'occasion, on pourra discuter à l'abri des regards indiscrets."
msgstr "Schau beizeiten mal bei mir vorbei. Da könnnen wir unter vier Augen ungestört reden."

#. Character:`saito` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "t5a5d019727"
msgid "J'y penserais..."
msgstr "Ich behalt’s im Hinterkopf ..."

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "t1c0082db29"
msgid "Je me demande comment ça se passe avec {{asami.n}}."
msgstr "Ich frage mich, wie die Dinge mit {{asami.n}} laufen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_6f6d4133"
msgid "Bon... C'est bien beau mais je fais quoi maintenant ?"
msgstr "Okay ... Das lief alles ganz gut, aber was mache ich jetzt?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "canal_a3493100"
msgid "Je savais bien que je te trouverais ici..."
msgstr "Ich wusste, dass ich dich hier finden würde ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_25469291"
msgid "Ah tu es venue pour te moquer de moi ?"
msgstr "Ah, bist du gekommen, um mich auszulachen?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "canal_beaec1b6"
msgid "Tss... Tu as vraiment une si mauvaise opinion de moi ?"
msgstr "Tss ... Hältst du mich wirklich für so gemein?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_d186b2b7"
msgid "Je ne sais pas... Le fait que tu agisses comme une sorte d'électron libre, un coup en compagnie de {{minato.n}}, l'autre avec nous, ne m'aide pas vraiment à avoir confiance en toi."
msgstr "Ich weiß nicht ... Die Tatsache, dass du dich irgendwie ständig mit mir und mit {{minato.n}} abgibst, fördert nicht gerade mein Vertrauen zu dir."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_9e6d7e5a"
msgid "Du coup... de quel côté es-tu ?"
msgstr "Also ... Auf wessen Seite stehst du?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "canal_2c87a577"
msgid "Du mien évidement !"
msgstr "Auf meiner natürlich!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_ca679b1b"
msgid "Ah ! Ça te ressemble bien."
msgstr "Ah, sowas hatte ich von dir erwartet."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_03775ec8_3"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_967cfb29"
msgid "Tu veux t'asseoir avec moi et profiter d'un moment de paix ?"
msgstr "Möchtest du dich zu mir setzen und einen Moment der Ruhe genießen?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "canal_6c29ae45"
msgid "Merci pour la proposition mais quelque chose me dit que tu ne resteras pas seul bien longtemps."
msgstr "Danke für das Angebot, aber etwas sagt mir, dass du hier nicht mehr lange alleine sein wirst."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_03775ec8_4"
msgid "..."
msgstr "..."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "canal_1e1c12ea"
msgid "À plus !"
msgstr "Man sieht sich!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_90e92c8b"
msgid "Alors je t'ai manqué ?"
msgstr "Hast du mich vermisst?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_7b0cd337"
msgid "Ça se pourrait."
msgstr "Vielleicht."

#. Character:`asami` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_9f067411"
msgid "Je le savais !"
msgstr "Wusste ich’s doch!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_263db47b"
msgid "Sans moi t'es déjà perdu."
msgstr "Du bist ohne mich verloren."

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_6fe46e0f"
msgid "Alors ?"
msgstr "Also?"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_53ed32c2"
msgid "Comme je te l'ai déjà dit... J'ai eu bien plus de fun avec toi en 3 jours..."
msgstr "Wie gesagt ... Ich hatte mit dir in diesen drei Tagen mehr Spaß, als ..."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_bc99d913"
msgid "... qu'en 10 ans de soi-disante amitié avec cet idiot."
msgstr "In zehn Jahren der sogenannten Freundschaft mit diesem Idiot."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_2b27740b"
msgid "Je vois..."
msgstr "Ich verstehe ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_e04cd316"
msgid "Qu'est-ce qu'on fait à présent ?"
msgstr "Also, was machen wir jetzt?"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_444613f2"
msgid "Je te botterais bien le cul sur n'importe quel jeu."
msgstr "Ich würde dir gerne in irgendeinem Videospiel den Arsch versohlen."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_1e167024"
msgid "J'ai besoin de me défouler."
msgstr "Ich muss etwas Dampf ablassen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_a66a8928"
msgid "Pff, comme si tu avais la moindre chance."
msgstr "Pfff, als hättest du irgendeine Chance, zu gewinnen."

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "JE_SUPPOSE_QUE_LE_FAIT_QUE_TU_C23E24"
msgid "... Je suppose que le fait que tu viennes ici plutôt que de rentrer directement à la maison signifie que quelque chose ne va pas ?"
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/canal.dialogue
msgctxt "OH_TU_M_AS_RETROUV_E_D7E799"
msgid "Oh tu m'as retrouvée ?"
msgstr ""

#. Character:`yasuka` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "OUI_TU_AS_RAISON_J_AI_ACCUMUL_670CB3"
msgid "Oui tu as raison... J'ai accumulé beaucoup de mauvaises décisions dans ma vie et je paie le prix de ma naïveté."
msgstr ""

#. Character:`yasuka`
#: game/story/canal.dialogue
msgctxt "EMPRUNTER_POUR_ACHETER_UNE_MAI_CEB454"
msgid "Emprunter pour acheter une maison bien au-dessus de mes moyens..."
msgstr ""

#. Character:`yasuka`
#: game/story/canal.dialogue
msgctxt "NE_PAS_M_TRE_RENSEIGN_E_SUR_LE_AB83F0"
msgid "Ne pas m'être renseignée sur les taux d'intérêt."
msgstr ""

#. Character:`yasuka`
#: game/story/canal.dialogue
msgctxt "ET_MON_PATRON_A_CALCUL_TOUT_CE_F0588B"
msgid "Et mon patron a calculé tout ce que je devais rembourser, même en vendant la maison ça ne suffirait pas."
msgstr ""

#. Character:`yasuka`
#: game/story/canal.dialogue
msgctxt "IL_FAUDRAIT_TROUVER_UN_APPARTE_47E755"
msgid "Il faudrait trouver un appartement plus petit, je devrais continuer à travailler, payer à la fois le loyer plus le remboursement de l'autre, c'est sans fin."
msgstr ""

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/canal.dialogue
msgctxt "JE_N_AURAIS_M_ME_PAS_DE_QUOI_P_EE1002"
msgid "Je n'aurais même pas de quoi payer les études de ma propre fille... J'aurais tellement voulu lui donner cette chance que moi je n'avais pas eue.."
msgstr ""

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "JE_N_AVAIS_PAS_CONSCIENCE_QUEL_C125E4"
msgid "Je n'avais pas conscience à quel point c'était aussi grave."
msgstr ""

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "J_AI_D_TE_PARA_TRE_RIDICULE_AV_9EDE15"
msgid "J'ai dû te paraître ridicule avec ma bonne volonté et mon petit job..."
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/canal.dialogue
msgctxt "NON_TU_AS_T_ADORABLE_540476"
msgid "Non... Tu as été adorable."
msgstr ""

#. Character:`yasuka`
#: game/story/canal.dialogue
msgctxt "POUR_LA_PREMI_RE_FOIS_DEPUIS_L_6E5814"
msgid "Pour la première fois depuis longtemps je n'avais plus la sensation d'être seule."
msgstr ""

#. Character:`yasuka` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "MAIS_IL_FAUT_QUE_JE_ME_RENDE_L_5349A9"
msgid "Mais il faut que je me rende à l'évidence... en l'état actuel la dette n'est pas remboursable et à cause des intérêts cachés elle ne le sera jamais."
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/canal.dialogue
msgctxt "W_DONC_ON_FAIT_QUOI_MAINTENAN_6BAE28"
msgid "...[w] Donc on fait quoi maintenant ?"
msgstr ""

#. Character:`yasuka`
#: game/story/canal.dialogue
msgctxt "JE_NE_SAIS_PAS_SI_TU_CONNAISSA_ECBC03"
msgid "Je ne sais pas... Si tu connaissais un moyen de revenir en arrière ça m'intéresserait beaucoup."
msgstr ""

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "QU_EST_CE_QUE_TU_FERAIS_SI_TU_8E6751"
msgid "Qu'est-ce que tu ferais si tu le pouvais ?"
msgstr ""

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/canal.dialogue
msgctxt "TU_ME_PARDONNERAIS_CETTE_FOIS_657550"
msgid "Tu me pardonnerais cette fois-ci si j'étais un peu plus égoïste ?"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "JE_PENSE_QUE_TU_L_AS_M_RIT_14BA38"
msgid "Je pense que tu l'as mérité..."
msgstr ""

#. Character:`yasuka`
#: game/story/canal.dialogue
msgctxt "MAIS_IL_Y_A_UNE_CHOSE_QUE_JE_R_8CF841"
msgid "Mais... Il y a une chose que je referais à coup sûr."
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/canal.dialogue
msgctxt "CE_CHOIX_DE_T_AVOIR_FAIT_RENTR_D9E59D"
msgid "Ce choix de t'avoir fait rentrer dans notre petite famille."
msgstr ""

#. Character:`saito` | Attributes:`surprised`
#: game/story/canal.dialogue
msgctxt "JE_JE_NE_SAIS_PAS_QUOI_DIRE_C_B8EA8A"
msgid "Je.. Je ne sais pas quoi dire c'est..."
msgstr ""

#. Character:`yasuka` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "HEHE_JE_TE_VOIS_ROUGIR_D9C9D9"
msgid "Héhé, je te vois rougir !"
msgstr ""

#. Character:`yasuka`
#: game/story/canal.dialogue
msgctxt "ET_TOI_TU_FERAIS_QUOI_SI_TU_PO_1BE378"
msgid "Et toi ? Tu ferais quoi si tu pouvais revenir en arrière ?"
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/canal.dialogue
msgctxt "SI_JE_POUVAIS_MHHH_1314E4"
msgid "Si je pouvais... mhhh"
msgstr ""

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/canal.dialogue
msgctxt "ALLEZ_SOIS_HONN_TE_JE_ME_SUIS_750996"
msgid "Allez sois honnête, je me suis bien confiée à toi !"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "RIEN_JE_CROIS_QUE_JE_SUIS_L_O_9CC9BD"
msgid "Rien, je crois que je suis là où je dois être."
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/canal.dialogue
msgctxt "OOOH_MON_CH_RI_TU_VAS_ME_FAIRE_3BCC57"
msgid "Oooh mon chéri, tu vas me faire pleurer !"
msgstr ""

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "ALLEZ_RENTRONS_JE_CROIS_QU_ON_13BC84"
msgid "Allez rentrons ! Je crois qu'on a tous les deux besoin de repos."
msgstr ""

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "ON_R_FL_CHIRA_NOS_PROBL_MES_DE_16C8AF"
msgid "On réfléchira à nos problèmes demain."
msgstr ""

#. Character:`yasuka`
#: game/story/canal.dialogue
msgctxt "TU_AS_RAISON_CE_N_EST_PAS_COMM_026E8D"
msgid "Tu as raison, ce n'est pas comme si quelqu'un allait les faire disparaître..."
msgstr ""

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_8d1c4707"
msgid "Merde ! Merde ! Putain de merde !"
msgstr "Scheiße! Scheiße! Heilige Scheiße!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_12ecc732"
msgid "POURQUOI ?!"
msgstr "WARUM?!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_7d61954a"
msgid "Arrête de penser à ça, putain !"
msgstr "Fuck! Hör auf, darüber nachzudenken!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_d60b5538"
msgid "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAH !!!"
msgstr "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAH!!!"

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_5f6b112b"
msgid "... C'est bon ? T'es calmé ?!"
msgstr "... Alles klar, hast du dich beruhigt?"

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "canal_51d43d51"
msgid "Putain, pourquoi {{macumba.n}} n'est pas là ?!"
msgstr "Warum zum Teufel ist {{macumba.n}} nicht hier?"

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "canal_04d6c87d"
msgid "Je vais me faire détruire !"
msgstr "Ich werde auseinandergenommen werden!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_ce576e6f"
msgid "T'approche pas {{saito.n}} !"
msgstr "Bleib fern von mir, {{saito.n}}!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_5a043212"
msgid "TU FAIS UN SEUL PUTAIN DE PAS VERS MOI, ET J'TE JURE QUE..."
msgstr "WENN DU AUCH NUR EINEN WEITEREN SCHRITT IN MEINE RICHTUNG MACHST, DANN SCHWÖRE ICH, DASS ICH ..."

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_41ed73ca"
msgid "C'est bon... Je ne m'approcherai pas. Je suis juste là pour récupérer le journal de {{sakuya.n}} !"
msgstr "Alles klar ... Ich werde nicht näherkommen. Ich bin nur hier, um {{sakuya.n}}s Tagebuch zu holen!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_2962fb12"
msgid "Cette pute peut bien aller se faire foutre !"
msgstr "Diese Hure kann mich mal!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_6232c1f2"
msgid "ET MA VIE T'EN FAIS QUOI PUTAIN ?!"
msgstr "UND WAS ZUR HÖLLE KÜMMERT DICH MEIN LEBEN?!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_dc26ac58"
msgid "Le truc qu'elle m'a fait prendre... C'est irréversible, putain de merde !"
msgstr "Dieses Zeug, das sie mir verabreicht hat ... Es ist irreversibel, verdammt!"

#. Character:`saito` | Attributes:`angry`
#: game/story/canal.dialogue
msgctxt "canal_feb764b3"
msgid "... Arrête de te foutre de la gueule du monde !"
msgstr "... Hör einfach auf, das Opfer zu spielen!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_3bfe8b19"
msgid "Pourquoi tu te baladais avec ça de toute manière ?[w] Tu as le droit de détruire la vie des autres, mais la tienne est sacrée ?"
msgstr "Warum bist du damit überhaupt rumgelaufen?[w] Du nimmst dir das Recht, das Leben anderer Menschen zu zerstören, aber deines ist so heilig?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_40df85f2"
msgid "BORDEL ! MAIS C'EST QUOI CE RAISONNEMENT À LA CON ?!!"
msgstr "FUCK! WAS FÜR EIN BESCHEUERTES ARGUMENT SOLL DAS SEIN?!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_2d9c740f"
msgid "VA TE FAIRE FOUTRE !"
msgstr "FICK DICH!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_9760c707"
msgid "J'ai pas à justifier mes choix de vie, surtout auprès d'un gars... comme toi."
msgstr "Ich muss meine Lebensentscheidungen nicht rechtfertigen, schon gar nicht vor einem Typen ... wie dir."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_a526f197"
msgid "Super, monsieur le génie... et maintenant quoi ? Tu t'es fait flinguer le cerveau par une drogue que t'avais toi-même prévu de donner à quelqu'un pour me faire du mal."
msgstr "Großartig, Einstein ... Und was nun? Dein Hirn wurde von einer Droge durcheinandergebracht, die du jemand anderem geben wolltest, um mich zu verletzen."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_cc1e4a6e"
msgid "T'APPROCHE PAS J'AI DIT !"
msgstr "BLEIB WEG, HABE ICH GESAGT!"

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_17ae0e51"
msgid "Si t'es dans la merde à ce point là, retourne voir le gars qui t'a vendu ça."
msgstr "Wenn du in so großen Schwierigkeiten steckst, geh einfach zu dem Typen, der dir das verkauft hat."

#. Character:`akira` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_bd3bc77d"
msgid "...[w] Hahaha...[w] C'est juste impossible."
msgstr "...[w] Hahaha ...[w] Das kann ich nicht."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_0373d090"
msgid "Le gars qui m'a donné ça se foutra juste de ma gueule, ou au pire, il se servira de moi comme cobaye..."
msgstr "Der Typ, der es mir verkauft hat, wird sich einfach nur über mich lustig machen, oder – noch besser – mich als Versuchskaninchen missbrauchen..."

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_38122da1"
msgid "Comme quoi... Il y a une justice dans ce monde."
msgstr "Nun, wer hätte es gedacht ... Vielleicht gibt es doch ein wenig Gerechtigkeit auf dieser Welt."

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_a4cd90f9"
msgid "Ne compte pas sur moi pour avoir pitié de toi après ce que tu as voulu faire à {{asami.n}}..."
msgstr "Glaub ja nicht, dass ich Mitleid mit dir habe, nach dem, was du {{asami.n}} antun wolltest ..."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_60686f8b"
msgid "Je... Je n'attends pas de pitié de toi."
msgstr "Ich ... ich erwarte kein Mitleid von dir."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_8a5f61c1"
msgid "Je... Je veux juste..."
msgstr "Ich ... Ich will nur ..."

#. Character:`akira` | Attributes:`angry`
#: game/story/canal.dialogue
msgctxt "canal_3fdb3aee"
msgid "PUTAIN DE CERVEAU DE MERDE !"
msgstr "VERDAMMTES SCHEIẞHIRN!"

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_c45b5c6d"
msgid "... Euh, je ne suis pas sûr de comprendre."
msgstr "... Ähm, ich bin mir nicht sicher, ob ich das verstehe."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_42e7d9cc"
msgid "Laisse-moi seul, putain !"
msgstr "Lass mich in Ruhe, verdammt!"

#. Character:`saito` | Attributes:`angry`
#: game/story/canal.dialogue
msgctxt "canal_e056a468"
msgid "Non ! J'ai besoin de récupérer ce journal !"
msgstr "Nein! Ich brauche dieses Tagebuch!"

#. Character:`akira` | Attributes:`arrogant`
#: game/story/canal.dialogue
msgctxt "canal_37263872"
msgid "Pfff... T'es pitoyable une fois de plus, tu t'es fait séquestrer plusieurs jours, et te voilà maintenant à essayer de l'aider !"
msgstr "Pfff ... Du bist bemitleidenswert. Du wurdest für mehrere Tage entführt und jetzt versuchst du, ihr zu helfen!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_41360ebc"
msgid "Tu as la mémoire courte."
msgstr "Ich glaube, du wirst dement."

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_c60afd89"
msgid "Je sais... Mes actions n'ont pas vraiment de sens parfois. J'essaie seulement de faire de mon mieux."
msgstr "Ich weiß ... Meine Handlungen ergeben manchmal keinen Sinn. Ich versuche einfach mein Bestes zu geben."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_53f9fcb2"
msgid "Mais, crois en quelqu'un qui sait toujours se foutre dans la merde, si tu ne redonnes pas ça à sa propriétaire..."
msgstr "Aber glaub mir als jemand, der eine Menge Ahnung davon hat, wie man in Schwierigkeiten gerät. Wenn du ihr das Tagebuch nicht zurückgibst ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_245bebe9"
msgid "Elle te le fera payer au centuple !"
msgstr "Wird sie dich das hundertfach spüren lassen."

#. Character:`akira` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_b91fa2d6"
msgid "...[w] Putain, elle fait chier celle-là !"
msgstr "...[w] Verdammt, die ist so ein nervtötendes Miststück!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_03775ec8"
msgid "..."
msgstr "..."

#. Character:`akira` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_12893ca9"
msgid "{{saito.n}} ?"
msgstr "{{saito.n}}?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_64ae250a"
msgid "Quoi ?"
msgstr "Was?"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_89064ba2"
msgid "Je ne suis pas gay, mais...[w] depuis qu'elle m'a fait prendre ce truc, j'ai comme une irrésistible envie de te sucer !"
msgstr "Ich bin nicht schwul, aber ...[w] seit sie mich gezwungen hat, dieses Zeug zu nehmen, habe ich ein unwiderstehliches Verlangen, dir einen zu blasen!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/canal.dialogue
msgctxt "canal_6009f661"
msgid "Wow, wow, wow ! Doucement ! Je ne suis pas de ce bord-là."
msgstr "Wow wow wow! Immer mit der Ruhe! Ich finde das jetzt nicht so geil."

#. Character:`akira` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_5b5af2cd"
msgid "Moi non plus ! Mais ce truc... Me donne envie de baiser avec toi, ça me fait flipper."
msgstr "Ich auch nicht! Aber dieses Zeug ... bringt mich dazu, dich ficken zu wollen, es macht mich wahnsinnig."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_e5d90662"
msgid "Je sais que je te hais... Je te déteste depuis toujours ! Je sais que je suis hétéro, mais... J'ai maintenant ton visage dans ma tête et une envie de te su-"
msgstr "Ich weiß, dass ich dich hasse ... Ich habe dich immer gehasst! Ich weiß, dass ich hetero bin, aber ... ich habe jetzt dein Gesicht in meinem Kopf und den Wunsch dir einen zu bla-"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_047769f3"
msgid "STOP ! Okay c'est bon, j'ai compris, mais... ça n'arrivera pas !"
msgstr "STOPP! Okay, ich hab’s verstanden, aber ... das wird nicht passieren!"

#. Character:`akira` | Attributes:`angry`
#: game/story/canal.dialogue
msgctxt "canal_af9ecd2a"
msgid "Je ne suis pas gay !"
msgstr "Ich bin nicht schwul!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_0a38c0a8"
msgid "Et puis, allez tous vous faire foutre, voilà ce que j'en fais de ton journal de merde !"
msgstr "Und fickt euch alle! Ich zeig euch, was ich mit diesem beschissenen Tagebuch mache!"

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_043fbb7d"
msgid "Je te conseille pour ton propre bien de ne plus t'approcher de moi, je me retiens de toutes mes forces de ne pas te sauter dessus et ce n'est pas pour te frapper..."
msgstr "Ich rate dir zu deinem eigenen Wohl, mir nicht mehr näher zu kommen. Ich versuche mit aller Kraft, dich nicht anzuspringen und das nicht, um dich zu schlagen ..."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_57c76240"
msgid "Je trouverai un moyen... de me débarrasser de ça..."
msgstr "Ich werde einen Weg finden ... das loszuwerden ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_c6dc1151"
msgid "... Oh bon sang, de nouveaux problèmes à l'horizon, une fois de plus."
msgstr "... Oh Mann, wieder einmal kommen neue Probleme auf mich zu."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_b8d1180a"
msgid "Bref, récupérons ce journal, qu'on en finisse."
msgstr "Wie auch immer, holen wir uns dieses Tagebuch und bringen wir es hinter uns."

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_d6e75e0f"
msgid "Et voilà... Je n'ai plus qu'à lui rapporter ça !"
msgstr "So, das wär’s ... Jetzt muss ich es ihr nur noch zurückbringen!"

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_8cf9de32"
msgid "Je suis désolée..."
msgstr "Es tut mir leid ..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/canal.dialogue
msgctxt "canal_28ea2b4b"
msgid "Hein ?! Comment ça ?"
msgstr "Hä?! Wieso?"

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_1e8bab0c"
msgid "Je suis désolée pour tout ce que je t'ai fait endurer depuis plusieurs jours..."
msgstr "Es tut mir leid für all das, was du in den letzten Tagen durchmachen musstest ..."

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_f917788e"
msgid "Une minute... Attends, attends, j'ai loupé quelque chose."
msgstr "Eine Sekunde ... Warte, ich glaube, ich habe da etwas verpasst."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_4867194a"
msgid "J'ai discuté avec {{asami.n}}... Et, il s'avère qu'elle n'était pas si nulle que ça."
msgstr "Ich habe mit {{asami.n}} gesprochen. Es hat sich herausgestellt, dass sie gar nicht so schlimm ist."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_5a0157e6"
msgid "En fait, je crois bien que je me suis fait ma première amie !"
msgstr "Ich glaube, ich habe sogar meine erste Freundin gefunden!"

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_8950ed00"
msgid "Nous aimons la même personne alors, je pense que nous étions faites pour nous entendre."
msgstr "Wir lieben dieselbe Person, also denke ich, dass wir dazu bestimmt waren, miteinander auszukommen."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "t9ce2e7407e"
msgid "Elle a même accepté d'être ta maîtresse... Tandis que moi, je serai ta femme officielle !"
msgstr "Sie hat sich sogar einverstanden gezeigt, deine Geliebte zu sein ... Während ich offiziell deine Ehefrau sein werde!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/canal.dialogue
msgctxt "t60ba0d0c8c"
msgid "Quoi ?!"
msgstr "Was?!"

#. Character:`sakuya` | Attributes:`blush,happy`
#: game/story/canal.dialogue
msgctxt "t5d6ae468cd"
msgid "Haha, je plaisante !"
msgstr "Haha, ich mach’ nur Spaß!"

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_833d6d0d"
msgid "Elle t'apprécie au moins autant que moi je peux t'aimer, je pense que nous étions faites pour nous entendre."
msgstr "Sie mag dich genauso sehr wie ich dich liebe. Ich schätze, es war vorherbestimmt, dass wir miteinander auskommen würden."

#. Character:`saito` | Attributes:`guilty`
#: game/story/canal.dialogue
msgctxt "t8f4002adf6"
msgid "Vu comme ça..."
msgstr "Wenn du es so sagst ..."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_876abe1f"
msgid "Tu sais...[w] Je te reprochais de ne pas être honnête avec les femmes, mais... ce n'était qu'à moitié vrai."
msgstr "Weißt du...[w] Ich habe dir vorgeworfen, dass du nicht ehrlich zu Frauen bist, aber ... das war nur die halbe Wahrheit."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_47f408e2"
msgid "J'étais et je suis toujours terriblement jalouse de la relation que tu avais avec elles."
msgstr "Ich war und bin immer noch furchtbar eifersüchtig auf die Beziehungen, die du zu ihnen hattest."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_c2a50ae6"
msgid "Je voulais moi aussi avoir ce lien unique que tu partageais avec {{asami.n}} ou {{yasuka.n}}."
msgstr "Ich wollte auch diese einzigartige Bindung haben, die du mit {{asami.n}} oder {{yasuka.n}} geteilt hast."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_b69061c9"
msgid "Je suppose que je ne devrais peut-être pas forcer les choses..."
msgstr "Ich denke, ich sollte die Dinge vielleicht nicht erzwingen ..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_9b4be467"
msgid "Je pourrais te haïr pour certaines choses que tu m'as faites."
msgstr "Ich könnte dich für die Sachen, die du mir angetan hast, hassen."

#. Character:`sakuya` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_c0fca4b0"
msgid "... Je suis désolée."
msgstr "... Es tut mir leid."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_49398a09"
msgid "Mais, te voir gérer {{akira.n}} comme tu l'as fait..."
msgstr "Aber zu sehen, wie du {{akira.n}} so gehandhabt hast, wie eben ..."

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_237e2eb0"
msgid "Ça valait tout l'or du monde !"
msgstr "Das war alles Geld der Welt wert!"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_86cf362e"
msgid "**[i]Rires[/i]**"
msgstr "**[i]Lacht[/i]**"

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_6587b7be"
msgid "Par contre, tu vas devoir faire attention à toi, tu peux être certaine qu'il cherchera à se venger."
msgstr "Andererseits musst du auf dich aufpassen. Er wird sicher nach Vergeltung suchen."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_57336afb"
msgid "J'adore quand tu t'inquiètes pour moi, mais tu sais, je suis grande fille qui sait se défendre."
msgstr "Ich liebe es, wenn du dir Sorgen um mich machst, aber weißt du, ich bin ein großes Mädchen, das weiß, wie man sich verteidigt."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_72c52b2a"
msgid "Oui ça j'ai pu le constater moi-même... En attendant voici !"
msgstr "Ja, das habe ich selbst gesehen ... Übrigens, bitte schön!"

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/canal.dialogue
msgctxt "canal_bea39a62"
msgid "Mon journal ! Tu as pu le récupérer ! Je suis si heureuse, merci, merci, merci."
msgstr "Mein Tagebuch! Du konntest es zurückbekommen! Ich bin so glücklich, danke, danke, danke."

#. Character:`saito` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_e154b72d"
msgid "Je suppose qu'il avait tout un tas de secrets qu'il aurait voulu exploiter pour te faire chanter."
msgstr "Ich schätze,es enthielt eine ganze Reihe von Geheimnissen, die er ausnutzen wollte, um dich zu erpressen."

#. Character:`sakuya` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_d9bd5378"
msgid "Non, non, aucune chance, ce n'est pas son contenu qui est important, mais qui me l'a donné..."
msgstr "Nein, nicht im Geringsten. Nicht der Inhalt ist wichtig, sondern wer es mir geschenkt hat ..."

#. Character:`sakuya` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_d17fc0ef"
msgid "Je le tiens de ma mère... Avant qu'elle ne parte pour... Un long voyage."
msgstr "Ich habe es von meiner Mutter bekommen ... Bevor sie zu ... einer langen Reise aufbrach."

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_e08c9d70"
msgid "Oh je... Je suis sincèrement désolé."
msgstr "Oh, das ... das tut mir leid."

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/canal.dialogue
msgctxt "canal_4360a59c"
msgid "Elle n'est pas morte, ne t'inquiète pas, elle est juste en prison !"
msgstr "Sie ist nicht tot, keine Sorge. Sie ist nur im Gefängnis!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/canal.dialogue
msgctxt "canal_6d04f7e8_1"
msgid "Quoi ?!"
msgstr "Was?!"

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_79221134"
msgid "Ma mère est une femme 100 fois plus possessive que moi, d'ailleurs, c'est d'elle que je tiens cette idée de te kidnapper et de te faire tomber amoureux de moi."
msgstr "Meine Mutter ist hundermal besitzergreifender als ich. Ich habe die Idee, dich zu entführen, damit du dich in mich verliebst, von ihr."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_651ba628"
msgid "Elle a fait ça pour mon père à l'époque et ça a bien fonctionné !"
msgstr "Sie hat dasselbe damals mit meinem Vater gemacht und wie du siehst, hat es super geklappt!"

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "canal_edbeb65c"
msgid "Oh bordel... Je plains le {{chef.n}} à présent."
msgstr "Oh verdammt ... jetzt tut mir der {{chef.n}} leid."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "canal_b3193f01"
msgid "Si la mère est encore plus folle que la fille."
msgstr "Wenn die Mutter noch verrückter ist als die Tochter."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "canal_911cce75"
msgid "J'ose même pas imaginer ce qu'il a dû traverser."
msgstr "Ich kann mir gar nicht vorstellen, was er durchgemacht haben muss."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_1c29e825"
msgid "Tu pourras faire sa rencontre bientôt, elle sortira d'ici quelques mois."
msgstr "Du wirst sie bald kennenlernen können. In ein paar Monaten wird sie wieder freigelassen."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_8a5c8a7a"
msgid "J'ai hâte de te la présenter !"
msgstr "Ich kann es kaum erwarten, sie dir vorzustellen!"

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_e85728a7"
msgid "... et moi de la connaître."
msgstr "... und ich kann es auch nicht erwarten, sie kennenzulernen."

#. Character:`sakuya` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_d414cff4"
msgid "... dis {{saito.n}}."
msgstr ".. .Sag mir, {{saito.n}}."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_531b4ae5"
msgid "Je t'ai observé longtemps... Mais, depuis quelques semaines, j'ai l'impression de te découvrir à nouveau."
msgstr "Ich habe dich lange beobachtet ... Aber seit einigen Wochen habe ich das Gefühl, dich nochmal neu zu entdecken."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_b2613b7a"
msgid "Je ne dis pas que je n'aime pas le nouveau toi, mais... c'était si étrange."
msgstr "Ich sage nicht, dass ich dein neues Du nicht mag, aber ... es war so seltsam."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_b664dde4"
msgid "La veille, tu semblais si pitoyable que j'avais envie de te prendre dans mes bras..."
msgstr "Am Tag zuvor schienst du so bemitleidenswert zu sein, dass ich dich am liebsten in den Arm nehmen wollte ..."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_70f7edb7"
msgid "Et, le lendemain matin... tu semblais une toute nouvelle personne."
msgstr "Aber am nächsten Morgen ... schienst du ein ganz neuer Mensch zu sein."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_8b3977b0"
msgid "Donc j'aimerais savoir, es-tu vraiment {{saito.n}} ?"
msgstr "Also, ich würde gerne wissen, bist du wirklich {{saito.n}}?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_19b49a04"
msgid "Que tu me croies ou non importe peu, mais pour te dire la vérité."
msgstr "Es spielt keine Rolle, ob du mir glaubst oder nicht, aber ich sage dir die Wahrheit."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_04f63d7a"
msgid "Je suis déjà mort une fois."
msgstr "Ich bin schon einmal gestorben."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_e0487bbb"
msgid "Je ne suis pas sûre de comprendre..."
msgstr "Ich bin mir nicht sicher, ob ich das verstehe ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_f5517636"
msgid "J'ai vécu toute une vie... Et, le jour où je suis mort, je me suis réveillé dans mon ancien corps."
msgstr "Ich habe ein Leben lang gelebt ... Und an dem Tag, an dem ich starb, wachte ich in meinem alten Körper auf."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_67994c70"
msgid "Ma vie avait été tellement misérable que je devais tout faire pour changer."
msgstr "Mein Leben war so beschissen gewesen, dass ich alles tun musste, um es zu ändern."

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/canal.dialogue
msgctxt "canal_43769aef"
msgid "De quoi es-tu mort ?"
msgstr "Wie bist du gestorben?"

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_7d70b7c4"
msgid "J'ai passé ma vie à me faire exploiter par tous, ma santé s'est dégradée, je n'avais aucune relation que ce soit amicale ou amoureuse."
msgstr "Ich verbrachte mein Leben damit, von allen ausgebeutet zu werden, meine Gesundheit verschlechterte sich, ich hatte keine Beziehungen, weder freundschaftlicher noch romatischer Art."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_e004fe6b"
msgid "Je me suis laissé mourir sans vraiment me battre..."
msgstr "Ich habe mich sterben lassen, ohne wirklich zu kämpfen ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_83aa4686"
msgid "Ce n'est qu'à la toute fin, au moment de mourir, que j'ai eu peur et que j'ai souhaité pouvoir tout recommencer."
msgstr "Erst ganz zum Schluss, als ich starb, hatte ich Angst und wünschte, ich könnte nochmal von vorne anfangen."

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/canal.dialogue
msgctxt "canal_ec76888d"
msgid "Je ne comprends pas pourquoi tu es mort seul... je n'étais pas à tes côtés ?"
msgstr "Ich verstehe nicht, warum du allein gestorben bist ... War ich nicht an deiner Seite?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_d68db309"
msgid "Je... je ne sais pas, j'ai appris que tu avais travaillé dans l'industrie des films pour adultes."
msgstr "Ich ... Ich weiß es nicht, ich habe gehört, dass du in der Erotikfilmindustrie gelandet bist."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_612230ed"
msgid "Et, tu avais fini par te suicider quelques années plus tard..."
msgstr "Und dass du dich ein paar Jahre später umgebracht hast ..."

#. Character:`sakuya` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_207cda26"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_250cf179"
msgid "Plutôt fou comme histoire, non ? Je dois te paraître cinglé maintenant."
msgstr "Ziemlich verrückte Geschichte, oder? Ich muss für dich jetzt ziemlich durchgedreht klingen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_5b316d47"
msgid "Je n'en n'ai jamais parlé à personne, tu es la seule à être au courant de ça."
msgstr "Ich habe es keinem erzählt. Du bist die einzige Person, die davon weiß."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_74e989da"
msgid "Je te crois."
msgstr "Ich glaube dir."

#. Character:`saito` | Attributes:`surprised`
#: game/story/canal.dialogue
msgctxt "canal_4326f185"
msgid "Attends, quoi ?"
msgstr "Warte, was?"

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_9449a279"
msgid "Je te crois ! Je le sens au plus profond de moi, tu n'as pas menti."
msgstr "Ich glaube dir! Ich fühle es tief in meinem Inneren, du hast nicht gelogen."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_a4464f02"
msgid "Peu importe comment c'est arrivé... je te crois, c'est tout."
msgstr "Es spielt keine Rolle, wie es passiert ist ... Ich glaube dir, das ist alles."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_c1adc522"
msgid "Et, je suis vraiment comblée maintenant..."
msgstr "Und jetzt bin ich wirklich glücklich ..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_02599586"
msgid "Pourquoi ça ?"
msgstr "Wie kommt’s?"

#. Character:`sakuya` | Attributes:`blush`
#: game/story/canal.dialogue
msgctxt "canal_2655ea40"
msgid "Car je partage avec toi quelque chose d'unique, quelque chose dont personne n'est au courant !"
msgstr "Weil ich mit dir etwas Einzigartiges teile. Etwas, von dem niemand weiß!"

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "t15e0865940"
msgid "Dire la vérité"
msgstr "Die Wahrheit sagen"

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_f160b651"
msgid "J'en avais assez d'être le souffre-douleur."
msgstr "Ich hatte es satt, immer den Sündenbock zu spielen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_41b152fe"
msgid "Si je continuais à me laisser faire ainsi, toute ma vie n'aurait été que souffrance."
msgstr "Wenn ich nichts unternommen hätte, wäre mein ganzes Leben nichts weiter als endloses Leiden gewesen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_24e474db"
msgid "J'ai pris mon courage à deux mains et je me suis lancé."
msgstr "Ich habe endlich meinen Mut zusammengenommen und angefangen, etwas zu ändern."

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/canal.dialogue
msgctxt "canal_d6434504"
msgid "Je suis impressionnée... Ce n'est pas chose facile de se reprendre en main du jour au lendemain."
msgstr "Ich bin beeindruckt ... Es ist nicht einfach, über Nacht wieder die Kontrolle zu erlangen."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_764f2c69"
msgid "Il n'y a pas quelque chose d'autre que tu aurais oublié ?"
msgstr "Gibt es sonst noch etwas, das du vergessen haben könntest?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_b4e69ca9"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_a9a1b8c6"
msgid "Je ne sais pas, mais si ça me revient, je te le dirai !"
msgstr "Ich weiß es nicht, aber wenn mir etwas einfällt, lasse ich es dich wissen!"

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_76966922"
msgid "D'accord ! Dans ce cas, j'attendrai."
msgstr "Okay! Wenn das so ist, werde ich warten."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "t9fc6a348f7"
msgid "Dire seulement ce qu'elle a besoin de savoir."
msgstr "Ihr nur das sagen, was sie wissen muss"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_317383c2"
msgid "Je te raccompagne ?"
msgstr "Soll ich dich zurückbringen?"

#. Character:`sakuya` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_f5600f5f"
msgid "Non merci, mais je vais rentrer seule, si je rentre aussi tard avec un garçon mon père risque de s'énerver."
msgstr "Nein, danke. Ich werde alleine nach Hause gehen. Wenn ich um die Uhrzeit mit einem Jungen zu Hause aufkreuze, wird mein Vater wütend."

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/canal.dialogue
msgctxt "canal_ca98b3b5"
msgid "Et, puis je crois que quelqu'un t'attend chez toi..."
msgstr "Außerdem glaube ich, dass jemand zu Hause auf dich wartet ..."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_78473091"
msgid "On se reverra au restaurant, et puis..."
msgstr "Wir sehen uns im Restaurant und dann ..."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_380b0189"
msgid "... si jamais tu veux que nous passions un peu de temps rien que tous les deux."
msgstr "... wenn du jemals etwas Zeit zu zweit verbringen möchtest ..."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_4de7620a"
msgid "Ce sera avec plaisir !"
msgstr "Mit Vergnügen!"

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "canal_69e31164"
msgid "Bonne soirée, mon chéri !"
msgstr "Guten Abend, mein Schatz!"

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "CET_ENDROIT_EST_VRAIMENT_ROMAN_E993F7"
msgid "Cet endroit est vraiment romantique."
msgstr "Dieser Ort ist wirklich romantisch."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "JE_NE_M_ATTENDAIS_PAS_CE_QUE_T_D1E8DB"
msgid "Je ne m’attendais pas à ce que tu m’emmènes ici."
msgstr "Ich hätte nicht gedacht, dass du mich hierhin entführen würdest."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "COUTE_B140E9"
msgid "Écoute..."
msgstr "Hör zu ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "JE_VOULAIS_TE_REMERCIER_SINC_R_A8FFA3"
msgid "Je voulais te remercier sincèrement pour toute l’aide que tu m’as apporté avec {{yasuka.n}}."
msgstr "Ich möchte mich aufrichtig für all die Hilfe, die du mir bei {{yasuka.n}} gegeben hast, bedanken."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "SANS_TOI_CETTE_SITUATION_AURAI_4E49EC"
msgid "Sans toi, cette situation aurait pu s’éterniser, ou pire encore."
msgstr "Ohne dich hätte sich die Sache ewig hingezogen. Vielleicht wär’s auch noch schlimmer gekommen."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "SI_C_TAIT_REFAIRE_JE_N_H_SITER_248DCB"
msgid "Si c’était à refaire, je n’hésiterais pas une seconde."
msgstr "Wenn ich es nochmal tun müsste, würde ich keine Sekunde zögern."

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "TOUTEFOIS_W_MALGR_TOUTE_L_AIDE_79D792"
msgid "Toutefois...[w] Malgré toute l’aide que tu m’as apporté, tu ne peux pas menacer de mort les gens que j’aime."
msgstr "Aber ... [w]Trotz all der Hilfe, die du mir gegeben hast, kannst du nicht die Leben der Leute, die ich liebe bedrohen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "JE_NE_PEUX_PAS_T_EMP_CHER_DE_R_9FAC48"
msgid "Je ne peux pas t’empêcher de révéler mes secrets non plus."
msgstr "Ich kann dich auch nicht daran hindern, meine Geheimnisse preiszugeben."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "MAIS_J_AI_LA_FERME_INTENTION_D_3D2D41"
msgid "Mais j’ai la ferme intention de tout leur dire ce soir et d’être honnête avec elles."
msgstr "Aber ich möchte ihnen heute Nacht alles offen und ehrlich erzählen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "CE_QUE_J_AURAIS_D_FAIRE_DEPUIS_08F695"
msgid "Ce que j’aurais dû faire depuis longtemps."
msgstr "Das hätte ich schon vor langer Zeit tun sollen."

#. Character:`sakuya` | Attributes:`angry`
#: game/story/canal.dialogue
msgctxt "C_EST_NON_518BD9"
msgid "C’est non..."
msgstr "Nein ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "TU_AS_LE_DROIT_DE_NE_PAS_TRE_D_52AB7C"
msgid "Tu as le droit de ne pas être d’accord, mais qu’importe."
msgstr "Du hast das Recht, zu widersprechen, aber das spielt am Ende keine Rolle."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "JE_SERAI_LE_SEUL_D_CIDER_DE_MA_DC4CDB"
msgid "Je serai le seul à décider de ma vie, et personne d’autre ne le fera pour moi."
msgstr "Ich werde der einzige sein, der über mein Leben bestimmt und sonst niemand."

#. Character:`sakuya`
#: game/story/canal.dialogue
msgctxt "J_AI_DIT_NON_FEF266"
msgid "J’ai dit... NON !"
msgstr "Ich sagte ... NEIN!"

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "W_JE_ME_DOUTAIS_BIEN_QUE_A_SE_EAA5B2"
msgid "...[w] Je me doutais bien que ça serait compliqué..."
msgstr "... [w]Ich hatte schon befürchtet, dass es kompliziert werden würde ..."

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "SI_TU_NE_ME_LAISSES_PAS_LE_CHO_12CFC8"
msgid "Si tu ne me laisses pas le choix, je devrai en parler avec ton père et je quitterai également mon travail au restaurant."
msgstr "Wenn du mir keine Wahl lässt, muss ich mit deinem Vater reden und außerdem im Restaurant kündigen."

#. Character:`sakuya` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "NON_PAS_A_NON_45A37F"
msgid "NON ! Pas ça, non..."
msgstr "NEIN! Nicht das, bitte ..."

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "DANS_CE_CAS_TROUVONS_UN_TERRAI_FF4E7E"
msgid "Dans ce cas, trouvons un terrain d’entente tous les deux, nous pouvons rester amis et..."
msgstr "In dem Fall lass uns einen Kompromiss finden; wir können Freunde bleiben und ..."

#. Character:`sakuya` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "NE_T_EN_FAIS_PAS_JE_SAIS_CE_QU_090D65"
msgid "Ne t'en fais pas, je sais ce qu’il me reste à faire !"
msgstr "Keine Sorge, ich weiß, was zu tun ist!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/canal.dialogue
msgctxt "EUH_D_ACCORD_0D28C0"
msgid "Euh... D’accord..."
msgstr "Ähm ... Okay ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "JE_SUPPOSE_QUE_A_S_EST_BIEN_PA_B8A9DC"
msgid "Je suppose que ça s’est bien passé."
msgstr "Ich schätze, es ist gutgegangen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "JE_M_ATTENDAIS_PIRE_HONN_TEMEN_87E3E5"
msgid "Je m’attendais à pire, honnêtement."
msgstr "Um ehrlich zu sein, habe ich deutlich Schlimmeres erwartet."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_c125ad6e"
msgid "J'avais oublié à quel point cet endroit était agréable..."
msgstr "Ich hatte vergessen, wie schön dieser Ort doch ist ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_f877fde5"
msgid "On en oublierait presque tous ses problèmes."
msgstr "Als ließe man all seine Probleme hinter sich zurück."

#. Character:`macumba` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_df50909b"
msgid "Tout va bien petit frère ?"
msgstr "Alles in Ordnung, kleiner Bruder?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_f6213d3c"
msgid "Ah, c'est {{kimochi.n}} qui t'a dit où me trouver ?"
msgstr "Ah, hat dir {{kimochi.n}} gesagt, wo du mich findest?"

#. Character:`macumba`
#: game/story/canal.dialogue
msgctxt "canal_2498cda3"
msgid "Non... J'ai senti au fond de moi qu'un frère avait besoin de soutien."
msgstr "Nein ... Ich hatte einfach tief in mir ein Gefühl, dass ein Bruder Unterstützung braucht."

#. Character:`macumba`
#: game/story/canal.dialogue
msgctxt "canal_37b1848c"
msgid "Et me voilà !"
msgstr "Und hier bin ich!"

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_ed6623a0_1"
msgid "..."
msgstr "..."

#. Character:`macumba` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_8c7e8091"
msgid "Je le vois à ton regard petit frère."
msgstr "Ich sehe es in deinen Augen, kleiner Bruder."

#. Character:`macumba`
#: game/story/canal.dialogue
msgctxt "canal_b2ad0ab0"
msgid "Tu portes des poids bien trop lourds pour toi."
msgstr "Du trägst Laster, die viel zu schwer für dich alleine sind."

#. Character:`macumba`
#: game/story/canal.dialogue
msgctxt "canal_486c51c2"
msgid "Raconte tout à {{macumba.n}}."
msgstr "Erzähl alles {{macumba.n}}."

#. Character:`macumba` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_cc5844a6"
msgid "Haha quelle histoire mon frère."
msgstr "Haha, was für eine Geschichte, mein Bruder."

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_854d292a"
msgid "Je ne sais pas comment gérer cette situation, ça me dépasse."
msgstr "Ich weiß nicht, wie ich mit dieser Situation umgehen soll, es ist alles so viel."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_48906a26"
msgid "Et je n'ai pas envie de te demander de l'aide...[w] Si je ne résous pas ça moi-même j'ai l'impression que je ne progresserais pas."
msgstr "Und ich möchte dich nicht um Hilfe bitten ...[w] Wenn ich das nicht selbst löse, habe ich das Gefühl, dass ich keine Fortschritte machen werde."

#. Character:`macumba`
#: game/story/canal.dialogue
msgctxt "canal_347ff984"
msgid "En effet, certains combats doivent être menés seul. Ils nous permettent de grandir."
msgstr "Allerdings, manche Schlachten müssen alleine ausgefochten werden, weil sie uns alle wachsen lassen."

#. Character:`macumba` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_8d830b14"
msgid "Mais si {{macumba.n}} peut te donner un conseil... N'aie pas peur d'échouer, de te tromper ou de te faire mal."
msgstr "Aber wenn {{macumba.n}} dir einen Rat geben darf ... Hab keine Angst davor, zu scheitern, Fehler zu machen oder verletzt zu werden."

#. Character:`macumba`
#: game/story/canal.dialogue
msgctxt "canal_6843dc92"
msgid "Chaque échec te rapproche un peu plus du moment où tu réussiras..."
msgstr "Jedes Scheitern bringt dich dem Erfolg ein Stückchen näher ..."

#. Character:`macumba`
#: game/story/canal.dialogue
msgctxt "canal_bfe58151"
msgid "Ce n'est pas \"Est-ce que je vais y arriver ?\" qu'il faut se demander, mais plutôt \"Quand ?\""
msgstr "Du darfst dich nicht fragen, ob du es schaffst, sondern wann."

#. Character:`macumba`
#: game/story/canal.dialogue
msgctxt "canal_dc348ce1"
msgid "Car tu y arriveras..."
msgstr "Denn du wirst es schaffen ..."

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_39984ad0"
msgid "...[w] Comment fais-tu pour être si optimiste ?"
msgstr "...[w] Wie schaffst du es, so optimistisch zu sein?"

#. Character:`macumba`
#: game/story/canal.dialogue
msgctxt "canal_93dcec64"
msgid "Chacun sa méthode mon frère... Tu trouveras la tienne un jour."
msgstr "Wir haben alle unsere Wege, Bruder ... Du wirst deinen eines Tages auch finden."

#. Character:`macumba` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_d0e267f7"
msgid "Ce n'est qu'une question de... temps."
msgstr "Es ist nur eine Frage der Zeit."

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_c47be4f6"
msgid "Alors ça va mieux ?"
msgstr "Also, geht’s dir besser?"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_f290589d"
msgid "Tu as réussi à mettre de l'ordre dans tes idées ?"
msgstr "Hast du deine Gedanken sortieren können?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_1068d61f"
msgid "Je crois oui..."
msgstr "Ich glaube schon ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_f5ae7755"
msgid "Je sais ce que je dois faire."
msgstr "Ich weiß, was ich tun muss."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_8d4df7a0"
msgid "Avant j'avais peur...[w] Je ne connaissais pas la raison de cet acharnement."
msgstr "Zuvor hatte ich Angst ...[w] Ich kannte den Grund für deren Entschlossenheit nicht."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_286c9c81"
msgid "Mais en ayant connaissance de la vérité, c'est comme si le poids sur mes épaules venait de disparaître."
msgstr "Aber jetzt, wo ich die Wahrheit kenne, ist es so, als sei die Last auf meinen Schultern von mir gefallen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_d9a6ff1a"
msgid "Je ne me ferai plus intimider par ces trois connards."
msgstr "Ich lasse mich von diesen drei Arschlöchern nicht mehr schikanieren."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_3ef832f2"
msgid "Il ne me reste plus qu'à comprendre pourquoi {{noriko.n}} en arrive à de telles extrémités."
msgstr "Jetzt muss ich nur noch verstehen, warum {{noriko.n}} solche Extreme an den Tag legt."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_1fc07ccc"
msgid "En attendant..."
msgstr "Bis dahin ..."

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_7e0476ea"
msgid "Elle pourra envoyer qui elle veut, il n'est plus question de se laisser faire."
msgstr "Kann sie jeden schicken, den sie will. Ich werde auf keinen Fall weiter herumsitzen und mir das alles gefallen lassen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_dd898855"
msgid "Elle doit comprendre qu'elle ne pourra plus jamais m'intimider."
msgstr "Sie muss verstehen, dass sie mich nie wieder einschüchtern wird."

#. Character:`asami` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_461f6d32"
msgid "Ça c'est mon mec !"
msgstr "Das ist mein Freund!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_2f8613a1"
msgid "Quel est le programme à présent ?"
msgstr "Was ist jetzt dein Plan?"

#. Character:`saito` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_7cf35f51"
msgid "Je vais attendre... maintenant je sais qu'ils viendront pour moi à un moment ou un autre."
msgstr "Ich werde warten ... Jetzt weiß ich, dass sie irgendwann von selbst zu mir kommen werden."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_cf5fe8e4"
msgid "Reste éloignée de moi quelques temps pendant que je règle ça. Je ne voudrais pas qu'ils s'en prennent à toi."
msgstr "Halt dich eine Weile fern von mir, bis ich das geklärt habe. Ich möchte nicht, dass sie als nächstes hinter dir her sind."

#. Character:`asami` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "canal_649f3281"
msgid "Non ! Je refuse de rester planquée pendant que tu auras besoin de soutien !"
msgstr "Nein! Ich weigere mich, mich hier zu verstecken, während du Unterstützung brauchst!"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_3e3c5e7b"
msgid "Je reste avec toi, pour le meilleur et pour le pire."
msgstr "Ich bleibe bei dir, ob du es willst oder nicht."

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_d6948c92"
msgid "Tu es sûre de toi ?"
msgstr "Bist du dir sicher?"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_5cb28083"
msgid "Certaine. Par contre... j'ai besoin de toi pour un truc."
msgstr "Das bin ich, aber ... Ich brauche dich für etwas."

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_0e917af6"
msgid "À quoi donc ?"
msgstr "Was ist es?"

#. Character:`asami`
#: game/story/canal.dialogue
msgctxt "canal_35b47252"
msgid "Dans ma chambre."
msgstr "In meinem Zimmer."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_4811ea27"
msgid "Pour... ?"
msgstr "Für ...?"

#. Character:`asami` | Attributes:`pouting`
#: game/story/canal.dialogue
msgctxt "canal_2eccc183"
msgid "Il faut vraiment que je te fasse un dessin !?"
msgstr "Bist du so schwer von Begriff? Soll ich es dir aufmalen?!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/canal.dialogue
msgctxt "canal_41908842"
msgid "Oh ! OH ! Euh... D'accord."
msgstr "Oh ... OH! Ähmm ... Okay!"

#. Character:`asami` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_1c62f2ed"
msgid "Voir mon petit poney aussi déterminé me laisse toute chose."
msgstr "Mein kleines Pony so entschlossen zu sehen, macht mich ganz heiß."

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_f674c452"
msgid "Ha ha."
msgstr "Haha ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_d3a508be"
msgid "Encore un coup dans l'eau..."
msgstr "Noch ein Griff ins Klo..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_720d4aa3"
msgid "On a plus perdu notre temps qu'autre chose."
msgstr "Wir haben eine Menge Zeit verschwendet."

#. Character:`kimochi` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "canal_bcfb8373"
msgid "Ça valait la peine d'essayer."
msgstr "Es war einen Versuch wert."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_845833e5"
msgid "Il faut retourner auprès de {{noriko.n}} rapidement !"
msgstr "Wir müssen schnell zu {{noriko.n}} zurück, auf der Stelle!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "canal_cd2e974f"
msgid "J'ai un mauvais pressentiment..."
msgstr "Ich habe ein schlechtes Gefühl bei der Sache ..."

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_2dbd7a15"
msgid "J'ai besoin de toi, je suis dans la merde..."
msgstr "Ich brauche dich! Ich stecke richtig in der Scheiße ..."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_c4cb745f"
msgid "Je veux rien à voir à faire avec des branleurs comme vous."
msgstr "Ich will mit Wichsern wie euch nicht zu tun haben."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_7f12b0ee"
msgid "Vous êtes juste un groupe de sous-merdes, vous êtes incapables de faire quoi que ce soit tout seuls."
msgstr "Ihr seid nichts weiter als ein Haufen Schwachköpfe, die nichts alleine geschissen bekommen."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_fc6009ce"
msgid "Demande à tes potes, à quoi ils servent sinon ?"
msgstr "Frag deine Freunde. Wofür sind sie sonst da?"

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_84dbbbc0"
msgid "Je... je peux pas, ils m'ont lâchés."
msgstr "Ich ... ich kann nicht. Sie haben mich zurückgelassen."

#. Character:`akira` | Attributes:`arrogant`
#: game/story/canal.dialogue
msgctxt "canal_6d80575a"
msgid "...Vous me faites vraiment pitié."
msgstr "... Du bist wirklich bemitleidenswert."

#. Character:`takeo` | Attributes:`angry`
#: game/story/canal.dialogue
msgctxt "canal_4629dd3a"
msgid "S'il te plaît, je me suis attiré des emmerdes et sans toi j'y laisserai ma peau !"
msgstr "Bitte, ich bin in große Scheiße geraten und werde es ohne deine Hilfe nicht mehr lange überleben!"

#. Character:`akira` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_54c803b2"
msgid "T'avais qu'à y réfléchir avant !"
msgstr "Du hättest vorher darüber nachdenken sollen, was du tust."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_386740d9"
msgid "Règle d'or ! T'engage jamais dans un combat que tu peux pas gagner."
msgstr "Die Goldene Regel! Gerate in keinen Kampf, den du nicht gewinnen kannst."

#. Character:`akira` | Attributes:`angry`
#: game/story/canal.dialogue
msgctxt "canal_4a729e01"
msgid "Allez casse-toi ! J'aimerais profiter du soleil sans être dérangé, j'ai mes propres problèmes à gérer."
msgstr "Jetzt mach dich aus dem Staub! Ich würde den Sonnenuntergang gerne genießen, ohne von dir genervt zu werden. Ich habe meine eigenen Probleme, um die ich mich kümmern muss."

#. Character:`takeo` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_3aec795e"
msgid "Je te paierais !"
msgstr "Ich bezahle dich!"

#. Character:`akira` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "canal_87db5346"
msgid "...[w] Tu es sûr que tu as les moyens de t'offrir mes services ? Je ne suis pas donné."
msgstr "...[w] Bist du dir sicher, dass du dir meine Dienste leisten kannst? Ich bin nicht billig."

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_b520671d"
msgid "Je paierai le prix qu'il faut et je paierai un bonus si tu me laisses dire que c'est moi qui m'en suis occupé !"
msgstr "Ich zahle dir einen anständigen Preis und du bekommst sogar einen Bonus, wenn du so tust, als hätte ich mich darum gekümmert."

#. Character:`akira` | Attributes:`arrogant`
#: game/story/canal.dialogue
msgctxt "canal_a5c30825"
msgid "...Putain t'es pas croyable !"
msgstr "... Verdammt, du bist unglaublich!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_4fba3aaf"
msgid "Okay c'est bon je marche... C'est qui la cible ?"
msgstr "Okay, ich bin dabei ... Wer ist das Ziel?"

#. Character:`takeo` | Attributes:`mocking`
#: game/story/canal.dialogue
msgctxt "canal_3805e2d8"
msgid "Un guignol... Il est tout seul de toute façon."
msgstr "Ein Arschloch ... Er ist ohnehin allein."

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_7662ea35"
msgid "Il m'attendra probablement devant chez moi ce soir."
msgstr "Wahrscheinlich wartet er heute Nacht vor meinem Haus auf mich."

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_fc24c1c5"
msgid "Tombe lui dessus pendant qu'il sera occupé avec moi."
msgstr "Verfolge ihn, während er mit mir beschäftigt ist."

#. Character:`akira` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_028b6cac"
msgid "Si tu veux peu importe... Mais tu payes d'avance."
msgstr "Wie auch immer ... Aber du musst zuerst bezahlen."

#. Character:`takeo` | Attributes:`disgusted`
#: game/story/canal.dialogue
msgctxt "canal_044ee350"
msgid "C'est... c'est combien ?"
msgstr "Wie viel?"

#. Character:`akira` | Attributes:`arrogant`
#: game/story/canal.dialogue
msgctxt "canal_e05f4d20"
msgid "Cher !"
msgstr "Eine Menge!"

#. Character:`takeo` | Attributes:`mocking`
#: game/story/canal.dialogue
msgctxt "canal_c737d020"
msgid "Voilà ! J'espère que pour ce prix tu lui feras sauter toutes ses dents !"
msgstr "Hier! Ich hoffe, dass du ihm für das Geld alle Zähne ausschlägst!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_93a594c3"
msgid "T'en fais pas pour ça, par contre par devant, j'ai un truc à faire avant !"
msgstr "Mach dir darum keine Sorgen, aber vorher muss ich noch etwas erledigen!"

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_7c1955bd"
msgid "Ça peut pas attendre ? J'ai vraiment besoin de..."
msgstr "Kann das nicht warten? Ich brauche wirklich ..."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_e14c5948"
msgid "Non, j'arrive quand j'ai fini, tu n'as qu'à te cacher en attendant !"
msgstr "Nein, ich werde da sein, wenn ich fertig bin. Versteck dich einfach, während du auf mich wartest!"

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_78573fdb"
msgid "Mais putain tu étais où ?"
msgstr "Verdammte Scheiße, wo warst du?"

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_e317936c"
msgid "Tu devais venir me donner un coup de main."
msgstr "Du hast gesagt, du würdest mir helfen."

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_de8d27ee"
msgid "Putain je t'ai payé pour ça ! Rends-moi ma tune !"
msgstr "Fuck, ich habe dich dafür bezahlt! Gib mir mein Geld zurück!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_2abea939"
msgid "Non... Pas envie."
msgstr "Nein ... Ich habe keine Lust dazu."

#. Character:`takeo` | Attributes:`disgusted`
#: game/story/canal.dialogue
msgctxt "canal_ea5ebab0"
msgid "Mais on avait un accord bordel..."
msgstr "Wir hatten eine verfickte Abmachung ..."

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_8087de5a"
msgid "Toi et moi on est dans le même business !"
msgstr "Wir sitzen beide im gleichen Boot!"

#. Character:`akira` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "canal_3870c6d7"
msgid "C'est là que tu te trompes, toi tu rackettes les gens à plusieurs parce que t'es un lâche, moi c'est les lâches que je rackette, nous ne sommes pas pareils."
msgstr "Und genau da liegst du falsch. Du erpresst andere Leute, dir ihr Geld zu geben, weil du ein Feigling bist. Ich wiederum erpresse Feiglinge wie dich, um an das Geld zu kommen. Wir sind nicht gleich."

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_1daf3904"
msgid "Et puis... tu vas faire quoi ?"
msgstr "Und abgesehen davon ... Was willst du tun?"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_46d077bf"
msgid "Rien !"
msgstr "Nichts!"

#. Character:`akira` | Attributes:`arrogant`
#: game/story/canal.dialogue
msgctxt "canal_402e24f0"
msgid "T'es qu'une petite merde !"
msgstr "Du bist nichts weiter als ein kleiner Haufen Scheiße!"

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "canal_2b0f5f8a"
msgid "La prochaine fois résous tes problèmes par toi-même et ne me dérange plus."
msgstr "Kümmer dich das nächste Mal selbst um deine Probleme und geh mir nicht mehr auf die Nerven!"

#. Character:`akira` | Attributes:`angry`
#: game/story/canal.dialogue
msgctxt "canal_cb989749"
msgid "Tire toi maintenant !"
msgstr "Und jetzt verpiss dich!"

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "canal_f109e3c2"
msgid "Fait chier..."
msgstr "Scheiße ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "PERSONNE_VIDEMMENT_B1D0C5"
msgid "Personne, évidemment..."
msgstr "Niemand, natürlich ..."

#. Character:`saito` | Attributes:`sad`
#: game/story/canal.dialogue
msgctxt "A_AURAIT_T_BIEN_TROP_FACILE_S_7D7FD7"
msgid "Ça aurait été bien trop facile, sinon."
msgstr "Das wäre sonst viel zu einfach gewesen."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "VOYONS_QUI_POURRAIT_ME_RENSEIG_5D33AE"
msgid "Voyons... qui pourrait me renseigner ?"
msgstr "Lass uns mal sehen ... Wer könnte mir Informationen geben?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/canal.dialogue
msgctxt "LES_TROIS_IDIOTS_5F6581"
msgid "Les trois idiots !"
msgstr "Die drei Idioten!"

#. Character:`saito` | Attributes:`happy`
#: game/story/canal.dialogue
msgctxt "J_AURAIS_D_COMMENCER_PAR_EUX_6AF4F0"
msgid "J'aurais dû commencer par eux !"
msgstr "Ich hätte mit denen anfangen sollen!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "L_ARCADE_CENTER_N_EST_PAS_LOIN_05AD36"
msgid "L'arcade center n'est pas loin, je suis certain que {{nobu.n}} y sera !"
msgstr "Die Arcade-Halle ist nicht weit von hier. {{nobu.n}} wird bestimmt da sein!"

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "C_EST_FOU_DE_VOIR_QUE_PEU_IMPO_F95B5E"
msgid "C'est fou de voir que peu importe ce que j'entreprends, les événements qui se sont passés pendant ma précédente vie..."
msgstr "Es ist entmutigend, dass mich die Ereignisse aus meinem letzten Leben immer wieder einholen, was ich auch tue ..."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "JE_DOIS_FAIRE_DES_EFFORTS_SURH_66CBC4"
msgid "Je dois faire des efforts surhumains, ne serait-ce que pour faire bouger les choses."
msgstr "Ich muss wirklich übermenschliche Kraft beweisen, um die Dinge in den Griff zu bekommen."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "COMME_SI_LE_DESTIN_AVAIT_SA_VO_83E62A"
msgid "Comme si le destin avait sa volonté propre."
msgstr "Als hätte das Schicksal seinen eigenen Willen."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "_856DB5"
msgid "..."
msgstr "..."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "SI_A_SE_TROUVE_W_NON_JE_NE_DOI_A217CC"
msgid "Si ça se trouve...[w] Non, je ne dois pas me laisser aller à la parano !"
msgstr "Vielleicht ... [w]Nein, ich darf nicht paranoid werden!"

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "LES_CHOSES_BOUGENT_PETIT_PETIT_BB5EDD"
msgid "Les choses bougent petit à petit, {{noriko.n}} a été sauvée, je ne suis plus le faible que j'étais... {{yasuka.n}} croule toujours sous les dettes mais elle n'a plus l'autre pervers sur le dos."
msgstr "Die Dinge verändern sich bereits langsam. {{noriko.n}} wurde gerettet und ich bin nicht mehr der Schwächling, der ich früher war ... {{yasuka.n}} versinkt immer noch in ihren Schulden, aber sie muss sich zumindest nicht mehr mit diesem Perversling von einem Chef herumschlagen."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "EST_CE_QUE_J_AURAIS_PU_MIEUX_F_E0D634"
msgid "Est-ce que j'aurais pu mieux faire jusqu'ici ?"
msgstr "Hätte ich es bis jetzt besser machen können?"

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "JE_N_EN_SUIS_PAS_S_R_4193E5"
msgid "Je n'en suis pas sûr..."
msgstr "Ich bin mir nicht sicher ..."

#. Character:`narrator`
#: game/story/canal.dialogue
msgctxt "DE_TOUTE_FA_ON_C_EST_TROP_TARD_BD30D0"
msgid "De toute façon, c'est trop tard, je n'ai droit qu'à une seule seconde chance."
msgstr "Wie auch immer. Es ist zu spät. Ich habe nur eine zweite Chance."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "QU_EST_CE_QUE_TU_FAIS_L_929B9F"
msgid "Qu'est-ce que tu fais là ?"
msgstr "Was zur Hölle suchst du hier?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "JE_PRENAIS_L_AIR_C_EST_TOUFFAN_32E63E"
msgid "Je prenais l'air. C'est étouffant en ce moment avec tous ces policiers qui sont à ta recherche."
msgstr "Ich habe etwas frische Luft geschnappt. Es fühlt sich an, als würde ich von all den Polizisten, die nach dir suchen, erstickt werden."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "COMMENT_SE_PASSE_LA_VIE_DE_FUG_620A2B"
msgid "Comment se passe la vie de fugitif ?"
msgstr "Wie ist das Leben so auf der Flucht?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "VA_TE_FAIRE_VOIR_3AF365"
msgid "Va te faire voir !"
msgstr "Fick dich einfach!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "JE_NE_SAIS_PAS_CE_QUE_TU_AS_EN_925FA3"
msgid "Je ne sais pas ce que tu as en tête, mais ça ne m'intéresse pas."
msgstr "Ich weiß nicht, was du vorhattest, aber ich bin nicht interessiert."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "J_EN_AI_PLUS_QU_ASSEZ_DE_TON_D_8AAAE9"
msgid "J'en ai plus qu'assez de ton double jeu."
msgstr "Ich hatte mehr als genug von deinem kleinen Doppelagenten-Spiel."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "JE_NE_TE_FAIS_PAS_DU_TOUT_CONF_3C8124"
msgid "Je ne te fais pas du tout confiance."
msgstr "Ich vertraue dir nicht."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "MAIS_C_EST_UNE_TR_S_BONNE_CHOS_78995E"
msgid "Mais c'est une très bonne chose, ça !"
msgstr "Na, das ist doch mal eine gute Sache!"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "IL_NE_FAUT_FAIRE_CONFIANCE_PER_468F21"
msgid "Il ne faut faire confiance à personne !"
msgstr "Du kannst niemandem trauen!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "FICHE_MOI_LA_PAIX_LA_JOURN_E_A_3F2D88"
msgid "Fiche-moi la paix, la journée a été difficile."
msgstr "Lass mich in Ruhe. Ich hatte einen harten Tag."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "TU_AS_UN_ENDROIT_O_DORMIR_JE_S_C26CA4"
msgid "Tu as un endroit où dormir ? Je suppose que tu n'as plus aucun endroit où aller."
msgstr "Hast du einen Platz zum Schlafen? Ich schätze, du kannst nirgendwo hingehen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "CE_NE_SONT_PAS_TES_AFFAIRES_ET_BF3A2E"
msgid "Ce ne sont pas tes affaires, et tout ça ne te concerne pas."
msgstr "Das geht dich nichts an, lass das meine Sorge sein."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "ET_PUIS_SI_TU_AS_VRAIMENT_ENVI_1D5261"
msgid "Et puis, si tu as vraiment envie d'aider, aide plutôt {{asami.n}} à sortir de là où {{minato.n}} l'a enfermée."
msgstr "Und wenn du wirklich helfen wolltest, warum befreist du nicht {{asami.n}} aus ihrem Gefängnis, wo auch immer {{minato.n}} sie eingesperrt hat?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "BON_JE_VOIS_QUE_MONSIEUR_SAITO_7AC77C"
msgid "Bon, je vois que monsieur {{saito.n}} est un peu trop ronchon ce soir."
msgstr "Na gut, scheint so, als sei Herr {{saito.n}} heute Nacht ausgesprochen mürrisch."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "JE_VAIS_TE_LAISSER_TES_PENS_ES_5E30EE"
msgid "Je vais te laisser à tes pensées."
msgstr "Ich werde dich mit deinen Gedanken alleine lassen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "BON_D_BARRAS_C50EB0"
msgid "Bon débarras..."
msgstr "Viel Erfolg ..."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "W_NE_ME_JUGE_PAS_TROP_DUREMEN_87A11C"
msgid "...[w] Ne me juge pas trop durement. Si je suis avec {{minato.n}}, ce n'est pas par choix non plus."
msgstr "... [w]Verurteile mich nicht vorschnell. Wenn ich bei {{minato.n}} bin, dann auch nicht freiwillig."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "ET_SI_ON_Y_R_FL_CHIT_BIEN_EN_T_18DDF7"
msgid "Et si on y réfléchit bien, en t'aidant toi, j'aide indirectement {{asami.n}}, non ?"
msgstr "Und wenn du genauer darüber nachdenkst, helfe ich {{asami.n}} indirekt, indem ich dir helfe, oder?"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "W_PEUT_TRE_2B4D0D"
msgid "...[w] Peut-être..."
msgstr "... [w]Vielleicht ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "JE_CROIS_QUE_J_AI_PAS_T_ASSEZ_6D8009"
msgid "Je crois que j'ai pas été assez clair, visiblement..."
msgstr "Es scheint, als habe ich mich nicht deutlich genug ausgedrückt ..."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "MHHH_C_EST_TOI_QUI_PUES_COMME_FB50B4"
msgid "Mhhh... C'est toi qui pues comme ça ?"
msgstr "Hmmm ... Kommt dieser Gestank von dir?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "NE_ME_DIS_PAS_QUE_TU_TE_CACHES_1CF483"
msgid "Ne me dis pas que tu te caches dans les égouts ?!"
msgstr "Sag nicht, du versteckst dich in der Kanalisation?!"

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "TU_AS_VRAIMENT_UN_DON_POUR_NER_9EEC76"
msgid "Tu as vraiment un don pour énerver les gens."
msgstr "Du hast wirklich eine Begabung fürs Nerven von Leuten."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "D_STRESSE_UN_PEU_JE_NE_DIRAI_R_161ED8"
msgid "Dé-stresse un peu, je ne dirai rien à \"qui tu sais\" de toute façon."
msgstr "Entspann dich ein bisschen. Ich würde „Du-weißt-schon-wem“ eh nie was erzählen."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "C_EST_ENCORE_UN_PI_GE_C_EST_PO_98084E"
msgid "C'est encore un piège ? C'est pour me faire baisser ma garde ?"
msgstr "Ist das noch eine Falle? Ein Versuch, mich unachtsam werden zu lassen?"

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "TU_SAIS_BIEN_QUE_JE_D_TESTE_LE_D4EF29"
msgid "Tu sais bien que je déteste les mensonges. J'ai toujours été franche avec toi depuis qu'on se connaît."
msgstr "Du weißt, dass ich Lügen hasse. Ich war immer ehrlich mit dir, die ganze Zeit."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "JE_FAIS_JUSTE_ATTENTION_CE_QUE_F51955"
msgid "Je fais juste attention à ce que je dis et à qui je le dis."
msgstr "Ich bin nur vorsichtig damit, wem ich was erzähle."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "TU_NE_M_AURAS_PAS_COMME_A_JE_N_ACCA99"
msgid "Tu ne m'auras pas comme ça. Je ne sais pas quelle image tu veux te donner mais..."
msgstr "So einfach kriegst du mich nicht. Ich weiß nicht, was für einen Eindruck du machen willst, aber ..."

#. Character:`saito`
#: game/story/canal.dialogue
msgctxt "TOUT_CE_QUE_TU_DIS_N_EST_RIEN_1E6F51"
msgid "Tout ce que tu dis n'est rien d'autre que du mensonge par omission."
msgstr "Alles, was du sagst oder eben nicht sagst, ist unaufrichtig."

#. Character:`natsume`
#: game/story/canal.dialogue
msgctxt "BON_A_SUFFIT_SUIS_MOI_C0896B"
msgid "Bon, ça suffit ! Suis-moi !"
msgstr "Okay, das reicht! Komm mit!"

#. Character:`takeo` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "COMMENT_A_VA_DEPUIS_LA_DERNI_R_56A32A"
msgid "Comment ça va depuis la dernière fois ?"
msgstr ""

#. Character:`akira` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "FERME_BIEN_TA_GUEULE_ET_N_VOQU_5B26FD"
msgid "Ferme bien ta gueule et n’évoque plus jamais ce moment avec moi !"
msgstr ""

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "JE_ME_DISAIS_QU_ON_POURRAIT_PE_F38C5F"
msgid "Je me disais qu’on pourrait peut-être..."
msgstr ""

#. Character:`akira` | Attributes:`angry`
#: game/story/canal.dialogue
msgctxt "RIEN_DU_TOUT_JE_M_OCCUPERAI_DE_F41026"
msgid "Rien du tout, je m’occuperai de cette salope moi-même !"
msgstr ""

#. Character:`akira` | Attributes:`arrogant`
#: game/story/canal.dialogue
msgctxt "R_PONDS_PLUT_T_MA_QUESTION_2C497B"
msgid "Réponds plutôt à ma question !"
msgstr ""

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "JE_SUIS_TOMB_SUR_UNE_PETITE_BR_C514C6"
msgid "Je suis tombé sur une petite brune, un garçon manqué avec une marque sur le visage."
msgstr ""

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "ELLE_A_CRU_QU_IL_N_Y_AURAIT_AU_A27639"
msgid "Elle a cru qu’il n’y aurait aucune conséquence à se foutre de moi."
msgstr ""

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "JE_DOIS_JUSTE_LUI_FAIRE_UN_RAP_F8E233"
msgid "Je dois juste lui faire un rappel à la réalité."
msgstr ""

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "TU_NE_SAURAIS_PAS_O_JE_POURRAI_ACAE1C"
msgid "Tu ne saurais pas où je pourrais la trouver ?"
msgstr ""

#. Character:`takeo` | Attributes:`mocking`
#: game/story/canal.dialogue
msgctxt "JE_CROIS_QUE_JE_SAIS_DE_QUI_TU_70C223"
msgid "Je crois que je sais de qui tu parles..."
msgstr ""

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "ASAMI_N_F6DFF7"
msgid "{{asami.n}} !"
msgstr ""

#. Character:`takeo`
#: game/story/canal.dialogue
msgctxt "C_EST_UN_PEU_UNE_SORTE_D_LECTR_9F64CA"
msgid "C’est un peu une sorte d’électron libre, on la voit souvent au parc, elle est pas méchante franchement."
msgstr ""

#. Character:`akira` | Attributes:`upset`
#: game/story/canal.dialogue
msgctxt "JE_M_EN_FOUS_SI_JE_NE_FAIS_PAS_6763E0"
msgid "Je m’en fous, si je ne fais pas un exemple avec elle, ça va entacher ma réputation."
msgstr ""

#. Character:`akira`
#: game/story/canal.dialogue
msgctxt "O_EST_CE_QUE_JE_LA_TROUVE_BB5EE5"
msgid "Où est-ce que je la trouve ?"
msgstr ""

#. Character:`takeo` | Attributes:`neutral`
#: game/story/canal.dialogue
msgctxt "LE_PARC_OU_L_ARCADE_CENTER_0C39D1"
msgid "Le parc ou l’arcade center..."
msgstr ""

#. Character:`akira` | Attributes:`arrogant`
#: game/story/canal.dialogue
msgctxt "PARFAIT_ELLE_VA_S_EN_SOUVENIR_F76A3E"
msgid "Parfait ! Elle va s’en souvenir toute sa vie !"
msgstr ""

#. Character:`saito`
#: game/story/home_player_saito_room.dialogue
msgctxt "home_player_room_1d26945b"
msgid "Je devrais rejoindre {{yasuka.n}} dans la salle de bain."
msgstr "Ich sollte zu {{yasuka.n}} ins Badezimmer gehen."

#. Character:`saito`
#: game/story/home_player_saito_room.dialogue
msgctxt "t24aa40dc27"
msgid "[next]"
msgstr "[next]"

#. Character:`narrator`
#: game/story/home_player_saito_room.dialogue
msgctxt "t6ae95b8d05"
msgid "Dormir"
msgstr "Schlafen"

#. Character:`saito`
#: game/story/home_player_saito_room.dialogue
msgctxt "tcc9b2ae5f3"
msgid "[next]"
msgstr "[next]"

#. Character:`narrator`
#: game/story/home_player_saito_room.dialogue
msgctxt "tc773639ff4"
msgid "Faire une sieste"
msgstr "Eine kurze Pause machen"

#. Character:`saito`
#: game/story/home_player_saito_room.dialogue
msgctxt "tb5178005b3"
