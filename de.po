msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "EUH_A_D_PEND_DE_L_ENDROIT_ET_A_6FE091"
msgid "Euh... Ça dépend de l'endroit et avec qui je suis, mais j'essaierai."
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "BRAVE_GAR_ON_92F5D3"
msgid "Brave garçon !"
msgstr ""

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "ALLEZ_PRENDS_BIEN_SOIN_DE_YASU_5420AD"
msgid "Allez, prends bien soin de {{yasuka.n}}, je vais passer un peu de temps avec ma mère, moi aussi."
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t22d2ff6695"
msgid "[next]"
msgstr "[next]"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_c22fe00a"
msgid "Bonjour {{saito}}, tu as besoin de quelque chose ?"
msgstr "Hallo, {{saito}}! Brauchst du etwas?"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t0f72f1767e"
msgid "Discuter."
msgstr "Reden"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t82299edec1"
msgid "À propos de {{noriko.n}}."
msgstr "Was {{noriko.n}} betrifft..."

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "tcfcca545f9"
msgid "Avez-vous vu {{noriko.n}} ?"
msgstr "Hast du {{noriko.n}} gesehen?"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t5c2e5269ef"
msgid "Mauvaises fréquentations."
msgstr "Schlechte Gesellschaft"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t6b428057ee"
msgid "[color=yellow]Argent volé.[/color]"
msgstr "[color=yellow]Gestohlenes Geld[/color]"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_02574cc8"
msgid "Bonjour {{saito.n}}, comment vas-tu ?"
msgstr "Hallo, {{saito.n}}! Wie geht es dir?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_bc3b3424"
msgid "Tu t'es déjà décidé de venir me voir ?"
msgstr "Du hast dich also endlich entschlossen, mich mal besuchen zu kommen?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "ET_BIEN_CE_N_EST_PAS_TOUT_A_FA_65D577"
msgid "Eh bien... Ce n'est pas tout à fait désintéressé..."
msgstr ""

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "OH_VOYEZ_VOUS_A_QUE_PUIS_JE_FA_88D44E"
msgid "Oh ? Voyez-vous ça ! Que puis-je faire pour toi ?"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "C_EST_PROPOS_DE_NORIKO_N_82CB45"
msgid "C'est à propos de {{noriko.n}}."
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_64b40920"
msgid "Dis-moi tout."
msgstr "Erzähl mir alles."

#. Character:`centered`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_32ab0bcf"
msgid "Après quelques minutes d'explications..."
msgstr "Nach ein paar Minuten Erklärungen..."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_663fcd80"
msgid "Malheureusement, je ne peux pas t'en dire davantage mais tu sais quoi ? Je demanderai à mon ancien collaborateur."
msgstr "Ich kann dir leider nicht mehr dazu sagen, aber weißt du was? Ich frage meinen ehemaligen Mitarbeiter."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_90514ef1"
msgid "Si j'apprends quelque chose d'intéressant je te le dirais."
msgstr "Wenn ich etwas Interessantes herausfinde, lass ich es dich wissen."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_afa36740"
msgid "Merci infiniment."
msgstr "Vielen Dank."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_6908d2b6"
msgid "Aucun problème et dis-moi juste une chose..."
msgstr "Kein Problem. Sag mir nur eines..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t9dca5fcee6"
msgid "J'ai appris que toi et {{asami.n}} étiez seulement amis..."
msgstr "Ich habe gelernt, dass {{asami.n}} und du nur Freunde seid..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "tc7f0a37830"
msgid "Je suis surprise que tu aies réussi à résister à ses charmes."
msgstr "Ich bin überrascht, dass du es geschafft hast, ihrem Charme zu widerstehen."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t8c2b2c547f"
msgid "Du coup... Je me demandais... Y a-t-il une autre fille ?"
msgstr "Also... Ich habe mich gefragt... Gibt es da ein anderes Mädchen bei dir?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2805e8a7"
msgid "Je sais que vous sortez déjà ensemble."
msgstr "Ich weiß, dass ihr schon miteinander ausgeht."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3f62267a"
msgid "Mais qu'est-ce qui t'a fait définitivement craquer chez elle ?"
msgstr "Aber was hat dich am Ende überzeugt?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2329d961"
msgid "C'est tout moi quand j'étais jeune."
msgstr "Das klingt genauso wie ich, als ich jung war."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2d6975f1"
msgid "Heureusement ça passe avec le temps."
msgstr "Zum Glück vergeht das mit der Zeit."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_604ab035"
msgid "Ça me dérange pas."
msgstr "Es stört mich nicht."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_1c9d2b50"
msgid "C'est ça qui fait son charme."
msgstr "Das ist, was sie so charmant macht."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_c8ab143a"
msgid "Elle est vraiment bien tombée avec toi alors..."
msgstr "Dann kann sie sich wirklich glücklich schätzen, dich zu haben..."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2e8b5543"
msgid "Maman arrête avec ça, j'ai pas envie de changer."
msgstr "Mama, lass das! Ich will mich nicht ändern."

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_641dd2f6"
msgid "De plus {{saito.n}} m'aime pour ce que je suis donc tu devrais plutôt être contente."
msgstr "Abgesehen davon liebt mich {{saito.n}} so, wie ich bin, also solltest du eher glücklich sein."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_d7d63da9"
msgid "Ma puce, je suis contente pour toi c'est juste... que ton manteau ressemble plus à un gros sac poubelle."
msgstr "Meine Liebe, ich freue mich für dich, aber es ist einfach... Dein Mantel sieht eher aus wie ein überdimensionierter Müllsack."

#. Character:`asami` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a85290bb"
msgid "MAMAN !!!"
msgstr "MAMAAAA!!!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_dd6c2daa"
msgid "On va vous laisser je crois..."
msgstr "Ich lasse euch zwei lieber alleine..."

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "te25262aa89"
msgid "Son côté garçon manqué."
msgstr "Ihre Tomboy-Art"

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_1250478e"
msgid "J'avoue que je suis aussi surprise que toi."
msgstr "Ich muss zugeben, dass ich genauso überrascht bin wie du."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_64302154"
msgid "Je ne pensais pas qu'elle changerait aussi vite."
msgstr "Ich hätte nicht gedacht, dass sie sich so schnell verändern würde."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_4b6f0ff3"
msgid "Rien de tel qu'un chagrin d'amour pour se remettre en question."
msgstr "Es gibt nicht, was einen sich selbst mehr hiinterfragen lässt, als ein gebrochenes Herz"

#. Character:`asami` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_ee520f13"
msgid "MAMAN !!! Qu'est-ce que tu racontes à {{saito.n}} dans mon dos ?!"
msgstr "MAMAAA!!! Was erzählst du {{saito.n}} hinter meinem Rücken?!"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_34417166"
msgid "Rien ma puce, on discutait juste un peu de toi."
msgstr "Nichts, meine Liebe. Wir haben nur über dich geredet."

#. Character:`asami` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a57f63eb"
msgid "Oui, eh bien ne le faites pas ! Je ne suis pas une attraction !"
msgstr "Dann lasst das sein! Ich bin nicht irgendeine Attraktion!"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "tea2543a909"
msgid "Sa détermination."
msgstr "Ihre Entschlossenheit"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "ta80ea91415"
msgid "Il y a bien une personne à qui je tiens beaucoup."
msgstr "Es gibt jemanden, den ich sehr lieb habe."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "t9cb4ca02bb"
msgid "..."
msgstr "..."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "td4ee42c9b5"
msgid "Vraiment ? J'en connais une qui a de la chance."
msgstr "Wirklich? Dann muss sie sich ja ziemlich glücklich schätzen."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "tc6032fcbc0"
msgid "Tu l'as déjà rencontrée ma puce ?"
msgstr "Hast du sie schon getroffen, Liebling?"

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "t7ad8e7a741"
msgid "[font_size=10]Oui... et puis y'en a pas qu'une...[/font_size]"
msgstr "[font_size=10]Ja...und es ist mehr als nur eine...[/font_size]"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t94679766e1"
msgid "Oh ma petite chérie est jalouse !"
msgstr "Oh, mein kleiner Schatz ist eifersüchtig!"

#. Character:`asami` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "t9fb87cd5ce"
msgid "MAMAN !! ARRÊTE !"
msgstr "MAMA! LASS DAS!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t8117094e13"
msgid "Tu es trop mignonne !"
msgstr "Du bist so süß!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "ta3a8d45b15"
msgid "Tu ne trouves pas {{saito.n}} ?"
msgstr "Findest du nicht auch, {{saito.n}}?"

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "t3cbcb8d970"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`guilty`
#: game/story/konbini_interior.dialogue
msgctxt "teac8ff8e31"
msgid "Je crois que je vais vous laisser discuter de ça entre vous deux."
msgstr "Ich halte mich da raus."

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t4b18a33577"
msgid "Oui... Il y a bien quelqu'un."
msgstr "Ja... Da ist jemand."

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_df99a1f8"
msgid "Oh-ho voyez-vous ça ?!"
msgstr "Oh, oh, sieh mal einer an!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_8d89a396"
msgid "Tu sembles avoir confiance en toi."
msgstr "Du scheinst ganz schön selbstbewusst zu sein."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_58f48c02"
msgid "Mais que pourrait bien m'apporter un jeune homme comme toi ?"
msgstr "Aber was hätte ein junger Mann wie du mir nur zu bieten?"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_0365d33f"
msgid "Je suppose que nous ne le saurons jamais..."
msgstr "Ich schätze, das werden wir nie erfahren..."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_d62ae330"
msgid "Tu sais que si j'avais eu probablement 10 ans de moins je t'aurais dévoré ?"
msgstr "Weißt du, wenn ich zehn Jahre jünger wäre, dann wäre ich wahrscheinlich über dich hergefallen!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2e1d93cb"
msgid "Quoi ! Sérieusement ?"
msgstr "Was?! Im Ernst?!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_669a16f5"
msgid "Je suppose que nous ne le saurons jamais !"
msgstr "Ich schätze, das werden wir wohl nie erfahren!"

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_d6fd98ff"
msgid "Dites... Vous voulez un coup de main tous les deux ?"
msgstr "Sagt mir... braucht ihr zwei Hilfe?"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b641c373"
msgid "Oh ma chérie ! Je taquinais juste {{saito.n}}."
msgstr "Oh, Liebling! Ich habe {{saito.n}} nur ein wenig geärgert."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_71cedfb5"
msgid "Je sais... mais ça me fait bizarre d'entendre ma propre mère dire ce genre de choses à mon petit ami."
msgstr "Ich weiß... Aber es fühlt sich komisch an, wenn meine Mutter so etwas zu meinem Freund sagt."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2db8a73e"
msgid "Haha c'est pour ça que tu dois faire de ton mieux sinon peut-être que je garderais pour moi ?"
msgstr "Haha, deshalb solltest du dich ranhalten! Ansonsten schnappe ich ihn mir vielleicht..."

#. Character:`asami` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b25989d3"
msgid "Maman !!! Arrête avec ça !"
msgstr "Mamaaa! Hör auf!"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t93661763a1"
msgid "Elle n'était qu'un prétexte pour me rapprocher de vous."
msgstr "Sie ist nur ein Vorwand für mich, um dir näher zu kommen."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_9e5b7299"
msgid "À bientôt {{sayuri.n}}."
msgstr "Bis dann, {{sayuri.n}}."

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a9226adb"
msgid "Non, c'est madame pour elle !"
msgstr "Nein, für dich heißt es „Madame“!"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_5d548632"
msgid "Oh toi, tu ne perds rien pour attendre !"
msgstr "Oh, damit kommst du nicht davon!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b5073a39"
msgid "Bonjour {{saito.n}}, tu es bien matinal."
msgstr "Guten Morgen, {{saito.n}}! Du bist früh wach."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_e300b9a4"
msgid "Ça ferait une bonne surprise à ma fille si c'était toi qui allais la réveiller."
msgstr "Es wäre eine schöne Überraschung für meine Tochter, wenn du es wärst, der sie heute weckt."

#. Character:`saito` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_1a4ac489"
msgid "Sûrement mais... je ne suis pas venu pour ça, auriez-vous vue {{noriko.n}} passer ce matin ?"
msgstr "Sicherlich, aber... deshalb bin ich nicht hier. Hast du zufällig {{noriko.n}} heute Morgen hier vorbeikommen sehen?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3ed7c8a3"
msgid "Oh oui ! Ce matin elle se dirigeait vers l'ancienne gare désaffectée."
msgstr "Oh, ja! Sie ist eben in Richtung des verlassenen Bahnhofs gelaufen."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3ba6c0a7"
msgid "D'ailleurs à ce sujet, j'ai eu des nouvelles de mon ancien collaborateur."
msgstr "Übrigens, wo wir gerade dabei sind, ich habe mit meinem ehemaligen Mitarbeiter geredet."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3664dd15"
msgid "Quand je lui ai posé la question, il a tout de suite reconnu de qui je parlais."
msgstr "Als ich ihn gefragt habe, wusste er sofort, von wem ich rede."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3c87d730"
msgid "Vraiment ? A-t-il vu quelque chose qui sort de l'ordinaire ?"
msgstr "Wirklich? Hat er irgendwas Ungewöhnliches gesehen?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_d77694a2"
msgid "... À vrai dire, il y a bien quelque chose."
msgstr "...Tatsächlich schon."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_d5702a65"
msgid "Elle semble traîner assez régulièrement avec 3 hommes un peu grossiers qui traînent souvent dans le coin."
msgstr "Sie scheint recht häufig mit den drei unhöflichen Typen, die hier häufiger mal sind, abzuhängen."

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_32742a34"
msgid "Trois hommes vous dites..."
msgstr "Drei Typen sagst du..."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_f255feac"
msgid "Malheureusement, il n'a pas pu m'en dire davantage."
msgstr "Mehr konnte er mir leider nicht sagen."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_30026855"
msgid "Je comprends... Merci pour votre... ton aide."
msgstr "Ich verstehe... Danke für deine... deine Hilfe."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_bc298068"
msgid "Fais attention à elle {{saito.n}}. Ils ne m'inspirent pas confiance."
msgstr "Kümmer dich gut um sie, {{saito.n}}. Ich vertraue denen nicht."

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_9ad1c2bf"
msgid "Moi non plus, je vais m'en occuper."
msgstr "Ich auch nicht. Ich schaffe das schon."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_4b1649a0"
msgid "Bonsoir {{saito.n}}, tu as besoin de quelque chose ?"
msgstr "Hallo, {{saito.n}}! Brauchst du etwas?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_96d2cfce"
msgid "Bonsoir {{sayuri.n}}, j'étais simplement venu prendre de quoi manger avant de rentrer chez moi."
msgstr "Hallo, {{sayuri.n}}. Ich bin nur gekommen, um schnell etwas Essen zu kaufen, bevor ich nach Hause gehe."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_14c850b2"
msgid "Laisse-moi te l'offrir dans ce cas..."
msgstr "In dem Fall geht das Essen aufs Haus..."

#. Character:`saito` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_f60c5a3b"
msgid "Ce n'est pas nécessaire vous savez, j'ai de quoi p-"
msgstr "Das ist nicht nötig, weißt du! Ich habe genug, um zu zah-"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2bdd416f"
msgid "Arrête un peu... Laisse-moi te remercier à ma façon de prendre soin de ma fille."
msgstr "Sag nichts... Lass mich dir dafür danken, dass du dich um meine Tochter kümmerst."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b43c820e"
msgid "Très bien j'accepte alors."
msgstr "Wie du meinst. Dann akzeptiere ich das mal."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a4c6c66f"
msgid "Ce serait dommage de refuser un cadeau de ma future belle-mère c'est ça ?"
msgstr "Es wäre eine Schande, ein Geschenk von deiner zukünftigen Schwiegermutter abzulehnen, nicht wahr?"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2846bc20"
msgid "Oh mais c'est que tu comprends vite !"
msgstr "Oh, das hast du jetzt gesagt!"

#. Character:`noriko` | Attributes:`cute`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b9ab7872"
msgid "Bonsoir madame..."
msgstr "Guten Abend, Madame..."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_de757a92"
msgid "{{sayuri.SPELLOUT}} !"
msgstr "{{sayuri.SPELLOUT}}!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_89467128"
msgid "Désolée, je n'ai pas vraiment l'habitude..."
msgstr "Entschuldigung... Ich bin das einfach nicht gewohnt..."

#. Character:`kenji`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_624bd72c"
msgid "[font_size=34]{{saito.n}} le déchet ! Je sais que t'es là, sors d'ici ou c'est moi qui viens te chercher.[/font_size]"
msgstr "[font_size=34]{{saito.n}}, der Idiot! Ich weiß, dass du hier bist! Komm raus oder ich hole dich![/font_size]"

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3960521c"
msgid "Bon sang encore un de ces foutus idiots."
msgstr "Noch einer von diesen verdammten Idioten."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_22e372c0"
msgid "Reste là {{saito.n}}, je vais passer un coup de téléphone à la police de quartier et ils interviendront rapidement."
msgstr "Bleib hier, {{saito.n}}. Ich rufe die Polizei an, die werden sich schnell darum kümmern."

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_efd1ea6e"
msgid "Non...[w] Je m'en charge."
msgstr "Nein...[w] Ich schaffe das schon."

#. Character:`noriko`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_f58b1eb6"
msgid "Tu vas te faire refaire le portrait..."
msgstr "Die werden dich völlig zusammenschlagen..."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_0b281b81"
msgid "Ça te plairait de voir ça hein..."
msgstr "Das würdest du dir also gerne ansehen?"

#. Character:`noriko` | Attributes:`shame`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a1e2b777"
msgid "Quoi ?! Non ! Je..."
msgstr "Was?! Nein! Ich..."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_0327ff32"
msgid "S'il te plaît {{saito.n}}, sois prudent et ne fais rien d'inconsidéré."
msgstr "Bitte, {{saito.n}}, sei vorsichtig. Tu nichts Unüberlegtes."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_3149c73a"
msgid "Il faudra qu'on discute toi et moi {{noriko.n}} après tout ça."
msgstr "Wir zwei müssen nach dem hier mal ein Wörtchen reden, {{noriko.n}}."

#. Character:`noriko` | Attributes:`bad`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_aeaa5445"
msgid "Et qu'est ce que tu comptes faire exactement ? Tu vas te mettre en colère ?"
msgstr "Und was genau hast du vor? Willst du etwa wütend werden?"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_a994ce0f"
msgid "C'est ça le truc {{noriko.n}}, je suis toujours en colère."
msgstr "In Wahrheit, {{noriko.n}} ... bin ich einfach immer wütend."

#. Character:`noriko` | Attributes:`shame`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_898b1990"
msgid "..."
msgstr "..."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_7b58153d"
msgid "J'espère que tout ira bien pour lui..."
msgstr "Ich hoffe, dass für ihn alles gut geht..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_61aa192b"
msgid "... eh bien il semble que tu as de la chance."
msgstr "...Wow, sieht so aus, als hättest du den Jackpot gewonnen."

#. Character:`yasuka`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_3c5f45b1"
msgid "Oui ![w] Ça me fait énormément plaisir, ça faisait longtemps qu'on n'avait pas discuté toutes les deux comme ça."
msgstr "Ja![w] Ich freue mich so sehr. Es ist Urzeiten her, dass wir uns mal so unterhalten haben."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_451d468e"
msgid "Je ne savais même pas qu'{{asami.n}} était ta fille !"
msgstr "Ich hatte ja keine Ahnung, dass {{asami.n}} deine Tochter ist!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_47801297"
msgid "Mais maintenant je me rends compte à quel point j'ai été aveugle."
msgstr "Aber jetzt realisiere ich, wie blind ich war."

#. Character:`yasuka`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_469b1be1"
msgid "C'est ton portrait craché."
msgstr "Sie ist dir praktisch aus dem Gesicht geschnitten."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_c61c9f1b"
msgid "Les chiens ne font pas des chats comme on dit."
msgstr "Der Apfel fällt nicht weit vom Stamm, heißt es doch."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_b7613b0a"
msgid "{{saito.n}} a vraiment eu une bonne influence sur elle aussi."
msgstr "{{saito.n}} war ein auf sie auch wirklich ein guter Einfluss."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_94fa3189"
msgid "Il n'y a pas si longtemps elle me rendait folle."
msgstr "Bis vor Kurzem hat sie mich noch in den Wahnsinn getrieben."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_e7c09753"
msgid "Ne m'en parle pas, j'avais le même problème avec {{noriko.n}}."
msgstr "Erzähl mir davon. Ich hatte dasselbe Problem mit {{noriko.n}}."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_70e002d0"
msgid "D'ailleurs il ne faut pas que je tarde, ils doivent m'attendre, on va fêter ça ensemble !"
msgstr "Ich sollte nicht zu lange bleiben. Sie warten sicher schon auf mich. Wir feiern gleich zusammen!"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_0c84bddc"
msgid "Il faudra que vous veniez tous à l'occasion, qu'on puisse tous passer une soirée ensemble."
msgstr "Du solltest beizeiten mal vorbeikommen, damit wir mal in Ruhe einen Abend zusammen verbringen können."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_e64da86f"
msgid "Avec plaisir !"
msgstr "Mit Vergnügen!"

#. Character:`yasuka`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_b348bebc"
msgid "Allez bon courage et à bientôt !"
msgstr "Pass auf dich auf, bis bald!"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_2fbe45d8"
msgid "C'est bon ! J'ai récupéré ce qu'il vous devait !"
msgstr "Ist okay! Ich habe, was er dir schuldet, dabei!"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_15805226"
msgid "Oh {{saito.n}}, merci mais il ne fallait pas te mettre en danger pour une somme pareille tu sais..."
msgstr "Oh, {{saito.n}}, danke! Aber du solltest dich nicht wegen so wenig Geld in Gefahr begeben, weißt du..."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_7725fc23"
msgid "Qu'est-ce que j'aurais dit à ma fille si à cause de moi il t'était arrivé quelque chose ?"
msgstr "Was sollte ich nur meiner Tochter erzählen, wenn dir meinetwegen etwas zugestoßen wäre?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_7dbeb66f"
msgid "Tout s'est bien passé je vous assure !"
msgstr "Es ist alles gutgegangen, das kann ich dir versichern!"

#. Character:`notice`
#: game/story/konbini_interior.dialogue
msgctxt "te23e1b8d53"
msgid "Vous avez donné l'argent à {{sayuri.n}}"
msgstr "Du gibst {{sayuri.n}} das Geld."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b8094ed7"
msgid "Une seconde..."
msgstr "Warte..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_9fc376dc"
msgid "Il y a bien plus que prévu."
msgstr "Das ist viel zu viel."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_9ca535b5"
msgid "Gardez-le, ce n'est sûrement pas la première fois qu'il vous fait ce coup-là."
msgstr "Behalt es. Das ist wahrscheinlich nicht das erste Mal, dass er das getan hat."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_db36a0ac"
msgid "Non, en effet."
msgstr "Nein, da hast du Recht."

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_012d38c6"
msgid "...[w] Tu es un amour !"
msgstr "...[w]Du bist ein Schatz!"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_b4e27a3c"
msgid "Je vous en prie, c'était normal."
msgstr "Bitte, mach kein großes Ding daraus."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_44ce225c"
msgid "Au fait ! Tu devrais passer voir {{asami.n}}, je crois qu'elle était inquiète."
msgstr "Übrigens! Du solltest nach {{asami.n}} sehen. Ich glaube, sie macht sich Sorgen."

#. Character:`saito` | Attributes:`guilty`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_1746ad5a"
msgid "Inquiète à propos de quoi ?"
msgstr "Worüber macht sie sich denn Sorgen?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_0729f33c"
msgid "Il se pourrait que je lui ai raconté ce qu'il s'était passé hier soir."
msgstr "Ich habe ihr vielleicht davon erzählt, was letzte Nacht passiert ist."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_086c3bcd"
msgid "...C'est pas grave, je verrais ça avec elle."
msgstr "...Das spielt keine Rolle. Ich werde mit ihr reden."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "menu_sayuri_konbini_1f160de3"
msgid "J'y vais à bientôt {{sayuri.n}} !"
msgstr "Bis dann, {{sayuri.n}}."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_4d1f1162"
msgid "Qu'est-ce que tu fais là ma chérie ça ne te ressemble pas ?"
msgstr "Was machst du hier, meine Liebe? Das schickt sich nicht für dich."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_74698715"
msgid "Tu n'es pas avec {{saito.n}} ?"
msgstr "Ist {{saito.n}} gar nicht bei dir?"

#. Character:`asami` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_19a610e5"
msgid "Non en ce moment il passe tout son temps avec {{noriko.n}}..."
msgstr "Nein, dieser Tage verbringt er seine ganze Zeit mit {{noriko.n}}..."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_bf52f3d4"
msgid "Et ils n'ont pas besoin de moi."
msgstr "Und sie scheinen mich nicht zu brauchen."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_f3d01191"
msgid "Ohh ma petite puce est jalouse..."
msgstr "Oh, mein kleines Baby ist eifersüchtig..."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_d7bb846a"
msgid "...Moi aussi j-"
msgstr "...Ich möchte außerdem-"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_9d71aca3"
msgid "Et bien tu vois, quand on parle du loup !"
msgstr "Na, wenn man vom Teufel spricht!"

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_92a3063d"
msgid "Maman !!!"
msgstr "Mamaaaa!"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_e956b7e3"
msgid "Tout va bien ?"
msgstr "Ist alles in Ordnung?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_b73e4318"
msgid "Et bien en fait figure toi que..."
msgstr "Na ja, tatsächlich..."

#. Character:`asami` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_014c009b"
msgid "MAMAN STOP !"
msgstr "MAMA, LASS DAS!"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_abc4c7f4"
msgid "C'est bon j'ai compris je vous laisse entre vous."
msgstr "In Ordnung, hab’s verstanden. Ich lass dich schon alleine."

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_6bc5849a"
msgid "...{{noriko.n}} n'est pas avec toi ?"
msgstr "...Ist {{noriko.n}} gar nicht bei dir?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_77f23413"
msgid "Si si, elle attend dehors."
msgstr "Ist sie. Sie wartet draußen."

#. Character:`asami` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_a2df6564"
msgid "Vous êtes toujours dans votre projet de vengeance contre..."
msgstr "Du planst immer noch deinen Rachefeldzug gegen..."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_3e85771d"
msgid "Oui..."
msgstr "Ja ..."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_9c9606c1"
msgid "C'est bientôt terminé, il en manque un, les autres sauront qu'à l'avenir je ne serai plus une cible facile."
msgstr "Er ist fast vorbei. Einer fehlt noch und die anderen werden dann endlich kapieren, dass mit mir nicht zu spaßen ist."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_7e7b2940"
msgid "Ils y réfléchiront à deux fois avant de s'en prendre à moi."
msgstr "Sie werden zweimal darüber nachdenken, ob sie sich mit mir anlegen wollen."

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_c758ffb8"
msgid "Je ne sais pas pourquoi mais j'ai peur que tout ça se termine mal..."
msgstr "Ich weiß nicht, warum, aber ich habe Angst, dass das alles hier eine böse Wendung nimmt."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_754e585a"
msgid "...Ne t'inquiète pas, je fais attention à moi et je ne fais rien dans l'excès."
msgstr "...Mach dir keine Sorgen, ich passe schon auf mich auf und tue nichts zu Gewagtes."

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_1927ceb6"
msgid "Je préférerais qu'on passe plutôt notre journée ensemble quand même."
msgstr "Ich würde es vorziehen, wenn wir stattdessen unseren Tag gemeinsam verbringen würden."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_a2a3ce27"
msgid "Promis dès que j'en ai terminé avec ça, on sera rien que toi et moi !"
msgstr "Ich verspreche dir, sobald ich hier fertig bin, gibt es nur noch dich und mich!"

#. Character:`asami` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_a5353bca"
msgid "Promis ?"
msgstr "Versprochen?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_a6b143ac"
msgid "Promis !"
msgstr "Versprochen!"

#. Character:`asami` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "konbini_interior_4efd7efa"
msgid "Alors dépêche-toi et fais attention à toi !"
msgstr "Dann beeil dich und pass auf dich auf!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t6c7d969cf9"
msgid "Mon dieu c'est d'un ennui..."
msgstr "Mein Gott, das ist so langweilig ..."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "t6c331918d3"
msgid "Tout le monde a décidé de partir en vacance sauf moi je crois..."
msgstr "Ich glaube, jeder außer mir hat sich entschlossen, in den Urlaub zu fahren ..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "ta6d9455a9d"
msgid "Allez ma vielle, prend ton mal en patience, les choses vont s'arranger !"
msgstr "Komm schon, alte Frau, sei geduldig! Es wird wieder besser werden!"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t204a3e6b27"
msgid "..."
msgstr "..."

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "ta7bfc76e36"
msgid "......"
msgstr "......"

#. Character:`narrator`
#: game/story/konbini_interior.dialogue
msgctxt "t3bbd1a1d60"
msgid "........."
msgstr "........."

#. Character:`sayuri` | Attributes:`depressed`
#: game/story/konbini_interior.dialogue
msgctxt "t96081ec5f7"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "tccb4bfa32a"
msgid "Ca ne va pas ?"
msgstr "Was ist los?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "t0d9feb1588"
msgid "La reprise du travail est difficile ?"
msgstr "Ist es hart, wieder zu arbeiten?"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "tff5ad7b1c3"
msgid "Si ce n'était que ça..."
msgstr "Wenn es nur so einfach wäre ..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "tc17f859a71"
msgid "J'ai bien eu la confirmation que l'assistante de mon m... de ce connard avait une relation depuis des années."
msgstr "Ich habe bestätigt bekommen, dass die Assistentin meines M... dieses Arschlochs seit Jahren eine Affäre hatte."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "ted8e6d7c93"
msgid "Avoir des doutes est une chose mais... en avoir la confirmation..."
msgstr "Zweifel zu haben, ist das eine, aber ... sie bestätigt zu bekommen ..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t3512d7f59c"
msgid "J'ai l'impression d'avoir été stupide pendant si longtemps !"
msgstr "Ich fühle mich, als wäre ich die ganze Zeit so blind gewesen!"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "t1b44c5832b"
msgid "Ne soit pas si dure avec toi même..."
msgstr "Sei nicht so hart zu dir ..."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "t2dccfdcd96"
msgid "Vois ça du bon coté !"
msgstr "Denk an die gute Seite!"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "t0bd164fcde"
msgid "Il y a un bon coté ?"
msgstr "Es gibt eine gute Seite?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "t3ba2f1932e"
msgid "Tu peux désormais vivre ta vie sans culpabilité."
msgstr "Jetzt kannst du dein Leben fern von jeden Schuldgefühlen leben."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "tc9ba34b532"
msgid "Oui... J'ai eu l'impression qu'un poids avait été enlevé de mes épaules."
msgstr "Ja ... Ich fühle mich, als sei eine große Last von meinen Schultern gefallen."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t3fddfee84a"
msgid "C'est pour ça que pour fêter ça je nous ai réservé une chambre au love hôtel, rien que pour toi et moi !"
msgstr "Deswegen habe ich uns zur Feier ein Zimmer im Stundenhotel gebucht. Nur für dich und mich!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "t2e1b74f9b7"
msgid "Oh ! Vraiment ?"
msgstr "Oh! Wirklich?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t271d3f52d6"
msgid "Et cette fois ci je n'aurais plus ce petit sentiment de culpabilité, je vais pouvoir me lâcher !"
msgstr "Und dieses Mal werde ich nicht diesen kleinen Rest der Schuld verspüren, ich kann endlich loslassen!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/konbini_interior.dialogue
msgctxt "t38854292d1"
msgid "Je dois avoir peur ?"
msgstr "Muss ich Angst haben?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t3ba68e83e7"
msgid "Peut-être...."
msgstr "Vielleicht ..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "tb78625f7db"
msgid "Rendez-vous au Love Hôtel ce soir !"
msgstr "Wir sehen uns heute Nacht beim Stundenhotel!"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "ta9a95c3bb4"
msgid "Interdiction de me poser un lapin !"
msgstr "Lass mich nicht hängen!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/konbini_interior.dialogue
msgctxt "tb35ae9e090"
msgid "C'est pas mon genre !"
msgstr "Das würde ich nie tun!"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "t187b7195f5"
msgid "Qu'est ce que tu comptes faire à présent ?"
msgstr "Was hast du jetzt vor?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "te2a9d828d8"
msgid "Penser à moi; rien qu'a moi sans culpabilité !"
msgstr "Denk an mich. Nur an mich, ohne Schuldgefühle!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t3932fc78bf"
msgid "Je vais pouvoir me lâcher !"
msgstr "Ich kann endlich loslassen!"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "t7d858c20c1"
msgid "Préviens moi si tu veux de la compagnie !"
msgstr "Lass es mich wissen, wenn dir nach Gesellschaft ist!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t204fa7fa96"
msgid "Avec plaisir mais d'abord je vais vais me faire un plaisir de dégager toutes ses affaires de la maison !"
msgstr "Mit Vergnügen, aber zuerst werde endlich all diesen Krempel aus diesem Haus werfen!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "t5423db499c"
msgid "Passe me voir demain matin, j'aurais des nouvelles d'{{asami.n}} !"
msgstr "Komm morgen nochmal vorbei. Dann habe ich Neuigkeiten von {{asami.n}}!"

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "tfe2f2a9b93"
msgid "Pas de problème !"
msgstr "Kein Problem!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "OH_BONJOUR_E87C47"
msgid "... Oh, bonjour..."
msgstr "... Oh, hallo ..."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "NOUS_AVONS_COLL_DES_AFFICHES_A_C98459"
msgid "Nous avons collé des affiches avec le portrait d'{{asami.n}} partout en ville."
msgstr "Wir hängen Poster mit Bildern von {{asami.n}} in der ganzen Stadt auf."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "AVEC_UN_PEU_DE_CHANCE_PEUT_TRE_B32713"
msgid "Avec un peu de chance, peut-être que... quelqu'un aura vu quelque chose..."
msgstr "Mit etwas Glück ... weiß jemand da draußen mehr als wir ..."

#. Character:`noriko`
#: game/story/konbini_interior.dialogue
msgctxt "EST_CE_QU_ON_PEUT_METTRE_UNE_A_5938D7"
msgid "Est-ce qu'on peut mettre une affiche sur la vitrine ?"
msgstr "Können wir ein Poster ans Fenster kleben?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "JE_BIEN_S_R_ALLEZ_Y_413C46"
msgid "Je... Bien sûr... allez-y."
msgstr "Ich ... natürlich ... sehr gerne."

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "EXCUSEZ_MOI_J_AI_TELLEMENT_LA_1B5A31"
msgid "Excusez-moi... J'ai tellement la tête ailleurs."
msgstr "Verzeih mir ... ich bin gerade einfach nicht ganz bei mir."

#. Character:`saito` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "TU_N_AS_PAS_T_EXCUSER_VU_LA_SI_70E734"
msgid "Tu n'as pas à t'excuser, vu la situation."
msgstr "Du musst dich angesichts dieser Situation für gar nichts entschuldigen."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "JE_N_ARR_TE_PAS_D_IMAGINER_LE_BB94C9"
msgid "Je n'arrête pas d'imaginer le pire et..."
msgstr "Ich stelle mir nur immer zu das Schlimmste vor und ..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "CET_INSPECTEUR_DE_LA_POLICE_NE_329130"
msgid "Cet inspecteur de la police ne m'aide pas à aller mieux."
msgstr "Dieser Polizist hat mir auch nicht unbedingt geholfen, dass ich mich besser fühle."

#. Character:`noriko`
#: game/story/konbini_interior.dialogue
msgctxt "COMMENT_A_438782"
msgid "Comment ça ?"
msgstr "Was meinst du?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "IL_IL_M_A_DIT_DE_ME_PR_PARER_A_D83FBB"
msgid "Il... il m'a dit de me préparer au pire et... et... et... de commencer à accepter le fait qu'elle serait déjà probablement...[w] morte..."
msgstr "Er ... Er hat mir gesagt, ich solle mich auf das Schlimmste vorbereiten und ... und ... und ... akzeptieren, dass sie wahrscheinlich schon ... [w]tot ist."

#. Character:`noriko` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "MAIS_QUELLE_PUTAIN_D_ORDURE_IL_3D2AF4"
msgid "Mais quelle putain d'ordure ! Ils ont à peine commencé leur enquête et n'ont encore rien fait !"
msgstr "Dieser widerliche Drecksack! Die haben doch noch nicht mal angefangen, zu suchen!"

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "NORIKO_N_CALME_TOI_A2BE79"
msgid "{{noriko.n}}, calme-toi !"
msgstr "{{noriko.n}}, beruhig dich!"

#. Character:`noriko`
#: game/story/konbini_interior.dialogue
msgctxt "QUOI_NON_JE_REFUSE_DE_ME_CALME_158577"
msgid "Quoi ?! Non ! Je refuse de me calmer ! Ce type mériterait que..."
msgstr "Was?! Nein! Ich beruhige mich ganz bestimmt nicht! Dieser Wichser verdient ..."

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "NORIKO_N_TA_R_ACTION_ME_FAIT_0E4FCE"
msgid "{{noriko.n}}, ta réaction me fait du bien, j'ai ressenti exactement la même chose..."
msgstr "{{noriko.n}}, deine Reaktion heitert mich ein wenig auf ... ich habe mich genauso gefühlt ..."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "MAIS_PLUS_LE_TEMPS_PASSE_ET_PL_988B5F"
msgid "Mais plus le temps passe, et plus je..."
msgstr "Je mehr Zeit vergeht, desto eher glaube ich–"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "NON_JE_REFUSE_D_ABANDONNER_73B2E8"
msgid "Non, je refuse d'abandonner !"
msgstr "Nein, ich gebe nicht auf. Niemals!"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "JE_VAIS_CONTINUER_CHERCHER_ET_899FEA"
msgid "Je vais continuer à chercher et à y croire."
msgstr "Ich werde weitersuchen und die Hoffnung nicht verlieren."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "JE_SUIS_S_R_QU_ELLE_EST_L_QU_E_53B413"
msgid "Je suis sûr qu'elle est là, qu'elle nous attend ! Qu'elle croit en nous !"
msgstr "Ich bin mir sicher, wir werden sie finden! Sie vertraut auf uns!"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "EXACTEMENT_ON_NE_L_CHERA_RIEN_837771"
msgid "Exactement ! On ne lâchera rien !"
msgstr "Genau! Wir werden nicht verzagen!"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "W_VOUS_TES_DES_AMOURS_C3D4F0"
msgid "...[w] Vous êtes des amours !"
msgstr "... [w]Ihr seid so lieb!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "JE_SAIS_QUE_VOUS_AVEZ_D_J_FAIT_90F32C"
msgid "Je sais que vous avez déjà fait beaucoup mais... {{saito.n}}... Est-ce que..."
msgstr "Ich weiß, du hast schon eine Menge getan, aber ...{{saito.n}} ... würdest du ..."

#. Character:`noriko`
#: game/story/konbini_interior.dialogue
msgctxt "JE_VAIS_ATTENDRE_DEHORS_C2C7C5"
msgid "Je vais attendre dehors !"
msgstr "Ich warte draußen!"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "D_ACCORD_MERCI_39BCE8"
msgid "D'accord, merci."
msgstr "Okay, danke."

#. Character:`sayuri` | Attributes:`depressed`
#: game/story/konbini_interior.dialogue
msgctxt "JE_NE_DORS_PLUS_ENTRE_LA_TRIST_3BC3A2"
msgid "Je... ne dors plus... entre la tristesse, le stress et les angoisses, j'ai l'impression que mon esprit est en train de lâcher."
msgstr "Ich ... kann kaum ein Auge zudrücken ... Bei all der Trauer, dem Stress und dieser furchtbaren Angst bleibt leider der Schlaf auf der Strecke."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "TU_ACCEPTERAIS_DE_DORMIR_AVEC_D6118F"
msgid "Tu accepterais de dormir avec moi ce soir ?"
msgstr "Würdest du heute Nacht vielleicht bei mir schlafen?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "TU_ACCEPTERAIS_DE_DORMIR_LA_MA_9DD35B"
msgid "Tu accepterais de dormir à la maison ce soir ?"
msgstr "Würdest du heute Nacht vielleicht bei mir zu Hause übernachten?"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "JUSTE_TA_PR_SENCE_ME_SUFFIRAIT_4E5BA7"
msgid "Juste ta présence me suffirait... s'il te plaît..."
msgstr "Deine Anwesenheit würde schon genügen ... bitte ..."

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "BIEN_S_R_TOUT_CE_QUE_TU_VOUDRA_8A95E8"
msgid "Bien sûr ! Tout ce que tu voudras !"
msgstr "Natürlich! Ich würde alles für dich tun!"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "MERCI_138A8F"
msgid "Merci..."
msgstr "Danke ..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "LAISSE_MOI_FERMER_ET_JE_TE_REJ_B1F8D3"
msgid "Laisse-moi fermer et je te rejoins !"
msgstr "Lass mich den Laden nur schnell schließen und dann komme ich!"

#. Character:`netoru`
#: game/story/konbini_interior.dialogue
msgctxt "ET_JE_SUIS_SINC_REMENT_D_SOL_ABB8CD"
msgid "... et je suis sincèrement désolé pour votre fille."
msgstr "... und das mit deiner Tochter tut mir wirklich leid."

#. Character:`netoru` | Attributes:`bad`
#: game/story/konbini_interior.dialogue
msgctxt "S_IL_Y_A_QUOI_QUE_CE_SOIT_QUE_A0DEEF"
msgid "S'il y a quoi que ce soit que je puisse faire pour vous, n'hésitez pas à me demander."
msgstr "Falls es irgendwas gibt, was ich tun kann, sag bitte Bescheid."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "JE_MERCI_1D4B90"
msgid "Je... merci."
msgstr "Ich ... Danke."

#. Character:`netoru`
#: game/story/konbini_interior.dialogue
msgctxt "J_AIMERAIS_BEAUCOUP_VOUS_INVIT_8BCB7A"
msgid "J'aimerais beaucoup vous inviter à boire un café, je suis sûr que cela vous fera le plus grand b-"
msgstr "Ich würde dich liebend gerne mal auf einen Kaffee einladen. Ich bin mir sicher, das würde d–"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "CARTE_TOI_D_ELLE_ELLE_N_ACCEP_E4334F"
msgid "Écarte-toi d'elle ! Elle n'accepte rien de toi, tu n'as que de mauvaises intentions."
msgstr "Lass dich Finger von ihr! Sie wird von dir nichts annehmen. Du hast nur widerliche Absichten."

#. Character:`netoru` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "TOI_3FEEC3"
msgid "Toi..."
msgstr "Du ..."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "SAITO_N_QUE_SE_PASSE_T_IL_JE_B855B0"
msgid "{{saito.n}}, que se passe-t-il ? Je ne t'ai jamais vu aussi énervé !"
msgstr "{{saito.n}}, was ist hier los? Ich habe dich noch nie so wütend gesehen!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/konbini_interior.dialogue
msgctxt "JE_NE_SOUHAITE_CAUSER_AUCUN_PR_37C833"
msgid "Je ne souhaite causer aucun problème ici, encore une fois je suis là si besoin, ma proposition tient toujours."
msgstr "Ich will keinen Ärger verursachen. Ich bin mal wieder hier, falls ich gebraucht werde. Mein Angebot steht noch."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "OH_ET_UNE_DERNI_RE_CHOSE_FAITE_C548B8"
msgid "Oh, et une dernière chose, faites attention à lui, il n'est pas ce qu'il prétend être. Prenez soin de vous."
msgstr "Oh und eine letzte Sache. Behalt ihn im Auge. Er ist nicht, wer er vorgibt zu sein. Pass auf dich auf."

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "QUELLE_ORDURE_6C2E26"
msgid "Quelle ordure..."
msgstr "Was für ein Arschloch ..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "TU_M_EXPLIQUES_CE_QU_IL_SE_PAS_A4A119"
msgid "Tu m'expliques ce qu'il se passe ?"
msgstr "Kannst du mir bitte erzählen, was hier los ist?"

#. Character:`saito` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "JE_C_EST_DIFFICILE_EXPLIQUER_E_3AB609"
msgid "Je... c'est difficile à expliquer, et je n'aimerais pas donner de faux espoirs avant d'être sûr de t'en parler."
msgstr "... Das ist schwer zu erklären und ich will dir keine falschen Hoffnungen machen, bevor ich mir nicht sicher genug bin."

#. Character:`saito` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "JE_VEUX_JUSTE_QUE_TU_ME_PROMET_64ECEB"
msgid "Je veux juste que tu me promettes une chose. N'accepte rien à boire venant de lui, ce type est dangereux."
msgstr "Ich will nur, dass du mir eine Sache versprichst. Trink nichts, was er dir anbietet – er ist gefährlich."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "PFFF_SI_CE_N_EST_QUE_A_JE_N_A_304FFE"
msgid "... Pfff, si ce n'est que ça... je n'avais pas l'intention d'accepter sa proposition de toute façon, mais c'est compliqué de remballer quelqu'un de courtois."
msgstr "... Tsss, wenn das alles ist ... Ich hatte ohnehin nicht die Absicht, sein Angebot zu akzeptieren, aber dennoch ist es schwierig eine so zuvorkommende Person zurückzuweisen."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "DIS_MOI_PLUT_T_CE_QUE_TU_AS_EN_3B444E"
msgid "Dis-moi plutôt ce que tu as en tête. C'est quoi cette histoire de faux espoirs ?!"
msgstr "Sag mir, was dich beschäftigt. Was hat es mit dieser ganzen falschen Hoffnung auf sich?!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "JE_TE_PROMET_DE_TOUT_TE_RACONT_873488"
msgid "Je te promet de tout te raconter mais là je dois absolument suivre cet homme."
msgstr "Ich verspreche dir, dass ich dir alles erzählen werde, aber im Moment muss ich diesem Mann unbedingt folgen."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "JE_PENSE_SINCEREMENT_QU_IL_EST_B53258"
msgid "Je pense sincerement qu'il est lié a la disparition d'{{asami.n}} justement."
msgstr "Ich glaube, dass er etwas mit {{asami.n}}s Verschwinden zu tun hat."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "QUOI_CELUI_QUI_A_VOULU_M_OFFRI_23FED8"
msgid "Quoi ?! Celui qui a voulu m'offrir un café ?"
msgstr "Was?! Der Typ, der mir einen Kaffee kaufen wollte?"

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "OUI_96DBEF"
msgid "Oui."
msgstr "Ja."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "W_JE_VAIS_LE_TUER_3A7860"
msgid "...[w] Je vais le tuer !"
msgstr "... [w]Ich brin ihn um!"

#. Character:`saito` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "NOUS_TIONS_EN_TRAIN_DE_LE_SUIV_D17324"
msgid "Nous étions en train de le suivre justement, mais j'avais peur qu'il s'en prenne à toi..."
msgstr "Wir haben ihn verfolgt, aber ich hatte Angst, dass er es auf dich abgesehen hatte ..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "JE_DOIS_ME_D_P_CHER_D_AILLEURS_F263E8"
msgid "Je dois me dépêcher d'ailleurs, sinon on le perdra de vue."
msgstr "Ich muss mich beeilen, sonst verlieren wir ihn aus den Augen."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "DANS_CE_CAS_JE_VIENS_529848"
msgid "Dans ce cas je viens."
msgstr "Dann komme ich mit."

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "D_ACCORD_6B92B6"
msgid "... D'accord."
msgstr "... In Ordnung."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "C_EST_ENFIN_TERMIN_1CC42C"
msgid "C'est enfin terminé !"
msgstr "Es ist endlich vorbei!"

#. Character:`sayuri` | Attributes:`depressed`
#: game/story/konbini_interior.dialogue
msgctxt "UNE_JOURN_E_DE_PLUS_OU_DE_MOIN_0462BB"
msgid "Une journée de plus ou de moins... Quelle importance."
msgstr "Ein Tag mehr oder weniger ... Welche Rolle spielt das schon?"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "SANS_MA_PETITE_CH_RIE_JE_N_AI_F1F6FE"
msgid "Sans ma petite chérie, je n'ai même plus envie de rentrer à la maison."
msgstr "Ohne meinen kleinen Liebling habe ich keine Lust mehr, nach Hause zu gehen."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "ET_MAINTENANT_C_EST_SAITO_QUI_71EBE5"
msgid "Et maintenant, c'est {{saito}} qui s'était si bien occupé de moi qui a des problèmes..."
msgstr "Und jetzt hat {{saito}}, der sich doch so gut um mich gekümmert hat, auch noch Probleme ..."

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "JE_DOIS_PORTER_MALHEUR_76B3B7"
msgid "Je dois porter malheur..."
msgstr "Ich muss verflucht sein ..."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "NON_JE_NE_DOIS_PAS_ME_MORFONDR_E28A88"
msgid "Non, je ne dois pas me morfondre ainsi. Demain, j'irai voir {{yasuka.n}} pour discuter de tout ça !"
msgstr "Nein, ich darf nicht aufgeben. Morgen werde ich zu {{yasuka.n}} gehen und mit ihr über all das reden!"

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "EN_ATTENDANT_IL_EST_TEMPS_DE_R_D7EC10"
msgid "En attendant, il est temps de rentrer."
msgstr "Es ist höchste Zeit, zurückzugehen."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "QU_EST_CE_QUI_TE_FAIS_SOURIRE_F6750C"
msgid "Qu'est-ce qui te fait sourire comme ça ?"
msgstr ""

#. Character:`asami` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "JE_REPENSAIS_UN_TYPE_QUI_M_OBS_90074C"
msgid "Je repensais à un type qui m'observait dans le parc tout à l'heure."
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "JE_LISAIS_TRANQUILLEMENT_A_L_O_4B4CCB"
msgid "Je lisais tranquillement à l'ombre sous un arbre. Et il y avait pleins de pétales de cerisiers qui tombaient..."
msgstr ""

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "UN_TYPE_LOUCHE_62EA2B"
msgid "Un type louche ?"
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "HONNETEMENT_DES_TROIS_QUE_J_AI_6DDC39"
msgid "Honnêtement, des trois que j'ai croisés dans le parc, c'était le plus normal."
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "J_AI_BIEN_VU_SON_REGARD_INSIST_CA9CB2"
msgid "J'ai bien vu son regard insistant donc je me suis levée et je lui ai demandé pourquoi il me regardait."
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "ET_IL_MA_SORTIT_CETTE_PHRASE_T_5EE161"
msgid "Et il m'a sorti cette phrase tellement ringarde..."
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "LA_SC_NE_QUE_J_AVAIS_SOUS_LES_F53DAF"
msgid "\"La scène que j'avais sous les yeux était vraiment belle...\""
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "BON_SANG_EB34A0"
msgid "Bon sang..."
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "TU_VOIS_TOI_AUSSI_TU_TROUVES_A_08D9A4"
msgid "Tu vois ? Toi aussi tu trouves ça nul."
msgstr ""

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "C_EST_TOI_QUI_EST_NULLE_IL_A_T_D99A4E"
msgid "C'est toi qui es nulle ! Il a été franc avec toi et toi tu te moques de lui..."
msgstr ""

#. Character:`sayuri` | Attributes:`depressed`
#: game/story/konbini_interior.dialogue
msgctxt "MA_FILLE_FINIRA_SEUL_AVEC_DES_3B4274"
msgid "Ma fille finira seule avec des chats c'est sûr..."
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "MAIS_MAMAN_ARR_TE_ME_PORTE_PAS_B8761F"
msgid "Mais maman arrête, me porte pas la poisse !!"
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "ALORS_MA_CH_RIE_TU_PASSES_UNE_ADC369"
msgid "Alors ma chérie ? Tu passes une bonne journée ?"
msgstr ""

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "TU_AS_PU_REVOIR_GAR_ON_OU_MIEU_8E8995"
msgid "Tu as pu revoir le garçon ? Ou mieux... pris son numéro pour ta chère mère ?"
msgstr ""

#. Character:`asami` | Attributes:`bored`
#: game/story/konbini_interior.dialogue
msgctxt "PFF_ARRETE_TU_N_ES_M_ME_PAS_DR_04F5E7"
msgid "Pff arrête... Tu n'es même pas drôle. Tu as l'âge d'être sa mère !"
msgstr ""

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "JE_TE_TROUVE_BIEN_INSOLENTE_ED4B18"
msgid "Je te trouve bien insolente."
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "HMPH_CA8BE7"
msgid "Hmph..."
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "POURQUOI_TU_BOUDES_ENCORE_D1BA67"
msgid "Pourquoi tu boudes encore ?"
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "JE_VIENS_D_ACCOMPAGNER_SAITO_N_A9A84B"
msgid "Je viens d’accompagner {{saito.n}} à son travail."
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "ET_MAINTENANT_JE_ME_RETROUVE_T_F91C72"
msgid "Et maintenant, je me retrouve toute seule à les imaginer tous les deux..."
msgstr ""

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "PARCE_QU_EN_PLUS_IL_TRAVAILLE_CF6F59"
msgid "Parce qu’en plus il travaille ? Ma chérie, il va falloir que tu me le présentes... Peut-être que..."
msgstr ""

#. Character:`asami` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "VOUS_ALLEZ_VOUS_CALMER_TOUT_DE_0155BB"
msgid "Vous allez vous calmer tout de suite, toutes les deux !"
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "IL_M_A_FAIT_LA_M_ME_BLAGUE_CRO_1ED27B"
msgid "Il m’a fait la même blague, à croire que vous avez le même âge !"
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "LE_M_ME_HUMOUR_EN_PLUS_IL_A_TO_73C1AA"
msgid "Le même humour en plus... Il a tout pour plaire, décidément !"
msgstr ""

#. Character:`asami` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "MAMAN_ARR_TE_JE_L_AI_VU_EN_PRE_8C23B6"
msgid "Maman, arrête ! Je l’ai vu en premier !"
msgstr ""

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "MAIS_TU_ES_TROP_MIGNONNE_QUAND_0180AD"
msgid "Mais tu es trop mignonne quand tu boudes..."
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "RACONTE_MOI_PLUT_T_COMMENT_C_T_D284D4"
msgid "Raconte-moi plutôt comment c’était."
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "C_TAIT_TROP_BIEN_ON_A_DISCUT_D_1A5A23"
msgid "C’était trop bien ! On a discuté de plein de choses !"
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "JE_SENS_QUE_LE_COURANT_PASSE_V_9B30BA"
msgid "Je sens que le courant passe vraiment bien entre nous, il ne me repousse pas comme le faisait {{minato.n}}."
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "IL_PLAISANTE_EN_RETOUR_AVEC_MO_F0D66D"
msgid "Il plaisante en retour avec moi. C’était vraiment agréable d’être avec lui..."
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "MA_PETITE_CH_RIE_SERAIT_ELLE_D_20CA1F"
msgid "Ma petite chérie serait-elle déjà en train de tomber amoureuse ?"
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "JE_JE_N_EN_SAIS_RIEN_PEUT_TRE_D2C966"
msgid "Je... Je n’en sais rien... Peut-être..."
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "ET_QU_EST_CE_QUI_SEMBLE_T_ENNU_055D2B"
msgid "Et qu’est-ce qui semble t’ennuyer comme ça ?"
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "JE_VIENS_DE_VOIR_QU_IL_TRAVAIL_C189B1"
msgid "Je viens de voir qu’il travaille avec une fille magnifique... Elle est grande, de longs cheveux, une peau parfaite, une poitrine encore plus grosse que la tienne... Et elle semble avoir des vues sur {{saito.n}} aussi."
msgstr ""

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "TU_AS_DONC_UNE_RIVALE_ED3ED7"
msgid "Tu as donc une rivale !"
msgstr ""

#. Character:`sayuri` | Attributes:`upset`
#: game/story/konbini_interior.dialogue
msgctxt "DANS_CE_CAS_IL_N_Y_A_PAS_TRENT_A75E1A"
msgid "Dans ce cas, il n’y a pas trente-six solutions : n’attends pas une seconde de plus ni qu’il fasse le premier pas, tu risquerais de le perdre."
msgstr ""

#. Character:`asami` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "MAIS_JE_NE_RESSEMBLE_RIEN_57740A"
msgid "Mais je ne ressemble à rien !"
msgstr ""

#. Character:`sayuri` | Attributes:`depressed`
#: game/story/konbini_interior.dialogue
msgctxt "BON_SANG_TU_ME_RENDS_FOLLE_CE_193DF0"
msgid "Bon sang... Tu me rends folle, ce n’est pas faute de te l’avoir dit !"
msgstr ""

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/konbini_interior.dialogue
msgctxt "VIENS_AVEC_MOI_ON_VA_PRENDRE_D_EE0BFD"
msgid "Viens avec moi ! On va prendre deux petites heures pour te trouver une tenue qui fera ressortir ton charme, il faut que tu aies toi aussi des arguments à lui opposer !"
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "MAIS_TES_TENUES_TOI_SONT_TROP_A55CDB"
msgid "Mais tes tenues à toi sont trop..."
msgstr ""

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "TROP_QUOI_B0E5AF"
msgid "Trop quoi ?"
msgstr ""

#. Character:`asami`
#: game/story/konbini_interior.dialogue
msgctxt "OS_ES_SI_JE_PORTE_CE_QUE_TU_PO_8127D2"
msgid "Osées ! Si je porte ce que tu portais plus jeune, je finirai presque les seins à l’air !"
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "FAIS_CONFIANCE_TA_M_RE_56A94A"
msgid "Fais confiance à ta mère !"
msgstr ""

#. Character:`asami` | Attributes:`sad`
#: game/story/konbini_interior.dialogue
msgctxt "C_EST_JUSTEMENT_POUR_A_QUE_JE_5D2933"
msgid "C’est justement pour ça que je m’inquiète..."
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "MAMAN_JE_TE_PR_SENTE_SAITO_N_E7E01C"
msgid "Maman, je te présente {{saito.n}}."
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "BONJOUR_MADAME_C_EST_FD56E4"
msgid "Bonjour, madame, c’est..."
msgstr ""

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "JE_T_ARR_TE_TOUT_DE_SUITE_C_ES_BC786A"
msgid "Je t’arrête tout de suite, c’est {{sayuri.n}}."
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "PAS_DE_MADAME_AVEC_MOI_TU_VEUX_A7862F"
msgid "Pas de « madame » avec moi, tu veux bien ?"
msgstr ""

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "D_ACCORD_DANS_CE_CAS_ENCHANT_S_3416A0"
msgid "D’accord, dans ce cas, enchanté, {{sayuri.n}}."
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "A_FAIT_PLAISIR_DE_POUVOIR_ENF_C678B1"
msgid "Ça fait plaisir de pouvoir enfin mettre un visage sur un nom."
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "MA_FILLE_NE_CESSE_DE_PARLER_DE_A0121B"
msgid "Ma fille ne cesse de parler de toi depuis plusieurs jours, je me demande bien ce que tu as pu lui faire ?"
msgstr ""

#. Character:`saito` | Attributes:`surprised`
#: game/story/konbini_interior.dialogue
msgctxt "MAIS_TU_ES_S_RE_QUE_C_EST_TA_M_1836A8"
msgid "Mais tu es sûre que c’est ta mère ? Elle ressemble plus à ta grande sœur..."
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "ARR_TE_NE_LA_PROVOQUE_PAS_168D3A"
msgid "Arrête, ne la provoque pas !"
msgstr ""

#. Character:`sayuri` | Attributes:`moved`
#: game/story/konbini_interior.dialogue
msgctxt "JE_L_AIME_D_J_36CA7A"
msgid "Je l’aime déjà !"
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "SI_TU_VEUX_VENIR_ME_VOIR_QUAND_5810A0"
msgid "Si tu veux venir me voir quand ma fille n’est pas là, n’hésite pas."
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "TU_VIENDRAS_DERRI_RE_LE_COMPTO_C3650D"
msgid "Tu viendras derrière le comptoir avec moi, je te montrerai les ficelles du métier."
msgstr ""

#. Character:`asami` | Attributes:`angry`
#: game/story/konbini_interior.dialogue
msgctxt "BON_A_SUFFIT_JE_SAIS_QUE_A_VOU_0F407F"
msgid "Bon, ça suffit ! Je sais que ça vous amuse de vous moquer de moi, mais maintenant, ça suffit !"
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/konbini_interior.dialogue
msgctxt "MAINTENANT_QUE_TU_L_AS_VU_TU_E_44977A"
msgid "Maintenant que tu l’as vu, tu es rassurée ?"
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
#: game/story/konbini_interior.dialogue
msgctxt "OUI_MA_CH_RIE_C_EST_BON_AMUSEZ_3DD459"
msgid "Oui, ma chérie, c’est bon. Amusez-vous bien !"
msgstr ""

#. Character:`sayuri`
#: game/story/konbini_interior.dialogue
msgctxt "TR_S_BIENT_T_SAITO_N_CB201C"
msgid "À très bientôt, {{saito.n}} !"
msgstr ""

#. Character:`saito`
#: game/story/konbini_interior.dialogue
msgctxt "BIENT_T_SAYURI_N_722DA0"
msgid "À bientôt, {{sayuri.n}} !"
msgstr ""

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_f311beff"
msgid "Qu'est-ce que vous espériez de lui au final ?"
msgstr "Das hast du denn von ihm erwartet?"

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_cdf20124"
msgid "... Aucune idée, le boss voulait qu'on le garde jusqu'à ce qu'il arrive."
msgstr "...Keine Ahnung. Der Boss wollte, dass wir ihn hier behalten bis er da ist."

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_3cebb35e"
msgid "Merde ! Tu lui as fait quelque chose ? Il ne bouge plus !"
msgstr "Scheiße! Was hast du mit ihm gemacht? Er bewegt sich nicht!"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_eccb1cd2"
msgid "Déstresse, tête de banane. Il a juste reçu un petit coup de pression."
msgstr "Jetzt scheiß dich mal nicht ein, Dummkopf. Er musste nur lernen, mit ein wenig... Druck umzugehen."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_aa80c769"
msgid "Il s'est évanoui, rien de plus."
msgstr "Er ist bewusstlos, das ist alles."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_70a680fd"
msgid "En plus, j'ai obtenu une petite info bonus que je ne m'attendais pas à trouver en venant ici."
msgstr "Außerdem habe ich eine kleine Bonusinformation bekommen, die ich nicht erwartet hatte."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_e6439395"
msgid "Sur ce, les gars, amusez-vous bien ! Oubliez pas d'effacer vos empreintes en cas de problème."
msgstr "Nun gut, habt Spaß, Jungs! Vergesst nicht, eure Fingerabdrücke zu beseitigen, falls es Schwierigkeiten gibt."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_52557881"
msgid "Tiens, tiens, tiens... Voilà donc notre petit rat."
msgstr "Na, wen haben wir denn da? Hier ist ja unsere kleine Ratte."

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_3df576e4"
msgid "J'ai toujours su que tu étais mauvais !"
msgstr "Ich habe schon immer gewusst, dass ihr hinterlistig seid!"

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_98a049e1"
msgid "Même derrière tes faux airs de Monsieur parfait."
msgstr "Auch hinter deiner geheuchelten Fassade."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_6adf1fe9"
msgid "Je suppose qu'une proie est toujours plus ou moins sensible à son prédateur naturel !"
msgstr "Ich schätze, die Beute hat ein Gespür für ihre natürlichen Fressfeinde!"

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_57924e73"
msgid "Je ne sais pas ce que tu as fait à {{chiaki.n}}, mais je te garantis qu-"
msgstr "Ich weiß nicht, was du mit {{chiaki.n}} angestellt hast, aber ich schwöre, wenn ich-"

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_da52dfa6"
msgid "Laisse tomber les menaces... tu es conscient que tu ne verras plus jamais la lumière du jour ?"
msgstr "Lass die Drohungen sein... Bist du dir darüber im Klaren, dass du niemals mehr das Tageslicht erblicken wirst?"

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_c29cd484"
msgid "Quoi ?! Tu vas me..."
msgstr "Was?! Du willst mich..."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_4995c916"
msgid "Moi ? Bien sûr que non voyons ! Mais eux, oui. Ils se feront une joie de mettre fin à tes jours..."
msgstr "Ich? Nein, natürlich nicht! Aber sie werden es tun. Die freuen sich schon darauf, deinem Leben ein Ende zu setzen..."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_80bdb5f1"
msgid "[font_size=14]Je crois qu'ils débutent donc il est fort probable qu'ils doivent s'y reprendre à plusieurs fois.[/font_size]"
msgstr "[font_size=14]Ich glaube, das ist ihr erstes Mal, also kann es gut sein, dass sie ein paar Versuche brauchen werden.[/font_size]"

#. Character:`kenji`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_1fd13d33"
msgid "[font_size=14]{{takeo.n}} c'est quoi ce bordel, on nous avait pas parlé de ça ![/font_size]"
msgstr "[font_size=14]{{takeo.n}}, was zur Hölle? Davon hat uns niemand erzählt![/font_size]"

#. Character:`nobu`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_d6734cdf"
msgid "[font_size=14]Non... C'est mort, je ne suis pas un tueur.[/font_size]"
msgstr "[font_size=14]Nein... Ich bin raus. Ich bin kein Mörder.[/font_size]"

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_aeab6393"
msgid "[font_size=14]Fermez vos gueules ![/font_size]"
msgstr "[font_size=14]Halt deine verdammte Fresse![/font_size]"

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_d60ae9dd"
msgid "POURQUOI ?! POURQUOI TU FAIS TOUT ÇA ? POURQUOI TU TORTURES TA PROPRE SŒUR ?! POURQUOI TU AS PRÉTENDU ÊTRE LE MEILLEUR POTE DE {{saito.N}} POUR FINALEMENT LE TRAHIR ?"
msgstr "WARUM?! WARUM TUT IHR DAS ALLES? WARUM FOLTERST DU DEINE EIGENE SCHWESTER?! WARUM HAST DU VORGEGEBEN, {{saito.N}}S BESTER FREUND ZU SEIN, NUR UM IHN AM ENDE ZU HINTERGEHEN?!"

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_c4ca6047"
msgid "Pourquoi... Pourquoi t'es aussi..."
msgstr "Warum... Warum bist du so..."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_45974442"
msgid "... méchant ?"
msgstr "...böse?"

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_f2079665"
msgid "NON ![w] CON ![w] POURQUOI T'ES AUSSI CON ?!"
msgstr "NEIN![w] DUMM![w] WARUM BIST DU SO DUMM?!"

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_83ffb293"
msgid "..."
msgstr "..."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_e1fb5aac"
msgid "[font_size=14]Et si je te disais que c'est parce que tout ça m'amuse, tu me croirais ?[/font_size]"
msgstr "[font_size=14]Ich habe dir doch erzählt, dass es mich einfach nur amüsiert. Glaubst du mir etwa nicht?[/font_size]"

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_e2560602"
msgid ".... AAAAAAAAAAAAAH !"
msgstr "...AAAAAAAAAAAAAH!"

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_cdf51a0f"
msgid "Vous me réglez son compte proprement, ne laissez pas bêtement des traces."
msgstr "Kümmert euch um ihn und seid nicht dumm genug, um irgendwelche Beweise zu hinterlassen."

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_89c60028"
msgid "On fera tout ce qui est nécessaire."
msgstr "Wir tun, was nötig ist."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_7750d1f8"
msgid "Appelle-moi quand vous l'aurez fait, tu recevras le virement."
msgstr "Ruft mich an, wenn ihr fertig seid, dann überweise ich euch das Geld."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_0021280f"
msgid "Ne me décevez pas !"
msgstr "Enttäuscht mich nicht!"

#. Character:`nobu`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_b8da96e2"
msgid "{{takeo.n}}... On va vraiment le faire ?"
msgstr "{{takeo.n}}... Machen wir das wirklich?"

#. Character:`kenji` | Attributes:`angry`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_2ecec0be"
msgid "C'est vrai bordel, on nous a jamais dit qu'on aurait à tuer quelqu'un !"
msgstr "Verdammt nochmal, uns hat niemals jemand gesagt, dass wir einen Menschen töten müssten!"

#. Character:`takeo` | Attributes:`angry`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_b15c456d"
msgid "Les mecs... Arrêtez de vous chier dessus ! On savait bien qu'en traînant avec lui, on serait obligés de se salir les mains un jour ou l'autre."
msgstr "Leute... Hört auf, euch einzuscheißen! Es war absehbar, dass wir uns früher oder später die Hände schmutzig machen müssten, wenn wir uns mit ihm abgeben."

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_5bea11b3"
msgid "Ça me fait chier autant que vous, mais...[w] si c'est pas lui, ce sera nous."
msgstr "Es kotzt mich genauso sehr an wie euch, aber...[w] Wenn wir ihn nicht erledigen, sind wir als nächstes dran."

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_578230c9"
msgid "On ne doit pas laisser de traces."
msgstr "Wir dürfen keine Spuren hinterlassen."

#. Character:`nobu`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_3f8ed7f1"
msgid "... et pourquoi pas utiliser de l'acide ?"
msgstr "...Warum nehmen wir keine Säure?"

#. Character:`nobu` | Attributes:`bad`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_ebd8f73a"
msgid "J'ai vu ça dans une série, ça marche vachement bien !"
msgstr "Ich habe das in einer Fernsehserie gesehen. Das klappt wirklich gut!"

#. Character:`kenji` | Attributes:`angry`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_548dbe39"
msgid "Et, tu vas le chercher où ton bidon d'acide ?"
msgstr "Und wo willst du ein Fass Säure herbekommen?"

#. Character:`kenji`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_b68dd9a1"
msgid "Dans ton cul ?"
msgstr "Aus deinem Arsch?"

#. Character:`nobu` | Attributes:`angry`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_19fee4a4"
msgid "Mais bordel, j'essayais d'aider !"
msgstr "Verdammt, ich versuche doch nur, zu helfen!"

#. Character:`takeo` | Attributes:`neutral`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_ff5d38ee"
msgid "{{nobu.n}}, si tu veux aider, ferme ta gueule !"
msgstr "{{nobu.n}}, wenn du helfen willst, halt einfach die Fresse!"

#. Character:`nobu` | Attributes:`disgusted`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_94ec3338"
msgid "..."
msgstr "..."

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_1effadae"
msgid "Allez, cassez-vous ! Je le ferai moi-même de mes propres mains !"
msgstr "Verpisst euch! Ich mach es selbst, mit meinen eigenen Händen!"

#. Character:`kenji` | Attributes:`neutral`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_241498a4"
msgid "Non ! Non, je ne suis pas d'accord, on n'a pas traversé toutes ces emmerdes pour qu'un seul d'entre nous se sacrifie."
msgstr "Nein! Nein, das finde ich nicht in Ordnung. Wir haben nicht so viel Scheiße durchgemacht, nur damit sich einer opfert."

#. Character:`kenji`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_3bf27027"
msgid "On le fera tous les deux !"
msgstr "Wir machen das zu zweit!"

#. Character:`takeo` | Attributes:`mocking`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_4afc2d8b"
msgid "Putain, t'es un frère {{kenji.n}} !"
msgstr "Mann, du bist ein richtiger Bruder, {{kenji.n}}!"

#. Character:`nobu`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_30635860"
msgid "Allez, c'est bon putain, pas la peine de me faire culpabiliser, je suis avec vous aussi."
msgstr "Verdammt, in Ordnung. Kein Grund, mir ein schlechtes Gewissen zu machen, ich bin auch dabei."

#. Character:`kenji` | Attributes:`mocking`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_26096bc9"
msgid "De toute façon, je t'aurais traîné avec moi !"
msgstr "Ich hätte dich so oder so da mit reingezogen!"

#. Character:`nobu` | Attributes:`mocking`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_d573637b"
msgid "Mais quel bâtard !"
msgstr "Was für ein Arschloch!"

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_e5a51c9a"
msgid "Bon... Ça n'a vraiment rien de personnel, mais c'est comme ça."
msgstr "Na ja... Nichts Persönliches, aber so ist es halt einfach."

#. Character:`nobu`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_e1fede41"
msgid "Attends, attends... Un condamné à mort a toujours droit à un dernier mot."
msgstr "Warte, warte... Ein zum Tode Verurteilter hat immer ein Recht auf ein paar letzte Worte."

#. Character:`kenji`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_df89d369"
msgid "Putain, pourquoi faut-il toujours que tu sortes des conneries pareilles ?"
msgstr "Warum laberst du nur immer so eine Scheiße?"

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_dd8ba307"
msgid "... Vas-y ! Si t'as une dernière chose à dire avant de quitter ce monde, c'est le moment ?"
msgstr "...Na, komm schon! Wenn du irgendwas loszuwerden hast, sag es, bevor du abschmierst. Das ist deine letzte Chance!"

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_a6d01426"
msgid "... {{macumba.N}}, SAUVE-MOIIII !"
msgstr "...[w]{{macumba.N}}, RETTE MIIIICHHHHH!"

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_afe815d6"
msgid "... C'était bien tenté... vraiment, mais... il ne viendra p-"
msgstr "...Netter Versuch, wirklich, aber... Er wird nicht kommen..."

#. Character:`macumba`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_08ac5b46"
msgid "VOUS ! VOUS AVEZ OSÉ LEVER LA MAIN SUR MON PETIT FRÈRE ?!"
msgstr "DU! DU WAGST ES, DEINE HAND GEGEN MEINEN KLEINEN BRO ZU ERHEBEN?!"

#. Character:`macumba`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_bade8965"
msgid "JE N'AI JAMAIS ÉTÉ AUSSI EN COLÈRE !"
msgstr "ICH WAR NOCH NIE SO WÜTEND!"

#. Character:`macumba`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_d4ffb42e"
msgid "JE VAIS VOUS MASSACRER !"
msgstr "ICH BRING DICH UM!"

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_f1989b8e"
msgid "Bor-"
msgstr "Fu-"

#. Character:`kenji`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_e7b6c20d"
msgid "Put-"
msgstr "Heilige-"

#. Character:`nobu`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_fe376a02"
msgid "Mam-"
msgstr "Mam-"

#. Character:`narrator`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_a20cefa7"
msgid "..."
msgstr "..."

#. Character:`macumba` | Attributes:`sad`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_55df699f"
msgid "Petit frère {{kimochi.n}}... Je suis tellement désolé de ne pas être arrivé plus tôt !"
msgstr "Kleiner Bro, {{kimochi.n}}... Es tut mir so leid, dass ich nicht früher gekommen bin!"

#. Character:`macumba`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_9ea57277"
msgid "Pardonne-moi !"
msgstr "Vergib mir!"

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_3f15f7ac"
msgid "Tu es venu, c'est le plus important."
msgstr "Du bist hergekommen und das ist das Wichtigste."

#. Character:`macumba` | Attributes:`neutral`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_541d3310"
msgid "Je vais te ramener chez toi, je ne bougerai pas, c'est promis !"
msgstr "Ich bringe dich nach Hause, versprochen, also beweg dich nicht."

#. Character:`kimochi`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_7c234e29"
msgid "{{macumba.n}}... Il faut aussi aider {{saito.n}}, il a des problèmes..."
msgstr "{{macumba.n}}... Wir müssen auch {{saito.n}} helfen. Er steckt in Schwierigkeiten..."

#. Character:`macumba` | Attributes:`upset`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_5a080ccb"
msgid "Repose-toi petit frère, je vais m'occuper de tout."
msgstr "Ruh dich etwas aus, kleiner Bro. Ich kümmere mich um alles."

#. Character:`takeo` | Attributes:`angry`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_f2eeb105"
msgid "Il s'est passé quoi avec {{nobu.n}} ?"
msgstr "Was ist mit {{nobu.n}} passiert?"

#. Character:`kenji` | Attributes:`mocking`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_b5aa6b12"
msgid "Il s'est fait salement amocher par l'autre déchet."
msgstr "Er wurde von diesem Drecksack übel zusammengeschlagen."

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_bc4ae0aa"
msgid "Quoi ?! Encore ?"
msgstr "Was?! Schon wieder?"

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_292080ca"
msgid "Putain ce mec est un cas désespéré."
msgstr "Verdammt, dieser Typ ist wirklich ein hoffungsloser Fall."

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_c0b69f34"
msgid "Raconte-moi comment ça s'est passé."
msgstr "Erzähl mir, wie es dazu kam."

#. Character:`kenji` | Attributes:`bad`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_a051ed26"
msgid "Il a été directement le chercher chez lui..."
msgstr "Er ist direkt zum Haus gelaufen..."

#. Character:`kenji`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_40d3ec07"
msgid "À ce qu'il m'a dit... {{saito.n}} semblait agité et ne faisait pas attention à ce qui l'entourait."
msgstr "Von dem, was er mir erzählt hat... war {{saito.n}} aufgewühlt und hat nicht auf seine Umgebung geachtet."

#. Character:`takeo`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_fd7ee9c9"
msgid "Cette petite pute de {{nobu.n}} voulait le prendre par surprise ?"
msgstr "Wollte diese kleine Bitch {{nobu.n}} ihn überraschen?"

#. Character:`kenji` | Attributes:`mocking`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_a5a970a5"
msgid "Oui, eh bien ça n'a pas fonctionné, il s'est fait atomiser instantanément."
msgstr "Joa, na ja, das hat nicht geklappt. Er wurde sofort zerstört."

#. Character:`kenji`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_5734e6ae"
msgid "Il a pris un putain de K.O. par {{saito.n}} le déchet."
msgstr "{{saito.n}} hat ihn K.O. geschlagen."

#. Character:`takeo` | Attributes:`neutral`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_247c5141"
msgid "Tu vas t'en occuper à sa place."
msgstr "Du wirst dich stattdessen um ihn kümmern müssen."

#. Character:`kenji`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_5610c7cb"
msgid "Tu fais chier {{nobu.n}}, je me tape tes corvées !"
msgstr "Du bist wirklich nervtötend, {{nobu.n}}! Ich muss mich um deinen Scheiß kümmern!"

#. Character:`kenji`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_c91b8618"
msgid "Mais au moins je garde le fric."
msgstr "Aber zumindest kann ich dann das Geld behalten."

#. Character:`nobu`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_472b0bd8"
msgid "[font_size=14]Va te faire foutre ![/font_size]"
msgstr "[font_size=14]Fick dich![/font_size]"

#. Character:`netoru`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_4ac602e2"
msgid "Merci de m'accorder cette chance !"
msgstr "Danke für die Gelegenheit!"

#. Character:`netoru` | Attributes:`angry`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_08256e16"
msgid "Je vais pouvoir me venger de cette petite merde !"
msgstr "Ich kann endlich meine Rache an diesem kleinen Stück Scheiße üben!"

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_1454db06"
msgid "J'ai hâte de voir vos talents à l'œuvre."
msgstr "Ich kann es kaum erwarten, deine Fähigkeiten in Aktion zu sehen."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_8f090c78"
msgid "Oh vous ne saurez pas être déçu."
msgstr "Oh, du wirst nicht enttäuscht sein."

#. Character:`netoru`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_32f25c7f"
msgid "Merci encore pour votre soutien."
msgstr "Danke nochmal für deine Unterstützung."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_63722bb4"
msgid "Peu importe, suivez le plan scrupuleusement sans faute et tout ce que vous aurez perdu vous sera restitué. Et bien plus encore."
msgstr "Was auch passiert, halt dich einfach an den Plan, dann wirst du alles, was du verloren hast, wiederbekommen und noch mehr!"

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_b0a7e5c4"
msgid "D'ailleurs... je viens de recevoir l'information que j'attendais, vous pouvez passer à l'action dès maintenant."
msgstr "Übrigens... Ich habe gerade die Infos erhalten, auf die ich gewartet habe. Du kannst dich jetzt darum kümmern."

#. Character:`netoru` | Attributes:`bad`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_abfc0ba2"
msgid "Ce sera avec plaisir !"
msgstr "Das Vergnügen ist ganz auf meiner Seite!"

#. Character:`minato` | Attributes:`suspicious`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_da5c6e64"
msgid "Faites attention, attendez bien d'être seul. Gérer les témoins est vraiment épuisant et coûte bien trop d'argent."
msgstr "Sei vorsichtig und sieh zu, dass du alleine bist. Sich um Zeugen zu kümmern ist anstrengend und viel zu teuer."

#. Character:`netoru` | Attributes:`neutral`
#: game/story/warehouse_interior.dialogue
msgctxt "warehouse_interior_0bf037cd"
msgid "Je serai extrêmement prudent. Sur ce, j'y vais tout de suite !"
msgstr "Ich werde aufpassen. Ich mach mich auf den Weg!"

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "t5c0dc942ff"
msgid "Tout s'est bien déroulé ?"
msgstr "Ist alles gut gegangen?"

#. Character:`netoru` | Attributes:`bad`
#: game/story/warehouse_interior.dialogue
msgctxt "t9cb85e6ee1"
msgid "A la perfection."
msgstr "Perfekt."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/warehouse_interior.dialogue
msgctxt "t572c28ee90"
msgid "La lettre a bien été mise en évidence, elle a été un peu réticente à écrire mais quand j'ai commencé à la menacer de m'en prendre à sa mère, elle a tout de suite été plus coopérative."
msgstr "Letzteres ist gut angekommen. Sie war anfangs etwas zögerlich, es aufzuschreiben, aber als ich angefangen habe, zu drohen, ihrer Mutter wehzutun, war sie sofort kooperativer."

#. Character:`minato` | Attributes:`happy`
#: game/story/warehouse_interior.dialogue
msgctxt "tce302fcad6"
msgid "Parfait !"
msgstr "Perfekt!"

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "ta7c78a09f1"
msgid "C'est quelque chose que je n'ai plus eu l'habitude de dire depuis longtemps mais c'est du bon boulot."
msgstr "Ich sage jetzt etwas, was ich schon ein ganzes Weilchen nicht gesagt habe: gute Arbeit."

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/warehouse_interior.dialogue
msgctxt "tb560851a13"
msgid "C'est souvent ce qu'il se produit lorsqu'on travaille avec des amateurs."
msgstr "Das passiert oft, wenn man mit Anfängern arbeitet."

#. Character:`minato` | Attributes:`neutral`
#: game/story/warehouse_interior.dialogue
msgctxt "tab34aaf3f9"
msgid "En effet..."
msgstr "Durchaus ..."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/warehouse_interior.dialogue
msgctxt "t731db20e53"
msgid "Au sujet de la récompense... Vous me confirmez bien que..."
msgstr "Und was die Belohnung betrifft ... Kannst du bestätigen, dass ..."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "t8025c63a9b"
msgid "Oui vous aurez accès au X3 comme promis."
msgstr "Ja, du wirst Zugang zu X3 haben, wie ich es dir versprochen habe."

#. Character:`minato`
#: game/story/warehouse_interior.dialogue
msgctxt "t30396c7b9d"
msgid "Mais pour cela, le plan doit être mené d'une main de maître jusqu'au bout."
msgstr "Aber damit das passiert, muss der Plan makellos bis zum Ende ausgeführt werden."

#. Character:`netoru` | Attributes:`bad`
#: game/story/warehouse_interior.dialogue
msgctxt "t107ef4d82f"
msgid "C'est tout a fait naturel. Vous ne serez pas déçu !"
msgstr "Das ist zu erwarten. Du wirst nicht enttäuscht sein!"

#. Character:`netoru` | Attributes:`neutral`
#: game/story/warehouse_interior.dialogue
msgctxt "t0fdb209d3b"
msgid "Maintenant que j'y pense... Cette lettre me chagrine, la mère pourrait contacter le père assez rapidement et la supercherie serait vite révélée non ?"
msgstr "Jetzt, wo ich so darüber nachdenke ... Dieser Brief bedrückt mich. Die Mutter könnte den Vater recht einfach kontaktieren und die Lüge würde auffliegen, nicht wahr?"

#. Character:`minato` | Attributes:`suspicious`
#: game/story/warehouse_interior.dialogue
msgctxt "tc9b3aca804"
msgid "C'est possible mais très peu probable, il a quitté le pays depuis des mois pour refaire sa vie ailleurs avec une autre femme."
msgstr "Das ist möglich, aber sehr unwahrscheinlich. Er hat schon vor Monaten das Land verlassen und woanders mit einer neuen Frau ein neues Leben begonnen."

#. Character:`netoru`
#: game/story/warehouse_interior.dialogue
msgctxt "t776582b696"
msgid "Oh je vois..."
msgstr "Oh, verstehe ..."

#. Character:`minato` | Attributes:`neutral`
#: game/story/warehouse_interior.dialogue
msgctxt "t3aff46c58f"
msgid "Dans tous les cas, l'intérêt ici est de ne pas lever les soupçons de sa disparition avant plusieurs jours."
msgstr "In jedem Fall kommt es darauf an, für ein paar Tage keinen Verdacht wegen ihres Verschwindens zu schüren."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/warehouse_interior.dialogue
msgctxt "tdbbd0048f5"
msgid "Je comprends, j'attendrais donc les prochaines instructions."
msgstr "In Ordnung. Ich werde auf weitere Anweisungen warten."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "TOI_92297E"
msgid "TOI !"
msgstr "DU!"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "JE_TE_JURE_QUE_SI_JE_DESCENDS_6DC96A"
msgid "Je te jure que si je descends d'ici tu v-"
msgstr "Ich schwöre, wenn ich von hier runterkomme, wirst du-"

#. Character:`sakuya`
#: game/story/warehouse_interior.dialogue
msgctxt "TU_VAS_TE_CALMER_IMM_DIATEMENT_EAC2A7"
msgid "Tu vas te calmer immédiatement ou je décroche cette chaîne et ta tête frappera le béton."
msgstr "Du wirst dich jetzt erst mal beruhigen, sonst löse ich die Kette und dein Schädel macht Bekanntschaft mit dem Boden."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "TOUT_EST_DE_VOTRE_PUTAIN_DE_FA_EB908F"
msgid "Tout est de votre putain de faute !"
msgstr "Das ist alles deine verfickte Schuld!"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "C_EST_CAUSE_DE_VOUS_DEUX_QUE_J_2EC064"
msgid "C'est à cause de vous deux que j'ai tous ces problèmes !"
msgstr "Nur euretwegen habe ich all diese Probleme!"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "ARR_TE_DE_JOUER_LES_VICTIMES_J_E1C6DF"
msgid "Arrête de jouer les victimes ! Je t'ai déjà dit d'assumer tes actes."
msgstr "Hör auf, das Opfer zu spielen. Ich habe dir schon einmal gesagt, dass du Verantwortung für deine Taten übernehmen musst."

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "C_EST_TOI_QUI_VOULAIS_UTILISER_C51453"
msgid "C'est toi qui voulais utiliser {{sakuya.n}} dans une de tes combines louches."
msgstr "Du warst derjenige, der {{sakuya.n}} für seine schmutzigen Machenschaften ausnutzen wollte."

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "C_EST_ENCORE_TOI_QUI_TE_BALADA_B44320"
msgid "C'est encore toi qui te baladais avec cette drogue."
msgstr "Du bist derjenige, der mit dieser Droge rumgelaufen ist."

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "ET_C_EST_TOUJOURS_TOI_QUI_AS_V_BD0ED8"
msgid "Et c'est toujours toi qui as voulu faire du mal à {{asami.n}}."
msgstr "Und du warst auch immer derjenige, der {{asami.n}} wehtun wollte."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "PUTAIN_W_QU_EST_CE_QUE_VOUS_ME_29F040"
msgid "Putain...[w] Qu'est-ce que vous me voulez ?"
msgstr "Was zur Hölle ... [w]Was willst du von mir?"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "LA_QUESTION_EST_SIMPLE_QUI_EST_48CF3B"
msgid "La question est simple... Qui est ton fournisseur ?"
msgstr "Eine ganz einfache Frage ... Wer ist dein Lieferant?"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "C_EST_UNE_BLAGUE_BFE314"
msgid "C'est une blague ?"
msgstr "Soll das ein Witz sein?"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "ON_A_L_AIR_DE_PLAISANTER_8963E6"
msgid "On a l'air de plaisanter ?"
msgstr "Sehen wir so aus, als würden wir scherzen?"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "EST_CE_QUE_TU_CROIS_SINC_REMEN_E10D8E"
msgid "Est-ce que tu crois sincèrement que je vais te révéler un truc pareil ?"
msgstr "Glaubst du allen Ernstes, ich würde dir sowas erzählen?"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "D_VOILER_CETTE_INFO_C_EST_JUST_BB0612"
msgid "Dévoiler cette info, c'est juste la mort assurée pour moi."
msgstr "Wenn ich sowas ausplaudere bin ich ein toter Mann."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "JE_TE_CROYAIS_PLUS_INTELLIGENT_DA2887"
msgid "Je te croyais plus intelligent que ça !"
msgstr "Ich hätte gedacht, du wärst ein wenig intelligenter!"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "JE_VOIS_3A9571"
msgid "Je vois..."
msgstr "Ich verstehe ..."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "NON_NON_NON_NON_NON_3C3021"
msgid "Non ! NON ! NON NON NON !!!"
msgstr "Nein! NEIN! NEIN NEIN NEEEIIIN!"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "LOIGNE_CE_MONSTRE_DE_MOI_NE_L_CC711F"
msgid "Éloigne ce monstre de moi, ne la laisse plus s'approcher de moi !"
msgstr "Schaff dieses Monster von mir weg! Lass sie nicht in meine Nähe kommen!"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "TOUT_D_PENDRA_DE_TES_R_PONSES_5B803F"
msgid "Tout dépendra de tes réponses..."
msgstr "Das kommt ganz auf deine Antworten an ..."

#. Character:`akira` | Attributes:`upset`
#: game/story/warehouse_interior.dialogue
msgctxt "PUTAIN_JE_SUIS_FOUTU_C53679"
msgid "Putain, je suis foutu..."
msgstr "Scheiße, ich bin am Arsch ..."

#. Character:`saito` | Attributes:`upset`
#: game/story/warehouse_interior.dialogue
msgctxt "JE_T_COUTE_3E4537"
msgid "Je t'écoute."
msgstr "Ich höre."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "SI_JE_PARLE_ET_QU_IL_APPREND_Q_D86AAD"
msgid "Si... je parle et qu'il apprend que j'ai tout balancé, il me tuera. Il a des yeux et des oreilles partout."
msgstr "Wenn ... ich rede und er herausfindet, dass ich ihn verraten habe, bringt er mich um. Er hat Augen und Ohren überall."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "TU_N_AS_PAS_ID_E_DE_SON_INFLUE_255606"
msgid "Tu n'as pas idée de son influence... Il a la main sur tellement de choses."
msgstr "Du hast ja keine Ahnung, wie groß sein Einfluss ist ... Er hat in so vielen Bereichen seine Finger im Spiel."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "IL_TAIT_TES_C_T_S_DURANT_TOUT_320886"
msgid "Il était à tes côtés durant tout ce temps et tu n'as jamais rien vu."
msgstr "Er war die ganze Zeit an deiner Seite und du hattest nicht die geringste Ahnung."

#. Character:`saito` | Attributes:`neutral`
#: game/story/warehouse_interior.dialogue
msgctxt "C_TAIT_DONC_BIEN_MINATO_N_QUI_C51B10"
msgid "C'était donc bien {{minato.n}} qui était derrière tout ça !"
msgstr "Also war es {{minato.n}}, der hinter all dem steckt!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/warehouse_interior.dialogue
msgctxt "TOUT_A_N_A_AUCUN_SENS_ON_A_LE_BE1C87"
msgid "Tout ça n'a aucun sens... On a le même âge ! Comment il aurait pu en arriver là aussi vite ?"
msgstr "Das ergibt keinen Sinn ... Er ist genauso alt wie ich! Wie hätte er das so schnell bewerkstelligen können?"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "J_EN_SAIS_RIEN_TOUT_CE_QUE_JE_A72AC0"
msgid "J'en sais rien... Tout ce que je sais, c'est qu'à la base le X3 servait plutôt à rallier des adversaires."
msgstr "Ich weiß es nicht ... Ich weiß nur, dass X3 ursprünglich dafür gedacht war, seine Feinde auf seine Seite zu holen."

#. Character:`sakuya` | Attributes:`melancholic`
#: game/story/warehouse_interior.dialogue
msgctxt "IL_A_D_TENDRE_SON_R_SEAU_DE_CE_59F550"
msgid "Il a dû étendre son réseau de cette façon."
msgstr "Er muss sein Netzwerk dadurch aufgebaut haben."

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "L_UTILISATION_POUR_FAIRE_DES_E_88A2B1"
msgid "L'utilisation pour faire des esclaves sexuels est juste... la cerise sur le gâteau."
msgstr "Die Droge zu nutzen, um Sexsklaven zu erschaffen ist nur ... die Kirsche auf dem Sahnehäubchen."

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "A_EXPLIQUE_BIEN_POURQUOI_IL_A_91112A"
msgid "Ça explique bien pourquoi il a étendu son réseau aussi rapidement et profondément... Tout le monde a été drogué !"
msgstr "Das erklärt, wie er sein Netzwerk so schnell und umfangreich ausbauen konnte ... Sie stehen alle unter Drogen!"

#. Character:`akira` | Attributes:`arrogant`
#: game/story/warehouse_interior.dialogue
msgctxt "SI_TU_PENSES_A_C_EST_QUE_TU_ES_7F2CDE"
msgid "Si tu penses ça, c'est que tu es encore trop naïf !"
msgstr "Wenn du das wirklich glaubst, bist du immer noch zu naiv!"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "D_AUTRES_ONT_VU_LE_POTENTIEL_D_7EE91F"
msgid "D'autres ont vu le potentiel du produit et ont tout fait pour travailler avec lui."
msgstr "Andere haben das Potential dieses Zeugs gesehen und haben alles daran gesetzt, ihren Teil davon zu haben."

#. Character:`sakuya` | Attributes:`neutral`
#: game/story/warehouse_interior.dialogue
msgctxt "AVEC_UNE_TELLE_CHOSE_ENTRE_LEU_88FB21"
msgid "Avec une telle chose entre leurs mains, il n'est même pas nécessaire de recourir à la violence. Change tes ennemis en amis prêts à tout pour toi !"
msgstr "Mit so etwas in ihren Händen ist es nicht einmal mehr nötig, auf Gewaltanwendung zurückzugreifen. Du kannst deine Feinde einfach in Freunde verwandeln, die bereit sind, alles für dich zu geben!"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "ET_ASAMI_N_131268"
msgid "Et {{asami.n}} ?"
msgstr "Und {{asami.n}}?"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "AUCUNE_ID_E_MOI_JE_NE_FAISAIS_B633AE"
msgid "Aucune idée, moi je ne faisais que dealer du X3 pour lui !"
msgstr "Keine Ahnung. Ich habe ihm nur X3 verkauft, sonst nichts!"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "TU_AS_LA_LISTE_DE_TES_CLIENTS_386C0D"
msgid "Tu as la liste de tes clients ?"
msgstr "Hast du eine Liste deiner Kunden?"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "TU_RIGOLES_TU_CROIS_QUE_JE_TIE_A036EE"
msgid "Tu rigoles ? Tu crois que je tiens un putain de registre ?"
msgstr "Ist das dein Ernst? Glaubst du wirklich, ich würde über sowas Buch führen?"

#. Character:`akira`
#: game/story/warehouse_interior.dialogue
msgctxt "J_AI_R_PONDU_TOUTES_TES_QUESTI_B80DE6"
msgid "J'ai répondu à toutes tes questions ! Ça mérite bien une récompense, non ?"
msgstr "Ich habe all deine Fragen beantwortet! Da verdiene ich eine Belohnung, oder?"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "QUOI_43DB5B"
msgid "Quoi ?"
msgstr "Was?"

#. Character:`akira` | Attributes:`happy`
#: game/story/warehouse_interior.dialogue
msgctxt "TU_CROIS_QUE_JE_PEUX_TE_SUC_BF6991"
msgid "Tu crois que je peux te suc-"
msgstr "Meinst du, ich könnte dir vielleicht einen bla-"

#. Character:`sakuya` | Attributes:`angry`
#: game/story/warehouse_interior.dialogue
msgctxt "JE_CROIS_QU_IL_COMMENCE_D_PASS_BA4A9F"
msgid "Je crois qu'il commence à dépasser les bornes, je vais l'attacher à nouveau."
msgstr "Ich glaube, er verliert die Kontrolle. Ich werde ihn wieder fesseln."

#. Character:`akira` | Attributes:`angry`
#: game/story/warehouse_interior.dialogue
msgctxt "S_IL_VOUS_PLA_T_L_AIDE_BE07E7"
msgid "S'IL VOUS PLAÎT, À L'AIDE !"
msgstr "HILFE, BITTE!"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "ARR_TE_DE_HURLER_ON_VA_TE_REL_A518A1"
msgid "Arrête de hurler... On va te relâcher."
msgstr "Hör auf zu schreien ... wir werden dich wieder freilassen."

#. Character:`akira` | Attributes:`happy`
#: game/story/warehouse_interior.dialogue
msgctxt "QUOI_VOUS_TES_S_RIEUX_3CF166"
msgid "Quoi ?! Vous êtes sérieux ?"
msgstr "Was?! Ist das dein Ernst?"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "ON_IRA_S_OCCUPER_DE_MINATO_N_E_2CF355"
msgid "On ira s'occuper de {{minato.n}} ensuite !"
msgstr "Wir werden uns als nächstes um {{minato.n}} kümmern!"

#. Character:`akira` | Attributes:`arrogant`
#: game/story/warehouse_interior.dialogue
msgctxt "HAHAHA_VOUS_TES_FOUS_VOUS_ALLE_ADE339"
msgid "HAHAHA ! Vous êtes fous ! Vous allez vous faire tuer ou bien pire."
msgstr "HAHAHA! Ihr seid verrückt! Ich werdet alle dabei draufgehen."

#. Character:`saito` | Attributes:`upset`
#: game/story/warehouse_interior.dialogue
msgctxt "PAR_CONTRE_JE_ME_G_NERAI_PAS_P_489B98"
msgid "Par contre, je me gênerai pas pour lui dire que c'est toi qui as tout balancé."
msgstr "Dann wiederum werde ich auch mein Vergnügen damit haben, ihm zu erzählen, wer ihn verraten hat."

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "DONC_JE_TE_SUGG_RE_DE_PARTIR_T_47B313"
msgid "Donc je te suggère de partir très loin si tu veux éviter tout problème."
msgstr "Also schlage ich vor, dass du an irgendeinen weit, weit entfernten Ort ziehst, um dieser Sache aus dem Weg zu gehen."

#. Character:`akira` | Attributes:`upset`
#: game/story/warehouse_interior.dialogue
msgctxt "TU_FERAIS_A_TU_ME_CONDAMNERAI_1708A6"
msgid "... Tu ferais ça ? Tu me condamnerais à mort ?"
msgstr "... Das würdest du tun? Du würdest mich zum Tode verurteilen?"

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "ON_VERRA_50D02F"
msgid "On verra..."
msgstr "Werden wir ja sehen ..."

#. Character:`saito`
#: game/story/warehouse_interior.dialogue
msgctxt "D_P_CHE_TOI_AVANT_QUE_JE_NE_CH_9E8E64"
msgid "Dépêche-toi avant que je ne change d'avis !"
msgstr "Beeil dich, bevor ich es mir anders überlege!"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/amusement_park_exterior.dialogue
msgctxt "tce9ed5040b"
msgid "Si tu savais depuis combien de temps j'attends ça !"
msgstr "Wenn du nur wüsstest, wie lange ich schon darauf gewartet habe!"

#. Character:`saito`
#: game/story/amusement_park_exterior.dialogue
msgctxt "t4a526fc865"
msgid "Si longtemps ?"
msgstr "So lange?"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/amusement_park_exterior.dialogue
msgctxt "t42fc0dc46b"
msgid "Tu n'as pas idée..."
msgstr "Du hast ja keine Ahnung ..."

#. Character:`narrator` | Attributes:`neutral`
#: game/story/amusement_park_exterior.dialogue
msgctxt "te33d131a34"
msgid "En y repensant, ce parc n'avait pas fait long feu dans ma précédente vie..."
msgstr "Jetzt, wo ich darüber nachdenke, dieser Park hat in meinem vorigen Leben nicht lange durchgehalten ..."

#. Character:`narrator`
#: game/story/amusement_park_exterior.dialogue
msgctxt "t4ec91d0c13"
msgid "Le proprio avait dû revoir son modèle économique."
msgstr "Der Besitzer musste sein Geschäftskonzept überarbeiten."

#. Character:`narrator`
#: game/story/amusement_park_exterior.dialogue
msgctxt "tb076a8dffb"
msgid "Ou... il n'avait pas été racheté d'ailleurs ?"
msgstr "Oder ... wurde das Ganze nicht aufgekauft?"

#. Character:`narrator`
#: game/story/amusement_park_exterior.dialogue
msgctxt "t9231f122db"
msgid "Peu importe, ce n'est pas quelque chose qui me concerne..."
msgstr "Wie auch immer, ist im Grunde egal ..."

#. Character:`saito` | Attributes:`guilty`
#: game/story/amusement_park_exterior.dialogue
msgctxt "tbc51e00296"
msgid "Je trouve ça tellement idiot de ne laisser entrer que les couples..."
msgstr "Ich finde, es ist dämlich, nur Pärchen reinzulassen ..."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/amusement_park_exterior.dialogue
msgctxt "t8812a69820"
msgid "Sans enfants, c'est plus calme et surtout moins bruyant."
msgstr "Ohne Kinder ist es leiser und vor allem gesitteter."

#. Character:`sayuri`
#: game/story/amusement_park_exterior.dialogue
msgctxt "t6e1ae3014a"
msgid "Peu importe, arrête de trop y réfléchir et allons nous amuser, mon chéri !"
msgstr "Wie dem auch sei, denk nicht zu viel drüber nach und hab etwas Spaß, Liebling!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/amusement_park_exterior.dialogue
msgctxt "ta308e44578"
msgid "Je... ok !"
msgstr "Ich ... okay!"

#. Character:`asami` | Attributes:`happy`
#: game/story/amusement_park_exterior.dialogue
msgctxt "ALORS_SURPRIS_AA296B"
msgid "Alors ? Surpris ?"
msgstr ""

#. Character:`asami` | Attributes:`happy,blush`
#: game/story/amusement_park_exterior.dialogue
msgctxt "JE_VOULAIS_VENIR_ICI_LE_PREMIE_DE7EE9"
msgid "Je voulais venir ici le premier jour mais... c'était peut-être un poil trop rapide."
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/amusement_park_exterior.dialogue
msgctxt "TU_CONNAIS_LA_PARTICULARIT_DE_FDDDE7"
msgid "Tu connais la particularité de ce parc d'attractions ?"
msgstr ""

#. Character:`asami`
#: game/story/amusement_park_exterior.dialogue
msgctxt "OUI_OUVERT_SEULEMENT_POUR_LES_FCA356"
msgid "Oui, ouvert seulement pour les couples !"
msgstr ""

#. Character:`saito` | Attributes:`surprised`
#: game/story/amusement_park_exterior.dialogue
msgctxt "OH_JE_NE_SAVAIS_PAS_QUE_NOUS_T_9AC932"
msgid "Oh ! Je ne savais pas que nous étions en couple."
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/amusement_park_exterior.dialogue
msgctxt "C_EST_POUR_A_QU_IL_FAUT_TOUJOU_81D541"
msgid "C'est pour ça qu'il faut toujours lire les petits caractères !"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/amusement_park_exterior.dialogue
msgctxt "QUI_A_LE_TEMPS_DE_LIRE_TOUT_A_A106D3"
msgid "Qui a le temps de lire tout ça, honnêtement ?"
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/amusement_park_exterior.dialogue
msgctxt "PERSONNE_EXACTEMENT_C_EST_LE_B_6A669F"
msgid "Personne, exactement, c'est le but !"
msgstr ""

#. Character:`asami`
#: game/story/amusement_park_exterior.dialogue
msgctxt "MAINTENANT_TU_AS_SIGN_ET_TU_TE_DDD648"
msgid "Maintenant, tu as signé et tu te retrouves avec moi."
msgstr ""

#. Character:`saito` | Attributes:`sad`
#: game/story/amusement_park_exterior.dialogue
msgctxt "MINCE_MOI_QUI_VOULAIS_SIGNER_A_1D55AE"
msgid "Mince... Moi qui voulais signer avec ta m-"
msgstr ""

#. Character:`asami` | Attributes:`upset`
#: game/story/amusement_park_exterior.dialogue
msgctxt "SI_TU_FINIS_TA_PHRASE_JE_T_ARR_80720C"
msgid "Si tu finis ta phrase, je t'arrache la langue !"
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/amusement_park_exterior.dialogue
msgctxt "MERVEILLEUSE_PERSONNE_D6F0C9"
msgid "... merveilleuse personne."
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/amusement_park_exterior.dialogue
msgctxt "C_EST_MIEUX_0949C0"
msgid "C'est mieux !"
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/amusement_park_exterior.dialogue
msgctxt "TSS_POURQUOI_FAIRE_UN_PARC_D_D_EF69E6"
msgid "Tss... Pourquoi faire un parc dédié aux couples si on nous jette dehors ?"
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/amusement_park_exterior.dialogue
msgctxt "JE_PENSE_QU_ILS_ONT_EU_PEUR_QU_52D8A2"
msgid "Je pense qu'ils ont eu peur qu'il se passe quelque chose au bout de ce huitième tour de grande roue."
msgstr ""

#. Character:`asami`
#: game/story/amusement_park_exterior.dialogue
msgctxt "CELUI_QUI_LA_FAISAIT_TOURNER_D_DEBE30"
msgid "Celui qui la faisait tourner devait être célibataire."
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/amusement_park_exterior.dialogue
msgctxt "QUOI_QU_IL_EN_SOIT_C_TAIT_G_NI_21C0D4"
msgid "Quoi qu’il en soit, c’était... génial !"
msgstr ""

#. Character:`asami`
#: game/story/amusement_park_exterior.dialogue
msgctxt "C_EST_LE_GENRE_DE_SOUVENIRS_QU_60754F"
msgid "C’est le genre de souvenirs qui va rester toute une vie !"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/amusement_park_exterior.dialogue
msgctxt "ET_M_ME_DEUX_24584C"
msgid "Et même deux !"
msgstr ""

#. Character:`asami`
#: game/story/amusement_park_exterior.dialogue
msgctxt "M_ME_UNE_INFINIT_F7DF8C"
msgid "... Même une infinité !"
msgstr ""

#. Character:`saito`
#: game/story/amusement_park_exterior.dialogue
msgctxt "PFFF_SI_TU_VEUX_5B405C"
msgid "Pfff... si tu veux !"
msgstr ""

#. Character:`saito`
#: game/story/amusement_park_exterior.dialogue
msgctxt "TU_VIENS_JE_TE_RACCOMPAGNE_5D69B2"
msgid "Tu viens, je te raccompagne."
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/amusement_park_exterior.dialogue
msgctxt "OUI_MONSIEUR_RABAT_JOIE_93A17E"
msgid "Oui, monsieur rabat-joie."
msgstr ""

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t6616dbea73"
msgid "...[w] C'est quoi cet endroit ?!"
msgstr "... [w]Was ist das für ein Ort?!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t334088d21a"
msgid "Qu'est-ce que je fais ici ?"
msgstr "Was mache ich hier?"

#. Character:`asami` | Attributes:`angry`
#: game/story/home_minato_basement.dialogue
msgctxt "t4809c786ea"
msgid "VOUS !"
msgstr "DU!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tfa1fd66d03"
msgid "Que m'avez-vous fait, laissez-moi partir tout de suite sinon..."
msgstr "Was hast du mir angetan? Lass mich auf der Stelle gehen, sonst ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t095d5a29d5"
msgid "Et bien je vois que tu es toujours énergique, c'est rassurant !"
msgstr "Na, ich kann sehen, dass du immer noch so viel Energie hast; das beruhigt mich!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tcd00e8b551"
msgid "J'avais un peu peur d'avoir abusé avec le somnifère, mais non."
msgstr "Ich hatte etwas Angst, dass ich es mit den K.O.-Tropfen etwas übertrieben habe, aber es scheint mir, als ginge es dir ganz wunderbar."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tf763b78c1e"
msgid "Où suis-je ?"
msgstr "Wo bin ich?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t451cd0c7be"
msgid "Tu espère sincèrement que je vais te répondre ?"
msgstr "Erwartest du ernsthaft von mir, dass ich dir antworte?"

#. Character:`asami` | Attributes:`upset`
#: game/story/home_minato_basement.dialogue
msgctxt "t97dfa85638"
msgid "...[w]J'aurais au moins essayé."
msgstr "... [w]Einen Versuch war’s wert."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t136466d982"
msgid "Est-ce que vous pouvez au moins me dire pourquoi vous m'avez enlevée ?"
msgstr "Kannst du mir zumindest sagen, warum du mich entführt hast?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t2de7c6f348"
msgid "Tout ceci n'est que pure vengeance, à cause d'une de tes fréquentation... J'ai tout perdu."
msgstr "All das ist pure Vergeltung. Wegen einer Person aus deinem Umfeld ... habe ich alles verloren."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t9940847536"
msgid "Vous parlez de {{saito.n}} ?"
msgstr "Sprichst du von {{saito.n}}?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t722e8d2cef"
msgid "Tout ceci n'est que pure vengeance, à cause d'un petit ami... J'ai tout perdu."
msgstr "All das ist pure Vergeltung. Wegen deines Freunds ... habe ich alles verloren."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "td3915efa0c"
msgid "Mon magasin, ma réputation, mon argent, tout !"
msgstr "Meinen Laden, meinen Ruf, mein Geld, alles!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t32d21bdd14"
msgid "Tout est de sa faute !"
msgstr "Es ist alles seine Schuld!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t9a7db5b983"
msgid "S'en prendre à quelqu'un à qui il tient par-dessus tout n'est donc que justice."
msgstr "Da ist es nur gerecht, dass ich mir eine Person, die ihm lieber ist, als alles andere, nehme."

#. Character:`asami` | Attributes:`mocking`
#: game/story/home_minato_basement.dialogue
msgctxt "tc4959e9eda"
msgid "Ce n'est pas la faute de {{saito.n}}, c'est juste vous qui cherchez un responsable à vos échecs !"
msgstr "Es ist nicht {{saito.n}}s Schuld! Du suchst nur nach einem Sündenbock für dein eigenes Versagen!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t30b35e60bd"
msgid "Tu es sûre de vouloir me provoquer ? Tu n'es pas dans une situation où tu peux aisément te défendre tu sais..."
msgstr "Bist du dir sicher, dass du mich provozieren willst? Du befindest dich nicht unbedingt in einer Position, in der du dich gut verteidigen kannst, weißt du ..."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "t77fb0b8a12"
msgid "..."
msgstr "..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "td3bcef4b98"
msgid "J'en ai marre !"
msgstr "Ich hab’ die Schnauze voll!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tf97e08edf8"
msgid "Combien de temps vous allez me laisser là ?!"
msgstr "Wie länge willst du mich hierbehalten?!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tfeb6637757"
msgid "Tu auras beau te plaindre ce n'est pas ça qui changera ta situation."
msgstr "Ganz egal, wie sehr du dich auch beschwerst, es wird an deiner Situation wenig ändern."

#. Character:`asami` | Attributes:`mocking`
#: game/story/home_minato_basement.dialogue
msgctxt "t6c816b1331"
msgid "Je pourrais crier jusqu'à ce qu'on vienne me chercher ?"
msgstr "Ich könnte schreien, bis jemand zur Hilfe kommt, weißt du das?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t090a04fdc9"
msgid "Mhh mauvaise idée, cette pièce est insonorisée pour commencer."
msgstr "Hmm, schlechte Idee. Dieser Raum ist absolut schalldicht."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t292f8dd9cb"
msgid "Et tu passerais le reste du temps avec un bâillon ce qui serait assez inconfortable, tu ne crois pas ?"
msgstr "Und als Konsequenz würdest du für den Rest deiner Zeit hier einen Knebel bekommen. Das klingt ziemlich unangenehm, findest du nicht auch?"

#. Character:`asami` | Attributes:`upset`
#: game/story/home_minato_basement.dialogue
msgctxt "t8fa89c9c66"
msgid "Pfff...."
msgstr "Tsss ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t60ea88de18"
msgid "En plus je ne sais pas de quoi tu te plains, je t'ai laissé ma vieille console portable pour que tu n'aies pas à t'ennuyer."
msgstr "Abgesehen davon weiß ich nicht, warum du dich beschwerst. Ich habe dir meinen alten Handheld zur Verfügung gestellt, damit dir nicht langweilig wird."

#. Character:`asami` | Attributes:`mocking`
#: game/story/home_minato_basement.dialogue
msgctxt "t40dd4bc4bc"
msgid "J'ai effacée toutes vos sauvegardes !"
msgstr "Ich habe all deine Spielstände gelöscht!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t213a59239c"
msgid "Haha... Bien essayé mais ça fait des dizaines d'années que ne joue plus."
msgstr "Haha ... Netter Versuch, aber ich habe seit Jahrzehnten nicht mehr darauf gespielt."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t1b4e2e8a10"
msgid "Je suis passé à des jeux pour adultes."
msgstr "Ich bin zu Erwachsenenspielen übergegangen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "ta398e49778"
msgid "Vous n'avez pas honte de passer votre temps à vous branler à votre age ?"
msgstr "Schämst du dich nicht, dass du in deinem Alter so viel Zeit mit Wichsen verbringst?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t05328323b7"
msgid "..."
msgstr "..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "td704136d0f"
msgid "J'ai vu juste n'est ce pas !"
msgstr "Ich hatte recht, nicht wahr?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "te00a907488"
msgid "C'est affligeant, pourquoi tant de vulgarités ?"
msgstr "Warum solch vulgäre Ausdrucksweise?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tbd2b2fc5d9"
msgid "...Je fais ce que je peux."
msgstr "... Ich tu, was ich kann."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t67b18500f0"
msgid "Bon... On rigole bien tous les deux mais il va falloir me laisser partir."
msgstr "Nun gut ... Wir beide werden uns köstlich amüsieren, aber früher oder später musst du mich freilassen."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tc216268aac"
msgid "Vraiment ? Et pourquoi ça ?"
msgstr "Wirklich? Und warum das?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t0a27a551aa"
msgid "Vous m'avez kidnappée, enfermée ici mais vous ne m'avez fait aucun mal."
msgstr "Du hast mich entführt und eingesperrt, aber du hast mir kein körperliches Leid zugefügt."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t3c893dccf9"
msgid "Je ne sais pas comment sont traités les gens quand ils sont enlevés mais je suppose que ça ne se passe pas comme ça en general."
msgstr "Ich weiß nicht genau, wie Entführte sonst behandelt werden, aber ich schätze, für gewöhnlich läuft das anders."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t574a3c66d0"
msgid "C'est bien, tu es consciente de la chance que tu as !"
msgstr "Das ist gut; du weißt, wie glücklich du dich schätzen kannst!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t736a855b34"
msgid "Si vous me traitez bien, c'est que vous attendez quelque chose de moi, si ce n'était pas le cas, vous vous seriez débarrassé de moi depuis longtemps !"
msgstr "Wenn du mich gut behandelst, dann nur, weil du etwas von mir willst. Andernfalls hättest du dich schon längst meiner entledigt!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t8df263fd3f"
msgid "En effet... Pour le moment tu es dans le vrai !"
msgstr "In der Tat ... Du hast recht, zumindest vorerst."

#. Character:`asami` | Attributes:`upset`
#: game/story/home_minato_basement.dialogue
msgctxt "t1b51b3b825"
msgid "mhhh... Je ne sais pas ce que vous voulez ou attendez de moi mais je refuserai de toute manière."
msgstr "Hmm ... Ich weiß nicht, was du von mir willst oder erwartest, aber ich werde mich dir ohnehin nicht beugen."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t2cae7de609"
msgid "Oh ?! Tu en es certaine ?"
msgstr "Oh?! Bist du dir da sicher?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t65440519e5"
msgid "Absolument !"
msgstr "Todsicher!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tf92bcec173"
msgid "Vous avez une dent contre {{saito.n}} même si j'ignore pourquoi."
msgstr "Du hegst Groll gegen {{saito.n}}, auch wenn ich nicht genau weiß, warum."

#. Character:`asami` | Attributes:`angry`
#: game/story/home_minato_basement.dialogue
msgctxt "t16c3bc916c"
msgid "Je ne trahirais pas mon meilleur ami."
msgstr "Ich werde meinen besten Freund niemals verraten."

#. Character:`asami` | Attributes:`angry`
#: game/story/home_minato_basement.dialogue
msgctxt "t3c82d405c9"
msgid "Je ne trahirais pas mon petit ami."
msgstr "Ich werde meinen Freund niemals verraten."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t23d87bedc4"
msgid "Oh mais ce n'est pas toi qui le trahiras, c'est lui !"
msgstr "Oh, aber nicht du wirst ihn verraten; ganz im Gegenteil!"

#. Character:`asami` | Attributes:`afraid`
#: game/story/home_minato_basement.dialogue
msgctxt "ta50779437b"
msgid "Comment ça ?"
msgstr "Was meinst du?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t1d7c78b2bc"
msgid "Voyons... Je ne te savais pas si naive."
msgstr "Wirklich ...? Ich hätte nicht gedacht, dass du so naiv bist."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t389e1767d2"
msgid "Toi qui semblait pourtant si lucide... je suis déçu."
msgstr "Du wirktest so luzid ... Ich bin enttäuscht."

#. Character:`asami` | Attributes:`mocking`
#: game/story/home_minato_basement.dialogue
msgctxt "tc8befcd22c"
msgid "{{saito.n}} ne me trahira pas même si j'ignore ce que vous entendez par là."
msgstr "{{saito.n}} würde mich nie verraten oder betrügen, auch wenn ich nicht weiß, was du mir damit sagen willst."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t531e5f4e4f"
msgid "Tu ne vois pas? Bon très bien."
msgstr "Verstehst du es nicht? In Ordnung, wie du meinst."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tf3e541cfac"
msgid "Que crois-tu qu'il fasse à cet instant ?"
msgstr "Was glaubst du, macht er gerade?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tdda906a1dc"
msgid "La ? Je ne sais pas, il fait nuit, je suppose qu'il est chez lui ?"
msgstr "Jetzt gerade? Ich weiß nicht. Es ist dunkel, also schätze ich, ist er zu Hause?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t98902f8a1e"
msgid "Faux !"
msgstr "Falsch!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t97f73fe259"
msgid "Ton cher {{saito.n}} est en train de passer du bon temps avec ta mère !"
msgstr "Dein lieber {{saito.n}} vergnügt sich gerade köstlich mit deiner Mutter!"

#. Character:`asami` | Attributes:`afraid`
#: game/story/home_minato_basement.dialogue
msgctxt "t89d11e2c34"
msgid "Avec ma mère ?!"
msgstr "Mit meiner Mutter?!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t75697c69a5"
msgid "Oui figure-toi qu'ils ont passé l'après-midi et la soirée là-bas."
msgstr "Ja, sie haben den Nachmittag und den Abend gemeinsam verbracht."

#. Character:`asami` | Attributes:`mocking`
#: game/story/home_minato_basement.dialogue
msgctxt "td20e897e94"
msgid "....wahhh effectivement je... je ne vais définitivement pas m'en remettre."
msgstr "... Wow, ehrlich gesagt, ich ... ich werde mich davon definitiv nicht erholen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t289ecf4714"
msgid "C'est terrible ! C'est affreux !"
msgstr "Das ist schrecklich! Wie grauenvoll!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t97c3078d9e"
msgid "Ils se moquent de tout !"
msgstr "Ihnen ist alles egal!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tf525792cf3"
msgid "Tu fais la maline mais pendant ce temps-là ta mère se rapproche de ton meilleur ami."
msgstr "Du spielst die Kluge, aber währenddessen macht sich deine Mutter an deinen besten Freund ran."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tedd0219159"
msgid "Tu fais la maline mais pendant ce temps-là ta mère se rapproche de ton petit ami."
msgstr "Du spielst die Kluge, aber währenddessen macht sich deine Mutter an deinen Freund ran."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t991d013a62"
msgid "La belle affaire... Je connais ma mère, c'est la première fois que je m'absente et elle a du se sentir seule et déprimée."
msgstr "Ich kenne meine Mutter. Das ist das erste Mal, dass ich weg bin und sie muss sich einsam und deprimiert gefühlt haben."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t2ce1f53048"
msgid "{{saito.n}} a certainement dû se faire embringuer dans cette histoire car il a bon fond et il ne voulait certainement pas qu'elle soit triste."
msgstr "{{saito.n}} muss zweifelsohne involviert sein, weil er ein gutes Herz hat und nicht will, dass sie traurig ist."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "taf49527b43"
msgid "D'une certaine manière... Je suis rassurée"
msgstr "Auf eine gewisse Art un Weise ... bin ich beruhigt."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t6190c7bd22"
msgid "Tu sembles confiante."
msgstr "Du wirkst selbstbewusst."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tb952f2bee0"
msgid "Evidement ! Vous ne parviendrez pas à faire plier ma volonté."
msgstr "Natürlich! Du kannst mich nicht brechen."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t693983f184"
msgid "Tu as raison... Un homme et une femme seuls... qui vont passer du temps tous les deux à créer du lien..."
msgstr "Du hast recht ... Ein einsamer Mann und eine Frau ... die beide ihre Zeit damit verbringen, ihre Beziehung zueinander zu stärken ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t771229c57e"
msgid "Que pourrait il se passer ?"
msgstr "Was könnte da schon schiefgehen?"

#. Character:`asami` | Attributes:`upset`
#: game/story/home_minato_basement.dialogue
msgctxt "tfcef30ccb5"
msgid "..."
msgstr "..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t8e13cf7851"
msgid "Bien je crois que nous avons assez discuté tous les deux..."
msgstr "Gut, ich denke, wir beide haben genug geredet ..."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "t8294e3a670"
msgid "Hey ! Apportez-moi d'autres jeux s'il vous plaît, j'ai déjà fini ceux-là..."
msgstr "Hey! Bring mir ein paar mehr Spiele, bitte! Ich hab die hier schon alle durchgespielt ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "td623cbe064"
msgid "[font_size=20]S'il vous plait...[/font_size]"
msgstr "[font_size=20]Bitte ...[/font_size]"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "ta6e619aa62"
msgid "Je verrais ce que je peux faire !"
msgstr "Ich schaue mal, was sich da machen lässt!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tfabc8a3571"
msgid "Alors tout se passe bien ici ?"
msgstr "Also, geht es hier gut voran?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "te763346485"
msgid "Très drôle ! Comment ça pourrait se passer d'après vous ?"
msgstr "Sehr lustig! Wie glaubst du denn, läuft es hier?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t560bf6b8ef"
msgid "Je constate quand même que tu as terminé la plupart des jeux que je t'ai apporté la dernière fois..."
msgstr "Ich sehe, dass du die meisten Spiele, die ich dir letztes Mal mitgebracht habe, durchgespielt hast ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t53cbb2dbe7"
msgid "En même temps... ce n'est pas comme si j'avais autre chose à faire."
msgstr "Dann wiederum ... Ist nicht so, als hätte ich etwas Besseres zu tun."

#. Character:`asami` | Attributes:`mocking`
#: game/story/home_minato_basement.dialogue
msgctxt "tacca8e07a5"
msgid "Sinon ? Votre vengeance se passe bien ?"
msgstr "Wie auch immer. Läuft dein Rachefeldzug gut?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t6a9cec4633"
msgid "Je suppose que ma mère et mon meilleur ami ont encore passé la journée ensemble ?"
msgstr "Ich schätze, meine Mutter und mein bester Freund haben den Tag wieder gemeinsam verbracht?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t7792b1b729"
msgid "Je suppose que ma mère et mon petit ami ont encore passé la journée ensemble ?"
msgstr "Ich schätze, meine Mutter und mein Freund haben den Tag wieder gemeinsam verbracht?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t011216b60e"
msgid "Tiens donc... Ça t'intéresse de le savoir à présent ?"
msgstr "Nun ja ... Willst du das wirklich wissen?"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "t82e78a9bd0"
msgid "..."
msgstr "..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t2e06e66d23"
msgid "Très bien, je ne vais pas garder le suspens plus longtemps."
msgstr "In Ordnung, ich werde dich nicht weiter auf die Folter spannen."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t0ee2a6b31e"
msgid "Ils ont été vus à la salle d'arcade toute la journée où il semble que ta mère s'est beaucoup amusée."
msgstr "Sie waren den ganzen Tag in der Spielhalle. Es sieht so aus, als hätte deine Mutter dort eine Menge Spaß gehabt."

#. Character:`asami` | Attributes:`mocking`
#: game/story/home_minato_basement.dialogue
msgctxt "td2ac6dd796"
msgid "Ca ne m'étonne pas !"
msgstr "Ich bin nicht überrascht!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "td44347c664"
msgid "Ma mère était une grande joueuse auparavant !"
msgstr "Meine Mutter war früher eine ganz hervorragende Spielerin!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tc12369c2a3"
msgid "Mon père n'aimait pas ce côté-là, elle a dû arrêter car il le lui avait demandé."
msgstr "Mein Vater mochte diese Seite von ihr nicht, also musste sie aufhören, als er sie darum bat."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t4e2dfdf242"
msgid "Je suis contente, elle s'amuse de nouveau !"
msgstr "Ich bin froh, dass sie wieder etwas Spaß hat."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t53fcde90e0"
msgid "Je vois que tu le prends plutôt bien."
msgstr "Ich sehe, du fasst das Ganze ziemlich gut auf."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tae00120060"
msgid "Je vous ai déjà dit que vous ne me briserez pas le moral !"
msgstr "Ich habe dir bereits gesagt, dass du mich nicht brechen wirst!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t3ae405bf03"
msgid "Pourtant... cela fait déjà deux jours de suite qu'ils passent la journée ensemble."
msgstr "Und doch ... Sie haben zwei Tage in Folge miteinander verbracht."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "td02d79f48d"
msgid "Des liens peuvent avoir déjà commencé à se former, tu sais..."
msgstr "Es könnte durchaus sein, dass sich bereits eine gewisse Verbindung zwischen den beiden entwickelt hat ..."

#. Character:`asami` | Attributes:`upset`
#: game/story/home_minato_basement.dialogue
msgctxt "t99d6a0b758"
msgid "...[w]J'ai confiance."
msgstr "... [w]Ich bin zuversichtlich."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t4a92b6d992"
msgid "Ahlala si naïve..."
msgstr "Achh, so naiv ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t1b3165cf65"
msgid "Laissez moi deviner ? Ils ont encore passés la journée ensemble ?"
msgstr "Lass mich raten? Sie haben den Tag wieder zusammen verbracht?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t51a42a7ca0"
msgid "J'ai de la peine pour vous quand même..."
msgstr "Du tust mir leid ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "te578d45589"
msgid "On est tout les deux la à perdre notre temps alors qu'on pourrait très bien faire autre chose."
msgstr "Wir verschwenden hier beide unsere Zeit, während wir etwas Besseres zu tun hätten."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t2fa7d86e17"
msgid "Tu n'es pas curieuse ?"
msgstr "Bist du nicht neugierig?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tc73bee5c5b"
msgid "Non."
msgstr "Nein."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t65178c61e5"
msgid "Ca fait le troisième jour de suite."
msgstr "Das ist der dritte Tag in Folge."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t9e181ee972"
msgid "Et alors ? Il y aura peut être un quatrième voir un cinquième ?"
msgstr "Na und? Vielleicht gibt es sogar einen vierten oder fünften?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t1b0b631990"
msgid "Peut-être... peut-être... mais...[w]Au troisième jour il n'est pas rentré dormir chez lui."
msgstr "Vielleicht ... vielleicht ... Aber ... [w]Am dritten Tag ist er abends nicht nach Hause gegangen, um schlafen zu gehen."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t616796f309"
msgid "Il est resté chez toi."
msgstr "Er ist dageblieben."

#. Character:`asami` | Attributes:`upset`
#: game/story/home_minato_basement.dialogue
msgctxt "t9eef5cefc2"
msgid "..."
msgstr "..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tfe96ba4440"
msgid "Un homme et une femme... seuls... dans une si grande maison... A la nuit tombée."
msgstr "Ein Mann und eine Frau ... alleine ... in so einem großen Haus ... bei Abenddämmerung."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t3e95f017f7"
msgid "Tu penses tout de même pas qu'il va simplement dormir sur le canapé pendant qu'elle dort dans sa chambre ?"
msgstr "Du glaubst doch nicht etwa, dass er auf dem Sofa geschlafen hat, während sie alleine in ihrem Bett lag, oder?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tc2a7244e78"
msgid "Tu n'es quand même pas naïve a ce point {{asami.n}} ?"
msgstr "Du bist doch sicherlich nicht so naiv, oder, {{asami.n}}?"

#. Character:`asami` | Attributes:`angry`
#: game/story/home_minato_basement.dialogue
msgctxt "t284c708a90"
msgid "Je...[w]Je n'ai pas envie d'en savoir plus..."
msgstr "Ich ... [w]Ich will es nicht mehr wissen ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t5cf5030a5f"
msgid "Je n'ai aucun moyen de savoir si ce que vous dites est la vérité ou pas !"
msgstr "Ich habe keine Möglichkeit, zu beurteilen, ob du die Wahrheit sagst oder nicht!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tbe9fc61b54"
msgid "Donc jusqu'à preuve du contraire tout ce que vous direz sera considéré comme un mensonge."
msgstr "Also werde ich, bis du mir das Gegenteil beweist, alles, was du sagst, für eine Lüge halten."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tdc9be53bff"
msgid "Je vois, je vois... Je comprend."
msgstr "Verstehe, verstehe ... In Ordnung."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t296cefe20b"
msgid "Je suis comme toi aussi, j'aime bien croire ce que je vois."
msgstr "Ich bin genau wie du. Ich glaube auch nur das, was ich selbst sehe."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "te590233294"
msgid "Les faits rien que les faits !"
msgstr "Fakten, nichts als Fakten!"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "t680196b76d"
msgid "Si vous avez compris laissez moi tranquille..."
msgstr "Wenn du mich doch so gut verstehst, lass mich alleine ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t99a686e51a"
msgid "C'est pour ça qu'on à des photos !"
msgstr "Deshalb haben wir Fotos!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t6b78a40ccb"
msgid "..."
msgstr "..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t3e8b082964"
msgid "Regarde ! Ca c'est eux au parc !"
msgstr "Schau es dir an! Das sind sie im Park!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "ta2ba1b1740"
msgid "Dans la grande roue en train de s'embrasser !"
msgstr "Da küssen sie sich auf dem Riesenrad!"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "teba4cbc7c3"
msgid "..."
msgstr "..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "ET_LES_VOILA_DANS_LA_GRANDE_RO_7774EB"
msgid "Et les voila dans la grande roue en train de s'embrasser."
msgstr "Und da sind sie, knutschend auf dem Riesenrad."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "TON_PETIT_AMI_S_OCCUPE_VRAIMEN_073D42"
msgid "Ton petit ami s'occupe vraiment bien de ta mère..."
msgstr "Dein Freund kümmert sich wirklich gut um deine Mutter ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t90eaa2459e"
msgid "Dans la grande roue !"
msgstr "Auf dem Riesenrad!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tfcdcd8cfff"
msgid "Ca c'est eux dans une ruelle sombre... Je ne sais pas ce qu'ils se disent mais ça semble très intense."
msgstr "Das sind sie in einer dunklen Seitengasse ... Ich weiß nicht, was sie einander sagen, aber es sieht ziemlich intensiv aus."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t0f42f3aadd"
msgid "Et enfin les voici a la maison, tous les deux nus dans la salle de bain!"
msgstr "Und da sind sie zu Hause, beide nackt im Badezimmer!"

#. Character:`asami` | Attributes:`angry`
#: game/story/home_minato_basement.dialogue
msgctxt "t53c6735264"
msgid "Je rêve ! Vous avez mis des caméras chez moi ?"
msgstr "Ist das dein Ernst?! Du hast Kameras bei mir zu Hause versteckt?!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t28c11de615"
msgid "Vous êtes vraiment le pire !"
msgstr "Du bist wirklich das widerlichste Schwein, das man sich auch nur vorstellen kann!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "teabebb29ca"
msgid "Oh mais je l'assume ! Je suis effectivement le pire !"
msgstr "Oh, absolut habe ich das! Ich bin durchaus ziemlich widerlich!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t83edf875b9"
msgid "D'ailleurs sans ça... je n'aurais pas eu ces images de ta mère et ton meilleur ami en train de... Bref, vois par toi même !"
msgstr "Abgesehen davon, wenn ich das nicht getan hätte ... dann besäße ich nicht diese Bilder von deiner Mutter und deinem besten Freund, wie sie miteinander schlafen ... Wie auch immer, sieh selbst!"

#. Character:`asami` | Attributes:`mocking`
#: game/story/home_minato_basement.dialogue
msgctxt "tdbd67f2d69"
msgid "Non ! Peu importe ce qu'il se passe, vous ne me briserez pas le moral !"
msgstr "Nein! Was auch immer passieren mag, du wirst mich nicht brechen!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "te6d2591f80"
msgid "Ma mère est grande elle peut faire ce qu'elle veut et {{saito.n}} est juste un ami et s'il rend ma mère heureuse alors tant mieux, ce sera toujours mieux que d'avoir un père incapable et toujours absent."
msgstr "Meine Mutter ist eine erwachsene Frau. Sie darf tun, was sie will. Abgesehen davon ist {{saito.n}} nur ein Freund und wenn er meine Mutter glücklich macht, dann umso besser! Immer noch besser, als ein Vater, der sich um nichts kümmert und dauernd weg ist."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "OH_L_ON_A_UNE_BELLE_VUE_0F2E84"
msgid "Oh là, on a une belle vue !"
msgstr "Wow, was für eine schöne Aussicht!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "CAUSE_DE_LA_BU_E_ON_NE_VOYAIT_C8C26F"
msgid "À cause de la buée, on ne voyait pas grand-chose dans la salle de bain."
msgstr "Im Bad war zu viel Dampf, um etwas zu erkennen."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "MAIS_ILS_ONT_FAIT_A_DANS_LE_SA_640766"
msgid "Mais ils ont fait ça dans le salon..."
msgstr "Aber schau mal, was sie im Wohnzimmer getrieben haben ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "L_ENFOIR_L_ESP_CE_DE_C832D7"
msgid "L'enfoiré ! L'espèce de..."
msgstr "Dieser Wichser! Dieser verdamme–"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "ET_JE_NE_TE_PARLE_M_ME_PAS_DE_BFF17C"
msgid "Et je ne te parle même pas de ce qu’ils ont fait dans la chambre !"
msgstr "Und ich werde dir lieber nicht sagen, was im Schlafzimmer abgegangen ist!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_DOIS_RECONNA_TRE_QUE_JE_SUI_D8D7F5"
msgid "Je dois reconnaître que je suis admirable devant tant d’endurance."
msgstr "Ich muss zugeben, dass ich von seiner Ausdauer ziemlich beeindruckt bin."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "ON_A_D_J_PLUSIEURS_HEURES_DE_V_F3562A"
msgid "On a déjà plusieurs heures de vidéos... Si tu veux les visionner par toi-même pour être certaine."
msgstr "Wir haben bereits mehrere Stunden Bildmaterial ... Falls du es dir selbst ansehen willst, um sicher zu gehen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "ARR_TEZ_809054"
msgid "Arrêtez.. !"
msgstr "Hör auf damit ...!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_AURAIS_R_ELLEMENT_PU_PARTIR_4DC20F"
msgid "Tu aurais réellement pu partir quelques jours et tout ça n’aurait rien changé."
msgstr "Du hättest wirklich für ein paar Tage verreisen können und es hätte keinen Unterschied gemacht."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "TA_M_RE_ET_TON_PETIT_AMI_AURAI_B30FA4"
msgid "Ta mère et ton petit ami auraient inévitablement couché ensemble dans ton dos !"
msgstr "Deine Mutter und dein Freund hätten in jedem Fall hinter deinem Rücken miteinander geschlafen!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "STOP_0603E9"
msgid "Stop !"
msgstr "Stopp!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "CETTE_SITUATION_AURAIT_PU_DURE_89FD6E"
msgid "Cette situation aurait pu durer des années sans que tu t’en aperçoives !"
msgstr "Das hätten sie noch Jahre so treiben können, ohne dass du es überhaupt merkst!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "MAIS_ARR_TEZ_BON_SANG_9325BD"
msgid "MAIS ARRÊTEZ, BON SANG !"
msgstr "VERDAMMT NOCHMAL, DU SOLLST AUFHÖREN, HAB ICH GESAGT!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_VEUX_BIEN_ARR_TER_MAIS_TU_D_8D527F"
msgid "Je veux bien arrêter... Mais tu dois reconnaître par toi-même que ta propre mère et ton petit ami..."
msgstr "Sehr gerne ... Aber du musst zugeben, dass deiner Mutter und deinem Freund ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "EX_PETIT_AMI_684D8D"
msgid "EX-PETIT AMI !"
msgstr "EXFREUND!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "D_ACCORD_W_ET_TON_EX_PETIT_AMI_08DEF5"
msgid "D’accord...[w] et ton ex-petit ami, n’ont que faire de tes sentiments."
msgstr "Okay ... [w]Deinem Exfreund deine Gefühle scheißegal sind."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "J_AI_MAL_AU_C_UR_J_AI_JUSTE_EN_28F4D3"
msgid "J’ai mal au cœur... J’ai juste envie de mourir..."
msgstr "Mir ist schlecht ... Ich will einfach nur verrecken ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "CE_SERAIT_TELLEMENT_TRISTE_SI_01F48A"
msgid "Ce serait tellement triste... Si tu fais ça, ils continueront leur vie de leur côté pendant que {{saito.n}} réconfortera ta mère."
msgstr "Das wäre wirklich traurig ... Wenn du das tust, werden sie einfach mit ihren Leben weitermachen, während sich {{saito.n}} um deine Mutter kümmert."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_VEUX_SEULEMENT_QUE_A_S_ARR_DA4025"
msgid "Je veux seulement que ça s’arrête !"
msgstr "Ich will einfach nur, dass es aufhört!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "S_IL_VOUS_PLA_T_0C8369"
msgid "S’il vous plaît...!"
msgstr "Bitte ...!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "J_AI_UNE_SOLUTION_DANS_CE_CAS_4BF60B"
msgid "J’ai une solution dans ce cas..."
msgstr "In dem Fall habe ich eine Lösung ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "QU_EST_CE_QUE_C_EST_F88FDF"
msgid "Qu’est-ce que c’est ?"
msgstr "Die da wäre?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "LE_X3_JE_SUPPOSE_QUE_TU_EN_AS_40B850"
msgid "Le X3... Je suppose que tu en as entendu parler ?"
msgstr "X3 ... Ich schätze, du hast davon gehört?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "OUI_MAIS_JE_NE_VEUX_PAS_JE_NE_32019A"
msgid "Oui... Mais je ne veux pas... Je ne serai plus moi... après ça..."
msgstr "Ja ... Aber ich will nicht ... Ich wäre nicht mehr ich selbst ... danach ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "COUTE_MOI_BIEN_ASAMI_N_RIEN_N_F18E7B"
msgid "Écoute-moi bien {{asami.n}}, rien ne dit qu’ils te laisseront en vie... Tu en sais déjà beaucoup trop."
msgstr "Hör mir gut zu, {{asami.n}}. Keiner kann dir garantieren, dass sie dich am Leben lassen ... Du weißt bereits viel zu viel."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "IMAGINE_QU_ILS_TE_DONNENT_LA_D_DD6C5D"
msgid "Imagine qu’ils te donnent la drogue et qu’ils t’obligent à rester toute ta vie à la botte d’un type horrible ?"
msgstr "Stell dir vor, sie geben dir die Droge und du musst irgendeinem Arschloch für den Rest deines Lebens gehorchen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "COMME_VOUS_PAR_EXEMPLE_A76A1E"
msgid "Comme vous par exemple ?"
msgstr "Ein Arschloch wie du, zum Beispiel?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "AI_JE_VRAIMENT_T_AUSSI_HORRIBL_4FC44D"
msgid "Ai-je vraiment été aussi horrible que ça ?"
msgstr "Bin ich wirklich so schlimm?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "CE_N_EST_PAS_LA_MEILLEURE_CAPT_D06682"
msgid "Ce n’est pas la meilleure captivité de ta vie ? J’ai fait un effort pour que tu ne t’ennuies pas, tu pourrais au moins le reconnaître..."
msgstr "Ist das nicht die beste Entführung, die du haben kannst? Ich sorge dafür, dass du dich nicht langweilst, wenigstens das könntest du zu schätzen wissen ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "C_EST_VRAI_95D43F"
msgid "C’est vrai..."
msgstr "Hast ja Recht ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "ACCEPTE_DE_PRENDRE_LA_PILULE_E_94FAB3"
msgid "Accepte de prendre la pilule et viens avec moi, non seulement tu échappes à {{minato.n}} et à ce qu’il a prévu d’horrible pour toi..."
msgstr "Nimm die Tablette und komm mit mir. Du wirst nicht nur vor {{minato.n}} und seinen sinisteren Plänen sicher sein ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "MAIS_EN_PLUS_TU_RETROUVES_TA_L_1EAE78"
msgid "Mais en plus tu retrouves ta liberté et tu auras quelqu’un pour te soutenir face à ta mère et ton ex."
msgstr "Du wirst sogar deine Freiheit wiederhaben und bekommst jemanden, der dich unterstützt, wenn du deine Mutter und deinen Ex wiedersiehst."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "LE_X3_TE_FERA_OUBLIER_LA_PEINE_FAF965"
msgid "Le X3 te fera oublier la peine de la rupture et en plus tu seras heureuse."
msgstr "X3 wird dafür sorgen, dass du den Trennungsschmerz und Liebeskummer vergisst. Du wirst sogar richtig glücklich sein."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_NE_FAUT_PAS_AVOIR_PEUR_EC6615"
msgid "Il ne faut pas avoir peur."
msgstr "Du brauchst keine Angst zu haben."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "LE_X3_EST_LITT_RALEMENT_TA_SEU_999BDA"
msgid "Le X3 est littéralement ta seule échappatoire !"
msgstr "Das X3 ist dein einziger Ausweg!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_8B9E30"
msgid "Je..."
msgstr "Ich ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_TE_PROMETS_QUE_JE_M_OCCUPER_A4EB52"
msgid "Je te promets que je m’occuperai de toi et que tu ne manqueras jamais de rien !"
msgstr "Ich verspreche dir, dass ich mich um dich kümmern werde und es dir an nichts fehlt."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "W_C_EST_D_ACCORD_E9CD77"
msgid "...[w] C’est d’accord..."
msgstr "... [w]Okay ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "C_EST_LA_BONNE_D_CISION_528D42"
msgid "C’est la bonne décision !"
msgstr "Gute Wahl!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "MAIS_J_AI_UNE_CONDITION_W_JE_V_500209"
msgid "Mais j’ai une condition ![w] Je veux que... que ce qui se passe entre nous après soit... filmé. Je veux qu’il culpabilise toute sa vie !"
msgstr "Aber ich habe eine Bedingung! [w]Ich will, dass ... alles, was zwischen uns passiert, aufgenommen wird. Ich will, dass er sich für den Rest seines Lebens schuldig fühlt."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_POURRAS_M_ME_LUI_APPORTER_E_CE73E5"
msgid "Tu pourras même lui apporter en main propre si tu veux !"
msgstr "Du kannst ihm die Aufnahmen sogar selbst überreichen, wenn du willst!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "DE_TOUTE_FA_ON_C_EST_A_OU_LA_M_33A275"
msgid "De toute façon, c’est ça ou... la mort, je suppose."
msgstr "Entweder das oder ... der Tod, schätze ich."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_SUIS_D_SOL_QUE_LA_VIE_AIT_T_CD7450"
msgid "Je suis désolé que la vie ait tourné comme ça pour toi..."
msgstr "Tut mir leid, dass sich die Dinge so für dich entwickelt haben ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "C_EST_BON_DONNEZ_MOI_CE_TRUC_Q_E1E180"
msgid "C’est bon, donnez-moi ce truc qu’on en finisse !"
msgstr "Na dann, gib mir dieses verdammte Zeug endlich, damit wir’s schnell hinter uns haben!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tc59db30bcf"
msgid "Je suis sur que si on attend encore quelques jours, j'aurais des trucs sympa a te montrer !"
msgstr "Ich bin mir sicher, wenn wir noch ein paar Tage warten, habe ich dir ein paar coole Sachen zu zeiegn!"

#. Character:`asami` | Attributes:`mocking`
#: game/story/home_minato_basement.dialogue
msgctxt "tbe6040ab2e"
msgid "Non ! Peu importe ce qu'il se passe, vous ne me briserez pas le moral !"
msgstr "Nein! Was auch immer passieren mag, du wirst mich nicht brechen!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tf3985c984b"
msgid "J'ai confiance en {{saito.n}} ! Je sais qu'il ne fera rien de tel !"
msgstr "Ich vertraue {{saito.n}}! Ich weiß, dass er nichts dergleichen tun würde!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t0527a025a7"
msgid "Très bien comme tu voudras..."
msgstr "Sehr wohl, wie du wünschst ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t96c512d22f"
msgid "Je te laisse seule avec tes pensées !"
msgstr "Ich lasse dich mit deinen Gedanken dann mal alleine!"

#. Character:`asami` | Attributes:`upset`
#: game/story/home_minato_basement.dialogue
msgctxt "t3e2cafe7a4"
msgid "Une seconde !"
msgstr "Eine Sekunde!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tec13573c2b"
msgid "Quoi ?"
msgstr "Was?"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "t3bfdba1301"
msgid "Apportez moi d'autre jeux, j'ai fini ceux là !"
msgstr "Bring mir mehr Spiele mit! Ich habe die hier durchgespielt!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "tebf16ddd57"
msgid "...."
msgstr "..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tabea73485c"
msgid "{{natsume.n}} qu'est ce que tu fais là ?!"
msgstr "{{natsume.n}}, was suchst du hier?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t412933abac"
msgid "Tu es venue pour me lib-"
msgstr "Bist du gekommen, um mich zu befrei-"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "tfd75881431"
msgid "Désolé mais je ne suis pas venu pour ça !"
msgstr "Sorry, aber deswegen bin ich nicht hier!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t50250f9c58"
msgid "C'est le moment ?"
msgstr "Ist es an der Zeit?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "t41070439a8"
msgid "Oui..."
msgstr "Ja ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "ta1c809c177"
msgid "Bon sang j'attend ça depuis trop longtemps !"
msgstr "Verdammt, ich habe viel zu lange auf das hier gewartet!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tf84cccc409"
msgid "{{natsume.n}}... Qu'est ce que tu fais ? Je pensais que nous étions..."
msgstr "{{natsume.n}} ... Was tust du? Ich dachte, wir wären ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "t18aad2d043"
msgid "amies ?"
msgstr "Freunde?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "te55e1177a1"
msgid "Dans une autre vie ça aurait pu se faire... Mais maintenant c'est trop tard."
msgstr "In einem anderen Leben vielleicht ... Aber jetzt ist es zu spät."

#. Character:`asami` | Attributes:`upset`
#: game/story/home_minato_basement.dialogue
msgctxt "t6e61abc92d"
msgid "C'est pas trop tard, détache moi et j'oublierais tout ça c'est promis !"
msgstr "Es ist nicht zu spät. Mach mich los und ich vergesse das alles, versprochen!"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "td0f6becafa"
msgid "S'il vous plait... Laissez moi rentrer chez moi.... Je vous en prie..."
msgstr "Bitte ... lass mich nach Hause gehen ... Bitte ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "tee2b2741cb"
msgid "Fait lui prendre sa première dose !"
msgstr "Lass sie die erste Dosis nehmen!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "tc3b72a6083"
msgid "Je ne prendrais pas ce truc !"
msgstr "Ich werde dieses Zeug nicht nehmen!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t4a934fad8f"
msgid "Personne ne t'a demande ton avis !"
msgstr "Niemand hat dich nach deiner Meinung gefragt!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t6a3b82648e"
msgid "Non ![w]NOOOON ![w] ARRETEZ !"
msgstr "Nein! [w]NEEEIIIIIN! [w]STOPP!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t9ee17d094b"
msgid "{{natsume.n}} !!!!"
msgstr "{{natsume.n}}!!!!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "t5e0b7a179f"
msgid "..."
msgstr "..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t2c81f2c61d"
msgid "Et maintenant ?"
msgstr "Was jetzt?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "taa46047957"
msgid "Attache la sur le lit et prend la photo !"
msgstr "Fessel sie ans Bett und mach das Foto!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t0a1baa28d8"
msgid "Plutôt mourir !"
msgstr "...[w] Lieber sterbe ich."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "t5f026e745a"
msgid "Allons, ne dis pas bêtises comme ça, personne ne veux ta mort ici !"
msgstr "Komm schon, red keinen Unsinn! Niemand will dich hier krepieren sehen!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "t8b03dd6685"
msgid "Crois moi avec ce qui va lui arriver à l'avenir, la mort est préférable."
msgstr "Glaub mir, angesichts dessen, was dich erwartet, wäre der Tod eine Erlösung."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "ta281782833"
msgid "Comment ça ?!!! Qu'est ce qui va m'arriver ?!!"
msgstr "Was meinst du damit?! Was hast du mit mir vor?!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t67766e1e3b"
msgid "Sortez moi d'ici !!!"
msgstr "Bring mich hier raus!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "t111ea7d0cc"
msgid "{{natsume.n}} !!!!"
msgstr "{{natsume.n}}!!!!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "QU_EST_CE_QUE_TU_ES_VENUE_FAIR_8E3615"
msgid "Qu'est-ce que tu es venue faire, traîtresse ?!"
msgstr "Warum bist du hierher gekommen, Verräter?!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "TE_MOQUER_DE_MOI_8A6D4D"
msgid "Te moquer de moi ?"
msgstr "Um mich zu verhöhnen?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "NON_CE_N_EST_PAS_MON_STYLE_3FEF71"
msgid "... Non, ce n'est pas mon style."
msgstr "... Nein, das ist nicht meine Art."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_SUIS_JUSTE_VENUE_TE_TENIR_A_691203"
msgid "Je suis juste venue te tenir au courant de ce qui se passe en ce moment."
msgstr "Ich bin nur gekommen, um dich wissen zu lassen, was gerade vor sich geht."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TA_M_RE_A_ENFIN_APPRIS_LA_V_RI_BB6D40"
msgid "Ta mère a enfin appris la vérité."
msgstr "Deine Mutter hat endlich die Wahrheit gelernt."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "ET_COMMENT_VA_T_ELLE_D56BBC"
msgid "... Et comment va-t-elle ?"
msgstr "... Und wie geht es ihr?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "C_EST_TOI_QUI_ES_DANS_UNE_SITU_125B26"
msgid "C'est toi qui es dans une situation critique et tu t'inquiètes pour les autres ?"
msgstr "Du befindest dich in einer prekären Situation und sorgst dich um andere?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "OUAIS_C_EST_TOUT_MOI_A_D_SOL_E_FE3146"
msgid "Ouais, c'est tout moi, ça... Désolée d'avoir conservé mon humanité."
msgstr "Ja, so bin ich eben ... Tut mir leid, dass in mir noch ein wenig Menschlichkeit übriggeblieben ist."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "LAISSE_MOI_PARTIR_NATSUME_N_S_8DC34C"
msgid "Laisse-moi partir, {{natsume.n}}... S'il te plaît !"
msgstr "Lass mich gehen, {{natsume.n}} ... Bitte, lass mich gehen!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "NE_ME_REGARDE_PAS_COMME_A_TU_N_1A5945"
msgid "Ne me regarde pas comme ça, tu n'obtiendras rien de moi."
msgstr "Schau mich nicht so an. Du wirst mich nicht weichkriegen."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "IMAGINE_QUE_JE_TE_LAISSE_PARTI_4CB47E"
msgid "Imagine que je te laisse partir comme tu me le demandes ? Que crois-tu qu'il va se passer ?"
msgstr "Stell dir vor, ich würde dich einfach ziehen lassen. Was glaubst du, würde passieren?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_N_EN_SAIS_RIEN_JE_N_AI_PAS_25A9A9"
msgid "Je n'en sais rien... Je n'ai pas réfléchi jusque-là..."
msgstr "Ich weiß nicht ... So weit habe ich nicht gedacht ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TOUTES_LES_TRACES_SERONT_EFFAC_71B46C"
msgid "Toutes les traces seront effacées : toi, moi, {{saito.n}}, ta mère..."
msgstr "Alle Spuren werden ausgelöscht: du, ich, {{saito.n}}, deine Mutter ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TOUT_CE_QUI_A_UN_LIEN_DE_PR_S_170B1F"
msgid "Tout ce qui a un lien de près ou de loin avec toi sera impacté."
msgstr "Jeder, der auch nur im Entferntesten etwas mit dir zu tun hat, wird betroffen sein."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "POURQUOI_MOI_6E5328"
msgid "... Pourquoi moi ?"
msgstr "... Warum ich?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_N_EN_SAIS_RIEN_POURQUOI_CER_E1F524"
msgid "Je n'en sais rien... Pourquoi certains enfants meurent-ils du cancer ?"
msgstr "Ich weiß nicht ... Warum sterben manche Kinder an Krebs?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_PENSES_QU_IL_Y_A_UNE_RAISON_501940"
msgid "Tu penses qu'il y a une raison ?"
msgstr "Glaubst du, es gibt einen Grund?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "BIEN_S_R_QUE_NON_3E9792"
msgid "Bien sûr que non !!"
msgstr "Natürlich nicht!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_TAIS_JUSTE_L_AU_MAUVAIS_END_9F7A33"
msgid "Tu étais juste là au mauvais endroit, au mauvais moment !"
msgstr "Du warst nur zur falschen Zeit am falschen Ort!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "ET_PLUS_VITE_TU_ACCEPTERAS_CE_03AA71"
msgid "Et plus vite tu accepteras ce qui t'attend..."
msgstr "Und je früher du dein Schicksal akzeptierst ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "MIEUX_CE_SERA_40D071"
msgid "Mieux ce sera..."
msgstr "Desto besser ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "VOUS_TES_DES_MONSTRES_2E6E33"
msgid "Vous êtes des monstres..."
msgstr "Ihr seid Monster ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_SUIS_D_SOL_E_POUR_TOI_MAIS_9C51C3"
msgid "Je suis désolée pour toi, mais il est temps que tu prennes ta seconde dose."
msgstr "Du tust mir leid, aber es ist an der Zeit für deine zweite Dosis."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "JAMAIS_DE_LA_VIE_J_AVALERAI_CE_E035C2"
msgid "Jamais de la vie j'avalerai ce truc ! Je préférerais mourir !"
msgstr "Niemals werde ich dieses Zeugs schlucken! Lieber sterbe ich!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "PFFFF_TU_N_AS_TOUJOURS_PAS_COM_71ADE1"
msgid "Pffff... Tu n'as toujours pas compris dans quelle situation tu te trouves ?"
msgstr "Tss ... Du hast es immer noch nicht verstanden?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "NATSUME_N_JE_PENSAIS_QUE_NOUS_AAD348"
msgid "{{natsume.n}}... Je pensais que nous étions amies ! Ça ne signifie rien pour toi ?"
msgstr "{{natsume.n}} ... Ich dachte, wir wären Freunde! Bedeutet das dir nichts?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "OH_BON_SANG_T_ES_ENCORE_COINC_761DB8"
msgid "Oh bon sang, t'es encore coincée là-dessus ? Réveille-toi un peu !"
msgstr "Oh Mann, du hängst dich immer noch daran auf? Wach auf, Verdammt!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_NE_CROIS_PAS_AU_CONCEPT_DE_86FE1F"
msgid "Je ne crois pas au concept de l'amitié !"
msgstr "Ich glaube nicht an Freundschaft!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "C_EST_LA_CHOSE_LA_PLUS_TRISTE_58E78A"
msgid "C'est la chose la plus triste et surtout la plus fausse que j'ai jamais entendue !"
msgstr "Das ist das Traurigste und Bemitleidenswerteste, das ich je gehört habe."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "COMMENT_T_EXPLIQUER_A_W_IL_Y_A_BE1904"
msgid "Comment t'expliquer ça ?[w] Il y a seulement des rapports de force ou des intérêts communs."
msgstr "Wie soll ich dir das nur erklären? [w]Es gibt nur Machtverhältnisse oder gemeinsame Interessen."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "LES_GENS_AIMENT_S_ENTOURER_PAR_61D26A"
msgid "Les gens aiment s'entourer par peur de rester seuls, personne n'est vraiment ce qu'il prétend être, tout n'est que mensonge."
msgstr "Menschen umgeben sich mit anderen aus der Angst heraus, alleine zu sein. Keiner ist wirklich, wer er vorgibt zu sein – es ist alles nur eine Lüge."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "J_AI_DE_LA_PEINE_POUR_TOI_E10741"
msgid "J'ai de la peine pour toi..."
msgstr "Tu tust mir leid ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "W_TU_FERAIS_MIEUX_DE_T_INQUI_3C0CD7"
msgid "...[w]Tu ferais mieux de t'inquiéter pour ta vie à toi."
msgstr "... [w]Du solltest lieber dir selbst leidtun."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "POURQUOI_QU_ALLEZ_VOUS_FAIRE_D_4CB269"
msgid "Pourquoi ? Qu'allez-vous faire de moi ?"
msgstr "Warum? Was hast du mit mir vor?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "AUX_ENCH_RES_LE_PLUS_RICHE_POU_74D936"
msgid "Aux enchères... Le plus riche pourra te ramener chez lui, où tu deviendras sa chose."
msgstr "Bei einer Auktion ... wird dich der reichste Mann nach Hause nehmen, wo du sein Eigentum wirst."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "HAHAHA_AUCUN_MOYEN_QUE_J_ACCEP_070167"
msgid "Hahaha ! Aucun moyen que j'accepte un truc pareil !"
msgstr "Hahaha! Niemals würde ich so etwas akzeptieren!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_AS_VISIBLEMENT_LA_M_MOIRE_C_EF4D00"
msgid "Tu as visiblement la mémoire courte... Non seulement tu vas l'accepter, mais en plus tu en redemanderas."
msgstr "Du hast offensichtlich nicht zugehört ... Du wirst es nicht nur akzeptieren, sondern auch noch nach mehr fragen."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_AS_OUBLI_CES_PILULES_QUE_TU_A075DB"
msgid "Tu as oublié ? Ces pilules que tu prends ne sont pas n'importe quelle drogue."
msgstr "Hast du es vergessen? Diese Tabletten, die du nimmst, sind nicht nur irgendeine Droge."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "LE_X3_EST_SUFFISAMMENT_FORT_PO_E0DE9C"
msgid "Le X3 est suffisamment fort pour altérer la chimie du cerveau définitivement... Vois-le comme un philtre d'amour moderne."
msgstr "X3 ist stark genug, um dein Hirn dauerhaft umzuprogrammieren ... Betrachte es als Liebestrank."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "QUAND_TU_VERRAS_TON_NOUVEAU_PR_F80BCC"
msgid "Quand tu verras ton nouveau propriétaire, tu tomberas tellement amoureuse de lui que tu feras tout pour exaucer le moindre de ses désirs."
msgstr "Wenn du deinen neuen Meister siehst, wirst du dich so unsterblich in ihn verlieben, dass du bereit bist, alles für ihn zu ertragen."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_EN_OUBLIERAS_M_ME_CEUX_QUE_7BD342"
msgid "Tu en oublieras même ceux que tu aimais auparavant."
msgstr "Du wirst sogar deine einstigen Geliebten vergessen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "Y_A_PAS_MOYEN_QUE_ED2BF4"
msgid "Y'a pas moyen que..."
msgstr "Niemals ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_FAUT_JUSTE_3_DOSES_POUR_QUE_A3ABB0"
msgid "Il faut juste 3 doses pour que ça fonctionne, et c'est le moment de prendre la seconde !"
msgstr "Du brauchst nur drei Dosen, damit es funktioniert und jetzt ist es an der Zeit für die zweite!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "NOOOON_NON_7A7499"
msgid "Noooon ! Non !"
msgstr "Neiiiiin! Nein!"

#. Character:`netoru` | Attributes:`frustrated`
#: game/story/home_minato_basement.dialogue
msgctxt "CE_N_TAIT_PAS_CENS_SE_PASSER_C_F7D406"
msgid "Ce n'était pas censé se passer comme ça !"
msgstr "So sollte es nicht ablaufen!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "QUOI_DONC_BD9CF9"
msgid "Quoi donc ?"
msgstr "Was ist los?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_TAIT_CENS_ME_LAISSER_CETTE_51229E"
msgid "Il était censé me laisser cette fille !"
msgstr "Er sollte mir das Mädchen überlassen!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_NE_SUIS_PAS_AU_COURANT_DE_V_34EE2D"
msgid "Je ne suis pas au courant de vos affaires !"
msgstr "Ich weiß von keiner Abmachung!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "SI_TU_AS_UN_PROBL_ME_AVEC_A_JE_BEF5DF"
msgid "Si tu as un problème avec ça je te suggère d'allez lui en parler."
msgstr "Wenn du ein Problem damit hast, schlage ich vor, dass du mit ihm redest."

#. Character:`netoru` | Attributes:`arrogant`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_NE_VAIS_PAS_ME_G_NER_F49F1B"
msgid "Je ne vais pas me gêner !"
msgstr "Ich werde mich nicht zurückhalten!"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "COMMENT_VA_NOTRE_PETITE_LAPINE_4ADE44"
msgid "Comment va notre petite lapine ?"
msgstr "Wie geht’s unserem kleinen Häschen?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "_D52489"
msgid "... !"
msgstr "...!"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "BIEN_J_AI_UNE_BONNE_NOUVELLE_T_7A5720"
msgid "Bien, j'ai une bonne nouvelle à t'annoncer !"
msgstr "Nun, ich habe gute Neuigkeiten für dich!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "VOUS_ALLEZ_ENFIN_ME_LAISSER_RE_3EF502"
msgid "Vous allez enfin me laisser rentrer chez moi ?"
msgstr "Lässt du mich endlich nach Hause gehen?"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "TECHNIQUEMENT_OUI_TU_POURRAS_B_E8BFC3"
msgid "Techniquement, oui... Tu pourras bientôt aller dans ta nouvelle maison."
msgstr "Im Grunde schon ... Du wirst bald dein neues Zuhause kennenlernen."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "TON_FUTUR_PROPRI_TAIRE_A_T_D_C_058C1E"
msgid "Ton futur propriétaire a été décidé. Dans quelques jours, tu n'auras plus qu'une idée en tête, et ce sera d'exaucer le moindre de ses désirs."
msgstr "Dein künftiger Besitzer wurde gewählt. In ein paar Tagen wirst du nur noch eine Sache im Kopf haben: Jeden seiner Wünsche zu befriedigen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "VA_TE_FAIRE_VOIR_02A8A9"
msgid "Va te faire voir !"
msgstr "Fick dich!"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "AIMERAIS_TU_AVOIR_DES_NOUVELLE_4BEFEA"
msgid "Aimerais-tu avoir des nouvelles de {{saito.n}} ?"
msgstr "Willst was Neues von {{saito.n}} hören?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "_5254CA"
msgid "..."
msgstr "..."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_VAIS_PRENDRE_CE_SILENCE_POU_666C23"
msgid "Je vais prendre ce silence pour un oui."
msgstr "Ich werte dein Schweigen als ein Ja."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "EH_BIEN_FIGURE_TOI_QU_IL_EST_E_7EACAB"
msgid "Eh bien, figure-toi qu'il est en ce moment même activement recherché par la police pour... ton meurtre."
msgstr "Nun, nach ihm wird gerade von der Polizei gefahndet ... wegen Mordes an dir."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "MAIS_JE_SUIS_TOUJOURS_8CC2A8"
msgid "Mais je suis toujours..."
msgstr "Aber ich bin doch noch ..."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "VIVANTE_OUI_CERTAINEMENT_MAIS_1CC6B6"
msgid "Vivante ? Oui, certainement, mais manipuler l'opinion publique est plutôt simple."
msgstr "Am Leben? Ja, definitiv, aber die öffentliche Meinung zu manipulieren ist ziemlich einfach."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "QU_EST_CE_QU_A_FAIT_SAITO_N_PO_4DE8F5"
msgid "Qu'est-ce qu'a fait {{saito.n}} pour que tu t'acharnes autant sur lui ?"
msgstr "Was zur Hölle hat {{saito.n}} dir getan, dass du es so auf ihn abgesehen hast?"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_NE_M_A_RIEN_FAIT_MAIS_J_AIM_E1C159"
msgid "Il ne m'a rien fait, mais j'aime le voir se débattre de toutes ses forces, comme quelqu'un en train de se noyer."
msgstr "Er hat mir gar nichts angetan, aber ich liebe es, ihm beim Versuch, dich zu retten zuzusehen. Als würde er langsam, aber sicher ertrinken."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_ES_VRAIMENT_LA_PIRE_DES_RAC_CA6749"
msgid "Tu es vraiment la pire des raclures !"
msgstr "Du bist wirklich der abscheulichste Drecksack, der mir je unter die Augen gekommen ist!"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "ET_LE_MEILLEUR_DANS_TOUT_A_C_E_149383"
msgid "Et le meilleur dans tout ça, c'est que dès qu'ils lui tomberont dessus, tu peux être certaine qu'on le mettra dans le couloir de la mort. Mais si ça peut te rassurer, on lui enverra des vidéos de toi avec ton nouveau maître."
msgstr "Und das beste ist, sobald sie ihn gefangen haben, kommt er bestimmt in den Todestrakt. Aber wenn’s dich aufheitert: Wir schicken ihm dann gerne Fotos von dir mit deinem neuen Meister."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "A_LUI_REDONNERA_DU_BAUME_AU_C_75B3E3"
msgid "Ça lui redonnera du baume au cœur."
msgstr "Das wird ihn schon aufmuntern."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "J_AI_M_ME_PLUS_LES_MOTS_POUR_D_C451F5"
msgid "J'ai même plus les mots pour dire à quel point tu me dégoûtes."
msgstr "Man kann nicht in Worte fassen, wie sehr du mich anwiderst."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_PARA_T_QUE_TU_FAIS_BEAUCOUP_410243"
msgid "Il paraît que tu fais beaucoup de bruit, que se passe-t-il ?"
msgstr "Ich habe gehört, du hast hier ordentlich Radau gemacht. Was ist passiert?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_NE_SAIS_PAS_MOI_PEUT_TRE_PA_59B30A"
msgid "Je ne sais pas, moi... Peut-être parce que j’ai été kidnappée ?"
msgstr "Ich weiß auch nicht ... Vielleicht dass ich entführt wurde?!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "ARR_TE_A_TU_NE_TE_RENDS_PAS_SE_43E824"
msgid "Arrête ça, tu ne te rends pas service."
msgstr "Lass das. Du tust dir damit keinen Gefallen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "POURQUOI_JE_T_COUTERAIS_EE65EC"
msgid "Pourquoi je t’écouterais ?"
msgstr "Und warum sollte ich auf dich hören?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_AS_D_CID_DE_R_AGIR_COMME_UN_1C3322"
msgid "Tu as décidé de réagir comme une gamine, soit."
msgstr "Du benimmst dich wie ein scheiß Kind. Also gut."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "IMAGINONS_UN_INSTANT_QUE_TU_CO_A8D9F4"
msgid "Imaginons un instant que tu continues, que va-t-il se passer selon toi ?"
msgstr "Stell dir vor, du machst einfach weiter so, wie bisher. Was glaubst du, wird passieren?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "QUELQU_UN_FINIRA_BIEN_PAR_M_EN_EE1BEF"
msgid "Quelqu’un finira bien par m’entendre !"
msgstr "Irgendjemand wird mich hören!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "NON_TOUT_EST_INSONORIS_CDA38E"
msgid "Non, tout est insonorisé."
msgstr "Falsch, alles hier ist absolut schalldicht."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "W_AU_MOINS_A_EMMERDE_MINATO_N_7F1F14"
msgid "...[w] Au moins ça emmerde {{minato.n}} ! C’est toujours ça de gagné !"
msgstr "...[w]Zumindest gehe ich {{minato.n}} damit auf den Sack! Allein dafür lohnt es sich!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_PENSES_TROP_COURT_TERME_404EF8"
msgid "Tu penses trop à court terme..."
msgstr "Du denkst zu kurzfristig ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "SI_TU_FAIS_A_TROP_LONGTEMPS_OU_6C9D56"
msgid "Si tu fais ça trop longtemps ou trop souvent, il prendra des mesures pour que tu ne puisses plus le faire."
msgstr "Wenn du das so weitermachst, wird er irgendwann dafür sorgen, dass du aufhörst."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_AS_ENVIE_DE_PASSER_JOUR_ET_4F8713"
msgid "Tu as envie de passer jour et nuit avec un bâillon dans la bouche ? Il te le fera garder en permanence et tu ne finiras par t’alimenter qu’avec une paille."
msgstr "Willst du hier den ganzen Tag lang mit einem Knebel sitzen? Er wird ihn dir nie abnehmen und irgendwann kannst du nur noch durch einen Strohhalm essen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "PFFF_DE_TOUTE_FA_ON_J_ALLAIS_A_2F9987"
msgid "Pfff... De toute façon j’allais arrêter, ça me fait mal à la gorge."
msgstr "Tss ... Ich wollte sowieso aufhören. Mein Hals tut langsam weh."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "NATSUME_N_COMMENT_VA_SAITO_N_6ED5A2"
msgid "{{natsume.n}}... Comment va {{saito.n}} ? Est-ce qu’il va bien ?"
msgstr "{{natsume.n}} ... Wie geht es {{saito.n}}? Was macht er?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "R_PONDS_D_ABORD_MA_QUESTION_QU_59C8A2"
msgid "... Réponds d’abord à ma question, quel genre de lien vous avez pour qu’il essaie aussi fort de te sauver ?"
msgstr "Zuerst beantwortest du meine Frage: Was für ein Verhältnis habt ihr zueinander, dass er sich so viel Mühe dabei gibt, dich zu retten?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "CO_COMMENT_A_ME_SAUVER_851DF3"
msgid "Co-comment ça, me sauver ?"
msgstr "Was meinst du, mich zu retten?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "SA_VIE_EST_LITT_RALEMENT_FOUTU_E3C5E2"
msgid "Sa vie est littéralement foutue, on lui a collé une réputation de meurtrier, il est recherché par la police, et au lieu de penser à lui et de se faire oublier..."
msgstr "Sein Leben ist total im Eimer. Ihm wird nachgesagt, ein Mörder zu sein und die Polizei sucht nach ihm. Und anstatt an sich selbst zu denken und sich aus dem Staub zu machen ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_N_A_TOUJOURS_QU_UNE_SEULE_I_73C88B"
msgid "Il n’a toujours qu’une seule idée en tête, c’est de venir te tirer de là !"
msgstr "Hat er nur eine Sache im Kopf: Dich hier raus zu bekommen!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "VOUS_VOUS_CONNAISSEZ_QUE_DEPUI_3BA755"
msgid "Vous vous connaissez que depuis peu, donc pourquoi ce lien est-il si fort ?"
msgstr "Ihr kennt euch erst seit Kurzem, also warum hängt ihr so sehr aneinander?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "LE_PIRE_DANS_TOUT_A_C_EST_QUE_7FC428"
msgid "Le pire dans tout ça, c’est que je partage ton avis... Je ne sais pas pourquoi il est prêt à faire tout ça."
msgstr "Das Schlimmste ist, ich bin genau so verwirrt wie du ... Ich habe keine Ahnung, warum er so weit geht."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "MAIS_JE_N_AI_JAMAIS_T_AUSSI_HE_EA67DF"
msgid "Mais je n’ai jamais été aussi heureuse !"
msgstr "Aber ich war noch nie so glücklich!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_M_A_FAIT_PASSER_UN_MESSAGE_2676E4"
msgid "Il m’a fait passer un message pour toi !"
msgstr "Ich soll dir eine Nachricht von ihm ausrichten!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "QUOI_UN_MESSAGE_DE_SAITO_N_QUA_1A875D"
msgid "Quoi, un message de {{saito.n}} ? Quand ? Il sait ce que je suis—"
msgstr "Was, eine Nachricht von {{saito.n}}? Wann? Er weiß, was–"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "DIS_LUI_DE_GARDER_ESPOIR_JE_V_C7EFB6"
msgid "\"Dis-lui de garder espoir. Je vais définitivement trouver une solution pour la sortir de là.\""
msgstr "„Sag ihr, dass sie die Hoffnung nicht verlieren darf. Ich finde einen Weg, um sie zu befreien.“"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "CET_IDIOT_EC6303"
msgid "Cet idiot..."
msgstr "Dieser Idiot ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "C_EST_CE_QUE_JE_PENSAIS_AUSSI_EB5EC2"
msgid "C’est ce que je pensais aussi."
msgstr "Das dachte ich auch."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_minato_basement.dialogue
msgctxt "PARLE_MOI_UN_PEU_PLUS_DE_LUI_4039C2"
msgid "Parle-moi un peu plus de lui !"
msgstr "Erzähl mir mehr über ihn!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_VEUX_DIRE_QU_EST_CE_QU_IL_F_D3747E"
msgid "Je veux dire... Qu'est-ce qu'il fait en ce moment ?"
msgstr "Ich meine ... Was macht er gerade?"

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_SUIS_TR_S_HEUREUSE_DE_SAVOI_E97FDA"
msgid "Je suis très heureuse de savoir qu'il va venir me sortir de là mais comment compte-t-il s'y prendre ?"
msgstr "Ich freue mich wirklich, dass er sich bemüht, mich hier raus zu bekommen, aber wie zur Hölle will er das machen?"

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_JE_CROIS_QU_IL_S_ENTRAINE_EEF7B5"
msgid "... Je... je crois qu'il s'entraîne."
msgstr "... Ich ... Ich glaube, er trainiert."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_S_ENTRAINE_A_QUOI_0D8A55"
msgid "Il s'entraîne à quoi ?"
msgstr "Wofür trainiert er?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "AUCUNE_ID_E_F1331E"
msgid "Aucune idée !"
msgstr "Keine Ahnung!"

#. Character:`natsume` | Attributes:`cute`
#: game/story/home_minato_basement.dialogue
msgctxt "A_SE_BATTRE_JE_SUPPOSE_8BF6AE"
msgid "À se battre je suppose ?"
msgstr "Fürs Kämpfen, schätze ich?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_VEUT_TRE_DEVENIR_ASSEZ_FORT_822766"
msgid "Il veut peut-être devenir assez fort pour venir casser la gueule de {{minato.n}} ?"
msgstr "Vielleicht will er stark genug werden, um {{minato.n}} die Fresse zu polieren?"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_minato_basement.dialogue
msgctxt "AVOUE_QUE_A_SERAIT_TROP_BIEN_49D946"
msgid "Avoue que ça serait trop bien..."
msgstr "Gib es zu, das wäre schon ziemlich herrlich ..."

#. Character:`natsume` | Attributes:`bad`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_SUIS_D_ACCORD_J_AURAIS_BIEN_5AC339"
msgid "Je suis d'accord, j'aurais bien envie de voir ça moi aussi."
msgstr "Da stimm’ ich dir zu. Das würde ich mir gerne ansehen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "HAHAHA_31860B"
msgid "Hahaha."
msgstr "Hahaha."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_CROIS_QU_IL_Y_ARRIVERA_DF4670"
msgid "Tu crois qu'il y arrivera ?"
msgstr "Glaubst du, er schafft es?"

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_NE_SAIS_PAS_IL_A_L_AIR_VRAI_06187E"
msgid "Je ne sais pas... Il a l'air vraiment déterminé."
msgstr "Ich weiß nicht ... Er wirkt sehr entschlossen."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "COMME_S_IL_AVAIT_UN_PLAN_EN_T_340115"
msgid "Comme s'il avait un plan en tête."
msgstr "Als hätte er irgendeinen Plan im Kopf."

#. Character:`asami` | Attributes:`bored`
#: game/story/home_minato_basement.dialogue
msgctxt "S_ENTRAINER_HEIN_CET_IDIOT_F2A626"
msgid "S'entraîner hein... Cet idiot..."
msgstr "Training, hmm ... Dieser Idiot ..."

#. Character:`natsume` | Attributes:`pouting`
#: game/story/home_minato_basement.dialogue
msgctxt "C_EST_CLAIR_C24AAB"
msgid "C'est clair..."
msgstr "Ja ... Du hast Recht."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_M_EN_VOUDRAIS_DE_VOULOIR_IN_9D314D"
msgid "Je m'en voudrais de vouloir interrompre un moment aussi fraternel !"
msgstr "Ich unterbreche so einen intimen Moment nur ungerne!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "QU_EST_CE_QUE_TU_VEUX_4F4E78"
msgid "Qu'est-ce que tu veux ?"
msgstr "Was willst du?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_VOULAIS_JUSTE_APPORTER_UNE_25D57F"
msgid "Je voulais juste apporter une bonne nouvelle à ma chère prisonnière préférée."
msgstr "Ich möchte meiner Lieblingsgefangenen nur ein paar gute Neuigkeiten überbringen."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_VAS_POUVOIR_TE_R_JOUIR_TU_V_2581DE"
msgid "Tu vas pouvoir te réjouir, tu vas avoir un nouveau papa !"
msgstr "Das sollte dich aufheitern. Du wirst einen neuen Papa bekommen!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "QUOI_QU_EST_CE_QUE_C_EST_QUE_C_81F6E9"
msgid "Quoi ?! Qu'est-ce que c'est que ces conneries ?"
msgstr "Was?! Was soll dieser Scheiß?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "SI_VOUS_ESSAYEZ_ENCORE_VOS_JEU_BA627F"
msgid "Si vous essayez encore vos jeux stupides pour me rendre jalouse, il va falloir trouver autre chose."
msgstr "Wenn du immer noch dein dämliches Spiel spielst und mich eifersüchtig machen willst, brauchst du einen neuen Plan."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_N_AI_AUCUN_INT_R_T_POUR_LES_EC1CB8"
msgid "Je n'ai aucun intérêt pour les perdants !"
msgstr "Ich habe kein Interesse an Versagern!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "ALORS_QUOI_5D5D23"
msgid "Alors quoi...?"
msgstr "Na und ...?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "TA_M_RE_A_PRIS_AVEC_SUCC_S_LA_E5CEB9"
msgid "Ta mère a pris avec succès la seconde dose de X3 et ce soir je lui donnerai la dernière."
msgstr "Deine Mutter hat erfolgreich die zweite Dosis X3 genommen und heute Nacht bekommt sie die letzte."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "NON_VOUS_N_AVEZ_PAS_FAIT_A_0635A0"
msgid "Non... Vous n'avez pas fait ça... ?!"
msgstr "Nein ... Das hast du nicht getan, oder ...?!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "LA_BASE_A_DEVAIT_TRE_TOI_MAIS_4FCE90"
msgid "À la base, ça devait être toi mais... il y a eu un changement de programme inopportun."
msgstr "Eigentlich sollte es ja dich treffen, aber ... Es gab eine kleine Planänderung."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "LA_NATALIT_DE_NOTRE_CHER_BEAU_26BB25"
msgid "La natalité de notre cher beau pays étant en baisse, je me fais un devoir d'y remédier."
msgstr "Wo doch die Geburtenzahlen unseres Landes stetig sinken, sehe ich es als meine staatsbürgerliche Pflicht, etwas dagegen zu unternehmen."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_PEUX_T_ASSURER_QUE_JE_LA_TR_D9F2E6"
msgid "Je peux t'assurer que je la traiterai bien, d'ici quelques années tu auras tout plein de frères et sœurs."
msgstr "Ich verspreche dir, ich werde mich gut um sie kümmern und in ein paar Jahren hast du ganz viele kleine Geschwister."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "DOMMAGE_QUE_TU_NE_SERAS_PAS_L_8EB23D"
msgid "Dommage que tu ne seras pas là pour voir ça."
msgstr "Schade, dass du das nicht mit ansehen wirst."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "VOUS_NE_TOUCHEREZ_PAS_UN_SEUL_AF0F5C"
msgid "Vous ne toucherez pas un seul des cheveux de ma mère !"
msgstr "Wag es nicht, meiner Mutter auch nur ein Haar zu krümmen!"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "ET_QUI_M_EN_EMP_CHERA_0E1125"
msgid "Et qui m'en empêchera...?"
msgstr "Und wer sollte mich aufhalten ...?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_W_NATSUME_N_FAIS_QUELQUE_CH_6D212D"
msgid "Je...[w] {{natsume.n}} fais quelque chose... Pitié..."
msgstr "Ich ... [w]{{natsume.n}}, tu irgendwas ... Bitte ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_SUIS_D_SOL_E_9BB659"
msgid "Je suis désolée..."
msgstr "Es tut mir leid ..."

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "BREF_J_AI_DES_COURSES_FAIRE_LA_319CE5"
msgid "Bref, j'ai des courses à faire, la soirée va être très chaude, tu crois que ta mère rentre dans ton ancien uniforme de collégienne ?"
msgstr "Wie auch immer, ich habe Besorgungen zu erledigen. Diese Nacht wird großartig. Meinst du, deine Mutter passt immer noch in ihre alte Schuluniform?"

#. Character:`netoru`
#: game/story/home_minato_basement.dialogue
msgctxt "NON_NE_ME_DIS_RIEN_CE_SERA_LA_7AD227"
msgid "Non ne me dis rien, ce sera la surprise !!"
msgstr "Nein, sag’s mir nicht. Ich will, dass es eine Überraschung wird!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "NATSUME_N_S_IL_TE_PLA_T_5B8396"
msgid "{{natsume.n}}, s'il te plaît..."
msgstr "{{natsume.n}}, bitte ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "NE_LAISSE_PAS_CETTE_ORDURE_AVO_8C3A80"
msgid "Ne laisse pas cette ordure avoir ce qu'il veut !"
msgstr "Lass diesen Bastard damit nicht durchkommen!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "MA_M_RE_NE_M_RITE_PAS_DE_PASSE_C4CFF9"
msgid "Ma mère ne mérite pas de passer le reste de sa vie comme ça !"
msgstr "Meine Mutter hat es nicht verdient, den Rest ihres Lebens so zu verbringen!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "PITI_PARLE_EN_SAITO_N_ADBC96"
msgid "Pitié... Parle-en à {{saito.n}} !"
msgstr "Bitte ... Erzähl {{saito.n}} davon!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "SI_TOI_TU_NE_PEUX_PAS_PEUT_TRE_12BB9E"
msgid "Si toi tu ne peux pas, peut-être que lui le pourra !?"
msgstr "Wenn du es nicht kannst, kann es vielleicht er?!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "NATSUME_N_14C6A0"
msgid "{{natsume.n}} !"
msgstr "{{natsume.n}}!"

#. Character:`natsume` | Attributes:`happy`
#: game/story/home_minato_basement.dialogue
msgctxt "J_AI_UNE_BONNE_NOUVELLE_POUR_T_B5D02C"
msgid "J'ai une bonne nouvelle pour toi !"
msgstr "Ich habe tolle Neuigkeiten für dich!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "COMMENT_VA_MA_M_RE_40DE2B"
msgid "Comment va... ma mère ?"
msgstr "Wie ... Wie geht es meiner Mutter?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "EH_BIEN_FIGURE_TOI_QU_ELLE_SE_169A1F"
msgid "Eh bien figure-toi... qu’elle se porte à merveille."
msgstr "Na, ob du’s glaubst oder nicht ... Ihr geht’s großartig."

#. Character:`natsume` | Attributes:`bad`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_SEMBLE_QU_ELLE_N_AIT_PAS_RE_2C8634"
msgid "Il semble qu’elle n’ait pas reçu la dernière dose de X3."
msgstr "Scheint so, als hätte sie die letzte Dosis X3 doch nicht bekommen."

#. Character:`asami` | Attributes:`surprised`
#: game/story/home_minato_basement.dialogue
msgctxt "VRAIMENT_QU_EST_CE_QUI_S_EST_P_DCE946"
msgid "Vraiment ?!! Qu’est-ce qui s’est passé ?"
msgstr "Wirklich?! Was ist passiert?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "D_APR_S_CE_QUE_J_AI_ENTENDU_DE_1C8EA2"
msgid "D’après ce que j’ai entendu de {{minato.n}}, notre cher {{netoru.n}} a disparu."
msgstr "{{minato.n}} hat mir erzählt, dass unser lieber {{netoru.n}} scheinbar verschwunden ist."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_minato_basement.dialogue
msgctxt "MERCI_MERCI_MON_DIEU_JE_SAVAIS_9D3EB6"
msgid "Merci ! Merci mon Dieu... Je savais que ça ne pouvait pas finir comme ça..."
msgstr "Danke! Gott sei Dank ... Ich wusste, dass es so nicht enden konnte ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_VA_REVENIR_E60F91"
msgid "Il va revenir ?"
msgstr "Kommt er zurück?"

#. Character:`natsume` | Attributes:`cute`
#: game/story/home_minato_basement.dialogue
msgctxt "J_EN_AI_PAS_L_IMPRESSION_QUELQ_972CAE"
msgid "J’en ai pas l’impression. Quelqu’un a dû s’occuper de lui."
msgstr "Ich glaube nicht. Jemand muss sich um ihn gekümmert haben."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "MERCI_NATSUME_N_MERCI_POUR_CE_4EEA71"
msgid "Merci {{natsume.n}} ! Merci pour ce que tu as fait."
msgstr "Danke, {{natsume.n}}! Danke für alles was du getan hast."

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_basement.dialogue
msgctxt "CE_N_EST_PAS_MOI_JE_N_Y_SUIS_P_5E4491"
msgid "Ce n’est pas moi... Je n’y suis pour rien."
msgstr "Bedank dich nicht bei mir ... Ich habe damit nichts zu tun."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "CE_N_EST_PAS_SAITO_N_NON_PLUS_BA86E4"
msgid "Ce n’est pas {{saito.n}} non plus."
msgstr "Es war aber auch nicht {{saito.n}}."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_minato_basement.dialogue
msgctxt "PEU_IMPORTE_W_ET_TOI_TU_VAS_BI_1E4E0C"
msgid "Peu importe...[w] Et toi, tu vas bien ?"
msgstr "Wie auch immer ... [w]Also, geht’s dir gut?"

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_basement.dialogue
msgctxt "MOI_W_PAS_VRAIMENT_17001D"
msgid "Moi ?[w] Pas vraiment..."
msgstr "Mir? nicht wirklich ..."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "MINATO_N_PR_PARE_QUELQUE_CHOS_0C1424"
msgid "{{minato.n}} prépare quelque chose d’horrible, et même toi, tu as du mal à t’en remettre ?"
msgstr "{{minato.n}} arbeitet an etwas Schrecklichem und nicht mal du scheinst es verhindern zu können?"

#. Character:`natsume` | Attributes:`pouting`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_SAIS_QUE_TU_PEUX_TRE_SACR_M_08687F"
msgid "Tu sais que tu peux être sacrément perspicace quand tu veux ?!"
msgstr "Weißt du, du kannst wirklich scharfsinnig sein, wenn du willst ..."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_minato_basement.dialogue
msgctxt "COMMENT_A_QUAND_JE_VEUX_F79C0B"
msgid "Comment ça, “quand je veux” ?"
msgstr "Was meinst du mit „wenn ich will“?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "W_OH_JE_VOIS_TU_ES_EN_TRAIN_D_D5B2F1"
msgid "...[w] Oh, je vois... Tu es en train de tomber amoureuse !"
msgstr "... [w]Oh, ich versteh’ schon ... Du verliebst dich!"

#. Character:`natsume` | Attributes:`surprised`
#: game/story/home_minato_basement.dialogue
msgctxt "QUOI_237004"
msgid "Quoi ?!"
msgstr "Was?!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "QU_EST_CE_QUE_TU_RACONTES_C_ES_4EDDBC"
msgid "Qu’est-ce que tu racontes ?! C’est vraiment le moment de parler de ça ?"
msgstr "Wovon zur Hölle redest du?! Glaubst du wirklich, das ist die richtige Zeit für solche Gespräche?"

#. Character:`asami` | Attributes:`upset`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_VOIS_UN_MEILLEUR_MOMENT_POU_5DEA8A"
msgid "Tu vois un meilleur moment pour en parler ?"
msgstr "Fällt dir ein besserer Zeitpunkt ein, um darüber zu reden?"

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_basement.dialogue
msgctxt "NON_VIDEMMENT_F03EEC"
msgid "... Non, évidemment."
msgstr "... Nein, nicht wirklich."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_LE_REGARDES_SE_D_MENER_COMM_4AACED"
msgid "Tu le regardes se démener comme un fou, à essayer d’arranger les choses."
msgstr "Du siehst ihm dabei zu, wie er alles in seiner Macht Stehende tut, um die Dinge in den Griff zu bekommen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_S_INQUI_TE_SINC_REMENT_POUR_C34CA2"
msgid "Il s’inquiète sincèrement pour les autres, et quand tu es avec lui, tu oublies tous tes problèmes..."
msgstr "Ihm liegen andere Menschen am Herzen und wenn du bei ihm bist, scheinen sich all deine Probleme in Luft aufzulösen ..."

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "W_M_ME_SI_C_TAIT_LE_CAS_W_CET_A218AA"
msgid "...[w] Même si c’était le cas...[w] Cette histoire n’aura pas de fin heureuse."
msgstr "... [w]Selbst, wenn das der Fall wäre ... [w]Diese Geschichte wird kein Happy End haben."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_Y_A_CERTAINES_CHOSES_CONTRE_D24964"
msgid "Il y a certaines choses contre lesquelles on ne peut rien."
msgstr "Es gibt Dinge im Leben, gegen die man nichts ausrichten kann."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_minato_basement.dialogue
msgctxt "PEUT_TRE_BIEN_MAIS_CE_N_EST_PA_C88A8B"
msgid "Peut-être bien, mais... ce n’est pas parce que quelque chose est soi-disant impossible qu’on doit abandonner."
msgstr "Vielleicht, aber ... Nur weil etwas angeblich unmöglich ist, heißt das nicht, dass man aufgeben sollte."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "CROIRE_EN_QUELQUE_CHOSE_D_IMPO_7561E8"
msgid "Croire en quelque chose d’impossible vaut mieux que vivre sans espoir."
msgstr "An etwas Unmögliches zu glauben, ist besser, als ohne Hoffnung zu leben."

#. Character:`natsume` | Attributes:`bad`
#: game/story/home_minato_basement.dialogue
msgctxt "CROIRE_EN_L_IMPOSSIBLE_HEIN_C_6A6EC4"
msgid "Croire en l’impossible, hein... C’est pas trop mon truc, ce genre de philosophie. Je suis plutôt quelqu’un de pragmatique."
msgstr "An etwas Unmögliches glauben, hmm ... Diese Einstellung ist nicht wirklich mein Ding. Ich bin da etwas pragmatischer."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "HAHA_PEUT_TRE_MAIS_TU_COMMENCE_1BA8EC"
msgid "Haha, peut-être, mais tu commences à changer !"
msgstr "Haha, vielleicht, aber du veränderst dich langsam!"

#. Character:`natsume` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "ASAMI_N_TU_N_AS_PLUS_BEAUCOUP_FF0502"
msgid "{{asami.n}}... Tu n’as plus beaucoup de temps..."
msgstr "{{asami.n}} ... Du hast nicht mehr viel Zeit ..."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_VAIS_CONTINUER_D_Y_CROIRE_S_B52121"
msgid "Je vais continuer d’y croire. {{saito.n}} a dit qu’il viendrait, définitivement !"
msgstr "Ich werde weiter fest daran glauben. {{saito.n}} hat gesagt, dass er kommen würde!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "UN_MIRACLE_S_EST_D_J_PRODUIT_A_92DE0B"
msgid "Un miracle s’est déjà produit avec ma mère."
msgstr "Ein Wunder ist bereits bei meiner Mutter passiert."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_minato_basement.dialogue
msgctxt "A_PEUT_ENCORE_SE_REPRODUIRE_BCD70A"
msgid "Ça peut encore se reproduire..."
msgstr "Es könnte auch noch ein zweites geben ..."

#. Character:`natsume` | Attributes:`neutral`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_ES_CERTAINE_QUE_TU_N_AS_VRA_D434A9"
msgid "Tu es certaine que tu n’as vraiment aucune idée de qui aurait pu l’aider ?"
msgstr "Bist du dir absolut sicher, dass du nicht weißt, wer ihm geholfen haben könnte?"

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_minato_basement.dialogue
msgctxt "W_PEUT_TRE_ET_SI_C_EST_LE_CAS_F6F208"
msgid "...[w] Peut-être... Et si c’est le cas... vous venez de taper dans un nid de frelons."
msgstr "... [w]Vielleicht ... Und wenn das stimmt ... Hast du gerade die Büchse der Pandora geöffnet."

#. Character:`natsume` | Attributes:`surprised`
#: game/story/home_minato_basement.dialogue
msgctxt "AH_9930D4"
msgid "Ah !"
msgstr "Ah!"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "ET_MOI_ALORS_TU_N_ES_PAS_CONTE_7E4B9C"
msgid "Et moi alors, tu n’es pas contente de me voir ?"
msgstr "Was ist mit mir? Freust du dich nicht, mich zu sehen?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "W_QU_EST_CE_QUE_TU_VEUX_4E6F49"
msgid "...[w] Qu’est-ce que tu veux ?"
msgstr "... [w]Was willst du?"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_PR_F_RE_CE_REGARD_EDFB5A"
msgid "Je préfère ce regard !"
msgstr "Der Ausdruck gefällt mir gleich viel lieber!"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "C_EST_LE_MOMENT_DE_PRENDRE_LA_7494D1"
msgid "C’est le moment de prendre la dernière dose de X3."
msgstr "Es ist Zeit für deine letzte Dosis X3."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_VOULAIS_SIMPLEMENT_VOIR_LA_DC46C6"
msgid "Je voulais simplement voir la tête que tu feras quand tu verras le futur homme de ta vie."
msgstr "Ich wollte nur deinen Blick sehen, wenn du deinem zukünftigen Mann begegnest."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "VA_TE_FAIRE_FOUTRE_0D3D71"
msgid "Va te faire foutre !"
msgstr "Fick dich!"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "LE_VOIL_MAGNIFIQUE_N_EST_CE_PA_28764E"
msgid "Le voilà ! Magnifique, n’est-ce pas ?"
msgstr "Da wäre er! Großartig, oder?"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "TU_N_AURAS_BIENT_T_QU_UNE_ID_E_1A43DF"
msgid "Tu n’auras bientôt qu’une idée en tête : c’est de combler le moindre de ses désirs."
msgstr "Bald wirst du nur noch eine Sache im Kopf haben: Ihm jeden seiner Wünsche zu erfüllen."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "W_TU_SAIS_CE_QUE_JE_REGRETTE_C3E04A"
msgid "...[w] Tu sais ce que je regrette le plus ?"
msgstr "... [w]Weißt du, was ich am meisten bereue?"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "DIS_TOUJOURS_CA4D9A"
msgid "Dis toujours..."
msgstr "Spuck’s aus ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "D_AVOIR_UN_JOUR_D_VELOPP_DES_S_54A0FB"
msgid "D’avoir un jour développé des sentiments pour toi. J’aurais préféré me casser les deux jambes ce jour-là."
msgstr "Jemals Gefühle für dich entwickelt zu haben. Ich hätte mir damals lieber die Beine gebrochen, als das."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "HAHA_EN_VRAI_JE_PENSE_QUE_TU_D_FD05D4"
msgid "Haha ! En vrai... Je pense que tu devrais me remercier... Tu connais cet adage qui dit qu’on peut toujours trouver pire ?"
msgstr "Haha! Ehrlich gesagt ... Ich glaube, du solltest mir danken ... Du weißt schon, was die Leute sagen: „Schlimmer geht immer“."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "VIDEMMENT_MAIS_JE_VOIS_PAS_CO_C41299"
msgid "Évidemment... Mais je vois pas comment..."
msgstr "Ganz offensichtlich ... Aber ich sehe nicht, wie ..."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "QUAND_JE_T_AURAI_RACONT_A_TU_V_5090D7"
msgid "Quand je t’aurai raconté ça, tu vas te sentir reconnaissante, crois-moi."
msgstr "Wenn ich mit dem Erzählen fertig bin, wirst du mir dankbar sein, vertrau mir."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "AUCUNE_CHANCE_A42F61"
msgid "Aucune chance !"
msgstr "Niemals!"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "FIGURE_TOI_QU_LA_BASE_TON_NOUV_3FC756"
msgid "Figure-toi qu’à la base, ton nouveau maître était tellement tordu qu’il n’avait même pas prévu d’envoyer sa photo, mais celle d’un foutu cochon !"
msgstr "Hör zu: Dein neuer Meister ist so abgedreht, dass er dir nicht mal ein Foto von ihm, sondern von einem verdammten Schwein schicken wollte!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "QUOI_2F7642"
msgid "Quoi ?!!"
msgstr "Was?!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "PLUT_T_MOURIR_QUE_D_ACCEPTER_U_512842"
msgid "Plutôt mourir que d’accepter un truc pareil."
msgstr "Lieber sterbe ich, als sowas zu akzeptieren."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "OUI_C_EST_FOU_M_ME_SI_L_ID_E_T_E7629C"
msgid "Oui, c’est fou. Même si l’idée était bien amusante, il a fallu le convaincre de ne pas le faire."
msgstr "Ja, ziemlich verrückt. Ich fand die Idee zwar ganz lustig, hab sie ihm am Ende aber ausgeredet."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "APR_S_TOUT_TU_AURAIS_T_AUX_ORD_49517D"
msgid "Après tout... Tu aurais été aux ordres d’un animal, ce qui, sur le plan logistique, était un peu compliqué, et je n’ai pas poussé mes recherches jusque-là."
msgstr "Schließlich ... Hättest du dann einem Tier Rede und Antwort gestanden, was insgesamt recht kompliziert hätte werden können und ich habe nicht so intensiv in der Richtung geforscht."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "MAIS_AVEC_SA_PHOTO_IL_POURRA_T_57A11C"
msgid "Mais avec sa photo, il pourra tout simplement t’ordonner de le faire, et tu seras heureuse."
msgstr "Aber mit seinem Foto kann er dir einfach befehlen, etwas zu tun und du wirst dich damit zufriedengeben."

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "BREF_AMUSE_TOI_BIEN_DANS_TA_NO_1E027E"
msgid "Bref, amuse-toi bien dans ta nouvelle vie !"
msgstr "Wie auch immer, genieß dein neues Leben in vollen Zügen!"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "PEUT_TRE_QUE_TU_METTRAS_AU_MON_67368C"
msgid "Peut-être que tu mettras au monde plein de petits cochonnets, qui sait ?"
msgstr "Vielleicht wirst du am Ende Mutter von einem Haufen kleiner Säue. Wer weiß das schon?"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "DONNE_LUI_SA_DOSE_ET_MAINTIENS_66718E"
msgid "Donne-lui sa dose et maintiens-lui la tête jusqu’à ce qu’elle ouvre les yeux !"
msgstr "Gib ihr die Pille und halte ihren Kopf bis sie die Augen aufmacht!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "ALLEZ_AVALE_D960B7"
msgid "Allez avale !"
msgstr "Komm schon, schluck’s runter!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "NOON_MMHHH_EC5696"
msgid "Noon !!! Mmhhh..."
msgstr "Neeiin! Mmhh ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "VOUS_TES_DES_MONSTRES_260FBA"
msgid "Vous êtes des monstres !"
msgstr "Ihr seid Monster!"

#. Character:`minato`
#: game/story/home_minato_basement.dialogue
msgctxt "AU_PLAISIR_DE_T_AVOIR_CONNU_ABD4D5"
msgid "Au plaisir de t'avoir connu !"
msgstr "Es war schön, dich gekannt zu haben!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "SNIFF_SNIFF_65B332"
msgid "Sniff... Sniff..."
msgstr "Schnief ... schnief ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_N_OUVRIRAI_PLUS_JAMAIS_LES_83A23F"
msgid "Je n’ouvrirai plus jamais les yeux de toute ma vie..."
msgstr "Ich werde meine Augen für den Rest meines Lebens zu halten."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "ALORS_TU_CROIS_TOUJOURS_EN_L_I_C647EE"
msgid "Alors, tu crois toujours en l’impossible ?"
msgstr "Na, glaubst du immer noch an das Unmögliche?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "M_ME_APR_S_TOUT_A_24D230"
msgid "Même après tout ça ?"
msgstr "Sogar nach all dem?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "L_ESPOIR_EST_LA_SEULE_CHOSE_QU_6B1C01"
msgid "L’espoir est la seule chose qu’il me reste, personne ne me l’enlèvera."
msgstr "Hoffnung ist das letzte, was mir bleibt und die wird mir niemand nehmen."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "W_T_ES_PAS_CROYABLE_COMME_FIL_586FE3"
msgid "...[w] T’es pas croyable comme fille !"
msgstr "... [w]Du bist wirklich unglaublich!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "HEIN_DE0245"
msgid "Hein... ?"
msgstr "Huh ...?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "ALLEZ_ON_SE_TIRE_D_ICI_J_EN_AI_AFD1D5"
msgid "Allez, on se tire d’ici ! J’en ai ma claque de ce taré."
msgstr "Komm schon, lass uns von hier verschwinden! Ich hab’ die Schnauze voll von diesem Psycho!"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "CE_C_EST_UN_PI_GE_758803"
msgid "Ce... C’est un piège ?"
msgstr "Ist das ... eine Falle?"

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "SI_J_OUVRE_LES_YEUX_JE_VAIS_TO_0D2BA3"
msgid "Si j’ouvre les yeux, je vais tomber amoureuse de la première personne que je verrai..."
msgstr "Wenn ich die Augen öffne, verliebe ich mich in die erste Person, die ich sehe ..."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "A_AURAIT_D_EFFECTIVEMENT_TRE_7F8470"
msgid "Ça aurait dû effectivement être le cas...[w] Si je t’avais donné le X3..."
msgstr "Das wäre so, ja, aber nur ... [w]Wenn ich dir auch wirklich X3 gegeben hätte."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "MAIS_JE_N_AI_JAMAIS_FAIT_UNE_T_02B016"
msgid "Mais je n’ai jamais fait une telle chose, j’ai toujours remplacé la pilule par autre chose !"
msgstr "Aber das habe ich nicht. Ich habe die Tabletten durch etwas Anderes ersetzt."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "QU_EST_CE_QUE_J_AI_PRIS_ALORS_EE24E0"
msgid "Qu’est-ce que j’ai pris alors ?"
msgstr "Was habe ich dann bitte geschluckt?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "DU_SUCRE_IDIOTE_C9F9D9"
msgid "Du sucre, idiote !"
msgstr "Zucker, Schwachkopf!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "IL_TAIT_HORS_DE_QUESTION_QUE_J_B50AE5"
msgid "Il était hors de question que je fasse subir ça à quelqu’un."
msgstr "Auf keinen Fall würde ich jemandem so etwas antun."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_JE_NE_SAIS_PLUS_QUOI_PENSER_058468"
msgid "Je... Je ne sais plus quoi penser, si c’est encore un piège pour me rendre folle."
msgstr "Ich ... Ich weiß nicht mehr, was ich denken soll. Ob das nicht doch wieder eine Falle ist, um mir völlig den Verstand zu rauben."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "C_EST_PAS_GRAVE_JE_COMPRENDS_Q_A7F324"
msgid "C’est pas grave, je comprends que c’est dur de faire confiance après tout ça, j’attendrai à côté de toi !"
msgstr "Keine Sorge. Ich verstehe, dass es schwierig ist, mir zu vertrauen. Ich warte hier neben dir!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "AU_FAIT_W_TU_AVAIS_RAISON_8883E7"
msgid "Au fait...[w] Tu avais raison..."
msgstr "Übrigens ... [w]Du hattest Recht ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "QUEL_PROPOS_800F4F"
msgid "À quel propos ?"
msgstr "Worüber?"

#. Character:`natsume` | Attributes:`shame`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_CROIS_BIEN_QUE_JE_SUIS_TOMB_F3A136"
msgid "Je crois bien que je suis tombée amoureuse de lui... Je ne voulais juste pas le reconnaître."
msgstr "Ich glaube, ich habe mich wirklich in ihn verknallt ... Ich wollte es nur nicht zugeben."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_JALOUSAIS_LA_RELATION_QUE_T_28A24A"
msgid "Je jalousais la relation que tu avais avec lui."
msgstr "Ich war eifersüchtig auf dein Verhältnis zu ihm."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_VOULAIS_EN_FAIRE_PARTIE_MAI_2F3ED4"
msgid "Je voulais en faire partie, mais les conditions dans lesquelles je me trouvais ne me le permettaient pas."
msgstr "Ich wollte dazugehören, aber meine Umstände ließen das einfach nicht zu."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_minato_basement.dialogue
msgctxt "ALORS_C_TAIT_COMMENT_9C2E1F"
msgid "Alors ? C’était comment ?"
msgstr "Und? Wie war’s?"

#. Character:`natsume` | Attributes:`cute`
#: game/story/home_minato_basement.dialogue
msgctxt "W_HORRIBLE_C_EST_UN_MONSTRE_I_4B034D"
msgid "...[w] Horrible ! C’est un monstre, il ne m’a pas laissé le temps de souffler !"
msgstr "... [w]Schrecklich! Er ist ein Biest! Er hat mir nicht mal Zeit zum Atmen gelassen!"

#. Character:`natsume` | Attributes:`happy`
#: game/story/home_minato_basement.dialogue
msgctxt "MAIS_QUELQU_UN_NE_M_AVAIT_JAMA_9AF6E6"
msgid "Mais... Quelqu’un ne m’avait jamais autant désirée, aussi fort, comme si tous mes soucis disparaissaient quand j’étais dans ses bras..."
msgstr "Aber ... Niemand hat mich je so sehr gewollt. Es war, als hätten sich in seinen Armen liegend alle Sorgen in Luft aufgelöst ..."

#. Character:`asami` | Attributes:`surprised`
#: game/story/home_minato_basement.dialogue
msgctxt "OHOH_C_EST_MAUVAIS_2E0DF5"
msgid "Ohoh... C’est mauvais..."
msgstr "Oh ... Das ist schlecht ..."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_minato_basement.dialogue
msgctxt "SI_ELLE_APPREND_QUEL_POINT_TU_7C9C69"
msgid "Si elle apprend à quel point tu as été proche de lui, tu vas avoir d’autres problèmes."
msgstr "Wenn sie herausfindet, wie nahe du ihm gekommen bist, hast du noch größere Probleme."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_G_RE_DES_SITUATIONS_BIEN_PL_88EF9C"
msgid "Je gère des situations bien plus difficiles depuis toute petite."
msgstr "Ich habe mich von klein auf schon mit schlimmeren Situationen rumgeschlagen."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "CE_QUI_EST_URGENT_ICI_C_EST_DE_CA689B"
msgid "Ce qui est urgent ici, c’est de partir rapidement ! {{minato.n}} doit s’absenter, nous partirons à ce moment-là."
msgstr "Das Wichtigste ist, dass wir dich hier schnell rausbringen! {{minato.n}} muss gleich gehen, also werden wir dann verschwinden."

#. Character:`natsume` | Attributes:`bad`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_REVIENS_JE_VAIS_CHERCHER_LE_7C812D"
msgid "Je reviens, je vais chercher les clefs de tes menottes !"
msgstr "Ich komme gleich wieder. Ich hole nur die Schlüssel für deine Handschellen!"

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_VAIS_LUI_BOTTER_LE_CUL_POUR_686D03"
msgid "Je vais lui botter le cul pour lui apprendre à faire tomber amoureuses toutes les filles qu'il croise !"
msgstr "Ich werde ihm in den Hintern treten, um ihm beizubringen, wie er ein richtiger Frauenschwarm wird!"

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_minato_basement.dialogue
msgctxt "ALORS_79A42E"
msgid "Alors ?"
msgstr "Also?"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "CHIAKI_N_NOUS_APPORTE_LES_CLE_596608"
msgid "{{chiaki.n}} nous apporte les clefs et on s’en va définitivement loin d’ici."
msgstr "{{chiaki.n}} wird uns die Schlüssel bringen und wie verlassen diesen Ort für immer."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "ON_IRA_O_CHEZ_MOI_DIRECTEMENT_2959A9"
msgid "On ira où ? Chez moi directement ?"
msgstr "Wohin gehen wir? Direkt zu mir nach Hause?"

#. Character:`natsume` | Attributes:`neutral`
#: game/story/home_minato_basement.dialogue
msgctxt "NON_PAS_TOUT_DE_SUITE_LA_POLIC_4D0A0E"
msgid "Non, pas tout de suite, la police qui surveille ta maison bosse aussi pour lui."
msgstr "Nein, nicht heute. Die Bullen, die dein Haus bewachen, arbeiten auch für ihn."

#. Character:`natsume` | Attributes:`happy`
#: game/story/home_minato_basement.dialogue
msgctxt "MAIS_NE_T_INQUI_TE_PAS_JE_CONN_4A6A17"
msgid "Mais ne t’inquiète pas, je connais quelqu’un qui pourrait te cacher quelque temps."
msgstr "Aber keine Sorge. Ich kenne jemanden, der dich eine Zeit lang verstecken kann."

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "ELLE_M_A_D_J_AID_E_PAR_LE_PASS_1A3EF8"
msgid "Elle m’a déjà aidée par le passé."
msgstr "Sie hat mir schon früher mal geholfen."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_minato_basement.dialogue
msgctxt "SI_TU_LUI_FAIS_CONFIANCE_A_ME_37B4CF"
msgid "Si tu lui fais confiance, ça me va !"
msgstr "Wenn du ihr vertraust, tue ich das auch!"

#. Character:`asami` | Attributes:`surprised`
#: game/story/home_minato_basement.dialogue
msgctxt "C_TAIT_QUOI_A_A73453"
msgid "C’était quoi ça ?"
msgstr "Was war das?"

#. Character:`natsume` | Attributes:`afraid`
#: game/story/home_minato_basement.dialogue
msgctxt "W_FUCK_39B63F"
msgid "...[w] Fuck !"
msgstr "...[w] Fuck!"

#. Character:`natsume`
#: game/story/home_minato_basement.dialogue
msgctxt "JE_ME_SUIS_FAITE_AVOIR_94EF5E"
msgid "Je me suis faite avoir..."
msgstr "Ich wurde reingelegt ..."

#. Character:`asami`
#: game/story/home_minato_basement.dialogue
msgctxt "QUOI_MAIS_PAR_QUI_B0F0CA"
msgid "Quoi ?! Mais... par qui ?"
msgstr "Was?! Aber ... von wem?"

#. Character:`kimochi`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_6c070e34"
msgid "[font_size=14]T'ainnnn mais vous branliez quoi ?![/font_size]"
msgstr "[font_size=14]Verdammt, was habt ihr nur gemacht?![/font_size]"

#. Character:`kimochi`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_29c87101"
msgid "[font_size=14]C'est pas à moi de tout faire pour vous quand même ?[/font_size]"
msgstr "[font_size=14]Eigentlich sollte ich mich nicht immer um eure Angelegenheiten kümmern müssen, oder?[/font_size]"

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_e8de1011"
msgid "[font_size=14]Juste un petit contre-temps.[/font_size]"
msgstr "[font_size=14]Nur ein kleiner Rückschlag.[/font_size]"

#. Character:`asami`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_26151af2"
msgid "[font_size=14]Oui... Rien de grave, c'était juste {{saito.n}} qui trouvait ma mère \"intéressante.\"[/font_size]"
msgstr "[font_size=14]Ja... Nichts Ernstes. {{saito.n}} fand meine Mutter einfach nur sehr „interessant“.[/font_size]"

#. Character:`kimochi`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_6c315e6a"
msgid "[font_size=14]Bordel {{saito.n}} ! Tu vas arrêter d'aller manger à tous les râteliers ?![/font_size]"
msgstr "[font_size=14]Verdammt, {{saito.n}}! Willst du dich wirklich in jede Angelegenheit einmischen?![/font_size]"

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_5882a6dd"
msgid "[font_size=14]Hey, je ne faisais que discuter. J'ai dit intéressante mais j'ai mal choisi mes mots, j'aurais dû dire sympa c'est tout.[/font_size]"
msgstr "[font_size=14]Hey, ich habe nur geredet! Ich sagte „interessant“, aber ich habe meine Worte schlecht gewählt. Ich hätte lieber „nett“ sagen sollen.[/font_size]"

#. Character:`kimochi`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_617b0b56"
msgid "[font_size=14]Ouais c'est ça...[w] Ça commence toujours comme ça.[/font_size]"
msgstr "[font_size=14]Jaaa, klar...[w] So fängt es immer an.[/font_size]"

#. Character:`kimochi`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_dc833f7b"
msgid "[font_size=14]{{asami.n}} si tu cherches un autre mec je...[/font_size]"
msgstr "[font_size=14]{{asami.n}}, wenn du nach einem anderen Typen suchst, dann...[/font_size]"

#. Character:`asami`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_7e7d9515"
msgid "[font_size=14]Même pas en rêve.[/font_size]"
msgstr "[font_size=14]Nicht im Traum.[/font_size]"

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_f2da07a4"
msgid "[font_size=14]Que fait-elle depuis tout à l'heure ? Elle ne rentre pas ?[/font_size]"
msgstr "[font_size=14]Was hat sie die ganze Zeit gemacht? Will sie nicht reingehen?[/font_size]"

#. Character:`kimochi`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_f130f23c"
msgid "[font_size=14]Non... elle est resté figée devant cette machine en soupirant.[/font_size]"
msgstr "[font_size=14]Nein... Sie stand die ganze Zeit seufzend vor diesem Automaten.[/font_size]"

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_3ab84d3a"
msgid "[font_size=14]Cette machine m'évoque quelque chose mais je ne sais pas quoi.[/font_size]"
msgstr "[font_size=14]Dieser Automat erinnert mich an etwas, aber ich weiß nicht, was.[/font_size]"

#. Character:`kimochi`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_69708ef3"
msgid "[font_size=14]On ira l'inspecter après, mais de ce que je peux voir c'est un vieux modèle.[/font_size]"
msgstr "[font_size=14]Wir können ihn uns später genauer ansehen, aber ich kann sogar von hier sehen, dass es ein recht altes Modell ist.[/font_size]"

#. Character:`kimochi`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_989cb00d"
msgid "[font_size=14]Il a facilement plus de 10 ans.[/font_size]"
msgstr "[font_size=14]Locker über zehn Jahre alt.[/font_size]"

#. Character:`asami`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_febafb3d"
msgid "[font_size=14]Si c'est aussi vieux, est-ce que ça aurait un rapport avec ce qu'il s'est passé ?[/font_size]"
msgstr "[font_size=14]Wenn er so alt ist, könnte er dann irgendwas mit dem zu tun haben, was zwischen euch passiert ist?[/font_size]"

#. Character:`asami`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_ddb12f0c"
msgid "[font_size=14]Elle semble si...[w] {{saito.n}} il faut que j'aille lui faire un câlin, elle me fait trop de peine ![/font_size]"
msgstr "[font_size=14]Sie sieht so...[w] {{saito.n}}, ich muss ihr eine Umarmung geben! Ihr Anblick macht mich so traurig![/font_size]"

#. Character:`kimochi`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_6d2d544b"
msgid "[font_size=14]Mais ça va pas dans ta tête ?! Reste cachée, si elle apprend que tu la surveilles elle ne te fera certainement plus confiance à l'avenir.[/font_size]"
msgstr "[font_size=14]Bist du verrückt geworden?! Bleib versteckt! Wenn sie rausfindet, dass du sie beobachtest, wird sie dir sicher danach nicht mehr vertrauen.[/font_size]"

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_7bbf1256"
msgid "[font_size=14]Il a raison, même si c'est dur tu dois résister. On doit comprendre pourquoi, sinon on aura fait tout ça pour rien.[/font_size]"
msgstr "[font_size=14]Er hat Recht. Auch wenn es hart ist, musst du widerstehen. Wir müssen ihre Beweggründe verstehen. Ansonsten war all das hier umsonst.[/font_size]"

#. Character:`asami`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_f1e95324"
msgid "[font_size=14]C'est trop dur de la regarder comme ça.[/font_size]"
msgstr "[font_size=14]Es ist einfach nur so herzzerreißend, sie so zu sehen.[/font_size]"

#. Character:`asami`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_3b94d80b"
msgid "[font_size=14]{{noriko.n}} sois forte ![/font_size]"
msgstr "[font_size=14]{{noriko.n}}, sei stark![/font_size]"

#. Character:`kimochi`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_ae295143"
msgid "Elle s'en va !"
msgstr "Sie geht!"

#. Character:`saito` | Attributes:`upset`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_c6679a1d"
msgid "Continuons de la suivre !"
msgstr "Schnell, hinterher!"

#. Character:`asami`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_9ddf98c0"
msgid "Elle prend la direction du parc."
msgstr "Sie geht in Richtung Park."

#. Character:`noriko`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_6f023063"
msgid "Alors qu'est ce qu'on attend, on entre ?"
msgstr "Worauf warten wir dann noch? Lass uns gehen bevor wir sie verlieren!"

#. Character:`saito` | Attributes:`sad`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_952c9a8e"
msgid "Je ne sais pas, il pourrait nous voir..."
msgstr "Ich weiß nicht, vielleicht sieht er uns..."

#. Character:`noriko` | Attributes:`bad`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_feefd23b"
msgid "Trouillard !"
msgstr "Weichei!"

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_41de6b9f"
msgid "Mais...[w] Je suppose qu'en faisant attention ça ira."
msgstr "Aber...[w] Ich schätze, wenn wir vorsichtig sind, wird es schon klappen."

#. Character:`saito` | Attributes:`happy`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_a10e3710"
msgid "Et puis... Ca faisait longtemps que je voulais venir sans jamais oser."
msgstr "Und abgesehen davon... Ich wollte hier schon lange mal hingehen, habe mich aber nie getraut."

#. Character:`nobu`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_b278e908"
msgid "J'ai la dalle..."
msgstr "Ich verhungere gleich..."

#. Character:`nobu` | Attributes:`bad`
#: game/story/arcade_exterior.dialogue
msgctxt "arcade_center_exterior_21398832"
msgid "Un petit tour au konbini avant de rentrer."
msgstr "Nur ein kleiner Zwischenstopp beim Kombini bevor ich zurückgehe."

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "tc51296653b"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "t1322efbb99"
msgid "Un problème ?"
msgstr "Gibt es ein Problem?"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/arcade_exterior.dialogue
msgctxt "t5cce5a4624"
msgid "Non... [w]J'étais juste nostalgique."
msgstr "Nein ...[w] Ich war nur etwas in Nostalgie versunken."

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "ta99867b347"
msgid "Plus jeune, j'ai passée énormément de temps ici."
msgstr "Als ich jünger war, habe ich hier eine Menge Zeit verbracht."

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "t768b31a2eb"
msgid "...et dépensé assez d'argent pour offrir des études supérieures pour {{asami.n}}."
msgstr "... Und genug Geld ausgegeben, um {{asami.n}} einen guten Schulabschluss zu finanzieren."

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "t8b422de4bd"
msgid "Qu'elle n'aura jamais du coup..."
msgstr "Den sie nie haben wird ..."

#. Character:`saito` | Attributes:`happy`
#: game/story/arcade_exterior.dialogue
msgctxt "t4e7d6b04cb"
msgid "Haha!"
msgstr "Haha!"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/arcade_exterior.dialogue
msgctxt "te176a569f7"
msgid "Mais ça c'est un secret, il ne faut pas lui dire !"
msgstr "Aber das ist ein Geheimnis, also verrat es ihr nicht!"

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "t755d8bac79"
msgid "Pas de problème."
msgstr "Kein Problem."

#. Character:`sayuri` | Attributes:`moved`
#: game/story/arcade_exterior.dialogue
msgctxt "t3eea93f69b"
msgid "Ça ne te dérange pas si on entre un moment ?"
msgstr "Wäre es in Ordnung, wenn wir kurz eintreten würden?"

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "t19b53547ab"
msgid "J'aimerais voir à quels jeux on joue aujourd'hui !"
msgstr "Ich würde gerne sehen, was für Spiele die Jugend von heute spielt!"

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "tc654514aa3"
msgid "Bien sur, je te suis !"
msgstr "Selbstverständlich, ich bin bei dir!"

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/arcade_exterior.dialogue
msgctxt "td89db23836"
msgid "Mais...[w]Il est déjà aussi tard ?!"
msgstr "Aber ... [w]Es ist schon so spät?!"

#. Character:`saito` | Attributes:`guilty`
#: game/story/arcade_exterior.dialogue
msgctxt "t677ee30eea"
msgid "Tu ne t'en rends compte que maintenant ?"
msgstr "Das hast du erst jetzt bemerkt?"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/arcade_exterior.dialogue
msgctxt "tacabe0ade5"
msgid "Je suis désolée, je n'ai vraiment pas vu le temps passer."
msgstr "Tut mir leid, ich habe die Zeit etwas aus den Augen verloren."

#. Character:`saito` | Attributes:`happy`
#: game/story/arcade_exterior.dialogue
msgctxt "td0bc59358d"
msgid "Ce n'est pas grave, je t'assure."
msgstr "Alles gut, das versichere ich dir."

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "t841b170da0"
msgid "Est-ce que tu as passé un bon moment ?"
msgstr "Hattest du Spaß?"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/arcade_exterior.dialogue
msgctxt "ta963a2a822"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "tb27ad5d583"
msgid "{{sayuri.n}} ?"
msgstr "{{sayuri.n}}?"

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "t9da0a826c8"
msgid "J'ai adorée !"
msgstr "Es war großartig!"

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "t7e1b246e93"
msgid "D'abord le onsen... Puis la salle d'arcade..."
msgstr "Erst der Onsen ... Dann die Spielehalle ..."

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "tf8fe00210a"
msgid "J'ai passée deux jours incroyables."
msgstr "Ich hatte zwei phantastische Tage."

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "t83b010c767"
msgid "Tu as été adorable tout le long... Quel dommage vraiment, quel dommage..."
msgstr "Du warst all die Zeit so liebenswert ... Sehr bedauerlich, wirklich sehr bedauerlich ..."

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "t5040d0dc87"
msgid "Dommage ?"
msgstr "Bedauerlich?"

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "tfe3e4385ca"
msgid "Laisse tomber, je suis juste en avance de 10 ans..."
msgstr "Vergiss es, ich bin nur zehn Jahre vorm Zeitplan ..."

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "ta4b52e68c4"
msgid "Euh... Okay"
msgstr "Ähm ... Okay."

#. Character:`sayuri`
#: game/story/arcade_exterior.dialogue
msgctxt "t2617926ed7"
msgid "Allez ! Mon prince charmant va t'il me raccompagner ?"
msgstr "Komm schon! Wird mich mein Märchenprinz nach Hause bringen?"

#. Character:`saito` | Attributes:`happy`
#: game/story/arcade_exterior.dialogue
msgctxt "t4d14f0ecfa"
msgid "Avec plaisir !"
msgstr "Mit Vergnügen!"

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "INSTALLONS_QUELQUES_AFFICHES_I_7CD32E"
msgid "Installons quelques affiches ici."
msgstr "Lass uns hier ein paar Poster aufhängen."

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "BON_A_DEVRAIT_SUFFIRE_POUR_ICI_D9D85E"
msgid "Bon, ça devrait suffire pour ici, allons voir du côté du konbini."
msgstr "Gut, das sollte fürs Erste reichen. Lass uns beim Kombini weitermachen."

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "NOBU_N_C_EST_S_RIEUX_J_AI_BES_256693"
msgid "{{nobu.n}}, c'est sérieux, j'ai besoin que tu me répondes sur un truc."
msgstr "{{nobu.n}}, das ist todernst. Du musst mir eine Frage beantworten."

#. Character:`nobu` | Attributes:`angry`
#: game/story/arcade_exterior.dialogue
msgctxt "PUTAIN_MAIS_TU_ME_CASSES_LES_C_5BB2E9"
msgid "Putain, mais tu me casses les couilles ! Va plutôt t'occuper de ta copine !"
msgstr "Du gehst mir auf den Sack! Verpiss dich und gib dich lieber mit deiner Freundin ab!"

#. Character:`nobu` | Attributes:`bad`
#: game/story/arcade_exterior.dialogue
msgctxt "AH_OUI_MERDE_C_EST_VRAI_J_AVAI_3A5879"
msgid "Ah oui, merde, c'est vrai ! J'avais oublié qu'elle était sûrement en train de se faire violer dans une cave !"
msgstr "Oh verdammt, hab’ ich total vergessen! Sie vergammel ja gerade in irgendeinem Keller und wird wahrscheinlich vergewaltigt!"

#. Character:`saito` | Attributes:`upset`
#: game/story/arcade_exterior.dialogue
msgctxt "FAIS_ATTENTION_CE_QUE_TU_DIS_S_B7A28E"
msgid "Fais attention à ce que tu dis, sinon..."
msgstr "Pass auf, was du als nächstes sagst, sonst ..."

#. Character:`nobu`
#: game/story/arcade_exterior.dialogue
msgctxt "SINON_QUOI_TA_COPINE_S_EST_FAI_C3302E"
msgid "Sinon quoi ? Ta copine s'est faite enlever et y'a rien que tu puisses faire, t'es vraiment une grosse merde."
msgstr "Sonst was? Deine Freundin wurde entführt und du kannst nichts dagegen machen, du verdammtes Stück Scheiße."

#. Character:`nobu`
#: game/story/arcade_exterior.dialogue
msgctxt "MOI_A_NE_ME_SERAIT_JAMAIS_ARRI_681E47"
msgid "Moi, ça ne me serait jamais arrivé."
msgstr "Mir wäre sowas nie passiert."

#. Character:`saito`
#: game/story/arcade_exterior.dialogue
msgctxt "SI_SI_TU_SAIS_QUELQUE_CHOSE_J_81F728"
msgid "... Si... si tu sais quelque chose, je dois..."
msgstr "... Wenn ... wenn du irgendetwas weiß, muss ich ..."

#. Character:`nobu`
#: game/story/arcade_exterior.dialogue
msgctxt "BAH_ALORS_ON_B_GAIE_01E1DE"
msgid "Bah alors ? On bégaie ?"
msgstr "Na und? Was ist denn los? Plötzlich das Sprechen verlernt?"

#. Character:`saito` | Attributes:`angry`
#: game/story/arcade_exterior.dialogue
msgctxt "JE_CONTIENS_JUSTE_MON_ENVIE_DE_16262B"
msgid "Je contiens juste mon envie de te faire bouffer mon poing..."
msgstr "Ich kämpfe nur gegen den Drang an, dir die Fresse zu polieren ..."

#. Character:`nobu` | Attributes:`mocking`
#: game/story/arcade_exterior.dialogue
msgctxt "OH_MAIS_C_EST_QU_IL_EST_DEVENU_471DA6"
msgid "Oh, mais c'est qu'il est devenu violent ?"
msgstr "Oh, werden wir jetzt etwa gewalttätig?"

#. Character:`nobu` | Attributes:`angry`
#: game/story/arcade_exterior.dialogue
msgctxt "TU_CROIS_QUOI_PARCE_QUE_TU_M_A_B7E949"
msgid "Tu crois quoi ? Parce que tu m'as battu une fois, tu es devenu un tueur ? Tu m'as eu par surprise !"
msgstr "Was glaubst du? Nur weil du mich einmal erwischt hast, glaubst du, du wärst ein krasser Schläger? Du hast mich einfach überrascht!"

#. Character:`nobu`
#: game/story/arcade_exterior.dialogue
msgctxt "JE_T_CLATE_QUAND_TU_VEUX_SURTO_97FDA8"
msgid "Je t'éclate quand tu veux ! Surtout depuis que j'ai commencé les cours au dojo !"
msgstr "Ich werde jederzeit mit dir fertig! Besonders, seitdem ich im Dojo unterrichtet werde!"

#. Character:`nobu` | Attributes:`bad`
#: game/story/arcade_exterior.dialogue
msgctxt "MEC_T_AS_PAS_ID_E_DE_CE_QU_ON_E8C03E"
msgid "Mec ! T'as pas idée de ce qu'on peut y apprendre !"
msgstr "Alter! Du hast ja keine Ahnung, was man da alles lernen kann!"

#. Character:`nobu`
#: game/story/arcade_exterior.dialogue
msgctxt "AH_OUI_C_EST_VRAI_QUE_TU_N_AS_5EB367"
msgid "Ah oui, c'est vrai que tu n'as pas le droit d'y aller..."
msgstr "Oh, stimmt ja, du darfst da ja nicht hingehen ..."

#. Character:`nobu`
#: game/story/arcade_exterior.dialogue
msgctxt "J_AI_JAMAIS_VU_UN_LOSER_PAREIL_7B063F"
msgid "J'ai jamais vu un loser pareil !"
msgstr "Ich habe noch nie so einen Versager kennengelernt!"

#. Character:`nobu` | Attributes:`mocking`
#: game/story/arcade_exterior.dialogue
msgctxt "ALLEZ_JE_ME_TIRE_VU_QUE_TU_N_A_827F70"
msgid "Allez, je me tire. Vu que tu n'as plus de copine, tu devrais retourner te branler tout seul dans ta chambre !"
msgstr "Scheiß drauf, ich bin hier raus."

#. TRANSLATORS: # placeholder de sakuya qui regarde par la vitre de l'arcade center Character:`sakuya`
#: game/story/arcade_exterior.dialogue
msgctxt "FONT_SIZE_14_NON_NON_NON_TU_E_DECC36"
msgid "[font_size=14]Non non non ! Tu es trop près de lui ![/font_size]"
msgstr ""

#. Character:`sakuya`
#: game/story/arcade_exterior.dialogue
msgctxt "FONT_SIZE_14_ARR_TE_DE_LE_COL_D92B80"
msgid "[font_size=14]Arrête de le coller comme ça ![/font_size]"
msgstr ""

#. Character:`sakuya`
#: game/story/arcade_exterior.dialogue
msgctxt "FONT_SIZE_14_SAITO_N_NE_TE_LA_8C8261"
msgid "[font_size=14]{{saito.n}} ne te laisse pas avoir comme ça, si elle se frotte à toi comme ça c’est volontaire ![/font_size]"
msgstr ""

#. Character:`sakuya`
#: game/story/arcade_exterior.dialogue
msgctxt "FONT_SIZE_14_JE_DEVRAIS_FONT_640DD7"
msgid "[font_size=14]Je devrais...[/font_size]"
msgstr ""

#. Character:`nobu`
#: game/story/arcade_exterior.dialogue
msgctxt "HEY_A_C_EST_UN_JOLI_CUL_OU_JE_11BAFA"
msgid "Hey ! Ça c’est un joli cul, ou je ne m’y connais pas !"
msgstr ""

#. Character:`nobu`
#: game/story/arcade_exterior.dialogue
msgctxt "RETOURNE_TOI_J_AIMERAIS_VOIR_S_671C52"
msgid "Retourne-toi, j’aimerais voir si tu es tout aussi mignonne de l’autre côté."
msgstr ""

#. Character:`sakuya`
#: game/story/arcade_exterior.dialogue
