msgid "Je dois rester discret le temps de trouver une solution."
msgstr "Ich muss unter dem Radar bleiben, bis ich eine Lösung gefunden habe."

#. Character:`noriko`
#: game/story/home_player_exterior.dialogue
msgctxt "home_player_exterior_fdfd5503"
msgid "PUTAIN !"
msgstr "FUCK!"

#. Character:`noriko`
#: game/story/home_player_exterior.dialogue
msgctxt "home_player_exterior_a244dcef"
msgid "J'me demandais quel attardé pouvait spammer la sonnette comme ça..."
msgstr "Ich habe mich gefragt, was für ein Idiot diese Klingel so vergewaltigen würde..."

#. Character:`noriko`
#: game/story/home_player_exterior.dialogue
msgctxt "home_player_exterior_7d18f9a3"
msgid "...et voilà, t'es content ? Tu as fait mumuse ?"
msgstr "...und da hätten wir’s. Bist du glücklich? Hattest du Spaß?"

#. Character:`noriko`
#: game/story/home_player_exterior.dialogue
msgctxt "home_player_exterior_e642177e"
msgid "Tu vas nous laisser dormir à présent ?"
msgstr "Lässt du uns jetzt schlafen?"

#. Character:`noriko`
#: game/story/home_player_exterior.dialogue
