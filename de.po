msgstr ""

#. Character:`yasuka`
#: game/story/home_player_exterior.dialogue
msgctxt "ET_M_ME_AVEC_TOUS_MES_SOUCIS_A_8F0FE6"
msgid "Et même avec tous mes soucis, ça fait de moi la femme la plus heureuse à cet instant."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_exterior.dialogue
msgctxt "BONNE_NUIT_MON_CH_RI_321E65"
msgid "Bonne nuit mon chéri !"
msgstr ""

