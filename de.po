msgstr "Du bist unermüdlich ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_66dbe0e7"
msgid "C'est toi qui me donnes envie de me dépasser !"
msgstr "Du bist diejenige, die mich dazu bringt, über meine Grenzen hinauszugehen!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_9fc616da"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_dfbd72bc"
msgid "Je suis sûre qu'elle me ment !"
msgstr "Ich bin mir sicher, dass sie mich anlügt!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_df6fa795"
msgid "Ma chérie, je suis très occupée avec {{saito.n}} !"
msgstr "Süße, ich bin mit {{saito.n}} sehr beschäftigt!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_157cf316"
msgid "Repasse dans une... Non, deux heures !"
msgstr "Komm wieder in einer ... Nein, zwei Stunden!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_c6d5b18e"
msgid "Quoi, deux heures ?! M-"
msgstr "Was, zwei Stunden?! Aber-"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_6aa0ac01"
msgid "Je t'avais dit que cette situation serait compliquée."
msgstr "Ich habe dir gesagt, dass die Situation kompliziert werden würde."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_edfa2d71"
msgid "Je sais..."
msgstr "Ich weiß ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_283f1b0c"
msgid "Mais je m'en fiche."
msgstr "Aber das ist mir egal."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_fe787873"
msgid "Je veux en profiter sans être dérangée !"
msgstr "Ich möchte Spaß haben, ohne gestört zu werden!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_77b103d4"
msgid "Vos désirs sont des ordres !"
msgstr "Dein Wunsch ist mir Befehl!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t0184c7b5e1"
msgid "Timelapse"
msgstr "Zeitraffer"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_34ec5686"
msgid "Mon Dieu..."
msgstr "Oh Gott ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_7d28106d"
msgid "Je n'en peux plus !"
msgstr "Ich halt’s nicht mehr aus!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_1c6454c3"
msgid "Dis-moi que tu as eu ton compte ?"
msgstr "Bitte sag mir, dass du genug hattest?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_b25c2222"
msgid "[font_size=14]Merci mon chéri...[/font_size]"
msgstr "[font_size=14]Danke, Liebling ...[/font_size]"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_f96b0c16"
msgid "[font_size=14]Tu veux rester dormir ici ?[/font_size]"
msgstr "[font_size=14]Möchtest du heute hier schlafen?[/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_53c814c7"
msgid "Allez, j'ai du pain sur la planche !"
msgstr "Ich habe alle Hände voll zu tun!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t5de7c9f377"
msgid "Pourquoi pas !"
msgstr "Warum nicht?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_a9dad176"
msgid "D'accord."
msgstr "Alles klar."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_124b9811"
msgid "Bonne nuit mon chéri."
msgstr "Gute Nacht, Süßer."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_70821b2f"
msgid "Tu m'as épuisée, je crois que je pourrais m'endormir d'une seconde à l'autre."
msgstr "Du hast mich ausgelaugt. Ich glaube, ich könnte jeden Moment einschlafen."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_9ffdfbf9"
msgid "Bonne nuit !"
msgstr "Gute Nacht!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_c14d9a6c"
msgid "Bonne nuit mon chéri !"
msgstr "Gute Nacht, mein Schatz!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t93a60f627c"
msgid "J'ai encore des choses à faire."
msgstr "Ich habe immer noch Sachen zu erledigen."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t4a3aa2f59a"
msgid "Ça ira pour aujourd'hui !"
msgstr "Für heute reicht’s mir!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_8e2b7d21"
msgid "Tu es vraiment infatigable..."
msgstr "Du bist wirklich unermüdlich ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_9d9c47d0"
msgid "[font_size=14]Mais j'adore ça ![/font_size]"
msgstr "[font_size=14]Aber genau dafür liebe ich dich![/font_size]"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t9568e93c9b"
msgid "Encore !"
msgstr "Mehr!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_64c09b00"
msgid "Elle a l'air de dormir à poing fermé."
msgstr "Sie scheint fest zu schlafen."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_3c746642"
msgid "Je ferai peut-être mieux de m'assurer qu'elle n'est pas fait un malaise."
msgstr "Ich sollte lieber sichergehen, dass es ihr gut geht."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_4bc5f2cf"
msgid "Ou autre chose."
msgstr "Oder sowas."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_edb624be"
msgid "J'allume la lumière quelques secondes, ça devrait me permettre d'avoir la conscience tranquille."
msgstr "Ich werde das Licht für ein paar Sekunden anmachen. Das sollte genug für mein Gewissen sein."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_4ad13b11"
msgid "Eh bien, eh bien, qui voilà ?"
msgstr "Na, wen haben wir denn da?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_005e16fd"
msgid "Moi qui pensais devoir venir dans ta chambre pour une petite visite nocturne..."
msgstr "Und ich dachte schon, ich müsste heute Nacht in dein Zimmer kommen ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_14bfc72d"
msgid "{{yasuka.n}} est-ce que tout va bien ?"
msgstr "Ist alles gut, {{yasuka.n}}?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_57a791c0"
msgid "Il semblerait qu'au club, tu aies été droguée par..."
msgstr "Es scheint so, als wären dir im Nachtklub Drogen unter-"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_fb13de64"
msgid "Shhhh, ne dit rien !"
msgstr "Pschhht, sag nichts!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_18ed30a1"
msgid "Je promets de t'écouter autant que tu le souhaites, mais avant..."
msgstr "Ich verspreche dir, dass ich dir so viel zuhören werde, wie du willst, aber zuerst ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_50d4b793"
msgid "Avant ?"
msgstr "Zuerst?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_cfdda3c3"
msgid "Je veux que tu viennes te glisser sous les couvertures avec moi."
msgstr "Möchte ich, dass du mit unter meine Decke kommst."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_8baf7f76"
msgid "Non {{yasuka.n}}, justement, c'est ça le problème !"
msgstr "Nein, {{yasuka.n}}, genau das ist doch das Problem!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_dc45f29b"
msgid "Tu n'es plus dans ton état normal, t-"
msgstr "Du bist nicht so recht bei Verstand!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_750aa037"
msgid "Il me semble pourtant que tu n'étais pas aussi timide la dernière fois que je suis venu dans ta chambre..."
msgstr "Ich meine, mich erinnern zu können, dass du das letzte Mal, als ich in dein Zimmer kam, nicht so schüchtern warst ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_66332e88"
msgid "Ce grand lit est vraiment très froid, et j'aimerais beaucoup que tu viennes me réchauffer."
msgstr "Dieses riesige Bett ist wirklich kalt und ich würde mich sehr freuen, wenn du mich wärmen würdest."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_7f9d4463"
msgid "Je... Je..."
msgstr "Ich ... ich ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_00dc0725"
msgid "Je dois te parler de quelque chose d'important avant !"
msgstr "Ich muss vorher mit dir über etwas Wichtiges reden!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_3969010e"
msgid "Mais tu as été dr-"
msgstr "Du bist auf Drog-"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_b0f7b963"
msgid "Tututu ! Je ne veux rien entendre. Promis, j'écouterai ce que tu as à me dire après !"
msgstr "Pscht! Ich will nichts hören. Ich verspreche dir, dass ich dir nachher zuhören werde!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_889d3700"
msgid "Mais avant ça..."
msgstr "Aber davor ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_a05e5d3f"
msgid "J'ai envie de toi maintenant, rejoins-moi tout de suite dans ce lit !"
msgstr "Möchte ich, dass du endlich zu mir ins Bett kommst!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_b57b8c90"
msgid "Bon... Elle n'en démordra pas."
msgstr "Wow ... Sie wird nicht aufgeben."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_8965df4e"
msgid "Après, c'est peut-être affreux de penser ça mais..."
msgstr "Wie auch immer, es mag schrecklich von mir sein, das in Erwägung zu ziehen, aber ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_bd58c0f4"
msgid "Le faire avec elle est loin pour me déplaire."
msgstr "Mit ihr zu schlafen ist weit davon entfernt, ein unangenehmer Gedanke zu sein."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_c88feff6"
msgid "Mais est-ce que ça ne serait pas abuser de son état ?"
msgstr "Aber würde ich sie da in diesem Zustand nicht ausnutzen?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_cf47fddc"
msgid "Rhaaaa ! Pourquoi je me prends la tête comme ça ?"
msgstr "Naaaa, warum mache ich die Dinge nur so kompliziert?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_030ce30c"
msgid "Mon chéri... Maman veut ton sexe en elle !"
msgstr "Liebling ... Mama will deinen Schwanz in sich spüren!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_417d9d8f"
msgid "Dépêche-toi, sinon c'est moi qui viendrai te chercher !"
msgstr "Beeil dich oder ich hole dich!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_65d86c48"
msgid "Mam- Je... Oui, tout de suite !"
msgstr "Ma- Ich ... Ja, natürlich!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_5cf01dee"
msgid "Oh et puis merde, je suis bien trop excité maintenant pour penser de manière rationnelle !"
msgstr "Oh Scheiße, ich bin viel zu erregt, um jetzt rational zu denken!"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_1f978e50"
msgid "Quitte à passer à l'acte, je préfère que ce soit avec moi."
msgstr "Wenn sie das tun muss, würde ich es vorziehen, wenn es mit mir wäre."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_a5acbba5"
msgid "Eh bien, tu vois quand tu veux..."
msgstr "Nun, du wirst schon sehen, wenn du willst ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_8bb19557"
msgid "Mmmmh... Oui !"
msgstr "Mmmmh ... Ja!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_2c2b9cea"
msgid "J'attendais ça depuis si longtemps."
msgstr "Ich habe so lange darauf gewartet."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_6eef6615"
msgid "Pourquoi tu ne voyais pas tous les signaux que je t'envoyais ?"
msgstr "Warum hast du nie auf all die Signale, die ich dir gegeben habe, reagiert?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "sleeping_with_yasuka_2_ac6d81a7"
msgid "Pourquoi as-tu pris autant de temps ?"
msgstr "Was hat bei dir so lange gedauert?"

#. Character:`yasuka`
