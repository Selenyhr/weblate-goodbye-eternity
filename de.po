#~ msgid "Autant en finir tout de suite."
#~ msgstr "Da kann ich das auch gleich hinter mich bringen."

#~ msgctxt "talk_asami_24787d1c"
#~ msgid "Je vais prendre un peu d'avance, je crois."
#~ msgstr "Ich glaube, ich nehme mir einen kleinen Vorsprung."

