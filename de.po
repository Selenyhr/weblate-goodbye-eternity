msgctxt "yasuka_love_sexe_repeat_47687564"
msgid "\"Ca\" m'a manquée."
msgstr "Ich habe „ihn“ vermisst."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_3eadf778"
msgid "Tu m'as manquée aussi mais je suis un peu f-"
msgstr "Ich habe dich auch vermisst, aber ich bin etwas mü-"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_dd93b3f4"
msgid "Ne t'inquiète pas... Nous ne sommes pas obligés de faire des folies."
msgstr "Keine Sorge ... Wir müssen nichts Verrücktes machen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_245458f4"
msgid "Nous pouvons aussi faire ça tendrement."
msgstr "Wir können es heute auch langsam angehen lassen."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_9156b917"
msgid "Je..."
msgstr "Ich ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_fbd34660"
msgid "Allez viens !"
msgstr "Komm schon!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_aaa9f4fd"
msgid "d'accord..."
msgstr "Okay ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_b0f8d7e3"
msgid "Et bien {{noriko.n}}, j'espère que tu as pu réussir a sortir de la chambre sinon..."
msgstr "Gut, {{noriko.n}}, ich hoffe, du hast es aus dem Zimmer geschafft, ansonsten ..."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_90dc4bec"
msgid "Tu risques de passer un moment bien malaisant..."
msgstr "Wird das jetzt für dich etwas unangenehm ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t78db667372"
msgid "Tu semblais étrange, quelque chose ne va pas ?"
msgstr "Du wirkst besorgt, stimmt etwas nicht?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t214c929c88"
msgid "Non, non, tout va bien."
msgstr "Nein, nein. Alles ist gut."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "te204b19f32"
msgid "Je le sais quand tu me caches des choses..."
msgstr "Ich merke es, wenn du Sachen vor mir verheimlichst ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tc79df12ff2"
msgid "Regarde-moi bien dans les yeux et laisse-moi t'aider à oublier tes problèmes."
msgstr "Schau mir in die Augen und lass mich dir helfen, all deine Probleme zu vergessen."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tc6faa8eda8"
msgid "Oui... Pardon, je ne peux décidément rien te cacher."
msgstr "Ja ... tut mir leid. Ich scheine wohl wirklich nichts vor dir verstecken zu können."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t3134935fa8"
msgid "Allez viens là !"
msgstr "Komm her."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "te7c15a9046"
msgid "Hmm voilà comme ça !"
msgstr "Hmmm, genau so."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t9c8b2fb57f"
msgid "Juste toi et moi."
msgstr "Nur du und ich."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tbc38954e8f"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tcd45d29baa"
msgid "Continue mon chéri !"
msgstr "Mach weiter so, Süßer."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t7f720676ac"
msgid "Ce soir tu m'appartiens."
msgstr "Heute Nacht gehörst du mir."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t691130f681"
msgid "et je suis aussi tout à toi."
msgstr "Und ich dir."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t9a06ecb448"
msgid "Oh mon dieu, Oui !"
msgstr "Oh mein Gott, ja!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t0219c71d3e"
msgid "Je vais jouir !"
msgstr "Ich komme gleich!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tf28683a90d"
msgid "Jouis avec moi."
msgstr "Komm mit mir!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "taf6c5a0274"
msgid "Ahh... Ouiii!"
msgstr "Ahh ... Jaaaa!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_51660c14"
msgid "Elle a fini par s'endormir..."
msgstr "Sie ist eingeschlafen ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_228305a3"
msgid "Bon sang quelle soirée."
msgstr "Verdammt, was für eine Nacht."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_d6a6c8c6"
msgid "[font_size=14]Bordel pourquoi il a fallu que tu fasses ça avec ma mere juste sous mon nez !![/font_size]"
msgstr "[font_size=14]Verdammt nochmal! Warum musstest du das mit meiner Mutter treiben direkt vor meinen Augen?![/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_2c33ae4a"
msgid "[font_size=14]Désolé... Je n'ai pas pu lui dire non, je pensais que tu avais réussi a sortir.[/font_size]"
msgstr "[font_size=14]Entschuldige ... Sie hat kein Nein akzepiert. Ich dachte, du hättest es geschafft, dich aus dem Zimmer zu schleichen.[/font_size]"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_8e197ac3"
msgid "[font_size=14]Et comment j'aurais pu faire ? Vous étiez tous les deux dans le salon ![/font_size]"
msgstr "[font_size=14Und wie hätte ich das anstellen sollen? Ihr wart beide im Wohnzimmer![/font_size]"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_bf56975f"
msgid "[font_size=14]Et puis comment ça se fait que tu aies pu enchaîner avec elle après tout ce qu'on a fait toi et moi ?[/font_size]"
msgstr "[font_size=14]Außerdem, wie hast du es geschafft, dass sich die Dinge so zwischen euch entwickeln, nach allem, was wir gemeinsam getan haben?[/font_size]"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_bb829b7c"
msgid "[font_size=14]C'est peut être pas le meilleur moment pour discuter de ça...[/font_size]"
msgstr "[font_size=14]Vielleicht ist jetzt gerade nicht der beste Augenblick, um darüber zu reden ...[/font_size]"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "yasuka_love_sexe_repeat_fa9e5d57"
msgid "[font_size=14]...[/font_size]"
msgstr "[font_size=14]...[/font_size]"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t262844bbf6"
msgid "et bien... Ca a l'air assez grave."
msgstr "Na ja ... Das sieht ziemlich ernst aus."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t827064d1fa"
msgid "En effet."
msgstr "In der Tat."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t45f43b7d2a"
msgid "Tu as une idée pour lui faire retrouver le sourire ?"
msgstr "Hast du irgendwelche Ideen, wie du sie wieder zum Lachen bringen kannst?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t3c19c8622e"
msgid "Tout ça m'a fait repenser à nous."
msgstr "All das hier hat mich dazu gebracht, über uns nachzudenken."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t710909f630"
msgid "A nous ? Comment ça ?"
msgstr "Über uns? Inwiefern?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tf23b23d2fe"
msgid "Tu n'as pas idée à quel point j'étais heureuse d'être enfin considérée comme une femme après tout ce temps."
msgstr "Du hast keine Idee, wie glücklich ich war, als ich nach all der Zeit endlich als Frau angesehen zu werden."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tbcfca6d888"
msgid "Redécouvrir le plaisir d'aimer et d'être aimé en retour."
msgstr "Den Genuss der gegenseitigen Liebe neuzuentdecken."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "td2e615574d"
msgid "Tu m'as comblée de bonheur quand tu t'es occupé de moi, tout ça m'a donné une idée."
msgstr "Du hast mich mit Freude erfüllt, wenn du dich um mich gekümmert hast und das hat mir eine Idee gegeben."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "TU_N_AS_PAS_ID_E_QUEL_POINT_J_13A6F3"
msgid "Tu n'as pas idée à quel point j'étais heureuse d'être enfin soutenue après tout ce temps à lutter seule."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "AVOIR_UNE_PAULE_SUR_LAQUELLE_S_58C7B8"
msgid "Avoir une épaule sur laquelle s'appuyer."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "TOUT_A_M_A_COMBL_E_DE_BONHEUR_A059C6"
msgid "Tout ça m'a comblée de bonheur et ça me donne une idée..."
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t841c1f176c"
msgid "Je ne suis pas sûr de savoir où tu veux en venir."
msgstr "Ich weiß nicht, worauf du hinauswillst."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t8e1e247912"
msgid "J'aimerais que {{sayuri.n}} puisse connaitre ce même bonheur."
msgstr "Ich wünsche mir, dass {{sayuri.n}} dieselbe Freude erfahren kann."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t6cc7eb957c"
msgid "Sinon j'ai peur qu'elle fasse des bêtises qu'elle pourrait regretter."
msgstr "Ansonsten, befürchte ich, könnte sie etwas Dummes anstellen, was sie später bereuen wird."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t2e069a817d"
msgid "Et bien présenté de cette façon c'est difficile de refuser."
msgstr "Nun ja, wenn du es so formulierst, kann man ja kaum nein sagen."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t842201da64"
msgid "Quel est le problème ? Tu ne l'apprécies pas ?"
msgstr "Wo liegt das Problem? Magst du sie nicht?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t4879fc7ac8"
msgid "Non, non, rien a voir."
msgstr "Nein, nein, das ist es nicht."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t3cae13c655"
msgid "C'est une femme gentille et très attachante mais... Tu ne vas pas être... Jalouse si je passe plus de temps avec elle qu'avec toi ?"
msgstr "Sie ist eine nette und wirklich liebenswerte Frau, aber ... wirst du nicht ein wenig ... eifersüchtig, wenn ich mit ihr mehr Zeit als mit dir verbringe?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t870aa99030"
msgid "Mon chéri, c'est adorable que tu penses à moi avant tout mais ne t'en fais pas, il ne s'agit que de quelques jours le temps que sa fille ne revienne."
msgstr "Liebling, es ist süß, dass du zuerst an mich denkst, aber mach dir keine Sorgen. Es sind ja nur die paar Tage, bis ihre Tochter zurückkommt."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t634d5683c6"
msgid "Autre problème que je vois.... {{sayuri.n}} acceptera t'elle de passer du temps avec un homme qui à l'âge de sa fille."
msgstr "Das ist ein weiteres Problem ... Ist {{sayuri.n}} dazu bereit, Zeit mit einem Jungen des Alters ihrer Tochter zu verbringen?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t670df50b98"
msgid "Ne t'inquiète pas, je sais de source sûre qu'elle n'est pas insensible à tes charmes."
msgstr "Keine Sorge, ich kann dir mit absoluter Sicherheit sagen, dass sie gegen deinen Charme nicht immun ist."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "tfb2f7a06d7"
msgid "Une seconde, ça veut dire quoi ça...?"
msgstr "Warte mal, was soll das heißen ...?"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "t1fac59ba5f"
msgid "Allez viens avec moi !"
msgstr "Komm schon, komm mit!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "MAMAN_POURQUOI_SAITO_N_N_EST_T_28B170"
msgid "Maman... Pourquoi {{saito.n}} n'est toujours pas rentré ?"
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "TU_T_INQUI_TES_POUR_LUI_6574ED"
msgid "Tu t'inquiètes pour lui ?"
msgstr ""

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "NON_C_EST_JUSTE_QUE_IL_EST_DI_B5AD20"
msgid "... Non... c'est juste que... il est... différent..."
msgstr ""

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "AH_JE_NE_SUIS_DONC_PAS_LA_SEUL_47EFB7"
msgid "Ah ! Je ne suis donc pas la seule à l'avoir remarqué."
msgstr ""

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "QUELQUE_CHOSE_A_CHANG_DANS_SON_1E385F"
msgid "Quelque chose a changé dans son regard, il est plus vif qu'auparavant."
msgstr ""

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "A_NE_R_POND_TOUJOURS_PAS_MA_Q_D2BA58"
msgid "Ça ne répond toujours pas à ma question... Et s'il avait eu un problème ?"
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "JE_CROIS_QUE_NOTRE_SAITO_N_FAI_75A64A"
msgid "Je crois que notre {{saito.n}} fait tout simplement de son mieux."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "NOUS_DEVONS_LUI_FAIRE_CONFIANC_CE9A3A"
msgid "Nous devons lui faire confiance, il est adulte et capable de prendre ses propres décisions."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "SI_TU_AS_DU_MAL_TROUVER_LE_SOM_5BEEDB"
msgid "Si tu as du mal à trouver le sommeil, tu peux toujours l'attendre un peu devant la maison."
msgstr ""

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "OUI_JE_VAIS_FAIRE_A_E551EA"
msgid "Oui, je vais faire ça !"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "TOUT_VA_BIEN_E19B1B"
msgid "Tout va bien ?"
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "OH_C_EST_MON_CH_RI_TU_AS_PASS_2474E3"
msgid "Oh, c'est mon chéri ! Tu as passé un bon moment avec {{asami.n}} ?"
msgstr ""

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "OUI_JE_VOULAIS_TE_REMERCIER_PO_90B9C9"
msgid "Oui, je voulais te remercier pour ça, justement..."
msgstr ""

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "C_EST_SOUVENT_ASSEZ_BRUYANT_LA_1B8C95"
msgid "C'est souvent assez bruyant à la maison en ce moment."
msgstr ""

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "NE_T_EN_FAIS_PAS_JE_COMPRENDS_543A9F"
msgid "Ne t'en fais pas, je comprends."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "DE_TOUTE_FA_ON_A_NE_SERA_PLUS_119947"
msgid "De toute façon, ça ne sera plus un problème."
msgstr ""

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "POURQUOI_A_C75527"
msgid "Pourquoi ça ?"
msgstr ""

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "JE_VAIS_DEVOIR_REPRENDRE_LE_TR_628E19"
msgid "Je vais devoir reprendre le travail après ces quelques jours de repos que j'ai pu négocier après des années sans en avoir pris..."
msgstr ""

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "DES_ANN_ES_SANS_AVOIR_PRIS_DE_3606CC"
msgid "Des années sans avoir pris de congés... ?"
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "JE_SAIS_HORRIBLE_N_EST_CE_PAS_A4D44A"
msgid "Je sais... horrible, n'est-ce pas ?"
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "MAIS_COMME_NOUS_CROULONS_SOUS_89047E"
msgid "Mais comme nous croulons sous une dette colossale, je culpabilisais à prendre du repos."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
#: game/story/home_player_yasuka_room.dialogue
msgctxt "MAIS_CETTE_FOIS_CI_C_EST_DIFF_18E187"
msgid "Mais cette fois-ci, c'est différent, j'ai une décision à prendre."
msgstr ""

