#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_9650078c"
msgid "Quand il faut y aller, faut y aller !"
msgstr "Wenn es Zeit ist, zu gehen, kann man nichts machen!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_5308c43e"
msgid "{{noriko.n}}... Ahem... Je peux te parler un instant ?"
msgstr "Hey, {{noriko.n}} ... Könnte ich vielleicht eine Sekunde mit dir reden?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_29cd7803"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_18fae4d1"
msgid "Je suis à la recherche de mon vieux MP3..."
msgstr "Weißt du, ich bin auf der Suche nach meinem Walkman ..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_278e7c99"
msgid "Tu ne l'aurais pas vu à tout has...."
msgstr "Ich habe mich gefragt, ob du ihn vielleicht gese-"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_a1d6bd2c"
msgid "...Évidemment !"
msgstr "... Natürlich!"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_1ed63590"
msgid "Bon... Il va falloir trouver une stratégie plus efficace..."
msgstr "Nun ... Ich befürchte, wir müssen eine bessere Strategie finden ..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_a2a2c4f6"
msgid "Elle doit probablement jouer sur son PC, peut-être que..."
msgstr "Sie spielt wahrscheinlich wieder auf ihrem PC ..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_3f06fac8"
msgid "Si je lui coupe le wifi, je suis certain à 200% qu'elle va sortir de sa chambre !"
msgstr "Vielleicht kann ich sie aus ihrem Zimmer locken, indem ich das WLAN abstelle."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_7a9b7c49"
msgid "Le routeur doit être dans le [color=yellow]salon[/color]."
msgstr "Der Router ist im [color=yellow]Wohnzimmer[/color]."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_closed_d6ed5375"
msgid "Il va falloir être rapide !"
msgstr "Ich muss aber schnell sein."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_e7719ae9"
msgid "Qu'est-ce qu'elle regardait comme ça... ?"
msgstr "Was hat sie sich angeschaut...?"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_c4e3d3da"
msgid "Putain de bordel de merde... !"
msgstr "Heilige Scheiße...!"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_1eb724ef"
msgid "C'est quoi ça ?!"
msgstr "Ist das?!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_32cbd8c8"
msgid "AAAAAAH !"
msgstr "AAAAAAH!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_7095c62a"
msgid "QU'EST-CE QUE TU FAIS DANS MA CHAMBRE ?!!"
msgstr "WAS HAST DU IN MEINEM ZIMMER ZU SUCHEN?!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_e4920734"
msgid "ENFOIRÉ ! T'AVAIS PAS LE DROIT DE REGARDER ÇA !!"
msgstr "NIEMAND GIBT DIR DAS RECHT, DAS ANZUSCHAUEN!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_cdac2962"
msgid "T'ES VRAIMENT UN PUTAIN DE CONNARD !"
msgstr "DU BIST EIN GOTTVERDAMMTES ARSCHLOCH!"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_7c415df9"
msgid "Et merde ! Pris en flag, ça pouvait pas tomber plus mal..."
msgstr "Scheiße! Gerade jetzt erwischt zu werden..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_b355c7c6"
msgid "Désolé... Vraiment !"
msgstr "Es tut mir leid... Wirklich!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_95378fb1"
msgid "T'ES DÉSOLÉ ?! TU CROIS QUE CA VA SUFFIRE ?"
msgstr "Es tut dir leid? Glaubst du, das ist genug?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_8cb036f5"
msgid "Non... Je..."
msgstr "Nein... Ich..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_2189f730"
msgid "Comment je peux me faire pardonner ?"
msgstr "Wie kann ich das wiedergutmachen?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_29cd7803"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_bdd910de"
msgid "...[font_size=14]à genoux[/font_size]"
msgstr "...[font_size=14]Auf die Knie.[/font_size]"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_9302ef11"
msgid "Quoi ? Mais..."
msgstr "Was?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_cd1ef043"
msgid "J'ai dit..."
msgstr "Ich sagte..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_34e61ed7"
msgid "À GENOUX !"
msgstr "GEH AUF DIE KNIE!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_00296699"
msgid "Outch !"
msgstr "Autsch!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_dae92ccc"
msgid "Tu vas devoir comprendre, qu'ici..."
msgstr "Ich denke, es ist an der Zeit, dass du es endlich verstehst..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_5c7d1578"
msgid "Tu n'es..."
msgstr "Du bist..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_25d2851c"
msgid "rien de plus qu'un..."
msgstr "nichts weiter als ein..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_7ab81800"
msgid "...misérable."
msgstr "armseliger..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_657a7a37"
msgid "Putain de..."
msgstr "verfickter..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_569d390a"
msgid "CLÉBARD !"
msgstr "HUND!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_3e20ec33"
msgid "Arrête ça... !"
msgstr "Hey, lass das...!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_78450098"
msgid "Chuuut, pas un mot, ni maintenant, ni jamais."
msgstr "Ich habe dir nicht erlaubt, zu bellen, kleines Hündchen."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_bebcd775"
msgid "Dorénavant, tu m'obéiras au doigt et à l'œil..."
msgstr "Ab sofort gehorchst du mir, verstanden? Jedes Wort, jeder Befehl. Wenn ich spreche, hörst du zu."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_ce8f4e97"
msgid "Et si je refuse ?"
msgstr "Was, wenn ich mich weigere?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_b2f72d90"
msgid "J'irai voir maman et lui dirais que tu m'as violé plusieurs fois dans mon enfance."
msgstr "Dann erzähle ich Mama einfach, dass du mich im Laufe der Zeit ein paar mal vergewaltigt hast."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_4ef9bc25"
msgid "Quoi ?! Mais j'ai jam... !"
msgstr "Was?! Aber ich würde nie...!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_e17c6ce8"
msgid "TU OBÉIRAS !"
msgstr "Es sei denn, du gehorchst mir."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_b14bf260"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_b3183e43"
msgid "Parfait ! Maintenant dégage de ma chambre !"
msgstr "Perfekt! Und jetzt verschwinde aus meinem Zimmer, Hündchen! Ich habe zu tun."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_e100ab91"
msgid "Maman te l'a emprunté. Je ne touche pas à tes affaires, j'ai pas envie de choper le cancer !"
msgstr "Mama hat ihn sich ausgeliehen. Ich fasse deinen Kram nicht an. Ich will doch keinen Krebs bekommen!"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_a21e86ee"
msgid "..."
msgstr "..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_f5f4e555"
msgid "Qu'est-ce qu-"
msgstr "Was ..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_29621d39"
msgid "Merde... Mais qu'est-ce qui vient de se passer ?!"
msgstr "Was zur Hölle ist gerade passiert?"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_acd28135"
msgid "Je savais qu'elle était odieuse, mais pas qu'elle avait un côté sadique."
msgstr "Ich wusste ja, dass sie eine Bitch ist, aber noch dazu eine Sadistin?"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_025cac24"
msgid "Je me suis bien fait baiser la gueule, j'avais oublié ce chantage..."
msgstr "Und jetzt..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_2b81833a"
msgid "Je suis coincé à obéir à tous ses caprices !"
msgstr "Muss ich ihr aufs Wort gehorchen."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_a21e86ee_1"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_17e596ff"
msgid "FERME LÀ !"
msgstr "Ach, halt die Fresse!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_27fe91d9"
msgid "Si tu t'étais contentée de me répondre dès le départ, on n'en serait pas arrivé là !"
msgstr "Wenn du mir einfach geantwortet hättest, als ich angeklopft habe, wären wir beide jetzt nicht in dieser Situation."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_2b82e184"
msgid "Il faut que je me sorte de là avant que ça ne dégénère..."
msgstr "Ich muss hier raus, bevor sie völlig durchdreht..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_093f4a70"
msgid "Il me faut une idée et vite..."
msgstr "Ich brauche einen Plan, schnell..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_4b35a18b"
msgid "Je vais tenter quelque chose..."
msgstr "Lass uns mal sehen..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_e0cc54b7"
msgid "Je ne sais plus quoi faire avec toi {{noriko.n}} !"
msgstr "Ich weiß nicht mehr, was ich mit dir machen soll, {{noriko.n}}!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_52971ce2"
msgid "Tu abuses de ma patience depuis bien trop longtemps."
msgstr "Du stellst meine Geduld wirklich auf die Probe."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_6150a6d5"
msgid "Je ne sais pas pourquoi tu ne me prends pas au sérieux, mais ça va changer..."
msgstr "Ich weiß nicht, warum du mich nie ernst zu nehmen scheinst... Aber ich denke, das können wir ändern..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_102ef7ee"
msgid "Va... te... faire foutre !"
msgstr "Fick...dich!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_dae531e8"
msgid "...[w] Tu as peut-être besoin que je joigne les actes à la parole ?"
msgstr "...[w]Wenn Worte nicht ausreichen, muss ich vielleicht Taten folgen lassen..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_666b9ce6"
msgid "Si tu aimes ce genre de chose, peut-être qu'on peut trouver une sorte d'arrangement ?"
msgstr "Wenn du sowas magst, können wir vielleicht eine Vereinbarung treffen?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_f2e8ce36"
msgid "J'aurais peut-être dû t'accorder plus d'attention..."
msgstr "Ich kann dir mehr... Aufmerksamkeit geben."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_850db9ee"
msgid "Arrête... Je..."
msgstr "Warte... Ich..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_df83df6a"
msgid "Je ne te savais pas aussi vicieuse !"
msgstr "Ich hatte ja keine Ahnung, wie versaut du bist!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_a4f00544"
msgid "Ah..."
msgstr "Ah..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_67bc1bbf"
msgid "À partir de maintenant, tu vas arrêter de me prendre pour ton esclave."
msgstr "Ab sofort gehörst du mir."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_6eff81b7"
msgid "C'est à moi que tu obéiras !"
msgstr "Du wirst mir gehorchen, hast du das verstanden?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_f16779f7"
msgid "Je..."
msgstr "Ich ..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_f8001b90"
msgid "Est-ce que je me suis bien fait comprendre cette fois-ci ?"
msgstr "Habe ich mich deutlich ausgedrückt?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_9fc616da"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_3fbad6b5"
msgid "Oui..."
msgstr "Ja ..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_e2cb7a2e"
msgid "Finalement... Je vais finir par croire que c'était ce que tu voulais depuis le début..."
msgstr "Braves Mädchen. Es wirkt fast so, als wolltest du von Anfang an..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_9fc616da_1"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_03f06f03"
msgid "Où est le baladeur {{noriko.n}} !?"
msgstr "Wo ist mein Walkman, {{noriko.n}}?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_cefb0a59"
msgid "C'est maman qui t'a emprunté le baladeur, pas moi..."
msgstr "Mama hat sich deinen Walkman ausgeliehen, nicht ich..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_d19ce8a2"
msgid "Tu vois ? Tu aurais dû commencer par ça dès le début."
msgstr "Siehst du? Du hättest damit anfangen sollen."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_3b23c22d"
msgid "Putain de bordel de merde !"
msgstr "Verdammte Scheiße!"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_901d3cde"
msgid "Je ne sais pas ce qui m'a pris, mais visiblement, je m'en suis sorti vivant..."
msgstr "Ich weiß nicht, was in mich gefahren ist, aber es hat funktioniert..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_0a80aabf"
msgid "Ma relation avec ma chère {{noriko.n}} devrait évoluer d'une bien étrange façon..."
msgstr "Mein Verhältnis zu meiner lieben {{noriko.n}} wird sich definitiv etwas verändern..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_a4dc08cc"
msgid "J'espère que tout ça aura suffi... J'ai vraiment pris de trop gros risques cette fois-ci !"
msgstr "Ich hoffe, ich habe das Richtige getan... Ich bin dieses Mal wirklich ein zu großes Risiko eingegangen!"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_1b354464"
msgid "Toutes ces conneries ont fini par m'exciter..."
msgstr "Und jetzt bin ich notgeil..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_8a9a83e4"
msgid "Bref..."
msgstr "Wie auch immer..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "pc_noriko_3bf75143"
msgid "Allons voir {{yasuka.n}} pour ce foutu baladeur CD !"
msgstr "Ab zu {{yasuka.n}}, um diesen verdammten Walkman endlich zu kriegen!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_b9b10a29"
msgid "HEY ! T'AS RIEN À FAIRE DANS MA CHAMBRE !"
msgstr "WAS HAST DU IN MEINEM ZIMMER ZU SUCHEN?!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_41613f0d"
msgid "Arrête ça, tu sais très bien pourquoi je suis là !"
msgstr "Ach, halt die Klappe. Du weißt, warum ich hier bin."

#. Character:`noriko` | Attributes:`-angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_a4009c4c"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_bd8a548e"
msgid "Je t'ai déjà prévenu plusieurs fois."
msgstr "Ich habe dich heute morgen gewarnt, wenn du mir noch einmal im Weg stehst..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_453dbe3a"
msgid "Et je t'ai déjà dit que si tu recommençais, j'allais m'occuper de toi."
msgstr "Dann würde ich dir das Leben zur Hölle machen."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_8ee5c0d0"
msgid "Tu crois que tu me fais peur ?"
msgstr "Du machst mir keine Angst."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_85be0407"
msgid "Pose à peine un doigt sur moi et tu peux être sûr que j'irais voir maman et lui dirais que tu m'as violé par le passé !"
msgstr "Wag es, mich anzurühren und Mama wird meine Schreie in der ganzen Stadt hören. Was glaubst du, wem sie glauben würde? Dir oder mir?"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_7ffd9815"
msgid "Nous y voilà..."
msgstr "Da wären wir also..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_8c087e43"
msgid "J'ai bien la preuve que ce n'était pas qu'un simple rêve."
msgstr "Da habe ich den Beweis, dass es nicht nur ein Traum war..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_6c7476b4"
msgid "Tout ce que j'ai vécu s'est réellement produit !"
msgstr "Es war real!"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_f0f3b580"
msgid "Je dois sortir mon meilleur jeu d'acteur."
msgstr "In Ordnung, ich muss einfach nur weiterreden und einen kühlen Kopf bewahren..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_547cf7f2"
msgid "Et faire en sorte de révéler toute sa vraie personnalité."
msgstr "Irgendwann wird ihre wahre Persönlichkeit zum Vorschein kommen."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_d6aa7458"
msgid "Mais... T'es complètement folle ?!"
msgstr "Hast du den Verstand verloren?!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_db77f6fb"
msgid "Tu sais très bien que j'ai jamais fait un truc pareil !"
msgstr "Ich würde sowas nie tun!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_0b5ed9e7"
msgid "{{yasuka.n}} ne croira jamais un mensonge pareil !"
msgstr "{{yasuka.n}} würde dir das nicht abkaufen!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_61aada6b"
msgid "Pfff... Peu importe si c'est pas la vérité !"
msgstr "Du hast wirklich keine Ahnung, was?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_94f22c85"
msgid "Maman croira tout ce que je lui dirai !"
msgstr "Mama glaubt mir alles, was ich erzähle!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_22afa39e"
msgid "Surtout si je lui dis qu'on a fait du mal à sa petite chérie..."
msgstr "Und wenn ich behaupte, dass du ihrem Liebling wehgetan hast..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_a4668afa"
msgid "Bien... Je pense que tu comprends ce qu'il va arriver..."
msgstr "Na ja... Ich denke, den Rest kannst du dir denken."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_9d2bd8fd"
msgid "J'en ai peur..."
msgstr "Ja, da hast du Recht."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_29cd7803"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_7f4df03b"
msgid "Pourquoi t'es en train de sourire ?"
msgstr "Warum grinst du so?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_ee4eaef2"
msgid "Tu réalises ce qui va arriver pour toi ?"
msgstr "Hast du auch nur eine Sekunde zugehört, was ich gerade gesagt habe?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_d1124181"
msgid "C'est ton cerveau qui a lâché gros débile ?"
msgstr "Hat dich deine letzte Gehirnzelle endlich aufgegeben?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_48a9f185"
msgid "Tu vas commencer par me donner tout ton argent !"
msgstr "Wie auch immer, du wirst erst einmal damit anfangen, mir dein ganzes Geld zu überlassen."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_8774f8f6"
msgid "Ensuite, tu seras mon chien !"
msgstr "Du wirst mein kleiner Hund sein!"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_68771bf7"
msgid "Tu obéiras à tout ce que je te dem..."
msgstr "Wenn ich sitz sage, wirst du sitzen. Wenn ich sage, du sollst betteln, dann bettelst du. Du wirst mir aufs Wort gehorchen."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_50dd8dd0"
msgid "POURQUOI TU SOURIS COMME UN PUTAIN D'ATTARDÉ ?!!"
msgstr "WARUM GRINST DU SO WIE EIN VERDAMMTER IDIOT?!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_6a052d56"
msgid "Oh, pour rien..."
msgstr "Ach, nichts..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_5e15bd98"
msgid "Juste que... Je me demande ce que pensera {{yasuka.n}} de cet enregistrement..."
msgstr "Ich frage mich nur... Was {{yasuka.n}} von dieser Aufnahme halten wird..."

#. Character:`notice`
#: game/story/home_player_noriko_room.dialogue
msgctxt "t3e261da450"
msgid "Vous arrêtez l'enregistrement sous les yeux de {{noriko.n}}."
msgstr "Du beendest die Aufnahme vor {{noriko.n}}s Augen."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_080e5f7e"
msgid "...Mais... Mais... Tu as..."
msgstr "Warte, was...?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_391aad38"
msgid "Tout enregistré oui, je t'avais prévenue {{noriko.n}} que je montrerais quelle salope tu peux être..."
msgstr "Jup, ich habe alles aufgenommen. Ich habe dich gewarnt, was passieren würde, wenn du mir weiter im Weg stehen würdest, {{noriko.n}}."

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_e8a4876f"
msgid "Non... Non non non non... NOOONNNNN !!!"
msgstr "Nein... nein nein nein nein nein, bitte!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_d15fe766"
msgid "[font_size=19]Nooonn...[/font_size]"
msgstr "[font_size=19]Nein...[/font_size]"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_cfc5152c"
msgid "[font_size=14]Nonn...[/font_size]"
msgstr "[font_size=14]Nein...[/font_size]"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "home_player_noriko_room_4a14d581"
msgid "Bien, pour commencer..."
msgstr "Nun, zunächst einmal..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "td139b6d726"
msgid "[next]"
msgstr "[next]"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_4371f6a9"
msgid "Voilà..."
msgstr "Also ..."

#. Character:`notice`
#: game/story/home_player_noriko_room.dialogue
msgctxt "t8fc53e68f6"
msgid "Vous obtenez le baladeur MP3."
msgstr "Du bekommst den Walkman."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_b81fcf6d"
msgid "Et, bien voilà... Ce n'était pas si compliqué {{noriko.n}}."
msgstr "Na, das war doch gar nicht so schwer, oder, {{noriko.n}}?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_4c58bfe8"
msgid "Qu'est-ce que tu vas faire avec... l'enregistrement ?"
msgstr "Was willst du mit dieser... Aufnahme jetzt machen?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_03775ec8"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_26ea0a25"
msgid "Tant que tu te tiens tranquille avec moi, je ne ferais rien."
msgstr "Solange du in meiner Gegenwart einfach die Klappe hältst, werde ich erstmal nichts damit tun."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_0f230e58"
msgid "Recommence ton cinéma et soit sûre que je l'utiliserais."
msgstr "Aber wenn du beschließt, deine reizende Persönlichkeit mir gegenüber weiterhin so deutlich zum Ausruck zu bringen, dann kann ich dir versichern, dass ich guten Nutzen für diese Aufnahme finden werde."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_7074cdd1"
msgid "C'est compris ?"
msgstr "Verstanden?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ea3796f0"
msgid "[font_size=19]Oui...[/font_size]"
msgstr "[font_size=19]Ja...[/font_size]"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "t6dfeb25814"
msgid "[hint=ROUTE REJET]Donne-moi le baladeur MP3."
msgstr "[hint=ZURÜCKWEISUNGS-ROUTE]Wirst du mir den Walkman geben."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_6a640c96"
msgid "Co... Comment ça ?"
msgstr "Was... Was meinst du damit?"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_4d72610e"
msgid "Les rôles se sont inversés {{noriko.n}}. Tu ne pensais quand même pas que tu allais t'en tirer aussi facilement ?"
msgstr "Das Blatt hat sich gewendet, {{noriko.n}}. Du glaubst doch nicht ernsthaft, dass ich dich so einfach davonkommen lasse, oder?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_46159041"
msgid "Pas après toutes ces années à m'avoir pourri la vie."
msgstr "Nach all diesen Jahren, in denen du alles gegeben hast, um mir das Leben schwer zu machen?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_dddbcc71"
msgid "Pas après toutes les insultes[w], les humiliations[w], les crasses que tu m'as faites."
msgstr "All die Beleidigungen,[w] die Demütigungen,[w] die Erpressungen, denen ich dank dir ausgesetzt war?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_59ad3fd8"
msgid "J'ai juste à donner ceci à {{yasuka.n}} pour faire de ta vie un enfer."
msgstr "Ich brauche das hier nur {{yasuka.n}} zu zeigen und dein Leben wird die reinste Hölle."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_9778a29a"
msgid "...[w] Je vois..."
msgstr "...[w]Ich verstehe..."

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_96092db1"
msgid "Alors, je pense que j'ai quelque chose pour toi..."
msgstr "Ich glaube, ich habe da etwas für dich..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_07f849c3"
msgid "Je suis certain qu'un puceau comme toi n'en a jamais vu en vrai."
msgstr "Eine Jungfrau wie du hat so etwas wahrscheinlich noch nie im echten Leben zu Gesicht bekommen."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_2ba3329d"
msgid "Alors, satisfait ?"
msgstr "Gefällt’s dir?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_21a93eab"
msgid "Profites-en, car tu n'en verras jamais d'autres."
msgstr "Genieß es, denn das ist das letzte Mal, dass du sowas sehen wirst."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_86fc5973"
msgid "Je suis sûr que tu meurs d'envie de les toucher."
msgstr "Du würdest sie sicherlich gerne anfassen..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_686a2fd7"
msgid "Aaah, ma chère {{noriko.n}}... Je ne m'attendais pas à ça, mais..."
msgstr "Ach, meine liebe {{noriko.n}}... Ich weiß dieses Angebot sehr zu schätzen, aber..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_7ab112f5"
msgid "Je pense que ça ne suffira pas..."
msgstr "Ich befürchte, das wird nicht ausreichen."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_8c66181f"
msgid "Tu m'emmerdes depuis tant d'années, tu crois qu'en voyant ta poitrine une fois ça va effacer ton ardoise ?"
msgstr "Du glaust doch nicht wirklich, mir einmal deine Titten zu zeigen, gleicht all die Jahre der Misshandlung aus, oder?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_e305091d"
msgid "C'est clairement pas suffisant."
msgstr "Ich bin... enttäuscht von dir."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_7da22726"
msgid "...Je vais te t-"
msgstr "...Fick-"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_305ba402"
msgid "Attention {{noriko.n}} ! Ne fais pas quelque chose que tu pourrais regretter."
msgstr "Sei vorsichtig, {{noriko.n}}! Sag lieber nichts, was du später bereuen könntest."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_c13b3356"
msgid "Rhabille-toi, et donne ce que je suis venu chercher. Tiens-toi prête pour ma prochaine visite."
msgstr "Zieh dich an und gib mir den Walkman. Und bereite dich auf meinen nächsten Besuch vor."

#. Character:`notice`
#: game/story/home_player_noriko_room.dialogue
msgctxt "t6a2e1e2138"
msgid "Vous obtenez le baladeur MP3."
msgstr "Du bekommst den Walkman."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ff54907f"
msgid "...Quand ?"
msgstr "...Wann?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_74450f95"
msgid "Quand j'en aurai décidé !"
msgstr "Mal sehen, wenn mir danach ist."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_5ea74534"
msgid "MAIS...!"
msgstr "Aber..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_b867a4ca"
msgid "Ce n'est plus toi qui décides à présent."
msgstr "Bis dann."

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_7fef2aea"
msgid "...fait chier !"
msgstr "...Fuck!"

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "tf77c3e2d7c"
msgid "[hint=ROUTE CHANTAGE]Jusqu'à quel point tu ne veux pas que ça se sache {{noriko.n}} ?"
msgstr "[hint=ERPRESSUNGS-ROUTE]Wie viel liegt dir daran, dieses Geheimnis zu bewahren, {{noriko.n}}?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_00b62d92"
msgid "{{noriko.n}} !"
msgstr "{{noriko.n}}!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_ab94ab29"
msgid "J'ai besoin de toi immédiatement !"
msgstr "Ich brauche dich, jetzt sofort!"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_5ac10f1f"
msgid "PUTAIN !"
msgstr "FUCK!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_162c6915"
msgid "Tu peux pas frapper avant d'entrer comme tout le monde ?"
msgstr "Kannst du nicht wie jeder andere auch anklopfen, bevor du hier hereinplatzt?"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_ebf61c11"
msgid "On s'en tape !"
msgstr "Ist mir egal!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_c5099605"
msgid "De quelle couleur sont mes yeux ?"
msgstr "Welche Augenfarbe habe ich?"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_ad9c1117"
msgid "Quoi ?"
msgstr "Was?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_9b1c4351"
msgid "{{noriko.n}} juste... répond moi, de quelle couleur sont mes yeux ?"
msgstr "{{noriko.n}}... antworte mir einfach. Welche Farben haben meine Augen?"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_898b1990_2"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_403a83ce"
msgid "Marron, tu as les yeux marron."
msgstr "Braun. Du hast braune Augen."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_a8ddeb9f"
msgid "Tu avais juste à regarder dans la salle de bain..."
msgstr "Du hättest einfach im Badezimmer in den Spiegel schauen können..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_070865d3"
msgid "Merci !"
msgstr "Danke!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_6764641e"
msgid "Pourqu-"
msgstr "Warum-"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_d385f1f5"
msgid "Noisette... Tu as les yeux couleur noisette."
msgstr "Haselnussbraun ... Deine Augen sind haselnussbraun."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_9f34edda"
msgid "Merci {{noriko.n}} !"
msgstr "Danke, {{noriko.n}}!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_200e1f01"
msgid "Attends-je..."
msgstr "Warte, ich..."

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_64ae250a"
msgid "Quoi ?"
msgstr "Was?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_f6039c86"
msgid "...Non, laisse tomber."
msgstr "...Nein, nicht so wichtig."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_1446a0d4"
msgid "S'il te plait..."
msgstr "Bitte..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_045e61d8"
msgid "De la merde !"
msgstr "Scheiße!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_84f6a032"
msgid "Attends, quoi ?"
msgstr "Warte, was?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_8ce77e83"
msgid "Tes yeux ont la même couleur que de la merde !"
msgstr "Deine Augen haben die Farbe von Scheiße!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_86926d74"
msgid "Hmm, oh, tu veux dire marron ?"
msgstr "Hmm? Ach, du meinst braun?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_9f34edda_1"
msgid "Merci {{noriko.n}} !"
msgstr "Danke, {{noriko.n}}!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_50516910"
msgid "...[w] Taré."
msgstr "...[w]Freak."

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_76daba04"
msgid "Que... Qu'est-ce que tu veux ?"
msgstr "Was... Was willst du?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_374ea508"
msgid "Tu vas encore me brutaliser c'est ça ?"
msgstr "Du willst mich wieder ärgern, oder?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_e4a64377"
msgid "Quoi ? Bien sûr que non."
msgstr "Was? Natürlich nicht."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_eadd7ccf"
msgid "Il s'agit d'autre chose..."
msgstr "Es geht um was Anderes..."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_2cccb1ce"
msgid "HEY !"
msgstr "HEY!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_90bc6a7a"
msgid "Qui t'a permis de rentrer dans ma chambre sans prévenir ?"
msgstr "Warum platzt du hier einfach ohne Vorwarnung rein?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_08c316a9"
msgid "Dégage !"
msgstr "Verschwinde!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_113b6635"
msgid "Désolé, mais c'est important."
msgstr "Entschuldigung, aber es ist wichtig."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_181efd45"
msgid "Qu'est-ce que tu veux ?"
msgstr "Was willst du?"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_c78c394d"
msgid "Qu'est-ce que tu me veux ?"
msgstr "Was willst du?"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_f5c961f2"
msgid "Tu veux encore que je te s-"
msgstr "Willst du immer noch, dass ich-"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_19fbe169"
msgid "Non, je ne suis pas venu pour ça !"
msgstr "Nein, deswegen bin ich nicht hier!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_c67f735e"
msgid "{{noriko.n}}, tu aurais un instant, j'ai besoins de toi."
msgstr "{{noriko.n}}, hast du einen Moment? Ich brauche deine Hilfe."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_b2f32b08"
msgid "Pfff, je croyais que tu n'en avais plus rien à faire de moi justement."
msgstr "Tsss, und ich dachte, du wolltest nichts mehr zu tun haben."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_ffa08594"
msgid "...Écoute au moins ce que j'ai à dire."
msgstr "...Hör mir zumindest kurz zu."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_750f38c2"
msgid "À vrai dire, j'ai besoins d'un conseil vestimentaire."
msgstr "Um ehrlich zu sein, brauche ich deine Modeberatung."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_c30c9b33"
msgid "Un conseil vestimentaire ?"
msgstr "Modeberatung?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_f56a80d0"
msgid "J'ai besoins d'un costume plutôt chic pour un club privé !"
msgstr "Ich brauche einen schicken Anzug für einen exklusiven Klub!"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_22497002"
msgid "...Laisse-moi deviner, tu veux voir où travaille maman ?"
msgstr "...Lass mich raten, du willst nachsehen, wo Mama arbeitet?"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_c4c6f267"
msgid "Oui, j'aimerais m'assurer que tout se passe bien pour elle."
msgstr "Ja. Ich will sichergehen, dass für sie alles gut läuft."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_bab56ba2"
msgid "Qu'est-ce que j'y gagne dans tout ça ?"
msgstr "Und was ist für mich drin?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_c78344cb"
msgid "...La satisfaction d'avoir aidé {{yasuka.n}} ?"
msgstr "...Die Genugtuung, {{yasuka.n}} geholfen zu haben?"

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_033a7dca"
msgid "Débrouille-toi tout seul alors."
msgstr "Dann kümmer mich selbst darum."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_970887f9"
msgid "Maman n'a pas besoins de toi, elle se débrouille très bien toute seule."
msgstr "Mama braucht dich nicht. Sie kommt auch gut ohne dich klar."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_62ce77a5"
msgid "La preuve, on a enfin de l'argent de poche."
msgstr "Wir haben jetzt sogar Taschengeld."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_2cc1d08a"
msgid "Je ne peux pas lui donner tort."
msgstr "Da hat sie nicht ganz Unrecht."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_bc29aa1c"
msgid "Mais je peux pas lui dire qu'il y a deux connards qui cherchent à me faire du mal en passant par {{yasuka.n}}."
msgstr "Ich kann ihr aber nicht erzählen, dass zwei Arschlöcher versuchen, mir durch {{yasuka.n}} das Leben schwer zu machen."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_85dca400"
msgid "Qu'est-ce que je pourrais lui promettre ?"
msgstr "Was könnte ich ihr anbieten?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_1363899f"
msgid "Bon... voici ma proposition, la prochaine fois qu'elle nous donne de l'argent de poche, tout est pour toi."
msgstr "Also gut... hier ist mein Angebot. Das nächste Mal, wenn sie uns Taschengeld gibt, geb ich dir meinen Anteil."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_206b361c"
msgid "Alors ?"
msgstr "Also?"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_5bc1f7ae"
msgid "...Okay."
msgstr "...Okay."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_9cc7eb13"
msgid "Alors, tu connais une boutique ?"
msgstr "Also, kennst du einen Laden?"

#. Character:`noriko` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_6d4da199"
msgid "Oui, à côté du Konbini !"
msgstr "Ja, direkt neben dem Kombini!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_fceaf5df"
msgid "Du konbini ? Mais... il n'y a rien à part..."
msgstr "Der Kombini? Aber... da ist nichts, außer..."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_e819b89d"
msgid "Des poubelles exactement !"
msgstr "Müll! Exakt!"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_a6fb9f62"
msgid "Tu crois que tu peux m'acheter avec un peu d'argent de poche ?"
msgstr "Dachtest du wirklich, du könntest mich mit ein wenig Taschengeld überzeugen?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_7cd51e75"
msgid "DÉGAGE DE MA CHAMBRE !"
msgstr "RAUS AUS MEINEM ZIMMER!"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_236d552c"
msgid "Tu crois que j'ai oublié ce que tu m'as fait ?"
msgstr "Glaubst du, ich hätte vergessen, was du mir angetan hast?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_88c1d780"
msgid "Dégage de ma chambre et débrouille-toi !"
msgstr "Jetzt verschwinde aus meinem Zimmer und kümmer dich selbst um deinen Scheiß!"

#. Character:`asami`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_d2c15ef3"
msgid "Du coup, t'as jamais eu envie de..."
msgstr "Also wolltest du nie..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_2a59c441"
msgid "En fait..."
msgstr "Eigentlich..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_6e42cc7d"
msgid "Bon bon bon, je crois qu'on va s'arrêter ici."
msgstr "Nun gut. Ich denke, wir können an dieser Stelle aufhören."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_02e28f57"
msgid "J'ai pas envie que tous mes secrets soient dévoilés."
msgstr "Ich will nicht, dass all meine Geheimnisse rauskommen."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_b5ad9c74"
msgid "Oh, c'est dommage, j'apprenais plein de choses intéressantes."
msgstr "Oh, das ist zu schade. Ich habe gerade eine Menge spannender Sachen erfahren."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_c8493ef1"
msgid "{{noriko.n}}, merci d'avoir discuté un peu avec moi, la prochaine fois ça te dit de sortir en ville ensemble ?"
msgstr "Danke für die Unterhaltung, {{noriko.n}}. Wollen wir nächstes Mal vielleicht gemeinsam irgendwo hingehen?"

#. Character:`noriko` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_790ebbaa"
msgid "C'est vrai ?! Euh... Mmhh... Bien sûr, avec plaisir."
msgstr "Wirklich?! Ähm... Hmm... Natürlich. Sehr gerne."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_5562ec2c"
msgid "J'ai encore quelques dossiers sur {{saito.n}}."
msgstr "Ich habe immer noch ein paar interessante Sachen zu {{saito.n}} auszuplaudern."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "J_AI_SON_HISTORIQUE_WEB_RECENT_DBF1C1"
msgid "J'ai son historique web récent... Tu vas pas être déçue !"
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_0bef7a8f"
msgid "Excellent, c'est exactement le genre de chose que j'attendais !"
msgstr "Perfekt! Das war genau die Art Info, die ich erwartet hatte!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ed6623a0"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_9d53f045"
msgid "T'es dans la merde mon pauvre !"
msgstr "Du bist am Arsch. Armes Ding!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "JE_NE_PEUX_PAS_SIMPLEMENT_VENI_66539C"
msgid "Je ne peux pas simplement venir te voir et discuter avec toi ?"
msgstr ""

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "J_AI_RIEN_TE_DIRE_3DF1D5"
msgid "J'ai rien à te dire."
msgstr ""

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "MAIS_MOI_PAR_CONTRE_J_AI_DES_C_EA918E"
msgid "Mais moi par contre j'ai des choses à dire."
msgstr ""

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "JE_NE_SUIS_PAS_SURPRIS_QUE_TU_D178E8"
msgid "Je ne suis pas surpris que tu t'entendes aussi bien avec {{asami.n}} et que vous soyez devenues amies."
msgstr ""

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "C_EST_UNE_FILLE_VRAIMENT_CHOUE_5BE000"
msgid "C'est une fille vraiment chouette !"
msgstr ""

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "C_EST_CLAIR_TU_NE_LA_M_RITES_P_394A84"
msgid "C'est clair ! Tu ne la mérites pas."
msgstr ""

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "CE_CE_N_EST_DE_TOUTE_FA_ON_PAS_F39025"
msgid "Ce... Ce n'est de toute façon pas à toi d'en décid-"
msgstr ""

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "PEU_IMPORTE_D9B1F0"
msgid "Peu importe..."
msgstr ""

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "JE_VEUX_ENTRERRER_LA_HACHE_DE_B19F0D"
msgid "Je veux entrerrer la hache de guerre avec toi."
msgstr ""

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_25e3c5d8"
msgid "On passe la plupart de notre temps à se crier dessus, à s'éviter, à se faire des crasses."
msgstr "Wir haben die meiste Zeit unseres Lebens nur damit verbracht, uns gegenseitig anzuschreien, uns aus dem Weg zu gehen und uns das Leben schwer zu machen."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_fac73f92"
msgid "Peut-on faire la paix une bonne fois pour toutes ?"
msgstr "Können wir endlich Frieden schließen?"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_854ba06d"
msgid "Non !"
msgstr "Nein!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_8f3ab287"
msgid "M-"
msgstr "A-"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_0210f28c"
msgid "Je refuse !"
msgstr "Niemals!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_be653c95"
msgid "Les choses ont été bien trop loin pour passer à autre chose."
msgstr "Es ist schon viel zu spät, um einfach von vorne anzufangen."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_95699640"
msgid "Écoute je suis prêt à faire des effort et pardonner certaines choses et..."
msgstr "Hör mir zu, ich bin bereit, mir Mühe zu geben und dir bestimmte Sachen zu verzeihen und..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_4ddfdea3"
msgid "ARRÊTE ! C'est pas à toi de décider ça, c'est pas à toi de me pardonner !"
msgstr "HÖR AUF! Es liegt nicht an dir, das zu entscheiden! Es ist nicht deine Aufgabe, mir zu vergeben!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_63807d1b"
msgid "Mais... Je comprends pas..."
msgstr "Aber... Ich verstehe nicht..."

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_d2a5baa5"
msgid "Tu passes ton temps à faire la victime...[w] Tout ça pour...[w] rien."
msgstr "Du hast die ganze Zeit das Opfer gespielt...[w] Alles für..[w] nichts."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_5f66ed1e"
msgid "{{noriko.n}}, je veux vraiment devenir une meilleure personne et si tu ne me dis pas pourquoi tu me hais autant je..."
msgstr "{{noriko.n}}, ich möchte wirklich ein besserer Mensch werden, aber wenn du mir nicht sagst, warum du mich so sehr hasst..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_3611390a"
msgid "VOILÀ ! Il s'agit encore de toi et de personne d'autre, il faut tout te donner, tout te dire, tout faire pour toi !"
msgstr "DAS WAR’S! Es geht immer nur um dich und sonst niemanden! Alles muss dir in den Arsch geschoben werden, alles muss man dir erklären!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_74e47000"
msgid "Y'A RIEN QUI CHANGE JAMAIS AVEC TOI !"
msgstr "DU WIRST DICH NIE VERÄNDERN!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_bbdc0057"
msgid "Tu ne te souviens même plus..."
msgstr "Du erinnerst dich nicht einmal daran, als..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_d0a9f7cc"
msgid "Me souvenir ?"
msgstr "Erinnern?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_a7c19159"
msgid "VA-T-EN !"
msgstr "VERPISS DICH!"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_115ee30e"
msgid "Hey !!!"
msgstr "Hey!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_8108a2e8"
msgid "On doit parler !"
msgstr "Wir müssen reden!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_fc34e3c8"
msgid "Oui mais moi j'ai rien à te dire !"
msgstr "Ja, aber ich habe dir nichts zu sagen!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_f02845f2"
msgid "Tu faisais quoi aujourd'hui ?"
msgstr "Was hast du heute gemacht?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_c9abca40"
msgid "Que... En quoi ça te regarde ?"
msgstr "Was... Was geht dich das an?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_1b2d6437"
msgid "Ça me regarde dans le sens où tu prétends avoir passé la journée avec {{asami.n}} alors que ce n'est pas le cas."
msgstr "Es geht mich was an, weil du behauptest, den ganzen Tag mit {{asami.n}} verbracht zu haben, auch wenn das nicht stimmt."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_6bbac01e"
msgid "... Et alors ? Je n'avais pas envie de rendre des comptes à ma mère."
msgstr "...Ja und? Ich wollte es Mama eben nicht erzählen."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "JE_NE_COMPRENDS_ET_NE_SUPPORTE_EE13A7"
msgid "Je ne comprends et ne supporte plus cette animosité que tu as envers moi."
msgstr ""

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_0395eddb"
msgid "Je ne sais pas ce que j'ai pu te faire pour qu'on en arrive là, mais j'aimerais comprendre."
msgstr "Ich weiß nicht, was ich dir angetan haben könnte, dass du so geworden bist, aber ich würde es gerne verstehen."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_f3655e6b"
msgid "Si tu te préoccupais un peu plus de toi et moins de moi on n'en serait pas là !"
msgstr "Wenn du etwas mehr auf dich selbst achten würdest, anstatt dauernd auf mich, wären wir beide nicht in dieser Situation"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_d7b86515"
msgid "Attention à toi {{noriko.n}}. Je veux bien être gentil, mais je ne suis plus le garçon docile sur lequel tu pouvais marcher."
msgstr "Sei vorsichtig, {{noriko.n}}. Ich bin bereit, nett zu sein, aber ich bin nicht mehr der kleine, zierliche Junge, den du nach Belieben herumkommandieren kannst."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_499d7d45"
msgid "Tout ce que j'essaie de faire c'est de comprendre pourquoi on en arrive là aujourd'hui."
msgstr "Alles, was ich versuche, zu verstehen, ist, warum wir an diesen Punkt gelangt sind."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_9b26c03c"
msgid "Je sais que tu me caches des choses, et crois-moi je finirai par les découvrir."
msgstr "Ich weiß, dass du mir Dinge verheimlichst und glaub mir, ich werde herausfinden, worum es da geht."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_f2c92a0a"
msgid "... Va... va-t-en ! Laisse-moi tranquille. Ne t'occupe pas de mes affaires."
msgstr "...Geh... Geh weg! Lass mich allein. Misch dich nicht in meine Angelegenheiten ein."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_01bf2617"
msgid "On n'en restera pas là."
msgstr "Das ist noch nicht vorbei!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_cfaa5842"
msgid "Bonne soirée."
msgstr "Gute Nacht."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_f772442c"
msgid "Bon ça suffit les conneries, maintenant tu vas t'expliquer !"
msgstr "Okay, genug Bullshit! Jetzt wirst du dich erklären!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_feea393d"
msgid "Pourquoi tu es complètement à poil d'ailleurs ?"
msgstr "Und warum bist du eigentlich nackt?"

#. Character:`saito` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_f29a8032"
msgid "T'es en train de me rendre complètement fou."
msgstr "Du treibst mich in den Wahnsinn."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_1fcf040e"
msgid "Je sais pas à quel jeu tu joues mais..."
msgstr "Ich weiß nicht, welches Spiel du spielst, aber..."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_21ed9f39"
msgid "Tu vas me punir ?"
msgstr "Wirst du mich jetzt bestrafen?"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_40121d8e"
msgid "Oui je vais te... Attends quoi ?"
msgstr "Ja, ich werde... Warte, was?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_a6b8a84e"
msgid "Prouve-le !"
msgstr "Beweis es!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_01de4c42"
msgid "Bordel de...[w] Mais... mais de quoi tu parles ?"
msgstr "Verdammt...[w] Aber... aber wovon redest du?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_d83c5729"
msgid "Tu crois que tout ceci n'est qu'une vaste plaisanterie pour toi ?"
msgstr "Ist das für dich alles nur ein einziger Witz?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_b4651e0d"
msgid "Donc... tu ne me puniras pas ? Tu te dégonfles ?"
msgstr "Also... wirst du mich nicht bestrafen? Hast du Schiss?"

#. Character:`saito` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_befd0cab"
msgid "Quoi ?! Mais... putain {{noriko.n}} !"
msgstr "Was?! Aber... verdammt nochmal, {{noriko.n}}!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_44fc70a1"
msgid "Tu crois que je ne te sauterai pas dessus ?"
msgstr "Glaubst du, ich würde es nicht durchziehen?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_910623fe"
msgid "Visiblement non... il semblerait que tu sois seulement une grande bouche..."
msgstr "Anscheinend ja nicht... Scheint wohl so, als hättest du einfach nur ’ne große Klappe und nichts dahinter."

#. Character:`saito` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_11b4c513"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_daef296a"
msgid "J'attends toujours..."
msgstr "Ich warte immer noch..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_ae4363f2"
msgid "Je vais le faire."
msgstr "Ich tu’s wirklich."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_b1602e4c"
msgid "Alors vas-y !"
msgstr "Dann tu es doch!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_68172d73"
msgid "Je ne plaisante pas !"
msgstr "Ich mein’s ernst!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_356a5fed"
msgid "J'attends encore..."
msgstr "Ich warte immer noch..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_d20fe92e"
msgid "... Très bien si c'est ce que tu souhaites."
msgstr "...Okay, wenn es das ist, was du willst."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_0d32894d"
msgid "Alors tu penses toujours que je ne vais pas le faire ?"
msgstr "Glaubst du immer noch, ich würde es nicht durchziehen?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_027ebe58"
msgid "Non, aucune chance, t'auras pas le cran !"
msgstr "Niemals, du hast nicht die Eier dazu!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_49458075"
msgid "... Non tu as raison, je ne vais pas la mettre."
msgstr "...Du hast Recht, ich werde dich nicht ficken."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_649da96d"
msgid "Quoi ?!"
msgstr "Was?!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_25230ebd"
msgid "NON ! Mets-la ! Mets-la moi !"
msgstr "NEIN! Steck ihn rein! Steck ihn in mich rein!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_324d2d97"
msgid "... et le mot magique ?"
msgstr "...Wie lautet das Zauberwort?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_1003269d"
msgid "Mets-la moi s'il te plaît..."
msgstr "Steck ihn rein... bitte..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_8c56b39f"
msgid "... eh bien voilà !"
msgstr "Na endlich!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_2fe49844"
msgid "Mhhh... mhhh"
msgstr "Mhhh... mhhh..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_969d36df"
msgid "Tu sais, tu n'es pas obligée de retenir ta voix."
msgstr "Du weiß, dass du dir nicht jeden Laut zu verkneifen brauchst?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_9d53056b"
msgid "Si tu apprécies, lâche-toi !"
msgstr "Wenn es dir gefällt, lass einfach los!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_f65a964f"
msgid "Y'a aucun moyen qu... que... ça me... fasse du... bien !"
msgstr "Sowas würde mir... n... niemals... ge...fallen!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_1cbfbee9"
msgid "Très bien, augmentons la cadence alors !"
msgstr "In Ordnung, dann lass uns mal einen Zahn zulegen!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_0b0667c1"
msgid "Mmhhhh... mhhh... aaah..."
msgstr "Mmhhhh... mhhh... aaah..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_1a0711b1"
msgid "Toujours aussi fière ?"
msgstr "Immer noch so stolz?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_38862f98"
msgid "Non... Je... C'est..."
msgstr "Nein... Ich... Das ist..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_f7320604"
msgid "Tu as raison, je peux y mettre plus de force."
msgstr "Du hast Recht, ich kann härter machen."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_35b49e60"
msgid "Quoi ?! Non... Je suis déjà..."
msgstr "Was?! Nein... Ich bin schon..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_282cef29"
msgid "Aaaah aaaah aaaah... Oui !"
msgstr "Aaaah aaaah aaaah... Ja!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_67c85a93"
msgid "Beaucoup mieux ![w] Je te préfère quand tu es honnête avec toi-même..."
msgstr "Das ist besser![w] Ich ziehe es vor, wenn du ehrlich mit dir bist..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_5468a594"
msgid "Oui pardon, ne t'arrête pas !"
msgstr "Tut mir leid, bitte hör nicht auf!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_04cebda8"
msgid "Mmhh Ouiiii !"
msgstr "Mhhh, jaaa!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_e15dd9fd"
msgid "Hannn hannn..."
msgstr "Hahhh... hahh..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_a0055cf4"
msgid "Retire-toi !"
msgstr "Geh von mir weg!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_5431b506"
msgid "Al-"
msgstr "Also-"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_988c494f"
msgid "Dégage de ma chambre maintenant !!!"
msgstr "Verschwinde jetzt aus meinem Zimmer!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_56609df8"
msgid "Bordel mais pourquoi t'es encore à poil ?"
msgstr "Mein Gott, warum bist du immer noch nackt?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_847cdc2c"
msgid "Je t'attendais !"
msgstr "Ich habe auf dich gewartet!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_ea095bd7"
msgid "Quoi ?! Mais bordel, je ne veux pas jouer à ton petit jeu j'aimerais juste..."
msgstr "Was? Verdammt, ich will dein lästiges Spiel nicht spielen! Ich will nur..."

#. Character:`noriko` | Attributes:`disgusted`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_476f4808"
msgid "Je le savais tu t'es dégonflé..."
msgstr "Ich wusste es, du machst einen Rückzieher..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_6a1ae8b4"
msgid "Non ! Non non non et non ! Tu ne m'auras pas une seconde fois comme ça !"
msgstr "Nein! Nein, nein, nein und nochmals nein! Das klappt nicht nochmal!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_a5469489"
msgid "C'est dommage... j'avais bien aimé moi..."
msgstr "Zu schade... Ich hab’s genossen..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_8784c6cc"
msgid "...[w] Bordel."
msgstr "...[w]Verdammt."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_8e500ab0"
msgid "Donc tu te dégonfles... c'est bien ce que je disais."
msgstr "Du machst ’nen Rückzieher... Hab ich’s doch gewusst."

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_2209c0e1"
msgid "Tu avais un côté sauvage... J'avais l'impression d'avoir un alpha."
msgstr "Du hattest eine wilde Seite... Als hätte ich hier tatsächlich einen richtigen Mann."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_e11d8581"
msgid "Mais là... J'ai plus l'impression d'avoir un b-"
msgstr "Aber jetzt... Jetzt fühlt es sich so an, als hätte ich ein W-"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_8fbd428b"
msgid "Okay stop ! C'est du sauvage que tu veux ?"
msgstr "Okay, lass das! Du willst es wild?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_41f629b5"
msgid "Pas de problème ! Mais après on va discuter toi et moi !"
msgstr "Kein Problem! Aber danach werden wir ein paar Sachen bereden müssen!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_2492d629"
msgid "Alors tu comptes la rentrer, ou il faut demander de l'aide ?"
msgstr "Steckst du ihn jetzt endlich rein oder muss ich dir Hilfe holen?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_7caf2eae"
msgid "Il me semble que c'est ce que tu veux... Demande-le moi poliment !"
msgstr "Das hättest du wohl gerne... Wenn du freundlich fragst, mache ich es vielleicht!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_22a349d1"
msgid "... Je... Je veux pas demander quelque chose d'aussi gênant."
msgstr "...Ich... Ich will dich nicht sowas Peinliches fragen."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_34033223"
msgid "Dans ce cas, on peut rester longtemps comme ça !"
msgstr "In dem Fall können wir hier gerne noch ein Weilchen so bleiben!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_d742e1c3"
msgid "Mais...[w] D'accord...[w] Mets... Mets-la en moi[w] s'il te plaît."
msgstr "Aber...[w] Okay...[w] Steck... steck ihn in mich rein...[w] bitte."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_0c2c5f65"
msgid "Mmhhh ouiii !"
msgstr "Mmhhh, jaaa!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_171cb176"
msgid "... J'ai jamais vu une fille aussi dérangée que toi !"
msgstr "...Ich habe noch nie ein so gestörtes Mädchen wie dich gesehen!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_d8e7dd6c"
msgid "Je comprends vraiment pas t-"
msgstr "Ich verstehe nicht, warum-"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_e8414074"
msgid "Shhhhht ! Arrête de réfléchir et pousse plus fort !"
msgstr "Pschhht! Denk nicht so viel und leg dich mehr ins Zeug!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_5d23f633"
msgid "Oh bordel !"
msgstr "Oh, fuck!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_a5b84aaa"
msgid "Oui c'est... doucement... doucement je..."
msgstr "Ja, das ist... sei... sei vorsichtig, ich..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_eae959f1"
msgid "Désolé je n'entends pas un mot."
msgstr "Tut mir leid, ich habe kein Wort verstanden."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_14556aeb"
msgid "Aaaah... aaah... ahhh..."
msgstr "Aaaah... aaah... ahhh..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_e5584940"
msgid "Maintenant que tu as eu ce que tu voulais..."
msgstr "Jetzt, wo du bekommen hast, was du wolltest..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_901837ca"
msgid "Je veux des explications."
msgstr "Will ich eine Erklärung."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_3e32a7a6"
msgid "Je sais que tu as payé les thugs pour qu'ils viennent me tabasser."
msgstr "Ich weiß, dass du die Schläger bezahlt hast, um mich zu verprügeln."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_ed15802e"
msgid "Je sais également que tu fais ça depuis longtemps."
msgstr "Ich weiß auch, dass du das schon ein ganzes Weilchen tust."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_f3f8be00"
msgid "Je ne m'énerverai pas... J'aimerais juste comprendre."
msgstr "Ich werde nicht wütend werden... Ich möchte nur verstehen."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_c12e5234"
msgid "Pourquoi {{noriko.n}} ?"
msgstr "Warum, {{noriko.n}}?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_9d36ecf3"
msgid "...[w] Tu ne comprendrais pas."
msgstr "...[w]Du würdest es nicht verstehen."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_4006214c"
msgid "Commence déjà par me l'expliquer."
msgstr "Fang einfach damit an, es mir zu erklären."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_ee42977b"
msgid "Si tu n'essaies pas... comment veux tu qu-"
msgstr "Wenn du es nicht einmal versuchst... Wie willst du dann wissen, ob ich-"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_16f5c3aa"
msgid "Tu ne pourras jamais me pardonner de toute façon donc à quoi bon..."
msgstr "Du könntest mir ohnehin nie vergeben, warum sollte ich dann..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_ec497736"
msgid "Ce que je fais depuis des années...[w] est bien trop grave."
msgstr "Was ich jahrelang getan habe...[w] ist viel zu ernst."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_c5fc98f5"
msgid "Je me suis mise là-dedans toute seule."
msgstr "Ich habe mich selbst da reingeritten."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_e1ef8947"
msgid "Je m'en sortirai toute seule."
msgstr "Ich werde auch von selbst wieder herausfinden."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_03775ec8_1"
msgid "..."
msgstr "..."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_cb534121"
msgid "Il n'est pas possible d'effacer autant de haine en un claquement de doigts."
msgstr "Man kann nicht einfach so viel Hass auf einen Schlag verschwinden lassen."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_e59d4a37"
msgid "Et même si toi, tu me pardonnes..."
msgstr "Und selbst wenn du mir... vergeben würdest..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_3727be54"
msgid "Je ne pourrai jamais me pardonner pour tout ce que je t'ai fait subir."
msgstr "Könnte ich mir nie selbst vergeben für alles, was ich dir angetan habe."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_8f3ab287"
msgid "M-"
msgstr "A-"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_65d8e093"
msgid "S'il te plaît, sors d'ici. J'arrêterai toute cette folie moi-même."
msgstr "Geh jetzt bitte. Ich werde mich selbst um den ganzen Wahnsinn kümmern."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_3f4e98e6"
msgid "Et plus jamais je ne donnerai de l'argent à qui que ce soit pour te faire du mal."
msgstr "Und ich werde niemals mehr jemanden bezahlen, damit er dir wehtut."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_68701303"
msgid "{{noriko.n}} j-"
msgstr "{{noriko.n}}, ich-"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_c87216c5"
msgid "Va-t-en !"
msgstr "Verschwinde!"

#. Character:`akira`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_2cd7eae5"
msgid "Donc ça c'est ta chambre..."
msgstr "Das ist also dein Zimmer..."

#. Character:`akira`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_af78149d"
msgid "Intéressant, c'est plutôt sympa."
msgstr "Interessant. Es ist ganz nett."

#. Character:`akira`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_23e7e2a3"
msgid "C'est à peu près ce à quoi je m'attendais."
msgstr "Wenn auch ziemlich genau das, was ich erwartet habe."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_38de776a"
msgid "Arrête de regarder partout comme ça !"
msgstr "Hör auf, dich so umzuschauen!"

#. Character:`akira`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_42f7d168"
msgid "Pourquoi ? En quoi ça dérange ?"
msgstr "Warum? Wo ist das Problem?"

#. Character:`akira` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_59c9ebcb"
msgid "On a conclu un accord non ?"
msgstr "Wir hatten eine Abmachung, oder?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_d6e8a40a"
msgid "...[w] Oui..."
msgstr "...[w] Ja ..."

#. Character:`akira`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_66524a55"
msgid "Donc on doit officialiser ça correctement."
msgstr "Also müssen wir es offiziell machen... und angemessen."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_86653964"
msgid "Je sais..."
msgstr "Ich weiß ..."

#. Character:`akira` | Attributes:`arrogant`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_1078c727"
msgid "Commence donc déjà par me sucer !"
msgstr "Also, fang damit an, mir einen zu blasen!"

#. Character:`akira`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_21f49ad1"
msgid "Alors ? Tu attends quoi ?"
msgstr "Na? Worauf wartest du?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_e71b20ff"
msgid "Je ne veux pas faire ça ici...h"
msgstr "Ich will das nicht hier machen ..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_df6d7189"
msgid "Ma mère pourrait rentrer à tout moment et je pourrais avoir des problèmes..."
msgstr "Meine Mutter könnte jeden Augenblick zurückkommen und dann könnte ich in Schwierigkeiten geraten..."

#. Character:`akira` | Attributes:`arrogant`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_a9ff1c9a"
msgid "Ta mère peut nous rejoindre si tu veux verux, ça ne me dérange pas du tout !"
msgstr "Deine Mutter kann gerne mitmachen, wenn sie will. Ich hab’ damit kein Problem!"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_a65b6a2c"
msgid "Non mais ça va pas la tête ?!"
msgstr "Bist du völlig durchgedreht?!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_13637dc2"
msgid "Il y a aussi {{saito.n}}... Je n'ai aucun contrôle sur ses allées-et-venues."
msgstr "Und dann wäre da noch {{saito.n}}... Ich habe keine Kontrolle darüber, wohin er geht."

#. Character:`akira`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_4b604da9"
msgid "...[w] Ça me donne une idée !"
msgstr "...[w]Da habe ich eine Idee!"

#. Character:`akira`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_740b3d4b"
msgid "Montre moi sa chambre !"
msgstr "Zeig mir sein Zimmer!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_6b210338"
msgid "Quoi ?! Mais..."
msgstr "Was?! Aber..."

#. Character:`akira` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_68dbe274"
msgid "Discute pas !"
msgstr "Keine Widerrede!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_898b1990"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_80661a29"
msgid "Mes chéris je dois vous laisser, j'ai une course à faire en ville."
msgstr "Meine Lieben, ich muss leider gehen. Ich habe noch einen Termin in der Stadt."

#. Character:`yasuka`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_d772d9ce"
msgid "À plus tard !"
msgstr "Bis später!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_60a76012"
msgid "[font_size=14]Elle est partie ?[/font_size]"
msgstr "[font_size=14]Ist sie weg?[/font_size]"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_a438a2d4"
msgid "[font_size=14]Je crois...[/font_size]"
msgstr "[font_size=14]Ich glaube schon...[/font_size]"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_a4551ab0"
msgid "Alors qu'est ce que t'attends ? Un carton d'invitation ?!"
msgstr "Worauf wartest du dann noch? Eine Einladung?!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_4ad7276e"
msgid "T'as toujours un caractère de merde !"
msgstr "Du bist immer noch ein hoffnungsloser Fall!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ed85b032"
msgid "T'attends quoi pour venir me punir ?"
msgstr "Warum kommst du dann nicht rüber, um mich zu bestrafen?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_926dc966"
msgid "Ohhh sale petite... Attends un peu !"
msgstr "Ohhh, du kleines Luder... Warte nur!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ecb7c0fd"
msgid "Allez ! Arrête de vouloir me faire attendre..."
msgstr "Komm schon! Lass mich nicht warten..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_b11d758e"
msgid "Je ne sais pas trop... J'hésite..."
msgstr "Ich weiß nicht... was soll ich tun...?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_94c337ae"
msgid "Allez !"
msgstr "Komm schon!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_a1c5c607"
msgid "Satisfaite ?"
msgstr "Zufrieden?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_5efecf68"
msgid "... Tu peux refaire comme hier ?"
msgstr "...Könntest du es wie gestern machen?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ef2a085b"
msgid "Je peux !"
msgstr "Klar!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_f3e074df"
msgid "Mmh c'est... encore mieux !"
msgstr "Hmmm, das ist... sogar noch besser!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_1f956caa"
msgid "Alors accroche-toi, je vais commencer à aller plus vite !"
msgstr "Nimm dich in Acht, ich werd’ jetzt schneller!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_5efa119c"
msgid "Quoi !? Non je suis pas encore..."
msgstr "Was?! Nein, ich bin nicht-"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_82186b9e"
msgid "Je m'en fiche !"
msgstr "Das ist mir egal!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_dbcd1650"
msgid "Aaaah aaahh aaah"
msgstr "Aaaah aaahh aaah!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_abd71e16"
msgid "Plus vite, plus vite !"
msgstr "Schneller, schneller!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_a5fbaab1"
msgid "Je.... Putain c'est trop bon !"
msgstr "Ich... Fuck, das ist so gut!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_d12ab627"
msgid "Et c'est encore que le début !"
msgstr "Und wir haben gerade erst angefangen!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_c5456ce7"
msgid "Prends-moi en levrette par derrière !"
msgstr "Nimm mich jetzt von hinten ran!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_b485483d"
msgid "Je veux tout essayer !"
msgstr "Ich will alles ausprobieren!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_2c06a353"
msgid "Ohlàlà oui !"
msgstr "Oh mein... Ja!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_4a1a069b"
msgid "Oh putain !"
msgstr "Oh, Scheiße!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_4023c988"
msgid "Plus vite, plus vite bordel !"
msgstr "Schneller, schneller, verdammt nochmal!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_09ca2f4b"
msgid "Continue de te plaindre et je te laisse en plan !"
msgstr "Wenn du dich weiterhin so beschwerst, höre ich auf!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_115596c5"
msgid "Non ! Non ! Pardon !"
msgstr "Nein! Nein! Tut mir leid!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_33622361"
msgid "Je te promets que je serai obéissante à présent !"
msgstr "Ich verspreche dir, ich werde ab sofort ein braves Mädchen sein!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_e6268444"
msgid "À la bonne heure !"
msgstr "War auch langsam mal Zeit!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "t9f474f55f7"
msgid "Tu sais je peux aussi arreter et aller voir ailleurs."
msgstr "Du weißt, ich kann auch einfach aufhören und weggehen."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "t3948b597b1"
msgid "Si tu fais ça je pourrirais encore plus la vie qu'avant !"
msgstr "Wenn du das tust, mache ich dir das Leben nur noch mehr zur Hölle!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "t3f9c49d299"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "td41137fc8e"
msgid "Je plaisantais ! Allez !"
msgstr "Ich mache doch nur Witze! Komm schon!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_0bf3ffe0"
msgid "IL NE POURRA SE SORTIR DE CETTE SITUATION S'IL EST CONSTAMMENT SURPROTÉGÉ !"
msgstr "ER KANN SICH NICHT AUS DIESER SITUATION BEFREIEN, WENN ER STÄNDIG IN WATTE GEPACKT WIRD!"

#. Character:`asami`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_a7153541"
msgid "LE METTRE EN DANGER N'EST PAS UNE SOLUTION NON PLUS !"
msgstr "IHN IN GEFAHR ZU BRINGEN IST ABER AUCH KEINE LÖSUNG!"

#. Character:`asami`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ff63257f"
msgid "TU FAIS QUOI SI L'UN DE CES TROIS IDIOTS SORT UN COUTEAU ET..."
msgstr "WAS WILLST DU MACHEN, WENN EINER DIESER DREI IDIOTEN EIN MESSER RAUSHOLT UND..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_e70e98c9"
msgid "Bon ça suffit, vous allez trop loin toutes les deux."
msgstr "Okay, das reicht! Ihr geht beide zu weit."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_3021a9c0"
msgid "Je me sens touché que vous vous fassiez autant de soucis pour moi mais j'aimerais quand même avoir mon mot à dire sur toute cette histoire."
msgstr "Ich fühle mich sehr geschmeichelt, dass ihr euch so um mich sorgt, aber ich würde da auch ganz gerne mitentscheiden wollen."

#. Character:`asami`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_c3703306"
msgid "Désolée..."
msgstr "Entschuldigung..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_8dbc4975"
msgid "Pfff si tu veux..."
msgstr "Tsss, wenn du willst..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_f0b633f9"
msgid "Arrêtez de vous mêler de mes affaires !"
msgstr "Hör auf, dich in meine Angelegenheiten einzumischen!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_e701ac91"
msgid "Si vous devez vous fâcher toutes les deux à cause de moi je préfère encore me débrouiller seul."
msgstr "Wenn ihr euch beide meinetwegen so aufregen müsst, kümmere ich mich lieber alleine darum."

#. Character:`asami`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_6a1adb7c"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_29cd7803_1"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_c32bd976"
msgid "Bon... Je peux savoir ce qui se p-"
msgstr "Nun... Ich würde gerne wissen, was los ist-"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_cb628197"
msgid "C'est moi !"
msgstr "Ich bin’s!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_39728dee"
msgid "Si tu te fais sans cesse harceler par les thugs c'est à cause de moi !"
msgstr "Wenn du ständig von den Schlägern belästigt wirst, dann nur meinetwegen!"

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_13292e4b"
msgid "Je ne suis pas sûr de comprendre... Pourquoi ce serait ta faute ?"
msgstr "Ich glaube, ich verstehe nicht ganz... Warum sollte es deine Schuld sein?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_438dad13"
msgid "C'est parce que je leur ai demandé de le faire."
msgstr "Weil ich sie darum gebeten habe, es zu tun."

#. Character:`saito` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_637ce628"
msgid "..."
msgstr "..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_236905ba"
msgid "Ce qui explique pourquoi {{asami.n}} s'est mise en colère. Je comprend mieux a présent."
msgstr "Das erklärt, warum {{asami.n}} wütend geworden ist. Jetzt verstehe ich es endlich."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_41aedebf"
msgid "Je veux une explication sinon crois moi j'en ai terminé avec toi."
msgstr "Ich verlange eine Erklärung. Ansonsten, glaub mir, hab ich genug von dir."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_b788d0f7"
msgid "...Je... J'en avais plus qu'assez..."
msgstr "...Ich... Ich hatte einfach die Schnauze voll..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_fb0870e4"
msgid "Tu te fais harceler depuis tellement longtemps, tu ne disais rien a personne."
msgstr "Du wurdest so lange belästigt, aber du hast nie mit irgendwem darüber geredet."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_b79539b1"
msgid "Tu étais trop gentil avec tous les autres... Tu te faisais marcher sur les pieds sans jamais lever la voix."
msgstr "Du warst zu nett zu allen anderen... Du hast dich zertrampeln lassen ohne jede Gegenwehr."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_7200eb5a"
msgid "Tu t'es laissé faire en pensant que ça passerait avec le temps."
msgstr "Du hast einfach aufgegeben, in dem Glauben, all das würde eines Tages vorübergehen."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ba9834eb"
msgid "Ils t'ont fait vivre un enfer."
msgstr "Sie haben dir das Leben zur Hölle gemacht."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_08ff9204"
msgid "Je voulais que tu réagisses... Que pour une fois tu puisses faire face."
msgstr "Ich wollte, dass du dich wehrst... Dass du einfach irgendwie zurechtkommst."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_e21dc606"
msgid "Alors..."
msgstr "Also..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_f22f2d10"
msgid "J'ai demandé aux thugs de te mener la vie dure pour qu'un jour tu prennes confiance en toi et que tu t'affirmes."
msgstr "Ich habe die Schläger darum gebeten, dir das Leben schwer zu machen, damit du eines Tages mehr Selbstvertrauen gewinnen und dich durchsetzen könntest."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_7999945b"
msgid "Ces trois idiots ne valent rien !"
msgstr "Diese drei Idioten sind wertlos!"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_e9bd6bd0"
msgid "Facile à dire..."
msgstr "Du hast gut reden..."

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ad2285e9"
msgid "ILS NE VALENT RIEN !"
msgstr "SIE SIND WERTLOS!"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_cc4ca906"
msgid "Je ne sais pas pourquoi tu es si effrayé par eux mais ils ne sont rien..."
msgstr "Ich weiß nicht, warum du so viel Angst vor denen hast! Die sind nichts..."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_406dcdec"
msgid "C'est quand même fou... C'est moi qui ai subi tout ça... et tu me donnes l'impression d'avoir été la victime."
msgstr "Dennoch erstaunlich... Ich bin derjenige, der all das durchmachen musste... und du schaffst es, dass ich mich hier wie das Opfer fühle."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_216311fa"
msgid "C'est..."
msgstr "Das ist ..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_67f017b0"
msgid "Bref... J'en ai assez entendu pour aujourd'hui je crois."
msgstr "Wie auch immer... Ich glaube, ich habe für heute genug gehört."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_fb95b21e"
msgid "Je vais...[w] J'ai besoin de faire le point."
msgstr "Ich werde jetzt...[w] Ich muss über all das in Ruhe nachdenken."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_8f035b01"
msgid "Non ! Ne pars pas !"
msgstr "Nein! Geh nicht!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_e196db52"
msgid "J'ai été odieuse je le sais, a cause de moi tu as souffert mais je voulais seulement arranger les choses, je voulais..."
msgstr "Ich war gehässig, ich weiß, und du hast meinetwegen gelitten, aber ich wollte die Dinge nur besser machen! Ich wollte..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ae7a3404"
msgid "{{noriko.n}}... Même si je t'ai détesté voir hais toutes ces années... Comprendre enfin la raison derrière tout ça me fait voir les choses sous un autre angle."
msgstr "{{noriko.n}}... Obwohl ich dich all die Jahre so sehr gehasst habe... Jetzt, wo ich den Grund hinter alldem verstehe, betrachte ich die Dinge aus einem anderen Blickwinkel."

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_6fa2a78d"
msgid "Laisse moi faire le tri dans mes idées et je te promets que que ça ira mieux demain."
msgstr "Lass mich meine Gedanken sortieren und ich verspreche dir, morgen wird es besser werden."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_ec5e0aba"
msgid "D'accord..."
msgstr "In Ordnung ..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_f4a3689b"
msgid "Merde... Si j'avais su tout ça avant..."
msgstr "Scheiße... Wenn ich das vorher gewusst hätte..."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_8861fab6"
msgid "J'étais à ce point pathétique.."
msgstr "Ich war wirklich armselig."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_db51f401"
msgid "En pensant pouvoir gérer mes problèmes moi-même je me rends compte que je n'ai fait qu'inquiéter ceux qui tenaient à moi."
msgstr "Indem ich dachte, ich könnte meine Probleme selbst in den Griff bekommen, habe ich gemerkt, dass ich nur diejenigen beunruhigte, denen ich wichtig war."

#. Character:`narrator`
#: game/story/home_player_noriko_room.dialogue
msgctxt "menu_rejet_noriko_final_9f91fa65"
msgid "J'étais vraiment à côté de la plaque."
msgstr "Ich hab’s wirklich nicht verstanden."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_95fd66a9"
msgid "Prêt pour ta récompense ?"
msgstr "Bereit für deine Belohnung?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_18a5829e"
msgid "Quoi ?! Mais... Je croyais que tu allais juste..."
msgstr "Was?! Aber... Ich dachte, du würdest einfach..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_0e7d3bd5"
msgid "Faire un gâteau ?"
msgstr "Einen Kuchen backen?"

#. Character:`noriko` | Attributes:`bad,blush`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_78e4fd33"
msgid "Comment tu as pu penser un truc pareil ?"
msgstr "Wie kommst du auf sowas?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_0b7519e0"
msgid "Je me le demande...[w] Et donc ? Pourquoi tu es... nue ?"
msgstr "Ich frage mich...[w] Warum bist du... nackt?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_0cb72bb2"
msgid "Tu vas bien manger mais pas ce que tu croyais.."
msgstr "Du wirst heute gut essen, aber nicht so, wie du denkst..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_695320b8"
msgid "J'ai pas envie de jouer a ça {{noriko.n}} !"
msgstr "Ich habe keine Lust auf deine Spielchen, {{noriko.n}}!"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_6bf1a80d"
msgid "Ah oui ? Tu es sur de toi, c'est probablement ta seule chance..."
msgstr "Wirklich? Bist du dir sicher? Das ist wahrscheinlich deine einzige Chance..."

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_659c843b"
msgid "Tu va la saisir ou te comporter comme un lâche une fois de plus ?"
msgstr "Nimmst du das Angebot an oder verhältst du dich wieder wie ein Feigling?"

#. Character:`saito`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_5852b62f"
msgid "Mais bordel jusqu'ou tu compte aller pour..."
msgstr "Was zur Hölle hast du vor..."

#. Character:`noriko` | Attributes:`neutral,blush`
#: game/story/home_player_noriko_room.dialogue
msgctxt "talk_noriko_f46dbb43"
msgid "C'est maintenant que tu dois te décider !"
msgstr "Jetzt ist es an der Zeit, dass du dich entscheidest!"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_noriko_room.dialogue
msgctxt "choice_noriko_cunni_97d407ad"
msgid "Tu es sur de toi ?"
msgstr "Bist du dir sicher?"

#. Character:`noriko`
#: game/story/home_player_noriko_room.dialogue
msgctxt "choice_noriko_cunni_78240909"
msgid "Tu risques probablement de le regretter tu sais..."
msgstr "Du wirst es wahrscheinlich bereuen, weißt du..."

#. Character:`noriko` | Attributes:`shame,blush`
#: game/story/home_player_noriko_room.dialogue
msgctxt "choice_noriko_cunni_7844d295"
msgid "..."
msgstr "..."

#. Character:`narrator`
