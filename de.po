#: game/story/restaurant_sakuya_room.dialogue
msgctxt "NON_TU_N_IRAS_NULLE_PART_AVANT_F55305"
msgid "Non, tu n'iras nulle part avant de m'expliquer ce qu'il se passe !"
msgstr "Nein, du gehst nirgendwo hin, solange du mir nicht erzählt hast, was los ist!"

#. Character:`noriko`
#: game/story/restaurant_sakuya_room.dialogue
msgctxt "MAIS_A_E_A_E_A_E_D_ACCORD_D_AC_01DF64"
msgid "Mais... Aïe aïe aïe... d'accord, d'accord !!"
msgstr "Aber ... Autsch, autsch ... Okay, okay!"

#. Character:`centered`
#: game/story/restaurant_sakuya_room.dialogue
msgctxt "NORIKO_N_EXPLIQUE_LA_SITUATIO_66428D"
msgid "{{noriko.n}} explique la situation."
msgstr "{{noriko.n}} erklärt die Situation."

#. Character:`noriko` | Attributes:`bad`
#: game/story/restaurant_sakuya_room.dialogue
msgctxt "JE_SUPPOSE_QUE_TOUT_A_DOIT_BIE_FD7F67"
msgid "Je suppose que tout ça doit bien t'arranger."
msgstr "Ich schätze, du musst mit alldem glücklich sein."

#. Character:`noriko`
#: game/story/restaurant_sakuya_room.dialogue
msgctxt "TOI_QUI_VEUX_GARDER_SAITO_N_RI_BDCB4A"
msgid "Toi qui veux garder {{saito.n}} rien que pour toi !"
msgstr "Du willst {{saito.n}} vermutlich ganz für dich behalten!"

#. Character:`sakuya` | Attributes:`sad`
#: game/story/restaurant_sakuya_room.dialogue
msgctxt "C_EST_L_O_TU_TE_TROMPES_ET_CE_44D53A"
msgid "... C'est là où tu te trompes et cela montre bien que tu ne connais rien à l'amour."
msgstr "... Da liegst du daneben und es beweist, dass du von Liebe keine Ahnung hast."

