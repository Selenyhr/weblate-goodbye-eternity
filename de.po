msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/restaurant_exterior.dialogue
msgctxt "JE_TE_TROUVE_BIEN_IMPATIENTE_C8B720"
msgid "Je te trouve bien impatiente."
msgstr ""

#. Character:`saito`
#: game/story/restaurant_exterior.dialogue
msgctxt "NOUS_AVONS_ENCORE_UN_PEU_DE_TE_5C6650"
msgid "Nous avons encore un peu de temps devant nous, autant aller nous promener en ville."
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/restaurant_exterior.dialogue
msgctxt "BON_J_ACCEPTE_MAIS_C_EST_PARCE_1486BF"
msgid "Bon, j'accepte, mais... c'est parce que c'est toi !"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "tc50fe37427"
msgid "[next]"
msgstr "[next]"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_40045615"
msgid "Salut toi !"
msgstr "Hallo!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_f6cde10a"
msgid "Je pensais justement à toi."
msgstr "Ich habe gerade an dich gedacht."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_f261baf5"
msgid "Tu as envie de quelque chose ?"
msgstr "Brauchst du irgendwas?"

#. Character:`narrator`
#: game/story/home_asami_asami_room.dialogue
msgctxt "t68e1a8a4dc"
msgid "Discuter"
msgstr "Reden"

#. Character:`narrator`
#: game/story/home_asami_asami_room.dialogue
msgctxt "t547040b4c2"
msgid "J'ai envie de toi"
msgstr "Ich brauche dich."

#. Character:`narrator`
#: game/story/home_asami_asami_room.dialogue
msgctxt "t6c1c64ba4a"
msgid "Retour"
msgstr "Zurück"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_a628ed32"
msgid "Oh, voyez-vous ça !"
msgstr "Na, sieh mal an!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_743fefe0"
msgid "C'est plutôt rare de te voir aussi entreprenant."
msgstr "Man sieht dich selten so selbstbewusst und zielstrebig."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_2222dfd7"
msgid "Mais je ne m'en plaindrais pas."
msgstr "Aber ich beschwer’ mich nicht."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_e62753a3"
msgid "À vrai dire... J'en avais envie moi aussi."
msgstr "Um ehrlich zu sein... habe ich das auch gewollt."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_95329bae"
msgid "Alors, qu'est-ce que tu attends ?"
msgstr "Worauf wartest du dann noch?"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_a26e802e"
msgid "C'est moi ou bien mon petit poney semble bien plus excité que d'habitude ?"
msgstr "Denke nur ich das oder ist mein kleines Pony aufgeregter als sonst?"

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_c360c9d3"
msgid "C'est...[w] possible."
msgstr "Das wäre...[w] möglich."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_fd966c1f"
msgid "Héhé..."
msgstr "Hihi..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_e61642e6"
msgid "Je ne veux plus jamais me disputer avec toi !"
msgstr "Ich will nie wieder mit dir streiten!"

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_eb76599e"
msgid "Moi non plus."
msgstr "Ich auch nicht."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_6fd40c44"
msgid "La prochaine fois que tu dois me dire quelque chose d'important..."
msgstr "Das nächste Mal, wenn du mir etwas Wichtiges erzählen musst..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_2d5b9e56"
msgid "Insiste plus !"
msgstr "Besteh mehr darauf!"

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_f2baee58"
msgid "Promis."
msgstr "Versprochen."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_82233579"
msgid "Oh mon Dieu ! Oh mon Dieu !"
msgstr "Oh mein Gott! Oh mein Gott!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_0b7d8a15"
msgid "Je..."
msgstr "Ich ..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_3095e9ea"
msgid "Je vais jouir !"
msgstr "Ich komme gleich!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_82e7a915"
msgid "Franchement, c'est bien mieux lorsqu'on n'est pas dérangés."
msgstr "Ehrlich gesagt ist es wesentlich besser, wenn wir nicht unterbrochen werden."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_2c02546e"
msgid "Tu ne crois pas ?"
msgstr "Findest du nicht auch?"

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "menu_asami_room_waiting_0b853865"
msgid "Je n'osais pas le dire..."
msgstr "Ich habe es nicht gewagt, es auszusprechen..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_ec8e6ef7"
msgid "Pfff... Quelle situation nulle !"
msgstr "Tss... Diese Situation ist scheiße!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_ee95d5b9"
msgid "Je comprends pas comment j'en suis arrivée là !"
msgstr "Ich verstehe nicht, wie ich hier gelandet bin!"

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_a18e7070"
msgid "Ma chérie, tout va bien ?"
msgstr "Liebling, ist alles gut?"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_42a9600a"
msgid "C'est rien maman, j'ai juste un choix à faire et je ne suis pas sûre de savoir si je prendrais la bonne décision."
msgstr "Ach, nichts, Mama. Ich muss einfach nur eine Entscheidung treffen und sichergehen, dass ich es nicht verhaue."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_523bebc0"
msgid "C'est juste un choix compliqué et je ne m'en sors pas..."
msgstr "Ich habe einfach nur eine schwierige Entscheidung zu treffen und ich kann mich nicht entscheiden..."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_88eeb506"
msgid "Oh ! Alors peut-être que l'amie qui est venue te rendre visite pourra t'aider ?"
msgstr "Oh! Vielleicht kann dir ja dein Freund, der dich neulich besucht hat, helfen?"

#. Character:`asami` | Attributes:`surprised`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_bef97d0f"
msgid "Une amie ?"
msgstr "Ein Freund?"

#. Character:`natsume`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_75507adf"
msgid "Merci beaucoup madame, je vais prendre le relais !"
msgstr "Vielen Dank, Madame! Ich würde das ab hier übernehmen, wenn es recht ist!"

#. Character:`sayuri` | Attributes:`depressed`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_a3efa4b0"
msgid "C'est {{sayuri.n}}, madame c'est trop... Bref ! Ravie d'avoir fait ta connaissance."
msgstr "Nenn mich {{sayuri.n}}. „Madame“ ist etwas übertrieben... Wie auch immer! Schön, dich kennenzulernen."

#. Character:`natsume`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_f5459b45"
msgid "C'est vraiment sympa ici, j'aime beaucoup !"
msgstr "Es ist wirklich schön hier. Ich mag’s!"

#. Character:`asami` | Attributes:`bored`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_4543f9cf"
msgid "T'es la fille qui traînait avec {{minato.n}} hier près du canal."
msgstr "Du bist das Mädchen, das gestern mit {{minato.n}} beim Kanal abgehangen hat."

#. Character:`asami` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_2b840516"
msgid "Tu es qui exactement pour lui ?"
msgstr "Wer genau bist du für ihn?"

#. Character:`natsume` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_2eed7b0c"
msgid "Quelqu'un qui ne te veut que du bien..."
msgstr "Jemand, der dir nur Gutes wünscht..."

#. Character:`natsume`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_e8fce8f6"
msgid "Alors, tu as pris une décision ?"
msgstr "Also hast du eine Entscheidung getroffen?"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_ae147d17"
msgid "... Je ne sais pas trop, j'ai désiré ça depuis si longtemps et maintenant que je l'ai, je ne suis plus sûre d'en vouloir."
msgstr "...Ich weiß nicht so recht. Ich habe das so lange gewollt, aber jetzt, wo ich es habe, weiß ich nicht, ob ich es immer noch will."

#. Character:`natsume` | Attributes:`smug`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_dbd63f36"
msgid "Je constate que tu es sur la bonne voie..."
msgstr "Ich sehe, du bist auf dem richtigen Weg..."

#. Character:`natsume`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_4c92cb72"
msgid "Mais j'aimerais néanmoins que tu écoutes ça."
msgstr "Aber ich würde dir gerne trotzdem etwas zeigen."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_b62f03e1"
msgid "Qu'est-ce que c'est ?"
msgstr "Was ist das?"

#. Character:`natsume`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_b9284e40"
msgid "Un petit enregistrement. Ça te sera sûrement très utile."
msgstr "Eine kleine Aufnahme. Ich bin mir sicher, dass sie dir helfen wird."

#. Character:`natsume` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_a646827f"
msgid "Toutefois j'ai une condition... Détruis-le après l'avoir écouté."
msgstr "Aber ich habe eine Bedingung... Zerstöre sie, nachdem du sie dir angehört hast."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_fe73a7a5"
msgid "On dirait un truc d'espions..."
msgstr "Das sieht so aus, als käme es direkt aus einem Krimi oder so..."

#. Character:`natsume` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_9ee1d2c9"
msgid "C'est à peu près ça, mais j'aurais des ennuis si ça s'apprend donc promets-le moi."
msgstr "Ich denke, das wär’s, aber ich kriege Probleme, wenn das herauskommt, also versprich es mir bitte."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_f555ad92"
msgid "C'est promis !"
msgstr "Versprochen!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_9c702275"
msgid "Alors... Voyons ça..."
msgstr "Also... Lass uns mal sehen..."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "IL_FAUT_ME_COMPRENDRE_AUSSI_J_EE1B85"
msgid "Il faut me comprendre aussi, j'ai de gros besoins à satisfaire."
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "IL_ME_SEMBLAIT_POURTANT_QU_IL_B72794"
msgid "Il me semblait pourtant qu'il n'y a pas si longtemps tu n'avais jamais fait ça."
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "PEUT_TRE_BIEN_MAIS_MAINTENANT_34BB1E"
msgid "Peut-être bien mais... Maintenant que j'ai goûté je suis accro, c'est encore plus fort que le chocolat!"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "DONC_SI_JE_N_AI_PAS_MA_DOSE_DE_73E431"
msgid "Donc si je n'ai pas ma dose de toi régulièrement je vais être de mauvaise humeur."
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_asami_asami_room.dialogue
msgctxt "OULA_D464D4"
msgid "Oula !"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "DONC_JE_COMPTE_SUR_TOI_POUR_VE_F70247"
msgid "Donc je compte sur toi pour venir passer du temps régulièrement avec moi, c'est compris ?"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "VOS_ORDRES_322038"
msgid "À vos ordres !"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "D_AILLEURS_SI_TU_ES_D_ATTAQUE_4F3C69"
msgid "D'ailleurs... Si tu es d'attaque, j'enchaînerais bien sur un second round..."
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_asami_asami_room.dialogue
msgctxt "EN_TEMPS_NORMAL_JE_N_AURAIS_M_E1E727"
msgid "En temps normal je n'aurais même pas attendu que tu le demandes mais malheureusement je dois y aller."
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "PFFF_QU_EST_CE_QUE_JE_FAIS_MOI_BCF584"
msgid "Pfff... Qu'est-ce que je fais moi en attendant ?"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "A_C_EST_TON_PROBL_ME_928863"
msgid "Ça c'est ton problème !"
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "ALLEZ_VAS_Y_MON_BEL_TALON_TRAV_C0F864"
msgid "Allez vas-y mon bel étalon ! Travaille dur !"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "JE_NE_T_ACCOMPAGNE_PAS_SINON_T_17E95D"
msgid "Je ne t'accompagne pas sinon ta collègue va encore me fusiller du regard."
msgstr ""

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "DANS_CE_CAS_PLUS_TARD_8A290A"
msgid "Dans ce cas à plus tard !"
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "AAAAH_A_M_AVAIT_MANQU_E38FA3"
msgid "Aaaah, ça m'avait manqué !"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "ON_DEVRAIT_VRAIMENT_SE_FAIRE_A_888B41"
msgid "On devrait vraiment se faire ça plus souvent."
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "TU_DIS_A_PARCE_QUE_TU_GAGNES_666DB2"
msgid "Tu dis ça parce que tu gagnes."
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "NON_PAS_SEULEMENT_JE_DIS_A_PAR_3A1B51"
msgid "Non pas seulement... Je dis ça parce que j'aime bien quand tu es là."
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "JE_ME_SENS_PLUS_D_TENDUE_2B42BC"
msgid "Je me sens plus détendue."
msgstr ""

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "EH_BIEN_DANS_CE_CAS_SI_TU_ES_B_716A0F"
msgid "Eh bien dans ce cas, si tu es bien détendue je vais te laisser."
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "QUOI_D_J_NONNNN_F51D3D"
msgid "Quoi déjà ? Nonnnn"
msgstr ""

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "C_EST_LA_VIE_Y_EN_A_QUI_DOIVEN_7700EE"
msgid "C'est la vie, y en a qui doivent bosser malheureusement..."
msgstr ""

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "JE_SUIS_DE_TOUT_C_UR_AVEC_TOI_FA79F3"
msgid "Je suis de tout cœur avec toi !"
msgstr ""

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "QU_EST_CE_QUE_TU_VAS_FAIRE_E8A68A"
msgid "Qu'est-ce que tu vas faire ?"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "CONTINUER_DE_JOUER_F54B56"
msgid "Continuer de jouer !"
msgstr ""

#. Character:`saito` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_031ba670"
msgid "..."
msgstr "..."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "BAH_QUOI_49ED32"
msgid "Bah quoi ?"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "PAS_DE_TEMPS_PERDRE_4313A2"
msgid "Pas de temps à perdre !"
msgstr ""

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_30ac16f2"
msgid "Oh !"
msgstr "Oh!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_19dd112e"
msgid "J'en suis !"
msgstr "Ich bin dabei!"

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_6ef90bb7"
msgid "Je préfère me dépêcher avant que ma mère ne rentre pour essayer de faire sa curieuse !"
msgstr "Wir sollten uns lieber beeilen, bevor meine Mutter wiederkommt."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_bcb277b4"
msgid "On devrait avoir une petite heure devant nous."
msgstr "Wir sollten noch etwa eine Stunde haben."

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_00759abf"
msgid "J'ai bien peur que ce soit loin d'être suffisant."
msgstr "Ich befürchte, das wird nicht genug sein."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_444b3b66"
msgid "Je... Je sais.... Mais..."
msgstr "Ich... Ich weiß... Aber..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_97ef1cfe"
msgid "Les vacances sont loin d'être...[w] terminées !"
msgstr "Die Ferien sind noch lange nicht...[w] vorbei!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_152b77d0"
msgid "Oh, bon sang..."
msgstr "Oh Mann..."

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_23ea0e6b"
msgid "Tu étais si pressée pour ne pas me laisser le temps d'enlever mes vêtements ?"
msgstr "Hast du es so eilig, dass du mir nicht einmal die Zeit lässt, mich auszuziehen?"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_326f75f5"
msgid "Oh mon Dieu... Ça vient !"
msgstr "Oh mein Gott... Ich komme!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_38bbf4d6"
msgid "Ne t'arrête pas !"
msgstr "Hör nicht auf!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_8901eed1"
msgid "Je vais j-"
msgstr "Ich k-"

#. Character:`sakuya`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_9961f383"
msgid "Non non non non non !"
msgstr "Nein, nein, nein, nein, nein, nein!"

#. Character:`sakuya`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_a6bb7c57"
msgid "Je t'avais prévenu, {{saito.n}} !"
msgstr "Ich habe dich gewarnt, {{saito.n}}!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "HEY_POURQUOI_CETTE_FOLLE_EST_C_5F2F36"
msgid "Hey, pourquoi cette folle est collée à ma fenêtre ?!!"
msgstr ""

#. Character:`sakuya`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_33df8099"
msgid "{{saito.n}} est à moi et à moi seule !"
msgstr "{{saito.n}} gehört mir und nur mir allein!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_2cec9e07"
msgid "Oh bon sang..."
msgstr "Oh Gott ..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_8cea69bc"
msgid "Si tu es plutôt rétro-gaming j'ai la Super-NES..."
msgstr "Wenn du mehr so auf Retro-Spiele stehst, hätte ich auch noch ein SNES..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_520326bd"
msgid "Peu importe, montre-moi celui que tu préfères."
msgstr "Ich bin mit allem zufrieden. Zeig mir einfach das, was du am liebsten magst."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_3cf5a21e"
msgid "Oui mais... C'est un jeu solo, donc ça va pas être drôle si tu passes ton temps à regarder."
msgstr "Okay, aber... Das ist ein Singleplayer-Spiel, also wäre es für dich nicht gerade spaßig, die ganze Zeit nur zuzuschauen."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_678df1d6"
msgid "Que penses-tu d'un petit bomberman ?"
msgstr "Wie wäre es mit etwas Bomberman?"

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_18c21cb3"
msgid "Ah ! Ça ça me parle ! Très bon choix !"
msgstr "Ah! Das kenne ich! Gute Wahl!"

#. Character:`sakuya`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_bef49bc0"
msgid "Mon amour pourquoi es-tu entré dans cette maison ?"
msgstr "Liebling, warum hast du dieses Haus betreten?"

#. Character:`sakuya` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_dae2e233"
msgid "C'est qui cette fille ?!"
msgstr "Wer ist dieses Mädchen?!"

#. Character:`sakuya`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_d0a47177"
msgid "Je suis sûre qu'elle en a après lui !"
msgstr "Ich bin mir sicher, dass sie hinter ihm her ist!"

#. Character:`sakuya` | Attributes:`angry`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_fc6a8dba"
msgid "{{saito.n}} est à moi et à personne d'autre !"
msgstr "{{saito.n}} gehört nur mir allein!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_44fc3c3e"
msgid "Ahah tu te défendais mieux chez toi !"
msgstr "Ahah, du hast dich bei dir zu Hause besser geschlagen!"

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_60271c6f"
msgid "Ahhh c'est juste que... ça fait longtemps, laisse-moi retrouver mes réflexes !"
msgstr "Ahhh, es ist nur... Ich bin nur etwas eingerostet, gleich habe ich mich wieder eingespielt!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_d3d69929"
msgid "Pas de soucis grand-père !"
msgstr "Kein Problem, Großväterchen!"

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_f110498d"
msgid "Insolente !"
msgstr "Wie unverschämt!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_dadb39bd"
msgid "Haha !"
msgstr "Haha!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_f3f0c139"
msgid "Au fait pourquoi tu t'es assis aussi loin de moi ?"
msgstr "Warum hast du dich eigentlich so weit von mir weggesetzt?"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_cd50a907"
msgid "Tu as peur que je te mange ou quoi ?"
msgstr "Hast du Angst, dass ich dich auffresse oder so?"

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_9d723b0b"
msgid "Oh je..."
msgstr "Oh, ich..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_7f674549"
msgid "Allez sois pas timide, rejoins-moi sur le lit, c'est plus confortable !"
msgstr "Komm schon, sei nicht so schüchtern! Komm mit aufs Bett, das ist viel gemütlicher!"

#. Character:`sakuya`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_02024b09"
msgid "NON NON NON !"
msgstr "NEIN NEIN NEIN!"

#. Character:`sakuya`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_3ad4cb3e"
msgid "Écarte-toi de lui tout de suite !"
msgstr "Halt dich von ihm fern!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "ENCORE_ELLE_A25FD3"
msgid "Encore elle !?"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_ae537cf2"
msgid "Qu'est-ce qu'elle fait dans mon jardin !"
msgstr "Und was hat sie in meinem Garten zu suchen?!"

#. Character:`sakuya`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_6ed4cc59"
msgid "[font_size=14]{{saito.n}} est à moi, t'approche pas de lui sinon...[/font_size]"
msgstr "[font_size=14]{{saito.n}} gehört mir! Wag es nicht, ihm näherzukommen, sonst...[/font_size]"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_9bd3d4fa"
msgid "Je rêve ou elle me menace ?!"
msgstr "Träume ich gerade, oder bedroht sie mich?"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "SAITO_N_FAIS_QUELQUE_CHOSE_S_D64E0F"
msgid "{{saito.n}}, fais quelque chose s'il te plait !"
msgstr ""

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_7b3994fe"
msgid "Oui... Il semble qu'elle soit un peu trop accrochée à moi."
msgstr "Ja... Es scheint wohl so, als wäre sie ein wenig zu anhänglich."

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "JE_SUIS_D_SOL_JE_VAIS_ALLER_LU_9F7018"
msgid "Je suis désolé, je vais aller lui parler."
msgstr ""

#. Character:`asami` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_42d87205"
msgid "Dépêche-toi, elle me fait flipper !"
msgstr "Beeil dich! Sie macht mir Angst!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_34079a9f"
msgid "Son regard m'a donnée la chair de poule."
msgstr "Dieser Blick in ihren Augen hat mir Gänsehaut verpasst."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "JE_R_VE_OU_ELLE_TAIT_CARR_MENT_A6BA78"
msgid "Je rêve ou elle était carrément entrée dans la maison ?"
msgstr ""

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_33d92d00"
msgid "Tu n'as pas rêvé, mais je vais faire en sorte que tout ça ne se produise plus jamais."
msgstr "Du träumst nicht, aber ich werde sicherstellen, dass das nie wieder passiert."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_00e5327d"
msgid "Je m'en occupe tout de suite !"
msgstr "Ich kümmere mich darum!"

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_dbda7cc9"
msgid "Elle a gâché notre moment rien qu'à nous..."
msgstr "Sie hat unsere gemeinsame Zeit ruiniert..."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_fbd82e2f"
msgid "Elle a gâché notre journée jeu..."
msgstr "Sie hat unsere Videospiel-Session ruiniert..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_7a00707c"
msgid "De toute façon, ta mère est rentrée plus tôt que prévu."
msgstr "Na ja, deine Mutter ist ohnehin früher als erwartet nach Hause gekommen."

#. Character:`asami` | Attributes:`surprised`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_6dcc601c"
msgid "Quoi ?! Mais, elle avait dit au moins une heure, voire deux !"
msgstr "Was?! Aber sie hat doch gesagt, dass sie mindestens für ein, zwei Stunden wegwäre!"

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_dfb6681d"
msgid "Tant pis ! On remet ça à plus tard, tu promets de faire attention à toi ?"
msgstr "Das ist zu schade! Wir müssen das dann wohl auf später verschieben. Versprich mir, dass du auf dich aufpasst, okay?"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_f987b077"
msgid "Je n'ai pas aimé son regard. Rien que d'y penser... Brrrr."
msgstr "Ich mag den Blick, den sie hatte, nicht. Wenn ich auch nur daran denke... Brrr."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_d65773fa"
msgid "Je te promets de faire attention !"
msgstr "Ich verspreche dir, vorsichtig zu sein!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_4e0a0b76"
msgid "Hey salut toi !"
msgstr "Hey, du!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_0a55fd05"
msgid "Si j'avais su que tu viendrais me voir ce soir, je me serais préparée..."
msgstr "Wenn ich gewusst hätte, dass du mich heute Nacht besuchen würdest, hätte ich mich darauf vorbereitet..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_2ffa91d2"
msgid "Tu veux regarder un film, jouer à la console ou faire la bête à deux dos ?"
msgstr "Willst du einen Film schauen, ein paar Videospiele spielen oder irgendwas anderes machen?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_88892c3b"
msgid "Écoute..."
msgstr "Hör mir zu..."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_cf3c3a75"
msgid "Oh désolé, je ne pensais pas que tu serais habillée en..."
msgstr "Oh, sorry, ich hätte nicht gedacht, dass du schon umgezogen..."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_16672cb8"
msgid "C'est bon... C'est juste une nuisette !"
msgstr "Alles gut... ist doch nur ein Nachtkleid!"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_fbdc6eba"
msgid "Qu'est-ce que tu fais la ? Tu voulais te mater un film avec moi ?"
msgstr "Was machst du hier? Möchtest du einen Film mit mir schauen?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_bfdca012"
msgid "Écoute... Je... Je pense que notre amitié va un peu trop loin justement et..."
msgstr "Hör mir zu... Ich... Ich finde, unsere Freundschaft geht ein wenig zu weit und..."

#. Character:`asami` | Attributes:`upset,blush`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_1b5491b9"
msgid "Écoute ? J'ai la forte impression que je ne vais pas du tout aimer ce que je vais entendre."
msgstr "Hör mir zu? Ich habe das leichte Gefühl, dass mir das, was jetzt kommt, nicht gefallen wird."

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "JE_SUIS_D_SOL_MAIS_JE_DOIS_FAI_5C5F56"
msgid "Je suis désolé, mais... Je dois faire le point seul quelques temps pour..."
msgstr ""

#. Character:`asami` | Attributes:`angry`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_699750f6"
msgid "Stop ![w] Ne dit plus rien, je ne veux pas l'entendre !"
msgstr "Hör auf![w] Kein Wort mehr! Ich will’s nicht hören!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_1e9c2377"
msgid "Pars !"
msgstr "Geh!"

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_d6d5effb"
msgid "Mais, je..."
msgstr "Aber ich..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_0998b887"
msgid "TOUT DE SUITE !"
msgstr "SOFORT!"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_34bfe681"
msgid "Allez, explique-moi un peu ce qui t'a mise dans cet état-là ?"
msgstr "Komm schon. Sag mir, wie du in dieser Situation gelandet bist."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_4e57b26a"
msgid "... **[i]sniff[/i]**"
msgstr "**[i]Schnief...[/i]**"

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_40719d0e"
msgid "Ma puce... Si tu ne me dis rien, je ne pourrai pas t'aider."
msgstr "Liebling... Wenn du es mir nicht erzählst, kann ich dir nicht helfen."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_aa41547b"
msgid "Il m'a quittée ! Voilà !"
msgstr "Er hat mich verlassen! Einfach so!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_c3c9680a"
msgid "Tout se passait bien entre nous."
msgstr "Es lief doch alles so gut zwischen uns."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_34292516"
msgid "Hier matin, c'était encore le bonheur et le soir..."
msgstr "Gestern Morgen war noch alles perfekt, aber am Abend..."

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_44f01d7b"
msgid "Oh ! Je vois... Ce sont malheureusement des choses qui arrivent."
msgstr "Oh! Verstehe... Leider kann sowas im Leben mal passieren."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_db66cda3"
msgid "Ce qui explique pourquoi je l'ai vu aussi peiné quand il est parti."
msgstr "Das erklärt, warum er so aufgebracht war, als er ging."

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_9e54475d"
msgid "Est-ce qu'il t'a au moins donnée une explication ?"
msgstr "Hat er dir zumindest eine Erklärung gegeben?"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_6b4e06c6"
msgid "Les gens ne quittent pas une personne du jour au lendemain comme ça."
msgstr "Menschen gehen über Nacht nicht einfach so."

#. Character:`sayuri` | Attributes:`moved`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_781ddc0b"
msgid "Les gens ne mettent pas fin à une amitié comme ça, c'est même plutôt rare, à moins de..."
msgstr "Menschen beenden Freundschaften nicht plötzlich einfach so. Das ist eigentlich sehr selten, es sei denn..."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_69ee5d41"
msgid "Quelle était la raison ?"
msgstr "Was war der Grund?"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_e70245f3"
msgid "... Je... je ne sais pas."
msgstr "Ich... ich weiß es nicht."

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_fc99bce2"
msgid "Comment ça ?"
msgstr "Wie kommt’s?"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_f4ea11dc"
msgid "Je... je savais ce qu'il allait me dire alors... je l'ai mis à la porte avant qu'il ne dise quoi que ce soit."
msgstr "Ich... ich wusste, was er sagen wollte, also... habe ich ihn rausgeworfen, bevor er sich erklären konnte."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_992d111b"
msgid "Mamannnn, j'ai tellement mal au cœur... **[i]sniff[/i]**"
msgstr "Mama, es tut so weh... **[i]Schnief...[/i]**"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_099e868e"
msgid "Ma puce, vient là !"
msgstr "Komm her, mein Schatz!"

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_4220d53b"
msgid "Tu sais... Tu risques de te morfondre pendant longtemps si tu restes sans savoir."
msgstr "Du weißt... Wenn du seine Beweggründe nicht verstehst, wird dich das noch lange beschäftigen."

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_17bd08db"
msgid "Tu dois lui laisser l'opportunité de t'expliquer ce qu'il s'est passé."
msgstr "Du musst ihm die Möglichkeit geben, zu erklären, was passiert ist."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_5f5a9612"
msgid "Et après, seulement après, tu pourras décider de ce que tu pourras faire."
msgstr "Nur dann kannst du vernünftig entscheiden, was zu tun ist."

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_ef315b0b"
msgid "Rester sans savoir serait pour moi la pire des choses..."
msgstr "Darüber im Dunkeln zu bleiben, wäre für mich das Schlimmste..."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_2a6fea30"
msgid "..."
msgstr "..."

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_8354a82d"
msgid "Je peux t'accompagner. Discrètement, bien entendu."
msgstr "Ich kann dich begleiten. Unauffällig natürlich."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_5bfed1ee"
msgid "Je... tu as raison... **[i]sniff[/i]**"
msgstr "Ich... Du hast Recht... **[i]Schnief...[/i]**"

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_4a6589db"
msgid "J'ai le droit à des explications et je les aurai."
msgstr "Ich habe ein Recht auf eine Erklärung und werde sie auch bekommen."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_444ad035"
msgid "Et, si c'est à cause d'une autre fille..."
msgstr "Und wenn es wegen eines anderen Mädchens ist..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_56748238"
msgid "Ses oreilles vont chauffer !"
msgstr "Wird er das bereuen!"

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_9f73a617"
msgid "Exactement, s'il a fait pleurer ma petite puce sans raison valable, je ne lui pardonnerai pas !"
msgstr "Genau! Wenn er mein kleines Mädchen ohne guten Grund zum Weinen gebracht hat, werde ich ihm nicht vergeben!"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_0f5d3e6a"
msgid "Merci, maman ! **[i]sniff[/i]**"
msgstr "Danke, Mama! **[i]Schnief...[/i]**"

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_1239c8b6"
msgid "Allez, sèche tes larmes ma puce, nous allons chercher nos réponses nous-même !"
msgstr "Wisch dir die Tränen ab, Liebling, und lass uns nach Antworten suchen!"

#. Character:`noriko`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_1be4764b"
msgid "Pourquoi tu n'as rien dit sur la fille en kimono ?! C'était vraiment louche comme situation."
msgstr "Warum hast du nichts über das Mädchen im Kimono gesagt?! Das war eine wirklich heikle Situation."

#. Character:`noriko`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_d4290819"
msgid "De plus, je ne comprends pas pourquoi tu as lâché l'affaire aussi vite avec elle."
msgstr "Abgesehen davon kann ich nicht verstehen, warum du so schnell aufgegeben hast."

#. Character:`asami` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_0bb2846c"
msgid "C'est elle..."
msgstr "Sie ist es..."

#. Character:`noriko`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_2e59a69e"
msgid "Quoi ?"
msgstr "Was?"

#. Character:`asami` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_163006f9"
msgid "C'est elle qui a dû faire quelque chose à {{saito.n}}."
msgstr "Sie muss {{saito.n}} irgendwas angetan haben."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_b7cee375"
msgid "Mais, comment tu le sais ? Elle n'a rien dit."
msgstr "Aber woher willst du das wissen? Sie hat nichts gesagt."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_8f1a7083"
msgid "Elle en a dit bien assez... Tu te souviens quand j'ai dit que nous étions à la recherche d'une personne ?"
msgstr "Sie hat genug gesagt... Erinnerst du dich, als ich sagte, wir würden nach jemandem suchen?"

#. Character:`noriko`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_bfffd62c"
msgid "Oui... et donc ?"
msgstr "Ja... Na und?"

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_007b6fed"
msgid "Je n'ai jamais précisé que c'était un homme ou une femme."
msgstr "Ich habe nie klargestellt, ob es ein Mann oder eine Frau war."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_7e9178ef"
msgid "Pourtant, elle m'a bien répondu..."
msgstr "Aber, sie hat gesagt..."

#. Character:`noriko`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_347db39a"
msgid "\"Il\" n'est pas ici..."
msgstr "Dass „er“ nicht hier sei..."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_0eef4f76"
msgid "Exactement !"
msgstr "Ganz genau!"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_44293725"
msgid "Ah la salope, je savais bien qu'elle était suspecte !"
msgstr "Diese Bitch! Ich wusste doch, dass mit ihr etwas nicht stimmt!"

#. Character:`asami` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_c32756c6"
msgid "Maintenant, quand je repense à l'homme qui s'est enfui quand nous avons mentionné cette fille, ça me fait penser qu'elle est dangereuse."
msgstr "Jetzt, wo ich an den Typen denke, der weggerannt ist, als wir dieses Mädchen erwähnten... Ich befürchte, das könnte heißen, dass sie gefährlich ist."

#. Character:`noriko`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_e068a087"
msgid "On n'a qu'à y aller à plusieurs en force, ou on appelle la police tout simplement !"
msgstr "Wir müssen einfach nur dahin gehen und uns den Weg hinein freikämpfen. Oder wir holen einfach die Polizei!"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_fccb8b59"
msgid "Et si, en voyant la police arriver, elle décidait de lui faire du mal ?"
msgstr "Was, wenn sie sich dazu entscheidet, ihm wehzutun, wenn sie die Polizei kommen sieht?"

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_898b1990"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_4e0e0969"
msgid "Tu... tu penses qu'elle le..."
msgstr "Du... du glaubst, sie würde...?"

#. Character:`asami` | Attributes:`angry`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_a976f51a"
msgid "NON ![w] Non... Je ne veux même pas envisager cette possibilité."
msgstr "NEIN![w] Nein... Ich will mir das nicht einmal vorstellen."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_cf857fa1"
msgid "Je suis sûre qu'il va bien."
msgstr "Ich bin mir sicher, ihm geht’s gut."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_5069d51b"
msgid "On va pas simplement s'introduire dans sa chambre comme ça... On doit juste réfléchir à un plan..."
msgstr "Wir können uns nicht einfach in ihr Zimmer schleichen... Wir müssen uns einen Plan überlegen..."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_e6ceb20b"
msgid "Oui, je me doute bien."
msgstr "Ja, ich weiß."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_967a95cb"
msgid "Qui serait assez idiot pour faire ça ?"
msgstr "Wer wäre dumm genug, sowas zu tun?"

#. Character:`noriko` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_82c30439"
msgid "C'est clair !"
msgstr "Absolut!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_bd6263be"
msgid "Pff, j'ai passé une nuit horrible."
msgstr "Tsss, ich hatte eine schreckliche Nacht."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_239aef49"
msgid "Je n'ai pas arrêté de faire des cauchemars..."
msgstr "Ich hatte andauernd Albträume..."

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_9319ce46"
msgid "La fille en kimono ?"
msgstr "Das Mädchen im Kimono?"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_9ed96646"
msgid "Oui... Je la voyais qui me pourchassait, brûlant tout ce à quoi je tenais..."
msgstr "Ja... Ich habe geträumt, dass sie mich gejagt hat und dabei alles verbrannt hat, was mir wichtig war..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_ac48cbde"
msgid "Il n'y a rien qui pouvait l'arrêter."
msgstr "Sie war nicht aufzuhalten."

#. Character:`noriko`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_8197319f"
msgid "J'avais aussi l'impression qu'elle était venue nous observer à la fenêtre."
msgstr "Ich hatte auch das Gefühl, als käme sie vorüber, um uns durch das Fenster zu beobachten."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_4de30304"
msgid "Cette fille est trop flippante !"
msgstr "Dieses Mädchen ist viel zu gruselig!"

#. Character:`asami` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_343ccd6d"
msgid "On doit sortir {{saito.n}} de là !"
msgstr "Wir müssen {{saito.n}} da raus bekommen!"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_bd382ff5"
msgid "On sait qu'elle nous empêchera d'entrer dans ce restaurant, mais avec une diversion."
msgstr "Sie wird uns davon abhalten wollen, das Restaurant zu betreten, aber mit einer Ablenkung..."

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_e8a67789"
msgid "Elle ne pourra pas nous retenir toutes les deux à la fois."
msgstr "Wird sie uns beide nicht gleichzeitig festhalten können."

#. Character:`noriko`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_8687512d"
msgid "Une de nous doit l'occuper, tandis que l'autre ira jeter un coup d'œil dans sa chambre discrètement."
msgstr "Eine von uns muss sie beschäftigt halten, während sich die andere in ihr Zimmer schleicht."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_85f11fac"
msgid "Ça me parait être un bon plan..."
msgstr "Klingt nach einem guten Plan..."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_livingroom_63157619"
msgid "Il reste certains petits détails à régler encore."
msgstr "Aber wir müssen immer noch die Details klären."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_c356cad9"
msgid "Je vois..."
msgstr "Ich verstehe ..."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_346597e6"
msgid "Quelque chose a donc dû se passer à ce moment-là."
msgstr "Irgenwas muss zu diesem Zeitpunkt passiert sein."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_93f1d0c2"
msgid "Mais ça veut pas forcément dire que tu es responsable."
msgstr "Aber das heißt nicht unbedingt, dass du dafür verantwortlich bist."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_a39a18bf"
msgid "Il a dû se passer quelque chose... D'accord. Mais est-ce que tu es fautif pour autant ?"
msgstr "Irgendetwas muss passiert sein... Okay. Aber heißt das, dass du schuld hast?"

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_e84df6c9"
msgid "On n'en sait rien !"
msgstr "Wir wissen es nicht!"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_c66600a8"
msgid "Et surtout... le fait que tu aies oublié tout ça prouve que toi aussi tu as vécu une mauvaise expérience."
msgstr "Und vor allem... Die Tatsache, dass du all das vergessen hast, beweist, dass du dabei auch schlechte Erfahrungen gemacht hast."

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_02896704"
msgid "Exactement !"
msgstr "Exakt!"

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_f57d118d"
msgid "C'est un mécanisme de protection du cerveau."
msgstr "Es ist ein Verteidigungsmechanismus des Gehirns."

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_8a5e0d41"
msgid "Quand on vit un évènement traumatisant, le cerveau nous le fait oublier, surtout si c'est un souvenir douloureux !"
msgstr "Wenn wir etwas Traumatisches erleben, verdrängt es das Gehirn, besonders wenn es sehr schmerzbehaftet ist!"

#. Character:`asami` | Attributes:`angry`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_331252ef"
msgid "Qu'est-ce qu'il fait chez moi lui ?"
msgstr "Was macht der in meinem Haus?"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_02996aab"
msgid "Je n'en sais rien, je ne l'ai pas invité."
msgstr "Ich weiß es nicht. Ich habe ihn nicht eingeladen."

#. Character:`kimochi` | Attributes:`think`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_7d40780c"
msgid "J'ai entendu toute votre conversation."
msgstr "Ich habe eure gesamte Unterhaltung gehört."

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_96d7d49e"
msgid "Vous faites ça pour aider {{noriko.n}} et je veux en être !"
msgstr "Ihr tut das, um {{noriko.n}} zu helfen und ich will mitmachen!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_34d661de"
msgid "Oui m-"
msgstr "Ja, ab-"

#. Character:`kimochi` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_c9dd0846"
msgid "{{saito.n}} ne dis plus rien, je t'ai souvent aidé maintenant c'est mon tour."
msgstr "{{saito.n}}, sag nichts. Ich habe dir oft genug geholfen, jetzt bin ich dran."

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_e7793bd5"
msgid "Je veux en être !"
msgstr "Ich will dabei sein!"

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_567db389"
msgid "Si tu veux mais tu te fais des idées si tu penses que {{noriko.n}} te..."
msgstr "Wenn du willst, aber wenn du wirklich glaubst, dass {{noriko.n}} dir am Ende..."

#. Character:`kimochi` | Attributes:`angry`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_25cc286d"
msgid "Elle est folle de moi et je le prouverai !"
msgstr "Sie ist verrückt nach mir und ich werde es beweisen!"

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_bdaef415"
msgid "J'en connais un qui va tomber de haut..."
msgstr "Da kommt aber eine schöne Überraschung auf jemanden zu..."

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_63a0ce90"
msgid "J'ai l'habitude de ne pas être pris au sérieux. Vous verrez bien qui aura raison à la fin."
msgstr "Ich bin es gewohnt, nicht ernst genommen zu werden. Ihr werdet schon sehen, wer am Ende Recht hat."

#. Character:`kimochi` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_071390b5"
msgid "Vous cherchez des réponses dans le passé mais vous n'en aurez pas."
msgstr "Ihr sucht nach Antworten in der Vergangenheit, aber da werdet ihr nichts finden."

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_7433a804"
msgid "Les réponses vous les trouverez seulement dans le présent."
msgstr "Ihr werdet nur Antworten in der Gegenwart finden."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_f708c55d"
msgid "Vas-y monsieur l'expert, qu'est-ce que tu proposes ?"
msgstr "In Ordnung, Besserwisser. Was schlägst du vor?"

#. Character:`kimochi` | Attributes:`disgusted`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_54fd9c17"
msgid "Je sens comme une petite animosité... Est-ce comme ça qu'on traite un ami ?"
msgstr "In spüre eine leichte Feindseligkeit... Behandelst du so deine Freunde?"

#. Character:`kimochi` | Attributes:`think`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_de14923e"
msgid "Bref...[w] Que fait-elle de ses journées ? A-t-elle une passion ? Des amies qu'elle retrouve en ville ?"
msgstr "Wie auch immer...[w] Was tut sie für gewöhnlich? Hat sie irgendwelche Vorlieben? Freunde, mit denen sie sich regelmäßig trifft?"

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_83c3ee2f"
msgid "A-t-elle peur de quelque chose en particulier ? Quelle est sa couleur préférée ? A-t-elle un ou une petite amie ?"
msgstr "Hat sie vor irgendwas Angst? Was ist ihre Lieblingsfarbe? Hat sie einen Freund oder eine Freundin?"

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_b739d42b"
msgid "Plus tu as d'informations sur elle, plus on pourra dresser un portrait précis de sa personnalité, de sa façon de penser."
msgstr "Je mehr Informationen wir über sie haben, desto besser können wir ein akkurates Profil von ihr zeichnen und ihre Denkweise nachverfolgen."

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_5e1cc29e"
msgid "Alors ?"
msgstr "Also?"

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_1be57732"
msgid "C'est cohérent... Alors {{saito.n}} ?"
msgstr "Das ergibt Sinn... Also, {{saito.n}}?"

#. Character:`kimochi` | Attributes:`disgusted`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_9fce4963"
msgid "...[w] Tout ce que tu sais de {{noriko.n}} c'est qu'elle regarde du porno ?"
msgstr "...[w] Alles, was du über {{noriko.n}} weißt, ist, dass sie Pornos schaut?"

#. Character:`narrator`
#: game/story/home_asami_asami_room.dialogue
msgctxt "t492e707036"
msgid "Je... Elle regarde du porno."
msgstr "Ich... Sie schaut Pornos."

#. Character:`narrator`
#: game/story/home_asami_asami_room.dialogue
msgctxt "t7f13f54e25"
msgid "Je suppose qu'elle passe son temps sur internet..."
msgstr "Ich schätze, sie verbringt ihre Zeit damit, im Internet zu surfen..."

#. Character:`kimochi` | Attributes:`angry`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_2519e44f"
msgid "Tu te fiches de moi ?"
msgstr "Willst du mich verarschen?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_00d0bed0"
msgid "Non... je ne me fiche pas de toi. Cela fait des années qu'elle m'évite, me harcèle et j'en passe."
msgstr "Nein... Ich mache keine Witze. Sie ist mir einfach nur stets aus dem Weg gegangen und hat mich all die Jahre beleidigt."

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_1f6a629d"
msgid "Rares sont les moments où j'ai eu une conversation normale avec elle."
msgstr "Ich kann die Anzahl, an normalen Konversationen, die ich mit ihr hatte, an einer Hand abzählen."

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_98481c39"
msgid "Je pense simplement qu'elle me déteste."
msgstr "Ich glaube, sie hasst mich einfach."

#. Character:`kimochi` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_7120aa32"
msgid "On ne déteste pas quelqu'un sans raison {{saito.n}}."
msgstr "Menschen hassen niemanden ohne Grund, {{saito.n}}."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_80c098d0"
msgid "Il a raison, quand tu as disparu à cause de {{sakuya.n}}, {{noriko.n}} a semblé vraiment inquiète."
msgstr "Er hat Recht. Als du wegen {{sakuya.n}} verschwunden warst, schien {{noriko.n}} wirklich besorgt zu sein."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_53b2c94b"
msgid "Elle m'a beaucoup aidée."
msgstr "Sie war mir eine große Hilfe."

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_909130c6"
msgid "Je... je ne savais pas."
msgstr "Ich... ich wusste nicht..."

#. Character:`kimochi` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_393657d9"
msgid "Tu vois ? Les choses ne sont pas aussi manichéennes, il semblerait bien qu'elle tienne un tant soit peu à toi mais pour une raison qui nous est inconnue..."
msgstr "Siehst du? Die Dinge sind nicht so schwarz-weiß. Sie scheint sich gewissermaßen um dich zu sorgen, aber warum, wissen wir nicht..."

#. Character:`kimochi` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_f1914ee0"
msgid "Elle ne peut pas te le montrer directement."
msgstr "Sie kann es dir nicht einfach zeigen."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_09874022"
msgid "Finalement... tu n'as pas l'air si mauvais que ça."
msgstr "Am Ende... scheinst du schließlich doch nicht so schlimm zu sein."

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_0e48caf3"
msgid "{{saito.n}} tu dois suivre {{noriko.n}} jour et nuit, nous devons tout savoir d'elle, je t'apprendrai à stalker comme un pro."
msgstr "{{saito.n}}, du musst {{noriko.n}} Tag und Nacht folgen. Wir müssen alles über sie herausfinden. Ich bringe dir bei, wie man stalkt wie ein Profi."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_c3789aff"
msgid "Oublie ce que je viens de dire."
msgstr "Vergiss, was ich gerade gesagt habe."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_0a0c785e"
msgid "{{saito.n}} n'écoute pas cet idiot, tout ce que tu risques c'est de finir en prison."
msgstr "{{saito.n}}, hör keine Sekunde auf diesen Idiot. Du riskierst nur, am Ende im Knast zu landen."

#. Character:`kimochi` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_23e2a435"
msgid "Il n'y a pas d'autres solutions, elle ne lui dira rien, ni à lui ou même à toi."
msgstr "Es gibt keine Alternativen. Sie wird nichts erzählen, nicht ihm und auch nicht dir."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_b688970b"
msgid "Mais quand même... C'est un peu..."
msgstr "Aber dennoch... Es ist ein wenig..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_935bccad"
msgid "{{kimochi.n}} a raison, {{noriko.n}} semble garder quelque chose pour elle depuis trop longtemps."
msgstr "{{kimochi.n}} hat Recht. {{noriko.n}} scheint irgendwas viel zu lange für sich behalten zu haben."

#. Character:`saito`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_62ff1840"
msgid "Si ça peut m'aider à me réconcilier définitivement avec elle, je dois le tenter."
msgstr "Wenn es mir dabei helfen kann, mich mit ihr wieder zu vertragen, muss ich es versuchen."

#. Character:`kimochi` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_9dc8c52d"
msgid "Exactement !"
msgstr "Exakt!"

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_29174d83"
msgid "Enfin une petite aventure entre hommes !"
msgstr "Endlich, ein richtiges Männerabenteuer!"

#. Character:`asami` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_ce34becf"
msgid "Hors de question ! Je viens avec vous, hors de question de te voir corrompre mon {{saito.n}} !"
msgstr "Keine Chance! Ich komme mit! Ich werde nicht zulassen, dass du meinen geliebten {{saito.n}} manipulierst!"

#. Character:`kimochi` | Attributes:`angry`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_7dc6b5c7"
msgid "{{saito.n}} dis quelque chose !"
msgstr "{{saito.n}}, sag doch auch etwas!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_6e385087"
msgid "J'en dis que c'est une très bonne idée."
msgstr "Ich sage, das ist eine sehr gute Idee."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_b9d68f22"
msgid "Parfait ! On commence par quoi grand maître stalker ?"
msgstr "Perfekt! Wo wollen wir anfangen, großer Meisterstalker?"

#. Character:`kimochi` | Attributes:`frustrated`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_c7ef26d8"
msgid "Tchhh..."
msgstr "Tssss..."

#. Character:`kimochi`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_a49c597e"
msgid "On campe devant chez toi et on attend qu'elle bouge."
msgstr "Wir warten vor eurem Haus bis sie rauskommt."

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_e938a59f"
msgid "Pfff je n'arrive pas à trouver le sommeil."
msgstr "Ugh, ich kann einfach nicht einschlafen."

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "tc89ed41127"
msgid "Je me demande ce que fais {{saito.n}}... Ça aurait été sympa de passer la soirée ensemble."
msgstr "Ich frage mich, was {{saito.n}} gerade tut... Es wäre zu schön gewesen, den Abend mit ihm zu verbringen."

#. Character:`asami` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_cdaa8c85"
msgid "Est-ce que j'en profiterais pas pour aller me glisser dans le lit de mon petit poney ?"
msgstr "Sollte ich die Situation ausnutzen und ins Bett meines kleinen Ponys kriechen?"

#. Character:`asami` | Attributes:`surprised`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_db729cbb"
msgid "Oh ! Ça doit être lui !"
msgstr "Oh! Das muss er sein!"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_c8b37d8c"
msgid "J'espère que la situation avec {{noriko.n}} s'est enfin arrangée !"
msgstr "Ich hoffe, die Situation mit {{noriko.n}} hat sich endlich beruhigt!"

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "home_asami_asami_room_56f008bd"
msgid "J'ARRIVE !"
msgstr "ICH KOMME!"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "tccb49eb2f3"
msgid "Ma puce tu es l-"
msgstr "Schatz, du bist z-"

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "t0503cc3099"
msgid "...[w]Visiblement non."
msgstr "...[w] Offensichtlich nicht."

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "t2e0d710aad"
msgid "Elle du passer la nuit chez {{saito.n}}..."
msgstr "Sie muss die Nacht bei {{saito.n}} verbracht haben ..."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/home_asami_asami_room.dialogue
msgctxt "t3162f4c42d"
msgid "Est-ce qu'elle aurait enfin sautée le pas ?"
msgstr "Hat sie endlich den Sprung ins kalte Wasser gewagt?"

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "tc20b2cc87b"
msgid "Ils n'arrêtent jamais tous deux !"
msgstr "Die beiden hören nie auf!"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/home_asami_asami_room.dialogue
msgctxt "tb46d8c401d"
msgid "Ah c'est beau la jeunesse !"
msgstr "Ah, die Wunder der Jugend!"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "t6b2b1e6806"
msgid "Mais ça ne change rien, elle aurait au moins pu m'envoyer un message."
msgstr "Aber das spielt keine Rolle. Sie hätte mir zumindest eine Nachricht schicken können."

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "t895b00d3d4"
msgid "Pfff..."
msgstr "Tsss ..."

#. Character:`sayuri` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "QUE_S_EST_IL_PASS_49001F"
msgid "Que s'est-il passé ?"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "JE_SAIS_ENFIN_CE_QUE_MINATO_N_83FAF3"
msgid "Je sais enfin ce que {{minato.n}} pensait de moi..."
msgstr ""

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/home_asami_asami_room.dialogue
msgctxt "TU_VEUX_DIRE_QUE_TU_AS_R_USSI_CED0EA"
msgid "Tu veux dire que tu as réussi à prendre ton courage à deux mains et que tu es allée lui demander ?"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "NON_J_AI_W_DEMAND_AU_GAR_ON_D_D690E2"
msgid "...Non... J'ai...[w] demandé au garçon du parc d'y aller pour moi, car ils se connaissaient..."
msgstr ""

#. Character:`sayuri` | Attributes:`sad`
#: game/story/home_asami_asami_room.dialogue
msgctxt "OH_JE_VOIS_C_EST_48F3F7"
msgid "Oh, je vois... C'est-"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "S_IL_TE_PLA_T_NE_DIS_RIEN_CE_S_9E88E2"
msgid "S'il te plaît, ne dis rien à ce sujet !"
msgstr ""

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "OKAY_OKAY_A8A689"
msgid "Okay... Okay..."
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "J_TAIS_UN_PEU_PLUS_LOIN_JE_VOU_82CF0B"
msgid "J'étais un peu plus loin, je voulais écouter sa réponse."
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "IL_A_T_ABSOLUMENT_ODIEUX_48F77C"
msgid "Il a été absolument odieux."
msgstr ""

#. Character:`sayuri` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "QU_EST_CE_QUE_CE_PETIT_CON_A_O_0CDFEB"
msgid "Qu'est-ce que ce petit con a osé te dire ?!"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "IL_NE_ME_VOIT_PAS_DU_TOUT_COM_F0CA46"
msgid "... Il ne me voit pas du tout comme une femme, il me considère comme une gamine, une nuisance."
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "IL_A_M_ME_DEMAND_SAITO_N_DE_SO_A1EB14"
msgid "Il a même demandé à {{saito.n}} de sortir avec moi pour que j'arrête de traîner dans ses pattes."
msgstr ""

#. Character:`sayuri` | Attributes:`neutral`
#: game/story/home_asami_asami_room.dialogue
msgctxt "C_EST_LE_NOM_DU_GAR_ON_QUI_EST_F57636"
msgid "C'est le nom du garçon qui est allé demander pour toi ?"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "OUI_DFB8C5"
msgid "Oui..."
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "CELUI_DONT_TU_VOULAIS_LE_NUM_R_C53ACF"
msgid "Celui dont tu voulais le numéro !"
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "A_ME_CONFIRME_QUE_J_AVAIS_FAI_9D453F"
msgid "Ça me confirme que j'avais fait le bon choix depuis le début !"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "MAMAN_E3629B"
msgid "Maman !!!"
msgstr ""

#. Character:`sayuri` | Attributes:`moved`
#: game/story/home_asami_asami_room.dialogue
msgctxt "MA_PUCE_ON_A_D_J_DISCUT_DE_A_T_1A2431"
msgid "Ma puce... On a déjà discuté de ça tellement de fois, mais tu savais déjà au fond de toi que ce garçon n'éprouvait pas ce que toi tu ressentais pour lui."
msgstr ""

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "TU_TE_VOILAIS_LA_FACE_W_REGARD_8E4586"
msgid "Tu te voilais la face...[w] Regarde le positif à présent !"
msgstr ""

#. Character:`asami`
#: game/story/home_asami_asami_room.dialogue
msgctxt "TU_TROUVES_QU_IL_Y_A_DU_POSITI_EE3752"
msgid "Tu trouves qu'il y a du positif ?"
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "BIEN_S_R_D_J_TU_TE_D_BARRASSES_A08525"
msgid "Bien sûr ! Déjà, tu te débarrasses d'un garçon que tu connais depuis plus de 10 ans qui n'a aucune considération pour toi, et en échange, tu as quelqu'un que tu connais depuis quelques jours prêt à te soutenir."
msgstr ""

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "SI_A_C_EST_PAS_DU_POSITIF_89D384"
msgid "Si ça, c'est pas du positif !"
msgstr ""

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "JE_SUIS_GENTILLE_JE_VEUX_BIEN_792C95"
msgid "Je suis gentille, je veux bien te laisser {{saito.n}}, il a l'air bien plus fiable que l'autre enfoiré."
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "COMME_SI_TU_AVAIS_UNE_CHANCE_A_892AA2"
msgid "Comme si tu avais une chance avec lui !"
msgstr ""

#. Character:`sayuri`
#: game/story/home_asami_asami_room.dialogue
msgctxt "TU_VEUX_TENIR_LE_PARI_D283EE"
msgid "Tu veux tenir le pari ?"
msgstr ""

#. Character:`sayuri` | Attributes:`upset`
#: game/story/home_asami_asami_room.dialogue
msgctxt "CE_TYPE_NE_M_RITE_M_ME_PAS_QUE_0CFE40"
msgid "Ce type ne mérite même pas que tu l'appelles \"papa\"."
msgstr ""

#. Character:`sayuri` | Attributes:`moved`
#: game/story/home_asami_asami_room.dialogue
msgctxt "JE_PR_F_RE_TENTER_MA_CHANCE_AV_558C13"
msgid "Je préfère tenter ma chance avec ton nouvel ami !"
msgstr ""

#. Character:`asami` | Attributes:`pouting`
#: game/story/home_asami_asami_room.dialogue
msgctxt "NON_C_EST_BON_JE_L_AI_VU_LA_PR_5A7B2F"
msgid "Non, c'est bon, je l'ai vu la première !"
msgstr ""

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_asami_asami_room.dialogue
msgctxt "JE_CONSTATE_QUE_A_VA_MIEUX_3D329A"
msgid "Je constate que ça va mieux."
