msgstr ""

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_VOUS_LAISSER_DISCUTER_776738"
msgid "Je vais vous laisser discuter entre vous, je t'attends dans ta chambre..."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_C_EST_GR_CE_TOI_D_UNE_CERT_7F3FB5"
msgid "Oui... C'est grâce à toi d'une certaine manière."
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_N_AI_PAS_SOUVENIR_D_AVOIR_F_79E12D"
msgid "Je n'ai pas souvenir d'avoir fait grand-chose pourtant."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_POURTANT_JE_T_ASSURE_QUE_A_220365"
msgid "Et pourtant je t'assure que ça a fait une différence."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "MON_SALAIRE_N_A_PLUS_RIEN_VOIR_3DACA1"
msgid "Mon salaire n'a plus rien à voir avec ce qu'il était auparavant, c'est là que je me dis que j'ai été bien stupide de rester aussi longtemps travailler pour cette ordure."
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_CONTENT_QUE_LES_CHOSES_861D75"
msgid "Je suis content que les choses s'arrangent de ton côté, tu vas pouvoir respirer un peu plus."
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_IL_VA_FALLOIR_F_TER_A_F1CFC2"
msgid "Oui, il va falloir fêter ça !"
msgstr ""

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "AU_FAIT_O_SE_SITUE_TON_NOUVEAU_3C73CE"
msgid "Au fait... Où se situe ton nouveau travail ?"
msgstr ""

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "AU_ONSEN_EN_BORDURE_DE_LA_VILL_EFE964"
msgid "Au onsen, en bordure de la ville, c'est un endroit vraiment magnifique."
msgstr ""

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "FONT_SIZE_14_SAITO_N_QU_EST_C_D41583"
msgid "[font_size=14]{{saito.n}} Qu'est-ce que tu fais ?!![/font_size]"
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "D_SOL_62A799"
msgid "Désolé..."
msgstr ""

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "CE_N_EST_PAS_GRAVE_NE_LA_FAIS_61BD8A"
msgid "Ce n'est pas grave, ne la fais pas attendre !"
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "BONNE_SOIR_E_VOUS_DEUX_253F62"
msgid "Bonne soirée à vous deux !"
msgstr ""

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_85fe00c0"
msgid "Elle doit probablement être dans sa chambre..."
msgstr "Sie ist wahrscheinlich in ihrem Schlafzimmer..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2e0008bd"
msgid "Je te sers un thé ou autre chose ?"
msgstr "Soll ich dir einen Tee machen oder so?"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3d344136"
msgid "Non merci, ça ira..."
msgstr "Nein, danke. Mir geht’s gut..."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4efc3390"
msgid "Donc... Tu es donc la dernière personne à avoir parlé à {{saito.n}} hier soir..."
msgstr "Also... Du warst die letzte Person, die gestern Nacht mit {{saito.n}} geredet hat..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_de909dee"
msgid "Il y a quelque chose qui sortait de l'ordinaire ?"
msgstr "War irgendetwas anders als sonst?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6c24c501"
msgid "Était-il comme d'habitude ?"
msgstr "Hat er sich so wie immer verhalten?"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_49ed57e4"
msgid "... À vrai dire...[w] Je crois qu'il avait l'intention de mettre fin à notre relation."
msgstr "Tatsächlich...[w] Glaube ich, er wollte Schluss machen."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_39503e19"
msgid "... À vrai dire...[w] Je crois qu'il avait l'intention de mettre fin à notre amitié."
msgstr "Tatsächlich...[w] Glaube ich, er wollte unsere Freundschaft beenden."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_59bd2637"
msgid "Mais... Je me suis fâchée et je l'ai chassé de la maison avant qu'il ne puisse s'expliquer."
msgstr "Aber... Ich wurde wütend und habe ihn rausgeschmissen, bevor er sich erklären konnte."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_JE_SUIS_CERTAINE_QUE_TU_NE_3D83B3"
msgid "Oh... Je suis certaine que tu ne le pensais pas."
msgstr ""

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_TAIS_VRAIMENT_FACH_E_TOUT_SE_DF5D72"
msgid "J'étais vraiment fâchée... tout se passait bien et tout a changé soudainement !"
msgstr ""

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_NE_COMPREND_VRAIMENT_PAS_CE_EDDDF9"
msgid "Je ne comprends vraiment pas ce qui lui est passé par la tête."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_365c29ac"
msgid "[font_size=14]Donc toi aussi...[/font_size]"
msgstr "[font_size=14]Bei dir also auch...[/font_size]"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_18318dad"
msgid "Vous avez dit quelque chose ?"
msgstr "Hast du was gesagt?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_83ce23e6"
msgid "Non non, je marmonnais, n'y fais pas attention."
msgstr "Nein, nein. Ich habe nur vor mich hin geredet. Vergiss es einfach."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_faafc679"
msgid "Avant de partir de la maison hier soir... Il semblait préoccupé."
msgstr "Bevor er gestern Nacht das Haus verlassen hat... schien er irgendwie sehr... beschäftigt zu sein."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fb0b492c"
msgid "D'où ma suggestion qu'il avait probablement des ennuis."
msgstr "Das bedeutet, dass er wahrscheinlich in Schwierigkeiten steckte."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_906c03bb"
msgid "Je... Je ne sais pas trop quoi en penser."
msgstr "Ich... Ich weiß nicht, was ich von all dem halten soll."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_22f0d850"
msgid "Ça ne fait qu'une journée."
msgstr "Es ist gerade mal einen Tag her."

#. Character:`asami` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c45226e2"
msgid "Peut-être est-il avec quelqu'un d'autre ?"
msgstr "Vielleicht ist er bei jemand anderem?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3d5f8dae"
msgid "Et la fille en kimono ?"
msgstr "Und was ist mit dem Mädchen in dem Kimono?"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_de3d0ba3"
msgid "Comment ça la fille en kimono ? Elle est venue chez vous aussi ?"
msgstr "Was meinst du, das Mädchen in dem Kimono? Ist sie auch bei dir zu Hause gewesen?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "SAKUYA_N_MAIS_POURQUOI_EN_AUR_CFCEE3"
msgid "{{sakuya.n}} ? Mais pourquoi en aurait-elle après {{saito.n}}, ils travaillent ensemble tous les deux..."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "CA_N_A_PAS_DE_SENS_8075B2"
msgid "Ça n'a pas de sens."
msgstr ""

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_707592dd"
msgid "Oh, mais oui, je l'avais oubliée, elle traînait souvent autour de la maison."
msgstr "Oh ja, ich habe sie total vergessen. Sie hat viel Zeit in der Nähe des Hauses verbracht."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7b95dc3b"
msgid "Vous pensez qu'elle a un lien dans la disparition de {{saito.n}} ?"
msgstr "Glaubst du, sie hat etwas mit {{saito.n}}s Verschwinden zu tun?"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9ccb3876"
msgid "Il serait parti pour une autre femme ?"
msgstr "Hätte er sich wegen einer anderen Frau aus dem Staub gemacht?"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_aeb5c3a9"
msgid "... Je ne sais pas, je pense que le mieux serait de discuter avec cette fille."
msgstr "...Ich weiß nicht. Ich glaube, es wäre am besten, wenn wir uns mal mit diesem Mädchen unterhalten würden."

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7231df1d"
msgid "..."
msgstr "..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a43a6be3"
msgid "{{asami.n}}, je suis certaine que {{saito.n}} t'aime de tout son cœur, et jamais il n'aurait agi ainsi sans avoir de raison valable."
msgstr "{{asami.n}}, ich bin mir sicher, dass dich {{saito.n}} von ganzem Herzen liebt und sich niemals grundlos so verhalten würde."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dac1642b"
msgid "{{asami.n}}, je suis certaine que {{saito.n}} ne pensait pas du tout ce qu'il t'a dit... Il l'a sûrement fait pour une bonne raison."
msgstr "{{asami.n}}, ich bin mir sicher, dass {{saito.n}} das, was er gesagt hat, nicht so gemeint hat... Er hat es vermutlich aus einem bestimmten Grund getan."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_45c268fd"
msgid "Vous croyez ?"
msgstr "Glaubst du?"

#. Character:`yasuka` | Attributes:`happy,blush`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b7c124b3"
msgid "J'en suis certaine !"
msgstr "Ich bin mir sicher!"

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "TR_S_BIEN_IL_NE_RESTE_QU_ALLER_7F5507"
msgid "Très bien, il ne reste qu'à aller voir cette sal-... cette fille !"
msgstr ""

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5e84599c"
msgid "Je l'accompagnerai !"
msgstr "Ich komme mit!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d4a1cdae"
msgid "Tu es sûre ma chérie ?"
msgstr "Bist du dir sicher, Süße?"

#. Character:`noriko` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c41c3e98"
msgid "Certaine !"
msgstr "Absolut!"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0a9b12e1"
msgid "Ne perdons pas de temps."
msgstr "Lass uns keine Zeit verlieren."

#. Character:`asami` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_921f8009"
msgid "Quoi, maintenant ? Là tout de suite ?"
msgstr "Was? Jetzt?"

#. Character:`noriko` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_675c152d"
msgid "Tu préfères attendre ?"
msgstr "Worauf willst du denn noch warten?"

#. Character:`asami` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b8938434"
msgid "Non, tu as raison."
msgstr "Nein. Du hast ja Recht."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b482dfc3"
msgid "Tenez-moi au courant... Je suis vraiment inquiète..."
msgstr "Halt mich auf dem Laufenden... Ich mache mir wirklich Sorgen..."

#. Character:`asami` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6b74626c"
msgid "C'est promis !"
msgstr "Verprechen wir!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "BONSOIR_MON_CH_RI_TOUT_VA_BIEN_CB7E6A"
msgid "Bonsoir mon chéri, tout va bien ?"
msgstr "Guten Abend, Darling. Alles in Ordnung?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_ON_NE_PEUT_MIEUX_796137"
msgid "Oui, on ne peut mieux."
msgstr "Ja, könnte nicht besser sein."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_R_GL_CERTAINS_PROBL_MES_E_6C6A79"
msgid "J'ai réglé certains problèmes et je me sens tout à coup bien plus léger."
msgstr "Ich habe ein paar Probleme aussortiert und fühle mich gleich viel besser."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_CONTENTE_POUR_TOI_DB0600"
msgid "Je suis contente pour toi..."
msgstr "Das freut mich für dich ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "AU_FAIT_JE_SAIS_QUE_NORIKO_N_S_03A1DB"
msgid "Au fait... Je sais que {{noriko.n}} à souvent parlé de ton histoirque web par le passé et..."
msgstr "Übrigens ... Ich weiß, dass {{noriko.n}} früher oft mit deinem Browserverlauf ankam und ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_NON_ENCORE_62F0BB"
msgid "Oh non encore ?"
msgstr "Oh nein, schon wieder?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "NE_T_INQUI_TE_PAS_EN_FAIT_J_AI_F005D1"
msgid "Ne t'inquiète pas, en fait... J'aimerais essayer avec toi ce soir..."
msgstr "Keine Sorge. Ehrlich gesagt ... Würde ich es gerne mit dir heute Nacht ausprobieren ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ESSAYER_C_EST_DIRE_TU_VEUX_DIR_66ADE3"
msgid "Essayer c'est dire... tu veux dire..."
msgstr "Wenn du „ausprobieren“ sagst ... meinst du ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_JE_SUIS_CURIEUSE_ET_J_AI_E_6826D2"
msgid "Oui, je suis curieuse et j'ai envie de le faire avec toi."
msgstr "Ja, ich bin neugierig und will das mit dir machen."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_PARLES_BIEN_DE_CE_QUE_JE_SU_993902"
msgid "Tu parles bien de ce que je suis en train de penser ?"
msgstr "Denkst du wirklich an das, woran ich gerade denke?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_MON_CH_RI_JE_PARLE_BIEN_DE_75AF9E"
msgid "Oui mon chéri, je parle bien de \"ça\"."
msgstr "Ja, Liebling, ich rede definitiv „darüber“."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_PASSERAI_ME_GLISSER_DANS_TO_FBA5B9"
msgid "Je passerai me glisser dans ton lit cette nuit quand {{noriko.n}} dormira profondément."
msgstr "Ich schlüpfe heute Nacht in dein Bett, wenn {{noriko.n}} schläft."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_J_AI_D_J_HATE_D_Y_TRE_7B9057"
msgid "J'ai... j'ai déjà hate d'y être !"
msgstr "Ich ... Ich kann’s kaum erwarten!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "NORIKO_N_NORIKO_N_6460BC"
msgid "{{noriko.n}} ! {{noriko.n}} !!"
msgstr "{{noriko.n}}! {{noriko.n}}!"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "CALME_TOI_JE_SUIS_CERTAINE_QU_D3B5DE"
msgid "Calme-toi, je suis certaine qu'elle va bien, elle doit être dans sa chambre."
msgstr "Beruhig dich. Ich bin mir sicher, ihr geht’s gut. Sie ist wahrscheinlich in ihrem Zimmer."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_M_EN_ASSURER_AFAFBC"
msgid "Je vais m'en assurer !"
msgstr "Ich muss sichergehen!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "ELLE_N_EST_PAS_L_8F70D0"
msgid "Elle n'est pas là ?"
msgstr "Sie ist nicht hier?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ASAMI_N_ED5AC0"
msgid "{{asami.n}} ?"
msgstr "{{asami.n}}?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_NON_NON_W_MERDE_13DEF7"
msgid "Non, non, non...[w] Merde !"
msgstr "Nein, nein, nein ... [w]Fuck!"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "t3e699fa5c9"
msgid "Je ne ferais pas ça à ta place !"
msgstr "Ich würde das nicht tun, wenn ich du wäre!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c320b570"
msgid "... et toi, ta journée s'est bien passée ?"
msgstr "...Und, hattest du einen schönen Tag?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_088567f7"
msgid "Oui c'était génial, j'ai passé la journée avec {{asami.n}}."
msgstr "Ja, er war wunderbar! Ich habe den Tag mit {{asami.n}} verbracht."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bf463289"
msgid "Je suis contente pour toi ma chérie, cette fille est adorable."
msgstr "Ich freue mich für dich, meine Liebe. Dieses Mädchen ist wirklich liebenswert."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_759bad8b"
msgid "Je suis sûre qu'elle aura une bonne influence sur toi."
msgstr "Ich bin mir sicher, dass sie ein guter Einfluss auf dich sein wird."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_89040705"
msgid "Tu dis ça comme si j'étais une délinquante..."
msgstr "Du sagst das so, als wäre ich eine Kriminelle..."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4cce02f4"
msgid "Avoue que tu n'as pas toujours été facile, je me trompe ?"
msgstr "Du musst aber zugeben, dass du nicht immer ganz einfach zu handhaben warst?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_eedf9fba"
msgid "... Je vais dans ma chambre !"
msgstr "...Ich gehe auf mein Zimmer!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_02628536"
msgid "Ahlala..."
msgstr "Och, Liebling..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_649ac2b9"
msgid "Ça va merci... Est-ce que {{noriko.n}} est levée ?"
msgstr "Mir geht’s gut, danke... Ist {{noriko.n}} schon aufgestanden?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b8099094"
msgid "Pour une fois elle était levée avant toi."
msgstr "Sie heute tatsächlich ausnahmsweise mal vor dir wach."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6e116a1d"
msgid "Elle a pris son argent de poche et est partie tôt ce matin."
msgstr "Sie hat ihr Taschengeld genommen und ist heute in aller Frühe gegangen."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5856191c"
msgid "Elle est déjà partie ?"
msgstr "Sie ist schon weg?"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6f2f17e4"
msgid "Oui pourquoi, est-ce qu'il y a un problème ?"
msgstr "Ja, warum? Ist das ein Problem?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_27601264"
msgid "Non non, j'essaierai de la rattraper. Tu sais où elle allait ?"
msgstr "Nein, nein. Ich versuche, sie einzuholen. Hast du eine Ahnung, wo sie hingehen wollte?"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8837d170"
msgid "Elle a dit qu'elle rejoignait {{asami.n}} en ville pour une journée shopping avec elle."
msgstr "Sie sagte, sie würde sich mit {{asami.n}} zum Shoppen in der Stadt treffen."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_50213d89"
msgid "Bordel, la voilà qui recommence ses magouilles."
msgstr "Verdammt, was hat sie nur vor?"

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_59fbc03a"
msgid "Qu'est-ce qu'elle est en train de préparer ?"
msgstr "Woran arbeitet sie jetzt?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_65cb155f"
msgid "Bonjour mon chéri !"
msgstr "Hallo, mein Schatz!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7345d539"
msgid "Tout se passe bien avec {{noriko.n}} ?"
msgstr "Ist alles gut mit {{noriko.n}}?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f99847aa"
msgid "J'y travaille et je pense que nous verrons bientôt {{noriko.n}} sourire de nouveau."
msgstr "Ich arbeite daran, aber ich denke, dass wir {{noriko.n}} bald wieder lachen sehen können."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e2f6123a"
msgid "Je savais bien que je pouvais compter sur toi."
msgstr "Ich wusste, dass ich auf dich zählen kann."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dba3bf28"
msgid "Mais fais attention à toi, ne crois pas pas que je ne vois pas tous ces bleus sur ton corps."
msgstr "Aber pass auf dich auf. Glaub ja nicht, mir wären all die blauen Flecken an deinem Körper nicht aufgefallen."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7a23d7d2"
msgid "Juste... sois prudent !"
msgstr "Sei... sei einfach vorsichtig!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_35f30c10"
msgid "Je le serai !"
msgstr "Das werde ich!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3f9b63ba"
msgid "..."
msgstr "..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2bb6599a"
msgid "Mon chéri... {{noriko.n}} a quitté la maison."
msgstr "Liebling... {{noriko.n}} ist schon gegangen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0ecaa08f"
msgid "On s'est disputées et elle est partie en claquant la porte."
msgstr "Wir hatten einen Streit, dann ist sie hinausgestürmt."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2cdfeb91"
msgid "Partie ?! Depuis combien de temps ?"
msgstr "Gegangen?! Wie lange ist das her?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7ccc98fa"
msgid "Il y a plusieurs dizaines de minutes, je n'ai pas pu la retenir."
msgstr "Bestimmt schon ein paar Minuten... Vielleicht eine halbe Stunde? Ich konnte sie nicht aufhalten."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_18169932"
msgid "Elle était dans ta chambre avec... ce garçon, il avait les cheveux longs."
msgstr "Sie war in deinem Zimmer zusammen mit... diesem Jungen, dem mit langen Haaren."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f985c24e"
msgid "Je m'en veux tellement si tu savais... mais il avait l'air si..."
msgstr "Ich fühle mich so schuldig, du hast ja keine Ahnung... Aber er sah so..."

#. Character:`saito` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_63a00d52"
msgid "{{akira.n}} ! Non tu as bien réagi, ce type est un psychopathe."
msgstr "{{akira.n}}! Nein, du hast das Richtige getan. Der Typ ist ein totaler Psychopath."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bc15dea5"
msgid "Je vais la retrouver, il ne lui arrivera rien."
msgstr "Ich werde sie finden. Ihr wird nichts passieren."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_69d82c4d"
msgid "Tu as une idée de l'endroit où elle pourrait être allée ?"
msgstr "Hast du irgendeine Ahnung, wo sie vielleicht hingegangen sein könnten?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_74b78344"
msgid "Je crois qu'il a parlé d'un hôtel en centre-ville..."
msgstr "Ich glaube, er sprach von einem Hotel in der Stadt..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5185bb71"
msgid "C'est probablement le love hotel !"
msgstr "Er meint wahrscheinlich das Stundenhotel!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5f0d4639"
msgid "Je t'en prie, empêche {{noriko.n}} de faire quelque chose qu'elle pourrait regretter !"
msgstr "Bitte, halt {{noriko.n}} auf, bevor sie etwas tut, was sie später bereuen wird!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_106ea3e2"
msgid "Et fais attention à toi surtout, je ne supporterais pas s'il t'arrivait quelque chose à toi aussi."
msgstr "Und sei besonders vorsichtig. Ich könnte es nicht ertragen, wenn dir etwas zustoßen würde."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5b475c98"
msgid "Tout ira bien, je ne suis plus le même qu'avant."
msgstr "Es wird alles gut. Ich bin nicht dieselbe Person, die ich früher war."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_15500ec7"
msgid "{{noriko.n}} ma chérie, je suis tellement désolée..."
msgstr "{{noriko.n}}, meine Liebe, es tut mir so leid..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4cafc087"
msgid "Je suis si heureuse que tu ailles bien."
msgstr "Ich bin so froh, dass es dir gut geht."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dc66d931"
msgid "Mais... vous rentrez ensemble ?!"
msgstr "Aber... vertragt ihr euch wieder?!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ba7acfca"
msgid "Oui maman ne t'inquiète plus, {{saito.n}} et moi avons enfin fait la paix."
msgstr "Ja, Mama! Keine Sorge. {{saito.n}} und ich haben endlich Frieden geschlossen."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b4839780"
msgid "Je suis désolée d'avoir été aussi odieuse pendant toutes ces années."
msgstr "Es tut mir leid, dass ich all die Jahre so anstrengend war."

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_60eab4e4"
msgid "Mais... à partir d'aujourd'hui c'est terminé, tu vas retrouver la {{noriko.n}} qui souriait comme avant."
msgstr "Aber... ab heute ist das vorbei. Ihr werdet wieder die {{noriko.n}} zurückhaben, die lachen kann; so wie früher."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ac77c436"
msgid "Mon dieu mes chéris... Je suis tellement heureuse !"
msgstr "Mein Gott, meine Lieben... Ich bin so glücklich!"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5187485a"
msgid "Je me moque de savoir comment tout ça s'est produit... Ce qui m'intéresse maintenant c'est de savoir qu'on va pouvoir se serrer les coudes comme une vraie famille !"
msgstr "Mir ist egal, wie all das passieren konnte... Alles, was mich gerade interessiert ist, dass wir endlich zusammenhalten können wie eine richtige Familie!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ea13cfe7"
msgid "Il faut fêter ça !"
msgstr "Das müssen wir feiern!"

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bb6dbf5d"
msgid "Quoi ?! Là ? Maintenant ? Tout de suite ?"
msgstr "Was?! Jetzt? Sofort?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f987f274"
msgid "Ne sois pas rabat-joie, chaque bonne nouvelle devrait pouvoir être fêtée !"
msgstr "Sei kein Spaßverderber! Alle guten Neuigkeiten sollten gefeiert werden!"

#. Character:`noriko` | Attributes:`bad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_47c426f7"
msgid "Exactement {{saito.n}} ne sois pas rabat-joie !"
msgstr "Genau, {{saito.n}}! Sei kein Spaßverderber!"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_98b97b5c"
msgid "C'est bon j'ai compris..."
msgstr "Schon okay, ich hab’s verstanden..."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cd1e30cc"
msgid "Je vais chercher quelque chose au konbini ?"
msgstr "Soll ich etwas aus dem Supermarkt holen?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_25eec42f"
msgid "Non surtout pas, j'y vais ! Vous avez probablement plein de choses à vous dire et à rattraper."
msgstr "Nein, kein Bedarf! Ihr habt bestimmt eine Menge zu bereden und verpasste Zeit aufzuholen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d12e7a0b"
msgid "Attendez-moi à la maison, je ne devrais pas en avoir pour plus d'une heure !"
msgstr "Wartet hier auf mich. Es sollte nicht länger als eine Stunde dauern!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_29cd7803_2"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_03775ec8_3"
msgid "..."
msgstr "..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1121ed67"
msgid "C'est étrange de se retrouver ainsi devant la télé, comme si rien ne s'était jamais produit."
msgstr "Es ist eigenartig, dass wir hier jetzt vor dem Fernseher sitzen, als wäre nichts passiert."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_41628bc6"
msgid "C'est probablement la première fois depuis des années que {{yasuka.n}} a été aussi heureuse."
msgstr "Das ist vermutlich das erste Mal seit Jahren, dass {{yasuka.n}} so glücklich ist."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_20d79a6b"
msgid "À ce propos...[w] Tu as vraiment couché avec elle ?"
msgstr "Apropos...[w] Hast du wirklich mit ihr geschlafen?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t7f573ad0d6"
msgid "Ca fait combien de temps que tu couchais avec elle ?"
msgstr "Wie lange schläfst du schon mit ihr?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d6516fa2"
msgid "Euh..."
msgstr "Ähm ..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_de0fb819"
msgid "Je ne suis pas idiote...[w] Tu crois que je ne vous ai pas entendus la nuit dans ta chambre ?"
msgstr "Ich bin nicht dumm...[w] Glaubst du ich hätte euch in der Nacht oder in deinem Zimmer nicht gehört?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1382305a"
msgid "Si tu le savais, pourquoi me le demander ?"
msgstr "Wenn du es schon weißt, warum fragst du dann noch?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_88e97b98"
msgid "... Je voulais l'entendre de ta bouche."
msgstr "...Ich wollte es aus deinem Mund hören."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6f2a9f74"
msgid "... Oui, c'est arrivé plusieurs fois."
msgstr "...Ja, wir haben es mehrfach getan."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t6dfe63f33a"
msgid "Pauvre {{asami.n}}..."
msgstr "Arme {{asami.n}}..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t79344e5734"
msgid "Pourquoi tu dis ça ?"
msgstr "Warum sagst du das?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t9111b5deb3"
msgid "...[w]Pour rien, t'es un cas désespéré."
msgstr "...[w]Nichts, du bist ein hoffnungsloser Fall."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1fe8d940"
msgid "Et {{asami.n}} est au courant ?"
msgstr "Und weiß {{asami.n}} davon?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_766c09de"
msgid "... Oui, aussi."
msgstr "...Ja, sie auch."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_83ddc671"
msgid "Sérieux ?! Et elle laisse faire ?"
msgstr "Im Ernst?! Und sie hindert dich nicht daran?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d04df73b"
msgid "Aussi incroyable que ça puisse paraître, oui."
msgstr "So unglaublich es auch scheinen mag, ja."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e44de8d1"
msgid "Et je pense qu'en écoutant {{yasuka.n}} lui expliquer la raison pour laquelle on en est arrivés là..."
msgstr "Und ich denke, weil ich {{yasuka.n}} zugehört habe, sind wir überhaupt erst in dieser Situation gelandet..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d6dcdb2c"
msgid "Elle s'est probablement mise à sa place."
msgstr "Sie hat sich vermutlich in ihre Lage hineinversetzen können."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "CA_FAIT_DU_BIEN_DE_LA_VOIR_SE_B9403C"
msgid "Ca fait du bien de la voir se réjouir comme ça."
msgstr ""

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_4141febb"
msgid "Et l'autre folle ?"
msgstr "Und die andere Verrückte?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9ed39083"
msgid "{{sakuya.n}} ? Elle n'est pas folle..."
msgstr "{{sakuya.n}}? Die ist nicht verrückt..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_81db9706"
msgid "Elle est juste... très passionnée."
msgstr "Die ist nur... sehr leidenschaftlich."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_79c16a7e"
msgid "Si tu le dis..."
msgstr "Wenn du das sagst ..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d4119381"
msgid "Et moi ?"
msgstr "Und ich?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_8cace5a2"
msgid "Comment ça, toi ?"
msgstr "Was meinst du damit?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_562b59b4"
msgid "C'était comment de... coucher avec moi ?"
msgstr "Wie war es so... mit mir zu schlafen?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f1868cc7"
msgid "Est-ce vraiment une conversation que tu veux avoir ?"
msgstr "Willst du diese Unterhaltung wirklich führen?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3a9562a6"
msgid "Je veux savoir. Tu couches avec toutes les femmes autour de toi !"
msgstr "Ich will es wissen. Du schläfst mit jeder Frau in deinem Umfeld!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_027edc6f"
msgid "Ne me dis pas que tu couches aussi avec la mère d'{{asami.n}} ?"
msgstr "Sag mir nicht, dass du auch mit {{asami.n}}s Mutter geschlafen hast?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2e0b7461"
msgid "Quoi ?! Non, bien sûr que non !"
msgstr "Was?! Nein, natürlich nicht!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_0fb7578a"
msgid "C'est elle la prochaine, c'est ça ?"
msgstr "Ist sie die nächste?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a30a6352"
msgid "T'es folle..."
msgstr "Du bist verrückt..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ead573fb"
msgid "Laisse tomber. De toute façon, c'était une erreur."
msgstr "Vergiss es. Wie auch immer, es war ein Fehler."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6a35066c"
msgid "Oh, que oui !"
msgstr "Oh ja, das war es!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_65d0f4dd"
msgid "Toi et moi, ça ne se reproduira plus."
msgstr "Du und ich... Das wird nicht nochmal passieren."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_336e9fd5"
msgid "Entièrement d'accord."
msgstr "Da stimme ich dir zu."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_89529c4b"
msgid "En plus, ce n'était pas si agréable que ça."
msgstr "Abgesehen davon war es ohnehin nicht so gut."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c63d9825"
msgid "Pff, tu crois que tu t'es mieux débrouillé ?"
msgstr "Pfff, glaubst du wirklich, du hast dich besser angestellt?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_525a2e1e"
msgid "...[w] Oui."
msgstr "...[w]Ja."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_9cbd998e"
msgid "Ah, tu veux jouer à ça !"
msgstr "Ah, willst du also dieses Spiel spielen?!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_34664b90"
msgid "À poil et plus vite que ça !"
msgstr "Zieh dich aus und beeil dich!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a6dc6e8a"
msgid "Hein !?"
msgstr "Was?!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_14b8c502"
msgid "Wow doucement..."
msgstr "Wow, komm runter..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b6558012"
msgid "Mmhhh laisse-moi faire... mhhhhh mhhh"
msgstr "Hmmm, lass mich führen... Hmmm, mmhh..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_616c661b"
msgid "{{yasuka.n}} pourrait rentrer à tout moment !"
msgstr "{{yasuka.n}} könnte jederzeit zurückkommen!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_a6d5d579"
msgid "... m'en fiche !"
msgstr "...mir egal!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_11b72ba3"
msgid "Je... ça fait longtemps... peut-être qu'il faudrait que..."
msgstr "Ich... es ist schon ein Weilchen her... Vielleicht sollten wir..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_3e50ca57"
msgid "Qu'on arrête ?"
msgstr "Aufhören?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_1ca04ffe"
msgid "Mais j'ai pas envie !"
msgstr "Ich will nicht!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b883ebf2"
msgid "Ça tombe bien moi non plus."
msgstr "Perfekt, ich nämlich auch nicht."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f2773e9a"
msgid "Aaaah... aaaah"
msgstr "Aaaah...aaaah"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b3b34de5"
msgid "Ne t'arrête pas !"
msgstr "Hör nicht auf!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5609c0c6"
msgid "Mmmmmh ouiiii !"
msgstr "Hmmmm, jaaaa!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f946afbe"
msgid "Oh mon dieu c'est trop bon !"
msgstr "Oh mein Gott, das ist so gut!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_51d1b869"
msgid "Dis... Tu crois qu'on pourrait... essayer... ça ?"
msgstr "Hey... Meinst du, wir könnten... du weißt schon was... probieren?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c9a4bcd3"
msgid "Tu veux dire..."
msgstr "Du meinst..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5ead300c"
msgid "{{asami.n}} m'a dit que c'était pas si mal au final..."
msgstr "{{asami.n}} hat mir gesagt, dass es gar nicht so übel sein soll..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "t9b2146bda9"
msgid "Ne m'oblige pas à le dire... Tu sais très bien de quoi je veux parler."
msgstr "Zwing mich nicht, es auszusprechen... Du weißt genau, wovon ich rede."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f01df574"
msgid "Okay !"
msgstr "Okay!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2b66c7c0"
msgid "Oh la vache c'est..."
msgstr "Oh mein... das ist..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_216311fa"
msgid "C'est..."
msgstr "Das ist ..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ffa56726"
msgid "Surprenant..."
msgstr "Überraschend..."

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c05cd9f7"
msgid "Tu as l'air vraiment inquiète."
msgstr "Du siehst wirklich besorgt aus."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2af0ec69"
msgid "Mon chéri..."
msgstr "Süßer..."

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f7e4d9b1"
msgid "[font_size=14]NON MAIS CA VA PAS LA TÊTE ?![/font_size]"
msgstr "[font_size=14]WAS ZUR HÖLLE IST FALSCH MIT DIR?![/font_size]"

#. Character:`asami`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ef2765d9"
msgid "[font_size=14]COMMENT TU PEUX METTRE QUELQU'UN EN DANGER COMME CA ?[/font_size]"
msgstr "[font_size=14]WIE KANNST DU JEMANDEN SO IN GEFAHR BRINGEN?[/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_dfd1856d"
msgid "...Me dis pas qu'elles..."
msgstr "...Sag mir nicht, dass sie..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e9da8b43"
msgid "Si... Elle se disputent depuis qu'elles sont arrivées."
msgstr "Doch... Sie haben gestritten seitdem sie da waren."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_d1de9ee2"
msgid "[font_size=14]JE SAIS CE QUE JE FAIS ![/font_size]"
msgstr "[font_size=14]ICH WEIẞ, WAS ICH TUE![/font_size]"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_90deb909"
msgid "[font_size=14]IL A BESOIN DE CA ![/font_size]"
msgstr "[font_size=14]ER BRAUCHT DAS![/font_size]"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fde9fbab"
msgid "Je n'ose pas y aller, ça me fait mal de les voir comme ça alors qu'elles s'appréciaient tellement."
msgstr "Ich wage es nicht, zu gehen. Es tut mir so weh, sie so zu sehen, wo sie sich doch sonst so gemocht haben."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_07f37322"
msgid "De plus je crois que tu es le sujet de leur dispute..."
msgstr "Noch dazu glaube ich, dass du es bist, um den sie sich streiten..."

#. Character:`saito` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2fd7763f"
msgid "Ne t'en fais pas je vais m'en occuper."
msgstr "Keine Sorge, ich kümmere mich darum."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ae713cd0_4"
msgid "..."
msgstr "..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_fc8becd8"
msgid "{{noriko.n}} ?"
msgstr "{{noriko.n}}?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_cc8b750d"
msgid "[font_size=14]Rejoins moi ![/font_size]"
msgstr "[font_size=14]Kommt her![/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_51b4dc79"
msgid "Je veux bien mais où es-tu ?"
msgstr "In Ordnung, aber wo bist du?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_98127c6a"
msgid "[font_size=14]Dans la chambre de maman ![/font_size]"
msgstr "[font_size=14]In Mamas Schlafzimmer![/font_size]"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_6cd29357"
msgid "Oh... Je le sens mal."
msgstr "Oh... Ich habe da ein schlechtes Gefühl."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_5e0b7b17"
msgid "Zut zut zut ! Si elle me voit ici je vais avoir des problèmes !"
msgstr "Nein, nein, nein! Ich werde in Schwierigkeiten geraten, wenn sie mich hier findet!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_605e7591"
msgid "[font_size=14]Bonsoir mon chéri... {{noriko.n}} n'est pas avec toi ?[/font_size]"
msgstr "[font_size=14]Guten Abend, Süßer... Ist {{noriko.n}} bei dir?[/font_size]"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_ac02c3f0"
msgid "Allez {{saito.n}}... Peu importe ce que tu veux faire mais empêche-la de rentrer dans la chambre !"
msgstr "Komm schon, {{saito.n}}... Egal, was du machst, halt sie einfach aus dem Zimmer raus!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_2eef2eff"
msgid "[font_size=14]Non... Je crois qu'elle était fatiguée[/font_size]"
msgstr "[font_size=14]Nein... Ich glaube, sie war müde.[/font_size]"

#. Character:`noriko` | Attributes:`cute`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_f1bd8145"
msgid "Oui c'est bien ça comme excuse, c'est crédible, elle ne viendra pas vérifier !"
msgstr "Ja, das ist eine gute Entschuldigung. Das ist glaubhaft, also wird sie nicht herkommen, um nachzusehen!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_81a86cad"
msgid "[font_size=14]Tu ne devais pas travailler au club ce soir ?[/font_size]"
msgstr "[font_size=14]Solltest du nicht eigentlich heute Abend im Klub arbeiten?[/font_size]"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_41a10d77"
msgid "[font_size=14]Si... mais finalement j'ai pu rentrer, problème de livraison d'alcool.[/font_size]"
msgstr "[font_size=14]Ja... aber am Ende konnte ich doch hierherkommen. Wir hatten ein paar Probleme mit der Alkohollieferung.[/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_bb80618f"
msgid "[font_size=14]Le problème à la boutique est réglé ?[/font_size]"
msgstr "[font_size=14]Ist das Problem mit dem Laden gelöst?[/font_size]"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_e7785f83"
msgid "[font_size=14]Une petite fuite d'eau, c'est bon à présent ![/font_size]"
msgstr "[font_size=14]Es war ein kleines Wasserleck, aber jetzt ist alles wieder in Ordnung![/font_size]"

#. Character:`noriko` | Attributes:`angry`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_c5b6905f"
msgid "Allez ailleurs bon sang ! Je ne peux pas sortir si vous restez tous les deux dans le salon !"
msgstr "Geht woanders hin, verdammt! Ich kann nicht verschwinden, wenn ihr zwei im Wohnzimmer bleibt!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_PUIS_E_JE_VAIS_ALLER_M_D7A386"
msgid "Je suis épuisée, je vais aller me coucher tout de suite."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_412c8af5"
msgid "[font_size=14]Étant donné que {{noriko.n}} est déjà en train de dormir... Et que tu es déjà dans la bonne tenue... Il ne te reste plus qu'à venir avec moi ![/font_size]"
msgstr "[font_size=14]Weil doch {{noriko.n}} schon schläft... Und du schon im passenden Outfit bist... Musst du einfach nur mit mir mitkommen![/font_size]"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_7f815e7f"
msgid "Euh oui mais.... At-"
msgstr "Ähm, ja, aber... Wart-"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_b7f70ad9"
msgid "Non non non non non!"
msgstr "Nein nein nein nein nein!"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "home_player_livingroom_df9f0303"
msgid "Une cachette vite !"
msgstr "Ein Versteck, schnell!"

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "tbae4d5efc7"
msgid "...Il est vraiment reparti comme ça... Sans prévenir ?"
msgstr "... Ist er wirklich einfach so abgehauen ... Ohne Vorwarnung?"

#. Character:`sayuri` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "t71128971aa"
msgid "Ah toi aussi ça te choque, je ne suis pas folle, c'est..."
msgstr "Ah, du bist auch überrascht? Also bin ich nicht verrückt, sondern ..."

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t94d5259211"
msgid "Oh bonjour {{saito.n}} !"
msgstr "Oh, hallo, {{saito.n}}!"

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "te2186388a4"
msgid "Désolé mon chéri, on t'a réveillé ?"
msgstr "Entschuldigung, Liebling, haben wir dich aufgeweckt?"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t102709a3a7"
msgid "Non non, j'allais juste courir au parc."
msgstr "Nein, nein, ich wollte nur eine Runde im Park laufen gehen."

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "t16525fde98"
msgid "Toutefois je suis surpris que vous vous connaissiez ?"
msgstr "Ich bin allerdings überrascht, dass ihr euch kennt."

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "t4595aa5678"
msgid "{{yasuka.n}} est une amie de longue date, on s'est un peu perdues de vue avec le temps, mais le fait que tu sois proche de ma fille a permis de nous rapprocher de nouveau."
msgstr "{{yasuka.n}} ist eine alte Freundin. Wir haben im Laufe der Zeit ein wenig den Kontakt verloren, aber die Tatsache, dass du meiner Tochter so nahestehst, hat uns auch wieder nähergebracht."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t0f71f4bd02"
msgid "Je suis content pour vous deux dans ce cas."
msgstr "Dann freue ich mich für euch beide."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t69685c5056"
msgid "Je vous laisse continuer votre discussion, vous avez sûrement un millier de choses à vous raconter, ne faites pas attention à moi."
msgstr "Ich werde euch bei eurer Unterhaltung dann nicht weiter stören. Es gibt wahrscheinlich noch tausend Dinge, die ihr euch erzählen müsst, also lasst euch von mir bitte nicht aufhalten."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb222c41a00"
msgid "Tu es un amour !"
msgstr "Du bist ein Schatz!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "td7fe5968d7"
msgid "A plus tard."
msgstr "Bis später."

#. Character:`sayuri` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "t72b23f76d7"
msgid "Bon vous avez fini vos secrets tous les deux ?"
msgstr "Also, habt ihr zwei genug aus dem Nähkästchen geplaudert?"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "t4c05b7754b"
msgid "Je vois bien votre complicité."
msgstr "Ich sehe, dass ihr gut miteinander auskommt."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "t9a98a25721"
msgid "[font_size=14]Invite la à sortir ![/font_size]"
msgstr "[font_size=14]Fragen, ob sie ausgehen möchte![/font_size]"

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb073f11752"
msgid "Je me disais... Vu que tu as du temps libre en ce moment..."
msgstr "Ich habe überlegt ... Wo du doch gerade etwas Freizeit hast ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t7f77fda481"
msgid "Est-ce que ça te dirait que je t'emmène te changer les idées ?"
msgstr "Wie würde es dir gefallen, woanders hinzugehen?"

#. Character:`sayuri` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb2566d66e2"
msgid "Tu es adorable {{saito.n}} mais ne te force pas, qu'est-ce que tu irais faire avec une vieille bique comme moi ?"
msgstr "Du bist herzallerliebst, {{saito.n}}, aber bitte zwing dich nicht dazu! Was solltest du mit einer alten Ziege wie mir anfangen?"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "ta3e3832288"
msgid "On risquerait de me prendre pour ta mère."
msgstr "Die Leute könnten mich für deine Mutter halten."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t23009f53cf"
msgid "Je n'y crois pas une seconde, au pire, on pourrait te prendre pour ma grande sœur !"
msgstr "Ich glaube dir kein Wort! Im schlimmsten Fall hielte man dich für meine große Schwester!"

#. Character:`sayuri` | Attributes:`moved,blush`
#: game/story/home_player_livingroom.dialogue
msgctxt "t18f2d777f6"
msgid "{{yasuka.n}} c'est toi qui as élevé ce séducteur dangereux ?!"
msgstr "{{yasuka.n}}, du bist diejenige, die diesen gefährlichen Charmeur erzogen hat?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "t54c731a429"
msgid "Il faut toujours que tu en fasses des tonnes."
msgstr "Du denkst zu viel nach."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb8367f0ae9"
msgid "Accepte donc la proposition !"
msgstr "Akzeptier einfach das Angebot!"

#. Character:`sayuri` | Attributes:`pouting,blush`
#: game/story/home_player_livingroom.dialogue
msgctxt "tf9ace33443"
msgid "Tu crois que je ne vois pas ce que tu es en train de faire ?"
msgstr "Glaubst du, ich verstehe nicht, was du da tust?"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t7d69c77a24"
msgid "Mais j'accepte !"
msgstr "Aber ich akzeptiere!"

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "ta8cce4653c"
msgid "Il y a certes un peu de {{yasuka.n}} dans cette idée mais j'aimerais aussi beaucoup apprendre à connaître la mère de ma meilleure amie."
msgstr "Es lässt sich nicht leugnen, dass {{yasuka.n}} bei alldem die Finger im Spiel hat, aber ganz abgesehen davon würde ich auch gerne mal die Mutter meiner besten Freundin kennenlernen."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "te72542ea60"
msgid "Il y a certes un peu de {{yasuka.n}} dans cette idée mais j'aimerais aussi beaucoup apprendre à connaître ma future belle-mère qui sait..."
msgstr "Es lässt sich nicht leugnen, dass {{yasuka.n}} bei alldem die Finger im Spiel hat, aber ganz abgesehen davon würde ich auch gerne mal meine womöglich zukünftige Schwiegermutter kennenlernen."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "td0e143b5c8"
msgid "Mon dieu mais quel gendre idéal tu fais !"
msgstr "Mein Gott, was für ein perfekter Schwiegersohn du doch bist!"

#. Character:`sayuri` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "teb12b3f350"
msgid "Tu m'as convaincue, passe me chercher demain en début d'après midi."
msgstr "Du hast mich überzeugt! Komm und hol mich morgen am frühen Nachmittag ab."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t3de0ec8306"
msgid "Ca marche !"
msgstr "In Ordnung!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "t36d9e66e3e"
msgid "{{yasuka.n}} merci pour le thé et la discussion, je dois me... préparer."
msgstr "{{yasuka.n}}, danke für den Tee und die schöne Unterhaltung. Ich muss ... mich fertigmachen."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t268f9d5113"
msgid "Oui je vois ce que tu veux dire, à bientôt !"
msgstr "Ja, ich weiß, was du meinst. Bis dann!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "te128fc9855"
msgid "Merci pour tout !"
msgstr "Danke für alles!"

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "t8d09dad7fd"
msgid "Merci mon chéri, je suis désolé de t'imposer cette situation."
msgstr "Vielen dank, mein Lieber. Es tut mir schrecklich leid, dich dieser Situation aussetzen zu müssen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_ESP_RE_QUE_A_NE_TE_D_RANGE_P_39F924"
msgid "J'espère que ça ne te dérange pas ?"
msgstr "Ich hoffe, das stört dich nicht?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_M_EN_VOUDRAIS_DE_CAUSER_DES_A361B6"
msgid "Je m'en voudrais de causer des problèmes entre toi et {{asami.n}}."
msgstr "Ich möchte auf keinen Fall zwischen dir und {{asami.n}} stehen."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_CERTAIN_QU_ELLE_SERAIT_87D3ED"
msgid "Je suis certain qu’elle serait contente que je m’occupe de sa mère."
msgstr "Ich bin mir sicher, dass sie sich freuen würde, wenn ich mich um ihre Mutter kümmere."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_PUIS_QU_EST_CE_QUI_POURRAIT_016D63"
msgid "Et puis... qu'est-ce qui pourrait se passer de mal ?"
msgstr "Und dann ... Was sollte schon schiefgehen?"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_MON_CH_RI_TU_M_ENL_VES_V_50341E"
msgid "Merci mon chéri, tu m'enlèves vraiment une épine du pied."
msgstr "Danke, Liebling. Du hast mir wirklich einen Stein vom Herzen genommen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "LA_VOIR_DANS_CET_TAT_ME_FAISAI_8D036D"
msgid "La voir dans cet état me faisait bien trop de peine."
msgstr "Sie so anzusehen war einfach zu viel für mich."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_T_INQUI_TES_INUTILEMENT_TO_5A75D1"
msgid "Tu t'inquiètes inutilement, tout ira bien"
msgstr "Du machst dir zu viele Sorgen. Alles wird gut."

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_MON_CH_RI_JE_SUIS_D_SOL_5A36E1"
msgid "Merci mon chéri ! Je suis désolée."
msgstr "Danke, Liebling! Es tut mir leid."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_M_ENGAGE_EXPLIQUER_ASAMI_N_2A5395"
msgid "Je m'engage à expliquer à {{asami.n}} que c’est moi qui t’ai imposé ça, c'est promis."
msgstr "Ich verspreche dir, ich werde {{asami.n}} erzählen, das ich derjenige war, der dir das angetan hat."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "COMME_A_ELLE_N_AURA_PAS_DE_RAI_99DAB8"
msgid "Comme ça elle n’aura pas de raison de t’en vouloir !"
msgstr "Dann hat sie keinen Grund, wütend auf dich zu sein."

#. Character:`narrator`
#: game/story/home_player_livingroom.dialogue
msgctxt "A_ME_MET_DANS_UNE_POSITION_D_78CFE4"
msgid "Ça me met dans une position délicate mais je le ferai pour toi."
msgstr "Das wird für mich nicht ganz einfach werden, aber ich krieg’s schon hin."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "tfd42b6cec5"
msgid "Tu ne m'imposes rien."
msgstr "Du setzt mich rein gar nichts aus."

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "tc5fdcabf4d"
msgid "Ce n'est pas comme si j'avais mieux à faire en ce moment."
msgstr "Ist nicht so, als hätte ich gerade irgendwas anderes zu tun."

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "t5febb6b6fb"
msgid "Et puis, comme je l'ai dit, c'est l'occasion de mieux connaitre {{sayuri.n}}."
msgstr "Und wie ich bereits sagte, es ist eine gute Gelegenheit, {{sayuri.n}} besser kennenzulernen."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "t2d57151eea"
msgid "Tu as une idée de l'endroit où tu pourrais l'emmener ?"
msgstr "Hast du eine Idee, wohin du sie ausführen könntest?"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "t38f342a204"
msgid "Je ne sais pas encore... Je vais y réfléchir."
msgstr "Ich weiß es noch nicht ... Ich werde darüber nachdenken."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "tfd9481d405"
msgid "Des suggestions ?"
msgstr "Irgendwelche Vorschläge?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "t39103a58a1"
msgid "Aucune j'en ai bien peur, ça fait bien trop longtemps."
msgstr "Leider nicht, befürchte ich. Es ist ein Weilchen her, dass ich ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "t4212b86433"
msgid "Les seuls souvenirs que j'ai d'elle remontent à loin."
msgstr "Die einzigen Erinnerungen, die ich von ihr habe, sind lange her."

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "tc3220dc13e"
msgid "Et à cette époque {{sayuri.n}} était assez folle."
msgstr "Und damals war {{sayuri.n}} ziemlich ... verrückt."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "tb0cd9384a7"
msgid "Bon et bien je vais me creuser les méninges pour trouver quelque chose avant demain."
msgstr "Na ja, ich werde mir bis morgen schon noch was einfallen lassen."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_N_EST_TOUJOURS_PAS_RENTR_17BD7C"
msgid "Il n'est toujours pas rentré ?"
msgstr "Ist er immer noch nicht wiedergekommen?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_COMMENCE_VRAIMENT_M_INQUI_T_C8112E"
msgid "Je commence vraiment à m'inquiéter pour lui..."
msgstr "Ich mache mir langsam wirklich Sorgen um ihn ..."

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_PEUR_QU_IL_NE_FASSE_QUELQ_DEBD0D"
msgid "J'ai peur qu'il ne fasse quelque chose qu'il puisse regretter."
msgstr "Ich habe die Befürchtung, dass er etwas tun wird, was er eines Tages noch bereuen wird."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_JE_NE_SAIS_PAS_E2AD23"
msgid "Je... je ne sais pas."
msgstr "Ich weiß nicht ... Ich weiß einfach nicht ..."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MA_CH_RIE_SI_TOI_AUSSI_TU_AS_B_9EB841"
msgid "Ma chérie... Si toi aussi tu as besoin d'en discuter, n'oublie pas que je serai toujours là pour toi, d'accord ?"
msgstr "Liebling ... Wenn du auch mal darüber reden möchtest, vergiss nicht, dass ich immer für dich da sein werde, okay?"

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "OUI_MERCI_MAMAN_A663E7"
msgid "Oui, merci maman."
msgstr "Ja, danke, Mama."

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_J_ENTENDS_DU_BRUIT_5E04A3"
msgid "Oh, j'entends du bruit !"
msgstr "Oh, ich höre etwas!"

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_VOUS_TES_TOUTES_L_726528"
msgid "Oh, vous êtes toutes là ?!"
msgstr "Oh, ihr seid alle da?!"

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "MON_CH_RI_TOUT_VA_BIEN_C31FF5"
msgid "Mon chéri, tout va bien ?"
msgstr "Liebling, geht es dir gut?"

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "LA_JOURN_E_A_T_FATIGANTE_64BF6D"
msgid "La journée a été... fatigante..."
msgstr "Ich hatte einen ... anstrengend Tag ..."

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_JUSTE_BESOIN_DE_REPOS_1192FB"
msgid "J'ai juste besoin de repos."
msgstr "Ich brauche einfach nur etwas Schlaf."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_L_SI_TU_V_C8AF83"
msgid "Je suis là si tu v-"
msgstr "Ich bin da falls, du–"

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "S_IL_VOUS_PLA_T_SORTEZ_DE_MA_M_89522A"
msgid "S’il vous plaît, sortez de ma maison !"
msgstr "Bitte verlassen Sie sofort mein Haus!"

#. Character:`cop`
#: game/story/home_player_livingroom.dialogue
msgctxt "MADAME_JE_SUIS_D_SOL_NOUS_AVON_0C4071"
msgid "Madame, je suis désolé, nous avons un mandat et vous hébergez un meurtrier."
msgstr "Entschuldigen Sie bitte, Madame. Wir haben einen Durchsuchungsbefehl und Sie beherbergen einen Mörder."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ARR_TEZ_DE_DIRE_DES_B_TISES_PA_E0F173"
msgid "Arrêtez de dire des bêtises pareilles ! Ces accusations sont ridicules, et si vous faisiez votre travail correctement, vous le sauriez aussi."
msgstr "Hören Sie auf mit diesem Unsinn! Diese Anschuldigungen sind doch lächerlich und wenn Sie ihren Job anständig machen würden, wüssten Sie das!"

#. Character:`cop` | Attributes:`bad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MADAME_MESUREZ_VOS_PAROLES_VOU_9FC4D3"
msgid "Madame, mesurez vos paroles ! Vous êtes probablement en état de choc face à ce qui est en train d’arriver, mais nous avons des preuves irréfutables."
msgstr "Madame, sehen Sie sich vor! Sie sind wahrscheinlich aufgebracht wegen der Ereignisse, aber wir haben handfeste Beweise."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUELLES_PREUVES_AVEZ_VOUS_J_AI_89F757"
msgid "Quelles preuves avez-vous ?! J’aimerais bien voir ça !"
msgstr "Was für Beweise habt ihr?! Die würde ich mir gerne auch ansehen!"

#. Character:`cop`
#: game/story/home_player_livingroom.dialogue
msgctxt "NOUS_AVONS_TROUV_DES_AFFAIRES_1AE4E4"
msgid "Nous avons trouvé des affaires appartenant à la victime, avec du sang dessus."
msgstr "Wir haben einige Gegenstände des Opfers mit Blutspuren entdeckt."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_BIEN_S_R_VOUS_NE_TROUVEZ_PA_6DBCC6"
msgid "Et bien sûr, vous ne trouvez pas ça étrange qu’il ait gardé tout ça dans sa chambre sans s’en débarrasser ?"
msgstr "Ah, aber Sie fragen sich nicht, warum er all das in seinem Zimmer aufbewahren sollte, anstatt es zu entsorgen?"

#. Character:`cop` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "MADAME_SI_VOUS_FAISIEZ_CE_M_TI_9D838B"
msgid "Madame, si vous faisiez ce métier depuis aussi longtemps que moi, vous sauriez à quel point les jeunes de nos jours sont stupides."
msgstr "Madame, wenn Sie diesen Job schon so lange machen würden, wie ich, wüssten Sie, wie verdammt dämlich die Jugend von heute ist."

#. Character:`cop`
#: game/story/home_player_livingroom.dialogue
msgctxt "TOUTES_LES_AFFAIRES_DE_LA_FILL_A7E1B5"
msgid "Toutes les affaires de la fille étaient soigneusement cachées dans un sac à dos."
msgstr "All der Kram war sorgfältig in einem Rucksack verpackt."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "VOUS_VOULEZ_PARLER_DE_CE_SAC_I_151CE7"
msgid "Vous voulez parler de ce sac ? Il n’est même pas à lui ! C’est son ami {{minato.n}} qui le lui a rapporté, vous devriez plutôt l’interroger, lui !"
msgstr "Möchten Sie über diesen Rucksack sprechen? Der gehört nicht mal ihm! Sein Freund {{minato.n}} hat ihn hier vorbeigebracht; Sie sollten lieber ihn verhören!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "DU_MOINS_SI_C_EST_VRAIMENT_VOT_3DA2E1"
msgid "Du moins... si c’est vraiment votre intention..."
msgstr "Zumindest ... Wenn Ihnen etwas daran liegt, die Wahrheit herauszufinden ..."

#. Character:`cop` | Attributes:`disgusted`
#: game/story/home_player_livingroom.dialogue
msgctxt "MADAME_JE_N_AIME_PAS_BEAUCOUP_2CB51A"
msgid "Madame, je n’aime pas beaucoup vos insinuations."
msgstr "Madame, Ihre Anschuldigungen sind äußerst töricht."

#. Character:`cop`
#: game/story/home_player_livingroom.dialogue
msgctxt "NOUS_ALLONS_PARTIR_MAIS_NOUS_L_36E6A3"
msgid "Nous allons partir, mais nous laisserons un agent devant votre maison au cas où l’assassin d’{{asami.n}} viendrait prendre contact avec vous."
msgstr "Wir werden nun gehen, aber wir werden einen Mann vor Ihrem Haus abstellen, sollte {{asami.n}}s Mörder versuchen, Kontakt zu Ihnen aufzunehmen."

#. Character:`cop` | Attributes:`bad`
#: game/story/home_player_livingroom.dialogue
msgctxt "DANS_CE_CAS_L_MERCI_DE_NOUS_CO_853FDF"
msgid "Dans ce cas-là, merci de nous contacter rapidement !"
msgstr "Wenn das passiert, kontaktieren Sie uns bitte unverzüglich!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "AUCUNE_CHANCE_SORTEZ_DE_CHEZ_M_5C4414"
msgid "Aucune chance ! Sortez de chez moi !"
msgstr "Nie im Leben! Verschwinden Sie aus meinem Haus!"

#. Character:`cop`
#: game/story/home_player_livingroom.dialogue
msgctxt "BONNE_JOURN_E_MADAME_4CBF2D"
msgid "Bonne journée madame !"
msgstr "Ich wünsche Ihnen noch einen schönen Tag, Madame!"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "AAAAAHH_JE_N_AI_JAMAIS_EU_AUTA_04B639"
msgid "Aaaaahh ! Je n’ai jamais eu autant envie de faire du mal à quelqu’un de ma vie !"
msgstr "Aaaaahh! Ich wollte noch nie in meinem Leben jemandem so gerne eine scheuern!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "QU_EST_CE_QUI_S_EST_PASS_POURQ_534C5A"
msgid "Qu'est-ce qui s'est passé ?! Pourquoi la police est à la recherche de {{saito.n}} ?"
msgstr "Was zur Hölle ist passiert?! Warum sucht die Polizei nach {{saito.n}}?"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "CE_N_EST_PAS_POSSIBLE_IL_EST_I_222487"
msgid "Ce n'est pas possible, il est innocent, je te jure que je n'ai rien à voir avec ça !"
msgstr "Niemals! Er ist unschuldig. Ich schwöre, er hat nichts mit alldem zu tun!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "NOUS_TIONS_M_ME_ENSEMBLE_LE_JO_1D806C"
msgid "Nous étions même ensemble le jour où ma fille a été enlevée !"
msgstr "Wir waren sogar zusammen an dem Tag, an dem meine Tochter entführt wurde!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SUIS_CERTAINE_QUE_LA_POLICE_6F1223"
msgid "Je suis certaine que la police a fait une erreur, je vais aller les voir et tirer ça au clair et..."
msgstr "Ich bin mir sicher, dass die Polizei einen Fehler gemacht hat. Ich werde mich melden, das alles aufklären und ..."

#. Character:`yasuka` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "CALME_TOI_UN_PEU_JE_SAIS_BIEN_1033BF"
msgid "Calme-toi un peu, je sais bien que tu n'y es pour rien."
msgstr "Beruhige dich ein bisschen. Ich weiß, dass das nicht deine Schuld ist."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_SI_J_TAIS_TOI_JE_N_IRAIS_EABF35"
msgid "Mais si j'étais toi, je n'irais pas voir la police."
msgstr "Ich an deiner Stelle würde mich von der Polizei fernhalten."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_COMMENT_A_BAB138"
msgid "Quoi ?! Comment ça ?"
msgstr "Was?! Warum das denn?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "TOUT_A_FAIT_PARTIE_D_UNE_MISE_26286E"
msgid "Tout ça fait partie d'une mise en scène pour couvrir quelque chose de bien plus gros, et j'ai bien peur que tout ça soit lié à l'enlèvement d'{{asami.n}}."
msgstr "Diese ganze Nummer ist nur eine Ablenkung, um etwas Größeres zu vertuschen und ich befürchte, es hängt alles mit {{asami.n}}s Entführung zusammen."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SAVAIS_BIEN_QUE_CES_FLICS_0E535A"
msgid "... Je savais bien que ces flics étaient louches depuis le début !"
msgstr "Ich wusste von Anfang an, dass man diesen Polizisten nicht über den Weg trauen kann!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUEL_POINT_CETTE_SITUATION_ES_4A226F"
msgid "À quel point cette situation est-elle mauvaise ?"
msgstr "Wie schlimm ist die Situation?"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "D_ABORD_ASSIEDS_TOI_ET_GARDE_L_76D46D"
msgid "D'abord, assieds-toi et garde l'esprit ouvert, car tout ce que tu vas entendre à partir de maintenant est la vérité."
msgstr "Setz dich erst mal hin und hör aufmerksam zu, denn alles, was du jetzt hören wirst, ist die Wahrheit."

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "A_RISQUE_AUSSI_DE_DEVENIR_DAN_CBE59C"
msgid "Ça risque aussi de devenir dangereux pour toi, tu es certaine de le vouloir ?"
msgstr "Das könnte übrigens gefährlich für dich werden. Bist du dir sicher, dass du das durchziehen willst?"

#. Character:`sayuri` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VEUX_TOUT_SAVOIR_E28D76"
msgid "Je veux tout savoir !"
msgstr "Ich will alles wissen!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "TR_S_BIEN_ALORS_W_PARLONS_DU_X_BAD890"
msgid "Très bien alors...[w] Parlons du X3."
msgstr "In Ordnung ... [w]Dann lass uns mal über X3 reden."

#. Character:`sayuri` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_PARLES_DE_L_INSCRIPTION_SUR_7F162C"
msgid "Tu parles de l'inscription sur les photos de ma fille ? Tu sais ce que ça veut dire ?"
msgstr "Meinst du das, was auf den Fotos meiner Tochter steht? Du weißt, was das bedeutet?"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "MALHEUREUSEMENT_OUI_IL_S_AGIT_C58A4B"
msgid "Malheureusement oui... Il s'agit de..."
msgstr "Leider schon, ja ... Das Ding ist Folgendes ..."

#. Character:`centered`
#: game/story/home_player_livingroom.dialogue
msgctxt "YASUKA_N_RACONTE_SAYURI_N_TOU_773C69"
msgid "{{yasuka.n}} raconte à {{sayuri.n}} tout ce qu'elle a appris auprès de {{noriko.n}} et tout ce qui s'est passé dernièrement."
msgstr "{{yasuka.n}} erzählt {{sayuri.n}} alles, was sie von {{noriko.n}} erfahren hat und was in letzter Zeit noch vorgefallen ist."

#. Character:`sayuri` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "BORDEL_DE_MERDE_LAISSE_MOI_ALL_6F2449"
msgid "Bordel de merde, laisse-moi aller castrer cette espèce de petit bâtard !"
msgstr "Verdammte Scheiße, lass mich diesen kleinen Wichser kastrieren gehen!"

#. Character:`sayuri`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_ALLER_LUI_R_GLER_SON_C_169792"
msgid "Je vais aller lui régler son compte moi-même."
msgstr "Ich kümmere mich eigenhändig um ihn."

#. Character:`yasuka` | Attributes:`upset`
#: game/story/home_player_livingroom.dialogue
msgctxt "RESTE_ASSISE_JE_NE_T_AI_PAS_RA_55CAA7"
msgid "Reste assise, je ne t'ai pas raconté ça pour que tu te mettes en danger inutilement."
msgstr "Immer mit der Ruhe. Ich habe dir das nicht erzählt, damit du dich mit dem Wissen unnötig in Gefahr begibst."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ON_NE_PEUT_PAS_S_EXPOSER_OUVER_54628C"
msgid "On ne peut pas s'exposer ouvertement ou leur faire comprendre qu'on est au courant de leurs manigances, nous devons agir discrètement !"
msgstr "Wir dürfen uns nicht offen zeigen oder sie wissen lassen, dass wir uns ihrer Tricks bewusst sind. Wir müssen erst mal diskret handeln."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAMAN_IL_Y_A_LA_POLICE_DEVANT_6FE996"
msgid "Maman ! Il y a la police devant la maison !"
msgstr "Mama! Die Polizei steht vor unserem Haus!"

#. Character:`yasuka` | Attributes:`depressed`
#: game/story/home_player_livingroom.dialogue
msgctxt "DE_PIRE_EN_PIRE_FA24C2"
msgid "De pire en pire..."
msgstr "Die Dinge werden immer schlimmer ..."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "VOTRE_TH_EST_VRAIMENT_D_LICIEU_5D151B"
msgid "Votre thé est vraiment délicieux."
msgstr "Dein Tee ist wirklich köstlich."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "QU_EST_CE_QUE_TU_VEUX_73F2B7"
msgid "Qu’est-ce que tu veux ?"
msgstr "Was willst du?"

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_SAIS_PERTINEMMENT_CE_QUE_VO_0BDBB7"
msgid "Je sais pertinemment ce que vous ressentez pour {{saito.n}}. Vous ne pourrez pas me mentir là-dessus."
msgstr "Ich weiß genau, was du für {{saito.n}} empfindest. Da kannst du mich nicht anlügen."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_NE_ME_PARLEZ_PAS_D_UN_AMOUR_1D0256"
msgid "Et ne me parlez pas d’un amour filial, cela va bien au-delà."
msgstr "Und komm mir bloß nicht mit elterlicher Liebe. Ihr zwei habt diesen Punkt schon längst überschritten."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_DEVRAIS_PEUT_TRE_VOUS_LAISS_1C9F69"
msgid "Je devrais peut-être vous laisser..."
msgstr "Vielleicht sollte ich euch in Ruhe lassen."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "PAS_SI_VITE_TOI_7F61C4"
msgid "Pas si vite toi !"
msgstr ""

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_ME_PENSES_ASSEZ_STUPIDE_POUR_B88920"
msgid "Tu me penses assez stupide pour ne pas savoir ce que tu as fait avec lui ?"
msgstr ""

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_TU_ES_TOUT_AUSSI_CONCERN_E_080E7F"
msgid "Non ! Tu es tout aussi concernée."
msgstr "Nein! Du steckst da genauso drin wie wir."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "VOUS_ME_PENSEZ_ASSEZ_STUPIDE_P_B63980"
msgid "Vous me pensez assez stupide pour ne pas voir ce que vous avez fait avec lui, toutes les deux ?"
msgstr "Denkst du ernsthaft, ich wäre dumm genug, um nicht zu sehen, was ihr zwei mit ihm gemacht habt?"

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "J_AI_PASS_BEAUCOUP_DE_TEMPS_VO_E8AE4F"
msgid "J’ai passé beaucoup de temps à vous observer. Vous souhaitez toutes rester à ses côtés, mais aucune d’entre vous n’a la volonté d’agir et de faire ce qui est nécessaire le moment venu."
msgstr "Ich habe euch eine ganze Weile beobachtet. Ihr wollt alle an seiner Seite bleiben, aber keiner von euch hat den Willen, etwas zu unternehmen und zu tun, was nötig ist."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "QU_EST_CE_QUE_TU_INSINUES_EST_8109DA"
msgid "Qu’est-ce que tu insinues ? Est-ce que tu essaies de nous intimider ?"
msgstr "Was willst du damit sagen? Willst du uns einschüchtern?"

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "W_VOTRE_REMARQUE_EST_TOUT_FAI_A464E1"
msgid "...[w] Votre remarque est tout à fait déplaisante. Vous vous méprenez..."
msgstr "... [w]Was für eine Unterstellung. Du liegst falsch ..."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_NE_S_AGIT_EN_AUCUN_CAS_D_IN_6C9344"
msgid "Il ne s’agit en aucun cas d’intimidation, mais plutôt d’un avertissement."
msgstr "Das soll keine Einschüchterung sein, sondern eine Warnung."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_LA_M_ME_CHOSE_E1AE40"
msgid "C’est la même chose !"
msgstr "Das macht doch keinen Unterschied!"

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VOUS_TOL_RE_UNIQUEMENT_PAR_2655CD"
msgid "Je vous tolère uniquement par amour pour {{saito.n}}, mais ma patience a des limites."
msgstr "Ich toleriere euch nur wegen meiner Liebe zu {{saito.n}}, doch auch meine Geduld hat ein Ende."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "SI_VOUS_D_SIREZ_VOUS_TENIR_SES_59E3F6"
msgid "Si vous désirez vous tenir à ses côtés, montrez-vous dignes et ne vous comportez pas comme des parasites."
msgstr "Wenn ihr wirklich bei ihm bleiben wollt, dann beweist euch und ruht euch nicht auf den Erfolgen anderer aus."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_REFUSE_DE_PARTAGER_MON_FUTU_F4A7FE"
msgid "Je refuse de partager mon futur mari avec des femmes qui ne méritent pas mon respect."
msgstr "Ich werde meinen künftigen Ehemann niemals mit Frauen teilen, die meinen Respekt nicht verdient haben."

#. Character:`sakuya`
#: game/story/home_player_livingroom.dialogue
msgctxt "SUR_CE_MERCI_POUR_CET_EXCELLEN_C9CFA8"
msgid "Sur ce... Merci pour cet excellent thé, je vous souhaite une bonne journée."
msgstr "Also dann ... Danke für den wunderbaren Tee, ich wünsche einen schönen Tag."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "BON_BON_BON_0700D3"
msgid "Bon... bon... bon..."
msgstr "Na sieh mal einer an ..."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_CROIS_QUE_J_AI_UN_TRUC_FAIR_94508A"
msgid "Je crois que j’ai un truc à faire dans ma chambre."
msgstr "Ich glaube, ich habe noch etwas in meinem Zimmer zu erledigen."

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_VAIS_DEVOIR_1819E1"
msgid "Je vais devoir..."
msgstr "Ich muss wohl ..."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_CROIS_QUE_NOUS_DEVONS_AVOIR_B600A5"
msgid "Je crois que nous devons avoir une discussion, toi et moi !"
msgstr "Ich glaube, wir zwei müssen uns mal unterhalten!"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAMAN_JE_NE_SUIS_PAS_CERTAINE_1FF9C5"
msgid "Maman... je ne suis pas certaine d’en avoir envie."
msgstr "Mama ... Ich weiß nicht, ob ich das will."

#. Character:`noriko` | Attributes:`shame`
#: game/story/home_player_livingroom.dialogue
msgctxt "SURTOUT_S_IL_S_AGIT_DE_DISCUTE_399294"
msgid "Surtout s’il s’agit de discuter de ça !"
msgstr "Ganz besonders, wenn wir ausgerechnet darüber reden!"

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "OH_QUE_SI_TU_VAS_POSER_TES_FES_7A0736"
msgid "Oh que si ! Tu vas poser tes fesses sur ce canapé et me raconter tout ce que tu fais dans mon dos avec {{saito.n}}."
msgstr "Oh, absolut müssen wir das! Du wirst deinen Hintern schön auf das Sofa pflanzen und mir erzählen, was du mit {{saito.n}} hinter meinem Rücken getrieben hast."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "IL_Y_A_VISIBLEMENT_DES_CHOSES_3CD7DA"
msgid "Il y a visiblement des choses que j’ignore et dont cette fille est pourtant au courant."
msgstr "Da gibt es ganz offensichtlich ein paar Dinge, die ich nicht weiß, aber dieses Mädchen hat anscheinend Ahnung."

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUELLE_RELATION_ENTRETIENS_TU_838B0A"
msgid "Quelle relation entretiens-tu exactement avec lui ?"
msgstr "Was für ein Verhältnis habt ihr genau?"

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "AVEZ_VOUS_COUCH_ENSEMBLE_8317A3"
msgid "Avez-vous couché ensemble ?"
msgstr "Habt ihr miteinander geschlafen?"

#. Character:`noriko` | Attributes:`afraid`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAMAN_662D2B"
msgid "Maman !!!"
msgstr "Mamaaaa!!!"

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "EH_BIEN_VOUS_TES_D_J_BIEN_BRUY_0A3C1D"
msgid "Eh bien, vous êtes déjà bien bruyants dès le matin, que s'est-il passé ?"
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_B731A1"
msgid "Je..."
msgstr ""

#. Character:`narrator` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "ZUT_JE_NE_PEUX_PAS_LUI_DIRE_CE_E9BA36"
msgid "Zut ! Je ne peux pas lui dire ce qui m'est arrivé. La connaissant, elle risque surtout de s'inquiéter davantage."
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "DISONS_QUE_JE_ME_SUIS_R_VEILL_A2F79E"
msgid "Disons que je me suis réveillé d'un long cauchemar."
msgstr ""

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "EN_EFFET_TON_REGARD_SEMBLE_DIF_7080BF"
msgid "En effet, ton regard semble différent ce matin, quelque chose a changé mais je ne parviens pas à dire quoi."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_DONC_CE_CAUCHEMAR_TU_ME_RAC_459769"
msgid "Et donc ce cauchemar ? Tu me racontes ?"
msgstr ""

#. Character:`noriko`
#: game/story/home_player_livingroom.dialogue
msgctxt "FONT_SIZE_14_C_TAIT_UN_R_VE_P_174A56"
msgid "[font_size=14]C'était un rêve pervers, pas un cauchemar ![/font_size]"
msgstr ""

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_C_EST_VRAI_BF35E1"
msgid "Quoi, c'est vrai ?"
msgstr ""

#. Character:`yasuka` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "FONT_SIZE_14_TU_SAIS_QUE_SI_T_A75DE9"
msgid "[font_size=14]Tu sais que si tu as taché tes draps, tu peux me le dire...[/font_size]"
msgstr ""

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_CE_N_TAIT_P_4EA2BD"
msgid "NON ! CE N'ÉTAIT P-"
msgstr ""

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "CE_N_TAIT_PAS_CE_GENRE_DE_R_VE_A77142"
msgid "Ce n'était pas ce genre de rêve, à vrai dire j'aurais préféré..."
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_A_VA_BEAUCOUP_MIEUX_J_AI_442952"
msgid "Mais ça va beaucoup mieux ! J'ai décidé de me reprendre en main."
msgstr ""

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "ET_TOI_COMMENT_A_VA_7A4D85"
msgid "Et toi ? Comment ça va ?"
msgstr ""

#. Character:`yasuka` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "MOI_53E4BB"
msgid "... Moi ?"
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "EH_BIEN_OUI_JE_SAIS_D_J_QUE_NO_B5D379"
msgid "Eh bien oui... Je sais déjà que {{noriko.n}} est en pleine forme, elle me l'a encore démontré ce matin."
msgstr ""

#. Character:`saito` | Attributes:`happy`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_ET_TOI_311FE1"
msgid "Mais et toi ?"
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_LA_PREMI_RE_FOIS_QUE_TU_34D731"
msgid "C'est la première fois que tu me demandes..."
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_CROIS_QUE_JE_VAIS_PLEURER_95DDCC"
msgid "Je crois que je vais pleurer..."
msgstr ""

#. Character:`saito` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "QUOI_NON_NON_NON_31FCDC"
msgid "Quoi ?! Non, non, non !"
msgstr ""

#. Character:`saito`
#: game/story/home_player_livingroom.dialogue
msgctxt "JE_NE_VOULAIS_PAS_ME_MOQUER_DE_5319B2"
msgid "Je ne voulais pas me moquer de toi, je... je suis désolé, j'aurais dû te demander ça bien plus souvent"
msgstr ""

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "PARDON_11291A"
msgid "Pardon."
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "NON_NE_T_INQUI_TE_PAS_CE_SONT_4B15C4"
msgid "Non, ne t'inquiète pas, ce sont des larmes de joie..."
msgstr ""

#. Character:`saito` | Attributes:`guilty`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_TU_EN_ES_S_RE_755C4F"
msgid "Tu... tu en es sûre ?"
msgstr ""

#. Character:`yasuka` | Attributes:`pouting`
#: game/story/home_player_livingroom.dialogue
msgctxt "VIDEMMENT_823C0B"
msgid "Évidemment !"
msgstr ""

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "MAIS_POUR_TE_R_PONDRE_HONN_TEM_29F78B"
msgid "Mais pour te répondre honnêtement... ça ne va pas très fort en ce moment."
msgstr ""

#. Character:`saito` | Attributes:`neutral`
#: game/story/home_player_livingroom.dialogue
msgctxt "SI_JE_PEUX_FAIRE_QUOI_QUE_CE_S_6D0ED7"
msgid "Si je peux faire quoi que ce soit pour t'aider..."
msgstr ""

#. Character:`yasuka` | Attributes:`moved`
#: game/story/home_player_livingroom.dialogue
msgctxt "MERCI_MON_CH_RI_MAIS_J_AI_BIEN_06B224"
msgid "Merci mon chéri, mais j'ai bien peur que cela soit au-delà de ta portée."
msgstr ""

#. Character:`saito` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "TU_PEUX_QUAND_M_ME_M_EN_PARLER_81D3DE"
msgid "Tu peux quand même m'en parler ?"
msgstr ""

#. Character:`yasuka` | Attributes:`sad`
#: game/story/home_player_livingroom.dialogue
msgctxt "BIEN_S_R_C_EST_55B0C3"
msgid "Bien sûr... C'est-"
msgstr ""

#. Character:`yasuka`
#: game/story/home_player_livingroom.dialogue
msgctxt "C_EST_CAUSE_DES_DETTES_QUI_SE_4DFFCD"
msgid "C'est à cause des dettes qui se sont accumulées et je ne parviens plus à les rembourser."
msgstr ""

#. Character:`narrator` | Attributes:`surprised`
#: game/story/home_player_livingroom.dialogue
msgctxt "COMMENT_A_LES_DETTES_B9A6B8"
